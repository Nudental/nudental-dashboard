# Streaming URL fetch
# ---------------------------------------------------------------------------

def get_streaming_info(client: AscendClient) -> dict:
    """Get AMQPS connection details from Dentrix Ascend."""
    client._ensure_token()
    resp = requests.get(
        "https://prod.hs1api.com/ascend-streaming-api/url",
        headers={
            "Authorization": f"{client._token_type} {client._access_token}",
            "Organization-ID": ORG_ID,
        },
        timeout=15,
    )
    resp.raise_for_status()
    return resp.json()


# ---------------------------------------------------------------------------
# Message routing
# ---------------------------------------------------------------------------

RESOURCE_TYPE_MAP = {
    # Simple names (original)
    "patient": "patient",
    "patients": "patient",
    "appointment": "appointment",
    "appointments": "appointment",
    "transaction": "transaction",
    "transactions": "transaction",
    "patientpayment": "transaction",
    "insurancepayment": "transaction",
    "adjustment": "transaction",
    "procedure": "transaction",
    "provider": "provider",
    "providers": "provider",
    "location": "location",
    "locations": "location",
    # Versioned names from actual Dentrix AMQPS events
    "patientv1": "patient",
    "patientprocedurev1": "transaction",
    "appointmentv1": "appointment",
    "transactionv1": "transaction",
    "insurancepaymentv1": "transaction",
    "patientpaymentv1": "transaction",
    "adjustmentv1": "transaction",
    "visitv1": "visit",
    "clinicalnotev1": "clinicalnote",
    "txcasev1": "transaction",
    "commonpatientprocedures": "transaction",
    "missedappointmentv1": "appointment",
    "patientrecarev1": "other",
    "patientinsuranceplanv1": "other",
    "carrierinsuranceplanv1": "other",
    "eventv1": "other",
}

TRANSACTION_SUBTYPES = {
    "patientpayment", "insurancepayment", "adjustment", "procedure",
    "transaction", "transactions",
    "patientprocedure",
    # Versioned
    "patientprocedurev1", "transactionv1", "txcasev1",
    "commonpatientprocedures", "insurancepaymentv1", "patientpaymentv1",
    "adjustmentv1",
}

# Field normalization for streaming events (different from REST API schema)
def _normalize_stream_event(resource_raw: str, data: dict) -> dict:
    """Normalize streaming event fields to match REST API schema."""
    normalized = dict(data)
    if resource_raw in ("patientprocedurev1", "commonpatientprocedures"):
        if "serviceDate" in data and "transactionDate" not in data:
            normalized["transactionDate"] = data["serviceDate"]
        if "renderingProvider" in data and "provider" not in data:
            normalized["provider"] = data["renderingProvider"]
        if "state" in data and "isActive" not in data:
            normalized["isActive"] = data["state"] == "ACTIVE"
        if "ledgerType" not in data:
            normalized["ledgerType"] = "PatientProcedureLedger"
    return normalized


def _parse_routing_key(routing_key: str) -> tuple:
    """
    Parse routing key: OrgID.LocationID.ResourceType.Method
    Returns (org_id, location_id, resource_type, method)
    """
    parts = routing_key.split(".")
    if len(parts) < 4:
        return (None, None, None, None)
    org = parts[0]
    location = parts[1]
    resource = parts[2].lower()
    method = parts[3] if len(parts) > 3 else "unknown"
    return (org, location, resource, method)


def _route_message(routing_key: str, body: dict, raw_body: bytes) -> bool:
    """
    Route incoming AMQP message to the correct Supabase table.
    Returns True if successfully handled.
    """
    org_id, location_id, resource_raw, method = _parse_routing_key(routing_key)
    if not resource_raw:
        logger.warning(f"Could not parse routing key: {routing_key}")
        return False

    # --- FIX C3: Normalize event type (strip version suffix) ---
    resource_raw_base = re.sub(r"v\d+$", "", resource_raw)
    resource_type = RESOURCE_TYPE_MAP.get(resource_raw) or RESOURCE_TYPE_MAP.get(resource_raw_base, resource_raw_base)

    # --- FIX C4: Unwrap event envelope ---
    # Events arrive as: { "type": "...", "payload": { actual_data } }
    resource_data = body.get("payload", body)
    if isinstance(resource_data, str):
        try:
            resource_data = json.loads(resource_data)
        except (json.JSONDecodeError, TypeError):
            resource_data = body

    # Normalize streaming field names to REST-compatible schema
    resource_data = _normalize_stream_event(resource_raw_base or resource_raw, resource_data)

    resource_id = resource_data.get("id") or body.get("id") or body.get("resourceId")

    logger.info(
        f"Stream event: raw={resource_raw} → type={resource_type} method={method} "
        f"id={resource_id} loc={location_id} has_payload={'payload' in body}"
    )

    ok = False
    handler = "unhandled"
    try:
        if resource_type == "patient":
            handler = "upsert_patient"
            ok = upsert_patient(resource_data, org_id or ORG_ID)

        elif resource_type == "appointment":
            handler = "upsert_appointment"
            ok = upsert_appointment(resource_data, org_id or ORG_ID, location_id)
            # FIX-5: Also write back to local SQLite so appointment status changes
            # (UNCONFIRMED → COMPLETED, etc.) are reflected immediately.
            _sqlite_writeback_appointment(resource_data, method)

        elif resource_type == "transaction" or resource_raw in TRANSACTION_SUBTYPES or resource_raw_base in TRANSACTION_SUBTYPES:
            handler = "upsert_transaction"
            ok = upsert_transaction(resource_data, org_id or ORG_ID, tx_type=(resource_raw_base or resource_raw))
            # FIX-3/FIX-4: Also write back to local SQLite so distributions and field
            # changes are available immediately to the service layer without waiting
            # for the next hourly cursor-based sync.
            _sqlite_writeback(resource_data, method)

        elif resource_type == "provider":
            handler = "upsert_provider"
            ok = upsert_provider(resource_data, org_id or ORG_ID)

        elif resource_type == "location":
            handler = "upsert_location"
            ok = upsert_location(resource_data, org_id or ORG_ID)

        else:
            # Unhandled/unknown resource types (e.g. "other", "visit", "clinicalnote")
            # These are valid Dentrix events we don't yet process — log as debug, not error
            handler = "SKIPPED"
            logger.debug(
                f"SKIPPED event (unhandled type): received_type={body.get('type')} raw={resource_raw} "
                f"normalized={resource_type} routing_key={routing_key}"
            )
            ok = True  # Not an error — just a no-op for this resource type

    except Exception as e:
        logger.error(
            json.dumps({
                "error": str(e),
                "received_type": body.get("type"),
                "resource_type": resource_type,
                "resource_raw": resource_raw,
                "handler": handler,
                "method": method,
                "location_id": location_id,
                "timestamp": datetime.now(timezone.utc).isoformat(),
            })
        )
        ok = False

    logger.info(
        f"Stream route result: received_type={body.get('type')} raw={resource_raw} normalized={resource_type} "
        f"handler={handler} ok={ok}"
    )

    # Always write to local events table for SSE regardless of Supabase result
    event_payload = {
        "resourceType": resource_type,
        "resourceId": resource_id,
        "method": method,
        "locationId": location_id,
        "orgId": org_id or ORG_ID,
        "data": resource_data,
        "envelope": body,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "routingKey": routing_key,
        "supabaseOk": ok,
    }
    _write_event(f"{resource_type}.{method}", resource_type, resource_id, location_id, event_payload)

    return ok


# ---------------------------------------------------------------------------
# AMQPS Consumer
# ---------------------------------------------------------------------------

_consumer_running = False
_consumer_thread: Optional[threading.Thread] = None
_stats = {
    "messages_received": 0,
    "messages_routed": 0,
    "messages_skipped": 0,   # Unhandled resource types (not errors)
    "errors": 0,
    "connected_at": None,
    "last_message_at": None,
    "reconnects": 0,
}

# Audit batching for Supabase import_audit_log
_audit_batch = {
    "received": 0,
    "imported": 0,
    "failed": 0,
    "last_routing_key": None,
    "last_type": None,
    "started_ts": time.time(),
    "last_flush_ts": time.time(),
}


def _flush_stream_audit(force: bool = False):
    now = time.time()
    if not force:
        if _audit_batch["received"] < 50 and (now - _audit_batch["last_flush_ts"]) < 30:
            return

    duration_ms = int((now - _audit_batch["started_ts"]) * 1000)
    status = "success" if _audit_batch["failed"] == 0 else ("partial" if _audit_batch["imported"] > 0 else "failed")

    try:
        write_sync_audit(
            endpoint_key="streaming_events",
            endpoint_name="Dentrix AMQPS stream",
            endpoint_path="amqps",
            sync_type="streaming",
            status=status,
            records_fetched=_audit_batch["received"],
            records_imported=_audit_batch["imported"],
            records_failed=_audit_batch["failed"],
            error_details={
                "last_routing_key": _audit_batch["last_routing_key"],
                "last_type": _audit_batch["last_type"],
            },
            duration_ms=duration_ms,
            triggered_by="streaming_consumer",
        )
    except Exception as e:
        logger.warning(f"Failed to write streaming audit: {e}")

    _audit_batch["received"] = 0
    _audit_batch["imported"] = 0
    _audit_batch["failed"] = 0
    _audit_batch["started_ts"] = now
    _audit_batch["last_flush_ts"] = now


def _on_message(channel, method, properties, body):
    """Callback for each AMQP message."""
    global _stats
    _stats["messages_received"] += 1
    _stats["last_message_at"] = datetime.now(timezone.utc).isoformat()

    routing_key = method.routing_key
    try:
        if isinstance(body, bytes):
            body_str = body.decode("utf-8")
        else:
            body_str = body

        payload = json.loads(body_str)
        ok = _route_message(routing_key, payload, body)

        _audit_batch["received"] += 1
        _audit_batch["last_routing_key"] = routing_key
        _audit_batch["last_type"] = payload.get("type") or payload.get("messageType")

        if ok:
            _stats["messages_routed"] += 1
            _audit_batch["imported"] += 1
        else:
            # Only count as error if it was a genuine failure, not a SKIPPED/unhandled type
            # (SKIPPED events return ok=True now, so this branch is real failures only)
            _stats["errors"] += 1
            _audit_batch["failed"] += 1

        _flush_stream_audit(force=False)
    except json.JSONDecodeError:
        logger.warning(f"Non-JSON message on {routing_key}: {body[:100]}")
        _stats["errors"] += 1
        _audit_batch["received"] += 1
        _audit_batch["failed"] += 1
        _audit_batch["last_routing_key"] = routing_key
        _audit_batch["last_type"] = "non_json"
        _flush_stream_audit(force=False)

        # Write raw event to local events table
        _write_event("raw", "unknown", None, None, {
            "routingKey": routing_key,
            "rawBody": body.decode("utf-8", errors="replace")[:500],
        })
    except Exception as e:
        logger.error(f"Message handler error: {e}", exc_info=True)
        _stats["errors"] += 1
        _audit_batch["received"] += 1
        _audit_batch["failed"] += 1
        _audit_batch["last_routing_key"] = routing_key
        _audit_batch["last_type"] = "handler_exception"
        _flush_stream_audit(force=False)

    # Acknowledge the message
    channel.basic_ack(delivery_tag=method.delivery_tag)


def _build_pika_params(amqps_url: str) -> "pika.ConnectionParameters":
    """Parse AMQPS URL into pika connection parameters with SSL."""
    parsed = urlparse(amqps_url)

    ssl_ctx = ssl.create_default_context()
    ssl_ctx.check_hostname = False
    ssl_ctx.verify_mode = ssl.CERT_NONE  # HS1 certs may be self-signed

    credentials = pika.PlainCredentials(
        username=parsed.username or "guest",
        password=parsed.password or "guest",
    )

    params = pika.ConnectionParameters(
        host=parsed.hostname,
        port=parsed.port or 5671,
        virtual_host=parsed.path.lstrip("/") or "/",
        credentials=credentials,
        ssl_options=pika.SSLOptions(ssl_ctx),
        connection_attempts=3,
        retry_delay=2,
        socket_timeout=30,
        heartbeat=60,
    )
    return params


def _run_consumer_loop():
    """Main consumer loop with reconnection logic."""
    global _stats, _consumer_running

    client = AscendClient(creds_path=PROD_CREDS)
    client.authenticate()
    logger.info(f"Authenticated to Dentrix Ascend (org: {ORG_ID})")

    delay = RECONNECT_DELAY

    while _consumer_running:
        try:
            logger.info("Fetching AMQPS streaming URL...")
            stream_info = get_streaming_info(client)
            amqps_url = stream_info["url"]
            exchange = stream_info["exchanges"]
            queue_name = stream_info["queues"]
            routing_key = stream_info.get("routingKeys", "*.*.*.*")

            logger.info(f"Connecting to AMQPS: {amqps_url[:60]}...")
            params = _build_pika_params(amqps_url)

            connection = pika.BlockingConnection(params)
            channel = connection.channel()

            # JWT claim: queues must match ^apiConsumers\.{app_id}\..+$
            # The API returns base name; we append ".nudashboard" to satisfy the regex
            base_queue = queue_name
            suffixed_queue = f"{base_queue}.nudashboard"
            consume_queue = None

            # Try to create/declare the suffixed named queue
            for qname in [suffixed_queue, base_queue]:
                try:
                    channel.queue_declare(
                        queue=qname,
                        durable=False,
                        exclusive=False,
                        auto_delete=True,
                    )
                    consume_queue = qname
                    logger.info(f"Queue declared: {qname}")
                    break
                except Exception as qe:
                    logger.info(f"queue_declare({qname!r}) refused: {qe.__class__.__name__}: {str(qe)[:80]}")
                    # Channel is closed after failure — reopen
                    try:
                        channel = connection.channel()
                    except Exception:
                        pass

            if not consume_queue:
                raise Exception(
                    f"Cannot declare any queue. JWT allows pattern: ^apiConsumers\\.{queue_name.split('.',1)[-1]}\\..$. "
                    f"Tried: {suffixed_queue}, {base_queue}. "
                    "HS1 may require provisioning via support ticket."
                )

            # Bind to the HS1 exchange with topic routing key
            for rkey in ["*.*.*.*", "#"]:
                try:
                    channel.queue_bind(
                        exchange=exchange,
                        queue=consume_queue,
                        routing_key=rkey,
                    )
                    logger.info(f"Bound {consume_queue} → {exchange} routing_key={rkey}")
                    break
                except Exception as be:
                    logger.warning(f"Bind with {rkey!r} failed: {be}")

            channel.basic_qos(prefetch_count=10)
            channel.basic_consume(
                queue=consume_queue,
                on_message_callback=_on_message,
                auto_ack=False,
            )

            _stats["connected_at"] = datetime.now(timezone.utc).isoformat()
            _stats["reconnects"] += 1
            delay = RECONNECT_DELAY  # Reset delay on successful connect
            logger.info(f"✅ Connected to AMQPS stream. Queue: {queue_name}")

            # Write a connect event to local events table
            _write_event("consumer.connected", "system", None, None, {
                "queue": queue_name,
                "exchange": exchange,
                "timestamp": _stats["connected_at"],
            })

            # Block and consume
            channel.start_consuming()

        except pika.exceptions.AMQPConnectionError as e:
            logger.warning(f"AMQP connection error: {e}. Reconnecting in {delay}s...")
        except pika.exceptions.StreamLostError as e:
            logger.warning(f"AMQP stream lost: {e}. Reconnecting in {delay}s...")
        except Exception as e:
            logger.error(f"Consumer error: {e}. Reconnecting in {delay}s...", exc_info=True)

        if not _consumer_running:
            break

        # Write disconnect event
        _write_event("consumer.disconnected", "system", None, None, {
            "reason": "connection_lost",
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "stats": dict(_stats),
        })

        time.sleep(delay)
        delay = min(delay * 2, MAX_RECONNECT_DELAY)

        # Re-authenticate if token might have expired
        try:
            client._ensure_token()
        except Exception as e:
            logger.warning(f"Re-auth failed: {e}")
            try:
                client.authenticate()
            except Exception as e2:
                logger.error(f"Auth retry failed: {e2}")

    logger.info("Consumer loop exited")


# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

def get_stats() -> dict:
    return dict(_stats)


def start_consumer_thread() -> Optional[threading.Thread]:
    """Start the streaming consumer as a background daemon thread."""
    global _consumer_running, _consumer_thread

    if not PIKA_AVAILABLE:
        logger.error("pika not installed. Cannot start streaming consumer.")
        return None

    _init_events_table()

    if _consumer_thread and _consumer_thread.is_alive():
        logger.info("Consumer thread already running")
        return _consumer_thread

    _consumer_running = True
    t = threading.Thread(target=_run_consumer_loop, daemon=True, name="amqp-consumer")
    t.start()
    _consumer_thread = t
    logger.info("Streaming consumer thread started")
    return t


def stop_consumer():
    global _consumer_running
    _consumer_running = False
    try:
        _flush_stream_audit(force=True)
    except Exception:
        pass
    logger.info("Streaming consumer stop requested")


# ---------------------------------------------------------------------------
# Standalone entry point
# ---------------------------------------------------------------------------

if __name__ == "__main__":
    import signal

    logging.basicConfig(level=logging.DEBUG)

    # ── sync_logger (Phase 2D) — process lifecycle only, NOT per-event ──
    try:
        from sync_logger import start_sync_run, finish_sync_run, fail_sync_run
    except ImportError:
        start_sync_run = finish_sync_run = fail_sync_run = lambda *a, **kw: None

    _sl_run_id = start_sync_run("dentrix_streaming", trigger_type="realtime", triggered_by="process_start",
                                metadata={"mode": "standalone", "pid": os.getpid()})

    def _handle_signal(sig, frame):
        logger.info(f"Signal {sig} received, stopping...")
        finish_sync_run(_sl_run_id, status="success",
                        metadata={"reason": f"signal_{sig}", "stats": {k: v for k, v in _stats.items() if k != "connected_at"}})
        stop_consumer()
        sys.exit(0)

    signal.signal(signal.SIGINT, _handle_signal)
    signal.signal(signal.SIGTERM, _handle_signal)

    _init_events_table()
    _consumer_running = True

    logger.info("Starting Dentrix Ascend streaming consumer (standalone mode)...")
    try:
        _run_consumer_loop()
    except Exception as _exc:
        fail_sync_run(_sl_run_id, error=_exc,
                      metadata={"stats": {k: v for k, v in _stats.items() if k != "connected_at"}})
        raise
