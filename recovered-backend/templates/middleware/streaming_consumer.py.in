RECONNECT_DELAY = 5   # seconds
MAX_RECONNECT_DELAY = 60

# ---------------------------------------------------------------------------
# Local SQLite events table (for SSE fan-out to connected clients)
# ---------------------------------------------------------------------------

def _get_events_db() -> sqlite3.Connection:
    # Use a generous timeout + busy_timeout to reduce "database is locked" errors
    # since this DB is shared with the main Ascend sync.
    conn = sqlite3.connect(EVENTS_DB_PATH, check_same_thread=False, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=NORMAL")
    conn.execute("PRAGMA busy_timeout=5000")
    return conn


def _init_events_table():
    conn = _get_events_db()
    conn.execute("""
        CREATE TABLE IF NOT EXISTS stream_events (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            event_type TEXT NOT NULL,
            resource_type TEXT,
            resource_id TEXT,
            location_id TEXT,
            org_id TEXT,
            payload TEXT NOT NULL,
            received_at REAL DEFAULT (unixepoch('now', 'subsec'))
        )
    """)
    conn.execute("CREATE INDEX IF NOT EXISTS idx_se_received ON stream_events(received_at)")
    conn.commit()
    conn.close()
    logger.info("Stream events table ready")


def _get_ascend_db() -> sqlite3.Connection:
    """Open the main Ascend SQLite DB for transaction write-backs."""
    conn = sqlite3.connect(ASCEND_DB_PATH, check_same_thread=False, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=NORMAL")
    conn.execute("PRAGMA busy_timeout=5000")
    return conn


# ---------------------------------------------------------------------------
# Distribution-lines materializer (keeps DL in sync with payment upserts)
# ---------------------------------------------------------------------------
def _rebuild_dl_for_item(conn: sqlite3.Connection, source_table: str, item: dict):
    """Materialize distribution_lines for a single payment/adjustment.

    Idempotent: deletes any existing rows for this transaction_id first,
    then re-inserts from the raw distributions array.
    """
    tx_id = item.get("id")
    if not tx_id:
        return

    dists = item.get("distributions")
    if not isinstance(dists, list):
        return

    # Delete existing lines for this transaction
    conn.execute(
        "DELETE FROM distribution_lines WHERE source_table = ? AND transaction_id = ?",
        (source_table, tx_id),
    )

    if not dists:
        return

    ledger_type = item.get("ledgerType")
    tx_date = (item.get("transactionDate") or item.get("entryDate", "")[:10] or None)
    loc_raw = item.get("location")
    loc_id = loc_raw.get("id") if isinstance(loc_raw, dict) else loc_raw
    is_payment = source_table in ("insurance_payments", "patient_payments")
    tx_amount = float(item.get("amount") or 0)

    # Batch-load procedures for provider_id and procedure_transaction_date
    charge_ids = [d.get("chargeId") for d in dists if isinstance(d, dict) and d.get("chargeId")]
    proc_map = {}
    if charge_ids:
        qmarks = ",".join(["?"] * len(charge_ids))
        rows = conn.execute(
            f"SELECT id, location_id, provider_id, transaction_date FROM procedures WHERE id IN ({qmarks})",
            tuple(charge_ids),
        ).fetchall()
        proc_map = {r["id"]: (r["location_id"], r["provider_id"], r["transaction_date"]) for r in rows}

    lines = []
    for d in dists:
        if not isinstance(d, dict):
            continue
        charge_id = d.get("chargeId")
        if not charge_id:
            continue

        charge_loc = d.get("chargeLocationId")
        raw_applied = float(d.get("appliedAmount", 0) or 0)

        if is_payment:
            applied_amount = -abs(raw_applied)
        elif tx_amount < 0:
            applied_amount = -abs(raw_applied)
        else:
            applied_amount = abs(raw_applied)

        proc = proc_map.get(charge_id)
        proc_provider = proc[1] if proc else None
        proc_date = proc[2] if proc else None
        if not charge_loc and proc:
            charge_loc = proc[0]

        lines.append((
            source_table, tx_id, ledger_type, tx_date,
            loc_id, charge_id, charge_loc, applied_amount,
            1 if item.get("isActive", True) else 0,
            proc_provider, proc_date,
        ))

    if lines:
        conn.executemany(
            """INSERT INTO distribution_lines
               (source_table, transaction_id, transaction_ledger_type, transaction_date,
                transaction_location_id, charge_id, charge_location_id, applied_amount,
                line_is_active, procedure_provider_id, procedure_transaction_date)
               VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
            lines,
        )


# Mapping from Dentrix ledgerType → local SQLite table
LEDGER_TYPE_TO_TABLE = {
    "PatientProcedureLedger":              "procedures",
    "PatientProcedureLedgerCancellation":  "procedures",
    "PatientProcedureLedgerRebill":        "procedures",
    "PatientProcedurePayment":             "patient_payments",
    "PatientProcedurePaymentCancellation": "patient_payments",
    "PatientProcedurePaymentRebill":       "patient_payments",
    "InsurancePayment":                    "insurance_payments",
    "InsurancePaymentCancellation":        "insurance_payments",
    "InsurancePaymentRebill":              "insurance_payments",
    "PatientChargeAdjustment":             "adjustments",
    "PatientChargeAdjustmentCancellation": "adjustments",
    "PatientChargeAdjustmentRebill":       "adjustments",
    "PatientCreditAdjustment":             "adjustments",
    "PatientCreditAdjustmentCancellation": "adjustments",
    "PatientCreditAdjustmentRebill":       "adjustments",
    "InsuranceRefundAdjustment":           "adjustments",
    "InsuranceRefundAdjustmentCancellation": "adjustments",
    "InsuranceRefundAdjustmentRebill":     "adjustments",
}


def _sqlite_writeback_appointment(resource_data: dict, method: str) -> bool:
    """
    FIX-5: Write streaming appointment CREATE/UPDATE/DELETE events back to
    the local SQLite appointments table so that status changes (e.g.
    UNCONFIRMED → COMPLETED) are reflected immediately.

    Without this, cursor-based sync only fetches NEW appointments by lastId
    and never re-fetches existing ones whose status changed.
    """
    record_id = resource_data.get("id")
    if not record_id:
        return False

    try:
        conn = _get_ascend_db()

        if method.upper() == "DELETE":
            with conn:
                conn.execute("DELETE FROM appointments WHERE id = ?", (record_id,))
            conn.close()
            logger.debug(f"SQLite appt write-back DELETE: id={record_id}")
            return True

        # Map appointment fields (same as sync.py _map_appointment)
        provider = resource_data.get("provider") or {}
        location = resource_data.get("location") or {}
        patient = resource_data.get("patient") or {}
        provider_id = provider.get("id") if isinstance(provider, dict) else str(provider or "")
        location_id = location.get("id") if isinstance(location, dict) else str(location or "")
        patient_id = patient.get("id") if isinstance(patient, dict) else str(patient or "")
        start = resource_data.get("start") or resource_data.get("startTime") or ""
        end = resource_data.get("end") or resource_data.get("endTime") or ""

        row = (
            record_id,
            start,
            end,
            resource_data.get("status"),
            provider_id,
            location_id,
            patient_id,
            resource_data.get("duration"),
            (resource_data.get("lastModified") or "")[:10],
            json.dumps(resource_data),
        )

        with conn:
            conn.execute(
                """INSERT OR REPLACE INTO appointments
                   (id, start_time, end_time, status, provider_id, location_id,
                    patient_id, duration, last_modified, raw)
                   VALUES (?,?,?,?,?,?,?,?,?,?)""",
                row,
            )
        conn.close()
        logger.debug(f"SQLite appt write-back {method}: id={record_id} status={resource_data.get('status')}")
        return True

    except Exception as e:
        logger.error(f"SQLite appt write-back error: {e} id={record_id}")
        return False


def _sqlite_writeback(resource_data: dict, method: str) -> bool:
    """
    FIX-3/FIX-4: Write streaming UPDATE/CREATE/DELETE events back to the local
    SQLite transaction tables so that distributions and field changes are
    reflected without waiting for the next cursor-based sync cycle.

    This is critical because:
    - Cursor-based sync only fetches NEW records (by lastId) — never re-fetches updates.
    - Insurance payments are often created with empty distributions; distributions are
      populated via a subsequent UPDATE event in Dentrix.
    - Without this write-back, distributions remain empty in SQLite indefinitely.
    - DELETE events (voided/cancelled transactions) need to mark is_active=0.
    """
    record_id = resource_data.get("id")
    if not record_id:
        return False

    ledger_type = resource_data.get("ledgerType")
    table = LEDGER_TYPE_TO_TABLE.get(ledger_type)
    if not table:
        return False  # Not a transaction type we track

    try:
        provider = resource_data.get("provider") or {}
        location = resource_data.get("location") or {}
        patient = resource_data.get("patient") or {}
        provider_id = provider.get("id") if isinstance(provider, dict) else provider
        location_id = location.get("id") if isinstance(location, dict) else location
        patient_id = patient.get("id") if isinstance(patient, dict) else patient

        conn = _get_ascend_db()

        if method.upper() == "DELETE":
            # FIX-3: Mark deleted records as inactive rather than removing them
            # (preserves referential integrity for distribution joins)
            with conn:
                conn.execute(
                    f"UPDATE {table} SET is_active = 0 WHERE id = ?",
                    (record_id,)
                )
            conn.close()
            logger.debug(f"SQLite write-back DELETE: {table} id={record_id}")
            return True

        # CREATE or UPDATE: full upsert with latest raw JSON
        entry_date = (resource_data.get("entryDate") or resource_data.get("entryDateTime") or "")[:26]
        tx_date = (
            resource_data.get("transactionDate") or
            entry_date[:10]
        )

        if table == "insurance_payments":
            # insurance_payments has 12 columns (extra: claim_location_id, entry_date)
            claim_loc = None
            dists = resource_data.get("distributions") or []
            if dists and isinstance(dists, list):
                claim_loc = dists[0].get("chargeLocationId")
            row = (
                record_id, tx_date,
                float(resource_data.get("amount") or 0),
                provider_id, location_id, patient_id, ledger_type,
                1 if resource_data.get("isActive", True) else 0,
                (resource_data.get("lastModified") or "")[:10],
                json.dumps(resource_data),
                claim_loc,    # claim_location_id
                entry_date,   # entry_date
            )
        else:
            # procedures, patient_payments, adjustments: 11 columns (+entry_date)
            row = (
                record_id, tx_date,
                float(resource_data.get("amount") or 0),
                provider_id, location_id, patient_id, ledger_type,
                1 if resource_data.get("isActive", True) else 0,
                (resource_data.get("lastModified") or "")[:10],
                json.dumps(resource_data),
                entry_date,   # entry_date
            )

        with conn:
            conn.execute(
                f"INSERT OR REPLACE INTO {table} VALUES ({','.join(['?']*len(row))})",
                row,
            )
            # Materialize distribution_lines for this payment/adjustment
            # so insurance/patient collections stay current in real-time.
            if table in ("insurance_payments", "patient_payments", "adjustments"):
                _rebuild_dl_for_item(conn, table, resource_data)
        conn.close()
        logger.debug(f"SQLite write-back {method}: {table} id={record_id} ledger={ledger_type}")
        return True

    except Exception as e:
        logger.warning(f"SQLite write-back failed ({table}/{method}/{record_id}): {e}")
        return False


def _write_event(event_type: str, resource_type: str, resource_id: Optional[str],
                 location_id: Optional[str], payload: dict):
    """Write a streaming event to the local events table for SSE delivery."""
    try:
        conn = _get_events_db()
        conn.execute(
            """INSERT INTO stream_events
               (event_type, resource_type, resource_id, location_id, org_id, payload)
               VALUES (?, ?, ?, ?, ?, ?)""",
            (event_type, resource_type, resource_id, location_id, ORG_ID,
             json.dumps(payload, default=str)),
        )
        conn.commit()
        conn.close()
    except Exception as e:
        logger.warning(f"Failed to write local stream event: {e}")


def get_recent_events(since_id: int = 0, limit: int = 50) -> list:
    """Read events newer than since_id from the local events table."""
    try:
        conn = _get_events_db()
        rows = conn.execute(
            "SELECT * FROM stream_events WHERE id > ? ORDER BY id ASC LIMIT ?",
            (since_id, limit),
        ).fetchall()
        conn.close()
        return [dict(r) for r in rows]
    except Exception as e:
        logger.warning(f"Failed to read stream events: {e}")
        return []


def get_latest_event_id() -> int:
    try:
        conn = _get_events_db()
        row = conn.execute("SELECT MAX(id) as max_id FROM stream_events").fetchone()
        conn.close()
        return row["max_id"] or 0
    except Exception:
        return 0


