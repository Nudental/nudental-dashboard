def _get_provider_specialty(provider_id: str, provider_name: str) -> dict:
    """
    Return the specialty classification for a provider.

    Lookup order:
    1. _PROVIDER_SPECIALTY_MAP by provider_id (explicit mapping)
    2. Derive from _lookup_provider_type(name):
       - hygienist → Hygiene / Hygienist
       - unattributed → Unattributed / Unattributed Office-Level
       - doctor → GP / General Practitioner (fallback for unmapped doctors)
    3. Unknown / Unmapped if neither applies
    """
    # Direct map lookup
    entry = _PROVIDER_SPECIALTY_MAP.get(provider_id or "")
    if entry:
        return {
            "specialtyGroup":      entry["specialtyGroup"],
            "specialtyLabel":      entry["specialtyLabel"],
            "isSpecialtyProvider": entry["isSpecialtyProvider"],
            "mappingSource":       entry["mappingSource"],
        }

    # Special synthetic row
    if provider_id == "UNATTRIBUTED_OFFICE_LEVEL":
        return {
            "specialtyGroup":      "Unattributed",
            "specialtyLabel":      "Unattributed Office-Level",
            "isSpecialtyProvider": None,
            "mappingSource":       "synthetic_residual",
        }

    # Derive from name-based type lookup
    ptype = _lookup_provider_type(provider_name)
    if ptype == "hygienist":
        return {
            "specialtyGroup":      "Hygiene",
            "specialtyLabel":      "Hygienist",
            "isSpecialtyProvider": False,
            "mappingSource":       "name_type_inferred",
        }

    # Fallback: unmapped doctor-type provider
    return {
        "specialtyGroup":      "Unknown",
        "specialtyLabel":      "Unmapped Provider Specialty",
        "isSpecialtyProvider": None,
        "mappingSource":       "unmapped",
    }


