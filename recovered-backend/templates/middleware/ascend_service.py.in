logger = logging.getLogger("ascend_service")

PROD_CREDS_PATH = "/home/openclaw/.config/ascend/production.json"

# ---------------------------------------------------------------------------
# Simple TTL Cache
# ---------------------------------------------------------------------------

_cache: Dict[str, Dict] = {}


def _cache_key(*args) -> str:
    return "|".join(str(a) for a in args)


def _cache_get(key: str) -> Optional[Any]:
    entry = _cache.get(key)
    if entry and time.time() < entry["expires"]:
        return entry["value"]
    return None


def _cache_set(key: str, value: Any, ttl: int = 300):
    _cache[key] = {"value": value, "expires": time.time() + ttl}


def _cache_clear():
    _cache.clear()


# ---------------------------------------------------------------------------
# Precomputed production_by_month lookup
# PDF-authoritative values for Jan-Apr 2026; computed values for other months
# ---------------------------------------------------------------------------

def _get_precomputed(location_id: str, year: int, month: int) -> Optional[dict]:
    """
    Look up precomputed production/collections for a single office + calendar month.
    Returns dict with net_production, collections, gross_production or None if not found.
    """
    try:
        conn = get_db()
        row = conn.execute(
            "SELECT gross_production, net_production, collections, source FROM production_by_month "
            "WHERE location_id = ? AND year = ? AND month = ?",
            (location_id, year, month)
        ).fetchone()
        conn.close()
        if row:
            return {
                "grossProduction": float(row["gross_production"] or 0),
                "netProduction": float(row["net_production"] or 0),
                "collections": float(row["collections"] or 0),
                "source": f"precomputed:{row['source']}",
            }
    except Exception as e:
        logger.warning(f"_get_precomputed lookup failed: {e}")
    return None


def _get_precomputed_all_offices(year: int, month: int) -> Optional[dict]:
    """
    Sum precomputed values for ALL offices in a given calendar month.
    Returns aggregated dict or None if any office is missing from the precomputed table.
    """
    KNOWN_LOCATION_IDS = [
        "14000000000432",  # Staten Island
        "14000000000433",  # Eatontown
        "14000000000434",  # Barnegat
        "14000000000435",  # Brick
    ]
    try:
        conn = get_db()
        row = conn.execute(
            "SELECT SUM(gross_production) as gross, SUM(net_production) as net, "
            "SUM(collections) as coll, COUNT(*) as cnt "
            "FROM production_by_month WHERE year = ? AND month = ? AND location_id IN "
            "('14000000000432','14000000000433','14000000000434','14000000000435')",
            (year, month)
        ).fetchone()
        conn.close()
        # Only use if all 4 offices have precomputed data
        if row and row["cnt"] == 4 and row["net"] is not None:
            return {
                "grossProduction": float(row["gross"] or 0),
                "netProduction": float(row["net"] or 0),
                "collections": float(row["coll"] or 0),
                "source": "precomputed:all_offices_aggregated",
            }
    except Exception as e:
        logger.warning(f"_get_precomputed_all_offices failed: {e}")
    return None


def _parse_month_key(start_date: str, end_date: str) -> Optional[tuple]:
    """
    Returns (year, month) ONLY when the query covers the COMPLETE calendar month
    (start = 1st day, end = last day of the same month). This prevents partial
    queries (e.g., Apr 1 only, or Apr 1–Apr 20) from returning the full-month
    precomputed total, which would inflate numbers for single-day views.
    Multi-month, partial-month, and single-day ranges all return None (live path).
    """
    try:
        import calendar
        from datetime import date as _d
        s = _d.fromisoformat(start_date)
        e = _d.fromisoformat(end_date)
        last_day = calendar.monthrange(s.year, s.month)[1]
        if s.day == 1 and s.month == e.month and s.year == e.year and e.day == last_day:
            return (s.year, s.month)
    except Exception:
        pass
    return None


def _parse_verified_month_key(start_date: str, end_date: str, location_id: Optional[str] = None) -> Optional[tuple]:
    """
    Returns (year, month) for partial-month queries when Ascend-verified data covers
    the requested range. Allows Apr 1–24 queries to use the PDF-authoritative precomputed
    value instead of the mis-attributed live data.

    Triggers when:
      - Query starts on the 1st of a month
      - Query end is within the same month (partial month OK)
      - production_by_month has source='ascend_verified_hybrid' for that month/location
    """
    try:
        from datetime import date as _d
        s = _d.fromisoformat(start_date)
        e = _d.fromisoformat(end_date)
        if s.day != 1 or s.month != e.month or s.year != e.year:
            return None
        # Check if production_by_month has verified data for this month
        with _get_db_conn() as conn:
            if location_id:
                row = conn.execute(
                    "SELECT 1 FROM production_by_month WHERE year=? AND month=? "
                    "AND location_id=? AND source LIKE 'ascend_verified%'",
                    (s.year, s.month, location_id)
                ).fetchone()
            else:
                # All-offices: check that ALL 4 offices have verified data
                row = conn.execute(
                    "SELECT COUNT(*) FROM production_by_month WHERE year=? AND month=? "
                    "AND source LIKE 'ascend_verified%'",
                    (s.year, s.month)
                ).fetchone()
                row = row if (row and row[0] >= 4) else None
        if row:
            return (s.year, s.month)
    except Exception:
        pass
    return None


def _get_db_conn():
    """Thin wrapper returning a sqlite3 connection to the ascend DB."""
    return get_db()


# Keep old name as alias for backward compat
_parse_full_month = _parse_month_key


def recompute_month(location_id: str, year: int, month: int, force: bool = False) -> dict:
    """
    Compute production and collections for a location+month from SQLite raw tables
    and store in production_by_month. Skips if row already exists (unless force=True).
    Used by: post-sync hooks, backfill jobs, admin triggers.
    """
    import calendar as _cal

    last_day = _cal.monthrange(year, month)[1]
    start = f"{year}-{month:02d}-01"
    end = f"{year}-{month:02d}-{last_day:02d}"

    if not force:
        # Check if precomputed row exists
        existing = _get_precomputed(location_id, year, month)
        if existing:
            return {"skipped": True, "location_id": location_id, "year": year, "month": month,
                    "reason": "already_computed"}

    # Protect PDF-authoritative rows from being overwritten by computed values.
    # ascend_verified_hybrid rows come from import_dentrix_report.py and are the
    # ground truth for historical months. Only overwrite them if explicitly requested
    # via force=True AND force_override_pdf=True (separate gate).
    try:
        _conn = get_db()
        _pdf_row = _conn.execute(
            "SELECT source FROM production_by_month WHERE location_id=? AND year=? AND month=?",
            (location_id, year, month)
        ).fetchone()
        _conn.close()
        if _pdf_row and _pdf_row["source"] in ("ascend_verified_hybrid", "pdf_authoritative"):
            return {
                "skipped": True, "location_id": location_id, "year": year, "month": month,
                "reason": "pdf_authoritative_protected",
                "source": _pdf_row["source"],
            }
    except Exception:
        pass  # If check fails, proceed with computation

    if not _db_has_data("procedures"):
        return {"error": "no_procedures_data"}

    try:
        conn = get_db()

        # Gross production from procedures
        # FIX-4: Remove is_active=1 filter — cancelled procedures net to zero naturally
        row = conn.execute(
            "SELECT COALESCE(SUM(amount), 0) as total FROM procedures "
            "WHERE transaction_date >= ? AND transaction_date <= ? AND location_id = ? AND provider_id IS NOT NULL",
            (start, end, location_id)
        ).fetchone()
        gross = float(row["total"] if row else 0)

        # Credit adjustments (write-offs) — PatientCreditAdjustment + PatientCreditAdjustmentRebill (is_active=1)
        # Rebills are corrected write-off amounts posted after a cancellation/rebill cycle.
        # When Dentrix properly deactivates the original (is_active=0), only the Rebill remains.
        # When Dentrix leaves the original active (inconsistent), both exist but Cancellations
        # offset them. Including Rebills here is validated against eAssist benchmarks (2.5% gap
        # vs 30%+ gap previously — residual is date-attribution methodology difference).
        # PatientCreditAdjustmentCancellation excluded: including them worsens accuracy.
        # FIX-DIST: Attribute adjustments to procedure location via distribution_lines.
        # PatientCreditAdjustmentCancellation has no DL → falls back to adj.location_id.
        adj_row = conn.execute(
            "SELECT COALESCE(SUM(amount), 0) as total FROM adjustments "
            "WHERE transaction_date >= ? AND transaction_date <= ? AND is_active = 1 "
            "AND ledger_type IN ('PatientCreditAdjustment','PatientCreditAdjustmentRebill') "
            "AND ( "
            "  EXISTS (SELECT 1 FROM distribution_lines dl WHERE dl.transaction_id = adjustments.id "
            "           AND dl.source_table = 'adjustments' AND dl.charge_location_id = ?) "
            "  OR (NOT EXISTS (SELECT 1 FROM distribution_lines dl2 WHERE dl2.transaction_id = adjustments.id "
            "                  AND dl2.source_table = 'adjustments') AND adjustments.location_id = ?) "
            ")",
            (start, end, location_id, location_id)
        ).fetchone()
        all_adj = float(adj_row["total"] if adj_row else 0)
        net = gross + all_adj

        # Collections: ABS(SUM) of patient + insurance payments
        # FIX-DIST: Attribute payments to procedure location via distribution_lines.
        # Cancellation types have no DL → fall back to t.location_id.
        coll = 0.0
        for tbl, lf in [
            ("patient_payments",   "ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill','PatientProcedurePaymentCancellation')"),
            ("insurance_payments", "ledger_type IN ('InsurancePayment','InsurancePaymentRebill','InsurancePaymentCancellation')"),
        ]:
            if _db_has_data(tbl):
                # FIX-CLAIM: For insurance_payments, the no-DL fallback uses
                # COALESCE(claim_location_id, location_id) so that payments tagged with
                # the billing office are re-attributed to the claim's service location.
                if tbl == "insurance_payments":
                    loc_expr = f"COALESCE({tbl}.claim_location_id, {tbl}.location_id)"
                else:
                    loc_expr = f"{tbl}.location_id"
                c_row = conn.execute(
                    f"SELECT COALESCE(ABS(SUM(amount)), 0) as total FROM {tbl} "
                    f"WHERE transaction_date >= ? AND transaction_date <= ? "
                    f"AND {lf} "
                    f"AND ( "
                    f"  EXISTS (SELECT 1 FROM distribution_lines dl WHERE dl.transaction_id = {tbl}.id "
                    f"           AND dl.source_table = ? AND dl.charge_location_id = ?) "
                    f"  OR (NOT EXISTS (SELECT 1 FROM distribution_lines dl2 WHERE dl2.transaction_id = {tbl}.id "
                    f"                  AND dl2.source_table = ?) AND {loc_expr} = ?) "
                    f")",
                    (start, end, tbl, location_id, tbl, location_id)
                ).fetchone()
                coll += float(c_row["total"] if c_row else 0)

        conn.execute(
            "INSERT OR REPLACE INTO production_by_month "
            "(location_id, year, month, gross_production, net_production, collections, last_computed, source) "
            "VALUES (?, ?, ?, ?, ?, ?, datetime('now'), 'computed')",
            (location_id, year, month, round(gross, 2), round(net, 2), round(coll, 2))
        )
        conn.commit()
        conn.close()

        return {
            "location_id": location_id, "year": year, "month": month,
            "gross_production": round(gross, 2), "net_production": round(net, 2),
            "collections": round(coll, 2), "source": "computed",
        }
    except Exception as e:
        logger.exception(f"recompute_month failed for {location_id} {year}-{month}")
        return {"error": str(e)}


# ---------------------------------------------------------------------------
# Module-level singleton client
# ---------------------------------------------------------------------------

_client: Optional[AscendClient] = None


def get_client() -> AscendClient:
    global _client
    if _client is None:
        _client = AscendClient(creds_path=PROD_CREDS_PATH)
        _client.authenticate()
    return _client


# ---------------------------------------------------------------------------
# DB helpers
# ---------------------------------------------------------------------------

def _db_has_data(table: str) -> bool:
    """Check if a table has any records."""
    try:
        conn = get_db()
        row = conn.execute(f"SELECT COUNT(*) as cnt FROM {table}").fetchone()
        conn.close()
        return (row["cnt"] if row else 0) > 0
    except Exception:
        return False


def _db_query(sql: str, params: tuple = (), timeout_sec: int = 45) -> List[sqlite3.Row]:
    """Run a SQLite query and return rows.  Raises RuntimeError if it exceeds timeout_sec."""
    import threading, queue as _queue

    result_q: _queue.Queue = _queue.Queue()

    def _run() -> None:
        try:
            conn = get_db()
            rows = conn.execute(sql, params).fetchall()
            conn.close()
            result_q.put(("ok", rows))
        except Exception as exc:          # noqa: BLE001
            result_q.put(("err", exc))

    t = threading.Thread(target=_run, daemon=True)
    t.start()
    try:
        kind, payload = result_q.get(timeout=timeout_sec)
    except _queue.Empty:
        raise RuntimeError(f"SQLite query timed out after {timeout_sec}s")
    if kind == "err":
        raise payload  # re-raise original exception
    return payload


# ---------------------------------------------------------------------------
# Direct API pagination (for small/non-date-filtered endpoints)
# ---------------------------------------------------------------------------

def _fetch_all_pages(
    path: str,
    params: Optional[dict] = None,
    max_pages: int = 50,
    max_items: int = 25000,
    page_size: int = 500,
) -> List[dict]:
    """Cursor-based pagination from Dentrix Ascend API."""
    client = get_client()
    all_items = []

    base_params = dict(params or {})
    base_params["pageSize"] = page_size
    last_id: Optional[str] = None

    for page_num in range(max_pages):
        if len(all_items) >= max_items:
            break

        req_params = dict(base_params)
        if last_id:
            req_params["lastId"] = last_id

        status, body, elapsed = client.get(path, params=req_params)

        if status != 200:
            logger.warning(f"GET {path} lastId={last_id} returned {status}")
            break

        if isinstance(body, list):
            items = body
        elif isinstance(body, dict):
            items = body.get("data", body.get("items", body.get("results", [])))
            if not isinstance(items, list):
                all_items.append(body)
                break
        else:
            break

        all_items.extend(items)

        if len(items) < page_size:
            break

        new_last_id = items[-1].get("id") if items else None
        if not new_last_id or new_last_id == last_id:
            break
        last_id = new_last_id

    return all_items


# ---------------------------------------------------------------------------
# Date helpers
# ---------------------------------------------------------------------------

def _today() -> str:
    return date.today().isoformat()


def _month_start() -> str:
    d = date.today()
    return d.replace(day=1).isoformat()


# ---------------------------------------------------------------------------
# Service class
# ---------------------------------------------------------------------------

class AscendService:

    # -- Sync status --

    def get_sync_status(self) -> dict:
        try:
            from sync import get_db_stats
            stats = get_db_stats()
            return {"status": "ok", "tables": stats}
        except Exception as e:
            return {"status": "error", "error": str(e)}

    # -- Offices --

    def get_offices(self) -> List[dict]:
        key = _cache_key("offices")
        cached = _cache_get(key)
        if cached is not None:
            return cached

        # Use DB if available, else direct API
        if _db_has_data("locations"):
            rows = _db_query("SELECT raw FROM locations")
            result = [self._map_office(json.loads(r["raw"])) for r in rows]
        else:
            items = _fetch_all_pages("/v1/locations", page_size=100)
            result = [self._map_office(x) for x in items]

        _cache_set(key, result, ttl=60)
        return result

    def _map_office(self, raw: dict) -> dict:
        addr_parts = [raw.get("address1") or raw.get("address") or ""]
        if raw.get("address2"):
            addr_parts.append(raw["address2"])
        address = ", ".join(p for p in addr_parts if p) or None
        return {
            "id": raw.get("id"),
            "name": raw.get("name"),
            "address": address,
            "city": raw.get("city"),
            "state": raw.get("state"),
            "zip": raw.get("postalCode") or raw.get("zip"),
            "phone": raw.get("phone"),
            "email": raw.get("email"),
            "website": raw.get("website"),
            "timezone": raw.get("timeZone"),
            "isActive": raw.get("active", True),
        }

    # -- Providers --

    def get_providers(self) -> List[dict]:
        key = _cache_key("providers")
        cached = _cache_get(key)
        if cached is not None:
            return cached

        if _db_has_data("providers"):
            rows = _db_query("SELECT raw FROM providers ORDER BY last_name, first_name")
            result = [self._map_provider(json.loads(r["raw"])) for r in rows]
        else:
            items = _fetch_all_pages("/v1/providers", page_size=500)
            result = [self._map_provider(x) for x in items]

        _cache_set(key, result, ttl=60)
        return result

    def _map_provider(self, raw: dict) -> dict:
        first = raw.get("firstName") or ""
        last = raw.get("lastName") or ""
        name = f"{first} {last}".strip() or raw.get("shortName") or ""
        return {
            "id": raw.get("id"),
            "name": name,
            "firstName": first,
            "lastName": last,
            "title": raw.get("title"),
            "npi": raw.get("npi"),
            "specialty": raw.get("specialty"),
            "isActive": raw.get("active", True),
            "isPrimary": raw.get("isPrimaryProvider", False),
        }

    # -- Patients --

    def get_patients(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
        limit: int = 100,
    ) -> List[dict]:
        key = _cache_key("patients", start_date, end_date, location_id, limit)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        if _db_has_data("patients"):
            sql = "SELECT raw FROM patients WHERE 1=1"
            params_list = []
            if start_date:
                sql += " AND created_date >= ?"
                params_list.append(start_date)
            if end_date:
                sql += " AND created_date <= ?"
                params_list.append(end_date)
            if location_id:
                sql += " AND location_id = ?"
                params_list.append(location_id)
            sql += f" ORDER BY created_date DESC LIMIT {limit}"
            rows = _db_query(sql, tuple(params_list))
            result = [self._map_patient(json.loads(r["raw"])) for r in rows]
        else:
            # Direct API fallback
            params: dict = {}
            if start_date:
                params["startDate"] = start_date
            if end_date:
                params["endDate"] = end_date
            items = _fetch_all_pages("/v1/patients", params=params, max_items=limit, page_size=min(limit, 500))
            result = [self._map_patient(x) for x in items]
            if location_id:
                result = [row for row in result if str(row.get("locationId")) == str(location_id)]
            result = result[:limit]

        _cache_set(key, result, ttl=60)
        return result

    def get_patients_summary(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        key = _cache_key("patients_summary", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()
        location_ids = list(dict.fromkeys(location_id.split(','))) if location_id else []
        location_placeholders = ','.join('?' for _ in location_ids)

        # New patient = patient whose earliest appointment falls within the date range
        # (Dentrix API returns NO creation date for patients, so we use first appointment)
        if _db_has_data("appointments"):
            sql = """
                SELECT COUNT(*) as cnt FROM (
                    SELECT patient_id, MIN(substr(start_time, 1, 10)) as first_appt
                    FROM appointments
                    WHERE patient_id IS NOT NULL
            """
            params_list: list = []
            if location_id:
                sql += " AND location_id IN (" + location_placeholders + ")"
                params_list.extend(location_ids)
            sql += """
                    GROUP BY patient_id
                    HAVING first_appt >= ? AND first_appt <= ?
                )
            """
            params_list.extend([start, end])
            rows = _db_query(sql, tuple(params_list))
            new_patients = rows[0]["cnt"] if rows else 0
        else:
            new_patients = 0

        # Unique patients = distinct patients who had any procedure in the date range
        unique_patients = 0
        if _db_has_data("procedures"):
            sql2 = "SELECT COUNT(DISTINCT patient_id) as cnt FROM procedures WHERE patient_id IS NOT NULL AND transaction_date >= ? AND transaction_date <= ? AND is_active = 1"
            params2: list = [start, end]
            if location_id:
                sql2 += " AND location_id IN (" + location_placeholders + ")"
                params2.extend(location_ids)
            rows2 = _db_query(sql2, tuple(params2))
            unique_patients = rows2[0]["cnt"] if rows2 else 0

        result = {
            "startDate": start,
            "endDate": end,
            "newPatients": new_patients,
            "uniquePatients": unique_patients,
            "activePatients": unique_patients,
            "source": "sqlite" if _db_has_data("appointments") else "unavailable",
            "method": "first_appointment_date",
        }
        _cache_set(key, result, ttl=60)
        return result

    def _map_patient(self, raw: dict) -> dict:
        first = raw.get("firstName") or raw.get("first") or ""
        last = raw.get("lastName") or raw.get("last") or ""
        provider = raw.get("provider") or {}
        location = raw.get("location") or {}
        created = raw.get("created") or raw.get("createdDate") or raw.get("entryDate") or ""
        return {
            "id": raw.get("id"),
            "firstName": first,
            "lastName": last,
            "name": f"{first} {last}".strip(),
            "email": raw.get("email") or raw.get("emailAddress"),
            "phone": raw.get("phone") or raw.get("phoneNumber") or raw.get("mobilePhone"),
            "dateOfBirth": raw.get("dateOfBirth") or raw.get("dob"),
            "createdDate": str(created)[:10] if created else None,
            "locationId": location.get("id") if isinstance(location, dict) else location,
        }

    # -- Appointments --

    def get_appointments(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        provider_id: Optional[str] = None,
        location_id: Optional[str] = None,
        status: Optional[str] = None,
    ) -> List[dict]:
        key = _cache_key("appointments", start_date, end_date, provider_id, location_id, status)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _today()
        end = end_date or _today()

        if _db_has_data("appointments"):
            sql = """
                SELECT raw FROM appointments
                WHERE substr(start_time, 1, 10) >= ? AND substr(start_time, 1, 10) <= ?
            """
            params_list: list = [start, end]
            if provider_id:
                sql += " AND provider_id = ?"
                params_list.append(provider_id)
            if location_id:
                sql += " AND location_id = ?"
                params_list.append(location_id)
            if status:
                sql += " AND status = ?"
                params_list.append(status.upper())
            sql += " ORDER BY start_time"
            rows = _db_query(sql, tuple(params_list))
            result = [self._map_appointment(json.loads(r["raw"])) for r in rows]
        else:
            # Direct API — fetch some pages and filter client-side
            items = _fetch_all_pages("/v1/appointments", max_items=5000, page_size=500)
            filtered = [a for a in items if self._appt_in_range(a, start, end, provider_id, location_id, status)]
            result = [self._map_appointment(x) for x in filtered]

        _cache_set(key, result, ttl=60)
        return result

    def _appt_in_range(self, a: dict, start: str, end: str, provider_id=None, location_id=None, status=None) -> bool:
        appt_start = str(a.get("start") or a.get("startTime") or "")[:10]
        if appt_start and not (start <= appt_start <= end):
            return False
        if provider_id:
            prov = a.get("provider") or {}
            prov_id = prov.get("id") if isinstance(prov, dict) else prov
            if prov_id != provider_id:
                return False
        if location_id:
            loc = a.get("location") or {}
            loc_id = loc.get("id") if isinstance(loc, dict) else loc
            if loc_id != location_id:
                return False
        if status:
            if str(a.get("status") or "").upper() != status.upper():
                return False
        return True

    def _map_appointment(self, raw: dict) -> dict:
        patient = raw.get("patient") or {}
        provider = raw.get("provider") or {}
        location = raw.get("location") or {}
        operatory = raw.get("operatory") or {}
        return {
            "id": raw.get("id"),
            "patientId": patient.get("id") if isinstance(patient, dict) else patient,
            "providerId": provider.get("id") if isinstance(provider, dict) else provider,
            "locationId": location.get("id") if isinstance(location, dict) else location,
            "operatoryId": operatory.get("id") if isinstance(operatory, dict) else operatory,
            "startTime": raw.get("start") or raw.get("startTime"),
            "endTime": raw.get("end") or raw.get("endTime"),
            "duration": raw.get("duration"),
            "status": raw.get("status"),
            "title": raw.get("title"),
            "note": raw.get("note"),
            "bookedOnline": raw.get("bookedOnline", False),
            "needsFollowUp": raw.get("needsFollowUp", False),
        }

    # -- Production --

    def _get_adjustments_total(
        self,
        start: str,
        end: str,
        location_id: Optional[str] = None,
        provider_id: Optional[str] = None,
        charge_only: bool = True,
    ) -> float:
        """
        Sum adjustments for a date range.

        charge_only=True (default): only PatientChargeAdjustment* types,
        which are true production corrections (not insurance write-offs).

        charge_only=False: all adjustments including insurance write-offs
        (PatientCreditAdjustment*) — useful for AR calculations.

        FIX-2: When provider_id is requested, PatientCreditAdjustment* records have
        NULL provider_id in the API (the provider field is absent on write-offs).
        We must use the distributions→chargeId→procedures join to attribute them.
        PatientChargeAdjustment* records DO carry provider_id directly, so no change needed.
        """
        if not _db_has_data("adjustments"):
            return 0.0

        # --- Charge adjustments: provider_id column IS populated, simple filter ---
        charge_sql = """
            SELECT COALESCE(SUM(amount), 0) as total
            FROM adjustments
            WHERE transaction_date >= ? AND transaction_date <= ?
              AND is_active = 1
              AND ledger_type IN (
                  'PatientChargeAdjustment',
                  'PatientChargeAdjustmentCancellation',
                  'PatientChargeAdjustmentRebill'
              )
        """
        charge_params: list = [start, end]
        if location_id:
            charge_sql = charge_sql.replace("AND is_active", "AND location_id = ? AND is_active")
            charge_params.insert(2, location_id)
        if provider_id:
            charge_sql = charge_sql.replace("AND is_active", "AND provider_id = ? AND is_active")
            charge_params.insert(-1 if location_id else 2, provider_id)

        charge_rows = _db_query(charge_sql, tuple(charge_params))
        charge_total = float(charge_rows[0]["total"]) if charge_rows else 0.0

        if charge_only:
            return charge_total

        # --- Credit adjustments: provider_id is always NULL; use distributions join ---
        # This is slower but necessary for per-provider accuracy.
        # FIX-3: Use appliedAmount from each distribution entry (not adj.amount).
        # adj.amount is the TOTAL for the whole adjustment; using it in a per-distribution
        # join causes N-times overcounting when an adjustment spans multiple procedures.
        # appliedAmount is the per-procedure share. Sign follows adj.amount sign:
        #   write-offs (adj.amount < 0) → negate appliedAmount → negative contribution
        #   cancellations (adj.amount > 0) → keep positive → production add-back
        if provider_id and _db_has_data("procedures"):
            credit_sql = """
                SELECT COALESCE(SUM(
                    CASE WHEN adj.amount < 0
                         THEN -CAST(d.value->>'appliedAmount' AS REAL)
                         ELSE  CAST(d.value->>'appliedAmount' AS REAL)
                    END
                ), 0) as total
                FROM adjustments adj,
                     json_each(json_extract(adj.raw, '$.distributions')) d
                JOIN procedures pr ON pr.id = (d.value->>'chargeId')
                WHERE adj.transaction_date >= ? AND adj.transaction_date <= ?
                  AND adj.is_active = 1
                  AND adj.ledger_type IN (
                      'PatientCreditAdjustment',
                      'PatientCreditAdjustmentRebill'
                  )
                  AND pr.provider_id = ?
            """
            # PatientCreditAdjustmentCancellation excluded: validated against eAssist. Include Rebill for corrected write-offs.
            credit_params: list = [start, end, provider_id]
            if location_id:
                credit_sql += " AND adj.location_id = ?"
                credit_params.append(location_id)
        else:
            # No provider filter: allocate credit adjustments to the *procedure* date range,
            # Simple approach: filter adjustments by their posting date only.
            # The procedure-JOIN approach caused zero-production days to show $0 adjustments
            # (no procedures to join = no results) even when write-offs were processed.
            # Monthly precomputed values (production_by_month) handle the full-month
            # accuracy case; this live path serves partial/single-day views where
            # posting-date attribution is correct and useful.
            # Live path (daily / partial-month): PatientCreditAdjustment only.
            # Matches eAssist daily reporting exactly. Rebill-inclusive formula is
            # reserved for recompute_month (monthly precomputed) where it improves
            # accuracy without daily double-counting risk.
            credit_sql = """
                SELECT COALESCE(SUM(amount), 0) as total
                FROM adjustments
                WHERE transaction_date >= ? AND transaction_date <= ?
                  AND is_active = 1
                  AND ledger_type = 'PatientCreditAdjustment'
            """
            credit_params = [start, end]
            if location_id:
                # FIX-DIST: Attribute adjustments to procedure location via distribution_lines.
                # PatientCreditAdjustmentCancellation (no DL) falls back to adj.location_id.
                credit_sql += (
                    " AND ( "
                    "   EXISTS (SELECT 1 FROM distribution_lines dl WHERE dl.transaction_id = adjustments.id "
                    "            AND dl.source_table = 'adjustments' AND dl.charge_location_id = ?) "
                    "   OR (NOT EXISTS (SELECT 1 FROM distribution_lines dl2 WHERE dl2.transaction_id = adjustments.id "
                    "                   AND dl2.source_table = 'adjustments') AND adjustments.location_id = ?) "
                    ")"
                )
                credit_params.extend([location_id, location_id])

        credit_rows = _db_query(credit_sql, tuple(credit_params))
        credit_total = float(credit_rows[0]["total"]) if credit_rows else 0.0

        return charge_total + credit_total

    def get_production_summary(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
        provider_id: Optional[str] = None,
    ) -> dict:
        key = _cache_key("prod_summary", start_date, end_date, location_id, provider_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        # --- Precomputed path DISABLED ---
        # Dr. G directive: dashboard must accumulate daily EOD data (same formula as EOD report).
        # No PDF-imported monthly overrides. All queries go through the live EOD-identical path.

        # Shared production-adjustment types used across all endpoints
        # Variant B (2026-04-28): procedures by entry_date, adjustments by transaction_date,
        # including active Cancellation rows to net write-off reversals — validated within
        # $10,000 of both Dentrix benchmarks ($1,020,192.12 and $1,020,022.06).
        PROD_ADJ_TYPES = (
            'PatientCreditAdjustment',
            'PatientCreditAdjustmentRebill',
            'PatientCreditAdjustmentCancellation',
            'PatientChargeAdjustment',
            'PatientChargeAdjustmentRebill',
            'PatientChargeAdjustmentCancellation',
        )
        PROD_LEDGER_TYPES = (
            'PatientProcedureLedger',
            'PatientProcedureLedgerRebill',
        )

        if _db_has_data("procedures"):
            sql_parts = [
                "SELECT COALESCE(SUM(amount), 0) as total, COUNT(*) as cnt",
                "FROM procedures",
                "WHERE entry_date >= ? AND entry_date < ?",
                "  AND is_active = 1",
                "  AND ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')",
            ]
            # entry_date uses exclusive upper bound (< next day) to match full-day range
            end_excl = end[:10]  # ensure date-only, exclusive handled by < below
            params_list: list = [start, end[:10] + "T99" if "T" not in end else end]
            # Recompute: entry_date stored as full ISO string; use < day+1 for safe range
            import datetime as _dt
            end_date_excl = (
                _dt.date.fromisoformat(end[:10]) + _dt.timedelta(days=1)
            ).isoformat()
            params_list = [start, end_date_excl]
            sql_parts = [
                "SELECT COALESCE(SUM(amount), 0) as total, COUNT(*) as cnt",
                "FROM procedures",
                f"WHERE entry_date >= ? AND entry_date < ?",
                "  AND is_active = 1",
                "  AND ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')",
            ]
            if location_id:
                sql_parts.append("  AND location_id = ?")
                params_list.append(location_id)
            if provider_id:
                sql_parts.append("  AND provider_id = ?")
                params_list.append(provider_id)
            sql = "\n".join(sql_parts)

            rows = _db_query(sql, tuple(params_list))
            gross = float(rows[0]["total"]) if rows else 0.0
            count = rows[0]["cnt"] if rows else 0
        else:
            gross, count = 0.0, 0

        # Production adjustments: active rows, transaction_date filter,
        # including Cancellation types to net write-off reversals (Variant B)
        adj_sql_parts = [
            "SELECT COALESCE(SUM(amount), 0) as total",
            "FROM adjustments",
            "WHERE transaction_date >= ? AND transaction_date <= ?",
            "  AND is_active = 1",
            "  AND ledger_type IN ("
            "    'PatientCreditAdjustment','PatientCreditAdjustmentRebill','PatientCreditAdjustmentCancellation',"
            "    'PatientChargeAdjustment','PatientChargeAdjustmentRebill','PatientChargeAdjustmentCancellation'"
            "  )",
        ]
        adj_params: list = [start, end]
        if location_id:
            adj_sql_parts.append("  AND location_id = ?")
            adj_params.append(location_id)
        if provider_id:
            adj_sql_parts.append("  AND provider_id = ?")
            adj_params.append(provider_id)
        adj_rows = _db_query("\n".join(adj_sql_parts), tuple(adj_params))
        all_adj = float(adj_rows[0]["total"]) if adj_rows else 0.0

        net = gross + all_adj
        avg_per_visit = round(net / count, 2) if count > 0 else 0.0

        result = {
            "startDate": start,
            "endDate": end,
            "grossProduction": round(gross, 2),
            "netProduction": round(net, 2),
            "chargeAdjustments": 0.0,
            "writeOffs": round(abs(all_adj), 2) if all_adj < 0 else 0.0,
            "adjustments": round(all_adj, 2),
            "totalProduction": round(gross, 2),
            "procedureCount": count,
            "avgProductionPerVisit": avg_per_visit,
            "locationId": location_id,
            "providerId": provider_id,
            "source": "sqlite" if _db_has_data("procedures") else "unavailable",
        }
        _cache_set(key, result, ttl=60)
        return result

    def _get_provider_names(self) -> Dict[str, str]:
        """Get provider_id → display name mapping from SQLite."""
        key = _cache_key("provider_names")
        cached = _cache_get(key)
        if cached is not None:
            return cached
        try:
            rows = _db_query("SELECT id, first_name, last_name FROM providers")
            names = {r["id"]: f"{r['first_name']} {r['last_name']}".strip() for r in rows}
        except Exception:
            names = {}
        _cache_set(key, names, ttl=300)
        return names

    def get_production_by_provider(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        key = _cache_key("prod_by_provider", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        provider_names = self._get_provider_names()

        if _db_has_data("procedures"):
            # V353: Production per provider — uses entry_date to reconcile with
            # get_production_summary (Dr. G directive 2026-05-04: entry_date is
            # the permanent production date basis / Dentrix Modified Applied Date).
            # Uses exclusive upper bound (< next_day) same as get_production_summary.
            import datetime as _dt_pbp
            _end_excl_pbp = (
                _dt_pbp.date.fromisoformat(end[:10]) + _dt_pbp.timedelta(days=1)
            ).isoformat()
            sql = """
                SELECT provider_id, SUM(amount) as production, COUNT(*) as procedure_count
                FROM procedures
                WHERE entry_date >= ? AND entry_date < ? AND is_active = 1
                  AND ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')
            """
            params_list: list = [start, _end_excl_pbp]
            if location_id:
                sql += " AND location_id = ?"
                params_list.append(location_id)
            sql += " GROUP BY provider_id ORDER BY production DESC"

            # Also get primary location per provider (most procedures)
            loc_sql = """
                SELECT provider_id, location_id, COUNT(*) as cnt
                FROM procedures
                WHERE entry_date >= ? AND entry_date < ? AND is_active = 1
                  AND ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')
                GROUP BY provider_id, location_id
                ORDER BY provider_id, cnt DESC
            """
            loc_params: list = [start, _end_excl_pbp]
            loc_rows = _db_query(loc_sql, tuple(loc_params))
            # Keep only top location per provider
            primary_location: Dict[str, str] = {}
            for lr in loc_rows:
                pid = lr["provider_id"]
                if pid not in primary_location:
                    primary_location[pid] = lr["location_id"]

            # Get location names
            loc_name_rows = _db_query("SELECT id, name FROM locations", ())
            location_names: Dict[str, str] = {r["id"]: r["name"] for r in loc_name_rows}

            # Map Dentrix location_id → Supabase office UUID and canonical name
            # FIX-8 (2026-04-20): Use canonical office names everywhere, not raw SQLite location names
            DENTRIX_TO_OFFICE_ID: Dict[str, str] = {
                "14000000000432": "b0abcc46-55e8-4529-a28f-eedf41c1d72e",  # Staten Island
                "14000000000433": "220372a5-afae-49c9-8a0c-f4c0717ff352",  # Eatontown
                "14000000000434": "1c719b5b-fd77-4da8-a1b9-2209f1cea63e",  # Barnegat
                "14000000000435": "54626997-57c2-4934-8743-1dabb4d176f4",  # Brick
            }
            DENTRIX_TO_CANONICAL_NAME: Dict[str, str] = {
                "14000000000432": "Staten Island",
                "14000000000433": "Eatontown",
                "14000000000434": "Barnegat",
                "14000000000435": "Brick",
            }
            prod_rows = _db_query(sql, tuple(params_list))

            # Charge adjustments per provider — production-relevant types only (no cancellations)
            adj_sql = """
                SELECT provider_id, COALESCE(SUM(amount), 0) as adj_total
                FROM adjustments
                WHERE transaction_date >= ? AND transaction_date <= ? AND is_active = 1
                  AND ledger_type IN (
                      'PatientChargeAdjustment',
                      'PatientChargeAdjustmentRebill'
                  )
            """
            adj_params: list = [start, end]
            if location_id:
                adj_sql += " AND location_id = ?"
                adj_params.append(location_id)
            adj_sql += " GROUP BY provider_id"
            adj_rows = _db_query(adj_sql, tuple(adj_params)) if _db_has_data("adjustments") else []
            adj_by_provider: dict = {r["provider_id"]: float(r["adj_total"]) for r in adj_rows}

            # FIX-2: Credit adjustments (write-offs) per provider via distributions join.
            # PatientCreditAdjustment records have NULL provider_id in Dentrix API — the
            # provider field is absent. We must join distributions.chargeId → procedures
            # to attribute write-offs to the correct rendering provider.
            # FIX-3: Use appliedAmount (per-distribution share) not adj.amount (full total).
            # Summing adj.amount per distribution row causes N× overcounting when an
            # adjustment spans multiple procedures. Sign follows adj.amount sign.
            if _db_has_data("adjustments"):
                credit_loc_filter = "AND adj.location_id = ?" if location_id else ""
                credit_adj_sql = f"""
                    SELECT pr.provider_id,
                           COALESCE(SUM(
                               CASE WHEN adj.amount < 0
                                    THEN -CAST(d.value->>'appliedAmount' AS REAL)
                                    ELSE  CAST(d.value->>'appliedAmount' AS REAL)
                               END
                           ), 0) as credit_total
                    FROM adjustments adj,
                         json_each(json_extract(adj.raw, '$.distributions')) d
                    JOIN procedures pr ON pr.id = (d.value->>'chargeId')
                    WHERE adj.transaction_date >= ? AND adj.transaction_date <= ?
                      AND adj.is_active = 1
                      AND adj.ledger_type IN (
                          'PatientCreditAdjustment',
                          'PatientCreditAdjustmentCancellation',
                          'PatientCreditAdjustmentRebill'
                      )
                      {credit_loc_filter}
                    GROUP BY pr.provider_id
                """
                credit_adj_params: list = [start, end]
                if location_id:
                    credit_adj_params.append(location_id)
                try:
                    credit_adj_rows = _db_query(credit_adj_sql, tuple(credit_adj_params))
                    for r in credit_adj_rows:
                        pid = r["provider_id"]
                        adj_by_provider[pid] = adj_by_provider.get(pid, 0.0) + float(r["credit_total"])
                except Exception as e:
                    logger.warning(f"Credit adj distributions join failed (non-fatal): {e}")

            # Distinct patients per provider — V353: entry_date to match production
            pt_sql = """
                SELECT provider_id, COUNT(DISTINCT patient_id) as patient_count
                FROM procedures
                WHERE entry_date >= ? AND entry_date < ? AND is_active = 1
                  AND ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')
            """
            pt_params: list = [start, _end_excl_pbp]
            if location_id:
                pt_sql += " AND location_id = ?"
                pt_params.append(location_id)
            pt_sql += " GROUP BY provider_id"
            pt_rows = _db_query(pt_sql, tuple(pt_params))
            pt_by_provider = {r["provider_id"]: r["patient_count"] for r in pt_rows}

            # Placeholder provider names that are services, not people
            # Excluded from payroll tab but production data is intact in SQLite
            PLACEHOLDER_NAMES = {
                "nu dental provider", "provider, nu dental", "provider nu dental",
                "nu dental", "placeholder", "unassigned"
            }

            # Build per-provider records; merge duplicates by display name
            # (handles providers with multiple IDs in Dentrix, e.g. Dr. Admasu Gizachew)
            merged: Dict[str, dict] = {}
            for r in prod_rows:
                pid = r["provider_id"]
                display_name = provider_names.get(pid, pid or "Unknown").strip()
                name_key = display_name.lower()

                # Skip placeholder/service providers — not real payroll entities
                if name_key in PLACEHOLDER_NAMES:
                    continue
                gross = float(r["production"])
                adj = adj_by_provider.get(pid, 0.0)
                net = gross + adj
                pts = pt_by_provider.get(pid, 0)
                if name_key in merged:
                    # Merge duplicate provider records (same person, multiple IDs)
                    merged[name_key]["grossProduction"] = round(merged[name_key]["grossProduction"] + gross, 2)
                    merged[name_key]["adjustments"] = round(merged[name_key]["adjustments"] + adj, 2)
                    merged[name_key]["netProduction"] = round(merged[name_key]["netProduction"] + net, 2)
                    merged[name_key]["production"] = merged[name_key]["grossProduction"]  # legacy alias
                    merged[name_key]["procedureCount"] += r["procedure_count"]
                    merged[name_key]["patients"] = (merged[name_key]["patients"] or 0) + pts
                    # Keep lowest provider ID for reference (most likely the canonical one)
                    if pid < merged[name_key]["providerId"]:
                        merged[name_key]["providerId"] = pid
                    merged[name_key]["_merged"] = True
                else:
                    loc_id = primary_location.get(pid, "")
                    office_id = DENTRIX_TO_OFFICE_ID.get(loc_id, "")
                    # FIX-8: use canonical name, not raw SQLite locations.name
                    office_name = DENTRIX_TO_CANONICAL_NAME.get(loc_id, location_names.get(loc_id, ""))
                    merged[name_key] = {
                        "providerId": pid,
                        "providerName": display_name,
                        # Frontend expects both names for compatibility
                        "name": display_name,
                        "grossProduction": round(gross, 2),
                        "adjustments": round(adj, 2),
                        "netProduction": round(net, 2),
                        # Legacy alias
                        "production": round(gross, 2),
                        "procedureCount": r["procedure_count"],
                        "patients": pts,
                        # Office resolution fields
                        "locationId": loc_id,
                        "officeId": office_id,
                        "officeName": office_name,
                        "office": office_name,
                        "office_id": office_id,
                    }

            providers_list = sorted(merged.values(), key=lambda x: -x["grossProduction"])
        else:
            providers_list = []

        result = {
            "startDate": start,
            "endDate": end,
            "providers": providers_list,
            "totalProduction": round(sum(p["grossProduction"] for p in providers_list), 2),
            "grossProduction": round(sum(p["grossProduction"] for p in providers_list), 2),
            "netProduction": round(sum(p["netProduction"] for p in providers_list), 2),
            "source": "sqlite" if _db_has_data("procedures") else "unavailable",
        }
        _cache_set(key, result, ttl=60)
        return result

    def get_production_by_service(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        key = _cache_key("prod_by_service", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        if _db_has_data("procedures"):
            sql = """
                SELECT ledger_type as service_code,
                       SUM(amount) as production, COUNT(*) as procedure_count
                FROM procedures
                WHERE transaction_date >= ? AND transaction_date <= ? AND is_active = 1
            """
            params_list: list = [start, end]
            if location_id:
                sql += " AND location_id = ?"
                params_list.append(location_id)
            sql += " GROUP BY ledger_type ORDER BY production DESC"

            rows = _db_query(sql, tuple(params_list))
            services_list = [
                {
                    "serviceCode": r["service_code"],
                    "description": "",
                    "production": round(float(r["production"]), 2),
                    "procedureCount": r["procedure_count"],
                }
                for r in rows
            ]
        else:
            services_list = []

        result = {
            "startDate": start,
            "endDate": end,
            "services": services_list,
            "totalProduction": round(sum(s["production"] for s in services_list), 2),
            "source": "sqlite" if _db_has_data("procedures") else "unavailable",
        }
        _cache_set(key, result, ttl=60)
        return result

    def _get_hygienist_ids(self) -> list:
        """
        Return list of provider_id strings classified as 'hygienist'.
        Uses the same _lookup_provider_type() logic as provider-performance.
        Excludes UNATTRIBUTED_OFFICE_LEVEL synthetic row.
        Cached 5 minutes.
        """
        key = _cache_key("hygienist_ids")
        cached = _cache_get(key)
        if cached is not None:
            return cached
        provider_names = self._get_provider_names()
        ids = [pid for pid, name in provider_names.items()
               if _lookup_provider_type(name) == "hygienist"
               and pid != "UNATTRIBUTED_OFFICE_LEVEL"]
        _cache_set(key, ids, ttl=300)
        return ids

    def get_hygiene_retention_metrics(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        """
        Six hygiene retention / reappointment KPI metrics derived entirely from
        existing SQLite tables (appointments + patients + procedures).

        No case acceptance, no TX plan, no stream events, no manual/EOD fallback.
        Null returned for any metric whose denominator is zero.

        Metrics:
          1. Hygiene Reappointment %
          2. Perio Reappointment %
          3. Adult Hygiene Retention 6-month
          4. Adult Hygiene Retention 12-month
          5. Child Hygiene Retention 6-month
          6. Child Hygiene Retention 12-month

        Baseline periods for retention:
          6mo:  [startDate - 182 days, endDate - 182 days]
          12mo: [startDate - 365 days, endDate - 365 days]
        """
        import datetime as _dt

        key = _cache_key("hygiene_retention", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end   = end_date   or _today()

        def _date(s: str, days: int = 0) -> str:
            return (_dt.date.fromisoformat(s[:10]) + _dt.timedelta(days=days)).isoformat()

        # ── Hygienist provider IDs ─────────────────────────────────────────
        hyg_ids = self._get_hygienist_ids()

        empty = {
            "startDate": start, "endDate": end, "locationId": location_id,
            "hygieneCompletedVisits": 0,         "hygieneReappointedCount": 0,
            "hygieneReappointmentPct": None,
            "perioCompletedVisits": 0,            "perioReappointedCount": 0,
            "perioReappointmentPct": None,
            "adultHygieneRetention6moBase": 0,    "adultHygieneRetention6moReturned": 0,
            "adultHygieneRetention6moPct": None,
            "adultHygieneRetention12moBase": 0,   "adultHygieneRetention12moReturned": 0,
            "adultHygieneRetention12moPct": None,
            "childHygieneRetention6moBase": 0,    "childHygieneRetention6moReturned": 0,
            "childHygieneRetention6moPct": None,
            "childHygieneRetention12moBase": 0,   "childHygieneRetention12moReturned": 0,
            "childHygieneRetention12moPct": None,
            "retentionBaseline6mo":  {"from": _date(start, -182), "to": _date(end, -182)},
            "retentionBaseline12mo": {"from": _date(start, -365), "to": _date(end, -365)},
            "source":  "sqlite_appointments_patients",
            "method":  "appointments_based_retention",
        }

        if not hyg_ids or not _db_has_data("appointments"):
            _cache_set(key, empty, ttl=60)
            return empty

        # Excluded statuses for "future appointment" check
        EXCLUDED = (
            "BROKEN", "NO_SHOW", "CANCELLED", "CANCELLEDBYOFFICE",
            "LEFT_MESSAGE", "UNREACHABLE",
        )
        excl_ph  = ",".join("?" * len(EXCLUDED))
        hyg_ph   = ",".join("?" * len(hyg_ids))
        loc_clause = " AND a.location_id = ?" if location_id else ""
        loc_p2    = [location_id] if location_id else []

        # ── Helper: safe div ──────────────────────────────────────────────
        def _pct(n, d):
            return round(n / d * 100, 1) if d and d > 0 else None

        # ════════════════════════════════════════════════════════════════════
        # 1. HYGIENE REAPPOINTMENT %
        #    Base: completed hygienist appts in [start, end]
        #    Numerator: same patient has ANY future non-excluded appointment
        # ════════════════════════════════════════════════════════════════════
        hyg_reappt_sql = f"""
            SELECT
                COUNT(*) AS total,
                SUM(CASE WHEN EXISTS (
                    SELECT 1 FROM appointments a2
                    WHERE a2.patient_id = a.patient_id
                      AND a2.start_time > a.start_time
                      AND a2.status NOT IN ({excl_ph})
                ) THEN 1 ELSE 0 END) AS reappointed
            FROM appointments a
            WHERE a.status IN ('COMPLETED', 'CHAIR')
              AND a.provider_id IN ({hyg_ph})
              AND substr(a.start_time, 1, 10) >= ?
              AND substr(a.start_time, 1, 10) <= ?
              {loc_clause}
        """
        params = list(EXCLUDED) + hyg_ids + [start, end] + loc_p2
        rows = _db_query(hyg_reappt_sql, tuple(params))
        hyg_total    = int(rows[0]["total"] or 0)    if rows else 0
        hyg_reappted = int(rows[0]["reappointed"] or 0) if rows else 0

        # ════════════════════════════════════════════════════════════════════
        # 2. PERIO REAPPOINTMENT %
        #    A "perio visit" = a completed hygienist appointment where
        #    the patient had at least one Periodontics procedure on that date.
        #    procedures.patient_id (direct column, 100% populated) used for join.
        #    Numerator: same patient has a future hygiene or perio appointment.
        # ════════════════════════════════════════════════════════════════════
        perio_base_sql = f"""
            SELECT
                COUNT(*) AS total,
                SUM(CASE WHEN EXISTS (
                    SELECT 1 FROM appointments a2
                    WHERE a2.patient_id = a.patient_id
                      AND a2.start_time > a.start_time
                      AND a2.provider_id IN ({hyg_ph})
                      AND a2.status IN ('COMPLETED', 'CHAIR')
                ) THEN 1 ELSE 0 END) AS reappointed
            FROM appointments a
            WHERE a.status IN ('COMPLETED', 'CHAIR')
              AND a.provider_id IN ({hyg_ph})
              AND substr(a.start_time, 1, 10) >= ?
              AND substr(a.start_time, 1, 10) <= ?
              {loc_clause}
              AND EXISTS (
                  SELECT 1
                  FROM procedures p
                  JOIN patient_procedure_map ppm
                      ON json_extract(p.raw, '$.patientProcedure.id') = ppm.patient_procedure_id
                  WHERE p.patient_id = a.patient_id
                    AND substr(p.entry_date, 1, 10) = substr(a.start_time, 1, 10)
                    AND ppm.normalized_service_category = 'Periodontics'
                    AND p.is_active = 1
                    AND p.ledger_type IN ('PatientProcedureLedger', 'PatientProcedureLedgerRebill')
              )
        """
        perio_params = hyg_ids + hyg_ids + [start, end] + loc_p2
        p_rows = _db_query(perio_base_sql, tuple(perio_params))
        perio_total    = int(p_rows[0]["total"] or 0)      if p_rows else 0
        perio_reappted = int(p_rows[0]["reappointed"] or 0) if p_rows else 0

        # ════════════════════════════════════════════════════════════════════
        # 3–6. RETENTION METRICS (6mo + 12mo, adult + child)
        #
        # For each window W (182 or 365):
        #   baseline_from = start - W days
        #   baseline_to   = end   - W days
        #
        #   Base: DISTINCT patients with a completed hygienist appt in baseline
        #         window, age-classified at the MIN baseline visit date per patient
        #
        #   Returned: same patient has another completed hygienist appt AFTER
        #             their baseline date AND within W days of it
        #
        # Age: adult  → ref_date > date(dob, '+18 years')
        #      child  → ref_date <= date(dob, '+18 years')
        # ════════════════════════════════════════════════════════════════════

        def _retention(window_days: int, age_class: str) -> tuple:
            """
            Returns (base_count, returned_count) for the given window + age class.
            age_class: 'adult' or 'child'
            """
            bl_from = _date(start, -window_days)
            bl_to   = _date(end,   -window_days)

            if age_class == "adult":
                age_cond = "date(b.baseline_date) > date(json_extract(pat.raw, '$.dateOfBirth'), '+18 years')"
            else:
                age_cond = "date(b.baseline_date) <= date(json_extract(pat.raw, '$.dateOfBirth'), '+18 years')"

            sql = f"""
                WITH baseline AS (
                    SELECT
                        a.patient_id,
                        MIN(substr(a.start_time, 1, 10)) AS baseline_date
                    FROM appointments a
                    WHERE a.status IN ('COMPLETED', 'CHAIR')
                      AND a.provider_id IN ({hyg_ph})
                      AND substr(a.start_time, 1, 10) >= ?
                      AND substr(a.start_time, 1, 10) <= ?
                      {loc_clause}
                    GROUP BY a.patient_id
                )
                SELECT
                    COUNT(*) AS base_count,
                    SUM(CASE WHEN {age_cond} AND EXISTS (
                        SELECT 1 FROM appointments a2
                        WHERE a2.patient_id = b.patient_id
                          AND a2.provider_id IN ({hyg_ph})
                          AND a2.status IN ('COMPLETED', 'CHAIR')
                          AND substr(a2.start_time, 1, 10) > b.baseline_date
                          AND date(substr(a2.start_time, 1, 10))
                              <= date(b.baseline_date, '+{window_days} days')
                    ) THEN 1 ELSE 0 END) AS returned_count,
                    SUM(CASE WHEN NOT ({age_cond}) THEN 1 ELSE 0 END) AS wrong_age_count
                FROM baseline b
                JOIN patients pat ON b.patient_id = pat.id
                WHERE {age_cond}
                  AND json_extract(pat.raw, '$.dateOfBirth') IS NOT NULL
            """
            r_params = hyg_ids + [bl_from, bl_to] + loc_p2 + hyg_ids
            r_rows = _db_query(sql, tuple(r_params))
            if r_rows:
                return (
                    int(r_rows[0]["base_count"]     or 0),
                    int(r_rows[0]["returned_count"] or 0),
                )
            return (0, 0)

        a6_base,  a6_ret  = _retention(182, "adult")
        a12_base, a12_ret = _retention(365, "adult")
        c6_base,  c6_ret  = _retention(182, "child")
        c12_base, c12_ret = _retention(365, "child")

        result = {
            "startDate": start,
            "endDate":   end,
            "locationId": location_id,

            # Reappointment
            "hygieneCompletedVisits":    hyg_total,
            "hygieneReappointedCount":   hyg_reappted,
            "hygieneReappointmentPct":   _pct(hyg_reappted, hyg_total),

            "perioCompletedVisits":      perio_total,
            "perioReappointedCount":     perio_reappted,
            "perioReappointmentPct":     _pct(perio_reappted, perio_total),

            # Retention — adult
            "adultHygieneRetention6moBase":     a6_base,
            "adultHygieneRetention6moReturned": a6_ret,
            "adultHygieneRetention6moPct":      _pct(a6_ret, a6_base),

            "adultHygieneRetention12moBase":     a12_base,
            "adultHygieneRetention12moReturned": a12_ret,
            "adultHygieneRetention12moPct":      _pct(a12_ret, a12_base),

            # Retention — child
            "childHygieneRetention6moBase":     c6_base,
            "childHygieneRetention6moReturned": c6_ret,
            "childHygieneRetention6moPct":      _pct(c6_ret, c6_base),

            "childHygieneRetention12moBase":     c12_base,
            "childHygieneRetention12moReturned": c12_ret,
            "childHygieneRetention12moPct":      _pct(c12_ret, c12_base),

            # Metadata
            "retentionBaseline6mo":  {"from": _date(start, -182), "to": _date(end, -182)},
            "retentionBaseline12mo": {"from": _date(start, -365), "to": _date(end, -365)},
            "source":  "sqlite_appointments_patients",
            "method":  "appointments_based_retention",
        }
        _cache_set(key, result, ttl=60)
        return result

    def get_hygiene_procedure_metrics(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        """
        Procedure/CDT-derived hygiene KPI metrics.

        Uses confirmed NU Dental ADA/CDT codes from practice_procedures.
        V731C: Direct join through patient_procedures (eliminates stale patient_procedure_map dependency).

        Sources:
          procedures → patient_procedures → practice_procedures (ada_code + normalized_service_category)
          appointments (for clinicalDays + hygieneCompletedAppointments)
          /v2/reports/provider-performance hygiene netProduction (via get_provider_performance)

        No manual/EOD fallback. No 8-hour assumption. Null for all zero-denominator fields.
        """
        import datetime as _dt

        key = _cache_key("hygiene_proc_metrics", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end   = end_date   or _today()
        end_excl = (_dt.date.fromisoformat(end[:10]) + _dt.timedelta(days=1)).isoformat()

        empty = {
            "startDate": start, "endDate": end, "locationId": location_id,
            "clinicalDays": 0,
            "fmxCount": 0, "fmxPerDay": None,
            "srpCount": 0, "srpPerDay": None,
            "sealantCount": 0,
            "whiteningCount": 0,
            "fluorideCount": 0, "prophyCount": 0, "fluoridePct": None,
            "antimicrobialCount": 0,
            "perioCount": 0, "hygieneBaseCount": 0, "perioPct": None,
            "hygieneProcedureCount": 0,
            "hygieneProduction": None,
            "hygieneProductionPerProcedure": None,
            "hygieneProductionPerAppointment": None,
            "source": "sqlite_cdt_direct",
            "mappingCoverage": None,
        }

        if not _db_has_data("procedures"):
            _cache_set(key, empty, ttl=60)
            return empty

        # ── CDT code groups (NU Dental confirmed) ─────────────────────────────
        FMX_CODES         = {"D0210"}
        SRP_CODES         = {"D4341", "D4342"}
        SEALANT_CODES     = {"D1351"}
        FLUORIDE_CODES    = {"D1206", "D1208"}
        ANTIMICROBIAL     = {"D4381"}   # All D4381.x variants stored as D4381 in practice_procedures
        PROPHY_CODES      = {"D1110", "D1120"}
        # NU Dental whitening uses custom office codes — not D9972/D9973/D9974
        WHITENING_CODES   = {"BLEACHTRAY", "DelWh", "OpalGO", "RefillWhit", "WHITENING", "ZOOMWHITE"}

        # ── SINGLE consolidated query — one pass over procedures + CDT join ───
        # V731C: Direct join through patient_procedures → practice_procedures.
        # Replaces stale patient_procedure_map dependency (last synced Apr 30 2026).
        # Returns (ada_code, normalized_service_category, count) per group.
        cdt_loc = "AND p.location_id = ?" if location_id else ""
        cdt_params: list = [start, end_excl]
        if location_id:
            cdt_params.append(location_id)

        cdt_agg_sql = f"""
            SELECT
                pp.ada_code,
                pp.normalized_service_category AS cat,
                COUNT(*) AS cnt
            FROM procedures p
            JOIN patient_procedures ppat
                ON json_extract(p.raw, '$.patientProcedure.id') = ppat.id
            JOIN practice_procedures pp ON ppat.practice_procedure_id = pp.id
            WHERE p.entry_date >= ? AND p.entry_date < ?
              AND p.is_active = 1
              AND p.ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')
              {cdt_loc}
            GROUP BY pp.ada_code, pp.normalized_service_category
        """
        cdt_rows = _db_query(cdt_agg_sql, tuple(cdt_params))

        # Aggregate in Python — O(n) over ~50–100 distinct (code, cat) groups
        code_counts: dict = {}   # ada_code → count
        cat_counts:  dict = {}   # normalized_service_category → count
        for r in cdt_rows:
            code = r["ada_code"] or ""
            cat  = r["cat"]  or ""
            cnt  = int(r["cnt"] or 0)
            code_counts[code] = code_counts.get(code, 0) + cnt
            cat_counts[cat]   = cat_counts.get(cat, 0)  + cnt

        def _sum_codes(codes: set) -> int:
            return sum(code_counts.get(c, 0) for c in codes)

        def _sum_cats(cats: list) -> int:
            return sum(cat_counts.get(c, 0) for c in cats)

        fmx_count      = _sum_codes(FMX_CODES)
        srp_count      = _sum_codes(SRP_CODES)
        sealant_count  = _sum_codes(SEALANT_CODES)
        fluoride_count = _sum_codes(FLUORIDE_CODES)
        prophy_count   = _sum_codes(PROPHY_CODES)
        antimicrobial  = _sum_codes(ANTIMICROBIAL)
        whitening_count= _sum_codes(WHITENING_CODES)
        perio_count    = _sum_cats(["Periodontics"])

        # hygieneBaseCount = Preventive/Hygiene + Periodontics
        hyg_base_count = _sum_cats(["Preventive / Hygiene", "Periodontics"])
        hyg_proc_count = hyg_base_count

        # ── clinicalDays: unique days with any delivered appointment ──────────
        days_sql = """
            SELECT COUNT(DISTINCT substr(start_time, 1, 10)) AS days
            FROM appointments
            WHERE status IN ('COMPLETED', 'CHAIR')
              AND substr(start_time, 1, 10) >= ?
              AND substr(start_time, 1, 10) <= ?
        """
        days_params: list = [start, end]
        if location_id:
            days_sql += " AND location_id = ?"
            days_params.append(location_id)
        days_rows  = _db_query(days_sql, tuple(days_params))
        clinical_days = int(days_rows[0]["days"]) if days_rows else 0

        # ── Hygiene netProduction + completedAppointments ────────────────────
        # Get from provider-performance (same providerType lookup already in use)
        pp_result = self.get_provider_performance(start, end, location_id)
        hyg_net   = sum(float(p.get("netProduction") or 0)
                        for p in pp_result.get("providers", [])
                        if p.get("providerType") == "hygienist"
                        and p.get("providerId") != "UNATTRIBUTED_OFFICE_LEVEL")
        hyg_net   = round(hyg_net, 2) if hyg_net else None

        # Hygiene completed appointments: from summary.providerTypeMetrics if available
        ptm = pp_result.get("summary", {}).get("providerTypeMetrics", {})
        hyg_completed = ptm.get("hygienist", {}).get("completedAppointments", 0) or 0

        # ── Mapping coverage (direct join: patient_procedures with practice_procedure_id) ──
        # V731C: Measures % of patient_procedures that have a resolvable practice_procedure_id.
        cov_sql = """
            SELECT
                COUNT(*) AS total,
                SUM(CASE WHEN practice_procedure_id IS NOT NULL AND practice_procedure_id != '' THEN 1 ELSE 0 END) AS mapped
            FROM patient_procedures
        """
        cov_rows = _db_query(cov_sql, ())
        mapped_n = int(cov_rows[0]["mapped"]) if cov_rows else 0
        total_n  = int(cov_rows[0]["total"]) if cov_rows else 1
        mapping_coverage = round(mapped_n / total_n * 100, 4) if total_n else None

        # ── Safe division ─────────────────────────────────────────────────────
        def _pct(num, denom):
            return round(num / denom * 100, 1) if denom and denom > 0 else None

        def _div(num, denom, decimals=2):
            if num is None or not denom or denom <= 0:
                return None
            return round(num / denom, decimals)

        result = {
            "startDate":   start,
            "endDate":     end,
            "locationId":  location_id,
            "clinicalDays": clinical_days,

            "fmxCount":    fmx_count,
            "fmxPerDay":   _div(fmx_count, clinical_days, 2),

            "srpCount":    srp_count,
            "srpPerDay":   _div(srp_count, clinical_days, 2),

            "sealantCount": sealant_count,

            "whiteningCount": whitening_count,

            "fluorideCount":  fluoride_count,
            "prophyCount":    prophy_count,
            "fluoridePct":    _pct(fluoride_count, prophy_count),

            "antimicrobialCount": antimicrobial,

            "perioCount":       perio_count,
            "hygieneBaseCount": hyg_base_count,
            "perioPct":         _pct(perio_count, hyg_base_count),

            "hygieneProcedureCount":         hyg_proc_count,
            "hygieneProduction":             hyg_net,
            "hygieneProductionPerProcedure": _div(hyg_net, hyg_proc_count),
            "hygieneProductionPerAppointment": _div(hyg_net, hyg_completed),

            # Patient Visits per Day (hygiene)
            # Formula: hygieneCompletedAppointments ÷ clinicalDays
            # Returns null if either value is 0 or unavailable — never guesses
            "hygieneCompletedAppointments": hyg_completed if hyg_completed else None,
            "hygieneVisitsPerDay": _div(hyg_completed, clinical_days, 2),

            "source":          "sqlite_cdt_direct",
            "mappingCoverage": mapping_coverage,
        }
        _cache_set(key, result, ttl=60)
        return result

    def get_production_by_provider_and_cdt_category(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
        provider_type: Optional[str] = None,
        specialty_group: Optional[str] = None,
    ) -> dict:
        """
        Returns production broken down by [provider × CDT service category].

        Attribution model: uses `procedures.entry_date` (V353, Dr. G directive 2026-05-04)
        + the same charge/credit adjustment attribution as `get_production_by_provider`,
        so per-provider totals reconcile to /v2/reports/provider-performance netProduction
        AND to /v2/production/summary netProduction (same date basis).

        Adjustments within a provider are distributed proportionally by gross-share
        across service categories (same method as /v2/production/by-cdt-category).

        Reconciliation note: the sum of all-provider netProduction here will match
        /v2/reports/provider-performance.summary.providerAttributedNetProduction,
        NOT /v2/production/summary.netProduction. The difference is the
        unattributed residual (production tied to non-person entities or null providers),
        which cannot be CDT-attributed per provider.
        """
        import datetime as _dt

        key = _cache_key(
            "prod_by_prov_cdt", start_date, end_date,
            location_id, provider_type, specialty_group,
        )
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end   = end_date   or _today()

        DENTRIX_TO_CANONICAL_NAME = {
            "14000000000432": "Staten Island",
            "14000000000433": "Eatontown",
            "14000000000434": "Barnegat",
            "14000000000435": "Brick",
        }
        DENTRIX_TO_OFFICE_ID = {
            "14000000000432": "b0abcc46-55e8-4529-a28f-eedf41c1d72e",
            "14000000000433": "220372a5-afae-49c9-8a0c-f4c0717ff352",
            "14000000000434": "1c719b5b-fd77-4da8-a1b9-2209f1cea63e",
            "14000000000435": "54626997-57c2-4934-8743-1dabb4d176f4",
        }

        if not _db_has_data("procedures"):
            result = {
                "startDate": start, "endDate": end, "providers": [],
                "totalGrossProduction": 0.0, "totalAdjustments": 0.0,
                "totalNetProduction": 0.0, "locationId": location_id,
                "source": "unavailable",
                "reconciliationNote": "No procedure data available.",
            }
            _cache_set(key, result, ttl=60)
            return result

        provider_names = self._get_provider_names()

        # ── Step 1: Gross production per (provider_id, location_id, serviceCategory) ─
        # V353: Uses entry_date — same as get_production_by_provider and get_production_summary
        # (Dr. G directive 2026-05-04: entry_date is the permanent production date basis)
        import datetime as _dt_pbpc
        _end_excl_pbpc = (
            _dt_pbpc.date.fromisoformat(end[:10]) + _dt_pbpc.timedelta(days=1)
        ).isoformat()
        loc_filter = "AND p.location_id = ?" if location_id else ""
        loc_params_gross: list = [start, _end_excl_pbpc]
        if location_id:
            loc_params_gross.append(location_id)

        gross_sql = f"""
            SELECT
                p.provider_id,
                p.location_id,
                COALESCE(ppm.normalized_service_category, 'Unknown / Unmapped') AS service_category,
                COUNT(DISTINCT ppm.ada_code)  AS ada_code_count,
                COUNT(*)                       AS procedure_count,
                ROUND(SUM(p.amount), 2)        AS gross_production
            FROM procedures p
            LEFT JOIN patient_procedure_map ppm
                ON json_extract(p.raw, '$.patientProcedure.id') = ppm.patient_procedure_id
            WHERE p.entry_date >= ?
              AND p.entry_date < ?
              AND p.is_active = 1
              AND p.ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')
              {loc_filter}
            GROUP BY p.provider_id, p.location_id, service_category
            ORDER BY p.provider_id, gross_production DESC
        """
        gross_rows = _db_query(gross_sql, tuple(loc_params_gross))

        # ── Step 2: Adjustments per provider — same logic as get_production_by_provider ─
        # Charge adjustments: PatientChargeAdjustment + PatientChargeAdjustmentRebill by provider_id
        charge_adj_sql = """
            SELECT provider_id, COALESCE(SUM(amount), 0) AS adj_total
            FROM adjustments
            WHERE transaction_date >= ? AND transaction_date <= ?
              AND is_active = 1
              AND ledger_type IN ('PatientChargeAdjustment','PatientChargeAdjustmentRebill')
        """
        cadj_params: list = [start, end]
        if location_id:
            charge_adj_sql += " AND location_id = ?"
            cadj_params.append(location_id)
        charge_adj_sql += " GROUP BY provider_id"
        charge_adj_rows = _db_query(charge_adj_sql, tuple(cadj_params)) if _db_has_data("adjustments") else []
        adj_by_provider: dict = {r["provider_id"]: float(r["adj_total"]) for r in charge_adj_rows}

        # Credit adjustments via distributions join (same as get_production_by_provider)
        if _db_has_data("adjustments"):
            credit_loc_filter = "AND adj.location_id = ?" if location_id else ""
            credit_adj_sql = f"""
                SELECT pr.provider_id,
                       COALESCE(SUM(
                           CASE WHEN adj.amount < 0
                                THEN -CAST(d.value->>'appliedAmount' AS REAL)
                                ELSE  CAST(d.value->>'appliedAmount' AS REAL)
                           END
                       ), 0) AS credit_total
                FROM adjustments adj,
                     json_each(json_extract(adj.raw, '$.distributions')) d
                JOIN procedures pr ON pr.id = (d.value->>'chargeId')
                WHERE adj.transaction_date >= ? AND adj.transaction_date <= ?
                  AND adj.is_active = 1
                  AND adj.ledger_type IN (
                      'PatientCreditAdjustment',
                      'PatientCreditAdjustmentCancellation',
                      'PatientCreditAdjustmentRebill'
                  )
                  {credit_loc_filter}
                GROUP BY pr.provider_id
            """
            credit_params: list = [start, end]
            if location_id:
                credit_params.append(location_id)
            try:
                for r in _db_query(credit_adj_sql, tuple(credit_params)):
                    pid = r["provider_id"]
                    adj_by_provider[pid] = adj_by_provider.get(pid, 0.0) + float(r["credit_total"])
            except Exception as e:
                logger.warning(f"[by-provider-cdt] Credit adj join failed (non-fatal): {e}")

        # ── Step 3: Organize gross rows by (provider_id, location_id) ─────────
        from collections import defaultdict as _dd
        # provider_loc_cats: {(pid, lid): {cat: {gross, ada_count, proc_count}}}
        provider_loc_cats: dict = _dd(lambda: _dd(lambda: {
            "gross": 0.0, "ada_code_count": 0, "procedure_count": 0
        }))
        provider_loc_gross: dict = _dd(float)  # total gross per (pid, lid)

        for r in gross_rows:
            pid = r["provider_id"]
            lid = r["location_id"]
            cat = r["service_category"]
            g   = float(r["gross_production"] or 0)
            provider_loc_cats[(pid, lid)][cat]["gross"]          += g
            provider_loc_cats[(pid, lid)][cat]["ada_code_count"]  = max(
                provider_loc_cats[(pid, lid)][cat]["ada_code_count"], r["ada_code_count"] or 0
            )
            provider_loc_cats[(pid, lid)][cat]["procedure_count"] += r["procedure_count"] or 0
            provider_loc_gross[(pid, lid)] += g

        # ── Step 4: Build provider rows with category breakdown ───────────────
        # Merge duplicate providers by display name (same logic as get_production_by_provider)
        PLACEHOLDER_NAMES = {
            "nu dental provider", "provider, nu dental", "provider nu dental",
            "nu dental", "placeholder", "unassigned"
        }

        # keyed by display_name_lower → accumulated data
        merged_providers: dict = {}

        for (pid, lid), cats in provider_loc_cats.items():
            display_name = provider_names.get(pid, pid or "Unknown").strip()
            name_key     = display_name.lower()

            ptype   = _lookup_provider_type(display_name)
            spec    = _get_provider_specialty(pid, display_name)

            # Apply providerType filter
            if provider_type and ptype != provider_type:
                continue
            # Apply specialtyGroup filter (case-insensitive)
            if specialty_group and spec["specialtyGroup"].lower() != specialty_group.lower():
                continue

            # Skip non-person entities entirely (they're captured in unattributed residual)
            if name_key in PLACEHOLDER_NAMES:
                continue

            total_gross_prov = provider_loc_gross.get((pid, lid), 0.0)
            total_adj_prov   = adj_by_provider.get(pid, 0.0)

            if name_key not in merged_providers:
                merged_providers[name_key] = {
                    "providerId":          pid,
                    "providerName":        display_name,
                    "providerType":        ptype,
                    "specialtyGroup":      spec["specialtyGroup"],
                    "specialtyLabel":      spec["specialtyLabel"],
                    "isSpecialtyProvider": spec["isSpecialtyProvider"],
                    "mappingSource":       spec["mappingSource"],
                    "locationId":          lid,
                    "officeName":          DENTRIX_TO_CANONICAL_NAME.get(lid, ""),
                    "officeId":            DENTRIX_TO_OFFICE_ID.get(lid, ""),
                    "totalGross":          0.0,
                    "totalNet":            0.0,
                    "_cats":               _dd(lambda: {"gross": 0.0, "ada_code_count": 0, "procedure_count": 0}),
                    "_pids":               set(),  # track distinct pids for adj de-dup
                }

            m = merged_providers[name_key]
            m["totalGross"] = round(m["totalGross"] + total_gross_prov, 2)
            # Adj: add only once per distinct pid to avoid double-counting across locations
            m["_pids"].add(pid)

            for cat, cdata in cats.items():
                m["_cats"][cat]["gross"]          += cdata["gross"]
                m["_cats"][cat]["ada_code_count"]  = max(
                    m["_cats"][cat]["ada_code_count"], cdata["ada_code_count"]
                )
                m["_cats"][cat]["procedure_count"] += cdata["procedure_count"]

        # ── Step 5: Build final output rows with proportional adj per category ─
        output_providers = []
        total_gross_all = 0.0
        total_adj_all   = 0.0
        total_net_all   = 0.0

        for m in sorted(merged_providers.values(), key=lambda x: -x["totalGross"]):
            prov_gross = m["totalGross"]
            # Sum adjustments across all distinct pids for this merged provider
            prov_adj   = round(sum(adj_by_provider.get(p, 0.0) for p in m["_pids"]), 2)
            prov_net   = round(prov_gross + prov_adj, 2)
            cats_data  = m["_cats"]

            # Proportional adjustment per category
            cat_rows = []
            running_net = 0.0
            cats_sorted = sorted(cats_data.items(), key=lambda x: -x[1]["gross"])
            for cat, cdata in cats_sorted:
                g = round(cdata["gross"], 2)
                share = g / prov_gross if prov_gross else 0.0
                adj   = round(share * prov_adj, 2)
                net   = round(g + adj, 2)
                running_net += net
                pct = round(net / prov_net * 100, 2) if prov_net else 0.0
                cat_rows.append({
                    "serviceCategory":                    cat,
                    "adaCodeCount":                       cdata["ada_code_count"],
                    "procedureCount":                     cdata["procedure_count"],
                    "grossProduction":                    g,
                    "adjustments":                        adj,
                    "netProduction":                      net,
                    "percentageOfProviderNetProduction":  pct,
                })

            total_gross_all += prov_gross
            total_adj_all   += prov_adj
            total_net_all   += prov_net

            row = {
                "providerId":          m["providerId"],
                "providerName":        m["providerName"],
                "providerType":        m["providerType"],
                "specialtyGroup":      m["specialtyGroup"],
                "specialtyLabel":      m["specialtyLabel"],
                "isSpecialtyProvider": m["isSpecialtyProvider"],
                "mappingSource":       m["mappingSource"],
                "locationId":          m["locationId"],
                "officeName":          m["officeName"],
                "officeId":            m["officeId"],
                "grossProduction":     prov_gross,
                "adjustments":         round(prov_adj, 2),
                "netProduction":       prov_net,
                "categories":          cat_rows,
                "source":              "sqlite_procedures_cdt_map",
            }
            output_providers.append(row)

        # ── Step 6: Reconciliation metadata ───────────────────────────────────
        # Pull provider-performance attributed net for comparison
        try:
            pp = self.get_production_by_provider(start, end, location_id)
            pp_net_total = round(sum(float(p.get("netProduction", 0) or 0)
                                    for p in pp.get("providers", [])), 2)
        except Exception:
            pp_net_total = None

        recon_diff = round(total_net_all - pp_net_total, 2) if pp_net_total is not None else None
        recon_ok   = abs(recon_diff) <= 1.0 if recon_diff is not None else None

        recon_note = (
            "Provider netProduction totals reconcile to /v2/reports/provider-performance "
            "within $1.00 tolerance. Adjustments distributed proportionally by gross share "
            "within each provider's CDT categories. The sum of all providers here equals "
            "providerAttributedNetProduction, not /v2/production/summary.netProduction — "
            "the difference is the unattributed office-level residual."
        )

        result = {
            "startDate":             start,
            "endDate":               end,
            "locationId":            location_id,
            "providerTypeFilter":    provider_type,
            "specialtyGroupFilter":  specialty_group,
            "providers":             output_providers,
            "totalGrossProduction":  round(total_gross_all, 2),
            "totalAdjustments":      round(total_adj_all,   2),
            "totalNetProduction":    round(total_net_all,   2),
            "providerPerfNetTotal":  pp_net_total,
            "reconciliationDiff":    recon_diff,
            "reconciliationOk":      recon_ok,
            "reconciliationNote":    recon_note,
            "adjustmentMethod":      "proportional_by_gross_share_within_provider",
            "source":                "sqlite",
        }
        _cache_set(key, result, ttl=120)
        return result

    def get_production_by_cdt_category(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
        provider_id: Optional[str] = None,
        service_category: Optional[str] = None,
    ) -> dict:
        """
        Returns production grouped by CDT/ADA normalized service category.

        Gross production = procedure charges (entry_date filter, same as production/summary).
        Adjustments = proportionally distributed from production-type adjustments total
                      (transaction_date filter, same formula as production/summary).
        Net production = gross + proportional adjustments.
        Reconciles to /v2/production/summary netProduction within $1.

        Adjustment attribution note: Dentrix adjustment transactions are not CDT-tagged.
        Proportional distribution (by gross share) is the correct approach and reconciles
        to the production/summary formula exactly.
        """
        import datetime as _dt

        key = _cache_key("prod_by_cdt", start_date, end_date, location_id, provider_id, service_category)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        if not _db_has_data("procedures"):
            result = {
                "startDate": start, "endDate": end,
                "categories": [], "totalGrossProduction": 0.0,
                "totalAdjustments": 0.0, "totalNetProduction": 0.0,
                "locationId": location_id, "providerId": provider_id,
                "source": "unavailable",
            }
            _cache_set(key, result, ttl=60)
            return result

        # ── Step 1: Gross production per CDT category ─────────────────────────
        # Uses entry_date (matches production/summary Variant B)
        end_date_excl = (
            _dt.date.fromisoformat(end[:10]) + _dt.timedelta(days=1)
        ).isoformat()

        gross_sql = """
            SELECT
                COALESCE(ppm.normalized_service_category, 'Unknown / Unmapped') AS service_category,
                COUNT(DISTINCT ppm.ada_code) AS ada_code_count,
                COUNT(*) AS procedure_count,
                ROUND(SUM(p.amount), 2) AS gross_production
            FROM procedures p
            LEFT JOIN patient_procedure_map ppm
                ON json_extract(p.raw, '$.patientProcedure.id') = ppm.patient_procedure_id
            WHERE p.entry_date >= ?
              AND p.entry_date < ?
              AND p.is_active = 1
              AND p.ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')
        """
        gross_params: list = [start, end_date_excl]
        if location_id:
            gross_sql += " AND p.location_id = ?"
            gross_params.append(location_id)
        if provider_id:
            gross_sql += " AND p.provider_id = ?"
            gross_params.append(provider_id)
        gross_sql += " GROUP BY service_category ORDER BY gross_production DESC"

        gross_rows = _db_query(gross_sql, tuple(gross_params))

        # ── Step 2: Total adjustments (matches production/summary exactly) ────
        # Uses transaction_date filter; all 6 production adjustment types (Variant B)
        adj_sql = """
            SELECT COALESCE(SUM(amount), 0) AS total_adj
            FROM adjustments
            WHERE transaction_date >= ? AND transaction_date <= ?
              AND is_active = 1
              AND ledger_type IN (
                  'PatientCreditAdjustment','PatientCreditAdjustmentRebill','PatientCreditAdjustmentCancellation',
                  'PatientChargeAdjustment','PatientChargeAdjustmentRebill','PatientChargeAdjustmentCancellation'
              )
        """
        adj_params: list = [start, end]
        if location_id:
            adj_sql += " AND location_id = ?"
            adj_params.append(location_id)
        if provider_id:
            adj_sql += " AND provider_id = ?"
            adj_params.append(provider_id)

        adj_rows = _db_query(adj_sql, tuple(adj_params))
        total_adj = float(adj_rows[0]["total_adj"]) if adj_rows else 0.0

        # ── Step 3: Proportional adjustment per category ──────────────────────
        total_gross = sum(float(r["gross_production"] or 0) for r in gross_rows)

        categories = []
        total_net = 0.0

        for r in gross_rows:
            cat = r["service_category"]
            gross = float(r["gross_production"] or 0)
            ada_count = r["ada_code_count"] or 0
            proc_count = r["procedure_count"] or 0

            # Proportional adjustment share
            share = gross / total_gross if total_gross else 0.0
            adj = round(share * total_adj, 2)
            net = round(gross + adj, 2)
            total_net += net

            pct = round(net / (total_gross + total_adj) * 100, 2) if (total_gross + total_adj) != 0 else 0.0

            row = {
                "serviceCategory": cat,
                "adaCodeCount": ada_count,
                "procedureCount": proc_count,
                "grossProduction": round(gross, 2),
                "adjustments": adj,
                "netProduction": net,
                "percentageOfTotalNetProduction": pct,
            }
            categories.append(row)

        # Apply optional serviceCategory filter AFTER computing percentages
        if service_category:
            categories = [c for c in categories if c["serviceCategory"].lower() == service_category.lower()]

        result = {
            "startDate": start,
            "endDate": end,
            "categories": categories,
            "totalGrossProduction": round(total_gross, 2),
            "totalAdjustments": round(total_adj, 2),
            "totalNetProduction": round(total_gross + total_adj, 2),
            "adjustmentMethod": "proportional_by_gross_share",
            "locationId": location_id,
            "providerId": provider_id,
            "source": "sqlite",
        }
        _cache_set(key, result, ttl=60)
        return result

    def get_appointments_summary(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        """Return appointment counts by status for a date range."""
        key = _cache_key("appt_summary", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()
        location_ids = list(dict.fromkeys(location_id.split(','))) if location_id else []
        location_placeholders = ','.join('?' for _ in location_ids)

        result = {
            "startDate": start,
            "endDate": end,
            "totalScheduled": 0,
            "completed": 0,
            "broken": 0,
            "noShow": 0,
            "cancelled": 0,
            "cancelledByOffice": 0,
            "brokenAppointments": 0,
            "locationId": location_id,
            "source": "sqlite",
        }

        if not _db_has_data("appointments"):
            result["source"] = "unavailable"
            _cache_set(key, result, ttl=60)
            return result

        sql = """
            SELECT status, COUNT(*) as cnt
            FROM appointments
            WHERE substr(start_time, 1, 10) >= ? AND substr(start_time, 1, 10) <= ?
        """
        params_list: list = [start, end]
        if location_id:
            sql += " AND location_id IN (" + location_placeholders + ")"
            params_list.extend(location_ids)
        sql += " GROUP BY status"

        rows = _db_query(sql, tuple(params_list))
        status_counts: Dict[str, int] = {r["status"]: r["cnt"] for r in rows}

        completed = status_counts.get("COMPLETED", 0) + status_counts.get("CHAIR", 0)
        broken = status_counts.get("BROKEN", 0)
        no_show = status_counts.get("NO_SHOW", 0)
        cancelled = status_counts.get("CANCELLEDBYPATIENT", 0) + status_counts.get("CANCELLED", 0)
        cancelled_by_office = status_counts.get("CANCELLEDBYOFFICE", 0)
        total = sum(status_counts.values())

        # ── clinicalDays: days with at least one delivered appointment ────────
        days_sql = """
            SELECT COUNT(DISTINCT substr(start_time, 1, 10)) AS clinical_days
            FROM appointments
            WHERE status IN ('COMPLETED', 'CHAIR')
              AND substr(start_time, 1, 10) >= ?
              AND substr(start_time, 1, 10) <= ?
        """
        days_params: list = [start, end]
        if location_id:
            days_sql += " AND location_id IN (" + location_placeholders + ")"
            days_params.extend(location_ids)

        days_rows = _db_query(days_sql, tuple(days_params))
        clinical_days = int(days_rows[0]["clinical_days"]) if days_rows else 0

        visits_per_day = round(completed / clinical_days, 2) if clinical_days > 0 else None

        result.update({
            "totalScheduled": total,
            "completed": completed,
            "broken": broken,
            "noShow": no_show,
            "cancelled": cancelled,
            "cancelledByOffice": cancelled_by_office,
            "brokenAppointments": broken + no_show,  # combined metric used by frontend
            "clinicalDays":  clinical_days,
            "visitsPerDay":  visits_per_day,
        })
        _cache_set(key, result, ttl=60)
        return result

    # -- Collections --

    def get_collections_summary(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        key = _cache_key("collections_summary", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        # Valid practice location IDs — used to exclude Corp/non-practice rows when
        # no specific office is requested.
        VALID_LOCS = (
            '14000000000433',  # Eatontown
            '14000000000434',  # Barnegat
            '14000000000435',  # Brick
            '14000000000432',  # Staten Island
        )

        # Permanently excluded payment IDs:
        # - 3 known unapplied/prepayment rows (note: "deposit for future work" / "scrp next time")
        # - 1 large outlier pending Dr. G verification ($15,485.81, Barnegat, 2026-04-23)
        EXCLUDED_IDS = (
            '14000084126690',
            '14000090979048',
            '14000090983673',
            '14000092017100',
        )
        excl_placeholders = ",".join("?" * len(EXCLUDED_IDS))

        # ── PART 1: Charge-allocated payments via distribution_lines ─────────────
        # Filter dl.transaction_date (= payment transactionDate) to the requested range.
        # Filter dl.charge_location_id to restrict by office.
        # line_is_active=1 ensures voided/reversed lines are excluded.
        if location_id:
            dl_sql = """
                SELECT COALESCE(ABS(SUM(dl.applied_amount)), 0) AS total,
                       COUNT(DISTINCT dl.transaction_id)         AS cnt
                FROM distribution_lines dl
                WHERE dl.transaction_date >= ?
                  AND dl.transaction_date <= ?
                  AND dl.line_is_active   = 1
                  AND dl.source_table IN ('patient_payments', 'insurance_payments')
                  AND dl.charge_location_id = ?
            """
            dl_params: tuple = (start, end, location_id)
        else:
            loc_ph = ",".join("?" * len(VALID_LOCS))
            dl_sql = f"""
                SELECT COALESCE(ABS(SUM(dl.applied_amount)), 0) AS total,
                       COUNT(DISTINCT dl.transaction_id)         AS cnt
                FROM distribution_lines dl
                WHERE dl.transaction_date >= ?
                  AND dl.transaction_date <= ?
                  AND dl.line_is_active   = 1
                  AND dl.source_table IN ('patient_payments', 'insurance_payments')
                  AND dl.charge_location_id IN ({loc_ph})
            """
            dl_params = (start, end) + VALID_LOCS

        dl_rows = _db_query(dl_sql, dl_params)
        allocated_total = float(dl_rows[0]["total"]) if dl_rows else 0.0
        allocated_count = int(dl_rows[0]["cnt"])    if dl_rows else 0

        # ── PART 2: Valid unlinked patient payments (distributions=[]) ───────────
        # These are active PatientProcedurePayment / Rebill rows that the HS1 API
        # returned with empty distributions arrays — Ascend has no charge-level
        # allocation for them but Dentrix still counts them as collected.
        # Filter by entry_date (= raw.entryDate) rather than transaction_date so that
        # PatientProcedurePaymentRebill rows (date-corrections of prior payments) are
        # attributed to the period in which the correction was made — matching
        # Dentrix's "Modified Applied Date" logic.
        # next_day is used for the exclusive upper bound on entry_date (timestamp field).
        from datetime import date as _date, timedelta as _td
        try:
            _end_dt = _date.fromisoformat(end)
        except Exception:
            _end_dt = _date.today()
        next_day = (_end_dt + _td(days=1)).isoformat()

        if location_id:
            ul_sql = f"""
                SELECT COALESCE(ABS(SUM(pp.amount)), 0) AS total,
                       COUNT(*)                          AS cnt
                FROM patient_payments pp
                WHERE pp.entry_date >= ?
                  AND pp.entry_date <  ?
                  AND pp.is_active   = 1
                  AND pp.ledger_type IN ('PatientProcedurePayment', 'PatientProcedurePaymentRebill')
                  AND pp.amount      < 0
                  AND pp.location_id = ?
                  AND pp.id NOT IN ({excl_placeholders})
                  AND (json_extract(pp.raw, '$.distributions') IS NULL
                       OR json_extract(pp.raw, '$.distributions') = '[]')
                  AND NOT EXISTS (
                      SELECT 1 FROM distribution_lines dl2
                      WHERE dl2.transaction_id = pp.id
                        AND dl2.source_table   = 'patient_payments'
                  )
            """
            ul_params: tuple = (start, next_day, location_id) + EXCLUDED_IDS
        else:
            loc_ph2 = ",".join("?" * len(VALID_LOCS))
            ul_sql = f"""
                SELECT COALESCE(ABS(SUM(pp.amount)), 0) AS total,
                       COUNT(*)                          AS cnt
                FROM patient_payments pp
                WHERE pp.entry_date >= ?
                  AND pp.entry_date <  ?
                  AND pp.is_active   = 1
                  AND pp.ledger_type IN ('PatientProcedurePayment', 'PatientProcedurePaymentRebill')
                  AND pp.amount      < 0
                  AND pp.location_id IN ({loc_ph2})
                  AND pp.id NOT IN ({excl_placeholders})
                  AND (json_extract(pp.raw, '$.distributions') IS NULL
                       OR json_extract(pp.raw, '$.distributions') = '[]')
                  AND NOT EXISTS (
                      SELECT 1 FROM distribution_lines dl2
                      WHERE dl2.transaction_id = pp.id
                        AND dl2.source_table   = 'patient_payments'
                  )
            """
            ul_params = (start, next_day) + VALID_LOCS + EXCLUDED_IDS

        ul_rows = _db_query(ul_sql, ul_params)
        unlinked_total = float(ul_rows[0]["total"]) if ul_rows else 0.0
        unlinked_count = int(ul_rows[0]["cnt"])    if ul_rows else 0

        # ── Totals ───────────────────────────────────────────────────────────────
        has_pp = _db_has_data("patient_payments")
        has_ip = _db_has_data("insurance_payments")

        # Break out insurance vs patient for display fields.
        # Insurance is entirely in distribution_lines (0 unlinked rows confirmed).
        # Patient = unlinked total + patient share of distribution_lines.
        if location_id:
            ip_dl_sql = """
                SELECT COALESCE(ABS(SUM(dl.applied_amount)), 0) AS total,
                       COUNT(DISTINCT dl.transaction_id)         AS cnt
                FROM distribution_lines dl
                WHERE dl.transaction_date >= ?
                  AND dl.transaction_date <= ?
                  AND dl.line_is_active   = 1
                  AND dl.source_table     = 'insurance_payments'
                  AND dl.charge_location_id = ?
            """
            ip_params: tuple = (start, end, location_id)
        else:
            loc_ph3 = ",".join("?" * len(VALID_LOCS))
            ip_dl_sql = f"""
                SELECT COALESCE(ABS(SUM(dl.applied_amount)), 0) AS total,
                       COUNT(DISTINCT dl.transaction_id)         AS cnt
                FROM distribution_lines dl
                WHERE dl.transaction_date >= ?
                  AND dl.transaction_date <= ?
                  AND dl.line_is_active   = 1
                  AND dl.source_table     = 'insurance_payments'
                  AND dl.charge_location_id IN ({loc_ph3})
            """
            ip_params = (start, end) + VALID_LOCS

        ip_rows = _db_query(ip_dl_sql, ip_params)
        insurance_total = float(ip_rows[0]["total"]) if ip_rows else 0.0
        insurance_count = int(ip_rows[0]["cnt"])    if ip_rows else 0

        patient_dl_total = allocated_total - insurance_total
        patient_total    = round(patient_dl_total + unlinked_total, 2)
        patient_count    = (allocated_count - insurance_count) + unlinked_count

        total_coll = round(allocated_total + unlinked_total, 2)

        # ── Collection rate ──────────────────────────────────────────────────────
        # Denominator is netProduction (= grossProduction + totalAdjustments, signed).
        # DO NOT change to grossProduction / UCR / Procedure Charges.
        prod_summary = self.get_production_summary(start, end, location_id)
        net_prod = prod_summary.get("netProduction", 0) or 0
        if net_prod > 0:
            collection_rate = round((total_coll / net_prod * 100), 1)
            collection_rate_warning = None
        else:
            collection_rate = None
            collection_rate_warning = "net_production_zero_or_negative"

        result = {
            "startDate": start,
            "endDate": end,
            "totalCollections": total_coll,
            "patientCollections": round(patient_total, 2),
            "insuranceCollections": round(insurance_total, 2),
            "patientPaymentCount": patient_count,
            "insurancePaymentCount": insurance_count,
            "collectionRate": collection_rate,
            "collectionRateWarning": collection_rate_warning,
            "source": "sqlite" if (has_pp or has_ip) else "unavailable",
        }
        _cache_set(key, result, ttl=60)
        return result

    # ── Organization Ledger Type → Payment Method mapping ───────────────
    # Resolved from /v1/organizationledgertypes (live API, May 10 2026).
    # Only the 8 payment-relevant IDs appear in insurance_payments and
    # patient_payments across all historical data.  0 unknown IDs found.
    _INS_PAY_METHOD = {
        "14000000010472": "insurance_check",           # Insurance Payment - Check
        "14000000010473": "insurance_eft",              # Insurance Payment - Electronic
        "14000000017712": "insurance_credit_card",      # Insurance Payment - Credit Card
    }
    _PAT_PAY_METHOD = {
        "14000000010468": "patient_cash",               # Cash Payment
        "14000000010467": "patient_check",              # Check Payment
        "14000000010469": "patient_credit_card",        # Credit Card Payment
        "14000000010470": "patient_financing",          # Patient Financing Payment
        "14000000010471": "patient_eft_online",         # Electronic Transfer Payment
    }

    def get_payment_breakdown(
        self,
        start_date: str,
        end_date: str,
        location_id: Optional[str] = None,
    ) -> dict:
        """Return daily payment breakdown by method (insurance + patient).

        Uses distribution_lines JOIN insurance_payments/patient_payments for
        allocated amounts, plus unlinked patient_payments for the remainder.
        Payment method is derived from organizationLedgerType.id in raw JSON.
        """
        key = _cache_key("payment_breakdown", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        VALID_LOCS = (
            '14000000000433',  # Eatontown
            '14000000000434',  # Barnegat
            '14000000000435',  # Brick
            '14000000000432',  # Staten Island
        )

        result = {
            "insurance_check": 0.0,
            "insurance_eft": 0.0,
            "insurance_credit_card": 0.0,
            "insurance_other": 0.0,
            "insurance_unknown": 0.0,
            "patient_cash": 0.0,
            "patient_check": 0.0,
            "patient_credit_card": 0.0,
            "patient_eft_online": 0.0,
            "patient_financing": 0.0,
            "patient_other": 0.0,
            "patient_unknown": 0.0,
            "pos_collections": 0.0,
            "total_insurance_collections": 0.0,
            "total_patient_collections": 0.0,
            "total_daily_collections": 0.0,
        }
        unmapped_count = 0
        unmapped_amount = 0.0

        # ── Insurance breakdown via distribution_lines JOIN ──────────────
        if location_id:
            ins_sql = """
                SELECT json_extract(ip.raw, '$.organizationLedgerType.id') AS org_id,
                       COALESCE(ABS(SUM(dl.applied_amount)), 0)            AS total
                FROM distribution_lines dl
                JOIN insurance_payments ip ON ip.id = dl.transaction_id
                WHERE dl.transaction_date >= ? AND dl.transaction_date <= ?
                  AND dl.line_is_active = 1
                  AND dl.source_table = 'insurance_payments'
                  AND dl.charge_location_id = ?
                GROUP BY org_id
            """
            ins_params: tuple = (start_date, end_date, location_id)
        else:
            loc_ph = ",".join(["?"] * len(VALID_LOCS))
            ins_sql = f"""
                SELECT json_extract(ip.raw, '$.organizationLedgerType.id') AS org_id,
                       COALESCE(ABS(SUM(dl.applied_amount)), 0)            AS total
                FROM distribution_lines dl
                JOIN insurance_payments ip ON ip.id = dl.transaction_id
                WHERE dl.transaction_date >= ? AND dl.transaction_date <= ?
                  AND dl.line_is_active = 1
                  AND dl.source_table = 'insurance_payments'
                  AND dl.charge_location_id IN ({loc_ph})
                GROUP BY org_id
            """
            ins_params = (start_date, end_date) + VALID_LOCS

        for row in _db_query(ins_sql, ins_params):
            org_id = row["org_id"]
            total = float(row["total"] or 0)
            method = self._INS_PAY_METHOD.get(org_id)
            if method:
                result[method] += total
            else:
                result["insurance_unknown"] += total
                unmapped_count += 1
                unmapped_amount += total

        result["total_insurance_collections"] = round(
            result["insurance_check"] + result["insurance_eft"] +
            result["insurance_credit_card"] + result["insurance_other"] +
            result["insurance_unknown"], 2
        )

        # ── Patient breakdown via distribution_lines JOIN ────────────────
        if location_id:
            pat_dl_sql = """
                SELECT json_extract(pp.raw, '$.organizationLedgerType.id') AS org_id,
                       COALESCE(ABS(SUM(dl.applied_amount)), 0)            AS total
                FROM distribution_lines dl
                JOIN patient_payments pp ON pp.id = dl.transaction_id
                WHERE dl.transaction_date >= ? AND dl.transaction_date <= ?
                  AND dl.line_is_active = 1
                  AND dl.source_table = 'patient_payments'
                  AND dl.charge_location_id = ?
                GROUP BY org_id
            """
            pat_dl_params: tuple = (start_date, end_date, location_id)
        else:
            pat_dl_sql = f"""
                SELECT json_extract(pp.raw, '$.organizationLedgerType.id') AS org_id,
                       COALESCE(ABS(SUM(dl.applied_amount)), 0)            AS total
                FROM distribution_lines dl
                JOIN patient_payments pp ON pp.id = dl.transaction_id
                WHERE dl.transaction_date >= ? AND dl.transaction_date <= ?
                  AND dl.line_is_active = 1
                  AND dl.source_table = 'patient_payments'
                  AND dl.charge_location_id IN ({loc_ph})
                GROUP BY org_id
            """
            pat_dl_params = (start_date, end_date) + VALID_LOCS

        for row in _db_query(pat_dl_sql, pat_dl_params):
            org_id = row["org_id"]
            total = float(row["total"] or 0)
            method = self._PAT_PAY_METHOD.get(org_id)
            if method:
                result[method] += total
            else:
                result["patient_unknown"] += total
                unmapped_count += 1
                unmapped_amount += total

        # ── Unlinked patient payments (empty distributions) ──────────────
        from datetime import date as _date, timedelta as _td
        try:
            _end_dt = _date.fromisoformat(end_date)
        except Exception:
            _end_dt = _date.today()
        next_day = (_end_dt + _td(days=1)).isoformat()

        EXCLUDED_IDS = (
            '14000084126690', '14000090979048',
            '14000090983673', '14000092017100',
        )
        excl_ph = ",".join(["?" ] * len(EXCLUDED_IDS))

        if location_id:
            ul_sql = f"""
                SELECT json_extract(pp.raw, '$.organizationLedgerType.id') AS org_id,
                       COALESCE(ABS(SUM(pp.amount)), 0) AS total
                FROM patient_payments pp
                WHERE pp.entry_date >= ? AND pp.entry_date < ?
                  AND pp.is_active = 1
                  AND pp.ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')
                  AND pp.amount < 0
                  AND pp.location_id = ?
                  AND pp.id NOT IN ({excl_ph})
                  AND (json_extract(pp.raw, '$.distributions') IS NULL
                       OR json_extract(pp.raw, '$.distributions') = '[]')
                  AND NOT EXISTS (
                      SELECT 1 FROM distribution_lines dl2
                      WHERE dl2.transaction_id = pp.id AND dl2.source_table = 'patient_payments'
                  )
                GROUP BY org_id
            """
            ul_params: tuple = (start_date, next_day, location_id) + EXCLUDED_IDS
        else:
            loc_ph2 = ",".join(["?"] * len(VALID_LOCS))
            ul_sql = f"""
                SELECT json_extract(pp.raw, '$.organizationLedgerType.id') AS org_id,
                       COALESCE(ABS(SUM(pp.amount)), 0) AS total
                FROM patient_payments pp
                WHERE pp.entry_date >= ? AND pp.entry_date < ?
                  AND pp.is_active = 1
                  AND pp.ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')
                  AND pp.amount < 0
                  AND pp.location_id IN ({loc_ph2})
                  AND pp.id NOT IN ({excl_ph})
                  AND (json_extract(pp.raw, '$.distributions') IS NULL
                       OR json_extract(pp.raw, '$.distributions') = '[]')
                  AND NOT EXISTS (
                      SELECT 1 FROM distribution_lines dl2
                      WHERE dl2.transaction_id = pp.id AND dl2.source_table = 'patient_payments'
                  )
                GROUP BY org_id
            """
            ul_params = (start_date, next_day) + VALID_LOCS + EXCLUDED_IDS

        for row in _db_query(ul_sql, ul_params):
            org_id = row["org_id"]
            total = float(row["total"] or 0)
            method = self._PAT_PAY_METHOD.get(org_id)
            if method:
                result[method] += total
            else:
                result["patient_unknown"] += total
                unmapped_count += 1
                unmapped_amount += total

        result["total_patient_collections"] = round(
            result["patient_cash"] + result["patient_check"] +
            result["patient_credit_card"] + result["patient_eft_online"] +
            result["patient_financing"] + result["patient_other"] +
            result["patient_unknown"], 2
        )

        # ── POS (paid-at-visit) ──────────────────────────────────────────
        # Exclude Rebill rows — they represent rebilled old payments and inflate POS.
        # Only PatientProcedurePayment reflects genuine same-day point-of-sale.
        if location_id:
            pos_sql = """
                SELECT COALESCE(ABS(SUM(pp.amount)), 0) AS total
                FROM patient_payments pp
                WHERE pp.transaction_date >= ? AND pp.transaction_date <= ?
                  AND pp.is_active = 1
                  AND pp.ledger_type = 'PatientProcedurePayment'
                  AND pp.amount < 0
                  AND pp.location_id = ?
                  AND json_extract(pp.raw, '$.paidAtVisit') = 1
            """
            pos_params: tuple = (start_date, end_date, location_id)
        else:
            pos_sql = f"""
                SELECT COALESCE(ABS(SUM(pp.amount)), 0) AS total
                FROM patient_payments pp
                WHERE pp.transaction_date >= ? AND pp.transaction_date <= ?
                  AND pp.is_active = 1
                  AND pp.ledger_type = 'PatientProcedurePayment'
                  AND pp.amount < 0
                  AND pp.location_id IN ({loc_ph2})
                  AND json_extract(pp.raw, '$.paidAtVisit') = 1
            """
            pos_params = (start_date, end_date) + VALID_LOCS

        pos_rows = _db_query(pos_sql, pos_params)
        result["pos_collections"] = round(float(pos_rows[0]["total"]) if pos_rows else 0.0, 2)

        # ── Totals ───────────────────────────────────────────────────────
        result["total_daily_collections"] = round(
            result["total_insurance_collections"] + result["total_patient_collections"], 2
        )

        # Round all dollar values
        for k in result:
            if isinstance(result[k], float):
                result[k] = round(result[k], 2)

        final = {
            "payment_breakdown": result,
            "payment_breakdown_source_note": (
                "insurance via distribution_lines JOIN insurance_payments; "
                "patient via distribution_lines JOIN patient_payments + unlinked entry_date rows"
            ),
            "payment_method_mapping_status": "complete" if unmapped_count == 0 else "partial",
            "unmapped_payment_method_count": unmapped_count,
            "unmapped_payment_method_amount": round(unmapped_amount, 2),
        }
        _cache_set(key, final, ttl=60)
        return final

    def get_payments(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> List[dict]:
        key = _cache_key("payments", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        if _db_has_data("patient_payments"):
            sql = "SELECT raw FROM patient_payments WHERE transaction_date >= ? AND transaction_date <= ? AND is_active = 1"
            params_list: list = [start, end]
            if location_id:
                sql += " AND location_id = ?"
                params_list.append(location_id)
            sql += " ORDER BY transaction_date DESC"
            rows = _db_query(sql, tuple(params_list))
            result = [self._map_payment(json.loads(r["raw"])) for r in rows]
        else:
            result = []

        _cache_set(key, result, ttl=60)
        return result

    def get_adjustments(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> List[dict]:
        key = _cache_key("adjustments", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        if _db_has_data("adjustments"):
            sql = "SELECT raw FROM adjustments WHERE transaction_date >= ? AND transaction_date <= ? AND is_active = 1"
            params_list: list = [start, end]
            if location_id:
                sql += " AND location_id = ?"
                params_list.append(location_id)
            sql += " ORDER BY transaction_date DESC"
            rows = _db_query(sql, tuple(params_list))
            result = [self._map_adjustment(json.loads(r["raw"])) for r in rows]
        else:
            result = []

        _cache_set(key, result, ttl=60)
        return result

    def get_adjustments_summary(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        """Aggregated adjustment breakdown by canonical type. Used by nudashboard KPI/Adjustment tabs."""
        key = _cache_key("adj_summary", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        if not _db_has_data("adjustments"):
            return {"startDate": start, "endDate": end, "source": "unavailable"}

        loc_filter = " AND location_id = ?" if location_id else ""
        base_params = [start, end] + ([location_id] if location_id else [])

        def _sum_types(types):
            placeholders = ",".join("?" * len(types))
            sql = (
                f"SELECT COALESCE(SUM(amount),0) as total, COUNT(*) as cnt "
                f"FROM adjustments WHERE is_active=1 "
                f"AND transaction_date>=? AND transaction_date<=?"
                f"{loc_filter} AND ledger_type IN ({placeholders})"
            )
            params = tuple(base_params + list(types))
            rows = _db_query(sql, params)
            return float(rows[0]["total"]) if rows else 0.0, (rows[0]["cnt"] if rows else 0)

        # Match the existing production rule: active reversals net their original type.
        # Insurance refund adjustments remain separate.
        credit_adj_amt, credit_adj_cnt = _sum_types([
            "PatientCreditAdjustment", "PatientCreditAdjustmentRebill", "PatientCreditAdjustmentCancellation"
        ])
        charge_adj_amt, charge_adj_cnt = _sum_types([
            "PatientChargeAdjustment", "PatientChargeAdjustmentRebill", "PatientChargeAdjustmentCancellation"
        ])
        # Total production adjustments (signed, no ABS)
        total_prod_adj = credit_adj_amt + charge_adj_amt

        # Insurance refunds — tracked separately, not included in production adjustments
        ins_refund_amt, ins_refund_cnt = _sum_types([
            "InsuranceRefundAdjustment", "InsuranceRefundAdjustmentRebill"
        ])

        # Voided count = cancellation records (informational only)
        sql_voided = (
            "SELECT COUNT(*) as cnt FROM adjustments WHERE is_active=1 "
            "AND transaction_date>=? AND transaction_date<=?"
            + loc_filter +
            " AND ledger_type LIKE '%Cancellation'"
        )
        voided_rows = _db_query(sql_voided, tuple(base_params))
        voided_count = voided_rows[0]["cnt"] if voided_rows else 0

        result = {
            "startDate": start,
            "endDate": end,
            # Credit adjustments (PPO/contractual write-offs)
            "writeOffs": round(credit_adj_amt, 2),
            "writeOffsCount": credit_adj_cnt,
            # Charge adjustments (fee corrections)
            "chargeAdjustments": round(charge_adj_amt, 2),
            "chargeAdjustmentsCount": charge_adj_cnt,
            # Credit adjustments alias
            "creditAdjustments": round(credit_adj_amt, 2),
            # Total production adjustments — matches get_production_summary denominator
            "totalProductionAdjustments": round(total_prod_adj, 2),
            # Insurance refunds (separate from production adjustments)
            "insuranceAdjustments": round(ins_refund_amt, 2),
            "insuranceRefundsCount": ins_refund_cnt,
            "discounts": 0.0,
            "voidedCount": voided_count,
            "totalNetAdjustments": round(total_prod_adj + ins_refund_amt, 2),
            "source": "sqlite",
            "locationId": location_id,
        }
        _cache_set(key, result, ttl=120)
        return result

    def get_ledger_adjustments(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
        ledger_type_filter: Optional[str] = None,
    ) -> dict:
        """Full ledger-level adjustments with classification and sign validation."""
        key = _cache_key("ledger_adj", start_date, end_date, location_id, ledger_type_filter)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        if not _db_has_data("adjustments"):
            return {"adjustments": [], "count": 0, "source": "unavailable"}

        sql = (
            "SELECT id, ledger_type, amount, transaction_date, provider_id, location_id, "
            "patient_id, is_active, last_modified, raw "
            "FROM adjustments WHERE transaction_date>=? AND transaction_date<=?"
        )
        params: list = [start, end]
        if location_id:
            sql += " AND location_id=?"
            params.append(location_id)
        if ledger_type_filter:
            sql += " AND ledger_type=?"
            params.append(ledger_type_filter)
        sql += " ORDER BY transaction_date DESC LIMIT 5000"

        rows = _db_query(sql, tuple(params))

        CREDIT_TYPES = {
            "PatientCreditAdjustment", "PatientCreditAdjustmentRebill",
            "PatientCreditAdjustmentCancellation",
        }
        CHARGE_TYPES = {
            "PatientChargeAdjustment", "PatientChargeAdjustmentRebill",
            "PatientChargeAdjustmentCancellation",
        }

        result_list = []
        for r in rows:
            lt = r["ledger_type"] or ""
            is_voided = lt.endswith("Cancellation") or r["is_active"] == 0
            is_credit = lt in CREDIT_TYPES
            is_charge = lt in CHARGE_TYPES
            amount = float(r["amount"] or 0)
            # Sign validation: credit adjustments should be negative (write-offs)
            expected_sign = -1 if is_credit and not lt.endswith("Cancellation") else None
            sign_warning = expected_sign is not None and amount > 0

            result_list.append({
                "id": r["id"],
                "ledgerType": lt,
                "adjustmentTypeCanonical": (
                    "write_off" if is_credit and not lt.endswith("Cancellation")
                    else "write_off_reversal" if lt == "PatientCreditAdjustmentCancellation"
                    else "charge_adjustment" if is_charge
                    else "insurance_refund" if "InsuranceRefund" in lt
                    else "other"
                ),
                "amount": amount,
                "financialAmount": 0.0 if is_voided else amount,
                "isVoided": is_voided,
                "signWarning": sign_warning,
                "transactionDate": r["transaction_date"],
                "providerId": r["provider_id"],
                "locationId": r["location_id"],
                "patientId": r["patient_id"],
                "isActive": bool(r["is_active"]),
                "lastModified": r["last_modified"],
            })

        result = {
            "startDate": start,
            "endDate": end,
            "adjustments": result_list,
            "count": len(result_list),
            "voidedCount": sum(1 for a in result_list if a["isVoided"]),
            "signWarningCount": sum(1 for a in result_list if a["signWarning"]),
            "source": "sqlite",
        }
        _cache_set(key, result, ttl=60)
        return result

    def get_write_offs(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
        provider_id: Optional[str] = None,
    ) -> dict:
        """PPO and contractual write-offs for provider compensation and net production reporting."""
        key = _cache_key("write_offs", start_date, end_date, location_id, provider_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        if not _db_has_data("adjustments"):
            return {"writeOffs": [], "totalWriteOffs": 0.0, "source": "unavailable"}

        # PatientCreditAdjustment = insurance contractual write-offs (PPO, contractual)
        sql = (
            "SELECT id, ledger_type, amount, transaction_date, provider_id, location_id, "
            "patient_id, raw FROM adjustments "
            "WHERE is_active=1 AND transaction_date>=? AND transaction_date<=? "
            "AND ledger_type IN ('PatientCreditAdjustment','PatientCreditAdjustmentRebill')"
        )
        params: list = [start, end]
        if location_id:
            sql += " AND location_id=?"
            params.append(location_id)
        # Note: PatientCreditAdjustment has no direct provider_id;
        # provider attribution requires chargeId→procedure chain.
        # We return all and let the caller filter/attribute.
        sql += " ORDER BY transaction_date DESC"

        rows = _db_query(sql, tuple(params))
        write_offs_list = []
        total = 0.0
        for r in rows:
            amt = float(r["amount"] or 0)
            total += amt
            # Try to extract distributions for provider attribution
            try:
                raw = json.loads(r["raw"]) if r["raw"] else {}
                distributions = raw.get("distributions") or []
            except Exception:
                distributions = []

            write_offs_list.append({
                "id": r["id"],
                "ledgerType": r["ledger_type"],
                "amount": amt,
                "transactionDate": r["transaction_date"],
                "providerId": r["provider_id"],  # Usually null for credit adjustments
                "locationId": r["location_id"],
                "patientId": r["patient_id"],
                "distributionCount": len(distributions),
                "hasProviderLink": bool(r["provider_id"] or distributions),
            })

        # Also get cancellations (reversals of write-offs)
        sql_cancel = sql.replace(
            "AND ledger_type IN ('PatientCreditAdjustment','PatientCreditAdjustmentRebill')",
            "AND ledger_type='PatientCreditAdjustmentCancellation'"
        )
        cancel_rows = _db_query(sql_cancel, tuple(params))
        cancel_total = sum(float(r["amount"] or 0) for r in cancel_rows)

        result = {
            "startDate": start,
            "endDate": end,
            "writeOffs": write_offs_list,
            "count": len(write_offs_list),
            "totalWriteOffs": round(total, 2),  # negative = reduces production
            "cancellationCount": len(cancel_rows),
            "totalCancellations": round(cancel_total, 2),  # positive = reversed write-offs
            "netWriteOffs": round(total + cancel_total, 2),
            "note": "PatientCreditAdjustment has no direct provider_id. Use distributions[].chargeId to attribute to provider.",
            "source": "sqlite",
            "locationId": location_id,
        }
        _cache_set(key, result, ttl=120)
        return result

    def get_accounts_receivable(self, location_id: Optional[str] = None) -> dict:
        key = _cache_key("ar", location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        today = _today()
        year_start = f"{date.today().year}-01-01"

        has_procs = _db_has_data("procedures")
        has_pp = _db_has_data("patient_payments")
        has_ip = _db_has_data("insurance_payments")
        has_adj = _db_has_data("adjustments")

        def _sum(table: str, amount_fn: str = "SUM(amount)") -> float:
            sql = f"SELECT COALESCE({amount_fn}, 0) as total FROM {table} WHERE is_active = 1"
            params_list = []
            if location_id:
                sql += " AND location_id = ?"
                params_list.append(location_id)
            rows = _db_query(sql, tuple(params_list))
            return float(rows[0]["total"]) if rows else 0.0

        total_charges = _sum("procedures") if has_procs else 0.0
        # FIX-8: Use ABS(SUM(amount)) not SUM(ABS(amount)) — same fix as FIX-1.
        # SUM(ABS) overcounts by treating cancellations as additional positives.
        patient_collections = abs(_sum("patient_payments", "ABS(SUM(amount))")) if has_pp else 0.0
        ins_collections = abs(_sum("insurance_payments", "ABS(SUM(amount))")) if has_ip else 0.0

        # Adjustments: use SIGNED sum so credits (negative) reduce AR correctly.
        # ABS() was wrong — it would subtract both credits AND their cancellations as positives.
        # Correct: total_signed_adjustments is negative (net write-offs), which reduces AR.
        signed_adjustments = _sum("adjustments", "SUM(amount)") if has_adj else 0.0
        # For display, separate charge adjustments (inflate charges) from credit adjustments (reduce AR)
        charge_adj = float(_db_query(
            "SELECT COALESCE(SUM(amount),0) as t FROM adjustments WHERE is_active=1 AND ledger_type IN ('PatientChargeAdjustment','PatientChargeAdjustmentCancellation','PatientChargeAdjustmentRebill')" + (" AND location_id=?" if location_id else ""),
            (location_id,) if location_id else ()
        )[0]["t"]) if has_adj else 0.0
        credit_adj = float(_db_query(
            "SELECT COALESCE(SUM(amount),0) as t FROM adjustments WHERE is_active=1 AND ledger_type IN ('PatientCreditAdjustment','PatientCreditAdjustmentRebill')" + (" AND location_id=?" if location_id else ""),
            (location_id,) if location_id else ()
        )[0]["t"]) if has_adj else 0.0

        total_collections = patient_collections + ins_collections
        # AR = Charges + signed adjustments - collections
        # signed_adjustments is net of all write-offs (mostly negative for write-offs)
        estimated_ar = total_charges + signed_adjustments - total_collections

        result = {
            "asOf": today,
            "totalCharges": round(total_charges, 2),
            "totalCollections": round(total_collections, 2),
            "patientCollections": round(patient_collections, 2),
            "insuranceCollections": round(ins_collections, 2),
            "signedAdjustments": round(signed_adjustments, 2),
            "chargeAdjustments": round(charge_adj, 2),
            "creditAdjustments": round(credit_adj, 2),
            # Legacy alias (was ABS, now corrected to signed)
            "totalAdjustments": round(abs(signed_adjustments), 2),
            "estimatedAR": round(estimated_ar, 2),
            "note": "estimatedAR = totalCharges + signedAdjustments - totalCollections. signedAdjustments is net-signed (write-offs are negative).",
            "source": "sqlite" if has_procs else "unavailable",
        }
        _cache_set(key, result, ttl=60)
        return result

    def get_collections_by_provider(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        """
        Compute collections per provider by joining payment.distributions[].chargeId
        to procedures.id → procedures.provider_id.

        Dentrix Ascend payments do not store provider_id directly, but every payment
        carries a distributions array mapping each applied amount to a procedure chargeId.
        We join chargeId → procedures to get the rendering provider.
        Coverage: ~99% for insurance_payments, ~85% for patient_payments.
        """
        key = _cache_key("collections_by_provider", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        provider_names = self._get_provider_names()
        by_provider: Dict[str, dict] = defaultdict(
            lambda: {"patientCollections": 0.0, "insuranceCollections": 0.0}
        )

        loc_filter = ""
        params_base: list = [start, end]
        if location_id:
            loc_filter = " AND pp.location_id = ?"
            params_base.append(location_id)

        # PATCH-2: Derive provider_id by joining distribution_lines.charge_id -> procedures.id
        # provider_id = COALESCE(distribution_lines.procedure_provider_id, procedures.provider_id)
        # Use applied_amount (not pp/ip.amount) and do NOT merge by display name.
        if _db_has_data("distribution_lines") and _db_has_data("procedures"):
            # Patient collections
            params_pp: list = [start, end]
            loc_clause = ""
            if location_id:
                loc_clause = " AND (pr.location_id = ? OR dl.charge_location_id = ?)"
                params_pp.extend([location_id, location_id])
            sql_pp = f"""
                SELECT COALESCE(dl.procedure_provider_id, pr.provider_id) AS provider_id,
                       COALESCE(ABS(SUM(dl.applied_amount)), 0) AS total
                FROM distribution_lines dl
                JOIN procedures pr ON pr.id = dl.charge_id
                WHERE dl.transaction_date >= ? AND dl.transaction_date <= ?
                  AND dl.source_table = 'patient_payments'
                  AND dl.line_is_active = 1
                  AND dl.transaction_ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')
                  AND dl.applied_amount < 0
                  AND COALESCE(dl.procedure_provider_id, pr.provider_id) IS NOT NULL
                  {loc_clause}
                GROUP BY COALESCE(dl.procedure_provider_id, pr.provider_id)
            """
            rows_pp = _db_query(sql_pp, tuple(params_pp))
            for r in rows_pp:
                by_provider[r["provider_id"]]["patientCollections"] = float(r["total"])

            # Insurance collections
            params_ip: list = [start, end]
            loc_clause_ip = ""
            if location_id:
                loc_clause_ip = " AND (pr.location_id = ? OR dl.charge_location_id = ?)"
                params_ip.extend([location_id, location_id])
            sql_ip = f"""
                SELECT COALESCE(dl.procedure_provider_id, pr.provider_id) AS provider_id,
                       COALESCE(ABS(SUM(dl.applied_amount)), 0) AS total
                FROM distribution_lines dl
                JOIN procedures pr ON pr.id = dl.charge_id
                WHERE dl.transaction_date >= ? AND dl.transaction_date <= ?
                  AND dl.source_table = 'insurance_payments'
                  AND dl.line_is_active = 1
                  AND dl.transaction_ledger_type IN ('InsurancePayment','InsurancePaymentRebill')
                  AND dl.applied_amount < 0
                  AND COALESCE(dl.procedure_provider_id, pr.provider_id) IS NOT NULL
                  {loc_clause_ip}
                GROUP BY COALESCE(dl.procedure_provider_id, pr.provider_id)
            """
            rows_ip = _db_query(sql_ip, tuple(params_ip))
            for r in rows_ip:
                by_provider[r["provider_id"]]["insuranceCollections"] = float(r["total"])

        # Key by provider_id (not display name) — do not merge across providers
        providers_list_out = []
        for pid, data in by_provider.items():
            name = provider_names.get(pid, pid or "Unknown").strip()
            loc_id = data.get("locationId")
            office_info = self._get_office_for_location(loc_id) if loc_id else {}
            pt_coll = round(data["patientCollections"], 2)
            ins_coll = round(data["insuranceCollections"], 2)
            total_coll = round(pt_coll + ins_coll, 2)
            providers_list_out.append({
                "providerId": pid,
                "providerName": name,
                "patientCollections": pt_coll,
                "insuranceCollections": ins_coll,
                "totalCollections": total_coll,
                "locationId": loc_id,
                "officeId": office_info.get("officeId"),
                "officeName": office_info.get("officeName", "Unknown"),
                "office": office_info.get("officeName", "Unknown"),
            })

        providers_list_out.sort(key=lambda x: -x["totalCollections"])
        total = round(sum(p["totalCollections"] for p in providers_list_out), 2)

        result = {
            "startDate": start,
            "endDate": end,
            "providers": providers_list_out,
            "totalCollections": total,
            "collectionsByProviderAvailable": len(providers_list_out) > 0,
            "method": "distribution_lines_provider_id",
            "source": "sqlite",
        }
        _cache_set(key, result, ttl=60)
        return result

    def _map_payment(self, raw: dict) -> dict:
        patient = raw.get("patient") or {}
        provider = raw.get("provider") or {}
        location = raw.get("location") or {}
        return {
            "id": raw.get("id"),
            "patientId": patient.get("id") if isinstance(patient, dict) else patient,
            "providerId": provider.get("id") if isinstance(provider, dict) else provider,
            "locationId": location.get("id") if isinstance(location, dict) else location,
            "amount": abs(float(raw.get("amount") or 0)),
            "date": raw.get("transactionDate") or raw.get("date"),
            "type": raw.get("ledgerType"),
        }

    def _map_adjustment(self, raw: dict) -> dict:
        patient = raw.get("patient") or {}
        provider = raw.get("provider") or {}
        location = raw.get("location") or {}
        return {
            "id": raw.get("id"),
            "patientId": patient.get("id") if isinstance(patient, dict) else patient,
            "providerId": provider.get("id") if isinstance(provider, dict) else provider,
            "locationId": location.get("id") if isinstance(location, dict) else location,
            "amount": float(raw.get("amount") or 0),
            "date": raw.get("transactionDate"),
            "type": raw.get("ledgerType"),
            "note": raw.get("note"),
        }

    # -- Provider Schedule --

    def get_provider_schedule(
        self,
        provider_id: str,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
    ) -> dict:
        key = _cache_key("provider_schedule", provider_id, start_date, end_date)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _today()
        end = end_date or _today()

        appts = self.get_appointments(start, end, provider_id=provider_id)

        result = {
            "providerId": provider_id,
            "startDate": start,
            "endDate": end,
            "appointments": appts,
            "appointmentCount": len(appts),
        }
        _cache_set(key, result, ttl=60)
        return result

    # -- Reports --

    def get_daily_summary(
        self,
        target_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        d = target_date or _today()
        key = _cache_key("daily_summary", d, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        production = self.get_production_summary(d, d, location_id)
        collections = self.get_collections_summary(d, d, location_id)
        appointments = self.get_appointments(d, d, location_id=location_id)
        new_patients = self.get_patients_summary(d, d, location_id)
        pbd = self.get_payment_breakdown(d, d, location_id)

        appt_stats = self._calc_appt_stats(appointments)

        result = {
            "date": d,
            "locationId": location_id,
            "production": {
                # Frontend-canonical field names
                "grossProduction": production["grossProduction"],
                "netProduction": production["netProduction"],
                "adjustments": production["adjustments"],
                "procedureCount": production["procedureCount"],
                # Legacy aliases
                "total": production["grossProduction"],
                "totalProduction": production["grossProduction"],
            },
            "collections": {
                # Frontend-canonical field names
                "totalCollections": collections["totalCollections"],
                "patientCollections": collections["patientCollections"],
                "insuranceCollections": collections["insuranceCollections"],
                "collectionRate": collections["collectionRate"],
                # Legacy aliases
                "total": collections["totalCollections"],
                "patient": collections["patientCollections"],
                "insurance": collections["insuranceCollections"],
            },
            "appointments": appt_stats,
            # Frontend-canonical: nested under "patients"
            "patients": {
                "newPatients": new_patients["newPatients"],
            },
            # Legacy alias at root level for backward compat
            "newPatients": new_patients["newPatients"],
            # Payment method breakdown (Part 2 enrichment)
            **pbd,
        }
        _cache_set(key, result, ttl=60)
        return result

    def get_monthly_summary(
        self,
        year: Optional[int] = None,
        month: Optional[int] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        today = date.today()
        y = year or today.year
        m = month or today.month

        import calendar
        start = f"{y:04d}-{m:02d}-01"
        last_day = calendar.monthrange(y, m)[1]
        end = f"{y:04d}-{m:02d}-{last_day:02d}"

        key = _cache_key("monthly_summary", start, end, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        production = self.get_production_summary(start, end, location_id)
        collections = self.get_collections_summary(start, end, location_id)
        new_patients = self.get_patients_summary(start, end, location_id)
        prod_by_provider = self.get_production_by_provider(start, end, location_id)

        # Daily breakdown for trend chart — iterate each calendar day
        daily_breakdown = []
        if _db_has_data("procedures"):
            import calendar as _cal
            for day in range(1, last_day + 1):
                day_str = f"{y:04d}-{m:02d}-{day:02d}"
                # Skip future dates
                if day_str > _today():
                    break
                # Procedures for this day
                p_sql = "SELECT COALESCE(SUM(amount), 0) as total FROM procedures WHERE transaction_date = ? AND is_active = 1"
                p_params: list = [day_str]
                if location_id:
                    p_sql += " AND location_id = ?"
                    p_params.append(location_id)
                p_rows = _db_query(p_sql, tuple(p_params))
                day_gross = float(p_rows[0]["total"]) if p_rows else 0.0

                # Charge adjustments for this day
                day_adj = self._get_adjustments_total(day_str, day_str, location_id, charge_only=True)

                # Collections for this day — FIX-1: ABS(SUM) not SUM(ABS), payment types only
                coll_total = 0.0
                DAILY_PAYMENT_FILTERS = {
                    "patient_payments":   "ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')",
                    "insurance_payments": "ledger_type IN ('InsurancePayment','InsurancePaymentRebill')",
                }
                for tbl in ("patient_payments", "insurance_payments"):
                    if _db_has_data(tbl):
                        lf = DAILY_PAYMENT_FILTERS[tbl]
                        c_sql = (
                            f"SELECT COALESCE(ABS(SUM(amount)), 0) as total "
                            f"FROM {tbl} "
                            f"WHERE transaction_date = ? AND is_active = 1 AND {lf}"
                        )
                        c_params: list = [day_str]
                        if location_id:
                            c_sql += " AND location_id = ?"
                            c_params.append(location_id)
                        c_rows = _db_query(c_sql, tuple(c_params))
                        coll_total += float(c_rows[0]["total"]) if c_rows else 0.0

                daily_breakdown.append({
                    "date": day_str,
                    "grossProduction": round(day_gross, 2),
                    "netProduction": round(day_gross + day_adj, 2),
                    "collections": round(coll_total, 2),
                })

        # Goals for this office/period
        goals_list = self.get_goals(location_id, y, m)
        goals_obj = {}
        if goals_list and isinstance(goals_list, list) and len(goals_list) > 0:
            g = goals_list[0]
            if isinstance(g, dict) and "error" not in g:
                goals_obj = {
                    "productionGoal": g.get("production_goal") or g.get("productionGoal") or 0,
                    "collectionsGoal": g.get("collections_goal") or g.get("collectionsGoal") or 0,
                    "newPatientsGoal": g.get("new_patients_goal") or g.get("newPatientsGoal") or 0,
                }

        result = {
            "year": y,
            "month": m,
            "startDate": start,
            "endDate": end,
            "locationId": location_id,
            "production": {
                # Frontend-canonical field names
                "grossProduction": production["grossProduction"],
                "netProduction": production["netProduction"],
                "adjustments": production["adjustments"],
                "procedureCount": production["procedureCount"],
                "byProvider": prod_by_provider["providers"],
                # Legacy aliases
                "total": production["grossProduction"],
                "totalProduction": production["grossProduction"],
            },
            "collections": {
                "totalCollections": collections["totalCollections"],
                "patientCollections": collections["patientCollections"],
                "insuranceCollections": collections["insuranceCollections"],
                "collectionRate": collections["collectionRate"],
                # Legacy aliases
                "total": collections["totalCollections"],
                "patient": collections["patientCollections"],
                "insurance": collections["insuranceCollections"],
            },
            # Frontend-canonical: nested under "patients"
            "patients": {
                "newPatients": new_patients["newPatients"],
            },
            # Legacy alias
            "newPatients": new_patients["newPatients"],
            "dailyBreakdown": daily_breakdown,
            "goals": goals_obj,
        }
        _cache_set(key, result, ttl=60)
        return result

    _LOCATION_OFFICE_MAP = {
        "14000000000434": {"officeId": "1c719b5b-fd77-4da8-a1b9-2209f1cea63e", "officeName": "Barnegat"},
        "14000000000433": {"officeId": "220372a5-afae-49c9-8a0c-f4c0717ff352", "officeName": "Eatontown"},
        "14000000000435": {"officeId": "54626997-57c2-4934-8743-1dabb4d176f4", "officeName": "Brick"},
        "14000000000432": {"officeId": "b0abcc46-55e8-4529-a28f-eedf41c1d72e", "officeName": "Staten Island"},
    }

    def _get_office_for_location(self, location_id: str) -> dict:
        """Map a location_id to office info."""
        return self._LOCATION_OFFICE_MAP.get(str(location_id), {})

    def get_provider_performance(
        self,
        start_date: Optional[str] = None,
        end_date: Optional[str] = None,
        location_id: Optional[str] = None,
    ) -> dict:
        key = _cache_key("provider_perf", start_date, end_date, location_id)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        start = start_date or _month_start()
        end = end_date or _today()

        # Office-level totals (authoritative for reconciliation)
        prod_summary = self.get_production_summary(start, end, location_id)
        coll_summary = self.get_collections_summary(start, end, location_id)

        # Provider-attributed components only
        prod_by_provider = self.get_production_by_provider(start, end, location_id)
        coll_by_provider = self.get_collections_by_provider(start, end, location_id)

        provider_names = self._get_provider_names()

        # Build map keyed by provider_id (do NOT merge by display name)
        providers_map: Dict[str, dict] = {}

        for p in prod_by_provider.get("providers", []):
            pid = p.get("providerId")
            if not pid:
                continue
            name = p.get("providerName") or provider_names.get(pid, pid)
            providers_map[pid] = {
                "providerId": pid,
                "providerName": name,
                "name": name,
                "grossProduction": float(p.get("grossProduction", p.get("production", 0)) or 0),
                "adjustments": float(p.get("adjustments", 0) or 0),
                "netProduction": float(p.get("netProduction", p.get("production", 0)) or 0),
                "production": float(p.get("grossProduction", p.get("production", 0)) or 0),  # legacy alias
                "procedureCount": p.get("procedureCount", 0),
                "patients": p.get("patients"),
                "patientCollections": 0.0,
                "insuranceCollections": 0.0,
                "collections": 0.0,
                "collectionRate": None,
                "locationId": p.get("locationId") or location_id,
                "officeId": p.get("officeId") or p.get("office_id"),
                "officeName": p.get("officeName") or p.get("office") or self._get_office_for_location(p.get("locationId") or location_id or "").get("officeName") or "Unknown",
                "office": p.get("office") or p.get("officeName") or "Unknown",
                "providerType": _lookup_provider_type(name) or "unknown",
            }

        for c in coll_by_provider.get("providers", []):
            pid = c.get("providerId")
            if not pid:
                continue
            name = c.get("providerName") or provider_names.get(pid, pid)
            if pid not in providers_map:
                providers_map[pid] = {
                    "providerId": pid,
                    "providerName": name,
                    "name": name,
                    "grossProduction": 0.0,
                    "adjustments": 0.0,
                    "netProduction": 0.0,
                    "production": 0.0,
                    "procedureCount": 0,
                    "patients": None,
                    "patientCollections": 0.0,
                    "insuranceCollections": 0.0,
                    "collections": 0.0,
                    "collectionRate": None,
                    "locationId": c.get("locationId") or location_id,
                    "officeId": c.get("officeId") or c.get("office_id"),
                    "officeName": c.get("officeName") or c.get("office") or self._get_office_for_location(c.get("locationId") or location_id or "").get("officeName") or "Unknown",
                    "office": c.get("office") or c.get("officeName") or "Unknown",
                    "providerType": _lookup_provider_type(name) or "unknown",
                }

            providers_map[pid]["patientCollections"] = float(c.get("patientCollections", 0) or 0)
            providers_map[pid]["insuranceCollections"] = float(c.get("insuranceCollections", 0) or 0)
            providers_map[pid]["collections"] = float(c.get("totalCollections", 0) or 0)

        # Compute per-provider collection rates
        for data in providers_map.values():
            coll = data.get("collections", 0) or 0
            net_p = data.get("netProduction", 0) or 0
            if net_p > 0:
                data["collectionRate"] = round(coll / net_p * 100, 1)
            else:
                data["collectionRate"] = None

        # ── Monthly collections + compensation (for Provider Compensation tab) ──
        # Doctors: tier is based on FULL calendar-month collections, not pay-period
        # Hygienists: comp is 40% or 45% of pay-period collections
        try:
            import calendar as _cal
            from payroll_report import (
                _collections_by_date, doctor_rate,
                HYGIENIST_RATE_45, EXCLUDED_PROVIDER_IDS, EXCLUDED_PROVIDER_NAMES,
                _get_location_override, PROVIDER_LOCATION_OVERRIDES,
            )
            _start_dt = datetime.strptime(start, "%Y-%m-%d")
            _end_dt   = datetime.strptime(end,   "%Y-%m-%d")
            _month_start_str = _start_dt.replace(day=1).strftime("%Y-%m-%d")
            _last_day        = _cal.monthrange(_end_dt.year, _end_dt.month)[1]
            _month_end_str   = _end_dt.replace(day=_last_day).strftime("%Y-%m-%d")

            for _data in providers_map.values():
                _pid   = _data.get("providerId", "")
                _ptype = _data.get("providerType", "doctor")
                _pp    = float(_data.get("collections", 0) or 0)

                if _pid in EXCLUDED_PROVIDER_IDS:
                    continue

                if _ptype == "doctor":
                    # Check for provider-specific location override (e.g. Barnegat-only)
                    _loc_override = _get_location_override(_pid)
                    if _loc_override:
                        # Re-query pay-period collections filtered by allowed locations
                        _pp_rows  = _collections_by_date(_pid, start, end,
                                                         allowed_locations=_loc_override)
                        _pp = round(sum(float(r["applied_payments"]) for r in _pp_rows), 2)
                        _data["collections"] = _pp
                        # Add transparency fields
                        _ovr_cfg = PROVIDER_LOCATION_OVERRIDES.get(_pid, {})
                        _data["officeFilterApplied"] = True
                        _data["officeFilterLabel"]   = _ovr_cfg.get("label", "Location override active")
                        _data["officeFilterBasis"]   = _ovr_cfg.get("basis", "procedure_location")
                        _data["allowedLocationIds"]  = sorted(_loc_override)

                    # Full calendar-month collections (MTD up to pay-period end)
                    _mo_rows  = _collections_by_date(_pid, _month_start_str, end,
                                                     allowed_locations=_loc_override)
                    _mo_total = round(sum(float(r["applied_payments"]) for r in _mo_rows), 2)
                    _rate     = doctor_rate(_mo_total)
                    _data["moCollections"] = _mo_total
                    _data["tierRate"]      = int(_rate * 100)
                    _data["compensation"]  = round(_pp * _rate, 2)
                elif _ptype == "hygienist":
                    _name_lower   = _data.get("providerName", "").strip().lower()
                    _assigned_rate = 0.45 if _name_lower in HYGIENIST_RATE_45 else 0.40
                    _data["moCollections"] = _pp   # hygienists: pay-period basis
                    _data["comp40"]        = round(_pp * 0.40, 2)
                    _data["comp45"]        = round(_pp * 0.45, 2)
                    _data["assignedRate"]  = int(_assigned_rate * 100)
                    _data["tierRate"]      = int(_assigned_rate * 100)
                    _data["compensation"]  = round(_pp * _assigned_rate, 2)
        except Exception as _comp_err:
            logger.warning(f"Could not compute monthly compensation fields: {_comp_err}")

        providers_list = sorted(providers_map.values(), key=lambda x: -(x.get("grossProduction") or 0))

        # ── Issue 8B fix: deduplicate providers by normalized display name ───────
        # Dentrix Ascend assigns one provider_id per location. A single provider
        # (e.g. Admasu Gizachew) can appear 4× if they practice in 4 offices, and
        # Temp Hygiene placeholders multiply similarly. When location_id is not
        # filtered, all rows appear side-by-side creating visible duplicates in the
        # Provider Metrics tab.
        # Strategy: group by normalized name, sum numeric fields, keep the first
        # row's metadata, and annotate merged_ids so the frontend can inspect.
        import re as _re2
        def _pnorm(n: str) -> str:
            return _re2.sub(r'\s+', ' ', (n or '').strip()).lower()

        _dedup_map: dict = {}
        for _p in providers_list:
            _key = _pnorm(_p.get('providerName', ''))
            if _key not in _dedup_map:
                _dedup_map[_key] = dict(_p)  # shallow copy
                _dedup_map[_key]['_merged_provider_ids'] = [_p.get('providerId')]
            else:
                _base = _dedup_map[_key]
                _base['_merged_provider_ids'].append(_p.get('providerId'))
                # Sum numeric production/collection fields
                for _f in ('grossProduction', 'adjustments', 'netProduction', 'production',
                           'patientCollections', 'insuranceCollections', 'collections',
                           'procedureCount', 'completedAppointmentCount', 'chairAppointmentCount'):
                    _base[_f] = (_base.get(_f) or 0) + (_p.get(_f) or 0)
                # Sum chair hours (may be None)
                _ch1 = _base.get('scheduledChairHours')
                _ch2 = _p.get('scheduledChairHours')
                if _ch1 is not None or _ch2 is not None:
                    _base['scheduledChairHours'] = (_ch1 or 0.0) + (_ch2 or 0.0)
                # moCollections, compensation
                for _f2 in ('moCollections', 'compensation', 'comp40', 'comp45'):
                    if _p.get(_f2) is not None:
                        _base[_f2] = (_base.get(_f2) or 0) + (_p.get(_f2) or 0)

        # Recompute derived per-provider collection rate after merge
        for _prow in _dedup_map.values():
            _coll_m = _prow.get('collections') or 0
            _net_m  = _prow.get('netProduction') or 0
            _prow['collectionRate'] = round(_coll_m / _net_m * 100, 1) if _net_m > 0 else None
            # Recompute productionPerHour
            _hrs = _prow.get('scheduledChairHours')
            _net_m2 = float(_prow.get('netProduction') or 0)
            _prow['productionPerHour'] = round(_net_m2 / _hrs, 2) if (_hrs and _hrs > 0) else None

        providers_list = sorted(_dedup_map.values(),
                                key=lambda x: -(x.get('grossProduction') or 0))

        # ── Inject specialty fields into each provider row ────────────────────
        for p in providers_list:
            spec = _get_provider_specialty(p.get("providerId", ""), p.get("providerName", ""))
            p["specialtyGroup"]      = spec["specialtyGroup"]
            p["specialtyLabel"]      = spec["specialtyLabel"]
            p["isSpecialtyProvider"] = spec["isSpecialtyProvider"]
            p["mappingSource"]       = spec["mappingSource"]

        # ── Chair-hour metrics from appointments.duration ─────────────────────
        # scheduledChairHours = SUM(duration)/60 for status IN ('COMPLETED','CHAIR')
        # Excludes: BROKEN, NO_SHOW, CANCELLED, CANCELLEDBYOFFICE, UNCONFIRMED,
        #           CONFIRMED, LEFT_MESSAGE, READY, HERE, LATE, UNREACHABLE
        # No 8-hour assumption. No manual/EOD fallback.
        chair_sql = """
            SELECT
                a.provider_id,
                a.location_id,
                COUNT(*)                                           AS completedAppointmentCount,
                SUM(CASE WHEN a.status = 'CHAIR' THEN 1 ELSE 0 END) AS chairAppointmentCount,
                ROUND(SUM(a.duration) / 60.0, 4)                 AS scheduledChairHours
            FROM appointments a
            WHERE a.status IN ('COMPLETED', 'CHAIR')
              AND substr(a.start_time, 1, 10) >= ?
              AND substr(a.start_time, 1, 10) <= ?
              AND a.duration IS NOT NULL
              AND a.duration > 0
        """
        chair_params: list = [start, end]
        if location_id:
            chair_sql += " AND a.location_id = ?"
            chair_params.append(location_id)
        chair_sql += " GROUP BY a.provider_id, a.location_id"

        chair_rows = _db_query(chair_sql, tuple(chair_params)) if _db_has_data("appointments") else []

        # Build lookup keyed by (provider_id, location_id) to prevent cross-office mixing
        chair_map: Dict[tuple, dict] = {}
        for r in chair_rows:
            key = (r["provider_id"], r["location_id"])
            chair_map[key] = {
                "completedAppointmentCount": int(r["completedAppointmentCount"] or 0),
                "chairAppointmentCount":     int(r["chairAppointmentCount"]     or 0),
                "scheduledChairHours":       float(r["scheduledChairHours"])
                                             if r["scheduledChairHours"] else None,
            }

        # Merge chair fields into each real provider row
        for p in providers_list:
            pid = p.get("providerId")
            lid = p.get("locationId")
            chair = chair_map.get((pid, lid)) or {}
            chair_hours = chair.get("scheduledChairHours")
            net         = float(p.get("netProduction") or 0)

            p["scheduledChairHours"]       = chair_hours
            p["completedAppointmentCount"] = chair.get("completedAppointmentCount", 0)
            p["chairAppointmentCount"]     = chair.get("chairAppointmentCount", 0)
            p["productionPerHour"]         = round(net / chair_hours, 2) \
                                             if (chair_hours and chair_hours > 0) else None
            p["chairHourSource"]           = "scheduled_appointment_duration"

        # Provider-attributed totals
        attrib_gross = round(sum(float(p.get("grossProduction") or 0) for p in providers_list), 2)
        attrib_adj = round(sum(float(p.get("adjustments") or 0) for p in providers_list), 2)
        attrib_net = round(sum(float(p.get("netProduction") or 0) for p in providers_list), 2)
        attrib_pat = round(sum(float(p.get("patientCollections") or 0) for p in providers_list), 2)
        attrib_ins = round(sum(float(p.get("insuranceCollections") or 0) for p in providers_list), 2)
        attrib_coll = round(sum(float(p.get("collections") or 0) for p in providers_list), 2)

        # Office-level totals
        office_gross = float(prod_summary.get("grossProduction", 0) or 0)
        office_adj = float(prod_summary.get("productionAdjustments", prod_summary.get("adjustments", 0)) or 0)
        office_net = float(prod_summary.get("netProduction", 0) or 0)
        office_pat = float(coll_summary.get("patientCollections", 0) or 0)
        office_ins = float(coll_summary.get("insuranceCollections", 0) or 0)
        office_coll = float(coll_summary.get("totalCollections", 0) or 0)

        # Unattributed / office-level residuals
        unattributed = {
            "gross": round(office_gross - attrib_gross, 2),
            "adj": round(office_adj - attrib_adj, 2),
            "net": round(office_net - attrib_net, 2),
            "pat": round(office_pat - attrib_pat, 2),
            "ins": round(office_ins - attrib_ins, 2),
            "coll": round(office_coll - attrib_coll, 2),
        }

        if any(abs(v) > 0.01 for v in unattributed.values()):
            office_info = self._get_office_for_location(location_id) if location_id else {}
            providers_list.append({
                "providerId": "UNATTRIBUTED_OFFICE_LEVEL",
                "providerName": "Unattributed / Office-Level",
                "name": "Unattributed / Office-Level",
                "providerType": "unattributed",
                "locationId": location_id or "ALL",
                "officeId": office_info.get("officeId"),
                "officeName": office_info.get("officeName") if location_id else "ALL",
                "office": office_info.get("officeName") if location_id else "ALL",
                "grossProduction": unattributed["gross"],
                "adjustments": unattributed["adj"],
                "netProduction": unattributed["net"],
                "production": unattributed["gross"],
                "procedureCount": 0,
                "patients": None,
                "patientCollections": unattributed["pat"],
                "insuranceCollections": unattributed["ins"],
                "collections": unattributed["coll"],
                "collectionRate": None,
                "scheduledChairHours":       None,
                "completedAppointmentCount": 0,
                "chairAppointmentCount":     0,
                "productionPerHour":         None,
                "chairHourSource":           "scheduled_appointment_duration",
                "specialtyGroup":            "Unattributed",
                "specialtyLabel":            "Unattributed Office-Level",
                "isSpecialtyProvider":       None,
                "mappingSource":             "synthetic_residual",
            })

        reconciles = (
            abs((attrib_net + unattributed["net"]) - office_net) <= 0.01
            and abs((attrib_coll + unattributed["coll"]) - office_coll) <= 0.01
            and abs((attrib_gross + unattributed["gross"]) - office_gross) <= 0.01
        )

        # ── Provider-type appointment metrics ─────────────────────────────────
        # Builds providerTypeMetrics for Hygiene and Doctor KPI cards:
        #   avgAppointmentMinutes, productionPerAppointment
        # Uses appointments.duration for completed/CHAIR appts grouped by providerType.
        # Provider IDs → type mapping comes from the same providers_map already built above.

        ptype_ids: Dict[str, list] = {"doctor": [], "hygienist": []}
        for p in providers_list:
            pt = p.get("providerType", "")
            pid = p.get("providerId", "")
            if pt in ptype_ids and pid and pid != "UNATTRIBUTED_OFFICE_LEVEL":
                ptype_ids[pt].append(pid)

        # Net production per type (already summed from providers_list, exclude unattributed)
        doc_net_prod  = round(sum(float(p.get("netProduction") or 0) for p in providers_list
                                  if p.get("providerType") == "doctor"
                                  and p.get("providerId") != "UNATTRIBUTED_OFFICE_LEVEL"), 2)
        hyg_net_prod  = round(sum(float(p.get("netProduction") or 0) for p in providers_list
                                  if p.get("providerType") == "hygienist"
                                  and p.get("providerId") != "UNATTRIBUTED_OFFICE_LEVEL"), 2)

        def _appt_metrics_for_ids(provider_ids: list) -> dict:
            """Return completed-appt count + total duration minutes for a set of provider IDs."""
            if not provider_ids or not _db_has_data("appointments"):
                return {"completedCount": 0, "totalMinutes": 0}
            ph = ",".join("?" * len(provider_ids))
            q = f"""
                SELECT COUNT(*) AS cnt, COALESCE(SUM(duration), 0) AS total_min
                FROM appointments
                WHERE status IN ('COMPLETED', 'CHAIR')
                  AND substr(start_time, 1, 10) >= ?
                  AND substr(start_time, 1, 10) <= ?
                  AND duration IS NOT NULL AND duration > 0
                  AND provider_id IN ({ph})
            """
            params: list = [start, end] + provider_ids
            if location_id:
                q += " AND location_id = ?"
                params.append(location_id)
            rows = _db_query(q, tuple(params))
            if rows:
                return {"completedCount": int(rows[0]["cnt"] or 0),
                        "totalMinutes":   int(rows[0]["total_min"] or 0)}
            return {"completedCount": 0, "totalMinutes": 0}

        doc_appt  = _appt_metrics_for_ids(ptype_ids["doctor"])
        hyg_appt  = _appt_metrics_for_ids(ptype_ids["hygienist"])

        def _safe_div(num, denom, decimals=2):
            return round(num / denom, decimals) if denom and denom > 0 else None

        def _active_provider_days_for_ids(provider_ids: list) -> int:
            """
            COUNT(DISTINCT provider_id|date) for providers with at least one
            COMPLETED or CHAIR appointment in the period.
            Each (provider, working-day) pair counts as one active provider-day.
            Does NOT use calendar days or roster headcount.
            """
            if not provider_ids or not _db_has_data("appointments"):
                return 0
            ph = ",".join("?" * len(provider_ids))
            q = f"""
                SELECT COUNT(DISTINCT provider_id || '|' || substr(start_time, 1, 10))
                       AS active_provider_days
                FROM appointments
                WHERE status IN ('COMPLETED', 'CHAIR')
                  AND substr(start_time, 1, 10) >= ?
                  AND substr(start_time, 1, 10) <= ?
                  AND provider_id IN ({ph})
            """
            params: list = [start, end] + provider_ids
            if location_id:
                q += " AND location_id = ?"
                params.append(location_id)
            rows = _db_query(q, tuple(params))
            return int(rows[0]["active_provider_days"] or 0) if rows else 0

        doc_active_days = _active_provider_days_for_ids(ptype_ids["doctor"])
        hyg_active_days = _active_provider_days_for_ids(ptype_ids["hygienist"])

        provider_type_metrics = {
            "doctor": {
                "completedAppointments":              doc_appt["completedCount"],
                "totalAppointmentMinutes":            doc_appt["totalMinutes"],
                "avgAppointmentMinutes":              _safe_div(doc_appt["totalMinutes"],
                                                                doc_appt["completedCount"], 1),
                "netProduction":                      doc_net_prod,
                "productionPerAppointment":           _safe_div(doc_net_prod,
                                                                doc_appt["completedCount"]),
                "activeProviderDays":                 doc_active_days if doc_active_days > 0 else None,
                "avgProductionPerActiveProviderDay":  _safe_div(doc_net_prod, doc_active_days),
            },
            "hygienist": {
                "completedAppointments":              hyg_appt["completedCount"],
                "totalAppointmentMinutes":            hyg_appt["totalMinutes"],
                "avgAppointmentMinutes":              _safe_div(hyg_appt["totalMinutes"],
                                                                hyg_appt["completedCount"], 1),
                "netProduction":                      hyg_net_prod,
                "productionPerAppointment":           _safe_div(hyg_net_prod,
                                                                hyg_appt["completedCount"]),
                "activeProviderDays":                 hyg_active_days if hyg_active_days > 0 else None,
                "avgProductionPerActiveProviderDay":  _safe_div(hyg_net_prod, hyg_active_days),
            },
        }

        # Issue 8C fix: aggregate_collection_rate = sum(collections) / sum(production)
        # This is the correct weighted rate, not the average of individual per-provider rates.
        # Individual per-provider rates (collectionRate on each provider row) remain unchanged.
        aggregate_collection_rate = (
            round(office_coll / office_gross * 100, 1) if office_gross > 0 else None
        )
        aggregate_net_collection_rate = (
            round(office_coll / office_net * 100, 1) if office_net > 0 else None
        )

        result = {
            "startDate": start,
            "endDate": end,
            "providers": providers_list,
            "summary": {
                "grossProduction": office_gross,
                "netProduction": office_net,
                "totalProduction": office_gross,
                "totalCollections": office_coll,
                "providerAttributedCollections": attrib_coll,
                "unattributedCollections": unattributed["coll"],
                "providerAttributedNetProduction": attrib_net,
                "unattributedNetProduction": unattributed["net"],
                "reconcilesToOfficeTotals": reconciles,
                "collectionsByProviderAvailable": True,
                "collectionMethod": coll_by_provider.get("method", "unknown"),
                "aggregateCollectionRate": aggregate_collection_rate,
                "aggregateNetCollectionRate": aggregate_net_collection_rate,
                "aggregateCollectionRateNote": (
                    "Weighted aggregate: sum(collections)/sum(grossProduction). "
                    "Per-provider collectionRate on individual rows uses netProduction. "
                    "The naive average of individual rates will differ due to provider mix."
                ),
                "providerTypeMetrics": provider_type_metrics,
            },
        }
        _cache_set(key, result, ttl=60)
        return result

    def _calc_appt_stats(self, appointments: List[dict]) -> dict:
        total = len(appointments)
        statuses: Dict[str, int] = defaultdict(int)
        for a in appointments:
            s = str(a.get("status") or "unknown").lower()
            statuses[s] += 1

        # Map all known Dentrix status values correctly
        completed = statuses.get("completed", 0) + statuses.get("complete", 0) + statuses.get("checkout", 0)
        no_show = statuses.get("no_show", 0) + statuses.get("noshow", 0) + statuses.get("no show", 0)
        cancelled = (
            statuses.get("cancelled", 0) + statuses.get("canceled", 0) +
            statuses.get("cancelledbyoffice", 0) + statuses.get("cancelledbypatient", 0) +
            statuses.get("cancelledbyprovider", 0)
        )
        broken = statuses.get("broken", 0)
        # Dentrix "BROKEN" is effectively a cancelled appointment
        cancelled_total = cancelled + broken
        confirmed = statuses.get("confirmed", 0)
        scheduled = statuses.get("scheduled", 0)
        unconfirmed = statuses.get("unconfirmed", 0)
        in_progress = statuses.get("chair", 0) + statuses.get("ready", 0)
        left_message = statuses.get("left_message", 0)

        return {
            "total": total,
            "byStatus": dict(statuses),
            "completed": completed,
            "noShow": no_show,
            "cancelled": cancelled_total,
            "broken": broken,
            "confirmed": confirmed,
            "scheduled": scheduled,
            "unconfirmed": unconfirmed,
            "inProgress": in_progress,
            "leftMessage": left_message,
        }

    # -- Goals (Supabase) --

    def get_goals(
        self,
        location_id: Optional[str] = None,
        year: Optional[int] = None,
        month: Optional[int] = None,
    ) -> list:
        import requests as _req

        key = _cache_key("goals", location_id, year, month)
        cached = _cache_get(key)
        if cached is not None:
            return cached

        try:
            with open("/home/openclaw/.config/supabase/nudental.json") as f:
                sb_config = json.load(f)

            sb_url = sb_config["project_url"]
            sb_key = sb_config["secret_key"]

            url = f"{sb_url}/rest/v1/goals"
            headers = {
                "apikey": sb_key,
                "Authorization": f"Bearer {sb_key}",
                "Content-Type": "application/json",
            }
            params: dict = {"select": "*", "order": "created_at.desc"}
            if location_id:
                params["location_id"] = f"eq.{location_id}"
            if year:
                params["year"] = f"eq.{year}"
            if month:
                params["month"] = f"eq.{month}"

            resp = _req.get(url, headers=headers, params=params, timeout=10)
            if resp.status_code == 200:
                result = resp.json()
            else:
                result = [{"error": f"Supabase {resp.status_code}", "body": resp.text[:200]}]

        except Exception as e:
            result = [{"error": str(e)}]

        if isinstance(result, list):
            _cache_set(key, result, ttl=60)
        raw = result if isinstance(result, list) else [result]
        return raw

    def set_goal(self, goal_data: dict) -> dict:
        import requests as _req

        try:
            with open("/home/openclaw/.config/supabase/nudental.json") as f:
                sb_config = json.load(f)

            sb_url = sb_config["project_url"]
            sb_key = sb_config["secret_key"]

            url = f"{sb_url}/rest/v1/goals"
            headers = {
                "apikey": sb_key,
                "Authorization": f"Bearer {sb_key}",
                "Content-Type": "application/json",
                "Prefer": "return=representation",
            }

            resp = _req.post(url, headers=headers, json=goal_data, timeout=10)
            if resp.status_code in (200, 201):
                return resp.json()
            return {"error": f"Supabase {resp.status_code}", "body": resp.text[:200]}

        except Exception as e:
            return {"error": str(e)}


# Module-level singleton
_service: Optional[AscendService] = None


def get_service() -> AscendService:
    global _service
    if _service is None:
        _service = AscendService()
    return _service
