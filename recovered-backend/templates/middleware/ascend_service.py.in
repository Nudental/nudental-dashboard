"""
Ascend Service Layer
Serves data from local SQLite (synced from Dentrix Ascend) for date-range queries.
Falls back to direct API for providers, offices, appointments (small sets).

Architecture:
- sync.py fetches all data from Dentrix Ascend API → local SQLite
- This service reads from SQLite for fast, filterable queries
- For static data (providers, offices), direct API calls are fine
"""

# Provider type mapping (from Supabase providers table)
_PROVIDER_TYPE_MAP = __NUDASHBOARD_CONFIG_LITERAL_006__

def _lookup_provider_type(name: str) -> str:
    """Look up provider type from name."""
    if not name:
        return "doctor"
    key = name.strip().lower().replace("dr. ", "").replace("dr ", "")
    if key in _PROVIDER_TYPE_MAP:
        return _PROVIDER_TYPE_MAP[key]
    # Check if name contains hygien/hyg
    if "hygien" in key or "temp" in key:
        return "hygienist"
    return "doctor"


