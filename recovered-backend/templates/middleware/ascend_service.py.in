#                                    active dentists are GPs by elimination
#   - inactive_gp_inferred         : Inactive dentist, treated as GP (no evidence
#                                    of specialty; marked lower confidence)
#   - placeholder                  : Non-clinical entity, no specialty
#
# Format per entry:
#   providerId → {specialtyGroup, specialtyLabel, isSpecialtyProvider, confidence, mappingSource}
#
# isSpecialtyProvider = True  : Has a specialty beyond general dentistry
# isSpecialtyProvider = False : GP, Hygiene, or administrative
# isSpecialtyProvider = None  : Unattributed / unknown
# ---------------------------------------------------------------------------

