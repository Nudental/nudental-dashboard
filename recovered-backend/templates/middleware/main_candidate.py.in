]

# Back Office checklist (9 items) — Dr. G approved text 2026-05-14
_BACK_OFFICE_CHECKLIST = [
    {"order": 1, "section": "back_office", "text": "Is there enough time scheduled for each procedure?"},
    {"order": 2, "section": "back_office", "text": "Are there adequate supplies available?"},
    {"order": 3, "section": "back_office", "text": "Do you need premedication information about a patient or any other pertinent medical info, such as allergies?"},
    {"order": 4, "section": "back_office", "text": "Do any patients need additional x rays?"},
    {"order": 5, "section": "back_office", "text": "Is there any pending treatment for any of today's patients that can be added to the schedule to fill in for cancellations or no-shows if needed?"},
    {"order": 6, "section": "back_office", "text": "When can emergencies be scheduled?"},
    {"order": 7, "section": "back_office", "text": "Have all lab cases for the day been checked in?"},
    {"order": 8, "section": "back_office", "text": "Are photos needed for any patients?"},
    {"order": 9, "section": "back_office", "text": "Are any family members overdue for recare?"},
]


@app.get("/v2/huddle/prefill", tags=["Huddle"], dependencies=[Depends(verify_api_key)])
def huddle_prefill(
    officeId: str = Query(..., description="Supabase office UUID"),
    date: Optional[str] = Query(
        default=None, alias="date",
        description="YYYY-MM-DD, defaults to today in America/New_York",
    ),
):
    """
    Composite read-only endpoint for the redesigned Morning Huddle.
    Returns goals, provider schedules, production/collection/new-patient actuals,
    working day calculations, plus/minus, and checklist templates in one call.

    Rocket renders the response directly — no client-side formula calculations needed.
    """
    from datetime import date as _date

    # ── 1. Validate office ──────────────────────────────────────────────────
    location_id = OFFICE_UUID_TO_LOCATION_ID.get(officeId)
    if not location_id:
        raise HTTPException(
            status_code=400,
            detail=f"Unknown officeId: {officeId}. Valid: {list(_OFFICE_NAMES.keys())}",
        )
    office_name = _OFFICE_NAMES[officeId]

    # ── 2. Resolve date ─────────────────────────────────────────────────────
    et = ZoneInfo("America/New_York")
    today_et = datetime.now(et).date()
    try:
        huddle_date = _date.fromisoformat(date) if date else today_et
    except ValueError:
        raise HTTPException(status_code=400, detail=f"Invalid date format: {date}. Use YYYY-MM-DD.")

    year = huddle_date.year
    month = huddle_date.month
    month_start = _date(year, month, 1).isoformat()
    date_str = huddle_date.isoformat()

    # ── 3. Working days ──────────────────────────────────────────────────────
    all_working_days = _huddle_working_days(year, month)
    elapsed_working_days = _huddle_working_days(year, month, through_date=huddle_date)
    wd_total = len(all_working_days)
    wd_elapsed = len(elapsed_working_days)

    # ── 4. Goals from Supabase ───────────────────────────────────────────────
    warnings = []
    goals_rows = _sb_query("goals", {
        "location_id": f"eq.{location_id}",
        "year": f"eq.{year}",
        "month": f"eq.{month}",
        "select": "production_goal,collections_goal,new_patients_goal,data",
    })

    if goals_rows:
        gr = goals_rows[0]
        production_goal = float(gr["production_goal"]) if gr.get("production_goal") is not None else None
        collections_goal = float(gr["collections_goal"]) if gr.get("collections_goal") is not None else None
        new_patients_goal = int(gr["new_patients_goal"]) if gr.get("new_patients_goal") is not None else None
        goal_data = gr.get("data") or {}
        provider_goals = goal_data.get("provider_goals", {})
    else:
        production_goal = None
        collections_goal = None
        new_patients_goal = None
        provider_goals = {}
        warnings.append(f"No goals row found for location_id={location_id}, {year}-{month:02d}")

    # ── 5. Provider schedules from Supabase ──────────────────────────────────
    sched_rows = _sb_query("provider_schedules", {
        "office_id": f"eq.{officeId}",
        "is_active": "eq.true",
        "effective_start": f"lte.{date_str}",
        "or": f"(effective_end.is.null,effective_end.gte.{date_str})",
        "select": "provider_id,weekday,frequency,week_parity,half_day,goal_key",
    })

    # Group by provider_id
    schedule_by_provider: dict[str, list[dict]] = {}
    goal_key_by_provider: dict[str, str] = {}
    for s in sched_rows:
        pid = s["provider_id"]
        schedule_by_provider.setdefault(pid, []).append(s)
        if s.get("goal_key") and pid not in goal_key_by_provider:
            goal_key_by_provider[pid] = s["goal_key"]

    if not sched_rows:
        warnings.append("No provider_schedules rows found for this office/date. Schedule data will be null for all providers.")

    # ── 6. Active providers from Supabase ────────────────────────────────────
    prov_rows = _sb_query("providers", {
        "office_id": f"eq.{officeId}",
        "is_active": "eq.true",
        "select": "id,name,provider_type",
    })

    # Deduplicate by normalized name — prefer provider with active schedule
    import re as _re
    def _norm_name(n: str) -> str:
        return _re.sub(r'\s+', ' ', (n or "").strip()).lower()

    # Build set of provider_ids that have schedules for this office/date
    scheduled_pids = set(schedule_by_provider.keys())

    # Group all provider rows by normalized name
    _name_groups: dict[str, list[dict]] = {}
    for p in prov_rows:
        nk = _norm_name(p.get("name"))
        _name_groups.setdefault(nk, []).append(p)

    deduped_providers = []
    for nk, group in _name_groups.items():
        if len(group) == 1:
            deduped_providers.append(group[0])
        else:
            # Pick best: 1) has schedule, 2) has goal_key, 3) has production match, 4) clean name
            def _score(row):
                pid = row["id"]
                raw = (row.get("name") or "")
                return (
                    pid in scheduled_pids,           # prefer scheduled
                    pid in goal_key_by_provider,      # prefer has goal_key
                    raw == raw.strip(),               # prefer no trailing space
                    pid,                              # stable tiebreaker
                )
            best = max(group, key=_score)
            deduped_providers.append(best)

    # ── 7. Production actuals from Dentrix (entry_date basis) ────────────────
    try:
        svc = get_service()
        prod_data = svc.get_production_by_provider(month_start, date_str, location_id)
        prod_providers = prod_data.get("providers", [])
        total_net_production = float(prod_data.get("netProduction", 0))
    except Exception as e:
        logger.warning(f"Huddle prefill: production fetch failed: {e}")
        prod_providers = []
        total_net_production = 0.0
        warnings.append(f"Production data unavailable: {e}")

    # Index production by Dentrix providerId for matching
    prod_by_dentrix_id: dict[str, dict] = {}
    prod_by_name: dict[str, dict] = {}
    for pp in prod_providers:
        did = pp.get("providerId", "")
        if did:
            prod_by_dentrix_id[did] = pp
        pname = (pp.get("providerName") or pp.get("name") or "").strip()
        if pname:
            prod_by_name[pname.lower()] = pp

    # ── 8. Collections actuals ───────────────────────────────────────────────
    try:
        coll_data = svc.get_collections_summary(month_start, date_str, location_id)
        total_collections = float(coll_data.get("totalCollections", 0))
    except Exception as e:
        logger.warning(f"Huddle prefill: collections fetch failed: {e}")
        coll_data = {}
        total_collections = 0.0
        warnings.append(f"Collections data unavailable: {e}")

    # ── 9. New patients actuals ──────────────────────────────────────────────
    try:
        np_mtd = svc.get_patients_summary(month_start, date_str, location_id)
        np_mtd_count = int(np_mtd.get("newPatients", 0))
    except Exception as e:
        logger.warning(f"Huddle prefill: patients MTD fetch failed: {e}")
        np_mtd_count = 0
        warnings.append(f"New patients MTD data unavailable: {e}")

    try:
        np_today = svc.get_patients_summary(date_str, date_str, location_id)
        np_today_count = int(np_today.get("newPatients", 0))
    except Exception as e:
        logger.warning(f"Huddle prefill: patients today fetch failed: {e}")
        np_today_count = 0

    # ── 10. Build provider arrays ────────────────────────────────────────────
    doctors = []
    hygienists = []

    for prov in deduped_providers:
        pid = prov["id"]
        ptype = prov.get("provider_type", "doctor")
        pname = (prov.get("name") or "").strip()

        prov_schedules = schedule_by_provider.get(pid, [])
        gk = goal_key_by_provider.get(pid)
        monthly_goal = float(provider_goals[gk]) if (gk and gk in provider_goals) else None

        # Schedule calculations
        schedule_info = None
        p_days_total = None
        p_days_elapsed = None
        daily_goal = None
        expected_mtd = None

        if prov_schedules:
            p_days_total = _huddle_count_provider_days(prov_schedules, all_working_days)
            p_days_elapsed = _huddle_count_provider_days(prov_schedules, elapsed_working_days)
            if monthly_goal is not None and p_days_total > 0:
                daily_goal = monthly_goal / p_days_total
                expected_mtd = daily_goal * p_days_elapsed

            sched_today = _huddle_is_scheduled_today(prov_schedules, huddle_date)
            weekdays_list = sorted(set(s["weekday"] for s in prov_schedules))
            freq = prov_schedules[0]["frequency"]
            wp = prov_schedules[0].get("week_parity") if freq == "every_other" else None
            hd = any(s.get("half_day") for s in prov_schedules)

            schedule_info = {
                "frequency": freq,
                "weekdays": weekdays_list,
                "week_parity": wp,
                "half_day": hd,
                "provider_days_total": round(p_days_total, 1),
                "provider_days_elapsed": round(p_days_elapsed, 1),
                "scheduled_today": sched_today,
                "daily_projected_goal": round(daily_goal, 2) if daily_goal is not None else None,
            }

        # Match to Dentrix production actuals by name
        # providers table has no dentrix_id — match via provider name
        actual_net = None
        name_lower = pname.lower()
        # Try exact match first
        if name_lower in prod_by_name:
            actual_net = float(prod_by_name[name_lower].get("netProduction", 0))
        else:
            # Try partial: "Dr. Alan Schwartz" matches "Alan Schwartz"
            for pk, pv in prod_by_name.items():
                if pk in name_lower or name_lower in pk:
                    actual_net = float(pv.get("netProduction", 0))
                    break
                # Strip "Dr. " prefix for matching
                stripped = name_lower.replace("dr. ", "").strip()
                pk_stripped = pk.replace("dr. ", "").strip()
                if stripped and pk_stripped and (stripped in pk_stripped or pk_stripped in stripped):
                    actual_net = float(pv.get("netProduction", 0))
                    break

        # Plus/minus: only if both actual and expected are known
        plus_minus = None
        if actual_net is not None and expected_mtd is not None:
            plus_minus = round(actual_net - expected_mtd, 2)

        entry = {
            "provider_id": pid,
            "name": pname,
            "provider_type": ptype,
            "goal_key": gk,
            "monthly_goal": round(monthly_goal, 2) if monthly_goal is not None else None,
            "schedule": schedule_info,
            "actuals": {
                "mtd_net_production": round(actual_net, 2) if actual_net is not None else None,
                "expected_mtd": round(expected_mtd, 2) if expected_mtd is not None else None,
                "plus_minus": plus_minus,
            },
        }

        if ptype == "doctor":
            doctors.append(entry)
        else:
            hygienists.append(entry)

    # Sort: providers with goals first (by monthly_goal desc), then by name
    doctors.sort(key=lambda x: (x["monthly_goal"] is None, -(x["monthly_goal"] or 0), x["name"]))
    hygienists.sort(key=lambda x: (x["monthly_goal"] is None, -(x["monthly_goal"] or 0), x["name"]))

    # ── 11. Office totals ────────────────────────────────────────────────────
    # Production
    if production_goal is not None and wd_total > 0:
        prod_expected = round(production_goal * (wd_elapsed / wd_total), 2)
        prod_pm = round(total_net_production - prod_expected, 2)
    else:
        prod_expected = None
        prod_pm = None

    # Collections
    if collections_goal is not None and wd_total > 0:
        coll_expected = round(collections_goal * (wd_elapsed / wd_total), 2)
        coll_pm = round(total_collections - coll_expected, 2)
    else:
        coll_expected = None
        coll_pm = None

    # Collection rate = collections / net production (NEVER gross)
    coll_rate = None
    if total_net_production > 0 and total_collections > 0:
        coll_rate = round(total_collections / total_net_production * 100, 2)

    # New patients
    if new_patients_goal is not None and wd_total > 0:
        np_expected = round(new_patients_goal * (wd_elapsed / wd_total))
        np_pm = np_mtd_count - np_expected
    else:
        np_expected = None
        np_pm = None

    # ── 12. Sync metadata ────────────────────────────────────────────────────
    # Try to get last sync timestamp from db stats
    try:
        db_stats = get_db_stats()
        last_sync = db_stats.get("last_sync") or db_stats.get("last_updated")
    except Exception:
        last_sync = None

    # ── 13. Assemble response ────────────────────────────────────────────────
    return {
        "office": {
            "id": officeId,
            "name": office_name,
            "dentrix_location_id": location_id,
        },
        "date": date_str,
        "month": {
            "year": year,
            "month": month,
            "working_days_total": wd_total,
            "working_days_elapsed": wd_elapsed,
            "holidays_excluded": _huddle_month_holidays(year, month),
        },
        "goals": {
            "production_monthly": production_goal,
            "collections_monthly": collections_goal,
            "new_patients_monthly": new_patients_goal,
            "source": f"public.goals (location_id={location_id}, {year}-{month:02d})" if goals_rows else None,
        },
        "providers": {
            "doctors": doctors,
            "hygienists": hygienists,
        },
        "office_totals": {
            "production": {
                "goal_monthly": production_goal,
                "expected_mtd": prod_expected,
                "actual_mtd": round(total_net_production, 2),
                "plus_minus": prod_pm,
            },
            "collections": {
                "goal_monthly": collections_goal,
                "expected_mtd": coll_expected,
                "actual_mtd": round(total_collections, 2),
                "plus_minus": coll_pm,
                "collection_rate_pct": coll_rate,
            },
            "new_patients": {
                "goal_monthly": new_patients_goal,
                "expected_mtd": np_expected,
                "actual_mtd": np_mtd_count,
                "actual_today": np_today_count,
                "plus_minus": np_pm,
            },
        },
        "checklists": {
            "front_desk": _FRONT_DESK_CHECKLIST,
            "back_office": _BACK_OFFICE_CHECKLIST,
        },
        "sync": {
            "data_as_of": last_sync,
            "note": "Production and collection data reflects Dentrix sync at 3:00 AM ET. Today's new patients may lag until next sync.",
            "production_date_basis": "entry_date",
        },
        "warnings": warnings if warnings else None,
    }


# ═══════════════════════════════════════════════════════════════════════════════
# EOD Daily Report — Phase 1 (Dentrix-sourced closeout report per office/date)
# ═══════════════════════════════════════════════════════════════════════════════

@app.get("/v2/eod/daily-report", tags=["EOD"])
def eod_daily_report(
    officeId: Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
    date: Optional[str] = Query(None),
):
    """
    Dentrix-sourced daily closeout report for one office on one date.

    Accepts either officeId (Supabase UUID) or locationId (Dentrix location ID).
    Returns production, adjustments, collections, deposit slip breakdown,
    appointment counts, and voided transactions — all from local SQLite
    (synced from Dentrix Ascend API).

    Phase 1: read-only, no unscheduled treatment, no workflow overlay.
    """
    import datetime as _dt

    # ── Resolve office ────────────────────────────────────────────────────────
    loc_id = locationId
    if not loc_id and officeId:
        loc_id = OFFICE_TO_LOCATION.get(officeId)
    if not loc_id:
        return {"error": "officeId or locationId is required"}, 400

    office_name = LOCATION_NAMES.get(loc_id, loc_id)
    office_uuid = LOCATION_TO_OFFICE.get(loc_id, None)

    # ── Resolve date ──────────────────────────────────────────────────────────
    if not date:
        date = _dt.date.today().isoformat()
    try:
        report_date = _dt.date.fromisoformat(date)
    except ValueError:
        return {"error": f"Invalid date format: {date}. Use YYYY-MM-DD."}, 400

    date_str = report_date.isoformat()
    next_day = (report_date + _dt.timedelta(days=1)).isoformat()

    # ── Connect to SQLite ─────────────────────────────────────────────────────
    import sqlite3 as _sq3
    conn = _sq3.connect(str(RCM_DB_PATH), timeout=15)
    conn.row_factory = _sq3.Row

    generated_at = _dt.datetime.now(_dt.timezone.utc).isoformat()
    warnings = []

    # ── Source freshness ──────────────────────────────────────────────────────
    sync_row = conn.execute(
        "SELECT last_synced_at FROM sync_state WHERE table_name = 'procedures'"
    ).fetchone()
    last_sync_ts = float(sync_row["last_synced_at"]) if sync_row else None
    last_sync_iso = (
        _dt.datetime.fromtimestamp(last_sync_ts, tz=_dt.timezone.utc).isoformat()
        if last_sync_ts else None
    )
    if last_sync_ts:
        age_hours = (_dt.datetime.now(_dt.timezone.utc).timestamp() - last_sync_ts) / 3600
        if age_hours > 24:
            warnings.append(f"SQLite data is {age_hours:.0f} hours old — may be stale")

    # Latest dates in SQLite for freshness reporting
    latest_txn = conn.execute(
        "SELECT MAX(transaction_date) AS v FROM procedures WHERE location_id = ?",
        (loc_id,),
    ).fetchone()["v"]
    latest_entry = conn.execute(
        "SELECT MAX(entry_date) AS v FROM procedures WHERE location_id = ?",
        (loc_id,),
    ).fetchone()["v"]

    # Streaming consumer status
    import subprocess as _sp
    try:
        _sc_check = _sp.run(["pgrep", "-f", "streaming_consumer.py"], capture_output=True, timeout=2)
        streaming_status = "running" if _sc_check.returncode == 0 else "not_running"
    except Exception:
        streaming_status = "unknown"
    if streaming_status != "running":
        warnings.append("Streaming consumer is not running — real-time updates may be delayed")

    # ── 1. Production (entry_date basis) ──────────────────────────────────────
    prod_row = conn.execute("""
        SELECT COALESCE(SUM(amount), 0) AS gross, COUNT(*) AS cnt
        FROM procedures
        WHERE entry_date >= ? AND entry_date < ?
          AND location_id = ? AND is_active = 1
          AND ledger_type IN ('PatientProcedureLedger', 'PatientProcedureLedgerRebill')
    """, (date_str, next_day, loc_id)).fetchone()
    gross_production = float(prod_row["gross"])
    procedure_count = prod_row["cnt"]

    # ── 2. Adjustments (transaction_date basis) ───────────────────────────────
    adj_row = conn.execute("""
        SELECT COALESCE(SUM(amount), 0) AS total, COUNT(*) AS cnt
        FROM adjustments
        WHERE transaction_date = ?
          AND location_id = ? AND is_active = 1
          AND ledger_type IN (
            'PatientCreditAdjustment', 'PatientCreditAdjustmentRebill',
            'PatientCreditAdjustmentCancellation',
            'PatientChargeAdjustment', 'PatientChargeAdjustmentRebill',
            'PatientChargeAdjustmentCancellation'
          )
    """, (date_str, loc_id)).fetchone()
    adjustments_total = float(adj_row["total"])
    adjustments_count = adj_row["cnt"]
    net_production = round(gross_production + adjustments_total, 2)

    # ── 3. Collections — via distribution_lines (charge-location-allocated) ───
    dl_ins_row = conn.execute("""
        SELECT COALESCE(ABS(SUM(dl.applied_amount)), 0) AS total,
               COUNT(DISTINCT dl.transaction_id) AS cnt
        FROM distribution_lines dl
        WHERE dl.transaction_date = ?
          AND dl.line_is_active = 1
          AND dl.source_table = 'insurance_payments'
          AND dl.charge_location_id = ?
    """, (date_str, loc_id)).fetchone()
    ins_coll_dl = float(dl_ins_row["total"])
    ins_coll_cnt = int(dl_ins_row["cnt"])

    dl_pat_row = conn.execute("""
        SELECT COALESCE(ABS(SUM(dl.applied_amount)), 0) AS total,
               COUNT(DISTINCT dl.transaction_id) AS cnt
        FROM distribution_lines dl
        WHERE dl.transaction_date = ?
          AND dl.line_is_active = 1
          AND dl.source_table = 'patient_payments'
          AND dl.charge_location_id = ?
    """, (date_str, loc_id)).fetchone()
    pat_coll_dl = float(dl_pat_row["total"])
    pat_coll_cnt = int(dl_pat_row["cnt"])

    total_coll_dl = round(ins_coll_dl + pat_coll_dl, 2)
    collection_rate = round((total_coll_dl / net_production * 100), 1) if net_production > 0 else None

    # ── 4. Raw payment totals (for deposit slip — full payment amounts) ───────
    raw_pat_row = conn.execute("""
        SELECT COALESCE(ABS(SUM(amount)), 0) AS total, COUNT(*) AS cnt
        FROM patient_payments
        WHERE transaction_date = ?
          AND location_id = ? AND is_active = 1 AND amount < 0
    """, (date_str, loc_id)).fetchone()
    raw_pat_total = float(raw_pat_row["total"])
    raw_pat_cnt = int(raw_pat_row["cnt"])

    raw_ins_row = conn.execute("""
        SELECT COALESCE(ABS(SUM(amount)), 0) AS total, COUNT(*) AS cnt
        FROM insurance_payments
        WHERE transaction_date = ?
          AND location_id = ? AND is_active = 1 AND amount < 0
    """, (date_str, loc_id)).fetchone()
    raw_ins_total = float(raw_ins_row["total"])
    raw_ins_cnt = int(raw_ins_row["cnt"])

    raw_total = round(raw_pat_total + raw_ins_total, 2)

    # ── 5. Deposit slip breakdown by payment method ───────────────────────────
    # Deposit slip category definitions: key → (label, organizationLedgerType.id, source_table)
    _DEPOSIT_CATS = [
        ("patient_cash",          "Cash Payments",                   "14000000010468", "patient_payments"),
        ("patient_check",         "Check Payments",                  "14000000010467", "patient_payments"),
        ("insurance_check",       "Insurance Check Payments",        "14000000010472", "insurance_payments"),
        ("patient_credit_card",   "Credit Card Payments",            "14000000010469", "patient_payments"),
        ("insurance_credit_card", "Insurance Credit Card Payments",  "14000000017712", "insurance_payments"),
        ("insurance_eft",         "Insurance Electronic Payments",   "14000000010473", "insurance_payments"),
        ("patient_financing",     "Patient Financing Payments",      "14000000010470", "patient_payments"),
        ("patient_eft_online",    "Electronic Transfer Payments",    "14000000010471", "patient_payments"),
    ]
    _ORG_ID_TO_KEY = {cat[2]: cat[0] for cat in _DEPOSIT_CATS}

    method_buckets = {cat[0]: {"count": 0, "total": 0.0} for cat in _DEPOSIT_CATS}
    unknown_bucket = {"count": 0, "total": 0.0}

    # Patient payments by method
    pat_methods = conn.execute("""
        SELECT json_extract(raw, '$.organizationLedgerType.id') AS org_id,
               ABS(amount) AS amt
        FROM patient_payments
        WHERE transaction_date = ?
          AND location_id = ? AND is_active = 1 AND amount < 0
    """, (date_str, loc_id)).fetchall()
    for r in pat_methods:
        key = _ORG_ID_TO_KEY.get(r["org_id"])
        if key and key in method_buckets:
            method_buckets[key]["count"] += 1
            method_buckets[key]["total"] = round(method_buckets[key]["total"] + float(r["amt"]), 2)
        else:
            unknown_bucket["count"] += 1
            unknown_bucket["total"] = round(unknown_bucket["total"] + float(r["amt"]), 2)

    # Insurance payments by method
    ins_methods = conn.execute("""
        SELECT json_extract(raw, '$.organizationLedgerType.id') AS org_id,
               ABS(amount) AS amt
        FROM insurance_payments
        WHERE transaction_date = ?
          AND location_id = ? AND is_active = 1 AND amount < 0
    """, (date_str, loc_id)).fetchall()
    for r in ins_methods:
        key = _ORG_ID_TO_KEY.get(r["org_id"])
        if key and key in method_buckets:
            method_buckets[key]["count"] += 1
            method_buckets[key]["total"] = round(method_buckets[key]["total"] + float(r["amt"]), 2)
        else:
            unknown_bucket["count"] += 1
            unknown_bucket["total"] = round(unknown_bucket["total"] + float(r["amt"]), 2)

    deposit_categories = [
        {"key": cat[0], "label": cat[1],
         "count": method_buckets[cat[0]]["count"], "total": method_buckets[cat[0]]["total"]}
        for cat in _DEPOSIT_CATS
    ]
    if unknown_bucket["count"] > 0:
        deposit_categories.append(
            {"key": "unknown", "label": "Unknown Payments",
             "count": unknown_bucket["count"], "total": unknown_bucket["total"]}
        )
    deposit_grand_count = sum(c["count"] for c in deposit_categories)
    deposit_grand_total = round(sum(c["total"] for c in deposit_categories), 2)

    # ── 6. Deposit slip detail rows ───────────────────────────────────────────
    # Build a patient name lookup for the detail rows
    detail_patient_ids = set()
    detail_raw_rows = []

    # Build label lookup from category definitions
    _KEY_TO_LABEL = {cat[0]: cat[1] for cat in _DEPOSIT_CATS}

    for src_table in ("patient_payments", "insurance_payments"):
        rows = conn.execute(f"""
            SELECT id, amount, patient_id, transaction_date, raw
            FROM {src_table}
            WHERE transaction_date = ?
              AND location_id = ? AND is_active = 1 AND amount < 0
            ORDER BY id
        """, (date_str, loc_id)).fetchall()
        for r in rows:
            detail_patient_ids.add(r["patient_id"])
            raw_j = json.loads(r["raw"] or "{}")
            org_id = (raw_j.get("organizationLedgerType") or {}).get("id", "")
            method_key = _ORG_ID_TO_KEY.get(org_id, "unknown")
            billing = raw_j.get("patientPaymentBilling") or {}
            ref = billing.get("referenceNumber") or billing.get("checkNumber") or ""
            cc_type_int = raw_j.get("creditCardType")
            cc_brand = {1: "Visa", 2: "Mastercard", 3: "AmEx", 4: "Discover"}.get(cc_type_int)
            # carrier_name for insurance payments via existing extract_carrier
            carrier = extract_carrier(raw_j) if src_table == "insurance_payments" else None
            detail_raw_rows.append({
                "payment_id": r["id"],
                "patient_id": r["patient_id"],
                "transaction_date": r["transaction_date"],
                "amount": round(abs(float(r["amount"])), 2),
                "method_key": method_key,
                "method_label": _KEY_TO_LABEL.get(method_key, "Unknown"),
                "card_brand": cc_brand,
                "reference": ref or None,
                "bank": None,  # Not available in Dentrix REST API
                "carrier_name": carrier,
                "source_table": src_table,
            })

    # Resolve patient names
    patient_names = {}
    if detail_patient_ids:
        ph = ",".join(["?"] * len(detail_patient_ids))
        prows = conn.execute(
            f"SELECT id, first_name, last_name FROM patients WHERE id IN ({ph})",
            tuple(detail_patient_ids),
        ).fetchall()
        patient_names = {
            r["id"]: f"{r['last_name'] or ''}, {r['first_name'] or ''}".strip(", ")
            for r in prows
        }

    deposit_detail = []
    for d in detail_raw_rows:
        d["patient_name"] = patient_names.get(d["patient_id"]) if d["source_table"] == "patient_payments" else None
        if d["source_table"] == "insurance_payments":
            # For insurance, patient_name shows who the payment is for
            d["patient_name"] = patient_names.get(d["patient_id"])
        deposit_detail.append(d)

    # ── 7. Appointments (full status breakdown) ─────────────────────────────
    appt_rows = conn.execute("""
        SELECT status, COUNT(*) AS cnt
        FROM appointments
        WHERE date(start_time) = ?
          AND location_id = ?
        GROUP BY status
    """, (date_str, loc_id)).fetchall()

    # Raw status counts (preserving original Dentrix case)
    raw_status_counts = {r["status"]: r["cnt"] for r in appt_rows}
    appt_total = sum(r["cnt"] for r in appt_rows)

    # Aggregated categories (matching existing dashboard logic at line ~13030)
    # COMPLETED includes CHAIR and CHECKOUT (in-progress terminal states)
    appt_completed = (
        raw_status_counts.get("COMPLETED", 0)
        + raw_status_counts.get("CHAIR", 0)
        + raw_status_counts.get("CHECKOUT", 0)
    )
    # CANCELLED includes all cancel variants Dentrix may use
    appt_cancelled = (
        raw_status_counts.get("CANCELLEDBYOFFICE", 0)
        + raw_status_counts.get("CANCELLEDBYPATIENT", 0)
        + raw_status_counts.get("CANCELLED", 0)
    )
    appt_broken = raw_status_counts.get("BROKEN", 0)
    appt_no_show = raw_status_counts.get("NO_SHOW", 0)
    # CONFIRMED includes all pre-visit confirmed states
    appt_confirmed = raw_status_counts.get("CONFIRMED", 0)
    # SCHEDULED = still pending (UNCONFIRMED + LEFT_MESSAGE + UNREACHABLE + READY)
    appt_scheduled = (
        raw_status_counts.get("UNCONFIRMED", 0)
        + raw_status_counts.get("LEFT_MESSAGE", 0)
        + raw_status_counts.get("UNREACHABLE", 0)
        + raw_status_counts.get("READY", 0)
    )

    # ── 8. Voided transactions (with voided_by attribution) ─────────────────
    # Strategy: find Cancellation rows (the void EVENT), then look up who performed
    # each void via onlineUser on the Cancellation row. previousTransaction links
    # the cancel back to the original procedure.
    #
    # Dentrix void pattern:
    #   Original procedure → is_active=0 (voided)
    #   Cancellation row   → may be is_active=0 or 1, onlineUser = voider
    #   Rebill row         → new procedure after void+rebill (if rebilled)
    #
    # We report: original voided procedures, with voided_by from matching cancel.
    # Exclude Rebill rows that were themselves voided (void→rebill→void chains)
    # to avoid double-counting the same $ amount.

    # Step 1: Get all voided non-Cancellation rows
    voided_rows = conn.execute("""
        SELECT id, amount, ledger_type, patient_id,
               json_extract(raw, '$.lastModified') AS voided_at,
               json_extract(raw, '$.onlineUser.id') AS posted_by_uid
        FROM procedures
        WHERE transaction_date = ?
          AND location_id = ? AND is_active = 0
          AND ledger_type NOT LIKE '%Cancellation%'
        ORDER BY json_extract(raw, '$.lastModified')
    """, (date_str, loc_id)).fetchall()

    # Step 2: Get ALL Cancellation rows for this office/date (any is_active)
    # to build cancel_map: original_procedure_id → cancel_row
    cancel_rows = conn.execute("""
        SELECT id,
               json_extract(raw, '$.previousTransaction.id') AS prev_id,
               json_extract(raw, '$.onlineUser.id') AS voider_uid,
               json_extract(raw, '$.lastModified') AS cancel_at
        FROM procedures
        WHERE transaction_date = ?
          AND location_id = ?
          AND ledger_type LIKE '%Cancellation%'
    """, (date_str, loc_id)).fetchall()
    cancel_map = {r["prev_id"]: r for r in cancel_rows if r["prev_id"]}

    # Step 3: Known user map (same as used elsewhere in main.py)
    _VOID_USERS = {
        "14000000011647": "Ny Velez", "14000000025678": "Elizabeth Velez",
        "14000000033227": "Viv Diaz", "14000000017582": "eAssist Dental Solutions",
        "14000000025410": "Courtney Spaeth", "14000000036783": "Angela Moore",
        "14000000029208": "Cami Lott", "14000000039529": "Latifa Motley",
        "14000000041949": "Mildred Fortune", "14000000045562": "Natasha Torok",
        "14000000046283": "Courtney Wilson", "14000000011514": "Admasu Gizachew",
        "14000000011643": "Nebraska Chaplick", "14000000032056": "Sheryl Dubman",
        "14000000036678": "Katherine Soto", "14000000045208": "Tracy Bushman",
        "14000000044056": "Mark Henin",
    }

    # Step 4: Lazy-fetch any unknown user IDs from Dentrix API
    all_uids = set()
    for r in voided_rows:
        if r["posted_by_uid"]:
            all_uids.add(r["posted_by_uid"])
    for c in cancel_rows:
        if c["voider_uid"]:
            all_uids.add(c["voider_uid"])
    missing_uids = [u for u in all_uids if u not in _VOID_USERS]
    if missing_uids:
        try:
            import requests as _req
            with open("/home/openclaw/.config/ascend/production.json") as _f:
                _creds = json.load(_f)
            _tok = _req.post(_creds["oauth_url"],
                data={"client_id": _creds["api_key"], "client_secret": _creds["secret"]},
                timeout=30).json().get("access_token")
            if _tok:
                _hdrs = {"Authorization": f"Bearer {_tok}", "Organization-ID": _creds["org_id"]}
                for uid in missing_uids[:10]:
                    try:
                        r2 = _req.get(f"{_creds['api_base']}/v1/users/{uid}", headers=_hdrs, timeout=10)
                        if r2.status_code == 200:
                            d2 = r2.json().get("data", r2.json())
                            _VOID_USERS[uid] = f"{d2.get('firstName','')}{' ' if d2.get('firstName') else ''}{d2.get('lastName','')}".strip()
                    except Exception:
                        pass
        except Exception:
            pass

    # Step 5: Patient names
    voided_patient_ids = {r["patient_id"] for r in voided_rows}
    voided_names = {}
    if voided_patient_ids:
        ph = ",".join(["?"] * len(voided_patient_ids))
        prows = conn.execute(
            f"SELECT id, first_name, last_name FROM patients WHERE id IN ({ph})",
            tuple(voided_patient_ids),
        ).fetchall()
        voided_names = {
            r["id"]: f"{r['last_name'] or ''}, {r['first_name'] or ''}".strip(", ")
            for r in prows
        }

    # Step 6: Build void items with attribution
    voided_total = round(sum(abs(float(r["amount"])) for r in voided_rows), 2)
    voided_items = []
    voided_by_matched = 0
    for r in voided_rows:
        cancel = cancel_map.get(r["id"])
        if cancel:
            voider_uid = cancel["voider_uid"]
            voider_name = _VOID_USERS.get(voider_uid) if voider_uid else None
            void_timestamp = cancel["cancel_at"]
            voided_by_matched += 1
        else:
            voider_uid = None
            voider_name = None
            void_timestamp = r["voided_at"]  # fallback to lastModified on original

        voided_items.append({
            "source_table": "procedures",
            "source_id": r["id"],
            "patient_id": r["patient_id"],
            "patient_name": voided_names.get(r["patient_id"]) or None,
            "ledger_type": r["ledger_type"],
            "amount": round(abs(float(r["amount"])), 2),
            "voided_at": void_timestamp,
            "voided_by": voider_name,
            "voided_by_name": voider_name,
            "voided_by_user_id": voider_uid,
            "voided_by_source": "cancellation_row_onlineUser" if cancel else None,
            "posted_by_name": _VOID_USERS.get(r["posted_by_uid"]) if r["posted_by_uid"] else None,
        })

    audit_log_available = voided_by_matched > 0

    conn.close()

    # ── 9. Assemble response ──────────────────────────────────────────────────
    return {
        "metadata": {
            "office_id": office_uuid,
            "office_name": office_name,
            "dentrix_location_id": loc_id,
            "date": date_str,
            "generated_at": generated_at,
            "data_source": "dentrix_fastapi",
            "phase": "eod_daily_report_phase_1",
        },
        "source_freshness": {
            "sqlite_latest_transaction_date": latest_txn,
            "sqlite_latest_entry_date": latest_entry,
            "streaming_consumer_status": streaming_status,
            "warnings": [w for w in warnings if "stale" in w.lower() or "streaming" in w.lower()],
        },

        "production": {
            "gross_production": gross_production if procedure_count > 0 else (0 if gross_production == 0 else gross_production),
            "adjustments": adjustments_total if adjustments_count > 0 else (0 if adjustments_total == 0 else adjustments_total),
            "net_production": net_production,
            "procedure_count": procedure_count,
            "date_basis": "procedures.entry_date; adjustments.transaction_date",
            "source": "existing Dentrix/FastAPI production logic",
        },

        "collections": {
            "allocated_total_collections": total_coll_dl,
            "allocated_patient_collections": pat_coll_dl,
            "allocated_insurance_collections": ins_coll_dl,
            "raw_deposit_total": raw_total,
            "raw_patient_payment_total": raw_pat_total,
            "raw_insurance_payment_total": raw_ins_total,
            "note": "Allocated collections may differ from raw deposit slip totals because distribution_lines attribute payments to charge locations.",
        },

        "deposit_slip": {
            "run_by": "transaction_date",
            "include_voided_payments": False,
            "categories": deposit_categories,
            "grand_total": {
                "count": deposit_grand_count,
                "total": deposit_grand_total,
            },
            "detail_rows": deposit_detail,
        },

        "appointments": {
            "total": appt_total,
            "completed": appt_completed,
            "confirmed": appt_confirmed,
            "scheduled": appt_scheduled,
            "cancelled": appt_cancelled,
            "broken": appt_broken,
            "no_show": appt_no_show,
            "cancelled_source": "CANCELLEDBYOFFICE + CANCELLEDBYPATIENT + CANCELLED statuses in SQLite",
            "confirmed_source": "CONFIRMED status in SQLite",
            "source": "sqlite appointments",
            "status_breakdown": raw_status_counts if raw_status_counts else None,
            "note": "Completed includes CHAIR/CHECKOUT. Scheduled includes UNCONFIRMED/LEFT_MESSAGE/UNREACHABLE/READY. Cancelled includes all Dentrix cancel variants. Status breakdown shows raw Dentrix statuses.",
        },

        "voided_transactions": {
            "count": len(voided_items),
            "total_voided_amount": voided_total,
            "items": voided_items,
            "voided_by_available": audit_log_available,
            "audit_log_available": audit_log_available,
            "note": "Voided-by is shown when matched from Dentrix Cancellation transaction records (onlineUser on the Cancellation row = person who performed the void). Some transaction rows may not have staff attribution if the cancellation record is missing or not yet synced.",
        },

        "warnings": warnings,
    }


# ============================================================================
# EOD Phase 2A — Unscheduled Treatment (Read-Only)
# ============================================================================

_UT_SCHEDULED_STATUSES = (
    "SCHEDULED", "CONFIRMED", "UNCONFIRMED", "READY", "LEFT_MESSAGE", "UNREACHABLE",
)


# ── Supabase PostgREST paginated fetch helper ─────────────────────────────
def _sb_fetch_all(url: str, headers: dict, page_size: int = 1000, timeout: int = 15) -> list:
    """
    Paginate a PostgREST GET using Range headers. Returns all rows.
    Stops when a page returns fewer than page_size rows.
    """
    import requests as _pg_rq
    all_rows: list = []
    offset = 0
    for _ in range(200):  # safety cap at 200k rows
        h = {**headers, "Range": f"{offset}-{offset + page_size - 1}"}
        resp = _pg_rq.get(url, headers=h, timeout=timeout)
        if resp.status_code not in (200, 206):
            break
        batch = resp.json()
        if not isinstance(batch, list):
            break
        all_rows.extend(batch)
        if len(batch) < page_size:
            break
        offset += page_size
    return all_rows


@app.get("/v2/eod/unscheduled-treatment", tags=["EOD"])
def eod_unscheduled_treatment(
    officeId: Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
    date: Optional[str] = Query(None),
    lookbackDays: int = Query(90, ge=1, le=2190),
    includeScheduled: bool = Query(False),
    includeReferredOut: bool = Query(False),
    providerId: Optional[str] = Query(None),
    minValue: Optional[float] = Query(None),
    search: Optional[str] = Query(None),
    page: int = Query(1, ge=1),
    pageSize: int = Query(50, ge=1, le=200),
):
    """
    Read-only unscheduled treatment queue per office.

    Returns active treatment-plan procedures from SQLite where the patient
    has no future appointment at that location.  Grouped by patient.

    Phase 2A: read-only — no contact logging, no assignment, no scorecard.
    """
    import datetime as _dt
    import sqlite3 as _sq3
    import json as _json
    from collections import OrderedDict

    # ── 1  Resolve office ─────────────────────────────────────────────────
    loc_id = locationId
    if not loc_id and officeId:
        loc_id = OFFICE_TO_LOCATION.get(officeId)
    if not loc_id:
        raise HTTPException(status_code=400, detail="officeId or locationId is required")
    if loc_id not in LOCATION_NAMES:
        raise HTTPException(status_code=400, detail=f"Unknown location: {loc_id}")

    office_name = f"NU Dental of {LOCATION_NAMES[loc_id]}"
    office_uuid = LOCATION_TO_OFFICE.get(loc_id, None)

    # ── 2  Resolve date ───────────────────────────────────────────────────
    if not date:
        date = _dt.date.today().isoformat()
    try:
        as_of = _dt.date.fromisoformat(date)
    except ValueError:
        raise HTTPException(status_code=400, detail=f"Invalid date: {date}. Use YYYY-MM-DD.")

    lookback_start = (as_of - _dt.timedelta(days=lookbackDays)).isoformat()
    as_of_str = as_of.isoformat()

    # ── 3  Connect ────────────────────────────────────────────────────────
    conn = _sq3.connect(str(RCM_DB_PATH), timeout=15)
    conn.row_factory = _sq3.Row
    generated_at = _dt.datetime.now(_dt.timezone.utc).isoformat()
    top_warnings: list[str] = []
    freshness_warnings: list[str] = []

    if lookbackDays > 365:
        top_warnings.append(
            f"Large historical lookback ({lookbackDays} days / ~{lookbackDays / 365:.1f} years) "
            "may include stale treatment plans and may take longer to load."
        )

    # ── 4  Source freshness ───────────────────────────────────────────────
    pp_sync = conn.execute(
        "SELECT last_synced_at FROM sync_state WHERE table_name = 'patient_procedures'"
    ).fetchone()
    pp_sync_ts = float(pp_sync["last_synced_at"]) if pp_sync else None
    pp_sync_iso = (
        _dt.datetime.fromtimestamp(pp_sync_ts, tz=_dt.timezone.utc).isoformat()
        if pp_sync_ts else None
    )

    appt_sync = conn.execute(
        "SELECT last_synced_at FROM sync_state WHERE table_name = 'appointments'"
    ).fetchone()
    appt_sync_ts = float(appt_sync["last_synced_at"]) if appt_sync else None
    appt_sync_iso = (
        _dt.datetime.fromtimestamp(appt_sync_ts, tz=_dt.timezone.utc).isoformat()
        if appt_sync_ts else None
    )

    # Latest last_modified in appointments for this location
    appt_latest_row = conn.execute(
        "SELECT MAX(last_modified) AS v FROM appointments WHERE location_id = ?",
        (loc_id,),
    ).fetchone()
    appt_latest_last_modified = appt_latest_row["v"] if appt_latest_row else None

    stale_appointment_warning = False

    if pp_sync_ts:
        age_h = (_dt.datetime.now(_dt.timezone.utc).timestamp() - pp_sync_ts) / 3600
        if age_h > 26:
            msg = f"Treatment plan data is {age_h:.0f}h old — nightly sync may have failed"
            freshness_warnings.append(msg)
            top_warnings.append(msg)

    if appt_sync_ts:
        appt_age_h = (_dt.datetime.now(_dt.timezone.utc).timestamp() - appt_sync_ts) / 3600
        if appt_age_h > 26:
            stale_appointment_warning = True
            msg = f"Appointment data is {appt_age_h:.0f}h old — scheduling detection may show false positives"
            freshness_warnings.append(msg)
            top_warnings.append(msg)

    # Check appointments latest last_modified for staleness (>24h)
    if appt_latest_last_modified:
        try:
            _alm = _dt.datetime.fromisoformat(appt_latest_last_modified.replace("Z", "+00:00"))
            _alm_age = (_dt.datetime.now(_dt.timezone.utc) - _alm).total_seconds() / 3600
            if _alm_age > 24:
                stale_appointment_warning = True
                msg = f"Latest appointment modification is {_alm_age:.0f}h ago — real-time appointment updates may not be flowing"
                freshness_warnings.append(msg)
                top_warnings.append(msg)
        except Exception:
            pass

    # Check streaming consumer status
    import subprocess as _sp
    try:
        _sc = _sp.run(["pgrep", "-f", "streaming_consumer.py"], capture_output=True, timeout=2)
        _streaming_ok = _sc.returncode == 0
    except Exception:
        _streaming_ok = False
    if not _streaming_ok:
        stale_appointment_warning = True
        msg = "Streaming consumer is not running — appointment data may be stale"
        freshness_warnings.append(msg)
        top_warnings.append(msg)

    # ── 5  Identify patients with future appointments + details ───────────
    placeholders = ",".join("?" for _ in _UT_SCHEDULED_STATUSES)

    # Build a dict: patient_id -> list of future appointment dicts
    patient_future_appts: dict[str, list] = {}
    appt_rows = conn.execute(f"""
        SELECT patient_id, id, start_time, end_time, status, provider_id
        FROM appointments
        WHERE location_id = ?
          AND start_time >= ?
          AND status IN ({placeholders})
        ORDER BY start_time
    """, (loc_id, as_of_str, *_UT_SCHEDULED_STATUSES)).fetchall()
    for ar in appt_rows:
        pid = ar["patient_id"]
        if pid not in patient_future_appts:
            patient_future_appts[pid] = []
        patient_future_appts[pid].append({
            "dentrix_appointment_id": ar["id"],
            "start_time": ar["start_time"],
            "end_time": ar["end_time"],
            "status": ar["status"],
            "provider_id": ar["provider_id"],
        })

    scheduled_patient_ids = set(patient_future_appts.keys())

    # ── 6  Pull all qualifying treatment-plan procedures ──────────────────
    base_sql = """
        SELECT
            pp.id              AS procedure_id,
            pp.amount,
            pp.entry_date,
            pp.service_date,
            pp.location_id,
            pp.provider_id,
            pp.patient_id,
            pp.last_modified   AS pp_last_modified,
            pp.raw,
            p.first_name       AS pat_first,
            p.last_name        AS pat_last,
            pr.ada_code,
            pr.description     AS proc_description,
            pr.normalized_service_category AS proc_category,
            prov.first_name    AS prov_first,
            prov.last_name     AS prov_last
        FROM patient_procedures pp
        LEFT JOIN patients p            ON pp.patient_id = p.id
        LEFT JOIN practice_procedures pr ON pp.practice_procedure_id = pr.id
        LEFT JOIN providers prov        ON pp.provider_id = prov.id
        WHERE pp.status = 'TREATMENT_PLAN'
          AND pp.state  = 'ACTIVE'
          AND pp.location_id = ?
          AND pp.entry_date >= ?
    """
    params: list = [loc_id, lookback_start]

    if providerId:
        base_sql += " AND pp.provider_id = ?"
        params.append(providerId)

    if minValue is not None:
        base_sql += " AND pp.amount >= ?"
        params.append(minValue)

    if search:
        sl = f"%{search}%"
        base_sql += """
          AND (
              p.first_name  LIKE ? COLLATE NOCASE
           OR p.last_name   LIKE ? COLLATE NOCASE
           OR pr.ada_code   LIKE ? COLLATE NOCASE
           OR pr.description LIKE ? COLLATE NOCASE
          )
        """
        params.extend([sl, sl, sl, sl])

    base_sql += " ORDER BY pp.entry_date DESC, pp.patient_id, pp.id"
    all_rows = conn.execute(base_sql, params).fetchall()

    # ── 7  Group by patient, annotate, filter ─────────────────────────────
    patient_groups: dict = OrderedDict()
    # Scope-level counters
    scope_patients: set[str] = set()
    scope_procedures = 0
    patients_with_appt: set[str] = set()
    patients_without_appt: set[str] = set()

    for row in all_rows:
        patient_id = row["patient_id"]
        scope_procedures += 1
        scope_patients.add(patient_id)

        has_future_appt = patient_id in scheduled_patient_ids
        if has_future_appt:
            patients_with_appt.add(patient_id)
        else:
            patients_without_appt.add(patient_id)

        # ── Parse raw JSON once ───────────────────────────────────────────
        raw_data: dict = {}
        if row["raw"]:
            try:
                raw_data = _json.loads(row["raw"])
            except Exception:
                pass

        referred_out = raw_data.get("referredOut", False) is True
        bill_to_ins = raw_data.get("billToInsurance", True)
        last_modified = raw_data.get("lastModified") or row["pp_last_modified"]

        if referred_out and not includeReferredOut:
            continue

        if has_future_appt and not includeScheduled:
            continue

        # ── Provider name ─────────────────────────────────────────────────
        prov_name = None
        if row["prov_first"] or row["prov_last"]:
            prov_name = " ".join(filter(None, [row["prov_first"], row["prov_last"]])).strip()

        # ── Teeth / oral cavity ───────────────────────────────────────────
        teeth = []
        teeth_raw = raw_data.get("procedureTeeth", [])
        if teeth_raw:
            teeth = [t.get("toothId") for t in teeth_raw if t.get("toothId")]
        oral_cavity = raw_data.get("oralCavity") or None

        # ── Build procedure record (matches Dr. G spec exactly) ──────────
        proc = {
            "dentrix_procedure_id": row["procedure_id"],
            "ada_code": row["ada_code"],
            "description": row["proc_description"],
            "category": row["proc_category"],
            "amount": round(float(row["amount"]), 2) if row["amount"] is not None else None,
            "provider_name": prov_name,
            "dentrix_provider_id": row["provider_id"],
            "entry_date": row["entry_date"],
            "service_date": row["service_date"],
            "bill_to_insurance": bill_to_ins,
            "referred_out": referred_out,
            "teeth": teeth,
            "oral_cavity": oral_cavity,
            "last_modified": last_modified,
        }

        # ── Patient name ──────────────────────────────────────────────────
        pat_name = None
        if row["pat_first"] or row["pat_last"]:
            parts = []
            if row["pat_last"]:
                parts.append(row["pat_last"])
            if row["pat_first"]:
                parts.append(row["pat_first"])
            pat_name = ", ".join(parts)

        if patient_id not in patient_groups:
            patient_groups[patient_id] = {
                "patient_id": patient_id,
                "patient_name": pat_name,
                "has_future_appt": has_future_appt,
                "procedures": [],
                "_total_value": 0.0,
                "_latest_entry": row["entry_date"],
                "_earliest_entry": row["entry_date"],
                "_providers": {},       # prov_name -> count
                "_categories": {},      # cat -> value
                "_bill_to_insurance_any": False,
                "_referred_out_any": False,
            }

        grp = patient_groups[patient_id]
        grp["procedures"].append(proc)
        grp["_total_value"] += (proc["amount"] or 0)

        ed = row["entry_date"]
        if ed:
            if not grp["_latest_entry"] or ed > grp["_latest_entry"]:
                grp["_latest_entry"] = ed
            if not grp["_earliest_entry"] or ed < grp["_earliest_entry"]:
                grp["_earliest_entry"] = ed

        if prov_name:
            grp["_providers"][prov_name] = grp["_providers"].get(prov_name, 0) + 1
        cat = row["proc_category"] or "Unknown"
        grp["_categories"][cat] = grp["_categories"].get(cat, 0) + (proc["amount"] or 0)
        if bill_to_ins:
            grp["_bill_to_insurance_any"] = True
        if referred_out:
            grp["_referred_out_any"] = True

    # ── 8  Finalize patient records ───────────────────────────────────────
    patients_list: list[dict] = []
    # Accumulators for top_categories / top_providers across ALL returned patients
    agg_categories: dict[str, dict] = {}
    agg_providers: dict[str, dict] = {}

    for patient_id, grp in patient_groups.items():
        procs = grp["procedures"]
        if not procs:
            continue

        highest = max(procs, key=lambda p: p["amount"])
        primary_cat = max(grp["_categories"], key=grp["_categories"].get) if grp["_categories"] else None
        # Primary provider = provider with most procedures for this patient
        primary_prov = max(grp["_providers"], key=grp["_providers"].get) if grp["_providers"] else None

        # Future appointments for this patient (empty list if none)
        future_appts = patient_future_appts.get(patient_id, [])

        patient_record = {
            "dentrix_patient_id": patient_id,
            "patient_name": grp["patient_name"],
            "office_name": office_name,
            "dentrix_location_id": loc_id,
            "procedure_count": len(procs),
            "total_value": round(grp["_total_value"], 2),
            "highest_value_procedure": (
                f"{highest['ada_code'] or '???'} — {highest['description'] or 'Unknown'}"
            ),
            "primary_category": primary_cat,
            "treatment_plan_date": grp["_earliest_entry"],
            "latest_treatment_plan_date": grp["_latest_entry"],
            "provider_name": primary_prov,
            "has_future_appointment": grp["has_future_appt"],
            "future_appointments": future_appts,
            "bill_to_insurance": grp["_bill_to_insurance_any"],
            "referred_out": grp["_referred_out_any"],
            "procedures": sorted(procs, key=lambda p: p["amount"], reverse=True),
        }
        patients_list.append(patient_record)

        # Accumulate for summary top_categories
        for cat_name, cat_val in grp["_categories"].items():
            if cat_name not in agg_categories:
                agg_categories[cat_name] = {"category": cat_name, "procedure_count": 0, "value": 0.0}
            cnt = sum(1 for p in procs if (p.get("category") or "Unknown") == cat_name)
            agg_categories[cat_name]["procedure_count"] += cnt
            agg_categories[cat_name]["value"] = round(agg_categories[cat_name]["value"] + cat_val, 2)

        # Accumulate for summary top_providers
        for prov_n, prov_cnt in grp["_providers"].items():
            if prov_n not in agg_providers:
                agg_providers[prov_n] = {"provider_name": prov_n, "procedure_count": 0, "patient_count": 0, "value": 0.0}
            agg_providers[prov_n]["procedure_count"] += prov_cnt
            agg_providers[prov_n]["patient_count"] += 1
            prov_val = sum(p["amount"] for p in procs if p.get("provider_name") == prov_n)
            agg_providers[prov_n]["value"] = round(agg_providers[prov_n]["value"] + prov_val, 2)

    # ── 8b  Warn about missing patient names ─────────────────────────────
    _missing_names = sum(1 for p in patients_list if not p.get("patient_name"))
    if _missing_names:
        top_warnings.append(
            f"{_missing_names} patient(s) have no name in the patients table — "
            "these may be recently added and not yet synced"
        )

    # ── 9  Sort patients (highest total value first) ──────────────────────
    patients_list.sort(key=lambda p: p["total_value"], reverse=True)

    # ── 10  Summary (before pagination) ───────────────────────────────────
    total_patients = len(patients_list)
    total_procedures = sum(p["procedure_count"] for p in patients_list)
    total_value = round(sum(p["total_value"] for p in patients_list), 2)
    total_pages = max(1, -(-total_patients // pageSize))

    top_categories = sorted(agg_categories.values(), key=lambda c: c["value"], reverse=True)
    top_providers = sorted(agg_providers.values(), key=lambda p: p["value"], reverse=True)

    # ── 11  Paginate ──────────────────────────────────────────────────────
    start_idx = (page - 1) * pageSize
    page_patients = patients_list[start_idx : start_idx + pageSize]

    conn.close()

    # ── 12  Workflow overlay (Phase 2E) ───────────────────────────────────
    #   Batch-fetch Supabase workflow rows for ALL patients (not just page)
    #   so workflow_summary covers full result set.
    import requests as _wf_rq

    _wf_queue_map: dict[str, dict] = {}       # dentrix_patient_id -> queue row
    _wf_contact_map: dict[str, dict] = {}     # queue_id -> latest contact
    _wf_user_names: dict[str, str] = {}       # user_id -> full_name
    _wf_available = True

    try:
        with open("/home/openclaw/.config/supabase/nudental.json") as _wf_f:
            _wf_sb = _json.load(_wf_f)
        _wf_url = _wf_sb["project_url"] + "/rest/v1"
        _wf_key = _wf_sb["secret_key"]
        _wf_hdrs = {
            "apikey": _wf_key,
            "Authorization": f"Bearer {_wf_key}",
        }
    except Exception:
        _wf_available = False

    if _wf_available and office_uuid:
        # 12a  Fetch ALL queue rows for this office (paginated to avoid 1k cap)
        try:
            _wf_all_q = _sb_fetch_all(
                f"{_wf_url}/unscheduled_treatment_queue"
                f"?office_id=eq.{office_uuid}"
                f"&select=id,dentrix_patient_id,queue_status,priority,"
                f"assigned_to,assigned_by,assigned_at,follow_up_date,"
                f"last_contact_at,last_contact_outcome,contact_attempt_count,"
                f"last_scheduled_date,last_scheduled_appt_id,"
                f"is_current,last_synced_at",
                headers=_wf_hdrs, timeout=15,
            )
            for r in _wf_all_q:
                _wf_queue_map[r["dentrix_patient_id"]] = r
        except Exception:
            _wf_available = False

    # 12b  Collect queue IDs that appear on any returned patient (all pages)
    _wf_all_patient_ids = {p["dentrix_patient_id"] for p in patients_list}
    _wf_matched_queue_ids = []
    for pid in _wf_all_patient_ids:
        qr = _wf_queue_map.get(pid)
        if qr:
            _wf_matched_queue_ids.append(qr["id"])

    # 12c  Batch-fetch latest contact per queue (only for page patients to limit payload)
    _wf_page_queue_ids = []
    for p in page_patients:
        qr = _wf_queue_map.get(p["dentrix_patient_id"])
        if qr:
            _wf_page_queue_ids.append(qr["id"])

    if _wf_available and _wf_page_queue_ids:
        # Use the view for latest contact, or fetch contacts ordered by contact_at desc
        # Batch: fetch latest contact per queue_id using PostgREST
        # Strategy: fetch contacts for these queue_ids ordered desc, dedupe in Python
        try:
            _qid_filter = ",".join(f'"{qid}"' for qid in _wf_page_queue_ids)
            _wf_c_resp = _wf_rq.get(
                f"{_wf_url}/unscheduled_treatment_contacts"
                f"?queue_id=in.({','.join(_wf_page_queue_ids)})"
                f"&select=id,queue_id,contacted_by,contacted_by_name,"
                f"contact_at,outcome,notes,follow_up_date,scheduled_date"
                f"&order=contact_at.desc"
                f"&limit={len(_wf_page_queue_ids) * 3}",
                headers=_wf_hdrs, timeout=10,
            )
            if _wf_c_resp.status_code == 200:
                for c in _wf_c_resp.json():
                    qid = c["queue_id"]
                    if qid not in _wf_contact_map:
                        _wf_contact_map[qid] = c
        except Exception:
            pass

    # 12d  Resolve assigned_to names (batch)
    _wf_assigned_uids = set()
    for pid in _wf_all_patient_ids:
        qr = _wf_queue_map.get(pid)
        if qr and qr.get("assigned_to"):
            _wf_assigned_uids.add(qr["assigned_to"])

    if _wf_available and _wf_assigned_uids:
        try:
            uid_list = ",".join(_wf_assigned_uids)
            _wf_u_resp = _wf_rq.get(
                f"{_wf_url}/user_profiles"
                f"?id=in.({uid_list})"
                f"&select=id,full_name",
                headers=_wf_hdrs, timeout=5,
            )
            if _wf_u_resp.status_code == 200:
                for u in _wf_u_resp.json():
                    _wf_user_names[u["id"]] = u.get("full_name")
        except Exception:
            pass

    # 12e  Build workflow_summary (across ALL patients, not just page)
    _wf_summary = {
        "workflow_rows_matched": 0,
        "pending": 0,
        "in_progress": 0,
        "scheduled": 0,
        "completed": 0,
        "deferred": 0,
        "dismissed": 0,
        "do_not_call": 0,
        "assigned": 0,
        "unassigned": 0,
        "follow_ups_due": 0,
        "follow_ups_overdue": 0,
    }

    _today_str = _dt.date.today().isoformat()

    for pid in _wf_all_patient_ids:
        qr = _wf_queue_map.get(pid)
        if not qr:
            _wf_summary["unassigned"] += 1
            continue
        _wf_summary["workflow_rows_matched"] += 1
        qs = qr.get("queue_status") or "pending"
        if qs in _wf_summary:
            _wf_summary[qs] += 1
        if qr.get("assigned_to"):
            _wf_summary["assigned"] += 1
        else:
            _wf_summary["unassigned"] += 1
        fu = qr.get("follow_up_date")
        if fu:
            if fu <= _today_str:
                _wf_summary["follow_ups_overdue"] += 1
            else:
                _wf_summary["follow_ups_due"] += 1

    # 12f  Attach workflow to each page patient
    _wf_empty_contact = {
        "contact_id": None,
        "contacted_by": None,
        "contacted_by_name": None,
        "contact_at": None,
        "outcome": None,
        "notes": None,
        "follow_up_date": None,
        "scheduled_date": None,
    }

    for p in page_patients:
        pid = p["dentrix_patient_id"]
        qr = _wf_queue_map.get(pid)
        if qr:
            qid = qr["id"]
            lc = _wf_contact_map.get(qid)
            latest_contact = {
                "contact_id": lc["id"] if lc else None,
                "contacted_by": lc["contacted_by"] if lc else None,
                "contacted_by_name": lc["contacted_by_name"] if lc else None,
                "contact_at": lc["contact_at"] if lc else None,
                "outcome": lc["outcome"] if lc else None,
                "notes": lc["notes"] if lc else None,
                "follow_up_date": lc["follow_up_date"] if lc else None,
                "scheduled_date": lc["scheduled_date"] if lc else None,
            } if lc else dict(_wf_empty_contact)

            p["workflow"] = {
                "queue_id": qid,
                "queue_status": qr.get("queue_status"),
                "priority": qr.get("priority"),
                "assigned_to": qr.get("assigned_to"),
                "assigned_to_name": _wf_user_names.get(qr["assigned_to"]) if qr.get("assigned_to") else None,
                "assigned_by": qr.get("assigned_by"),
                "assigned_at": qr.get("assigned_at"),
                "follow_up_date": qr.get("follow_up_date"),
                "last_contact_at": qr.get("last_contact_at"),
                "last_contact_outcome": qr.get("last_contact_outcome"),
                "contact_attempt_count": qr.get("contact_attempt_count", 0),
                "last_scheduled_date": qr.get("last_scheduled_date"),
                "last_scheduled_appt_id": qr.get("last_scheduled_appt_id"),
                "is_current": qr.get("is_current", True),
                "last_synced_at": qr.get("last_synced_at"),
                "has_workflow_row": True,
                "latest_contact": latest_contact,
            }
        else:
            p["workflow"] = {
                "queue_id": None,
                "queue_status": None,
                "priority": None,
                "assigned_to": None,
                "assigned_to_name": None,
                "assigned_by": None,
                "assigned_at": None,
                "follow_up_date": None,
                "last_contact_at": None,
                "last_contact_outcome": None,
                "contact_attempt_count": 0,
                "last_scheduled_date": None,
                "last_scheduled_appt_id": None,
                "is_current": None,
                "last_synced_at": None,
                "has_workflow_row": False,
                "latest_contact": dict(_wf_empty_contact),
            }

    # ── 13  Build response ────────────────────────────────────────────────
    return {
        "metadata": {
            "office_id": office_uuid,
            "office_name": office_name,
            "dentrix_location_id": loc_id,
            "as_of_date": as_of_str,
            "lookback_days": lookbackDays,
            "lookback_start": lookback_start,
            "generated_at": generated_at,
            "data_source": "sqlite_patient_procedures + appointments + supabase_workflow",
            "endpoint_version": "phase_2e_workflow_overlay",
        },
        "source_freshness": {
            "patient_procedures_synced_at": pp_sync_iso,
            "appointments_synced_at": appt_sync_iso,
            "appointments_latest_last_modified": appt_latest_last_modified,
            "stale_appointment_warning": stale_appointment_warning,
            "warnings": freshness_warnings,
        },
        "definition": {
            "status_filter": "TREATMENT_PLAN",
            "state_filter": "ACTIVE",
            "future_appointment_statuses": list(_UT_SCHEDULED_STATUSES),
            "scheduled_detection_basis": "patient_id + location_id future appointment",
            "procedure_to_appointment_linkage_available": False,
            "note": (
                "A patient with any future appointment at the same office is treated "
                "as likely scheduled because Dentrix does not expose procedure-to-appointment "
                "linkage in this source."
            ),
        },
        "summary": {
            "total_unscheduled_patients": total_patients,
            "total_unscheduled_procedures": total_procedures,
            "total_unscheduled_value": total_value,
            "total_treatment_plan_patients_in_scope": len(scope_patients),
            "total_treatment_plan_procedures_in_scope": scope_procedures,
            "patients_with_future_appointment": len(patients_with_appt),
            "patients_without_future_appointment": len(patients_without_appt),
            "top_categories": top_categories,
            "top_providers": top_providers,
        },
        "workflow_summary": _wf_summary,
        "patients": page_patients,
        "pagination": {
            "page": page,
            "page_size": pageSize,
            "total_patients": total_patients,
            "total_pages": total_pages,
        },
        "warnings": top_warnings if top_warnings else [],
    }


# ============================================================================
# EOD Phase 2G — Contact History + Assignees (Read-Only)
# ============================================================================

@app.get("/v2/eod/unscheduled-treatment/{queue_id}/contacts", tags=["EOD"],
         dependencies=[Depends(verify_api_key)])
def eod_unscheduled_treatment_contact_history(queue_id: str):
    """
    Read-only contact history for a single queue item.
    Returns all contact attempts ordered most recent first.
    Phase 2G: read-only — no writes.
    """
    import json as _json
    import requests as _rq

    try:
        with open("/home/openclaw/.config/supabase/nudental.json") as _f:
            _sb = _json.load(_f)
        _sb_url = _sb["project_url"] + "/rest/v1"
        _sb_key = _sb["secret_key"]
        _sb_hdrs = {"apikey": _sb_key, "Authorization": f"Bearer {_sb_key}"}
    except Exception as e:
        raise HTTPException(500, f"Supabase config error: {e}")

    # Validate queue item exists
    q_resp = _rq.get(
        f"{_sb_url}/unscheduled_treatment_queue"
        f"?id=eq.{queue_id}"
        f"&select=id,office_id,dentrix_patient_id,patient_name,queue_status,"
        f"contact_attempt_count,total_value,procedure_count",
        headers=_sb_hdrs, timeout=10,
    )
    if q_resp.status_code != 200 or not q_resp.json():
        raise HTTPException(404, f"Queue item not found: {queue_id}")

    queue_item = q_resp.json()[0]
    office_uuid = queue_item["office_id"]
    office_name = None
    for loc_id, name in LOCATION_NAMES.items():
        if LOCATION_TO_OFFICE.get(loc_id) == office_uuid:
            office_name = f"NU Dental of {name}"
            break

    # Fetch all contacts for this queue item
    c_resp = _rq.get(
        f"{_sb_url}/unscheduled_treatment_contacts"
        f"?queue_id=eq.{queue_id}"
        f"&select=id,contacted_by_name,contact_at,outcome,notes,"
        f"follow_up_date,scheduled_date,created_at"
        f"&order=contact_at.desc",
        headers=_sb_hdrs, timeout=10,
    )
    contacts = []
    if c_resp.status_code == 200:
        for c in c_resp.json():
            contacts.append({
                "contact_id": c["id"],
                "contacted_by_name": c["contacted_by_name"],
                "contact_at": c["contact_at"],
                "outcome": c["outcome"],
                "notes": c["notes"],
                "follow_up_date": c["follow_up_date"],
                "scheduled_date": c["scheduled_date"],
                "created_at": c["created_at"],
            })

    return {
        "queue_id": queue_id,
        "office_name": office_name,
        "patient_name": queue_item["patient_name"],
        "dentrix_patient_id": queue_item["dentrix_patient_id"],
        "queue_status": queue_item["queue_status"],
        "contact_attempt_count": queue_item["contact_attempt_count"],
        "total_value": queue_item["total_value"],
        "procedure_count": queue_item["procedure_count"],
        "contacts": contacts,
        "total_contacts": len(contacts),
    }


@app.get("/v2/eod/unscheduled-treatment/assignees", tags=["EOD"],
         dependencies=[Depends(verify_api_key)])
def eod_unscheduled_treatment_assignees(
    officeId: Optional[str] = Query(None),
):
    """
    Read-only eligible assignees for unscheduled treatment queue items.
    Returns active users who can be assigned queue work for the given office.
    Phase 2G: read-only.
    """
    import json as _json
    import requests as _rq

    try:
        with open("/home/openclaw/.config/supabase/nudental.json") as _f:
            _sb = _json.load(_f)
        _sb_url = _sb["project_url"] + "/rest/v1"
        _sb_key = _sb["secret_key"]
        _sb_hdrs = {"apikey": _sb_key, "Authorization": f"Bearer {_sb_key}"}
    except Exception as e:
        raise HTTPException(500, f"Supabase config error: {e}")

    # Fetch active users
    u_resp = _rq.get(
        f"{_sb_url}/user_profiles"
        f"?is_active=eq.true"
        f"&select=id,full_name,email,work_email,role,office_id",
        headers=_sb_hdrs, timeout=10,
    )
    if u_resp.status_code != 200:
        raise HTTPException(502, "Failed to fetch user profiles")

    all_users = u_resp.json()

    # Also fetch user_office_assignments for multi-office staff
    uoa_resp = _rq.get(
        f"{_sb_url}/user_office_assignments"
        f"?select=user_id,office_id,all_offices",
        headers=_sb_hdrs, timeout=10,
    )
    uoa_map: dict[str, list] = {}  # user_id -> list of office_ids or all_offices
    if uoa_resp.status_code == 200:
        for a in uoa_resp.json():
            uid = a["user_id"]
            if uid not in uoa_map:
                uoa_map[uid] = []
            uoa_map[uid].append(a)

    # All-office roles
    all_office_roles = {"super_admin", "admin", "regional_manager", "regional_clinical_manager"}

    assignees = []
    for u in all_users:
        user_id = u["id"]
        role = u.get("role", "")
        user_office = u.get("office_id")

        # Determine if user can access the requested office
        if officeId:
            can_access = (
                role in all_office_roles
                or user_office == officeId
                or any(
                    a.get("office_id") == officeId or a.get("all_offices")
                    for a in uoa_map.get(user_id, [])
                )
            )
            if not can_access:
                continue

        assignees.append({
            "user_id": user_id,
            "name": u.get("full_name"),
            "email": u.get("work_email") or u.get("email"),
            "role": role,
            "office_id": user_office,
        })

    # Sort: managers first, then alphabetical
    role_order = {
        "super_admin": 0, "admin": 1, "regional_manager": 2,
        "regional_clinical_manager": 3, "office_manager": 4, "staff": 5,
    }
    assignees.sort(key=lambda a: (role_order.get(a["role"], 9), a.get("name", "")))

    return {
        "office_id": officeId,
        "assignees": assignees,
        "total": len(assignees),
    }


# ============================================================================
# EOD Phase 2D — Unscheduled Treatment Queue Sync
# ============================================================================

@app.post("/v2/eod/unscheduled-treatment/sync", tags=["EOD"],
          dependencies=[Depends(verify_api_key)])
def eod_unscheduled_treatment_sync(
    officeId: Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
    allOffices: bool = Query(False),
    date: Optional[str] = Query(None),
    lookbackDays: int = Query(90, ge=1, le=2190),
    includeScheduled: bool = Query(False),
    includeReferredOut: bool = Query(False),
    dry_run: bool = Query(True),
    limit: Optional[int] = Query(None, ge=1, le=5000),
):
    """
    Backend-only queue sync: reads SQLite unscheduled treatment data and
    upserts into Supabase unscheduled_treatment_queue +
    unscheduled_treatment_queue_procedures.

    Phase 2D: sync only — no contact logging, no assignment, no scorecard.

    Uses service_role to bypass RLS.  Requires X-API-Key auth.
    """
    import datetime as _dt
    import sqlite3 as _sq3
    import json as _json
    import hashlib as _hl
    from collections import OrderedDict

    # ── 0  Supabase service config ────────────────────────────────────────
    try:
        with open("/home/openclaw/.config/supabase/nudental.json") as _f:
            _sb = _json.load(_f)
        _sb_url = _sb["project_url"] + "/rest/v1"
        _sb_key = _sb["secret_key"]
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Supabase config error: {e}")

    def _sb_headers(prefer="return=representation"):
        return {
            "apikey": _sb_key,
            "Authorization": f"Bearer {_sb_key}",
            "Content-Type": "application/json",
            "Prefer": f"resolution=merge-duplicates,{prefer}",
        }

    # ── 1  Resolve offices ────────────────────────────────────────────────
    if allOffices:
        target_offices = list(OFFICE_TO_LOCATION.items())
    elif locationId:
        office_uuid = LOCATION_TO_OFFICE.get(locationId)
        if not office_uuid:
            raise HTTPException(400, f"Unknown locationId: {locationId}")
        target_offices = [(office_uuid, locationId)]
    elif officeId:
        loc = OFFICE_TO_LOCATION.get(officeId)
        if not loc:
            raise HTTPException(400, f"Unknown officeId: {officeId}")
        target_offices = [(officeId, loc)]
    else:
        raise HTTPException(400, "officeId, locationId, or allOffices=true required")

    # ── 2  Date ───────────────────────────────────────────────────────────
    if not date:
        date = _dt.date.today().isoformat()
    try:
        as_of = _dt.date.fromisoformat(date)
    except ValueError:
        raise HTTPException(400, f"Invalid date: {date}")

    lookback_start = (as_of - _dt.timedelta(days=lookbackDays)).isoformat()
    as_of_str = as_of.isoformat()
    generated_at = _dt.datetime.now(_dt.timezone.utc).isoformat()

    # ── 3  Connect SQLite ─────────────────────────────────────────────────
    conn = _sq3.connect(str(RCM_DB_PATH), timeout=15)
    conn.row_factory = _sq3.Row

    # ── 4  Sync each office ───────────────────────────────────────────────
    office_results = []
    total_q_inserted = 0
    total_q_updated = 0
    total_q_unchanged = 0
    total_q_stale = 0
    total_p_inserted = 0
    total_p_updated = 0
    total_p_unchanged = 0
    total_p_stale = 0
    total_audit_rows = 0
    sample_queue_row = None
    sample_proc_row = None
    all_warnings: list[str] = []
    all_queue_ids_seen: dict[str, set] = {}  # office_uuid -> set of queue IDs seen

    for office_uuid, loc_id in target_offices:
        office_name = f"NU Dental of {LOCATION_NAMES.get(loc_id, 'Unknown')}"
        o_q_ins = o_q_upd = o_q_unch = o_q_stale = 0
        o_p_ins = o_p_upd = o_p_unch = o_p_stale = 0
        o_audit = 0
        queue_ids_seen = set()

        # ── 4a  Future appointments ───────────────────────────────────────
        placeholders = ",".join("?" for _ in _UT_SCHEDULED_STATUSES)
        patient_future_appts: dict[str, list] = {}
        appt_rows = conn.execute(f"""
            SELECT patient_id, id, start_time, end_time, status, provider_id
            FROM appointments
            WHERE location_id = ?
              AND start_time >= ?
              AND status IN ({placeholders})
            ORDER BY start_time
        """, (loc_id, as_of_str, *_UT_SCHEDULED_STATUSES)).fetchall()
        for ar in appt_rows:
            pid = ar["patient_id"]
            if pid not in patient_future_appts:
                patient_future_appts[pid] = []
            patient_future_appts[pid].append({
                "dentrix_appointment_id": ar["id"],
                "start_time": ar["start_time"],
                "status": ar["status"],
            })
        scheduled_patient_ids = set(patient_future_appts.keys())

        # ── 4b  Treatment plan procedures ─────────────────────────────────
        sql = """
            SELECT
                pp.id              AS procedure_id,
                pp.amount,
                pp.entry_date,
                pp.service_date,
                pp.location_id,
                pp.provider_id,
                pp.patient_id,
                pp.last_modified   AS pp_last_modified,
                pp.raw,
                p.first_name       AS pat_first,
                p.last_name        AS pat_last,
                pr.ada_code,
                pr.description     AS proc_description,
                pr.normalized_service_category AS proc_category,
                prov.first_name    AS prov_first,
                prov.last_name     AS prov_last
            FROM patient_procedures pp
            LEFT JOIN patients p            ON pp.patient_id = p.id
            LEFT JOIN practice_procedures pr ON pp.practice_procedure_id = pr.id
            LEFT JOIN providers prov        ON pp.provider_id = prov.id
            WHERE pp.status = 'TREATMENT_PLAN'
              AND pp.state  = 'ACTIVE'
              AND pp.location_id = ?
              AND pp.entry_date >= ?
            ORDER BY pp.entry_date DESC, pp.patient_id, pp.id
        """
        all_rows = conn.execute(sql, [loc_id, lookback_start]).fetchall()

        # ── 4c  Group by patient ──────────────────────────────────────────
        patient_groups: dict = OrderedDict()
        for row in all_rows:
            patient_id = row["patient_id"]
            has_future_appt = patient_id in scheduled_patient_ids

            raw_data: dict = {}
            if row["raw"]:
                try:
                    raw_data = _json.loads(row["raw"])
                except Exception:
                    pass

            referred_out = raw_data.get("referredOut", False) is True
            bill_to_ins = raw_data.get("billToInsurance", True)
            last_modified = raw_data.get("lastModified") or row["pp_last_modified"]

            if referred_out and not includeReferredOut:
                continue
            if has_future_appt and not includeScheduled:
                continue

            prov_name = None
            if row["prov_first"] or row["prov_last"]:
                prov_name = " ".join(filter(None, [row["prov_first"], row["prov_last"]])).strip()

            teeth = []
            teeth_raw = raw_data.get("procedureTeeth", [])
            if teeth_raw:
                teeth = [t.get("toothId") for t in teeth_raw if t.get("toothId")]
            oral_cavity = raw_data.get("oralCavity") or None

            proc = {
                "dentrix_procedure_id": row["procedure_id"],
                "ada_code": row["ada_code"],
                "procedure_description": row["proc_description"],
                "procedure_category": row["proc_category"],
                "amount": round(float(row["amount"]), 2) if row["amount"] is not None else None,
                "provider_name": prov_name,
                "dentrix_provider_id": row["provider_id"],
                "treatment_plan_date": row["entry_date"],
                "service_date": row["service_date"],
                "bill_to_insurance": bill_to_ins,
                "referred_out": referred_out,
                "teeth": teeth,
                "oral_cavity": oral_cavity,
                "source_last_modified": last_modified,
            }

            pat_name = None
            if row["pat_first"] or row["pat_last"]:
                parts = []
                if row["pat_last"]:
                    parts.append(row["pat_last"])
                if row["pat_first"]:
                    parts.append(row["pat_first"])
                pat_name = ", ".join(parts)

            if patient_id not in patient_groups:
                patient_groups[patient_id] = {
                    "patient_id": patient_id,
                    "patient_name": pat_name,
                    "has_future_appt": has_future_appt,
                    "procedures": [],
                    "total_value": 0.0,
                    "providers": {},
                    "categories": {},
                    "bill_to_insurance_any": False,
                    "referred_out_any": False,
                    "latest_entry": row["entry_date"],
                }

            grp = patient_groups[patient_id]
            grp["procedures"].append(proc)
            grp["total_value"] += (proc["amount"] or 0)

            ed = row["entry_date"]
            if ed and (not grp["latest_entry"] or ed > grp["latest_entry"]):
                grp["latest_entry"] = ed

            if prov_name:
                grp["providers"][prov_name] = grp["providers"].get(prov_name, 0) + 1
            cat = row["proc_category"] or "Unknown"
            grp["categories"][cat] = grp["categories"].get(cat, 0) + (proc["amount"] or 0)
            if bill_to_ins:
                grp["bill_to_insurance_any"] = True
            if referred_out:
                grp["referred_out_any"] = True

        # ── 4d  Apply limit ──────────────────────────────────────────────
        patient_ids = list(patient_groups.keys())
        if limit and len(patient_ids) > limit:
            patient_ids = patient_ids[:limit]
            all_warnings.append(f"Limited to {limit} patients for {office_name} (full scope: {len(patient_groups)})")

        # ── 4e  Build queue + procedure rows ──────────────────────────────
        queue_rows_to_upsert = []
        proc_rows_to_upsert = []

        for pid in patient_ids:
            grp = patient_groups[pid]
            procs = grp["procedures"]
            if not procs:
                continue

            highest = max(procs, key=lambda p: p["amount"] or 0)
            primary_cat = max(grp["categories"], key=grp["categories"].get) if grp["categories"] else None
            primary_prov = max(grp["providers"], key=grp["providers"].get) if grp["providers"] else None

            # Source hash for change detection (snapshot fields only)
            hash_input = _json.dumps({
                "patient_name": grp["patient_name"],
                "total_value": round(grp["total_value"], 2),
                "procedure_count": len(procs),
                "has_future_appt": grp["has_future_appt"],
                "primary_category": primary_cat,
                "provider_name": primary_prov,
                "latest_entry": grp["latest_entry"],
                "bill_to_insurance": grp["bill_to_insurance_any"],
                "referred_out": grp["referred_out_any"],
                "proc_ids": sorted([p["dentrix_procedure_id"] for p in procs]),
            }, sort_keys=True)
            source_hash = _hl.sha256(hash_input.encode()).hexdigest()[:16]

            q_row = {
                "office_id": office_uuid,
                "dentrix_location_id": loc_id,
                "dentrix_patient_id": pid,
                "patient_name": grp["patient_name"],
                "total_value": round(grp["total_value"], 2),
                "procedure_count": len(procs),
                "highest_value_procedure": (
                    f"{highest['ada_code'] or '???'} — {highest['procedure_description'] or 'Unknown'}"
                ),
                "primary_category": primary_cat,
                "provider_name": primary_prov,
                "latest_treatment_plan_date": grp["latest_entry"],
                "has_future_appointment": grp["has_future_appt"],
                "bill_to_insurance": grp["bill_to_insurance_any"],
                "referred_out": grp["referred_out_any"],
                "source_hash": source_hash,
                "source_last_seen_at": generated_at,
                "is_current": True,
                "last_synced_at": generated_at,
            }
            queue_rows_to_upsert.append(q_row)

            for proc in procs:
                p_hash_input = _json.dumps({
                    "ada_code": proc["ada_code"],
                    "amount": proc["amount"],
                    "provider_name": proc["provider_name"],
                    "treatment_plan_date": proc["treatment_plan_date"],
                    "bill_to_insurance": proc["bill_to_insurance"],
                    "referred_out": proc["referred_out"],
                    "teeth": proc["teeth"],
                }, sort_keys=True)
                p_hash = _hl.sha256(p_hash_input.encode()).hexdigest()[:16]

                p_row = {
                    "office_id": office_uuid,
                    "dentrix_location_id": loc_id,
                    "dentrix_patient_id": pid,
                    "dentrix_procedure_id": proc["dentrix_procedure_id"],
                    "ada_code": proc["ada_code"],
                    "procedure_description": proc["procedure_description"],
                    "procedure_category": proc["procedure_category"],
                    "amount": proc["amount"],
                    "provider_name": proc["provider_name"],
                    "dentrix_provider_id": proc["dentrix_provider_id"],
                    "treatment_plan_date": proc["treatment_plan_date"],
                    "service_date": proc["service_date"],
                    "bill_to_insurance": proc["bill_to_insurance"],
                    "referred_out": proc["referred_out"],
                    "teeth": _json.dumps(proc["teeth"]) if proc["teeth"] else "[]",
                    "oral_cavity": proc["oral_cavity"],
                    "source_last_modified": proc["source_last_modified"],
                    "source_hash": p_hash,
                    "is_current": True,
                }
                proc_rows_to_upsert.append(p_row)

        # ── 4f  DRY-RUN: skip writes, compute stats ──────────────────────
        if dry_run:
            # Query existing rows for diff stats (paginated)
            import requests as _rq
            existing_q = {}
            _eq_rows = _sb_fetch_all(
                f"{_sb_url}/unscheduled_treatment_queue"
                f"?office_id=eq.{office_uuid}&select=dentrix_patient_id,source_hash,queue_status,is_current",
                headers={"apikey": _sb_key, "Authorization": f"Bearer {_sb_key}"},
                timeout=15,
            )
            for r in _eq_rows:
                existing_q[r["dentrix_patient_id"]] = r

            for qr in queue_rows_to_upsert:
                dpid = qr["dentrix_patient_id"]
                ex = existing_q.get(dpid)
                if not ex:
                    o_q_ins += 1
                elif ex.get("source_hash") != qr["source_hash"]:
                    o_q_upd += 1
                else:
                    o_q_unch += 1

            # Stale: existing rows not in current batch (only on full sync, no limit)
            if not limit:
                seen_pids = {qr["dentrix_patient_id"] for qr in queue_rows_to_upsert}
                for dpid, ex in existing_q.items():
                    if dpid not in seen_pids and ex.get("is_current"):
                        o_q_stale += 1

            # Procedure stats (simplified — count new vs existing, paginated)
            existing_p_map = {}
            _ep_rows = _sb_fetch_all(
                f"{_sb_url}/unscheduled_treatment_queue_procedures"
                f"?office_id=eq.{office_uuid}&select=dentrix_procedure_id,source_hash",
                headers={"apikey": _sb_key, "Authorization": f"Bearer {_sb_key}"},
                timeout=15,
            )
            for r in _ep_rows:
                existing_p_map[r["dentrix_procedure_id"]] = r.get("source_hash")

            for pr in proc_rows_to_upsert:
                dpid = pr["dentrix_procedure_id"]
                ex_hash = existing_p_map.get(dpid)
                if ex_hash is None:
                    o_p_ins += 1
                elif ex_hash != pr["source_hash"]:
                    o_p_upd += 1
                else:
                    o_p_unch += 1

            if not limit:
                seen_proc_ids = {pr["dentrix_procedure_id"] for pr in proc_rows_to_upsert}
                for dpid in existing_p_map:
                    if dpid not in seen_proc_ids:
                        o_p_stale += 1

            if not sample_queue_row and queue_rows_to_upsert:
                sample_queue_row = queue_rows_to_upsert[0]
            if not sample_proc_row and proc_rows_to_upsert:
                sample_proc_row = proc_rows_to_upsert[0]

        # ── 4g  WRITE MODE ────────────────────────────────────────────────
        else:
            import requests as _rq

            # 4g-i  Fetch existing queue rows for this office (paginated)
            existing_q = {}
            _eq_rows = _sb_fetch_all(
                f"{_sb_url}/unscheduled_treatment_queue"
                f"?office_id=eq.{office_uuid}&select=id,dentrix_patient_id,source_hash,queue_status,is_current",
                headers={"apikey": _sb_key, "Authorization": f"Bearer {_sb_key}"},
                timeout=15,
            )
            for r in _eq_rows:
                existing_q[r["dentrix_patient_id"]] = r

            # 4g-ii  Fetch existing procedure rows (paginated)
            existing_p_map = {}
            _ep_rows = _sb_fetch_all(
                f"{_sb_url}/unscheduled_treatment_queue_procedures"
                f"?office_id=eq.{office_uuid}&select=id,dentrix_procedure_id,source_hash,queue_id",
                headers={"apikey": _sb_key, "Authorization": f"Bearer {_sb_key}"},
                timeout=15,
            )
            for r in _ep_rows:
                existing_p_map[r["dentrix_procedure_id"]] = r

            # 4g-iii  Upsert queue rows (one at a time for audit precision)
            audit_rows = []
            queue_id_map = {}  # dentrix_patient_id -> supabase queue id

            for qr in queue_rows_to_upsert:
                dpid = qr["dentrix_patient_id"]
                ex = existing_q.get(dpid)

                if ex:
                    queue_id = ex["id"]
                    queue_id_map[dpid] = queue_id

                    if ex.get("source_hash") == qr["source_hash"]:
                        # Unchanged — just touch last_synced_at + source_last_seen_at
                        _rq.patch(
                            f"{_sb_url}/unscheduled_treatment_queue?id=eq.{queue_id}",
                            headers=_sb_headers("return=minimal"),
                            json={
                                "last_synced_at": generated_at,
                                "source_last_seen_at": generated_at,
                                "is_current": True,
                            },
                            timeout=10,
                        )
                        o_q_unch += 1
                        queue_ids_seen.add(queue_id)
                        continue

                    # Changed — update snapshot fields, preserve workflow fields
                    patch_data = {
                        "patient_name": qr["patient_name"],
                        "total_value": qr["total_value"],
                        "procedure_count": qr["procedure_count"],
                        "highest_value_procedure": qr["highest_value_procedure"],
                        "primary_category": qr["primary_category"],
                        "provider_name": qr["provider_name"],
                        "latest_treatment_plan_date": qr["latest_treatment_plan_date"],
                        "has_future_appointment": qr["has_future_appointment"],
                        "bill_to_insurance": qr["bill_to_insurance"],
                        "referred_out": qr["referred_out"],
                        "source_hash": qr["source_hash"],
                        "source_last_seen_at": generated_at,
                        "is_current": True,
                        "last_synced_at": generated_at,
                    }
                    resp = _rq.patch(
                        f"{_sb_url}/unscheduled_treatment_queue?id=eq.{queue_id}",
                        headers=_sb_headers("return=minimal"),
                        json=patch_data,
                        timeout=10,
                    )
                    if resp.status_code in (200, 204):
                        o_q_upd += 1
                        audit_rows.append({
                            "entity_type": "queue_item",
                            "entity_id": queue_id,
                            "office_id": office_uuid,
                            "action": "synced",
                            "old_values": {"source_hash": ex.get("source_hash")},
                            "new_values": {"source_hash": qr["source_hash"]},
                            "metadata": {"sync_type": "snapshot_update"},
                        })
                    else:
                        all_warnings.append(f"Failed to update queue {dpid}: {resp.status_code}")
                    queue_ids_seen.add(queue_id)

                else:
                    # New — insert with POST (merge-duplicates on unique constraint)
                    resp = _rq.post(
                        f"{_sb_url}/unscheduled_treatment_queue"
                        f"?on_conflict=office_id,dentrix_patient_id",
                        headers={
                            "apikey": _sb_key,
                            "Authorization": f"Bearer {_sb_key}",
                            "Content-Type": "application/json",
                            "Prefer": "resolution=merge-duplicates,return=representation",
                        },
                        json={
                            **qr,
                            "queue_status": "pending",
                            "priority": "normal",
                            "contact_attempt_count": 0,
                            "first_synced_at": generated_at,
                        },
                        timeout=10,
                    )
                    if resp.status_code in (200, 201):
                        inserted = resp.json()
                        if isinstance(inserted, list) and inserted:
                            queue_id = inserted[0]["id"]
                        elif isinstance(inserted, dict):
                            queue_id = inserted["id"]
                        else:
                            queue_id = None
                        queue_id_map[dpid] = queue_id
                        o_q_ins += 1
                        if queue_id:
                            queue_ids_seen.add(queue_id)
                            audit_rows.append({
                                "entity_type": "queue_item",
                                "entity_id": queue_id,
                                "office_id": office_uuid,
                                "action": "synced",
                                "new_values": {
                                    "queue_status": "pending",
                                    "total_value": qr["total_value"],
                                    "procedure_count": qr["procedure_count"],
                                },
                                "metadata": {"sync_type": "new_item"},
                            })
                        if not sample_queue_row:
                            sample_queue_row = inserted[0] if isinstance(inserted, list) else inserted
                    else:
                        all_warnings.append(f"Failed to insert queue {dpid}: {resp.status_code} {resp.text[:100]}")

            # 4g-iv  Upsert procedure rows in batches
            # First, resolve queue_id for each procedure via patient_id
            for pr in proc_rows_to_upsert:
                dpid = pr["dentrix_patient_id"]
                q_id = queue_id_map.get(dpid)
                if not q_id:
                    # Try to find from existing
                    ex = existing_q.get(dpid)
                    q_id = ex["id"] if ex else None
                if q_id:
                    pr["queue_id"] = q_id
                else:
                    all_warnings.append(f"No queue_id for procedure {pr['dentrix_procedure_id']} (patient {dpid})")

            # Filter out procs without queue_id
            valid_procs = [pr for pr in proc_rows_to_upsert if pr.get("queue_id")]

            # Batch upsert procedures (50 at a time)
            _PROC_BATCH = 50
            for i in range(0, len(valid_procs), _PROC_BATCH):
                batch = valid_procs[i:i + _PROC_BATCH]
                # Count inserts vs updates
                for pr in batch:
                    ex = existing_p_map.get(pr["dentrix_procedure_id"])
                    if not ex:
                        o_p_ins += 1
                    elif ex.get("source_hash") != pr["source_hash"]:
                        o_p_upd += 1
                    else:
                        o_p_unch += 1

                resp = _rq.post(
                    f"{_sb_url}/unscheduled_treatment_queue_procedures?on_conflict=dentrix_procedure_id",
                    headers=_sb_headers("return=minimal"),
                    json=batch,
                    timeout=30,
                )
                if resp.status_code not in (200, 201, 204):
                    all_warnings.append(f"Proc batch {i}-{i+len(batch)}: {resp.status_code} {resp.text[:100]}")
                elif not sample_proc_row and batch:
                    sample_proc_row = batch[0]

            if not sample_proc_row and valid_procs:
                sample_proc_row = valid_procs[0]

            # 4g-v  Stale cleanup (only on full sync without limit)
            if not limit:
                for dpid, ex in existing_q.items():
                    ex_id = ex["id"]
                    if ex_id not in queue_ids_seen and ex.get("is_current"):
                        resp = _rq.patch(
                            f"{_sb_url}/unscheduled_treatment_queue?id=eq.{ex_id}",
                            headers=_sb_headers("return=minimal"),
                            json={
                                "is_current": False,
                                "last_synced_at": generated_at,
                            },
                            timeout=10,
                        )
                        if resp.status_code in (200, 204):
                            o_q_stale += 1
                            audit_rows.append({
                                "entity_type": "queue_item",
                                "entity_id": ex_id,
                                "office_id": office_uuid,
                                "action": "synced",
                                "old_values": {"is_current": True},
                                "new_values": {"is_current": False},
                                "metadata": {"sync_type": "stale_mark", "reason": "not_in_source_scope"},
                            })

                # Stale procedures: mark procedures whose queue is stale
                seen_proc_ids = {pr["dentrix_procedure_id"] for pr in proc_rows_to_upsert}
                for dprocid, ex_p in existing_p_map.items():
                    if dprocid not in seen_proc_ids:
                        resp = _rq.patch(
                            f"{_sb_url}/unscheduled_treatment_queue_procedures?dentrix_procedure_id=eq.{dprocid}",
                            headers=_sb_headers("return=minimal"),
                            json={"is_current": False},
                            timeout=10,
                        )
                        if resp.status_code in (200, 204):
                            o_p_stale += 1

            # 4g-vi  Write audit rows
            if audit_rows:
                for ab in range(0, len(audit_rows), 50):
                    batch = audit_rows[ab:ab + 50]
                    _rq.post(
                        f"{_sb_url}/unscheduled_treatment_audit_log",
                        headers={
                            "apikey": _sb_key,
                            "Authorization": f"Bearer {_sb_key}",
                            "Content-Type": "application/json",
                            "Prefer": "return=minimal",
                        },
                        json=batch,
                        timeout=15,
                    )
                o_audit = len(audit_rows)

        # ── 4h  Office summary ────────────────────────────────────────────
        office_results.append({
            "office_id": office_uuid,
            "office_name": office_name,
            "dentrix_location_id": loc_id,
            "source_patients": len(patient_ids),
            "source_procedures": len([p for pid in patient_ids for p in patient_groups[pid]["procedures"]]),
            "queue": {
                "inserted": o_q_ins,
                "updated": o_q_upd,
                "unchanged": o_q_unch,
                "stale_marked": o_q_stale,
            },
            "procedures": {
                "inserted": o_p_ins,
                "updated": o_p_upd,
                "unchanged": o_p_unch,
                "stale_marked": o_p_stale,
            },
            "audit_rows": o_audit,
        })

        total_q_inserted += o_q_ins
        total_q_updated += o_q_upd
        total_q_unchanged += o_q_unch
        total_q_stale += o_q_stale
        total_p_inserted += o_p_ins
        total_p_updated += o_p_upd
        total_p_unchanged += o_p_unch
        total_p_stale += o_p_stale
        total_audit_rows += o_audit

    conn.close()

    return {
        "metadata": {
            "generated_at": generated_at,
            "dry_run": dry_run,
            "as_of_date": as_of_str,
            "lookback_days": lookbackDays,
            "lookback_start": lookback_start,
            "include_scheduled": includeScheduled,
            "include_referred_out": includeReferredOut,
            "limit": limit,
            "offices_synced": len(target_offices),
        },
        "totals": {
            "queue": {
                "inserted": total_q_inserted,
                "updated": total_q_updated,
                "unchanged": total_q_unchanged,
                "stale_marked": total_q_stale,
                "total_processed": total_q_inserted + total_q_updated + total_q_unchanged,
            },
            "procedures": {
                "inserted": total_p_inserted,
                "updated": total_p_updated,
                "unchanged": total_p_unchanged,
                "stale_marked": total_p_stale,
                "total_processed": total_p_inserted + total_p_updated + total_p_unchanged,
            },
            "audit_rows_created": total_audit_rows,
        },
        "by_office": office_results,
        "sample_queue_row": sample_queue_row,
        "sample_procedure_row": sample_proc_row,
        "warnings": all_warnings,
    }


# ============================================================================
# EOD Phase 2B — Treatment Plan Completion Scorecard (Read-Only)
# ============================================================================

@app.get("/v2/eod/treatment-plan-completion", tags=["EOD"])
def eod_treatment_plan_completion(
    officeId: Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
    allOffices: bool = Query(False),
    plannedStartDate: str = Query(..., description="YYYY-MM-DD"),
    plannedEndDate: str = Query(..., description="YYYY-MM-DD"),
    completionWindowDays: int = Query(90, ge=1, le=730),
    includeOpen: bool = Query(True),
    includeSameDay: bool = Query(False),
    providerId: Optional[str] = Query(None),
    providerRole: Optional[str] = Query("planning_provider", regex="^(planning_provider|completing_provider)$"),
    category: Optional[str] = Query(None),
    minValue: Optional[float] = Query(None),
):
    """
    Read-only Treatment Plan Completion scorecard.

    Answers: Of treatment planned in the selected date range, what percentage
    was completed within the completion window?

    Phase 2B: read-only — no workflow, no Supabase writes.
    """
    import datetime as _dt
    import sqlite3 as _sq3
    import json as _json
    from collections import OrderedDict
    import subprocess as _sp

    # ── 1  Resolve office(s) ──────────────────────────────────────────────
    if allOffices:
        target_locations = list(LOCATION_NAMES.keys())
        office_label = "All Offices"
        office_uuid = None
        single_loc = None
    else:
        single_loc = locationId
        if not single_loc and officeId:
            single_loc = OFFICE_TO_LOCATION.get(officeId)
        if not single_loc:
            raise HTTPException(status_code=400, detail="officeId, locationId, or allOffices=true is required")
        if single_loc not in LOCATION_NAMES:
            raise HTTPException(status_code=400, detail=f"Unknown location: {single_loc}")
        target_locations = [single_loc]
        office_label = f"NU Dental of {LOCATION_NAMES[single_loc]}"
        office_uuid = LOCATION_TO_OFFICE.get(single_loc)

    # ── 2  Parse dates ────────────────────────────────────────────────────
    try:
        p_start = _dt.date.fromisoformat(plannedStartDate)
    except ValueError:
        raise HTTPException(status_code=400, detail=f"Invalid plannedStartDate: {plannedStartDate}")
    try:
        p_end = _dt.date.fromisoformat(plannedEndDate)
    except ValueError:
        raise HTTPException(status_code=400, detail=f"Invalid plannedEndDate: {plannedEndDate}")
    if p_end < p_start:
        raise HTTPException(status_code=400, detail="plannedEndDate must be >= plannedStartDate")

    cutoff = p_end + _dt.timedelta(days=completionWindowDays)
    cutoff_str = cutoff.isoformat()
    today = _dt.date.today()
    is_mature = today >= cutoff
    days_since_end = (today - p_end).days

    # ── 3  Connect ────────────────────────────────────────────────────────
    conn = _sq3.connect(str(RCM_DB_PATH), timeout=15)
    conn.row_factory = _sq3.Row
    generated_at = _dt.datetime.now(_dt.timezone.utc).isoformat()
    warnings: list[str] = []

    if not is_mature:
        warnings.append(
            f"This cohort is not mature yet. Completion rates may be artificially low "
            f"until the completion window has elapsed ({cutoff_str}). "
            f"Only {days_since_end} of {completionWindowDays} days have passed since planned_end_date."
        )

    # ── 4  Source freshness ───────────────────────────────────────────────
    pp_sync = conn.execute(
        "SELECT last_synced_at FROM sync_state WHERE table_name = 'patient_procedures'"
    ).fetchone()
    pp_sync_ts = float(pp_sync["last_synced_at"]) if pp_sync else None
    if pp_sync_ts:
        age_h = (_dt.datetime.now(_dt.timezone.utc).timestamp() - pp_sync_ts) / 3600
        if age_h > 26:
            warnings.append(f"Treatment plan data is {age_h:.0f}h old — nightly sync may have failed")

    # ── 5  Identify patients with future appointments (for open TP split) ─
    as_of_str = today.isoformat()
    placeholders = ",".join("?" for _ in _UT_SCHEDULED_STATUSES)
    scheduled_patients_by_loc: dict[str, set] = {}
    for loc in target_locations:
        pset: set[str] = set()
        for r in conn.execute(f"""
            SELECT DISTINCT patient_id FROM appointments
            WHERE location_id = ? AND start_time >= ?
              AND status IN ({placeholders})
        """, (loc, as_of_str, *_UT_SCHEDULED_STATUSES)).fetchall():
            pset.add(r["patient_id"])
        scheduled_patients_by_loc[loc] = pset

    # ── 6  Pull all qualifying rows ───────────────────────────────────────
    loc_placeholders = ",".join("?" for _ in target_locations)
    sql = f"""
        SELECT
            pp.id              AS proc_id,
            pp.status,
            pp.amount,
            pp.entry_date,
            pp.service_date,
            pp.location_id,
            pp.provider_id,
            pp.patient_id,
            pp.practice_procedure_id,
            pp.raw,
            pr.ada_code,
            pr.description     AS proc_desc,
            pr.normalized_service_category AS proc_cat,
            prov.first_name    AS prov_first,
            prov.last_name     AS prov_last
        FROM patient_procedures pp
        LEFT JOIN practice_procedures pr ON pp.practice_procedure_id = pr.id
        LEFT JOIN providers prov ON pp.provider_id = prov.id
        WHERE pp.state = 'ACTIVE'
          AND pp.status IN ('TREATMENT_PLAN', 'COMPLETED')
          AND pp.entry_date >= ? AND pp.entry_date <= ?
          AND pp.location_id IN ({loc_placeholders})
    """
    params: list = [plannedStartDate, plannedEndDate, *target_locations]

    if minValue is not None:
        sql += " AND pp.amount >= ?"
        params.append(minValue)

    if category:
        sql += " AND pr.normalized_service_category = ?"
        params.append(category)

    sql += " ORDER BY pp.location_id, pp.entry_date, pp.id"
    all_rows = conn.execute(sql, params).fetchall()

    # ── 7  Classify each row ─────────────────────────────────────────────
    # Accumulators
    _open: list[dict] = []           # active TP rows
    _completed_tp: list[dict] = []   # completed from treatment plan
    _same_day: list[dict] = []       # same-day plan+complete
    _direct: list[dict] = []         # completed without TP
    _all_completed_in_period = 0     # total completed rows in entry_date range

    def _prov_name(first, last):
        if first or last:
            return " ".join(filter(None, [first, last])).strip()
        return None

    for row in all_rows:
        raw: dict = {}
        if row["raw"]:
            try:
                raw = _json.loads(row["raw"])
            except Exception:
                pass

        referred = raw.get("referredOut", False) is True
        if referred:
            continue

        amt = round(float(row["amount"]), 2) if row["amount"] is not None else None
        completing_prov_id = row["provider_id"]
        completing_prov_name = _prov_name(row["prov_first"], row["prov_last"])

        rec = {
            "proc_id": row["proc_id"],
            "patient_id": row["patient_id"],
            "location_id": row["location_id"],
            "amount": amt,
            "entry_date": row["entry_date"],
            "service_date": row["service_date"],
            "ada_code": row["ada_code"],
            "proc_desc": row["proc_desc"],
            "proc_cat": row["proc_cat"] or "Unknown / Unmapped",
            "completing_provider_id": completing_prov_id,
            "completing_provider_name": completing_prov_name,
        }

        if row["status"] == "TREATMENT_PLAN":
            # Planning provider = provider_id on the TP row
            rec["planning_provider_id"] = completing_prov_id
            rec["planning_provider_name"] = completing_prov_name
            _open.append(rec)
            continue

        # COMPLETED
        _all_completed_in_period += 1
        tp_date = raw.get("treatmentPlannedDate")
        tp_prov = raw.get("treatmentPlannedProvider", {})
        tp_prov_id = tp_prov.get("id") if isinstance(tp_prov, dict) else None

        if not tp_date:
            _direct.append(rec)
            continue

        # Resolve planning provider name
        planning_prov_name = completing_prov_name  # default if same
        if tp_prov_id and tp_prov_id != completing_prov_id:
            pn_row = conn.execute(
                "SELECT first_name, last_name FROM providers WHERE id = ?", (tp_prov_id,)
            ).fetchone()
            if pn_row:
                planning_prov_name = _prov_name(pn_row["first_name"], pn_row["last_name"])

        rec["planning_provider_id"] = tp_prov_id or completing_prov_id
        rec["planning_provider_name"] = planning_prov_name

        if tp_date == row["entry_date"]:
            _same_day.append(rec)
            continue

        # Completed from treatment plan — check service_date within window
        if row["service_date"] and row["service_date"] <= cutoff_str:
            # Provider filter
            if providerId:
                if providerRole == "planning_provider" and rec["planning_provider_id"] != providerId:
                    continue
                if providerRole == "completing_provider" and completing_prov_id != providerId:
                    continue
            _completed_tp.append(rec)
        else:
            # service_date beyond window or null — treat as open
            rec["planning_provider_id"] = tp_prov_id or completing_prov_id
            rec["planning_provider_name"] = planning_prov_name
            # These are completed but outside window — don't count in either bucket
            pass

    # Apply provider filter to open TPs as well
    if providerId and providerRole == "planning_provider":
        _open = [r for r in _open if r["planning_provider_id"] == providerId]

    # Include same-day in main rate if requested
    if includeSameDay:
        _completed_tp.extend(_same_day)

    # ── 8  Build summary ─────────────────────────────────────────────────
    planned_all = _open + _completed_tp
    planned_count = len(planned_all)
    planned_value = round(sum((r["amount"] or 0) for r in planned_all), 2)
    completed_count = len(_completed_tp)
    completed_value = round(sum((r["amount"] or 0) for r in _completed_tp), 2)
    open_count = len(_open)
    open_value = round(sum((r["amount"] or 0) for r in _open), 2)

    comp_rate_count = round(completed_count / planned_count, 4) if planned_count else 0
    comp_rate_value = round(completed_value / planned_value, 4) if planned_value else 0

    # Patient-level
    planned_patients = set(r["patient_id"] for r in planned_all)
    completed_patients = set(r["patient_id"] for r in _completed_tp)
    open_patients = set(r["patient_id"] for r in _open)
    fully_completed = completed_patients - open_patients
    partially_completed = completed_patients & open_patients
    patient_comp_rate = round(len(completed_patients) / len(planned_patients), 4) if planned_patients else 0

    # Unscheduled vs scheduled-not-completed
    unsched_val = 0.0
    sched_not_comp_val = 0.0
    for r in _open:
        loc = r["location_id"]
        pid = r["patient_id"]
        a = r["amount"] or 0
        if pid in scheduled_patients_by_loc.get(loc, set()):
            sched_not_comp_val += a
        else:
            unsched_val += a
    unsched_val = round(unsched_val, 2)
    sched_not_comp_val = round(sched_not_comp_val, 2)

    # Days to completion
    days_list: list[float] = []
    for r in _completed_tp:
        if r["entry_date"] and r["service_date"]:
            try:
                ed = _dt.date.fromisoformat(r["entry_date"])
                sd = _dt.date.fromisoformat(r["service_date"])
                days_list.append((sd - ed).days)
            except Exception:
                pass
    avg_days = round(sum(days_list) / len(days_list), 1) if days_list else None
    median_days = None
    if days_list:
        s = sorted(days_list)
        mid = len(s) // 2
        median_days = round(s[mid] if len(s) % 2 else (s[mid - 1] + s[mid]) / 2, 1)

    # Provider handoff
    handoff = [r for r in _completed_tp if r["planning_provider_id"] != r["completing_provider_id"]]
    handoff_count = len(handoff)
    handoff_value = round(sum((r["amount"] or 0) for r in handoff), 2)
    same_prov_rate = round(1 - (handoff_count / completed_count), 4) if completed_count else None

    # Same-day stats (always computed, only included in main rate if includeSameDay)
    sd_count = len(_same_day) if not includeSameDay else 0
    sd_value = round(sum((r["amount"] or 0) for r in _same_day), 2) if not includeSameDay else 0

    # Coverage
    direct_count = len(_direct)
    coverage_total = _all_completed_in_period
    coverage_tp = len(_completed_tp) + (len(_same_day) if not includeSameDay else 0)
    coverage_share = round(coverage_tp / coverage_total, 4) if coverage_total else 0

    # ── 9  by_office ──────────────────────────────────────────────────────
    def _office_stats(loc_id, o_rows, c_rows):
        o_count = len(o_rows)
        c_count = len(c_rows)
        total = o_count + c_count
        o_val = round(sum((r["amount"] or 0) for r in o_rows), 2)
        c_val = round(sum((r["amount"] or 0) for r in c_rows), 2)
        t_val = round(o_val + c_val, 2)

        u_val = 0.0
        s_val = 0.0
        sp = scheduled_patients_by_loc.get(loc_id, set())
        for r in o_rows:
            a = r["amount"] or 0
            if r["patient_id"] in sp:
                s_val += a
            else:
                u_val += a

        dl = []
        for r in c_rows:
            if r["entry_date"] and r["service_date"]:
                try:
                    dl.append((_dt.date.fromisoformat(r["service_date"]) - _dt.date.fromisoformat(r["entry_date"])).days)
                except Exception:
                    pass
        a_d = round(sum(dl) / len(dl), 1) if dl else None
        m_d = None
        if dl:
            ss = sorted(dl)
            mid = len(ss) // 2
            m_d = round(ss[mid] if len(ss) % 2 else (ss[mid - 1] + ss[mid]) / 2, 1)

        return {
            "office_id": LOCATION_TO_OFFICE.get(loc_id),
            "office_name": f"NU Dental of {LOCATION_NAMES.get(loc_id, loc_id)}",
            "dentrix_location_id": loc_id,
            "planned_count": total,
            "planned_value": t_val,
            "completed_count": c_count,
            "completed_value": c_val,
            "completion_rate_by_count": round(c_count / total, 4) if total else 0,
            "completion_rate_by_value": round(c_val / t_val, 4) if t_val else 0,
            "open_count": o_count,
            "open_value": o_val,
            "unscheduled_value": round(u_val, 2),
            "scheduled_not_completed_value": round(s_val, 2),
            "avg_days_to_completion": a_d,
            "median_days_to_completion": m_d,
        }

    by_office = []
    for loc in target_locations:
        loc_open = [r for r in _open if r["location_id"] == loc]
        loc_comp = [r for r in _completed_tp if r["location_id"] == loc]
        if loc_open or loc_comp:
            by_office.append(_office_stats(loc, loc_open, loc_comp))
    by_office.sort(key=lambda x: x["planned_value"], reverse=True)

    # ── 10  by_planning_provider ──────────────────────────────────────────
    pp_groups: dict[str, dict] = {}
    for r in planned_all:
        pid = r["planning_provider_id"] or "unknown"
        if pid not in pp_groups:
            pp_groups[pid] = {"name": r["planning_provider_name"], "open": [], "comp": [], "loc": r.get("location_id")}
        if r in _open:
            pp_groups[pid]["open"].append(r)
        else:
            pp_groups[pid]["comp"].append(r)

    by_planning_provider = []
    for pid, g in pp_groups.items():
        o = g["open"]
        c = g["comp"]
        total = len(o) + len(c)
        o_val = round(sum((r["amount"] or 0) for r in o), 2)
        c_val = round(sum((r["amount"] or 0) for r in c), 2)
        t_val = round(o_val + c_val, 2)
        ho = [r for r in c if r["planning_provider_id"] != r["completing_provider_id"]]

        dl = []
        for r in c:
            if r["entry_date"] and r["service_date"]:
                try:
                    dl.append((_dt.date.fromisoformat(r["service_date"]) - _dt.date.fromisoformat(r["entry_date"])).days)
                except Exception:
                    pass
        a_d = round(sum(dl) / len(dl), 1) if dl else None
        m_d = None
        if dl:
            ss = sorted(dl)
            mid = len(ss) // 2
            m_d = round(ss[mid] if len(ss) % 2 else (ss[mid - 1] + ss[mid]) / 2, 1)

        rec = {
            "provider_name": g["name"],
            "dentrix_provider_id": pid,
            "planned_count": total,
            "planned_value": t_val,
            "completed_count": len(c),
            "completed_value": c_val,
            "completion_rate_by_count": round(len(c) / total, 4) if total else 0,
            "completion_rate_by_value": round(c_val / t_val, 4) if t_val else 0,
            "open_value": o_val,
            "avg_days_to_completion": a_d,
            "median_days_to_completion": m_d,
            "handoff_count": len(ho),
            "handoff_value": round(sum((r["amount"] or 0) for r in ho), 2),
        }
        if allOffices and g.get("loc"):
            rec["office_name"] = f"NU Dental of {LOCATION_NAMES.get(g['loc'], g['loc'])}"
        by_planning_provider.append(rec)
    by_planning_provider.sort(key=lambda x: x["planned_value"], reverse=True)

    # ── 11  by_completing_provider ────────────────────────────────────────
    cp_groups: dict[str, dict] = {}
    for r in _completed_tp:
        cid = r["completing_provider_id"] or "unknown"
        if cid not in cp_groups:
            cp_groups[cid] = {"name": r["completing_provider_name"], "own": [], "others": []}
        if r["planning_provider_id"] == r["completing_provider_id"]:
            cp_groups[cid]["own"].append(r)
        else:
            cp_groups[cid]["others"].append(r)

    by_completing_provider = []
    for cid, g in cp_groups.items():
        own_cnt = len(g["own"])
        own_val = round(sum((r["amount"] or 0) for r in g["own"]), 2)
        oth_cnt = len(g["others"])
        oth_val = round(sum((r["amount"] or 0) for r in g["others"]), 2)
        by_completing_provider.append({
            "provider_name": g["name"],
            "dentrix_provider_id": cid,
            "completed_from_own_plans_count": own_cnt,
            "completed_from_own_plans_value": own_val,
            "completed_from_others_plans_count": oth_cnt,
            "completed_from_others_plans_value": oth_val,
            "total_completed_count": own_cnt + oth_cnt,
            "total_completed_value": round(own_val + oth_val, 2),
        })
    by_completing_provider.sort(key=lambda x: x["total_completed_value"], reverse=True)

    # ── 12  by_category ───────────────────────────────────────────────────
    cat_groups: dict[str, dict] = {}
    for r in planned_all:
        cat = r["proc_cat"]
        if cat not in cat_groups:
            cat_groups[cat] = {"open": [], "comp": []}
        if r in _open:
            cat_groups[cat]["open"].append(r)
        else:
            cat_groups[cat]["comp"].append(r)

    by_category = []
    for cat, g in cat_groups.items():
        o = g["open"]
        c = g["comp"]
        total = len(o) + len(c)
        o_val = round(sum((r["amount"] or 0) for r in o), 2)
        c_val = round(sum((r["amount"] or 0) for r in c), 2)
        t_val = round(o_val + c_val, 2)

        dl = []
        for r in c:
            if r["entry_date"] and r["service_date"]:
                try:
                    dl.append((_dt.date.fromisoformat(r["service_date"]) - _dt.date.fromisoformat(r["entry_date"])).days)
                except Exception:
                    pass
        a_d = round(sum(dl) / len(dl), 1) if dl else None

        by_category.append({
            "category": cat,
            "planned_count": total,
            "planned_value": t_val,
            "completed_count": len(c),
            "completed_value": c_val,
            "completion_rate_by_count": round(len(c) / total, 4) if total else 0,
            "completion_rate_by_value": round(c_val / t_val, 4) if t_val else 0,
            "open_value": o_val,
            "avg_days_to_completion": a_d,
        })
    by_category.sort(key=lambda x: x["planned_value"], reverse=True)

    conn.close()

    # ── 13  Build response ────────────────────────────────────────────────
    return {
        "metadata": {
            "office_id": office_uuid,
            "office_name": office_label,
            "dentrix_location_id": single_loc,
            "all_offices": allOffices,
            "planned_start_date": plannedStartDate,
            "planned_end_date": plannedEndDate,
            "completion_window_days": completionWindowDays,
            "completion_cutoff_date": cutoff_str,
            "generated_at": generated_at,
            "data_source": "sqlite_patient_procedures",
            "endpoint_version": "phase_2b_read_only",
        },
        "definition": {
            "cohort_basis": "treatment plans entered (entry_date) in selected range",
            "planned_count_formula": (
                "active TREATMENT_PLAN + COMPLETED with treatmentPlannedDate != entry_date, "
                "where entry_date is in range"
            ),
            "completed_count_formula": (
                "COMPLETED with treatmentPlannedDate != entry_date, entry_date in range, "
                "service_date <= cutoff"
            ),
            "match_method": "dentrix_treatment_planned_date",
            "confidence": (
                "high — Dentrix preserves treatmentPlannedDate and treatmentPlannedProvider "
                "on completed rows"
            ),
            "excluded": (
                "COMPLETED with no treatmentPlannedDate (direct/walk-in), "
                + ("" if includeSameDay else "same-day plan+complete, ")
                + "REFERRED, EXISTING"
            ),
            "important_label": "Completion rate of formally treatment-planned procedures only.",
            "note": (
                "When a treatment plan is completed in Dentrix, the original TP row is "
                "deleted and a new COMPLETED row is created with the original entry_date "
                "and treatmentPlannedProvider preserved."
            ),
        },
        "maturity": {
            "is_mature": is_mature,
            "days_since_planned_end": days_since_end,
            "completion_window_days": completionWindowDays,
            "completion_cutoff_date": cutoff_str,
            "note": (
                "Cohort is mature — planned_end_date + completion_window has passed."
                if is_mature else
                f"Cohort is NOT mature — {cutoff_str} has not passed yet. "
                f"Completion rates may be artificially low."
            ),
        },
        "coverage": {
            "completed_procedures_total_in_period": coverage_total,
            "completed_from_treatment_plan_count": coverage_tp,
            "direct_completed_without_treatment_plan_count": direct_count,
            "same_day_plan_complete_count": len(_same_day) if not includeSameDay else 0,
            "formal_treatment_plan_completion_share": coverage_share,
            "note": "This scorecard only measures formally treatment-planned procedures.",
        },
        "summary": {
            "planned_procedure_count": planned_count,
            "planned_value": planned_value,
            "completed_procedure_count": completed_count,
            "completed_value": completed_value,
            "completion_rate_by_count": comp_rate_count,
            "completion_rate_by_value": comp_rate_value,
            "planned_patient_count": len(planned_patients),
            "patients_with_completed_treatment": len(completed_patients),
            "patients_fully_completed": len(fully_completed),
            "patients_partially_completed": len(partially_completed),
            "patient_completion_rate": patient_comp_rate,
            "open_procedure_count": open_count,
            "open_value": open_value,
            "unscheduled_value": unsched_val,
            "scheduled_not_completed_value": sched_not_comp_val,
            "same_day_plan_complete_count": sd_count,
            "same_day_plan_complete_value": sd_value,
            "average_days_to_completion": avg_days,
            "median_days_to_completion": median_days,
            "provider_handoff_count": handoff_count,
            "provider_handoff_value": handoff_value,
            "same_provider_completion_rate": same_prov_rate,
        },
        "by_office": by_office,
        "by_planning_provider": by_planning_provider,
        "by_completing_provider": by_completing_provider,
        "by_category": by_category,
        "warnings": warnings,
    }


