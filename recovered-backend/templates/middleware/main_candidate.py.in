# ---------------------------------------------------------------------------
# Goals (Supabase)
# ---------------------------------------------------------------------------

@app.get("/v2/goals", tags=["Goals"], dependencies=[Depends(verify_api_key)])
def list_goals(
    locationId: Optional[str] = Query(None),
    officeId: Optional[str] = Query(None),
    year: Optional[int] = Query(None),
    month: Optional[int] = Query(None),
):
    try:
        svc = get_service()
        loc_id = resolve_location_id(officeId, locationId)
        goals_list = svc.get_goals(loc_id, year, month)

        # Return both the raw list (for admin) AND a flat object for the frontend
        # Frontend reads: goalData.productionGoal, goalData.collectionsGoal
        # When no location filter: SUM all office goals (aggregate view)
        # When location filtered: use that office's goal
        flat = {"productionGoal": 0, "collectionsGoal": 0, "newPatientsGoal": 0}
        if goals_list and isinstance(goals_list, list):
            valid_goals = [g for g in goals_list if isinstance(g, dict) and "error" not in g]
            if loc_id:
                # Single office — take first matching goal
                if valid_goals:
                    g = valid_goals[0]
                    flat["productionGoal"] = g.get("production_goal") or g.get("productionGoal") or 0
                    flat["collectionsGoal"] = g.get("collections_goal") or g.get("collectionsGoal") or 0
                    flat["newPatientsGoal"] = g.get("new_patients_goal") or g.get("newPatientsGoal") or 0
            else:
                # All offices — sum all goals
                for g in valid_goals:
                    flat["productionGoal"] += g.get("production_goal") or g.get("productionGoal") or 0
                    flat["collectionsGoal"] += g.get("collections_goal") or g.get("collectionsGoal") or 0
                    flat["newPatientsGoal"] += g.get("new_patients_goal") or g.get("newPatientsGoal") or 0

        return {
            "goals": goals_list,
            # Flat keys at root for frontend direct access
            "productionGoal": flat["productionGoal"],
            "collectionsGoal": flat["collectionsGoal"],
            "newPatientsGoal": flat["newPatientsGoal"],
        }
    except Exception as e:
        logger.exception("Error fetching goals")
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/v2/goals", tags=["Goals"], dependencies=[Depends(verify_api_key)])
def create_goal(goal: dict = Body(...)):
    try:
        svc = get_service()
        result = svc.set_goal(goal)
        if isinstance(result, dict) and "error" in result:
            raise HTTPException(status_code=500, detail=result)
        return result
    except HTTPException:
        raise
    except Exception as e:
        logger.exception("Error creating goal")
        raise HTTPException(status_code=500, detail=str(e))


# ---------------------------------------------------------------------------
# Admin / Streaming status
# ---------------------------------------------------------------------------

@app.get("/v2/daily-entries", tags=["Reports"], dependencies=[Depends(verify_api_key)])
def get_daily_entries(
    startDate: Optional[str] = Query(None),
    endDate: Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
    officeId: Optional[str] = Query(None),
    status: Optional[str] = Query("approved"),   # Default: approved only
    limit: int = Query(200),
):
    """
    Read EOD daily entries from Supabase daily_entries table.
    Default filter: status='approved' to exclude rejected/pending entries.
    """
    import requests as _req

    try:
        with open("/home/openclaw/.config/supabase/nudental.json") as f:
            sb_config = json.load(f)

        sb_url = sb_config["project_url"]
        sb_key = sb_config["secret_key"]

        # Use a list of tuples so we can pass multiple filters on same column (entry_date range)
        # PostgREST requires: entry_date=gte.X&entry_date=lte.Y as separate params
        params: list = [
            ("select", "*"),
            ("order", "entry_date.desc"),
            ("limit", str(limit)),
        ]
        if startDate:
            params.append(("entry_date", f"gte.{startDate}"))
        if endDate:
            params.append(("entry_date", f"lte.{endDate}"))

        # daily_entries.office_id stores UUIDs — use officeId UUID directly if provided,
        # otherwise try reverse-mapping from Dentrix locationId to UUID
        LOCATION_ID_TO_UUID = {v: k for k, v in OFFICE_UUID_TO_LOCATION_ID.items()}
        office_uuid = None
        if officeId and "-" in str(officeId):
            # Already a UUID
            office_uuid = officeId
        elif locationId and locationId in LOCATION_ID_TO_UUID:
            office_uuid = LOCATION_ID_TO_UUID[locationId]
        elif officeId and officeId in LOCATION_ID_TO_UUID:
            office_uuid = LOCATION_ID_TO_UUID[officeId]
        if office_uuid:
            params.append(("office_id", f"eq.{office_uuid}"))

        # Critical: always filter by status (default: approved only)
        if status and status != "all":
            params.append(("status", f"eq.{status}"))

        headers = {
            "apikey": sb_key,
            "Authorization": f"Bearer {sb_key}",
            "Content-Type": "application/json",
        }
        resp = _req.get(f"{sb_url}/rest/v1/daily_entries", headers=headers, params=params, timeout=15)
        if resp.status_code != 200:
            raise HTTPException(status_code=resp.status_code, detail=resp.text[:300])

        entries = resp.json()

        # Compute totals (approved only by default)
        total_prod = sum(e.get("production") or 0 for e in entries)
        total_coll = sum(e.get("collection") or 0 for e in entries)
        total_np = sum(e.get("new_patients") or 0 for e in entries)

        loc_id = resolve_location_id(officeId, locationId)
        return {
            "entries": entries,
            "count": len(entries),
            "totals": {
                "production": round(total_prod, 2),
                "collections": round(total_coll, 2),
                "newPatients": total_np,
            },
            "filter": {
                "startDate": startDate,
                "endDate": endDate,
                "locationId": loc_id,
                "officeUuid": office_uuid,
                "status": status,
            },
            "note": "Totals include approved entries only by default. Pass ?status=all to include all statuses.",
        }
    except HTTPException:
        raise
    except Exception as e:
        logger.exception("Error fetching daily entries")
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/v2/reconciliation", tags=["Admin"], dependencies=[Depends(verify_api_key)])
def reconciliation_report(
    startDate: Optional[str] = Query(None),
    endDate: Optional[str] = Query(None),
):
    """
    Compare SQLite (Dentrix Ascend source) vs Supabase daily_entries totals.
    Surfaces the data divergence for investigation.
    """
    import requests as _req
    from datetime import date as _date
    import calendar as _cal

    today = _date.today()
    start = startDate or today.replace(day=1).isoformat()
    end = endDate or today.isoformat()

    svc = get_service()
    sqlite_prod = svc.get_production_summary(start, end)
    sqlite_coll = svc.get_collections_summary(start, end)

    # Supabase approved daily_entries
    try:
        with open("/home/openclaw/.config/supabase/nudental.json") as f:
            sb_config = json.load(f)
        sb_url = sb_config["project_url"]
        sb_key = sb_config["secret_key"]
        headers = {"apikey": sb_key, "Authorization": f"Bearer {sb_key}"}
        resp = _req.get(
            f"{sb_url}/rest/v1/daily_entries",
            headers=headers,
            params={"entry_date": f"gte.{start}", "status": "eq.approved", "select": "production,collection", "limit": "5000"},
            timeout=15,
        )
        # Also handle end date
        resp2 = _req.get(
            f"{sb_url}/rest/v1/daily_entries",
            headers=headers,
            params={"entry_date": f"gte.{start}", "status": "eq.approved",
                    "select": "production,collection,entry_date", "limit": "5000"},
            timeout=15,
        )
        if resp2.status_code == 200:
            sb_rows = [r for r in resp2.json() if r.get("entry_date", "") <= end]
            sb_prod = round(sum(r.get("production") or 0 for r in sb_rows), 2)
            sb_coll = round(sum(r.get("collection") or 0 for r in sb_rows), 2)
            sb_count = len(sb_rows)
        else:
            sb_prod, sb_coll, sb_count = 0, 0, 0
    except Exception as e:
        sb_prod, sb_coll, sb_count = 0, 0, f"error:{e}"

    prod_gap = round(sqlite_prod["grossProduction"] - (sb_prod if isinstance(sb_prod, float) else 0), 2)
    coll_gap = round(sqlite_coll["totalCollections"] - (sb_coll if isinstance(sb_coll, float) else 0), 2)

    return {
        "period": {"startDate": start, "endDate": end},
        "sqlite_dentrix": {
            "grossProduction": sqlite_prod["grossProduction"],
            "netProduction": sqlite_prod["netProduction"],
            "totalCollections": sqlite_coll["totalCollections"],
            "source": "Dentrix Ascend API → SQLite sync",
        },
        "supabase_daily_entries": {
            "production": sb_prod,
            "collections": sb_coll,
            "approvedEntries": sb_count,
            "source": "Manual EOD entries (approved only)",
        },
        "discrepancy": {
            "productionGap": prod_gap,
            "collectionsGap": coll_gap,
            "note": "Gap is expected: SQLite = all procedure-level Dentrix data; Supabase = manager-submitted daily totals. Source of truth is SQLite (Dentrix).",
        },
    }


