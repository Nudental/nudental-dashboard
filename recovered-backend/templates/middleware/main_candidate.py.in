# Compliance Status Endpoint (Issue 14 fix — Rev 2 2026-09-08)
# Returns not_configured status until real enforcement engine is built.
# Prevents the frontend from falsely displaying "Compliant" when no real
# checks are connected. Frontend should read overallStatus and display
# "Not Configured" when value is "not_configured".
# ---------------------------------------------------------------------------

@app.get("/v2/compliance", tags=["Compliance"], dependencies=[Depends(verify_api_key)])
@app.get("/v2/compliance/status", tags=["Compliance"], dependencies=[Depends(verify_api_key)])
def compliance_status():
    """
    Returns the current compliance configuration status.

    Issue 14 fix (Rev 2 — 2026-09-08):
    Previously this endpoint returned 404, causing the frontend to fall back
    to localStorage which defaults to the misleading string 'Compliant'.

    This stub returns overallStatus='not_configured' so the frontend can
    accurately display that compliance enforcement is not yet connected.
    No real compliance checks are connected until Dr. G approves the scope
    defined in Decision Center item DC-008.
    """
    import datetime as _dt
    return {
        "overallStatus": "not_configured",
        "statusMessage": "Compliance enforcement is not yet configured. No real checks are connected.",
        "checks": [],
        "configuredCheckCount": 0,
        "lastEvaluated": None,
        "asOfDate": _dt.date.today().isoformat(),
        "_note": "DC-008: Full compliance engine pending Dr. G authorization. See DASHBOARD_AUDIT_REVISION1_2026-09-08.md."
    }

