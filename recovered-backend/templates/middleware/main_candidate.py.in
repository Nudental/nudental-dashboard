@app.get("/v2/production/monthly", tags=["Production"], dependencies=[Depends(verify_api_key)])
def production_monthly(
    year: Optional[int] = Query(None, description="Year (defaults to current year)"),
    month: Optional[int] = Query(None, description="Month 1-12 (defaults to current month)"),
    locationId: Optional[str] = Query(None),
    officeId: Optional[str] = Query(None),
):
    """
    Returns precomputed production and collections for a single office + full calendar month.
    Reads from production_by_month SQLite table (PDF-authoritative for Jan-Apr 2026).
    Falls back to live calculation if no precomputed row exists.
    year and month default to current year/month when not provided (fixes Issue 7 — Monthly Trends loading).
    """
    import datetime as _dt
    _today = _dt.date.today()
    year = year or _today.year
    month = month or _today.month
    import sqlite3 as _sq3
    import calendar as _cal
    try:
        loc_id = resolve_location_id(officeId, locationId)
        last_day = _cal.monthrange(year, month)[1]
        start = f"{year}-{month:02d}-01"
        end = f"{year}-{month:02d}-{last_day:02d}"

        # Try precomputed first
        if loc_id:
            db_path = "/home/openclaw/.openclaw/workspace/ascend_api/middleware/ascend.db"
            conn = _sq3.connect(db_path)
            conn.row_factory = _sq3.Row
            row = conn.execute(
                "SELECT * FROM production_by_month WHERE location_id = ? AND year = ? AND month = ?",
                (loc_id, year, month)
            ).fetchone()
            conn.close()
            if row:
                return {
                    "locationId": loc_id,
                    "year": year,
                    "month": month,
                    "startDate": start,
                    "endDate": end,
                    "grossProduction": float(row["gross_production"] or 0),
                    "netProduction": float(row["net_production"] or 0),
                    "collections": float(row["collections"] or 0),
                    "source": f"precomputed:{row['source']}",
                }

        # Fallback: live calculation
        svc = get_service()
        prod = svc.get_production_summary(start, end, loc_id)
        coll = svc.get_collections_summary(start, end, loc_id)
        return {
            "locationId": loc_id,
            "year": year,
            "month": month,
            "startDate": start,
            "endDate": end,
            "grossProduction": prod.get("grossProduction", 0),
            "netProduction": prod.get("netProduction", 0),
            "collections": coll.get("totalCollections", 0),
            "source": "live_calculation",
        }
    except Exception as e:
        logger.exception("Error fetching monthly production")
        raise HTTPException(status_code=500, detail=str(e))


