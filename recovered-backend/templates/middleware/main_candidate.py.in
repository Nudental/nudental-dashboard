@app.get("/v2/providers/email", tags=["Providers"], dependencies=[Depends(verify_api_key)])
def provider_email_lookup(name: str = Query(..., description="Provider display name")):
    """Look up a provider's email by name. Read-only, no PHI, no UUIDs."""
    try:
        from payroll_report import get_provider_email
        email = get_provider_email(name)
        if email:
            return {
                "found": True,
                "email": email,
                "provider_email": email,
                "providerEmail": email,
                "source": "providers.email",
            }
        return {
            "found": False,
            "email": None,
            "provider_email": None,
            "providerEmail": None,
            "error": "no_email",
        }
    except Exception as e:
        logger.exception("Provider email lookup error")
        raise HTTPException(status_code=500, detail=str(e))


