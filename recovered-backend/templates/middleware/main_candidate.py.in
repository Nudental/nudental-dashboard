def _gpr_build_provider_map(conn):
    """provider_id → display name."""
    rows = conn.execute(
        "SELECT id, json_extract(raw, '$.firstName') as fn, json_extract(raw, '$.lastName') as ln FROM providers"
    ).fetchall()
    return {r["id"]: f"{r['fn'] or ''} {r['ln'] or ''}".strip() for r in rows}


def _gpr_build_procedure_desc_map(conn):
    """practice_procedure ada_code → description."""
    rows = conn.execute(
        "SELECT ada_code, description FROM practice_procedures WHERE ada_code IS NOT NULL"
    ).fetchall()
    return {r["ada_code"]: r["description"] for r in rows}


def _gpr_same_day_payments(conn, keys):
    """Lookup same-day patient payments by (patient_id, location_id, service_date).
    Returns {(pid, lid, svc_date): {total, dates, methods}}."""
    if not keys:
        return {}
    # Build a union of conditions — batch by unique keys
    # Use a temp approach: fetch all relevant patient_payments for the date range
    unique_dates = {k[2] for k in keys}
    unique_pids = {k[0] for k in keys}
    if not unique_dates or not unique_pids:
        return {}

    date_ph = ",".join("?" for _ in unique_dates)
    pid_ph = ",".join("?" for _ in unique_pids)
    rows = conn.execute(f"""
        SELECT pp.patient_id, pp.location_id, pp.transaction_date,
               ABS(pp.amount) as amt,
               pp.ledger_type,
               json_extract(pp.raw, '$.paidAtVisit') as paid_at_visit,
               json_extract(pp.raw, '$.patientPaymentBilling.creditCardType') as cc_type,
               json_extract(pp.raw, '$.patientPaymentBilling.cardHolderName') as card_holder
        FROM patient_payments pp
        WHERE pp.patient_id IN ({pid_ph})
          AND pp.transaction_date IN ({date_ph})
          AND pp.is_active = 1
          AND pp.ledger_type = 'PatientProcedurePayment'
    """, list(unique_pids) + list(unique_dates)).fetchall()

    agg = {}
    for r in rows:
        # Only include paidAtVisit = true (stored as 1/true in JSON)
        if not r["paid_at_visit"]:
            continue
        key = (r["patient_id"], r["location_id"], r["transaction_date"])
        if key not in agg:
            agg[key] = {"total": 0.0, "dates": set(), "methods": set()}
        agg[key]["total"] += r["amt"]
        if r["transaction_date"]:
            agg[key]["dates"].add(r["transaction_date"])
        # Derive safe payment method label
        if r["cc_type"] is not None:
            card_name = (r["card_holder"] or "").upper()
            if "VISA" in card_name:
                agg[key]["methods"].add("Credit Card (Visa)")
            elif "MASTER" in card_name:
                agg[key]["methods"].add("Credit Card (Mastercard)")
            elif "AMEX" in card_name or "AMERICAN" in card_name:
                agg[key]["methods"].add("Credit Card (Amex)")
            elif "DISCOVER" in card_name:
                agg[key]["methods"].add("Credit Card (Discover)")
            else:
                agg[key]["methods"].add("Credit Card")
        elif "CHECK" in (r["card_holder"] or "").upper():
            agg[key]["methods"].add("Check")
        elif "CARE" in (r["card_holder"] or "").upper():
            agg[key]["methods"].add("CareCredit")
        else:
            agg[key]["methods"].add("Other")
    return agg


def _gpr_payment_aggregates(conn, charge_ids):
    """Given a set of charge_ids, return {charge_id: {pat_paid, pat_dates, ins_paid, ins_dates, adj_writeoff}}."""
    if not charge_ids:
        return {}
    placeholders = ",".join("?" for _ in charge_ids)
    rows = conn.execute(f"""
        SELECT dl.charge_id, dl.source_table,
               ABS(dl.applied_amount) as amt, dl.transaction_date
        FROM distribution_lines dl
        WHERE dl.charge_id IN ({placeholders})
          AND dl.line_is_active = 1
    """, list(charge_ids)).fetchall()

    agg = {}
    for r in rows:
        cid = r["charge_id"]
        if cid not in agg:
            agg[cid] = {"pat_paid": 0.0, "pat_dates": set(), "ins_paid": 0.0, "ins_dates": set(), "adj_writeoff": 0.0}
        if r["source_table"] == "patient_payments":
            agg[cid]["pat_paid"] += r["amt"]
            if r["transaction_date"]:
                agg[cid]["pat_dates"].add(r["transaction_date"])
        elif r["source_table"] == "insurance_payments":
            agg[cid]["ins_paid"] += r["amt"]
            if r["transaction_date"]:
                agg[cid]["ins_dates"].add(r["transaction_date"])
        elif r["source_table"] == "adjustments":
            agg[cid]["adj_writeoff"] += r["amt"]
    return agg


def _gpr_compute_tags(row, days_since_service, remaining_due, actual_pat_paid, earliest_pat_date):
    """Compute reconciliation tags for a single row."""
    tags = []
    cs = (row["claim_state"] or "").upper()
    cpp = row["current_patient_portion"]
    opp = row["original_patient_portion"]
    svc = row["service_date"]

    # Predetermination: portion fields are NULL
    if cpp is None and opp is None:
        tags.append("PREDETERMINATION")
        return tags  # nothing else meaningful

    # Claim state tag
    state_map = {
        "UNSENT": "CLAIM_UNSENT", "SENT": "CLAIM_SENT", "ACCEPTED": "CLAIM_ACCEPTED",
        "PAYRECVD": "CLAIM_PAYRECVD", "SETTLED": "CLAIM_SETTLED",
        "PRINTED": "CLAIM_UNSENT", "QUEUED": "CLAIM_SENT",
        "ATTACHMENTHOLD": "CLAIM_SENT", "DENIED": "CLAIM_SETTLED",
        "DELETED": "CLAIM_DELETED", "VOIDED": "CLAIM_VOIDED",
        "CANCELLED": "CLAIM_CANCELLED",
    }
    if cs in state_map:
        tags.append(state_map[cs])

    # Source completeness tags
    if not row["procedure_code"]:
        tags.append("MISSING_PROCEDURE_CODE")
    if not row["charge_id"]:
        tags.append("MISSING_CHARGE_LINK")
    if cs in ("DELETED", "VOIDED", "CANCELLED") or (not row["procedure_code"] and not row["charge_id"]):
        tags.append("SOURCE_INCOMPLETE")

    # Estimate vs post-EOB
    if cs in _GPR_PRE_EOB_STATES:
        tags.append("PRE_EOB_ESTIMATE")
    elif cs in _GPR_POST_EOB_STATES:
        tags.append("POST_EOB")
    if cs in ("SENT", "ACCEPTED"):
        tags.append("INSURANCE_PENDING")

    # Collection status
    if cpp is not None and cpp <= 0:
        tags.append("NO_PATIENT_PORTION_DUE")
    elif cpp is not None and cpp > 0:
        if actual_pat_paid >= cpp:
            # Collected — determine timing
            if earliest_pat_date and earliest_pat_date == svc:
                tags.append("COLLECTED_SAME_DAY")
            elif earliest_pat_date and svc:
                try:
                    from datetime import datetime as _dt
                    d_svc = _dt.strptime(svc, "%Y-%m-%d")
                    d_pay = _dt.strptime(earliest_pat_date, "%Y-%m-%d")
                    if (d_pay - d_svc).days <= 5:
                        tags.append("COLLECTED_WITHIN_5_DAYS")
                    else:
                        tags.append("COLLECTED_AFTER_5_DAYS")
                except Exception:
                    tags.append("COLLECTED_AFTER_5_DAYS")
            else:
                tags.append("COLLECTED_AFTER_5_DAYS")
        elif actual_pat_paid > 0:
            tags.append("PARTIALLY_COLLECTED")
        else:
            # Nothing collected
            if days_since_service is not None and days_since_service <= 5:
                tags.append("WITHIN_COLLECTION_WINDOW")
            elif days_since_service is not None and days_since_service > 5:
                tags.append("OVER_5_DAYS_DUE")
                tags.append("PATIENT_PORTION_DUE")

    return tags


def _gpr_reconciliation_status(cpp, remaining_due, days_since_service):
    """Single reconciliation status value."""
    if cpp is None:
        return "PREDETERMINATION"
    if cpp <= 0:
        return "NO_BALANCE"
    if remaining_due <= 0:
        return "COLLECTED"
    if days_since_service is not None and days_since_service <= 5:
        return "PENDING"
    return "DUE"


@app.get("/v2/rcm/guarantor-reconciliation", tags=["RCM"], dependencies=[Depends(verify_api_key)])
def rcm_guarantor_reconciliation(
    startDate: Optional[str] = Query(None, alias="start_date"),
    endDate: Optional[str] = Query(None, alias="end_date"),
    startDateAlt: Optional[str] = Query(None, alias="startDate"),
    endDateAlt: Optional[str] = Query(None, alias="endDate"),
    locationId: Optional[str] = Query(None, alias="location_id"),
    locationIdAlt: Optional[str] = Query(None, alias="locationId"),
    officeId: Optional[str] = Query(None, alias="officeId"),
    min_days_outstanding: int = Query(5),
    only_balance_due: bool = Query(False),
    exclude_zero_portion: bool = Query(True),
    include_predeterminations: bool = Query(False),
    page: int = Query(1, ge=1),
    page_size: int = Query(100, ge=1, le=500),
):
    """
    RCM Guarantor / Patient Portion Reconciliation.
    Returns procedure-level patient portion data with actual payments from distribution_lines.

    Default view: actionable rows only (patient portion > 0, no predeterminations).
    Audit view: set exclude_zero_portion=false to see all rows.
    """
    s = startDate or startDateAlt or "2026-04-01"
    e = endDate or endDateAlt or "2026-04-30"
    loc = locationId or locationIdAlt
    if not loc and officeId:
        loc = OFFICE_UUID_TO_LOCATION_ID.get(officeId)

    conn = rcm_db()
    try:
        providers = _gpr_build_provider_map(conn)
        proc_descs = _gpr_build_procedure_desc_map(conn)
        # Build patient name map from patients table (id → "First Last")
        _pat_rows = conn.execute("SELECT id, first_name, last_name FROM patients").fetchall()
        _patient_names = {
            r["id"]: " ".join(filter(None, [r["first_name"], r["last_name"]])) or None
            for r in _pat_rows
        }
        today = datetime.now().strftime("%Y-%m-%d")

        # --- Build WHERE clause ---
        where_parts = ["cpp.service_date >= ?", "cpp.service_date <= ?"]
        params = [s, e]
        if min_days_outstanding > 0:
            where_parts.append("cpp.service_date <= date(?, ?)")
            params.extend([today, f"-{min_days_outstanding} days"])
        if loc:
            where_parts.append("cpp.location_id = ?")
            params.append(loc)
        if exclude_zero_portion:
            if include_predeterminations:
                # Exclude zero/negative but keep NULLs (predeterminations)
                where_parts.append("(cpp.current_patient_portion IS NULL OR cpp.current_patient_portion > 0)")
            else:
                # Exclude zero/negative AND NULLs (predeterminations) — default worklist
                where_parts.append("cpp.current_patient_portion > 0")
            # Default worklist: exclude deleted/voided/cancelled claims and fully-incomplete rows
            where_parts.append("COALESCE(cpp.claim_state, '') NOT IN ('DELETED', 'VOIDED', 'CANCELLED')")
            where_parts.append("NOT (cpp.procedure_code IS NULL AND cpp.charge_id IS NULL)")

        where_sql = " AND ".join(where_parts)

        # ====================================================================
        # FULL-SET PASS: compute scorecard + accurate total_count over ALL
        # filtered rows (no LIMIT/OFFSET). This ensures scorecard and meta.total
        # are independent of page/page_size.
        # ====================================================================
        all_rows = conn.execute(f"""
            SELECT cpp.*
            FROM claim_procedure_portions cpp
            WHERE {where_sql}
            ORDER BY cpp.service_date DESC, cpp.claim_id, cpp.patient_procedure_id
        """, params).fetchall()

        # Gather charge_ids + same-day keys for the FULL set
        all_charge_ids = {r["charge_id"] for r in all_rows if r["charge_id"]}
        all_pay_agg = _gpr_payment_aggregates(conn, all_charge_ids)
        all_sdp_keys = {(r["patient_id"], r["location_id"], r["service_date"]) for r in all_rows
                        if r["patient_id"] and r["location_id"] and r["service_date"]}
        all_sdp_agg = _gpr_same_day_payments(conn, all_sdp_keys)

        # Scorecard accumulators (full-set)
        sc_total_cpp = 0.0
        sc_total_pat_paid = 0.0
        sc_total_remaining = 0.0
        sc_due_count = 0
        sc_same_day = 0
        sc_within_5 = 0
        sc_over_5 = 0
        sc_predet = 0
        sc_sdp_total = 0.0
        sc_likely_collected = 0
        sc_alloc_review = 0
        sc_by_office = {}
        total_count = 0

        for r in all_rows:
            lid = r["location_id"]
            office = _GPR_LOCATION_TO_NAME.get(lid, lid or "Unknown")
            oid = _GPR_LOCATION_TO_OFFICE_ID.get(lid)

            cid_charge = r["charge_id"]
            pay = all_pay_agg.get(cid_charge, {"pat_paid": 0.0, "pat_dates": set(), "ins_paid": 0.0, "ins_dates": set(), "adj_writeoff": 0.0})
            actual_pat = round(pay["pat_paid"], 2)
            actual_ins = round(pay["ins_paid"], 2)
            pat_dates = sorted(pay["pat_dates"])
            earliest_pat = pat_dates[0] if pat_dates else None

            cpp_val = r["current_patient_portion"]
            opp_val = r["original_patient_portion"]

            if cpp_val is not None and cpp_val > 0:
                remaining = round(max(cpp_val - actual_pat, 0), 2)
            else:
                remaining = 0.0

            # Apply only_balance_due filter consistently across full set
            if only_balance_due and remaining <= 0:
                continue

            total_count += 1

            # Days calculations
            try:
                d_svc = datetime.strptime(r["service_date"], "%Y-%m-%d")
                d_now = datetime.strptime(today, "%Y-%m-%d")
                days_since_svc = (d_now - d_svc).days
            except Exception:
                days_since_svc = None

            days_since_sent = None
            if r["claim_sent_date"]:
                try:
                    d_sent = datetime.strptime(r["claim_sent_date"], "%Y-%m-%d")
                    days_since_sent = (datetime.strptime(today, "%Y-%m-%d") - d_sent).days
                except Exception:
                    pass

            # Portion label
            cs = (r["claim_state"] or "").upper()
            if cpp_val is None and opp_val is None:
                portion_label = "PREDETERMINATION"
            elif cs in _GPR_PRE_EOB_STATES:
                portion_label = "PRE_EOB_ESTIMATE"
            elif cs in _GPR_POST_EOB_STATES:
                portion_label = "POST_EOB"
            else:
                portion_label = "UNKNOWN"

            tags = _gpr_compute_tags(r, days_since_svc, remaining, actual_pat, earliest_pat)

            # Same-day patient payment signal
            sdp_key = (r["patient_id"], r["location_id"], r["service_date"])
            sdp = all_sdp_agg.get(sdp_key, {"total": 0.0, "dates": set(), "methods": set()})
            sdp_total = round(sdp["total"], 2)

            # Patient portion collection status
            if cpp_val is None or cpp_val <= 0:
                collection_status = "NO_PORTION_DUE"
            elif actual_pat >= cpp_val:
                collection_status = "COLLECTED_ALLOCATED"
            elif sdp_total >= cpp_val:
                collection_status = "LIKELY_COLLECTED_SAME_DAY"
            elif actual_pat > 0 and actual_pat < cpp_val:
                collection_status = "PARTIALLY_COLLECTED"
            elif days_since_svc is not None and days_since_svc <= min_days_outstanding:
                collection_status = "WITHIN_COLLECTION_WINDOW"
            else:
                collection_status = "NOT_COLLECTED"

            # Same-day tags for scorecard
            if collection_status == "LIKELY_COLLECTED_SAME_DAY":
                tags.append("LIKELY_COLLECTED_SAME_DAY")
                tags.append("ALLOCATION_REVIEW")

            # Scorecard accumulation
            if cpp_val is not None and cpp_val > 0:
                sc_total_cpp += cpp_val
            sc_total_pat_paid += actual_pat
            sc_total_remaining += remaining
            if "PATIENT_PORTION_DUE" in tags or "OVER_5_DAYS_DUE" in tags:
                sc_due_count += 1
            if "COLLECTED_SAME_DAY" in tags:
                sc_same_day += 1
            if "COLLECTED_WITHIN_5_DAYS" in tags:
                sc_within_5 += 1
            if "OVER_5_DAYS_DUE" in tags:
                sc_over_5 += 1
            if "PREDETERMINATION" in tags:
                sc_predet += 1
            sc_sdp_total += sdp_total
            if collection_status == "LIKELY_COLLECTED_SAME_DAY":
                sc_likely_collected += 1
            if "ALLOCATION_REVIEW" in tags:
                sc_alloc_review += 1

            # By-office accumulation
            if office not in sc_by_office:
                sc_by_office[office] = {
                    "office": office, "office_id": oid, "location_id": lid,
                    "total_current_patient_portion": 0.0, "total_actual_patient_paid": 0.0,
                    "total_remaining_patient_due": 0.0, "due_count": 0, "row_count": 0,
                    "same_day_patient_payment_total": 0.0,
                    "likely_collected_same_day_count": 0,
                    "allocation_review_count": 0,
                    "collected_allocated_count": 0,
                    "not_collected_count": 0,
                    "partially_collected_count": 0,
                    "within_window_count": 0,
                    "no_portion_due_count": 0,
                    "total_current_primary_insurance_portion": 0.0,
                    "total_actual_insurance_paid": 0.0,
                    "total_remaining_insurance_due": 0.0,
                    "_post_eob_ins_portion": 0.0,
                    "_post_eob_ins_paid": 0.0,
                    "_claim_ids_seen": set(),
                    "_claims_by_state": {},
                    "_days_since_sent_sum": 0.0,
                    "_days_since_sent_count": 0,
                    "pre_eob_row_count": 0,
                    "post_eob_row_count": 0,
                }
            ob = sc_by_office[office]
            ob["row_count"] += 1
            if cpp_val is not None and cpp_val > 0:
                ob["total_current_patient_portion"] += cpp_val
            ob["total_actual_patient_paid"] += actual_pat
            ob["total_remaining_patient_due"] += remaining
            if "PATIENT_PORTION_DUE" in tags or "OVER_5_DAYS_DUE" in tags:
                ob["due_count"] += 1
            ob["same_day_patient_payment_total"] += sdp_total
            if collection_status == "LIKELY_COLLECTED_SAME_DAY":
                ob["likely_collected_same_day_count"] += 1
            if "ALLOCATION_REVIEW" in tags:
                ob["allocation_review_count"] += 1
            if collection_status == "COLLECTED_ALLOCATED":
                ob["collected_allocated_count"] += 1
            elif collection_status == "NOT_COLLECTED":
                ob["not_collected_count"] += 1
            elif collection_status == "PARTIALLY_COLLECTED":
                ob["partially_collected_count"] += 1
            elif collection_status == "WITHIN_COLLECTION_WINDOW":
                ob["within_window_count"] += 1
            elif collection_status == "NO_PORTION_DUE":
                ob["no_portion_due_count"] += 1
            ins_portion_val = r["current_primary_insurance_portion"]
            if ins_portion_val is not None and ins_portion_val > 0:
                ob["total_current_primary_insurance_portion"] += ins_portion_val
            ob["total_actual_insurance_paid"] += actual_ins
            ins_remaining = max((ins_portion_val or 0) - actual_ins, 0)
            ob["total_remaining_insurance_due"] += ins_remaining
            orig_ins_val = r["original_primary_insurance_portion"]
            if portion_label == "POST_EOB":
                ob["post_eob_row_count"] += 1
                if orig_ins_val is not None and orig_ins_val > 0:
                    ob["_post_eob_ins_portion"] += orig_ins_val
                ob["_post_eob_ins_paid"] += actual_ins
            elif portion_label == "PRE_EOB_ESTIMATE":
                ob["pre_eob_row_count"] += 1
            cid_this = r["claim_id"]
            if cid_this and cid_this not in ob["_claim_ids_seen"]:
                ob["_claim_ids_seen"].add(cid_this)
                ob["_claims_by_state"][cs] = ob["_claims_by_state"].get(cs, 0) + 1
            if days_since_sent is not None:
                ob["_days_since_sent_sum"] += days_since_sent
                ob["_days_since_sent_count"] += 1

        # ====================================================================
        # PAGINATED DATA PASS: fetch only the requested page for the response
        # data array. Scorecard is already computed above from the full set.
        # ====================================================================

        # For only_balance_due, we cannot paginate at SQL level since remaining
        # is computed in Python. Reuse all_rows with index-based pagination.
        if only_balance_due:
            # Build the filtered index list from all_rows (same order)
            _filtered_indices = []
            for idx, r in enumerate(all_rows):
                cid_charge = r["charge_id"]
                pay = all_pay_agg.get(cid_charge, {"pat_paid": 0.0, "pat_dates": set(), "ins_paid": 0.0, "ins_dates": set(), "adj_writeoff": 0.0})
                actual_pat = round(pay["pat_paid"], 2)
                cpp_val = r["current_patient_portion"]
                if cpp_val is not None and cpp_val > 0:
                    remaining = round(max(cpp_val - actual_pat, 0), 2)
                else:
                    remaining = 0.0
                if remaining > 0:
                    _filtered_indices.append(idx)
            offset = (page - 1) * page_size
            page_indices = _filtered_indices[offset:offset + page_size]
            rows = [all_rows[i] for i in page_indices]
            # Payment/SDP lookups already available from full-set pass
            pay_agg = all_pay_agg
            sdp_agg = all_sdp_agg
            # Build payor/plan lookup for page rows (all_rows didn't JOIN insurance_claims)
            _page_claim_ids = {r["claim_id"] for r in rows if r["claim_id"]}
            _payor_plan_map = {}
            if _page_claim_ids:
                _ph = ",".join("?" for _ in _page_claim_ids)
                _pp_rows = conn.execute(f"""
                    SELECT id,
                           json_extract(raw, '$.payorName')     AS payor_name,
                           json_extract(raw, '$.groupPlanName') AS plan_name
                    FROM insurance_claims WHERE id IN ({_ph})
                """, list(_page_claim_ids)).fetchall()
                _payor_plan_map = {r["id"]: (r["payor_name"], r["plan_name"]) for r in _pp_rows}
        else:
            # Standard SQL pagination
            offset = (page - 1) * page_size
            rows = conn.execute(f"""
                SELECT cpp.*,
                       json_extract(ic.raw, '$.payorName')     AS _payor_name,
                       json_extract(ic.raw, '$.groupPlanName') AS _plan_name
                FROM claim_procedure_portions cpp
                LEFT JOIN insurance_claims ic ON ic.id = cpp.claim_id
                WHERE {where_sql}
                ORDER BY cpp.service_date DESC, cpp.claim_id, cpp.patient_procedure_id
                LIMIT ? OFFSET ?
            """, params + [page_size, offset]).fetchall()

            # Gather charge_ids for payment lookup (page only)
            charge_ids = {r["charge_id"] for r in rows if r["charge_id"]}
            pay_agg = _gpr_payment_aggregates(conn, charge_ids)

            # Gather same-day patient payment lookup keys (page only)
            sdp_keys = {(r["patient_id"], r["location_id"], r["service_date"]) for r in rows
                         if r["patient_id"] and r["location_id"] and r["service_date"]}
            sdp_agg = _gpr_same_day_payments(conn, sdp_keys)

        # Build response rows (data array only — scorecard already done in full-set pass)
        data = []

        for r in rows:
            lid = r["location_id"]
            office = _GPR_LOCATION_TO_NAME.get(lid, lid or "Unknown")
            oid = _GPR_LOCATION_TO_OFFICE_ID.get(lid)
            prov_name = providers.get(r["provider_id"], r["provider_id"] or "Unknown")
            proc_desc = proc_descs.get(r["procedure_code"]) if r["procedure_code"] else None

            cid = r["charge_id"]
            pay = pay_agg.get(cid, {"pat_paid": 0.0, "pat_dates": set(), "ins_paid": 0.0, "ins_dates": set(), "adj_writeoff": 0.0})
            actual_pat = round(pay["pat_paid"], 2)
            actual_ins = round(pay["ins_paid"], 2)
            ledger_writeoff = round(pay["adj_writeoff"], 2)
            pat_dates = sorted(pay["pat_dates"])
            ins_dates = sorted(pay["ins_dates"])
            earliest_pat = pat_dates[0] if pat_dates else None

            cpp_val = r["current_patient_portion"]
            opp_val = r["original_patient_portion"]

            if cpp_val is not None and cpp_val > 0:
                remaining = round(max(cpp_val - actual_pat, 0), 2)
            else:
                remaining = 0.0

            if opp_val is not None and opp_val > 0:
                est_remaining = round(max(opp_val - actual_pat, 0), 2)
            else:
                est_remaining = 0.0

            # Days calculations
            try:
                d_svc = datetime.strptime(r["service_date"], "%Y-%m-%d")
                d_now = datetime.strptime(today, "%Y-%m-%d")
                days_since_svc = (d_now - d_svc).days
            except Exception:
                days_since_svc = None

            days_since_sent = None
            if r["claim_sent_date"]:
                try:
                    d_sent = datetime.strptime(r["claim_sent_date"], "%Y-%m-%d")
                    days_since_sent = (datetime.strptime(today, "%Y-%m-%d") - d_sent).days
                except Exception:
                    pass

            # Portion label
            cs = (r["claim_state"] or "").upper()
            if cpp_val is None and opp_val is None:
                portion_label = "PREDETERMINATION"
            elif cs in _GPR_PRE_EOB_STATES:
                portion_label = "PRE_EOB_ESTIMATE"
            elif cs in _GPR_POST_EOB_STATES:
                portion_label = "POST_EOB"
            else:
                portion_label = "UNKNOWN"

            tags = _gpr_compute_tags(r, days_since_svc, remaining, actual_pat, earliest_pat)
            recon_status = _gpr_reconciliation_status(cpp_val, remaining, days_since_svc)

            # Same-day patient payment signal
            sdp_key = (r["patient_id"], r["location_id"], r["service_date"])
            sdp = sdp_agg.get(sdp_key, {"total": 0.0, "dates": set(), "methods": set()})
            sdp_total = round(sdp["total"], 2)
            sdp_dates = sorted(sdp["dates"])
            sdp_methods = sorted(sdp["methods"])

            # Patient portion collection status
            if cpp_val is None or cpp_val <= 0:
                collection_status = "NO_PORTION_DUE"
            elif actual_pat >= cpp_val:
                collection_status = "COLLECTED_ALLOCATED"
            elif sdp_total >= cpp_val:
                collection_status = "LIKELY_COLLECTED_SAME_DAY"
            elif actual_pat > 0 and actual_pat < cpp_val:
                collection_status = "PARTIALLY_COLLECTED"
            elif days_since_svc is not None and days_since_svc <= min_days_outstanding:
                collection_status = "WITHIN_COLLECTION_WINDOW"
            else:
                collection_status = "NOT_COLLECTED"

            # Same-day payment tags
            if sdp_total > 0:
                tags.append("SAME_DAY_PAYMENT_FOUND")
            if collection_status == "LIKELY_COLLECTED_SAME_DAY":
                tags.append("LIKELY_COLLECTED_SAME_DAY")
                tags.append("ALLOCATION_REVIEW")
            if (cpp_val is not None and cpp_val > 0
                    and actual_pat < cpp_val
                    and sdp_total >= cpp_val):
                tags.append("PATIENT_PORTION_NOT_ALLOCATED")

            # Resolve payor/plan — from SQL JOIN (_payor_name) or from lookup map
            if only_balance_due:
                _pp = _payor_plan_map.get(r["claim_id"], (None, None))
                payor_name = _pp[0]
                plan_name = _pp[1]
            else:
                payor_name = r["_payor_name"]
                plan_name = r["_plan_name"]

            row_out = {
                "office": office,
                "office_id": oid,
                "location_id": lid,
                "provider": prov_name,
                "provider_id": r["provider_id"],
                "patient_id": r["patient_id"],
                "patient_name": _patient_names.get(r["patient_id"]),
                "claim_id": r["claim_id"],
                "patient_procedure_id": r["patient_procedure_id"],
                "charge_id": cid,
                "procedure_code": r["procedure_code"],
                "procedure_description": proc_desc,
                "service_date": r["service_date"],
                "charge_amount": r["charge_amount"],
                "original_patient_portion": opp_val,
                "current_patient_portion": cpp_val,
                "portion_label": portion_label,
                "original_primary_insurance_portion": r["original_primary_insurance_portion"],
                "current_primary_insurance_portion": r["current_primary_insurance_portion"],
                "original_secondary_insurance_portion": r["original_secondary_insurance_portion"],
                "write_off": r["write_off"],
                "ledger_write_off": ledger_writeoff,
                "actual_patient_paid": actual_pat,
                "actual_patient_payment_dates": pat_dates,
                "actual_insurance_paid": actual_ins,
                "insurance_payment_dates": ins_dates,
                "remaining_patient_due": remaining,
                "estimated_remaining_patient_due": est_remaining,
                "same_day_patient_payment": sdp_total,
                "same_day_patient_payment_dates": sdp_dates,
                "same_day_patient_payment_methods": sdp_methods,
                "patient_portion_collection_status": collection_status,
                "payor_name": payor_name,
                "plan_name": plan_name,
                "claim_state": r["claim_state"],
                "claim_sent_date": r["claim_sent_date"],
                "days_since_service": days_since_svc,
                "days_since_claim_sent": days_since_sent,
                "reconciliation_status": recon_status,
                "tags": tags,
            }
            data.append(row_out)

        # Round scorecard values and compute derived rates
        _STATE_BUCKETS = {"ACCEPTED", "PAYRECVD", "SETTLED", "UNSENT", "DELETED"}
        for ob in sc_by_office.values():
            ob["total_current_patient_portion"] = round(ob["total_current_patient_portion"], 2)
            ob["total_actual_patient_paid"] = round(ob["total_actual_patient_paid"], 2)
            ob["total_remaining_patient_due"] = round(ob["total_remaining_patient_due"], 2)
            ob["same_day_patient_payment_total"] = round(ob["same_day_patient_payment_total"], 2)

            # Patient portion rates
            tcp = ob["total_current_patient_portion"]
            ob["patient_portion_collection_rate"] = round(ob["total_actual_patient_paid"] / tcp, 4) if tcp > 0 else None
            ob["operational_same_day_collection_rate"] = round(ob["same_day_patient_payment_total"] / tcp, 4) if tcp > 0 else None

            # Insurance rounding
            ob["total_current_primary_insurance_portion"] = round(ob["total_current_primary_insurance_portion"], 2)
            ob["total_actual_insurance_paid"] = round(ob["total_actual_insurance_paid"], 2)
            ob["total_remaining_insurance_due"] = round(ob["total_remaining_insurance_due"], 2)

            # Insurance rates
            tip = ob["total_current_primary_insurance_portion"]
            ob["insurance_collection_rate_all"] = round(ob["total_actual_insurance_paid"] / tip, 4) if tip > 0 else None
            pe_portion = ob.pop("_post_eob_ins_portion")
            pe_paid = ob.pop("_post_eob_ins_paid")
            ob["insurance_collection_rate_post_eob"] = round(pe_paid / pe_portion, 4) if pe_portion > 0 else None

            # Claim counts (distinct)
            claims_by_state = ob.pop("_claims_by_state")
            ob.pop("_claim_ids_seen")
            ob["claim_count"] = sum(claims_by_state.values())
            ob["claims_accepted"] = claims_by_state.get("ACCEPTED", 0)
            ob["claims_payrecvd"] = claims_by_state.get("PAYRECVD", 0)
            ob["claims_settled"] = claims_by_state.get("SETTLED", 0)
            ob["claims_unsent"] = claims_by_state.get("UNSENT", 0)
            ob["claims_deleted"] = claims_by_state.get("DELETED", 0)
            ob["claims_other"] = sum(v for k, v in claims_by_state.items() if k not in _STATE_BUCKETS)

            # Avg days since claim sent
            dss_sum = ob.pop("_days_since_sent_sum")
            dss_cnt = ob.pop("_days_since_sent_count")
            ob["avg_days_since_claim_sent"] = round(dss_sum / dss_cnt, 1) if dss_cnt > 0 else None

        return {
            "data": data,
            "meta": {
                "total": total_count,
                "page": page,
                "page_size": page_size,
                "start_date": s,
                "end_date": e,
                "filters_applied": {
                    "location_id": loc,
                    "min_days_outstanding": min_days_outstanding,
                    "only_balance_due": only_balance_due,
                    "exclude_zero_portion": exclude_zero_portion,
                    "include_predeterminations": include_predeterminations,
                },
            },
            "scorecard": {
                "total_rows": total_count,
                "total_current_patient_portion": round(sc_total_cpp, 2),
                "total_actual_patient_paid": round(sc_total_pat_paid, 2),
                "total_remaining_patient_due": round(sc_total_remaining, 2),
                "due_row_count": sc_due_count,
                "collected_same_day_count": sc_same_day,
                "collected_within_5_days_count": sc_within_5,
                "over_5_days_due_count": sc_over_5,
                "predetermination_count": sc_predet,
                "same_day_patient_payment_total": round(sc_sdp_total, 2),
                "likely_collected_same_day_count": sc_likely_collected,
                "allocation_review_count": sc_alloc_review,
                "by_office": list(sc_by_office.values()),
            },
        }
    finally:
        conn.close()


@app.get("/v2/financial/filter-options", tags=["Financial"], dependencies=[Depends(verify_api_key)])
def financial_filter_options(
    startDate:  Optional[str] = Query(None),
    endDate:    Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
):
    import sqlite3 as _sqlite3
    from datetime import date as _date
    selected_locations = list(dict.fromkeys(value.strip() for value in (locationId or '').split(',') if value.strip()))
    if locationId and (not selected_locations or any(value not in VALID_LOCATION_IDS for value in selected_locations)):
        raise HTTPException(status_code=422, detail="Select valid office locations.")
    location_placeholders = ",".join("?" for _ in selected_locations)
    conn = _sqlite3.connect(RCM_DB_PATH)
    conn.row_factory = _sqlite3.Row
    try:
        today = _date.today().isoformat()
        first_of_month = _date.today().replace(day=1).isoformat()
        start = startDate or first_of_month
        end   = endDate   or today

        # ── 1. Offices ───────────────────────────────────────────────────────
        loc_rows = conn.execute(
            "SELECT id, name, city, state FROM locations WHERE id IN ({}) ORDER BY name"
            .format(",".join("?" * len(VALID_LOCATION_IDS))),
            tuple(VALID_LOCATION_IDS)
        ).fetchall()
        offices = [
            {"officeId": r["id"], "officeName": r["name"], "city": r["city"], "state": r["state"]}
            for r in loc_rows
        ]

        # ── 2. Providers ─────────────────────────────────────────────────────
        # Collect active providers with optional activity counts in date range
        prov_params: list = []
        prov_count_sql = """
            SELECT provider_id, COUNT(*) as cnt
            FROM procedures
            WHERE is_active = 1
              AND transaction_date >= ? AND transaction_date <= ?
              AND ledger_type = 'PatientProcedureLedger'
        """
        prov_params += [start, end]
        if selected_locations:
            prov_count_sql += " AND location_id IN (" + location_placeholders + ")"
            prov_params.extend(selected_locations)
        prov_count_sql += " GROUP BY provider_id"

        activity = {r["provider_id"]: r["cnt"]
                    for r in conn.execute(prov_count_sql, prov_params).fetchall()}

        prov_rows = conn.execute(
            "SELECT id, first_name, last_name, is_active, raw FROM providers ORDER BY last_name, first_name"
        ).fetchall()

        import json as _json

        providers = []
        for r in prov_rows:
            raw = _json.loads(r["raw"] or "{}")
            specialty   = (raw.get("specialty") or "").upper()
            short_name  = raw.get("shortName", "")
            first       = r["first_name"] or ""
            last        = r["last_name"]  or ""
            full_name   = f"{first} {last}".strip() if (first or last) else short_name

            # Skip blank system/location-named providers that have no person name
            # and are in VALID_LOCATION_IDS (house accounts)
            is_location_proxy = r["id"] in VALID_LOCATION_IDS or (
                not first and last in {
                    "NU Dental of Eatontown", "NU Dental Of Staten Island",
                    "NU Dental of Brick", "NU Dental of Barnegat"
                }
            )

            # Conversion/Missing → unattributed
            is_conversion = first == "Conversion" and last == "Missing"

            if is_location_proxy:
                prov_type = "house_unknown"
            elif is_conversion:
                prov_type = "unattributed"
            else:
                prov_type = SPECIALTY_TYPE_MAP.get(specialty, "unknown")

            cnt = activity.get(r["id"])

            providers.append({
                "providerId":   r["id"],
                "providerName": full_name,
                "isActive":     bool(r["is_active"]),
                "providerType": prov_type,
                "count":        cnt if cnt is not None else None,
            })

        # ── 3. Provider Types ─────────────────────────────────────────────────
        type_counts: dict = {}
        type_has_null: dict = {}
        for p in providers:
            pt = p["providerType"]
            if pt not in type_counts:
                type_counts[pt] = 0
                type_has_null[pt] = False
            if p["count"] is None:
                type_has_null[pt] = True
            else:
                type_counts[pt] += p["count"]

        # Ensure all canonical types present
        for canonical in ("doctor", "hygienist", "house_unknown", "unattributed", "unknown"):
            if canonical not in type_counts:
                type_counts[canonical] = 0
                type_has_null[canonical] = True

        provider_types = sorted(
            [
                {
                    "providerType": pt,
                    "count": None if type_has_null[pt] and type_counts[pt] == 0 else type_counts[pt],
                }
                for pt in type_counts
            ],
            key=lambda x: x["providerType"],
        )

        # ── 4. Payment Methods ────────────────────────────────────────────────
        CARD_TYPE_REF = [
            {"cardKey": "visa",       "cardLabel": "VISA",             "creditCardType": 1, "tagId": "14000000003510"},
            {"cardKey": "mastercard", "cardLabel": "MasterCard",       "creditCardType": 2, "tagId": "14000000003507"},
            {"cardKey": "amex",       "cardLabel": "American Express", "creditCardType": 3, "tagId": "14000000003501"},
            {"cardKey": "discover",   "cardLabel": "Discover",         "creditCardType": 4, "tagId": "14000000003505"},
        ]
        FINANCING_TAG_IDS = ("14000000003502", "14000000016197")

        _p_loc = ""
        _p_loc_args: list = []
        _i_loc = ""
        _i_loc_args: list = []
        if selected_locations:
            _p_loc = " AND location_id IN (" + location_placeholders + ")"
            _p_loc_args = selected_locations
            _i_loc = " AND COALESCE(claim_location_id, location_id) IN (" + location_placeholders + ")"
            _i_loc_args = selected_locations

        _dt = [start, end]

        # ── A. Credit Card (Payment + Rebill, creditCardType IS NOT NULL) ──────
        cc_card_rows = conn.execute(f"""
            SELECT json_extract(raw,'$.patientPaymentBilling.creditCardType') AS cc_type,
                   COUNT(*) AS cnt,
                   ABS(SUM(amount)) AS total
            FROM patient_payments
            WHERE is_active = 1
              AND ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')
              AND amount < 0
              AND transaction_date >= ? AND transaction_date <= ?
              AND json_extract(raw,'$.patientPaymentBilling.creditCardType') IS NOT NULL
              {_p_loc}
            GROUP BY json_extract(raw,'$.patientPaymentBilling.creditCardType')
        """, _dt + _p_loc_args).fetchall()

        cc_by_type: dict = {}
        cc_total_count = 0
        cc_total_amount = 0.0
        for r in cc_card_rows:
            ct = r["cc_type"]
            cnt = r["cnt"] or 0
            amt = float(r["total"] or 0)
            cc_by_type[ct] = {"count": cnt, "amount": amt}
            cc_total_count  += cnt
            cc_total_amount += amt

        # ── B. Check Payments (PaymentOnly, checkNumber IS NOT NULL, no cc) ────
        chk_row = conn.execute(f"""
            SELECT COUNT(*) AS cnt, ABS(SUM(amount)) AS total
            FROM patient_payments
            WHERE is_active = 1
              AND ledger_type = 'PatientProcedurePayment'
              AND amount < 0
              AND transaction_date >= ? AND transaction_date <= ?
              AND json_extract(raw,'$.patientPaymentBilling.checkNumber') IS NOT NULL
              AND json_extract(raw,'$.patientPaymentBilling.creditCardType') IS NULL
              {_p_loc}
        """, _dt + _p_loc_args).fetchone()
        chk_count  = chk_row["cnt"] or 0
        chk_amount = float(chk_row["total"] or 0)

        # ── C. Patient Financing (PaymentOnly, no billing, paidAtVisit, financing tags) ─
        fin_row = conn.execute(f"""
            SELECT COUNT(*) AS cnt, ABS(SUM(amount)) AS total
            FROM patient_payments
            WHERE is_active = 1
              AND ledger_type = 'PatientProcedurePayment'
              AND amount < 0
              AND transaction_date >= ? AND transaction_date <= ?
              AND json_extract(raw,'$.patientPaymentBilling') IS NULL
              AND json_extract(raw,'$.paidAtVisit') = 1
              AND json_extract(raw,'$.transactionTags.1.id') IN ('14000000003502','14000000016197')
              {_p_loc}
        """, _dt + _p_loc_args).fetchone()
        fin_count  = fin_row["cnt"] or 0
        fin_amount = float(fin_row["total"] or 0)

        # ── D. Cash (Payment+Rebill, no billing, paidAtVisit, NOT financing tags) ─
        cash_row = conn.execute(f"""
            SELECT COUNT(*) AS cnt, ABS(SUM(amount)) AS total
            FROM patient_payments
            WHERE is_active = 1
              AND ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')
              AND amount < 0
              AND transaction_date >= ? AND transaction_date <= ?
              AND json_extract(raw,'$.patientPaymentBilling') IS NULL
              AND json_extract(raw,'$.paidAtVisit') = 1
              AND (json_extract(raw,'$.transactionTags.1.id') IS NULL
                   OR json_extract(raw,'$.transactionTags.1.id') NOT IN ('14000000003502','14000000016197'))
              {_p_loc}
        """, _dt + _p_loc_args).fetchone()
        cash_count  = cash_row["cnt"] or 0
        cash_amount = float(cash_row["total"] or 0)

        # ── Unclassified patient (no billing + paidAtVisit=0/NULL, or billing with no cc/check) ─
        pat_unclass_row = conn.execute(f"""
            SELECT COUNT(*) AS cnt, ABS(SUM(amount)) AS total
            FROM patient_payments
            WHERE is_active = 1
              AND ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')
              AND amount < 0
              AND transaction_date >= ? AND transaction_date <= ?
              AND json_extract(raw,'$.patientPaymentBilling.creditCardType') IS NULL
              AND json_extract(raw,'$.patientPaymentBilling.checkNumber') IS NULL
              AND NOT (
                    json_extract(raw,'$.patientPaymentBilling') IS NULL
                    AND json_extract(raw,'$.paidAtVisit') = 1
              )
              {_p_loc}
        """, _dt + _p_loc_args).fetchone()
        pat_unclass_count  = pat_unclass_row["cnt"] or 0
        pat_unclass_amount = float(pat_unclass_row["total"] or 0)

        # ── E. Insurance Check ────────────────────────────────────────────────
        ins_chk_row = conn.execute(f"""
            SELECT COUNT(*) AS cnt,
                   COUNT(DISTINCT json_extract(raw,'$.patientPaymentBilling.checkNumber')) AS deposit_cnt,
                   ABS(SUM(amount)) AS total
            FROM insurance_payments
            WHERE is_active = 1
              AND ledger_type IN ('InsurancePayment','InsurancePaymentRebill')
              AND amount < 0
              AND transaction_date >= ? AND transaction_date <= ?
              AND json_extract(raw,'$.patientPaymentBilling.checkNumber') IS NOT NULL
              {_i_loc}
        """, _dt + _i_loc_args).fetchone()
        ins_chk_count   = ins_chk_row["cnt"] or 0
        ins_chk_deposit = ins_chk_row["deposit_cnt"] or 0
        ins_chk_amount  = float(ins_chk_row["total"] or 0)

        # ── F. Insurance Credit Card ──────────────────────────────────────────
        ins_cc_row = conn.execute(f"""
            SELECT COUNT(*) AS cnt, ABS(SUM(amount)) AS total
            FROM insurance_payments
            WHERE is_active = 1
              AND ledger_type IN ('InsurancePayment','InsurancePaymentRebill')
              AND amount < 0
              AND transaction_date >= ? AND transaction_date <= ?
              AND json_extract(raw,'$.patientPaymentBilling.creditCardType') IS NOT NULL
              {_i_loc}
        """, _dt + _i_loc_args).fetchone()
        ins_cc_count  = ins_cc_row["cnt"] or 0
        ins_cc_amount = float(ins_cc_row["total"] or 0)

        # ── G. Insurance Electronic (EFT/ERA/DD pattern, no check, no cc) ───
        ins_eft_row = conn.execute(f"""
            SELECT COUNT(*) AS cnt,
                   COUNT(DISTINCT json_extract(raw,'$.patientPaymentBilling.referenceNumber')) AS deposit_cnt,
                   ABS(SUM(amount)) AS total
            FROM insurance_payments
            WHERE is_active = 1
              AND ledger_type IN ('InsurancePayment','InsurancePaymentRebill')
              AND amount < 0
              AND transaction_date >= ? AND transaction_date <= ?
              AND json_extract(raw,'$.patientPaymentBilling.checkNumber') IS NULL
              AND json_extract(raw,'$.patientPaymentBilling.creditCardType') IS NULL
              AND (
                    json_extract(raw,'$.patientPaymentBilling.referenceNumber') LIKE '%EFT%'
                 OR json_extract(raw,'$.patientPaymentBilling.referenceNumber') LIKE 'DD %'
                 OR (
                      json_extract(raw,'$.patientPaymentBilling.referenceNumber') IS NOT NULL
                      AND json_extract(raw,'$.patientPaymentBilling.referenceNumber') != ''
                      AND json_extract(raw,'$.patientPaymentBilling.referenceNumber') NOT LIKE '%NO PAY%'
                    )
              )
              {_i_loc}
        """, _dt + _i_loc_args).fetchone()
        ins_eft_count   = ins_eft_row["cnt"] or 0
        ins_eft_deposit = ins_eft_row["deposit_cnt"] or 0
        ins_eft_amount  = float(ins_eft_row["total"] or 0)

        # ── Insurance Unclassified (no check, no cc, no EFT/DD/ref pattern) ──
        ins_unclass_row = conn.execute(f"""
            SELECT COUNT(*) AS cnt, ABS(SUM(amount)) AS total
            FROM insurance_payments
            WHERE is_active = 1
              AND ledger_type IN ('InsurancePayment','InsurancePaymentRebill')
              AND amount < 0
              AND transaction_date >= ? AND transaction_date <= ?
              AND json_extract(raw,'$.patientPaymentBilling.checkNumber') IS NULL
              AND json_extract(raw,'$.patientPaymentBilling.creditCardType') IS NULL
              AND NOT (
                    json_extract(raw,'$.patientPaymentBilling.referenceNumber') LIKE '%EFT%'
                 OR json_extract(raw,'$.patientPaymentBilling.referenceNumber') LIKE 'DD %'
                 OR (
                      json_extract(raw,'$.patientPaymentBilling.referenceNumber') IS NOT NULL
                      AND json_extract(raw,'$.patientPaymentBilling.referenceNumber') != ''
                      AND json_extract(raw,'$.patientPaymentBilling.referenceNumber') NOT LIKE '%NO PAY%'
                    )
              )
              {_i_loc}
        """, _dt + _i_loc_args).fetchone()
        ins_unclass_count  = ins_unclass_row["cnt"] or 0
        ins_unclass_amount = float(ins_unclass_row["total"] or 0)

        total_unclassified_count  = pat_unclass_count  + ins_unclass_count
        total_unclassified_amount = pat_unclass_amount + ins_unclass_amount

        payment_methods = [
            {
                "methodKey":    "credit_card",
                "methodLabel":  "Credit Card Payments",
                "enabled":      True,
                "confidence":   "high",
                "source":       "patient_payments.raw.patientPaymentBilling.creditCardType",
                "count":        cc_total_count,
                "amount":       round(cc_total_amount, 2),
                "cardTypes": [
                    {
                        "cardKey":        m["cardKey"],
                        "cardLabel":      m["cardLabel"],
                        "creditCardType": m["creditCardType"],
                        "tagId":          m["tagId"],
                        "count":          cc_by_type.get(m["creditCardType"], {}).get("count", 0),
                        "amount":         round(cc_by_type.get(m["creditCardType"], {}).get("amount", 0.0), 2),
                    }
                    for m in CARD_TYPE_REF
                ],
            },
            {
                "methodKey":    "check",
                "methodLabel":  "Check Payments",
                "enabled":      True,
                "confidence":   "high",
                "source":       "patient_payments.raw.patientPaymentBilling.checkNumber",
                "count":        chk_count,
                "amount":       round(chk_amount, 2),
                "cardTypes":    [],
            },
            {
                "methodKey":    "cash",
                "methodLabel":  "Cash Payments",
                "enabled":      True,
                "confidence":   "medium",
                "source":       "patientPaymentBilling IS NULL, paidAtVisit=true, excluding financing tags",
                "count":        cash_count,
                "amount":       round(cash_amount, 2),
                "cardTypes":    [],
            },
            {
                "methodKey":    "insurance_check",
                "methodLabel":  "Insurance Check Payments",
                "enabled":      True,
                "confidence":   "high",
                "source":       "insurance_payments.raw.patientPaymentBilling.checkNumber",
                "count":        ins_chk_count,
                "depositCount": ins_chk_deposit,
                "amount":       round(ins_chk_amount, 2),
                "cardTypes":    [],
            },
            {
                "methodKey":    "insurance_credit_card",
                "methodLabel":  "Insurance Credit Card Payments",
                "enabled":      True,
                "confidence":   "medium",
                "source":       "insurance_payments.raw.patientPaymentBilling.creditCardType",
                "count":        ins_cc_count,
                "amount":       round(ins_cc_amount, 2),
                "cardTypes":    [],
            },
            {
                "methodKey":    "insurance_electronic",
                "methodLabel":  "Insurance Electronic Payments",
                "enabled":      True,
                "confidence":   "medium",
                "source":       "insurance_payments: no checkNumber, no creditCardType",
                "count":        ins_eft_count,
                "depositCount": ins_eft_deposit,
                "amount":       round(ins_eft_amount, 2),
                "cardTypes":    [],
            },
            {
                "methodKey":    "patient_financing",
                "methodLabel":  "Patient Financing Payments",
                "enabled":      True,
                "confidence":   "high",
                "source":       "patient_payments.raw.transactionTags.1.id IN ('14000000003502','14000000016197')",
                "count":        fin_count,
                "amount":       round(fin_amount, 2),
                "cardTypes":    [],
            },
            {
                "methodKey":    "electronic_transfer",
                "methodLabel":  "Electronic Transfer Payments",
                "enabled":      False,
                "confidence":   "low",
                "source":       None,
                "count":        None,
                "amount":       None,
                "reason":       "Patient ACH/EFT cannot be reliably classified from current Dentrix SQLite raw data.",
                "cardTypes":    [],
            },
            {
                "methodKey":    "unclassified",
                "methodLabel":  "Unclassified Payments",
                "enabled":      True,
                "confidence":   "low",
                "source":       "patient and insurance payments without reliable method indicators",
                "count":        total_unclassified_count,
                "amount":       round(total_unclassified_amount, 2),
                "reason":       "Payments without reliable method indicators.",
                "cardTypes":    [],
            },
        ]

        card_types = [
            {
                "cardKey":        c["cardKey"],
                "cardLabel":      c["cardLabel"],
                "creditCardType": c["creditCardType"],
                "tagId":          c["tagId"],
            }
            for c in CARD_TYPE_REF
        ]

        # ── 5. Collection Status ──────────────────────────────────────────────
        cs_params: list = [start, end]
        cs_loc_clause = ""
        if selected_locations:
            cs_loc_clause = " AND location_id IN (" + location_placeholders + ")"
            cs_params.extend(selected_locations)

        cs_rows = conn.execute(f"""
            SELECT
                json_extract(raw, '$.claimState')    as claim_state,
                json_extract(raw, '$.totalCharges')  as total_charges,
                COUNT(*) as cnt
            FROM insurance_claims
            WHERE service_date >= ? AND service_date <= ?
              {cs_loc_clause}
            GROUP BY claim_state
        """, cs_params).fetchall()

        cs_buckets: dict = {}
        for r in cs_rows:
            raw_state = (r["claim_state"] or "").upper()
            if raw_state in CLAIM_STATE_MAP:
                key, label = CLAIM_STATE_MAP[raw_state]
            else:
                key, label = "unknown", "Unknown"

            if key not in cs_buckets:
                cs_buckets[key] = {"statusKey": key, "statusLabel": label, "count": 0, "totalCharges": None}
            cs_buckets[key]["count"] += r["cnt"]

        # total_charges per bucket — re-query for sum
        cs_charges_rows = conn.execute(f"""
            SELECT
                json_extract(raw, '$.claimState')       as claim_state,
                SUM(CAST(json_extract(raw,'$.totalCharges') AS REAL)) as total_charges
            FROM insurance_claims
            WHERE service_date >= ? AND service_date <= ?
              {cs_loc_clause}
            GROUP BY claim_state
        """, cs_params).fetchall()

        for r in cs_charges_rows:
            raw_state = (r["claim_state"] or "").upper()
            key = CLAIM_STATE_MAP.get(raw_state, ("unknown", "Unknown"))[0]
            if key in cs_buckets and r["total_charges"] is not None:
                prev = cs_buckets[key]["totalCharges"]
                new  = round(float(r["total_charges"]), 2)
                cs_buckets[key]["totalCharges"] = new if prev is None else round(prev + new, 2)

        collection_statuses = sorted(cs_buckets.values(), key=lambda x: -x["count"])

        # ── 6. Service Categories (live — powered by patient_procedure_map) ──
        COVERAGE_THRESHOLD = 0.99  # 99% minimum to enable

        # Total procedure rows (all time)
        total_proc_count = conn.execute(
            "SELECT COUNT(*) FROM procedures"
        ).fetchone()[0] or 0

        # Mapped rows in patient_procedure_map (no errors, fully resolved)
        mapped_count = conn.execute(
            "SELECT COUNT(*) FROM patient_procedure_map "
            "WHERE error IS NULL AND practice_procedure_id IS NOT NULL"
        ).fetchone()[0] or 0

        # Active production procedure rows that have a confirmed CDT mapping
        # (join active prod rows to patient_procedure_map via patientProcedure.id in raw)
        active_cov_row = conn.execute("""
            SELECT
                COUNT(*) AS active_prod_total,
                SUM(CASE WHEN ppm.patient_procedure_id IS NOT NULL THEN 1 ELSE 0 END) AS active_prod_mapped
            FROM procedures p
            LEFT JOIN patient_procedure_map ppm
                ON json_extract(p.raw, '$.patientProcedure.id') = ppm.patient_procedure_id
               AND ppm.error IS NULL
               AND ppm.practice_procedure_id IS NOT NULL
            WHERE p.is_active = 1
              AND p.ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')
        """).fetchone()
        active_prod_count  = active_cov_row["active_prod_total"]  or 0
        active_prod_mapped = active_cov_row["active_prod_mapped"] or 0

        coverage_all    = round(mapped_count       / total_proc_count,  6) if total_proc_count  else 0.0
        coverage_active = round(active_prod_mapped / active_prod_count, 6) if active_prod_count else 0.0

        mapping_enabled = coverage_all >= COVERAGE_THRESHOLD

        if mapping_enabled:
            # Build category list from real mapped procedures
            # Scope to active production ledger rows only; respect locationId if provided
            cat_sql = """
                SELECT
                    COALESCE(ppm.normalized_service_category, 'Unknown / Unmapped') AS service_category,
                    COUNT(DISTINCT ppm.ada_code) AS ada_code_count,
                    COUNT(*) AS procedure_count
                FROM procedures p
                LEFT JOIN patient_procedure_map ppm
                    ON json_extract(p.raw, '$.patientProcedure.id') = ppm.patient_procedure_id
                WHERE p.is_active = 1
                  AND p.ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')
            """
            cat_params: list = []
            if selected_locations:
                cat_sql += " AND p.location_id IN (" + location_placeholders + ")"
                cat_params.extend(selected_locations)
            cat_sql += " GROUP BY service_category ORDER BY procedure_count DESC"

            cat_rows = conn.execute(cat_sql, tuple(cat_params)).fetchall()

            # CDT canonical sort order — matches normalize_category() ranges
            CDT_SORT_ORDER = [
                "Diagnostic / Exams",
                "Preventive / Hygiene",
                "Restorative",
                "Endodontics",
                "Periodontics",
                "Prosthodontics / Removable",
                "Maxillofacial Prosthetics",
                "Implants / Fixed Prosthodontics",
                "Prosthodontics / Fixed",
                "Oral Surgery",
                "Orthodontics",
                "Adjunctive / Misc",
                "Cosmetic",
                "Unknown / Unmapped",
            ]

            def _cat_sort_key(row_cat: str) -> int:
                try:
                    return CDT_SORT_ORDER.index(row_cat)
                except ValueError:
                    return len(CDT_SORT_ORDER)

            cat_list = sorted(
                [
                    {
                        "value":          r["service_category"],
                        "label":          r["service_category"],
                        "enabled":        True,
                        "procedureCount": r["procedure_count"],
                        "adaCodeCount":   r["ada_code_count"],
                    }
                    for r in cat_rows
                ],
                key=lambda x: _cat_sort_key(x["value"]),
            )

            service_categories = cat_list
            svc_cat_mapping = {
                "enabled":                  True,
                "coverageAllProcedures":    round(coverage_all * 100, 4),
                "coverageActiveProcedures": round(coverage_active * 100, 4),
                "mappedCount":              mapped_count,
                "totalProcedureCount":      total_proc_count,
                "activeProcedureCount":     active_prod_count,
                "activeMappedCount":        active_prod_mapped,
                "source":                   "patient_procedure_map + practice_procedures",
                "reason":                   None,
            }
            logger.info(
                "service_categories: enabled=True coverage_all=%.4f coverage_active=%.4f categories=%d",
                coverage_all, coverage_active, len(cat_list),
            )
        else:
            service_categories = []
            svc_cat_mapping = {
                "enabled":                  False,
                "coverageAllProcedures":    round(coverage_all * 100, 4),
                "coverageActiveProcedures": round(coverage_active * 100, 4),
                "mappedCount":              mapped_count,
                "totalProcedureCount":      total_proc_count,
                "activeProcedureCount":     active_prod_count,
                "activeMappedCount":        active_prod_mapped,
                "source":                   "patient_procedure_map + practice_procedures",
                "reason":                   (
                    f"Coverage {round(coverage_all * 100, 2)}% is below required threshold "
                    f"of {int(COVERAGE_THRESHOLD * 100)}%. "
                    "Run service_category_sync.py --map-patient-procedures to improve coverage."
                ),
            }
            logger.warning(
                "service_categories: disabled — coverage_all=%.4f below threshold=%.2f",
                coverage_all, COVERAGE_THRESHOLD,
            )

        # ── 7. Saved Analyses (internal feature, not Dentrix) ─────────────────
        saved_analyses = {
            "appFeature":    True,
            "dentrixSource": False,
            "enabled":       False,
            "reason": (
                "Saved Analyses is an internal dashboard feature and is not sourced from Dentrix. "
                "Storage/API not implemented yet."
            ),
        }

        return {
            "startDate":              start,
            "endDate":                end,
            "locationId":             locationId,
            "offices":                offices,
            "providers":              providers,
            "providerTypes":          provider_types,
            "paymentMethods":         payment_methods,
            "cardTypes":              card_types,
            "collectionStatuses":     collection_statuses,
            "serviceCategories":      service_categories,
            "serviceCategoryMapping": svc_cat_mapping,
            "savedAnalyses":          saved_analyses,
        }

    except Exception as e:
        logger.exception("Error in financial filter-options")
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        conn.close()


@app.get("/v2/admin/executive-reconcile", tags=["Admin"], dependencies=[Depends(verify_api_key)])
def executive_reconcile(
    year: int = Query(2026),
    month: Optional[int] = Query(None),
    locationId: Optional[str] = Query(None),
    officeId: Optional[str] = Query(None),
):
    """
    Debug/validation endpoint: returns selected filters, precomputed values, live API values,
    PDF reference values, and pass/fail for each KPI.
    Covers all 16 office-month combinations and monthly/grand totals.
    """
    import calendar as _cal
    from ascend_service import _get_precomputed, _get_precomputed_all_offices, recompute_month, get_service as _get_svc

    svc = _get_svc()
    loc_id = resolve_location_id(officeId, locationId)

    months = [month] if month else [1, 2, 3, 4]
    offices = [loc_id] if loc_id else list(OFFICE_CANONICAL.keys())

    results = []
    grand_net_precomp = 0
    grand_coll_precomp = 0
    grand_net_pdf = 0
    grand_coll_pdf = 0

    for m in months:
        last_day = _cal.monthrange(year, m)[1]
        start = f"{year}-{m:02d}-01"
        end = f"{year}-{m:02d}-{last_day:02d}"
        month_net_precomp = 0
        month_coll_precomp = 0
        month_net_pdf = 0
        month_coll_pdf = 0

        for lid in offices:
            pdf = EXEC_PDF_VALUES.get((lid, year, m))
            precomp = _get_precomputed(lid, year, m)

            # Live API values (from the live formula, bypassing cache)
            from sync import get_db
            conn = get_db()
            proc_row = conn.execute(
                "SELECT COALESCE(SUM(amount), 0) as gross FROM procedures "
                "WHERE transaction_date >= ? AND transaction_date <= ? AND is_active = 1 AND location_id = ?",
                (start, end, lid)
            ).fetchone()
            gross_live = float(proc_row["gross"] if proc_row else 0)
            conn.close()

            row = {
                "office": OFFICE_CANONICAL.get(lid, lid),
                "location_id": lid,
                "year": year,
                "month": m,
                "date_range": f"{start} – {end}",
                "filters": {"location_id": lid, "year": year, "month": m},
                "pdf": {
                    "net_production": pdf[0] if pdf else None,
                    "collections": pdf[1] if pdf else None,
                } if pdf else None,
                "precomputed": {
                    "gross": precomp["grossProduction"] if precomp else None,
                    "net": precomp["netProduction"] if precomp else None,
                    "collections": precomp["collections"] if precomp else None,
                    "source": precomp["source"] if precomp else "MISSING",
                } if precomp else {"source": "MISSING"},
                "live_gross_procedures": round(gross_live, 2),
                "validation": {},
            }

            # Validation
            if pdf and precomp:
                prod_diff = abs(precomp["netProduction"] - pdf[0])
                coll_diff = abs(precomp["collections"] - pdf[1])
                row["validation"]["net_production"] = "PASS" if prod_diff < 1 else f"FAIL (diff={prod_diff:.2f})"
                row["validation"]["collections"] = "PASS" if coll_diff < 1 else f"FAIL (diff={coll_diff:.2f})"
                row["validation"]["overall"] = "PASS" if prod_diff < 1 and coll_diff < 1 else "FAIL"
                month_net_precomp += precomp["netProduction"]
                month_coll_precomp += precomp["collections"]
                month_net_pdf += pdf[0]
                month_coll_pdf += pdf[1]
            elif precomp:
                row["validation"]["overall"] = "NO_PDF_REF"
                month_net_precomp += precomp["netProduction"]
                month_coll_precomp += precomp["collections"]
            else:
                row["validation"]["overall"] = "MISSING_PRECOMPUTED"

            results.append(row)

        grand_net_precomp += month_net_precomp
        grand_coll_precomp += month_coll_precomp
        grand_net_pdf += month_net_pdf
        grand_coll_pdf += month_coll_pdf

    # Monthly totals summary
    monthly_summary = []
    for m in months:
        m_rows = [r for r in results if r["month"] == m]
        m_net = sum(r["precomputed"].get("net", 0) or 0 for r in m_rows)
        m_coll = sum(r["precomputed"].get("collections", 0) or 0 for r in m_rows)
        pdf_m = EXEC_MONTHLY_PDF.get((year, m))
        monthly_summary.append({
            "year": year, "month": m,
            "net_production_sum": round(m_net, 2),
            "collections_sum": round(m_coll, 2),
            "pdf_net": pdf_m["net_production"] if pdf_m else None,
            "pdf_coll": pdf_m["collections"] if pdf_m else None,
            "net_diff": round(abs(m_net - (pdf_m["net_production"] if pdf_m else 0)), 2) if pdf_m else None,
            "coll_diff": round(abs(m_coll - (pdf_m["collections"] if pdf_m else 0)), 2) if pdf_m else None,
            "pass": abs(m_net - (pdf_m["net_production"] if pdf_m else 0)) < 2 and abs(m_coll - (pdf_m["collections"] if pdf_m else 0)) < 2 if pdf_m else None,
        })

    all_pass = all(r["validation"].get("overall") == "PASS" for r in results if "overall" in r["validation"])

    return {
        "summary": {
            "total_office_months_checked": len(results),
            "all_pass": all_pass,
            "grand_net_precomputed": round(grand_net_precomp, 2),
            "grand_net_pdf": round(grand_net_pdf, 2),
            "grand_coll_precomputed": round(grand_coll_precomp, 2),
            "grand_coll_pdf": round(grand_coll_pdf, 2),
        },
        "monthly_totals": monthly_summary,
        "office_month_detail": results,
    }


@app.post("/v2/admin/recompute-month", tags=["Admin"], dependencies=[Depends(verify_api_key)])
def recompute_month_endpoint(
    year: int = Query(...),
    month: int = Query(...),
    locationId: Optional[str] = Query(None),
    officeId: Optional[str] = Query(None),
    force: bool = Query(False),
    all_offices: bool = Query(False),
):
    """
    Trigger recompute of production_by_month for a given office+month.
    Use all_offices=true to recompute all 4 offices.
    Use force=true to overwrite existing computed (not pdf_authoritative) rows.
    """
    from ascend_service import recompute_month

    LOCATION_IDS = ["14000000000432", "14000000000433", "14000000000434", "14000000000435"]
    loc_id = resolve_location_id(officeId, locationId)

    targets = LOCATION_IDS if all_offices else ([loc_id] if loc_id else LOCATION_IDS)

    results = []
    for lid in targets:
        result = recompute_month(lid, year, month, force=force)
        result["office"] = OFFICE_CANONICAL.get(lid, lid)
        results.append(result)

    return {"recomputed": results, "year": year, "month": month}


@app.post("/v2/admin/backfill-history", tags=["Admin"], dependencies=[Depends(verify_api_key)])
def backfill_history(
    start_year: int = Query(2021),
    start_month: int = Query(1),
    end_year: int = Query(2025),
    end_month: int = Query(12),
    force: bool = Query(False),
):
    """
    Backfill production_by_month for all offices across a historical date range.
    Skips months that already have precomputed data (unless force=True).
    PDF-authoritative rows (Jan-Apr 2026) are never overwritten.
    """
    from ascend_service import recompute_month, _get_precomputed

    LOCATION_IDS = ["14000000000432", "14000000000433", "14000000000434", "14000000000435"]
    PDF_AUTH_KEYS = {(lid, y, m) for (lid, y, m) in [(l, y, m) for l in LOCATION_IDS
                     for (y, m) in [(2026, 1), (2026, 2), (2026, 3), (2026, 4)]]}

    results = {"seeded": 0, "skipped": 0, "errors": 0, "details": []}
    for y in range(start_year, end_year + 1):
        for m in range(1, 13):
            if y == start_year and m < start_month:
                continue
            if y == end_year and m > end_month:
                break
            for lid in LOCATION_IDS:
                # Never overwrite PDF-authoritative values
                if (lid, y, m) in PDF_AUTH_KEYS:
                    results["skipped"] += 1
                    continue
                result = recompute_month(lid, y, m, force=force)
                if result.get("skipped"):
                    results["skipped"] += 1
                elif result.get("error"):
                    results["errors"] += 1
                    results["details"].append({"lid": lid, "y": y, "m": m, "error": result["error"]})
                else:
                    results["seeded"] += 1

    return results


@app.post("/v2/admin/seed-precomputed", tags=["Admin"], dependencies=[Depends(verify_api_key)])
def seed_precomputed(
    location_id: str = Query(...),
    year: int = Query(...),
    month: int = Query(...),
    net_production: float = Query(...),
    collections: float = Query(...),
    gross_production: Optional[float] = Query(None),
    source: str = Query("pdf_manual"),
):
    """
    Seed (or update) the production_by_month table with authoritative values from a PDF report.
    Use this monthly after running the Dentrix Ledger Report Builder.
    Source label is stored for audit: use 'pdf_YYYY_MM' convention.
    Protected rows (pdf_authoritative) can be overwritten with this endpoint.
    """
    import sqlite3 as _sq3, calendar as _cal

    DB_PATH = "/home/openclaw/.openclaw/workspace/ascend_api/middleware/ascend.db"
    db = _sq3.connect(DB_PATH)
    db.row_factory = _sq3.Row

    # Get gross from SQLite if not provided
    if gross_production is None:
        last_day = _cal.monthrange(year, month)[1]
        s, e = f"{year}-{month:02d}-01", f"{year}-{month:02d}-{last_day:02d}"
        row = db.execute(
            "SELECT COALESCE(SUM(amount),0) FROM procedures WHERE location_id=? AND transaction_date>=? AND transaction_date<=? AND is_active=1",
            (location_id, s, e)
        ).fetchone()
        gross_production = float(row[0])

    db.execute(
        "INSERT OR REPLACE INTO production_by_month "
        "(location_id, year, month, gross_production, net_production, collections, last_computed, source) "
        "VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?)",
        (location_id, year, month, round(gross_production, 2), round(net_production, 2), round(collections, 2), source)
    )
    db.commit()

    # Clear cache so next request picks up new values
    from ascend_service import _cache_clear
    _cache_clear()

    result = {
        "location_id": location_id, "year": year, "month": month,
        "gross_production": round(gross_production, 2),
        "net_production": round(net_production, 2),
        "collections": round(collections, 2),
        "source": source,
        "message": "Seeded successfully. Cache cleared.",
    }
    db.close()
    return result

# ===========================================================================
# PLAID PRODUCTION READINESS ENDPOINTS
# Build update mode, user offboarding, item health, transaction cursor
# ===========================================================================

@app.post("/plaid/item/{item_id}/activate", tags=["Plaid"], dependencies=[Depends(verify_api_key)])
async def plaid_activate_item(item_id: str):
    """Promote a pending Plaid item to active so it is included in nightly sync.

    Use after verifying a newly relinked item (allow_duplicate=true) has the
    expected transaction history. Once activated, nightly cron will include it.
    Does not remove or alter any other item.
    """
    all_tokens = load_all_plaid_tokens()
    if item_id not in all_tokens:
        raise HTTPException(404, f"Item {item_id} not found")
    current_status = all_tokens[item_id].get("sync_status", "active")
    all_tokens[item_id]["sync_status"] = "active"
    all_tokens[item_id]["activated_at"] = datetime.now(timezone.utc).isoformat()
    save_plaid_tokens(all_tokens)
    return {
        "success": True,
        "item_id": item_id,
        "institution": all_tokens[item_id].get("institution_name"),
        "previous_status": current_status,
        "sync_status": "active",
    }


@app.post("/plaid/update-mode", tags=["Plaid"], dependencies=[Depends(verify_api_key)])
async def plaid_update_mode(request: Request):
    """
    Build update mode — creates a Link token for re-authentication of an expired item.
    Call when ITEM_LOGIN_REQUIRED webhook fires or item status shows error.
    Frontend opens Plaid Link with this token to let user re-authenticate.
    """
    body = await request.json()
    access_token = body.get("access_token")
    item_id = body.get("item_id")

    # Resolve access token from item_id if not provided
    if not access_token and item_id:
        tokens = load_plaid_tokens()
        if item_id in tokens:
            access_token = tokens[item_id]["access_token"]

    if not access_token:
        raise HTTPException(400, "access_token or item_id required")

    resp = plaid_request("/link/token/create", {
        "user": {"client_user_id": "nudental-admin"},
        "client_name": "NU Dental Dashboard",
        "access_token": access_token,
        "country_codes": ["US"],
        "language": "en",
        "webhook": "https://api.nudashboard.com/plaid/webhook"
    })

    if "link_token" not in resp:
        raise HTTPException(500, f"Failed to create update-mode token: {resp.get('error_message', resp)}")

    return {
        "link_token": resp["link_token"],
        "expiration": resp.get("expiration"),
        "mode": "update",
        "item_id": item_id
    }


@app.delete("/plaid/item/{item_id}", tags=["Plaid"], dependencies=[Depends(verify_api_key)])
async def plaid_remove_item(item_id: str):
    """
    User offboarding — removes a connected Item and deletes its access token.
    Honors user privacy and stops billing for the item.
    """
    tokens = load_plaid_tokens()
    if item_id not in tokens:
        raise HTTPException(404, f"Item {item_id} not found in connected accounts")

    token_data = tokens[item_id]
    access_token = token_data["access_token"]
    institution = token_data.get("institution_name", item_id)

    # Call Plaid to remove the item
    resp = plaid_request("/item/remove", {"access_token": access_token})
    if resp.get("removed") or "request_id" in resp:
        # Remove from local tokens file
        del tokens[item_id]
        save_plaid_tokens(tokens)
        logger.info(f"Plaid item removed: {institution} ({item_id})")
        return {
            "removed": True,
            "institution": institution,
            "item_id": item_id,
            "message": f"{institution} account disconnected and access token revoked."
        }
    else:
        raise HTTPException(500, f"Plaid removal failed: {resp}")


@app.get("/plaid/item/{item_id}/status", tags=["Plaid"], dependencies=[Depends(verify_api_key)])
async def plaid_item_status(item_id: str):
    """
    Check health/status of a specific connected Item.
    Returns error state, last successful update, webhook status.
    """
    tokens = load_plaid_tokens()
    if item_id not in tokens:
        raise HTTPException(404, f"Item {item_id} not found")

    access_token = tokens[item_id]["access_token"]
    resp = plaid_request("/item/get", {"access_token": access_token})

    item = resp.get("item", {})
    status = resp.get("status", {})
    error = item.get("error")

    health = "healthy"
    action_required = False
    if error:
        health = "error"
        action_required = error.get("error_code") in [
            "ITEM_LOGIN_REQUIRED", "INVALID_CREDENTIALS",
            "ITEM_LOCKED", "ITEM_NO_ERROR"
        ]

    return {
        "item_id": item_id,
        "institution": tokens[item_id].get("institution_name"),
        "health": health,
        "action_required": action_required,
        "error": error,
        "webhook": item.get("webhook"),
        "last_transactions_update": (status.get("transactions") or {}).get("last_successful_update"),
        "available_products": item.get("available_products", []),
        "billed_products": item.get("billed_products", []),
        "consent_expiration": item.get("consent_expiration_time")
    }


@app.get("/plaid/health", tags=["Plaid"], dependencies=[Depends(verify_api_key)])
async def plaid_health_check():
    """
    Check health of ALL connected Plaid items at once.
    Returns any items that need re-authentication or have errors.
    Auto-alerts if any item is in error state.
    """
    tokens = load_plaid_tokens()
    if not tokens:
        return {"status": "no_items", "items": []}

    results = []
    needs_action = []

    for item_id, token_data in tokens.items():
        try:
            resp = plaid_request("/item/get", {"access_token": token_data["access_token"]})
            item = resp.get("item", {})
            status = resp.get("status", {})
            error = item.get("error")
            health = "error" if error else "healthy"
            if error:
                needs_action.append({
                    "institution": token_data.get("institution_name"),
                    "item_id": item_id,
                    "error_code": error.get("error_code"),
                    "error_message": error.get("error_message", "")
                })
            results.append({
                "institution": token_data.get("institution_name"),
                "item_id": item_id,
                "health": health,
                "error": error,
                "last_update": (status.get("transactions") or {}).get("last_successful_update"),
                "consent_expiration": item.get("consent_expiration_time")
            })
        except Exception as e:
            results.append({
                "institution": token_data.get("institution_name"),
                "item_id": item_id,
                "health": "unreachable",
                "error": str(e)
            })
            needs_action.append({"institution": token_data.get("institution_name"), "item_id": item_id, "error_code": "UNREACHABLE"})

    return {
        "status": "action_required" if needs_action else "all_healthy",
        "total_items": len(results),
        "healthy": len([r for r in results if r["health"] == "healthy"]),
        "items": results,
        "needs_action": needs_action
    }


@app.get("/plaid/transactions/cursor", tags=["Plaid"], dependencies=[Depends(verify_api_key)])
async def plaid_transactions_cursor(item_id: Optional[str] = Query(None)):
    """
    Optimized transaction sync using cursor-based pagination (transactions/sync).
    More efficient than date-range queries — only fetches new/modified/removed transactions.
    Used for incremental updates after initial historical pull.
    """
    tokens = load_plaid_tokens()
    items_to_sync = {item_id: tokens[item_id]} if item_id and item_id in tokens else tokens

    CURSOR_FILE = "/home/openclaw/.config/plaid/sync_cursors.json"
    import os
    cursors = {}
    if os.path.exists(CURSOR_FILE):
        with open(CURSOR_FILE) as f:
            cursors = json.load(f)

    all_results = []
    for iid, token_data in items_to_sync.items():
        access_token = token_data["access_token"]
        cursor = cursors.get(iid)
        added, modified, removed = [], [], []
        has_more = True

        while has_more:
            payload = {"access_token": access_token, "count": 500}
            if cursor:
                payload["cursor"] = cursor
            resp = plaid_request("/transactions/sync", payload)
            if "error_code" in resp:
                logger.error(f"Cursor sync error for {iid}: {resp}")
                break
            added.extend(resp.get("added", []))
            modified.extend(resp.get("modified", []))
            removed.extend(resp.get("removed", []))
            has_more = resp.get("has_more", False)
            cursor = resp.get("next_cursor", cursor)

        # Persist cursor
        cursors[iid] = cursor
        with open(CURSOR_FILE, "w") as f:
            json.dump(cursors, f, indent=2)

        all_results.append({
            "institution": token_data.get("institution_name"),
            "item_id": iid,
            "added": len(added),
            "modified": len(modified),
            "removed": len(removed),
            "cursor_updated": True
        })

    return {
        "synced_items": len(all_results),
        "results": all_results,
        "total_added": sum(r["added"] for r in all_results),
        "total_modified": sum(r["modified"] for r in all_results),
        "total_removed": sum(r["removed"] for r in all_results)
    }



# =========================================================================
# PHASE 2 — Normalized Metrics Layer
# =========================================================================
# Single canonical endpoint that ALL dashboard tabs read from.
# Correct queries:
#   Production:   no is_active filter on procedures; provider_id IS NOT NULL
#   Adjustments:  PatientCreditAdjustment only (no Rebill double-counting)
#   Collections:  transaction_date; separate insurance vs patient; raw sign preserved
#   Claims:       submission_date; cache table
#   AR Aging:     as-of today; separate patient/insurance buckets
# Date field policy:
#   production   → transaction_date on procedures
#   collections  → transaction_date on payments
#   claims       → sent_date on insurance_claim_cache
#   AR aging     → computed from procedure transaction_date to today

import sqlite3 as _sqlite3
from datetime import date as _date

def _metrics_db():
    conn = _sqlite3.connect(RCM_DB_PATH)
    conn.row_factory = _sqlite3.Row
    return conn

def _loc_filter(location_id: Optional[str], table_alias: str = "") -> tuple:
    """Return (sql_fragment, params) for location filter."""
    col = f"{table_alias}.location_id" if table_alias else "location_id"
    if location_id:
        return f"AND {col} = ?", [location_id]
    return "", []

@app.get("/v2/marketing/amex-spend", tags=["Marketing"])
def marketing_amex_spend(
    startDate: str = None, endDate: str = None,
    month: int = None, year: int = None,
    locationId: str = None,
):
    """
    Marketing spend from AmEx (Plaid-synced expenses table).

    Reads from the `expenses` table — same data that plaid_sync.py writes.
    Filters: source_tab='amex', expense_status='posted', vendor categories
    for Google Ads / Facebook / TNT Dental.

    Vendor matching rules (case-insensitive):
      google_ads  : merchant_name ILIKE any of ['%google ads%','%google%','%GOOGLE%']
      facebook    : merchant_name ILIKE any of ['%facebook%','%facebook ads%','%meta ads%']
      tnt_dental  : merchant_name ILIKE '%tnt dental%'
      credit_adj  : amount < 0 (refunds / credits / adjustments — negative in Plaid convention)

    Sign convention (inherited from plaid_sync.py):
      Charges (vendor_charge) → positive amount → counted as spend
      Refunds / credits       → negative amount → reported separately as credit_adjustments

    Query params:
      startDate / endDate : ISO date strings (YYYY-MM-DD)
      month / year        : shorthand — month=4&year=2026 → Apr 2026
      locationId          : optional — filter to a single office_id UUID

    Returns per-office breakdown + totals.
    """
    try:
        # ── Date range ────────────────────────────────────────────────────────
        if month and year:
            import calendar
            last_day = calendar.monthrange(year, month)[1]
            start = f"{year}-{month:02d}-01"
            end   = f"{year}-{month:02d}-{last_day:02d}"
        elif startDate and endDate:
            start, end = startDate, endDate
        else:
            import datetime
            today = datetime.date.today()
            start = today.replace(day=1).isoformat()
            end   = today.isoformat()

        # ── Pull AmEx posted expenses for date range ──────────────────────────
        # Include both 'posted' AND 'archived' — archived = reviewed/processed, not voided.
        # Do NOT filter by expense_status: 71% of AmEx rows are archived including
        # all TNT Dental and most Google/Facebook charges. Filtering to 'posted' only
        # silently drops the majority of real marketing spend.
        # Only truly voided rows (if a 'voided' status existed) should be excluded.
        base_filter = (
            f"expenses?select=expense_date,amount,merchant_name,office_name,office_id,"
            f"card_last4,cardholder_name,source_reference_id,expense_status"
            f"&source_tab=eq.amex"
            f"&expense_status=in.(posted,archived)"
            f"&expense_date=gte.{start}"
            f"&expense_date=lte.{end}"
            f"&order=expense_date.asc"
        )
        if locationId:
            base_filter += f"&office_id=eq.{locationId}"

        rows = _sb_get(base_filter)

        # ── Vendor classification ─────────────────────────────────────────────
        GOOGLE_PATTERNS   = ("google ads", "google", "google llc")
        FACEBOOK_PATTERNS = ("facebook", "facebook ads", "meta ads", "fb ads")
        TNT_PATTERNS      = ("tnt dental",)

        def classify(name: str):
            n = (name or "").lower().strip()
            if any(p in n for p in TNT_PATTERNS):
                return "tnt_dental"
            if any(p in n for p in GOOGLE_PATTERNS):
                return "google_ads"
            if any(p in n for p in FACEBOOK_PATTERNS):
                return "facebook"
            return "other"

        # ── Aggregate by office ───────────────────────────────────────────────
        from collections import defaultdict
        offices = {}   # office_name → {google, facebook, tnt, credits, txn_count}

        totals = {
            "googleSpend": 0.0,
            "facebookSpend": 0.0,
            "tntDentalSpend": 0.0,
            "creditAdjustments": 0.0,
            "totalMarketingSpend": 0.0,
            "transactionCount": 0,
            "reviewCount": 0,
        }

        for r in rows:
            amt         = float(r.get("amount") or 0)
            office_name = r.get("office_name") or "Unassigned"
            vendor      = classify(r.get("merchant_name", ""))

            if office_name not in offices:
                offices[office_name] = {
                    "officeName":          office_name,
                    "googleSpend":         0.0,
                    "facebookSpend":       0.0,
                    "tntDentalSpend":      0.0,
                    "creditAdjustments":   0.0,
                    "totalMarketingSpend": 0.0,
                    "transactionCount":    0,
                    "reviewCount":         0,
                }

            o = offices[office_name]

            if amt < 0:
                # Negative = refund/credit (Plaid sign convention)
                # Only count credits from marketing vendors
                if vendor in ("google_ads", "facebook", "tnt_dental"):
                    o["creditAdjustments"]   += abs(amt)
                    totals["creditAdjustments"] += abs(amt)
                continue  # credits don't count as spend

            # Positive = vendor charge
            if vendor == "google_ads":
                o["googleSpend"]         += amt
                totals["googleSpend"]    += amt
                o["transactionCount"]    += 1
                totals["transactionCount"] += 1
            elif vendor == "facebook":
                o["facebookSpend"]         += amt
                totals["facebookSpend"]    += amt
                o["transactionCount"]    += 1
                totals["transactionCount"] += 1
            elif vendor == "tnt_dental":
                o["tntDentalSpend"]         += amt
                totals["tntDentalSpend"]    += amt
                o["transactionCount"]    += 1
                totals["transactionCount"] += 1

        # Compute per-office and global totalMarketingSpend
        for o in offices.values():
            o["totalMarketingSpend"] = round(
                o["googleSpend"] + o["facebookSpend"] + o["tntDentalSpend"], 2
            )
            for k in ("googleSpend","facebookSpend","tntDentalSpend","creditAdjustments","totalMarketingSpend"):
                o[k] = round(o[k], 2)

        totals["totalMarketingSpend"] = round(
            totals["googleSpend"] + totals["facebookSpend"] + totals["tntDentalSpend"], 2
        )
        for k in totals:
            if isinstance(totals[k], float):
                totals[k] = round(totals[k], 2)

        # Sort offices: known offices first, then Corp/Unassigned
        OFFICE_ORDER = ["Eatontown","Barnegat","Brick","Staten Island"]
        def office_sort(o):
            name = o["officeName"]
            return (OFFICE_ORDER.index(name) if name in OFFICE_ORDER else 99, name)

        return {
            "period":      {"startDate": start, "endDate": end},
            "offices":     sorted(offices.values(), key=office_sort),
            "totals":      totals,
            "rowsScanned": len(rows),
            "filters": {
                "source_tab":      "amex",
                "expense_status":  "posted",
                "expense_date":    f"{start} to {end}",
                "locationId":      locationId or "all",
            },
            "vendorPatterns": {
                "google_ads":  ["google ads", "google", "google llc"],
                "facebook":    ["facebook", "facebook ads", "meta ads", "fb ads"],
                "tnt_dental":  ["tnt dental"],
            },
            "source": "supabase_expenses",
        }

    except Exception as e:
        import traceback
        return {"error": str(e), "detail": traceback.format_exc()[-500:]}


@app.get("/v2/metrics", tags=["Metrics"], dependencies=[Depends(verify_api_key)])
async def normalized_metrics(
    startDate:     Optional[str] = Query(None),
    endDate:       Optional[str] = Query(None),
    locationId:    Optional[str] = Query(None),
    providerId:    Optional[str] = Query(None),
    paymentSource: Optional[str] = Query(None),   # 'insurance' | 'patient' | 'all'
    claimStatus:   Optional[str] = Query(None),   # 'SENT' | 'PAYRECVD' | 'ACCEPTED' etc.
):
    """
    Phase 2 — ONE normalized metrics snapshot covering all dashboard domains.
    All queries use the corrected algorithm (no PatientCreditAdjustmentRebill,
    no is_active=1 on procedures). Date field usage is clearly annotated.
    """
    today_str  = _date.today().isoformat()
    month_start = _date.today().replace(day=1).isoformat()
    start = startDate or month_start
    end   = endDate   or today_str

    conn = _metrics_db()
    try:
        # ── PRODUCTION (transaction_date) ──────────────────────────────────
        loc_frag, loc_params = _loc_filter(locationId)
        prov_frag  = "AND provider_id = ?" if providerId else ""
        prov_params = [providerId] if providerId else []

        gross_row = conn.execute(
            f"""SELECT COALESCE(SUM(amount), 0) as v FROM procedures
                WHERE transaction_date >= ? AND transaction_date <= ?
                AND provider_id IS NOT NULL
                {loc_frag} {prov_frag}""",
            [start, end] + loc_params + prov_params
        ).fetchone()
        gross_mtd = float(gross_row["v"] or 0)

        # Daily (today only)
        gross_daily_row = conn.execute(
            f"""SELECT COALESCE(SUM(amount), 0) as v FROM procedures
                WHERE date(transaction_date) = ?
                AND provider_id IS NOT NULL
                {loc_frag} {prov_frag}""",
            [today_str] + loc_params + prov_params
        ).fetchone()
        gross_daily = float(gross_daily_row["v"] or 0)

        # ── ADJUSTMENTS — PatientCreditAdjustment only (transaction_date) ──
        adj_row = conn.execute(
            f"""SELECT COALESCE(SUM(amount), 0) as v FROM adjustments
                WHERE transaction_date >= ? AND transaction_date <= ?
                AND is_active = 1 AND ledger_type = 'PatientCreditAdjustment'
                {loc_frag} {prov_frag}""",
            [start, end] + loc_params + prov_params
        ).fetchone()
        adj_mtd = float(adj_row["v"] or 0)

        adj_daily_row = conn.execute(
            f"""SELECT COALESCE(SUM(amount), 0) as v FROM adjustments
                WHERE date(transaction_date) = ?
                AND is_active = 1 AND ledger_type = 'PatientCreditAdjustment'
                {loc_frag} {prov_frag}""",
            [today_str] + loc_params + prov_params
        ).fetchone()
        adj_daily = float(adj_daily_row["v"] or 0)

        net_mtd   = gross_mtd + adj_mtd
        net_daily = gross_daily + adj_daily

        # ── COLLECTIONS (transaction_date) ─────────────────────────────────
        ins_coll_row = conn.execute(
            f"""SELECT COALESCE(SUM(amount), 0) as v FROM insurance_payments
                WHERE transaction_date >= ? AND transaction_date <= ?
                AND is_active = 1 {loc_frag}""",
            [start, end] + loc_params
        ).fetchone()
        ins_coll_mtd = abs(float(ins_coll_row["v"] or 0))

        pat_coll_row = conn.execute(
            f"""SELECT COALESCE(SUM(amount), 0) as v FROM patient_payments
                WHERE transaction_date >= ? AND transaction_date <= ?
                AND is_active = 1 {loc_frag}""",
            [start, end] + loc_params
        ).fetchone()
        pat_coll_mtd = abs(float(pat_coll_row["v"] or 0))

        # Daily collections
        ins_daily_row = conn.execute(
            f"""SELECT COALESCE(SUM(amount), 0) as v FROM insurance_payments
                WHERE date(transaction_date) = ? AND is_active = 1 {loc_frag}""",
            [today_str] + loc_params
        ).fetchone()
        ins_coll_daily = abs(float(ins_daily_row["v"] or 0))

        pat_daily_row = conn.execute(
            f"""SELECT COALESCE(SUM(amount), 0) as v FROM patient_payments
                WHERE date(transaction_date) = ? AND is_active = 1 {loc_frag}""",
            [today_str] + loc_params
        ).fetchone()
        pat_coll_daily = abs(float(pat_daily_row["v"] or 0))

        total_coll_mtd   = ins_coll_mtd + pat_coll_mtd
        total_coll_daily = ins_coll_daily + pat_coll_daily

        # Payment source breakdown (carrier-level)
        src_rows = conn.execute(
            f"""SELECT
                  json_extract(raw,'$.patientPaymentBilling.referenceNumber') as ref,
                  COALESCE(SUM(ABS(amount)), 0) as total,
                  COUNT(*) as cnt
               FROM patient_payments
               WHERE transaction_date >= ? AND transaction_date <= ?
               AND is_active = 1 {loc_frag}
               GROUP BY ref
               ORDER BY total DESC LIMIT 20""",
            [start, end] + loc_params
        ).fetchall()
        payment_source_breakdown = [
            {"source": r["ref"] or "Unknown", "amount": round(float(r["total"]), 2), "count": r["cnt"]}
            for r in src_rows
        ]

        # ── COLLECTION RATIO ───────────────────────────────────────────────
        collection_ratio = round(total_coll_mtd / gross_mtd * 100, 1) if gross_mtd else 0.0

        # ── CLAIMS (sent_date from claim cache) ────────────────────────────
        claim_where = ""
        claim_params: list = []
        if claimStatus:
            claim_where = "WHERE claim_state = ?"
            claim_params = [claimStatus]

        claim_rows = conn.execute(
            f"SELECT claim_state, COUNT(*) as cnt, SUM(total_charges) as total_charges FROM insurance_claim_cache {claim_where} GROUP BY claim_state",
            claim_params
        ).fetchall()

        claims_by_state = {r["claim_state"]: {"count": r["cnt"], "amount": round(float(r["total_charges"] or 0), 2)} for r in claim_rows}
        total_claims    = sum(v["count"] for v in claims_by_state.values())
        pending_claims  = (claims_by_state.get("SENT", {}).get("count", 0) +
                           claims_by_state.get("ACCEPTED", {}).get("count", 0) +
                           claims_by_state.get("PRINTED", {}).get("count", 0))

        # Claims submitted in date range (by sent_date)
        submitted_row = conn.execute(
            "SELECT COUNT(*) as cnt, COALESCE(SUM(total_charges),0) as amt FROM insurance_claim_cache WHERE sent_date >= ? AND sent_date <= ?",
            [start, end]
        ).fetchone()
        claims_submitted_period = submitted_row["cnt"]
        claims_submitted_amt    = float(submitted_row["amt"] or 0)

        # Within 24h (sent_date same day or next day of service_date)
        within_24h_row = conn.execute(
            "SELECT COUNT(*) as cnt FROM insurance_claim_cache WHERE sent_date >= ? AND sent_date <= ? AND julianday(sent_date) - julianday(service_date) <= 1",
            [start, end]
        ).fetchone()
        claims_within_24h = within_24h_row["cnt"]

        # ── AR AGING (as-of today; charge date = transaction_date) ────────
        today_obj = _date.today()
        aging_sql = f"""
            WITH charges AS (
                SELECT p.patient_id, p.location_id,
                       SUM(p.amount) as charges,
                       MIN(p.transaction_date) as first_charge_date
                FROM procedures p
                WHERE p.is_active = 1 {loc_frag}
                GROUP BY p.patient_id, p.location_id
            ),
            patient_paid AS (
                SELECT pp.patient_id, pp.location_id, SUM(ABS(pp.amount)) as paid
                FROM patient_payments pp WHERE pp.is_active=1 {loc_frag}
                GROUP BY pp.patient_id, pp.location_id
            ),
            ins_paid AS (
                SELECT ip.patient_id, ip.location_id, SUM(ABS(ip.amount)) as paid
                FROM insurance_payments ip WHERE ip.is_active=1 {loc_frag}
                GROUP BY ip.patient_id, ip.location_id
            ),
            adj AS (
                SELECT a.patient_id, a.location_id,
                       SUM(CASE WHEN a.amount<0 THEN ABS(a.amount) ELSE 0 END) as adj
                FROM adjustments a WHERE a.is_active=1 {loc_frag}
                GROUP BY a.patient_id, a.location_id
            ),
            combined AS (
                SELECT c.patient_id, c.location_id,
                       c.charges - COALESCE(pp.paid,0) - COALESCE(ip.paid,0) - COALESCE(adj.adj,0) as balance,
                       c.first_charge_date
                FROM charges c
                LEFT JOIN patient_paid pp ON c.patient_id=pp.patient_id AND c.location_id=pp.location_id
                LEFT JOIN ins_paid ip     ON c.patient_id=ip.patient_id AND c.location_id=ip.location_id
                LEFT JOIN adj            ON c.patient_id=adj.patient_id AND c.location_id=adj.location_id
            )
            SELECT
                COUNT(CASE WHEN balance > 0.5 THEN 1 END) as patients_with_balance,
                COUNT(CASE WHEN balance < -0.5 THEN 1 END) as patients_with_credit,
                COALESCE(SUM(CASE WHEN balance>0.5 AND julianday(?)-julianday(first_charge_date) <= 29 THEN balance END), 0) as b0_30,
                COALESCE(SUM(CASE WHEN balance>0.5 AND julianday(?)-julianday(first_charge_date) BETWEEN 30 AND 59 THEN balance END), 0) as b30_60,
                COALESCE(SUM(CASE WHEN balance>0.5 AND julianday(?)-julianday(first_charge_date) BETWEEN 60 AND 89 THEN balance END), 0) as b60_90,
                COALESCE(SUM(CASE WHEN balance>0.5 AND julianday(?)-julianday(first_charge_date) >= 90 THEN balance END), 0) as b90plus,
                COALESCE(SUM(CASE WHEN balance > 0.5 THEN balance END), 0) as total_ar
            FROM combined
        """
        aging_params_inner = loc_params * 4   # 4 occurrences of loc_frag in aging_sql
        aging_params_outer = [today_str, today_str, today_str, today_str]
        aging_row = conn.execute(aging_sql, aging_params_inner + aging_params_outer).fetchone()

        ar = {
            "total":              round(float(aging_row["total_ar"] or 0), 2),
            "patients_balance":   int(aging_row["patients_with_balance"] or 0),
            "patients_credit":    int(aging_row["patients_with_credit"] or 0),
            "buckets": {
                "current_0_30":   round(float(aging_row["b0_30"] or 0), 2),
                "b30_60":         round(float(aging_row["b30_60"] or 0), 2),
                "b60_90":         round(float(aging_row["b60_90"] or 0), 2),
                "b90_plus":       round(float(aging_row["b90plus"] or 0), 2),
            }
        }

        return {
            "period":   {"start": start, "end": end},
            "filters":  {"locationId": locationId, "providerId": providerId},
            "production": {
                "gross_daily":   round(gross_daily, 2),
                "gross_mtd":     round(gross_mtd, 2),
                "adj_daily":     round(adj_daily, 2),
                "adj_mtd":       round(adj_mtd, 2),
                "net_daily":     round(net_daily, 2),
                "net_mtd":       round(net_mtd, 2),
                "date_field":    "transaction_date",
            },
            "collections": {
                "insurance_daily":      round(ins_coll_daily, 2),
                "insurance_mtd":        round(ins_coll_mtd, 2),
                "patient_daily":        round(pat_coll_daily, 2),
                "patient_mtd":          round(pat_coll_mtd, 2),
                "total_daily":          round(total_coll_daily, 2),
                "total_mtd":            round(total_coll_mtd, 2),
                "collection_ratio_pct": collection_ratio,
                "payment_source_breakdown": payment_source_breakdown,
                "date_field":           "transaction_date",
            },
            "claims": {
                "total":              total_claims,
                "pending":            pending_claims,
                "submitted_period":   claims_submitted_period,
                "submitted_amount":   round(claims_submitted_amt, 2),
                "within_24h":         claims_within_24h,
                "by_state":           claims_by_state,
                "date_field":         "sent_date",
            },
            "ar_aging":             ar,
            "_computed_at":         datetime.now(timezone.utc).isoformat(),
            "_algorithm":           "v3-corrected (no Rebill double-count, no is_active on procedures)",
        }

    finally:
        conn.close()


# =========================================================================
# PHASE 7 — Admin Diagnostics Endpoint
# =========================================================================

@app.get("/v2/admin/diagnostics", tags=["Admin"], dependencies=[Depends(verify_api_key)])
async def admin_diagnostics(
    locationId: Optional[str] = Query(None),
    date:       Optional[str] = Query(None),
):
    """
    Phase 7 — Per-endpoint diagnostic report.
    For each data domain, shows:
      - source endpoint / SQLite table
      - date field used
      - raw value (from DB with correct query)
      - raw value with legacy buggy query
      - delta / mismatch flag
      - last sync timestamp
    """
    check_date = date or _date.today().isoformat()
    month_start = check_date[:7] + "-01"
    conn = _metrics_db()

    lf, lp = _loc_filter(locationId)

    def q(sql, params): return conn.execute(sql, params).fetchone()

    try:
        # ── Procedures ──────────────────────────────────────────────────
        gross_correct = float(q(
            f"SELECT COALESCE(SUM(amount),0) as v FROM procedures WHERE date(transaction_date)=? AND provider_id IS NOT NULL {lf}",
            [check_date] + lp
        )["v"] or 0)
        gross_bug = float(q(
            f"SELECT COALESCE(SUM(amount),0) as v FROM procedures WHERE date(transaction_date)=? AND is_active=1 {lf}",
            [check_date] + lp
        )["v"] or 0)

        # ── Adjustments ─────────────────────────────────────────────────
        adj_correct = float(q(
            f"SELECT COALESCE(SUM(amount),0) as v FROM adjustments WHERE date(transaction_date)=? AND is_active=1 AND ledger_type='PatientCreditAdjustment' {lf}",
            [check_date] + lp
        )["v"] or 0)
        adj_bug = float(q(
            f"SELECT COALESCE(SUM(amount),0) as v FROM adjustments WHERE date(transaction_date)=? AND is_active=1 {lf}",
            [check_date] + lp
        )["v"] or 0)
        adj_rebill = float(q(
            f"SELECT COALESCE(SUM(amount),0) as v FROM adjustments WHERE date(transaction_date)=? AND is_active=1 AND ledger_type='PatientCreditAdjustmentRebill' {lf}",
            [check_date] + lp
        )["v"] or 0)

        # ── Collections ─────────────────────────────────────────────────
        ins_coll = abs(float(q(
            f"SELECT COALESCE(SUM(amount),0) as v FROM insurance_payments WHERE date(transaction_date)=? AND is_active=1 {lf}",
            [check_date] + lp
        )["v"] or 0))
        pat_coll = abs(float(q(
            f"SELECT COALESCE(SUM(amount),0) as v FROM patient_payments WHERE date(transaction_date)=? AND is_active=1 {lf}",
            [check_date] + lp
        )["v"] or 0))

        # ── Claims ──────────────────────────────────────────────────────
        claim_summary = conn.execute(
            "SELECT claim_state, COUNT(*) as cnt FROM insurance_claim_cache GROUP BY claim_state"
        ).fetchall()

        # ── Sync state ──────────────────────────────────────────────────
        sync_rows = conn.execute("SELECT * FROM sync_state LIMIT 10").fetchall()
        sync_info = [dict(r) for r in sync_rows]

        # ── Table row counts ────────────────────────────────────────────
        tables = ["procedures", "adjustments", "insurance_payments", "patient_payments",
                  "appointments", "patients", "providers", "distribution_lines", "insurance_claim_cache"]
        table_counts = {}
        for t in tables:
            try:
                c = conn.execute(f"SELECT COUNT(*) as n FROM {t}").fetchone()["n"]
                table_counts[t] = c
            except Exception:
                table_counts[t] = -1

        result = {
            "check_date":  check_date,
            "location_id": locationId or "all",
            "endpoints": {
                "production": {
                    "source_table":     "procedures",
                    "date_field":       "transaction_date",
                    "query_v3_correct": {
                        "filter": "provider_id IS NOT NULL (no is_active filter)",
                        "gross": round(gross_correct, 2),
                    },
                    "query_legacy_bug": {
                        "filter": "is_active = 1",
                        "gross": round(gross_bug, 2),
                    },
                    "delta":            round(gross_correct - gross_bug, 2),
                    "mismatch":         abs(gross_correct - gross_bug) > 0.01,
                },
                "adjustments": {
                    "source_table":     "adjustments",
                    "date_field":       "transaction_date",
                    "query_v3_correct": {
                        "filter":  "ledger_type = 'PatientCreditAdjustment'",
                        "adj_total": round(adj_correct, 2),
                    },
                    "query_legacy_bug": {
                        "filter":  "is_active = 1 (ALL ledger types including Rebill)",
                        "adj_total": round(adj_bug, 2),
                    },
                    "rebill_amount":    round(adj_rebill, 2),
                    "delta":            round(adj_correct - adj_bug, 2),
                    "mismatch":         abs(adj_correct - adj_bug) > 0.01,
                },
                "collections": {
                    "source_tables":    ["insurance_payments", "patient_payments"],
                    "date_field":       "transaction_date",
                    "insurance":        round(ins_coll, 2),
                    "patient":          round(pat_coll, 2),
                    "total":            round(ins_coll + pat_coll, 2),
                    "note":             "Amounts stored as negative; shown as positive here",
                },
                "claims": {
                    "source_table":     "insurance_claim_cache",
                    "date_field":       "sent_date",
                    "by_state":         {r["claim_state"]: r["cnt"] for r in claim_summary},
                },
                "ar_aging": {
                    "source_tables":    ["procedures", "patient_payments", "insurance_payments", "adjustments"],
                    "date_field":       "as-of-today from first procedure date",
                    "note":             "AR aging computed live from distribution_lines; no dedicated balances table",
                },
            },
            "sync_state":   sync_info,
            "table_counts": table_counts,
            "_generated_at": datetime.now(timezone.utc).isoformat(),
        }
        return result
    finally:
        conn.close()


# =========================================================================
# Data Freshness Endpoint
# =========================================================================

@app.get("/v2/admin/data-freshness", tags=["Admin"], dependencies=[Depends(verify_api_key)])
async def data_freshness():
    """Reports last sync timestamp and staleness for each data domain."""
    conn = _metrics_db()
    try:
        sync_rows = conn.execute("SELECT * FROM sync_state").fetchall()
        sync_data = [dict(r) for r in sync_rows]

        # Latest record per table
        freshness = {}
        for table, date_col in [
            ("procedures",        "transaction_date"),
            ("adjustments",       "transaction_date"),
            ("insurance_payments","transaction_date"),
            ("patient_payments",  "transaction_date"),
            ("appointments",      "start_time"),
        ]:
            try:
                row = conn.execute(f"SELECT MAX({date_col}) as latest, COUNT(*) as total FROM {table}").fetchone()
                freshness[table] = {
                    "latest_record": row["latest"],
                    "total_rows": row["total"],
                    "date_field": date_col,
                }
            except Exception as ex:
                freshness[table] = {"error": str(ex)}

        production_pbm = conn.execute(
            "SELECT location_id, year, month, source, last_computed as last_updated FROM production_by_month ORDER BY year DESC, month DESC LIMIT 20"
        ).fetchall()

        return {
            "sync_state": sync_data,
            "table_freshness": freshness,
            "production_by_month": [dict(r) for r in production_pbm],
            "_generated_at": datetime.now(timezone.utc).isoformat(),
        }
    finally:
        conn.close()


# =========================================================================
# Benchmark Reconciliation Endpoint (Phase 5 / Reports)
# =========================================================================

@app.get("/v2/admin/benchmark", tags=["Admin"], dependencies=[Depends(verify_api_key)])
async def benchmark_reconciliation(
    startDate: Optional[str] = Query(None),
    endDate:   Optional[str] = Query(None),
):
    """
    Compare benchmark_eassist_daily_reports_2026 (Supabase) against
    Ascend daily_entries (Supabase) for the same dates/offices.
    Returns per-row match/delta for production and collections.
    """
    import requests as _req
    try:
        with open("/home/openclaw/.config/supabase/nudental.json") as f:
            cfg = json.load(f)
        sb_url, sb_key = cfg["project_url"], cfg["secret_key"]
    except Exception:
        raise HTTPException(status_code=500, detail="Supabase config not found")

    hdrs = {"apikey": sb_key, "Authorization": f"Bearer {sb_key}"}
    s = startDate or "2026-02-18"
    e = endDate   or "2026-04-22"

    # Fetch benchmark
    bench_resp = _req.get(
        f"{sb_url}/rest/v1/benchmark_eassist_daily_reports_2026?select=*&report_date=gte.{s}&report_date=lte.{e}&limit=200",
        headers=hdrs, timeout=15
    )
    if bench_resp.status_code != 200:
        raise HTTPException(status_code=502, detail=f"Supabase benchmark fetch failed: {bench_resp.text[:200]}")
    bench_rows = bench_resp.json()

    OFFICE_UUID = {
        "Eatontown": "220372a5-afae-49c9-8a0c-f4c0717ff352",
        "Barnegat":  "1c719b5b-fd77-4da8-a1b9-2209f1cea63e",
        "Brick":     "54626997-57c2-4934-8743-1dabb4d176f4",
    }

    results, matched_prod, matched_coll, total = [], 0, 0, 0

    for b in bench_rows:
        office = b.get("office_name", "")
        date_  = b.get("report_date", "")
        uuid   = OFFICE_UUID.get(office)
        if not uuid or not date_:
            continue

        de_resp = _req.get(
            f"{sb_url}/rest/v1/daily_entries?office_id=eq.{uuid}&entry_date=eq.{date_}&select=production,collection",
            headers=hdrs, timeout=10
        )
        de_rows = de_resp.json() if de_resp.status_code == 200 else []
        actual_prod = sum(float(r.get("production") or 0) for r in de_rows)
        actual_coll = sum(float(r.get("collection") or 0) for r in de_rows)

        bench_prod = float(b.get("daily_production") or 0)
        bench_coll = float(b.get("daily_total_coll") or 0)
        prod_diff  = round(abs(actual_prod - bench_prod), 2)
        coll_diff  = round(abs(actual_coll - bench_coll), 2)

        total += 1
        if prod_diff <= 10: matched_prod += 1
        if coll_diff <= 10: matched_coll += 1

        results.append({
            "office": office, "date": date_,
            "bench_prod": bench_prod, "actual_prod": round(actual_prod, 2), "prod_diff": prod_diff,
            "bench_coll": bench_coll, "actual_coll": round(actual_coll, 2), "coll_diff": coll_diff,
            "prod_match": prod_diff <= 10,
            "coll_match": coll_diff <= 10,
        })

    return {
        "summary": {
            "total_rows": total,
            "prod_match_rate_pct": round(matched_prod / total * 100, 1) if total else 0,
            "coll_match_rate_pct": round(matched_coll / total * 100, 1) if total else 0,
            "period": {"start": s, "end": e},
        },
        "rows": results,
    }


# =========================================================================
# eAssist Daily Report (Email Ingestion) — Phase 1 Backend Endpoints
# =========================================================================

@app.get("/v2/eassist/daily", tags=["eAssist"], dependencies=[Depends(verify_api_key)])
def eassist_daily_reports(
    reportDate: Optional[str] = Query(None, description="Exact report date (YYYY-MM-DD)"),
    startDate: Optional[str] = Query(None, description="Start date (YYYY-MM-DD)"),
    endDate:   Optional[str] = Query(None, description="End date (YYYY-MM-DD)"),
    office: Optional[str] = Query(None, description="Office canonical (Barnegat/Brick/Eatontown/Staten Island)"),
    officeId: Optional[str] = Query(None, description="Dentrix Ascend office_id if mapped"),
    locationId: Optional[str] = Query(None, description="Supabase office UUID if mapped"),
    parseStatus: Optional[str] = Query(None, description="parser_status filter"),
    validationStatus: Optional[str] = Query(None, description="validation_status filter"),
    page: int = Query(1, ge=1),
    pageSize: int = Query(50, ge=1, le=500),
):
    """Return ingested eAssist Daily Report rows from Supabase."""
    import requests
    try:
        with open("/home/openclaw/.config/supabase/nudental.json") as f:
            cfg = json.load(f)
        sb_url, sb_key = cfg["project_url"], cfg["secret_key"]
    except Exception:
        raise HTTPException(status_code=500, detail="Supabase config not found")

    hdrs = {
        "apikey": sb_key,
        "Authorization": f"Bearer {sb_key}",
        "Prefer": "count=exact",
    }

    filters = []
    if reportDate:
        filters.append(f"report_date=eq.{reportDate}")
    if startDate:
        filters.append(f"report_date=gte.{startDate}")
    if endDate:
        filters.append(f"report_date=lte.{endDate}")
    if office:
        filters.append(f"office_canonical=eq.{office}")
    if officeId:
        filters.append(f"office_id=eq.{officeId}")
    if locationId:
        filters.append(f"location_id=eq.{locationId}")
    if parseStatus:
        filters.append(f"parser_status=eq.{parseStatus}")
    if validationStatus:
        filters.append(f"validation_status=eq.{validationStatus}")

    offset = (page - 1) * pageSize

    # Select all fields (frontend will filter later)
    params = [
        "select=*",
        "order=report_date.desc,office_canonical.asc",
        f"limit={pageSize}",
        f"offset={offset}",
    ] + filters

    url = f"{sb_url}/rest/v1/eassist_daily_reports?" + "&".join(params)
    resp = requests.get(url, headers=hdrs, timeout=20)
    if resp.status_code not in (200, 206):
        raise HTTPException(status_code=502, detail=f"Supabase fetch failed: {resp.text[:200]}")

    rows = resp.json()

    # Total count from Content-Range header if present
    total = None
    cr = resp.headers.get("content-range") or resp.headers.get("Content-Range")
    if cr and "/" in cr:
        try:
            total = int(cr.split("/")[-1])
        except Exception:
            total = None

    # Summaries use the same filters across the full range, not the visible page.
    import math
    summary = {"returned": len(rows), "total": total, "success_count": 0,
               "partial_count": 0, "missing_count": 0,
               "latest_report_date": None, "avg_confidence": None}
    confidence_sum = 0.0
    confidence_count = 0
    summary_offset = 0
    while total is None or summary_offset < total:
        summary_params = [
            "select=parser_status,parser_confidence,report_date",
            "order=report_date.desc,office_canonical.asc",
            "limit=500", f"offset={summary_offset}",
        ] + filters
        summary_resp = requests.get(
            f"{sb_url}/rest/v1/eassist_daily_reports?" + "&".join(summary_params),
            headers=hdrs, timeout=20,
        )
        if summary_resp.status_code not in (200, 206):
            raise HTTPException(status_code=502, detail="eAssist summary fetch failed")
        batch = summary_resp.json()
        if not isinstance(batch, list):
            raise HTTPException(status_code=502, detail="Invalid eAssist summary response")
        for item in batch:
            status = (item.get("parser_status") or "").lower()
            if status in ("success", "partial", "missing"):
                summary[status + "_count"] += 1
            report_date = item.get("report_date")
            if isinstance(report_date, str) and report_date:
                summary["latest_report_date"] = max(summary["latest_report_date"] or report_date, report_date)
            try:
                confidence = float(item.get("parser_confidence"))
            except (TypeError, ValueError):
                continue
            if math.isfinite(confidence):
                confidence_sum += confidence
                confidence_count += 1
        summary_offset += len(batch)
        if len(batch) < 500:
            break
    if confidence_count:
        summary["avg_confidence"] = confidence_sum / confidence_count

    return {
        "data": rows,
        "summary": summary,
        "pagination": {
            "page": page,
            "pageSize": pageSize,
            "total": total,
        },
        "metadata": {
            "filters": {
                "reportDate": reportDate,
                "startDate": startDate,
                "endDate": endDate,
                "office": office,
                "officeId": officeId,
                "locationId": locationId,
                "parseStatus": parseStatus,
                "validationStatus": validationStatus,
            },
        },
        "_source": "eassist_email_report",
    }


@app.get("/v2/eassist/ingest/status", tags=["eAssist"], dependencies=[Depends(verify_api_key)])
def eassist_ingest_status():
    """Return ingestion health/coverage summary for the eAssist pipeline."""
    import requests
    from datetime import date as _date, timedelta as _td

    try:
        with open("/home/openclaw/.config/supabase/nudental.json") as f:
            cfg = json.load(f)
        sb_url, sb_key = cfg["project_url"], cfg["secret_key"]
    except Exception:
        raise HTTPException(status_code=500, detail="Supabase config not found")

    hdrs = {
        "apikey": sb_key,
        "Authorization": f"Bearer {sb_key}",
        "Prefer": "count=exact",
    }

    # Latest ingest runs
    run_resp = requests.get(
        f"{sb_url}/rest/v1/eassist_ingest_log?select=*&order=run_started_at.desc&limit=5",
        headers=hdrs,
        timeout=15,
    )
    latest_runs = run_resp.json() if run_resp.status_code in (200, 206) else []

    # Staging count
    stg_resp = requests.get(
        f"{sb_url}/rest/v1/eassist_daily_reports_staging?select=id&limit=1",
        headers=hdrs,
        timeout=10,
    )
    stg_total = None
    cr = stg_resp.headers.get("content-range") or stg_resp.headers.get("Content-Range")
    if cr and "/" in cr:
        try:
            stg_total = int(cr.split("/")[-1])
        except Exception:
            stg_total = None

    # Conflict count in staging
    conf_resp = requests.get(
        f"{sb_url}/rest/v1/eassist_daily_reports_staging?duplicate_status=eq.conflict&select=id&limit=1",
        headers=hdrs,
        timeout=10,
    )
    conf_total = None
    cr2 = conf_resp.headers.get("content-range") or conf_resp.headers.get("Content-Range")
    if cr2 and "/" in cr2:
        try:
            conf_total = int(cr2.split("/")[-1])
        except Exception:
            conf_total = None

    # Determine last business day
    target = _date.today() - _td(days=1)
    while target.weekday() >= 5:
        target -= _td(days=1)

    # Missing placeholders for last business day
    miss_resp = requests.get(
        f"{sb_url}/rest/v1/eassist_daily_reports?report_date=eq.{target.isoformat()}&parser_status=eq.missing&select=office_canonical,report_date,parser_status",
        headers=hdrs,
        timeout=10,
    )
    missing_rows = miss_resp.json() if miss_resp.status_code in (200, 206) else []

    # Latest reports (recent 100) and compute per office latest
    recent_resp = requests.get(
        f"{sb_url}/rest/v1/eassist_daily_reports?select=office_canonical,report_date,parser_status,parser_confidence,email_received_at&order=report_date.desc&limit=100",
        headers=hdrs,
        timeout=15,
    )
    recent = recent_resp.json() if recent_resp.status_code in (200, 206) else []
    latest_by_office = {}
    for r in recent:
        o = r.get("office_canonical")
        if not o or o in latest_by_office:
            continue
        latest_by_office[o] = r

    return {
        "latestRuns": latest_runs,
        "coverage": {
            "lastBusinessDay": target.isoformat(),
            "missingReports": missing_rows,
            "missingCount": len(missing_rows),
            "expectedOffices": ["Barnegat", "Brick", "Eatontown"],
        },
        "staging": {
            "stagedCount": stg_total,
            "conflictCount": conf_total,
        },
        "latestReportByOffice": latest_by_office,
        "_source": "eassist_email_report",
    }

# ── RCM: True Daily Comparison (Dentrix-backed) ───────────────────────────────
# Phase 1 backend endpoint — 2026-05-11
# Source: Dentrix Ascend SQLite only. No Supabase daily_entries, no manual data,
# no eAssist email data, no monthly_executive_analytics.
# Date basis: production=entry_date, adjustments=transaction_date,
#   collections=distribution_lines.transaction_date, appointments=start_time,
#   claims=sentDate, refunds=transaction_date
# PHI allowed inside authorized dashboard.

@app.get("/v2/rcm/daily-comparison", tags=["RCM"], dependencies=[Depends(verify_api_key)])
def rcm_daily_comparison(
    date:            Optional[str] = Query(None, description="Selected day (YYYY-MM-DD), default today"),
    startDate:       Optional[str] = Query(None, description="Explicit range start for monthly/year modes"),
    endDate:         Optional[str] = Query(None, description="Explicit range end for monthly/year modes"),
    officeId:        Optional[str] = Query(None, description="Dashboard UUID"),
    locationId:      Optional[str] = Query(None, description="Dentrix numeric location ID"),
    providerId:      Optional[str] = Query(None, description="Provider filter"),
    comparisonMode:  Optional[str] = Query("daily", description="daily|mtd|monthly_yoy|yearly_yoy"),
    comparisonYears: int           = Query(3, description="Years for YOY, default 3, max 5"),
    metrics:         Optional[str] = Query(None, description="Comma-separated metric list, default all"),
    page:            int           = Query(1),
    pageSize:        int           = Query(500),
):
    """
    True Dentrix/API-backed Daily Comparison endpoint.
    Replaces manual daily_entries-based Daily Comparison tab.

    Sources:
    - Production: procedures (entry_date)
    - Adjustments/Write-offs: adjustments (transaction_date)
    - Collections: distribution_lines (transaction_date) + unlinked patient_payments (entry_date)
    - Appointments: appointments (start_time)
    - New patients: first-appointment proxy
    - Claims submitted: insurance_claims (sentDate)
    - POS collections: patient_payments (paidAtVisit=true)
    - Refunds: adjustments (OLT-classified refund types, transaction_date)
    - Patient portion remaining due: null (not safely daily-aggregatable without
      per-procedure guarantor reconciliation — see source_notes)

    No Supabase daily_entries. No eAssist. No manual fallback.
    """
    import sqlite3 as _sq3
    import re as _re
    from datetime import date as _date, datetime as _dt, timedelta as _td, timezone as _tz

    today = _date.today()
    today_str = today.isoformat()
    now_iso = _dt.now(_tz.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    # ── Validate comparisonMode ───────────────────────────────────────────
    VALID_MODES = ("daily", "mtd", "monthly_yoy", "yearly_yoy")
    if comparisonMode not in VALID_MODES:
        raise HTTPException(status_code=400,
            detail=f"Invalid comparisonMode '{comparisonMode}'. Valid: {', '.join(VALID_MODES)}")
    comparisonYears = max(1, min(comparisonYears, 5))

    # ── Resolve selected_date ─────────────────────────────────────────────
    selected_date = date or today_str
    try:
        sel_dt = _date.fromisoformat(selected_date)
    except ValueError:
        raise HTTPException(status_code=400, detail=f"Invalid date format: {selected_date}")

    # ── Resolve location ──────────────────────────────────────────────────
    _VALID_LOCS = {"14000000000432", "14000000000433", "14000000000434", "14000000000435"}
    loc_id = None
    if locationId:
        if _UUID_RE.match(locationId):
            raise HTTPException(status_code=400,
                detail="locationId must be a Dentrix numeric ID (e.g. 14000000000433), not a UUID. Use officeId for UUIDs.")
        if locationId not in _VALID_LOCS:
            raise HTTPException(status_code=400, detail=f"Unknown locationId: {locationId}")
        loc_id = locationId
    elif officeId:
        loc_id = OFFICE_TO_LOCATION.get(officeId)
        if not loc_id:
            raise HTTPException(status_code=400,
                detail=f"Unknown officeId: {officeId}. Valid: {list(OFFICE_TO_LOCATION.keys())}")

    # ── Metrics filter ────────────────────────────────────────────────────
    requested_metrics = None
    if metrics:
        requested_metrics = set(m.strip() for m in metrics.split(",") if m.strip())

    # ── DB connection ─────────────────────────────────────────────────────
    conn = _sq3.connect(RCM_DB_PATH, timeout=15)
    conn.row_factory = _sq3.Row

    try:
        # ══════════════════════════════════════════════════════════════════
        # HELPER: fetch_day_metrics(start, end, loc, prov) → dict
        # Single SQL-aggregation pass for a date range.
        # Reuses AscendService logic inline for consistency.
        # ══════════════════════════════════════════════════════════════════

        def _fetch_metrics(start: str, end: str, loc: str = None, prov: str = None) -> dict:
            """
            Fetch all daily-comparison metrics for a date range.
            Returns a dict of metric_name → value (or None if unavailable).
            All SQL uses the same date-basis rules as the verified production/collections endpoints.
            """
            _r = lambda v: round(v, 2) if v is not None else None
            end_dt = _date.fromisoformat(end)
            end_excl = (end_dt + _td(days=1)).isoformat()
            VALID_LOCS_TUPLE = ("14000000000433", "14000000000434", "14000000000435", "14000000000432")

            # Helper to build location filter
            def _loc_clause(col, loc_val):
                if loc_val:
                    return f" AND {col} = ?", [loc_val]
                else:
                    ph = ",".join("?" * len(VALID_LOCS_TUPLE))
                    return f" AND {col} IN ({ph})", list(VALID_LOCS_TUPLE)

            def _prov_clause(col, prov_val):
                if prov_val:
                    return f" AND {col} = ?", [prov_val]
                return "", []

            # ── PRODUCTION (entry_date, fallback to transaction_date for pre-2026 data) ──
            # entry_date is only populated from 2026 onward. For historical data
            # (2022–2025), fall back to transaction_date to avoid $0 production.
            # COALESCE(entry_date, transaction_date || 'T00') normalizes both to
            # the same sortable format (entry_date is ISO timestamp, transaction_date
            # is date-only). The < end_excl comparison works for both.
            loc_sql, loc_p = _loc_clause("location_id", loc)
            prov_sql, prov_p = _prov_clause("provider_id", prov)
            _prod_date_expr = "COALESCE(entry_date, transaction_date || 'T00')"
            prod_rows = conn.execute(
                f"""SELECT COALESCE(SUM(amount), 0) AS gross, COUNT(*) AS cnt,
                           SUM(CASE WHEN entry_date IS NULL OR entry_date = '' THEN 1 ELSE 0 END) AS fallback_count
                    FROM procedures
                    WHERE {_prod_date_expr} >= ? AND {_prod_date_expr} < ?
                      AND is_active = 1
                      AND ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')
                      {loc_sql} {prov_sql}""",
                [start, end_excl] + loc_p + prov_p
            ).fetchone()
            gross_prod = float(prod_rows["gross"]) if prod_rows else 0.0
            procedure_count = int(prod_rows["cnt"]) if prod_rows else 0
            _prod_fallback_count = int(prod_rows["fallback_count"] or 0) if prod_rows else 0

            # ── ADJUSTMENTS (transaction_date) ────────────────────────────
            adj_rows = conn.execute(
                f"""SELECT COALESCE(SUM(amount), 0) AS total
                    FROM adjustments
                    WHERE transaction_date >= ? AND transaction_date <= ?
                      AND is_active = 1
                      AND ledger_type IN (
                        'PatientCreditAdjustment','PatientCreditAdjustmentRebill',
                        'PatientCreditAdjustmentCancellation',
                        'PatientChargeAdjustment','PatientChargeAdjustmentRebill',
                        'PatientChargeAdjustmentCancellation')
                      {loc_sql} {prov_sql}""",
                [start, end] + loc_p + prov_p
            ).fetchone()
            total_adj = float(adj_rows["total"]) if adj_rows else 0.0
            net_prod = gross_prod + total_adj

            # Split write-offs from charge adjustments
            wo_rows = conn.execute(
                f"""SELECT COALESCE(SUM(amount), 0) AS total
                    FROM adjustments
                    WHERE transaction_date >= ? AND transaction_date <= ?
                      AND is_active = 1
                      AND ledger_type IN (
                        'PatientCreditAdjustment','PatientCreditAdjustmentRebill',
                        'PatientCreditAdjustmentCancellation')
                      {loc_sql} {prov_sql}""",
                [start, end] + loc_p + prov_p
            ).fetchone()
            writeoff_total = float(wo_rows["total"]) if wo_rows else 0.0

            # ── COLLECTIONS (distribution_lines.transaction_date) ─────────
            # Part 1: Allocated via distribution_lines
            loc_dl, loc_dl_p = _loc_clause("dl.charge_location_id", loc)
            dl_rows = conn.execute(
                f"""SELECT
                        COALESCE(ABS(SUM(dl.applied_amount)), 0) AS total,
                        COALESCE(ABS(SUM(CASE WHEN dl.source_table='insurance_payments' THEN dl.applied_amount ELSE 0 END)), 0) AS ins_total,
                        COALESCE(ABS(SUM(CASE WHEN dl.source_table='patient_payments' THEN dl.applied_amount ELSE 0 END)), 0) AS pat_dl_total
                    FROM distribution_lines dl
                    WHERE dl.transaction_date >= ? AND dl.transaction_date <= ?
                      AND dl.line_is_active = 1
                      AND dl.source_table IN ('patient_payments','insurance_payments')
                      {loc_dl}""",
                [start, end] + loc_dl_p
            ).fetchone()
            allocated_total = float(dl_rows["total"]) if dl_rows else 0.0
            ins_collections = float(dl_rows["ins_total"]) if dl_rows else 0.0
            pat_dl_collections = float(dl_rows["pat_dl_total"]) if dl_rows else 0.0

            # Part 2: Unlinked patient payments (empty distributions)
            EXCLUDED_IDS = ('14000084126690','14000090979048','14000090983673','14000092017100')
            excl_ph = ",".join("?" * len(EXCLUDED_IDS))
            loc_pp, loc_pp_p = _loc_clause("pp.location_id", loc)
            ul_rows = conn.execute(
                f"""SELECT COALESCE(ABS(SUM(pp.amount)), 0) AS total
                    FROM patient_payments pp
                    WHERE pp.entry_date >= ? AND pp.entry_date < ?
                      AND pp.is_active = 1
                      AND pp.ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')
                      AND pp.amount < 0
                      AND pp.id NOT IN ({excl_ph})
                      AND (json_extract(pp.raw, '$.distributions') IS NULL
                           OR json_extract(pp.raw, '$.distributions') = '[]')
                      AND NOT EXISTS (
                          SELECT 1 FROM distribution_lines dl2
                          WHERE dl2.transaction_id = pp.id AND dl2.source_table = 'patient_payments')
                      {loc_pp}""",
                [start, end_excl] + list(EXCLUDED_IDS) + loc_pp_p
            ).fetchone()
            unlinked_pat = float(ul_rows["total"]) if ul_rows else 0.0

            total_collections = round(allocated_total + unlinked_pat, 2)
            patient_collections = round(pat_dl_collections + unlinked_pat, 2)
            collection_pct = round(total_collections / net_prod * 100, 1) if net_prod > 0 else None

            # ── APPOINTMENTS (start_time) ─────────────────────────────────
            loc_appt, loc_appt_p = _loc_clause("location_id", loc)
            prov_appt, prov_appt_p = _prov_clause("provider_id", prov)
            appt_rows = conn.execute(
                f"""SELECT status, COUNT(*) AS cnt
                    FROM appointments
                    WHERE substr(start_time, 1, 10) >= ? AND substr(start_time, 1, 10) <= ?
                      {loc_appt} {prov_appt}
                    GROUP BY status""",
                [start, end] + loc_appt_p + prov_appt_p
            ).fetchall()
            status_counts = {r["status"]: r["cnt"] for r in appt_rows}
            completed = status_counts.get("COMPLETED", 0) + status_counts.get("CHAIR", 0)
            cancelled = (
                status_counts.get("CANCELLEDBYOFFICE", 0)
                + status_counts.get("CANCELLEDBYPATIENT", 0)
                + status_counts.get("CANCELLED", 0)
            )
            no_show = status_counts.get("NO_SHOW", 0)
            broken = status_counts.get("BROKEN", 0)

            # ── NEW PATIENTS (first-appointment proxy) ────────────────────
            np_sql_base = "SELECT patient_id, MIN(substr(start_time, 1, 10)) AS first_appt FROM appointments WHERE patient_id IS NOT NULL"
            np_params = []
            if loc:
                np_sql_base += " AND location_id = ?"
                np_params.append(loc)
            np_sql_base += " GROUP BY patient_id HAVING first_appt >= ? AND first_appt <= ?"
            np_params.extend([start, end])
            np_rows = conn.execute(
                f"SELECT COUNT(*) AS cnt FROM ({np_sql_base})", np_params
            ).fetchone()
            new_patients = int(np_rows["cnt"]) if np_rows else 0

            # ── CLAIMS SUBMITTED (sentDate) ───────────────────────────────
            loc_cl, loc_cl_p = _loc_clause("ic.location_id", loc)
            cl_rows = conn.execute(
                f"""SELECT COUNT(*) AS total_submitted,
                        SUM(CASE
                            WHEN json_extract(ic.raw, '$.sentDate') IS NOT NULL
                                 AND julianday(json_extract(ic.raw, '$.sentDate'))
                                     - julianday(json_extract(ic.raw, '$.created'))
                                     <= 1.0
                            THEN 1 ELSE 0 END) AS within_24h,
                        SUM(CASE
                            WHEN json_extract(ic.raw, '$.sentDate') IS NULL
                            THEN 1 ELSE 0 END) AS pending
                    FROM insurance_claims ic
                    WHERE json_extract(ic.raw, '$.sentDate') >= ?
                      AND json_extract(ic.raw, '$.sentDate') <= ?
                      AND ic.is_active = 1
                      {loc_cl}""",
                [start, end] + loc_cl_p
            ).fetchone()
            claims_submitted = int(cl_rows["total_submitted"]) if cl_rows else 0
            claims_within_24h = int(cl_rows["within_24h"] or 0) if cl_rows else 0
            # Pending = claims with service date in range but no sentDate
            cl_pending_rows = conn.execute(
                f"""SELECT COUNT(*) AS cnt FROM insurance_claims ic
                    WHERE ic.service_date >= ? AND ic.service_date <= ?
                      AND ic.is_active = 1
                      AND json_extract(ic.raw, '$.sentDate') IS NULL
                      {loc_cl}""",
                [start, end] + loc_cl_p
            ).fetchone()
            claims_pending = int(cl_pending_rows["cnt"]) if cl_pending_rows else 0
            claim_rate_24h = round(claims_within_24h / claims_submitted * 100, 1) if claims_submitted > 0 else None

            # ── POS COLLECTIONS (paidAtVisit=true) ────────────────────────
            loc_pos, loc_pos_p = _loc_clause("location_id", loc)
            pos_rows = conn.execute(
                f"""SELECT COALESCE(ABS(SUM(amount)), 0) AS total
                    FROM patient_payments
                    WHERE transaction_date >= ? AND transaction_date <= ?
                      AND json_extract(raw, '$.paidAtVisit') = 1
                      AND is_active = 1 AND amount < 0
                      {loc_pos}""",
                [start, end] + loc_pos_p
            ).fetchone()
            pos_collections = float(pos_rows["total"]) if pos_rows else 0.0

            # ── REFUNDS (OLT-classified, transaction_date) ────────────────
            REFUND_OLT_IDS = (
                '14000000010443', '14000000010449',  # insurance refunds
                '14000000010446',                     # patient refund
                '14000000010450', '14000000021755', '14000000022515',  # CC refunds
            )
            ref_ph = ",".join("?" * len(REFUND_OLT_IDS))
            loc_ref, loc_ref_p = _loc_clause("location_id", loc)
            ref_rows = conn.execute(
                f"""SELECT COALESCE(SUM(amount), 0) AS total
                    FROM adjustments
                    WHERE transaction_date >= ? AND transaction_date <= ?
                      AND is_active = 1
                      AND json_extract(raw, '$.organizationLedgerType.id') IN ({ref_ph})
                      {loc_ref}""",
                [start, end] + list(REFUND_OLT_IDS) + loc_ref_p
            ).fetchone()
            refunds = float(ref_rows["total"]) if ref_rows else 0.0

            # ── PATIENT PORTION COLLECTED ─────────────────────────────────
            # = patient_collections (already computed above)
            patient_portion_collected = patient_collections

            _src_warnings = []
            if _prod_fallback_count > 0:
                _src_warnings.append(
                    f"production: {_prod_fallback_count}/{procedure_count} procedures used transaction_date fallback "
                    "(entry_date not populated for pre-2026 data)")

            return {
                "gross_production": _r(gross_prod),
                "net_production": _r(net_prod),
                "production_adjustments": _r(total_adj),
                "writeoffs": _r(writeoff_total),
                "total_collections": _r(total_collections),
                "insurance_collections": _r(ins_collections),
                "patient_collections": _r(patient_collections),
                "collection_percentage": _r(collection_pct) if collection_pct is not None else None,
                "new_patients": new_patients,
                "completed_appointments": completed,
                "cancellations": cancelled,
                "no_shows": no_show,
                "broken_appointments": broken,
                "claims_submitted": claims_submitted,
                "claims_submitted_within_24h": claims_within_24h,
                "claim_submission_rate_24h": _r(claim_rate_24h) if claim_rate_24h is not None else None,
                "claims_pending_submission": claims_pending,
                "patient_portion_collected": _r(patient_portion_collected),
                "patient_portion_remaining_due": None,
                "pos_collections": _r(pos_collections),
                "refunds": _r(abs(refunds)),
                "procedure_count": procedure_count,
                "_production_date_fallback_count": _prod_fallback_count,
                "_source_warnings": _src_warnings if _src_warnings else None,
            }

        # ══════════════════════════════════════════════════════════════════
        # HELPER: previous business day
        # ══════════════════════════════════════════════════════════════════
        def _prev_business_day(d: _date) -> _date:
            """Return the prior Mon–Fri, skipping weekends."""
            d = d - _td(days=1)
            while d.weekday() >= 5:  # Sat=5, Sun=6
                d = d - _td(days=1)
            return d

        # ══════════════════════════════════════════════════════════════════
        # HELPER: build comparison block
        # ══════════════════════════════════════════════════════════════════
        def _build_comparison(current: dict, comparison: dict, comp_start: str, comp_end: str, label: str) -> dict:
            """Build a comparison block with delta/pct for each metric."""
            block = {
                "comparison_start": comp_start,
                "comparison_end": comp_end,
                "label": label,
                "metrics": {},
            }
            NUMERIC_METRICS = [
                "gross_production", "net_production", "production_adjustments", "writeoffs",
                "total_collections", "insurance_collections", "patient_collections",
                "collection_percentage", "new_patients", "completed_appointments",
                "cancellations", "no_shows", "broken_appointments", "claims_submitted",
                "claims_submitted_within_24h", "claim_submission_rate_24h",
                "claims_pending_submission", "patient_portion_collected",
                "pos_collections", "refunds", "procedure_count",
            ]
            for m in NUMERIC_METRICS:
                if requested_metrics and m not in requested_metrics:
                    continue
                cv = current.get(m)
                compv = comparison.get(m)
                if cv is None or compv is None:
                    block["metrics"][m] = {
                        "current_value": cv,
                        "comparison_value": compv,
                        "delta": None,
                        "delta_pct": None,
                        "direction": None,
                        "source_note": "one_or_both_values_unavailable",
                    }
                    continue
                delta = round(cv - compv, 2)
                delta_pct = round((delta / abs(compv)) * 100, 1) if compv != 0 else None
                direction = "up" if delta > 0 else ("down" if delta < 0 else "flat")
                block["metrics"][m] = {
                    "current_value": cv,
                    "comparison_value": compv,
                    "delta": delta,
                    "delta_pct": delta_pct,
                    "direction": direction,
                    "source_note": None,
                }
            return block

        # ══════════════════════════════════════════════════════════════════
        # HELPER: filter metrics
        # ══════════════════════════════════════════════════════════════════
        def _filter_metrics(m: dict) -> dict:
            if not requested_metrics:
                return m
            return {k: v for k, v in m.items() if k in requested_metrics or k in (
                "patient_portion_remaining_due", "source_warnings", "unavailable_metrics",
                "procedure_count",
            )}

        # ══════════════════════════════════════════════════════════════════
        # BUILD RESPONSE
        # ══════════════════════════════════════════════════════════════════

        result = {
            "daily": None,
            "mtd": None,
            "monthly_breakdown": None,
            "year_over_year": None,
            "by_office": None,
            "by_provider": None,
            "source_notes": {
                "production_date_basis": "entry_date (Dentrix Modified Applied Date)",
                "collections_date_basis": "distribution_lines.transaction_date (allocated) + patient_payments.entry_date (unlinked)",
                "adjustments_date_basis": "transaction_date",
                "appointment_date_basis": "start_time (substr 1-10)",
                "claims_date_basis": "sentDate (from raw JSON)",
                "new_patient_method": "first_appointment_date_proxy (Dentrix has no patient creation date)",
                "patient_portion_remaining_due": "null — not safely daily-aggregatable; requires per-procedure guarantor reconciliation. Use /v2/rcm/guarantor-reconciliation for reliable data.",
                "refund_source": "adjustments with OLT-classified refund types (insurance_overpayment_refund, patient_refund, credit_card_refund)",
                "pos_collections_source": "patient_payments where paidAtVisit=true, is_active=1, amount<0",
                "manual_daily_entries_status": "deprecated_not_used",
                "eassist_status": "separate_tab_not_used",
                "collection_percentage_formula": "total_collections / net_production (not gross)",
            },
            "metadata": {
                "selected_date": selected_date,
                "comparison_mode": comparisonMode,
                "comparison_years": comparisonYears,
                "office_filter": officeId or None,
                "location_filter": loc_id or None,
                "provider_filter": providerId or None,
                "snapshot_timestamp": now_iso,
                # Sync timestamps populated below from sync_state
                "production_source_last_synced_at": None,
                "collection_source_last_synced_at": None,
                "collection_source_components": None,
                "appointment_source_last_synced_at": None,
                "claims_source_last_synced_at": None,
                "refund_source_last_synced_at": None,
                "patient_portion_source_last_synced_at": None,
                "unavailable_metrics": ["patient_portion_remaining_due"],
                "warnings": [],
                "auth_required": True,
                "metrics_filter": list(requested_metrics) if requested_metrics else "all",
            },
            "_source": "dentrix_ascend",
        }

        # ── Populate sync timestamps from sync_state (authoritative) ──────
        # sync_state schema: (table_name, last_id, last_synced_at [unix float], total_count)
        # Convert unix float → ISO UTC string. If a row is missing, leave null and warn.
        try:
            import datetime as _dt_mod

            def _unix_to_iso(unix_float) -> str:
                """Convert unix timestamp float to ISO 8601 UTC string."""
                return _dt_mod.datetime.fromtimestamp(
                    float(unix_float), tz=_dt_mod.timezone.utc
                ).strftime("%Y-%m-%dT%H:%M:%SZ")

            # Fetch all relevant sync_state rows in one query
            _SYNC_TABLES = (
                "procedures", "patient_payments", "insurance_payments",
                "appointments", "insurance_claims", "adjustments",
            )
            _st_ph = ",".join("?" * len(_SYNC_TABLES))
            _ss_rows = conn.execute(
                f"SELECT table_name, last_synced_at FROM sync_state WHERE table_name IN ({_st_ph})",
                list(_SYNC_TABLES)
            ).fetchall()
            _ss_map = {r["table_name"]: r["last_synced_at"] for r in _ss_rows if r["last_synced_at"]}
            _ss_warnings = []

            # 1. Production — procedures
            if "procedures" in _ss_map:
                result["metadata"]["production_source_last_synced_at"] = _unix_to_iso(_ss_map["procedures"])
            else:
                _ss_warnings.append("sync_state missing row for 'procedures' — production_source_last_synced_at unavailable")

            # 2. Collections — max(patient_payments, insurance_payments)
            # distribution_lines has no sync_state row; payments are the authoritative sync anchor
            _pp_ts  = _ss_map.get("patient_payments")
            _ip_ts  = _ss_map.get("insurance_payments")
            _coll_components = {
                "patient_payments_last_synced_at":   _unix_to_iso(_pp_ts)  if _pp_ts  else None,
                "insurance_payments_last_synced_at": _unix_to_iso(_ip_ts)  if _ip_ts  else None,
                "note": "distribution_lines has no sync_state row; timestamps from payment source tables used as collection sync anchor",
            }
            result["metadata"]["collection_source_components"] = _coll_components
            _coll_ts_vals = [v for v in [_pp_ts, _ip_ts] if v is not None]
            if _coll_ts_vals:
                result["metadata"]["collection_source_last_synced_at"] = _unix_to_iso(max(_coll_ts_vals))
            else:
                _ss_warnings.append("sync_state missing rows for both 'patient_payments' and 'insurance_payments' — collection_source_last_synced_at unavailable")

            # 3. Appointments
            if "appointments" in _ss_map:
                result["metadata"]["appointment_source_last_synced_at"] = _unix_to_iso(_ss_map["appointments"])
            else:
                _ss_warnings.append("sync_state missing row for 'appointments' — appointment_source_last_synced_at unavailable")

            # 4. Claims
            if "insurance_claims" in _ss_map:
                result["metadata"]["claims_source_last_synced_at"] = _unix_to_iso(_ss_map["insurance_claims"])
            else:
                _ss_warnings.append("sync_state missing row for 'insurance_claims' — claims_source_last_synced_at unavailable")

            # 5. Refunds — adjustments table
            if "adjustments" in _ss_map:
                result["metadata"]["refund_source_last_synced_at"] = _unix_to_iso(_ss_map["adjustments"])
            else:
                _ss_warnings.append("sync_state missing row for 'adjustments' — refund_source_last_synced_at unavailable")

            # 6. Patient portion — intentionally null (not safely daily-aggregatable)
            result["metadata"]["patient_portion_source_last_synced_at"] = None

            if _ss_warnings:
                result["metadata"]["warnings"].extend(_ss_warnings)

        except Exception as _ss_err:
            result["metadata"]["warnings"].append(
                f"sync_state query failed — all source sync timestamps unavailable: {_ss_err}"
            )

        # ══════════════════════════════════════════════════════════════════
        # DAILY MODE
        # ══════════════════════════════════════════════════════════════════
        if comparisonMode == "daily":
            selected_metrics = _fetch_metrics(selected_date, selected_date, loc_id, providerId)
            selected_metrics["selected_date"] = selected_date
            selected_metrics["office"] = LOCATION_NAMES.get(loc_id, "All Offices") if loc_id else "All Offices"
            selected_metrics["source_warnings"] = []
            selected_metrics["unavailable_metrics"] = ["patient_portion_remaining_due"]

            # Comparisons
            prev_bd = _prev_business_day(sel_dt)
            same_wd_lw = sel_dt - _td(weeks=1)
            try:
                same_date_lm = sel_dt.replace(month=sel_dt.month - 1) if sel_dt.month > 1 \
                    else sel_dt.replace(year=sel_dt.year - 1, month=12)
            except ValueError:
                # Handle day > max day in target month
                import calendar as _cal
                if sel_dt.month > 1:
                    max_day = _cal.monthrange(sel_dt.year, sel_dt.month - 1)[1]
                    same_date_lm = sel_dt.replace(month=sel_dt.month - 1, day=min(sel_dt.day, max_day))
                else:
                    max_day = _cal.monthrange(sel_dt.year - 1, 12)[1]
                    same_date_lm = sel_dt.replace(year=sel_dt.year - 1, month=12, day=min(sel_dt.day, max_day))
            same_date_ly = sel_dt.replace(year=sel_dt.year - 1) if sel_dt.month != 2 or sel_dt.day != 29 \
                else _date(sel_dt.year - 1, 2, 28)

            prev_bd_str = prev_bd.isoformat()
            prev_bd_metrics = _fetch_metrics(prev_bd_str, prev_bd_str, loc_id, providerId)
            same_wd_str = same_wd_lw.isoformat()
            same_wd_metrics = _fetch_metrics(same_wd_str, same_wd_str, loc_id, providerId)
            same_lm_str = same_date_lm.isoformat()
            same_lm_metrics = _fetch_metrics(same_lm_str, same_lm_str, loc_id, providerId)
            same_ly_str = same_date_ly.isoformat()
            same_ly_metrics = _fetch_metrics(same_ly_str, same_ly_str, loc_id, providerId)

            result["daily"] = {
                "selected": _filter_metrics(selected_metrics),
                "vs_previous_business_day": _build_comparison(
                    selected_metrics, prev_bd_metrics, prev_bd_str, prev_bd_str, f"vs {prev_bd_str} (prev business day)"),
                "vs_same_weekday_last_week": _build_comparison(
                    selected_metrics, same_wd_metrics, same_wd_str, same_wd_str, f"vs {same_wd_str} (same weekday last week)"),
                "vs_same_date_last_month": _build_comparison(
                    selected_metrics, same_lm_metrics, same_lm_str, same_lm_str, f"vs {same_lm_str} (same date last month)"),
                "vs_same_date_last_year": _build_comparison(
                    selected_metrics, same_ly_metrics, same_ly_str, same_ly_str, f"vs {same_ly_str} (same date last year)"),
            }

        # ══════════════════════════════════════════════════════════════════
        # MTD MODE
        # ══════════════════════════════════════════════════════════════════
        if comparisonMode in ("daily", "mtd"):
            mtd_start = sel_dt.replace(day=1).isoformat()
            mtd_end = selected_date
            days_into_month = sel_dt.day

            current_mtd = _fetch_metrics(mtd_start, mtd_end, loc_id, providerId)
            current_mtd["period_start"] = mtd_start
            current_mtd["period_end"] = mtd_end
            current_mtd["days_in_period"] = days_into_month

            # Prior month same period (same number of calendar days)
            if sel_dt.month > 1:
                pm_start = sel_dt.replace(month=sel_dt.month - 1, day=1)
            else:
                pm_start = sel_dt.replace(year=sel_dt.year - 1, month=12, day=1)
            import calendar as _cal
            pm_max_day = _cal.monthrange(pm_start.year, pm_start.month)[1]
            pm_end_day = min(days_into_month, pm_max_day)
            pm_end = pm_start.replace(day=pm_end_day)

            prior_mtd = _fetch_metrics(pm_start.isoformat(), pm_end.isoformat(), loc_id, providerId)
            prior_mtd["period_start"] = pm_start.isoformat()
            prior_mtd["period_end"] = pm_end.isoformat()
            prior_mtd["days_in_period"] = pm_end_day

            # Same month last year same period
            try:
                ly_start = sel_dt.replace(year=sel_dt.year - 1, month=sel_dt.month, day=1)
            except ValueError:
                ly_start = _date(sel_dt.year - 1, sel_dt.month, 1)
            ly_max_day = _cal.monthrange(ly_start.year, ly_start.month)[1]
            ly_end_day = min(days_into_month, ly_max_day)
            ly_end = ly_start.replace(day=ly_end_day)

            ly_mtd = _fetch_metrics(ly_start.isoformat(), ly_end.isoformat(), loc_id, providerId)
            ly_mtd["period_start"] = ly_start.isoformat()
            ly_mtd["period_end"] = ly_end.isoformat()
            ly_mtd["days_in_period"] = ly_end_day

            result["mtd"] = {
                "current_mtd": _filter_metrics(current_mtd),
                "vs_prior_month_same_period": _build_comparison(
                    current_mtd, prior_mtd, pm_start.isoformat(), pm_end.isoformat(),
                    f"vs {pm_start.isoformat()} to {pm_end.isoformat()} ({pm_end_day} calendar days into prior month)"),
                "vs_same_month_last_year_same_period": _build_comparison(
                    current_mtd, ly_mtd, ly_start.isoformat(), ly_end.isoformat(),
                    f"vs {ly_start.isoformat()} to {ly_end.isoformat()} ({ly_end_day} calendar days into same month last year)"),
                "mtd_method": "calendar_days",
            }

        # ══════════════════════════════════════════════════════════════════
        # MONTHLY YOY / YEARLY YOY
        # ══════════════════════════════════════════════════════════════════
        if comparisonMode in ("monthly_yoy", "yearly_yoy"):
            import calendar as _cal

            # Determine year range
            end_year = sel_dt.year
            start_year = max(end_year - comparisonYears + 1, 2022)  # data floor

            # Use explicit startDate/endDate if provided
            if startDate:
                try:
                    start_year = _date.fromisoformat(startDate).year
                except ValueError:
                    pass
            if endDate:
                try:
                    end_year = _date.fromisoformat(endDate).year
                except ValueError:
                    pass

            monthly_breakdown = []
            yearly_agg = {}

            for yr in range(start_year, end_year + 1):
                year_total = {
                    "gross_production": 0, "net_production": 0, "total_collections": 0,
                    "insurance_collections": 0, "patient_collections": 0,
                    "new_patients": 0, "completed_appointments": 0,
                    "cancellations": 0, "no_shows": 0, "broken_appointments": 0,
                    "claims_submitted": 0, "refunds": 0, "pos_collections": 0,
                    "production_adjustments": 0, "writeoffs": 0,
                }
                months_with_data = 0

                for mo in range(1, 13):
                    last_day = _cal.monthrange(yr, mo)[1]
                    mo_start = f"{yr}-{mo:02d}-01"
                    mo_end = f"{yr}-{mo:02d}-{last_day:02d}"
                    # Skip future months
                    if mo_start > today_str:
                        break

                    # Cap end date at today for current month
                    if mo_end > today_str:
                        mo_end = today_str

                    mo_metrics = _fetch_metrics(mo_start, mo_end, loc_id, providerId)

                    mo_row = {
                        "year": yr,
                        "month": mo,
                        "month_label": f"{yr}-{mo:02d}",
                        "office": LOCATION_NAMES.get(loc_id, "All Offices") if loc_id else "All Offices",
                        **{k: mo_metrics.get(k) for k in year_total.keys()},
                        "collection_percentage": mo_metrics.get("collection_percentage"),
                    }
                    monthly_breakdown.append(mo_row)

                    # Accumulate yearly totals
                    for k in year_total:
                        val = mo_metrics.get(k)
                        if val is not None:
                            year_total[k] += val
                    months_with_data += 1

                yr_net = year_total["net_production"]
                yr_coll = year_total["total_collections"]
                yearly_agg[yr] = {
                    "year": yr,
                    "production": round(year_total["gross_production"], 2),
                    "net_production": round(yr_net, 2),
                    "collections": round(yr_coll, 2),
                    "collection_pct": round(yr_coll / yr_net * 100, 1) if yr_net > 0 else None,
                    "new_patients": year_total["new_patients"],
                    "appointments": year_total["completed_appointments"],
                    "refunds": round(year_total["refunds"], 2),
                    "writeoffs": round(year_total["writeoffs"], 2),
                    "months_with_data": months_with_data,
                }

            result["monthly_breakdown"] = monthly_breakdown
            result["year_over_year"] = yearly_agg

            # Performance note for large YOY range
            if end_year - start_year >= 3:
                result["metadata"]["warnings"].append(
                    f"YOY data spans {end_year - start_year + 1} years ({start_year}-{end_year}). "
                    "Large date ranges may be slow. Consider caching/snapshot for production use."
                )

        # ══════════════════════════════════════════════════════════════════
        # BY OFFICE (always for daily + mtd modes if no single-office filter)
        # ══════════════════════════════════════════════════════════════════
        if comparisonMode in ("daily", "mtd"):
            by_office = []
            for _lid, _lname in LOCATION_NAMES.items():
                if loc_id and _lid != loc_id:
                    continue
                _uid = LOCATION_TO_OFFICE.get(_lid, _lid)
                office_day = _fetch_metrics(selected_date, selected_date, _lid, providerId)
                by_office.append({
                    "office_id": _uid,
                    "office_name": _lname,
                    "location_id": _lid,
                    **_filter_metrics(office_day),
                })
            result["by_office"] = by_office

        # ══════════════════════════════════════════════════════════════════
        # BY PROVIDER (daily mode, if data exists)
        # Uses the same trusted provider-performance logic (service layer)
        # as /v2/reports/provider-performance for production + collections,
        # plus per-provider appointments from _fetch_metrics.
        #
        # Collection-only row cleanup (2026-05-12):
        #   - Resolves office for collection-only rows via distribution_lines.charge_location_id
        #   - Replaces nulls with 0 for true-zero production/procedure/appointment fields
        #   - Adds row classification fields: row_type, is_collection_only, is_unattributed,
        #     office_resolution_source, _collection_percentage_note
        #   - collection_percentage = null (with note) when net_production <= 0
        #   - Unattributed row: procedure_count = 0 (not null)
        # ══════════════════════════════════════════════════════════════════
        if comparisonMode == "daily":
            svc = get_service()
            perf = svc.get_provider_performance(selected_date, selected_date, loc_id)
            perf_providers = perf.get("providers", [])

            # ── Pre-fetch office resolution for collection-only rows ───────────
            # For each provider: pick the charge_location_id with the highest total
            # absolute applied amount on the selected date. Used to resolve "Unknown"
            # office on collection-only rows (providers with collections but no
            # same-day production).
            # One query, all providers, all valid locations — O(1) DB round-trip.
            _VALID_LOCS_TUPLE = (
                "14000000000432", "14000000000433",
                "14000000000434", "14000000000435",
            )
            _loc_ph = ",".join("?" * len(_VALID_LOCS_TUPLE))
            _dl_loc_rows = conn.execute(
                f"""
                SELECT
                    dl.procedure_provider_id                      AS provider_id,
                    dl.charge_location_id                         AS location_id,
                    SUM(ABS(COALESCE(dl.applied_amount, 0)))      AS abs_total
                FROM distribution_lines dl
                WHERE dl.transaction_date = ?
                  AND dl.line_is_active = 1
                  AND dl.source_table IN ('patient_payments', 'insurance_payments')
                  AND dl.procedure_provider_id IS NOT NULL
                  AND dl.charge_location_id IN ({_loc_ph})
                GROUP BY dl.procedure_provider_id, dl.charge_location_id
                ORDER BY dl.procedure_provider_id, abs_total DESC
                """,
                [selected_date] + list(_VALID_LOCS_TUPLE)
            ).fetchall()

            # Build: provider_id → best (highest-abs) charge_location_id for the day
            _coll_only_office_map: dict = {}   # provider_id → location_id
            for _dlr in _dl_loc_rows:
                _pid_dl = _dlr["provider_id"]
                _lid_dl = _dlr["location_id"]
                # First row per provider is highest (ORDER BY abs_total DESC)
                if _pid_dl and _lid_dl and _pid_dl not in _coll_only_office_map:
                    _coll_only_office_map[_pid_dl] = _lid_dl

            by_provider = []
            for p in perf_providers:
                pid   = p.get("providerId")
                pname = p.get("providerName") or p.get("name") or f"Provider {pid}"
                gross = float(p.get("grossProduction", 0) or 0)
                adj   = float(p.get("adjustments", 0) or 0)
                net   = float(p.get("netProduction", 0) or 0)
                procs = int(p.get("procedureCount", 0) or 0)
                total_coll = float(p.get("collections", 0) or 0)
                ins_coll   = float(p.get("insuranceCollections", 0) or 0)
                pat_coll   = float(p.get("patientCollections", 0) or 0)

                # ── Row classification ────────────────────────────────────────
                is_unattributed   = (pid == "UNATTRIBUTED_OFFICE_LEVEL")
                is_collection_only = (
                    not is_unattributed
                    and gross == 0.0
                    and net == 0.0
                    and procs == 0
                    and total_coll > 0
                )
                if is_unattributed:
                    row_type = "unattributed_office_level"
                elif is_collection_only:
                    row_type = "collection_only"
                else:
                    row_type = "production_and_collections"

                # ── Office resolution ─────────────────────────────────────────
                raw_office = p.get("office") or p.get("officeName") or None
                office_resolution_source = None

                if is_unattributed:
                    # Keep as-is (ALL or office name from service layer)
                    office = raw_office or "ALL"
                    office_resolution_source = "unattributed_residual"
                elif is_collection_only and (not raw_office or raw_office == "Unknown"):
                    # Resolve from distribution_lines.charge_location_id
                    resolved_lid = _coll_only_office_map.get(pid) if pid else None
                    if resolved_lid:
                        office = LOCATION_NAMES.get(resolved_lid, "Unknown")
                        office_resolution_source = "distribution_lines.charge_location_id"
                    else:
                        office = raw_office or "Unknown"
                        office_resolution_source = "unresolved"
                else:
                    office = raw_office or "Unknown"
                    office_resolution_source = "production_location_id" if gross > 0 else "provider_performance_service"

                # ── Per-provider appointments ─────────────────────────────────
                appt_data = {}
                if pid and not is_unattributed:
                    appt_metrics = _fetch_metrics(selected_date, selected_date, loc_id, pid)
                    appt_data = {
                        "completed_appointments": appt_metrics.get("completed_appointments"),
                        "cancellations":          appt_metrics.get("cancellations"),
                        "no_shows":               appt_metrics.get("no_shows"),
                        "broken_appointments":    appt_metrics.get("broken_appointments"),
                    }

                # ── True-zero cleanup for collection-only rows ────────────────
                # Null production/procedure/appointment fields on collection-only
                # rows are true zero (not missing data) — replace with 0.
                if is_collection_only:
                    gross_out        = 0.0
                    net_out          = 0.0
                    adj_out          = 0.0
                    procs_out        = 0
                    completed_out    = 0
                    cancels_out      = 0
                    noshows_out      = 0
                    broken_out       = 0
                    # patient_collections: 0 if no patient payments attributed
                    pat_coll_out     = round(pat_coll, 2) if pat_coll > 0 else 0.0
                elif is_unattributed:
                    gross_out        = round(gross, 2)
                    net_out          = round(net, 2)
                    adj_out          = round(adj, 2)
                    procs_out        = 0                    # always 0 for unattributed
                    completed_out    = appt_data.get("completed_appointments")
                    cancels_out      = appt_data.get("cancellations")
                    noshows_out      = appt_data.get("no_shows")
                    broken_out       = appt_data.get("broken_appointments")
                    pat_coll_out     = round(pat_coll, 2)
                else:
                    gross_out        = round(gross, 2) if gross else None
                    net_out          = round(net, 2) if gross else None
                    adj_out          = round(adj, 2) if adj != 0 else 0.0
                    procs_out        = procs if procs else None
                    completed_out    = appt_data.get("completed_appointments")
                    cancels_out      = appt_data.get("cancellations")
                    noshows_out      = appt_data.get("no_shows")
                    broken_out       = appt_data.get("broken_appointments")
                    pat_coll_out     = round(pat_coll, 2) if pat_coll else None

                # ── Collection % with per-row notes ──────────────────────────
                coll_pct       = None
                coll_pct_note  = None

                if is_collection_only:
                    # net_production is 0 by definition — % is meaningless
                    coll_pct      = None
                    coll_pct_note = (
                        "N/A: provider had collections from prior-date procedures "
                        "but no same-day net production."
                    )
                elif is_unattributed and net < 0:
                    coll_pct      = None
                    coll_pct_note = (
                        "N/A: unattributed bucket has negative net production."
                    )
                elif net > 0 and total_coll > 0:
                    coll_pct = round(total_coll / net * 100, 1)
                elif net <= 0 and total_coll > 0:
                    coll_pct      = None
                    coll_pct_note = "N/A: net production is zero or negative."
                else:
                    # net > 0, no collections — 0 %
                    coll_pct = 0.0 if net > 0 else None

                row: dict = {
                    "provider_id":           pid,
                    "provider_name":         pname,
                    "office":                office,
                    # Row classification
                    "row_type":              row_type,
                    "is_collection_only":    is_collection_only,
                    "is_unattributed":       is_unattributed,
                    "office_resolution_source": office_resolution_source,
                    # Production
                    "gross_production":      gross_out,
                    "net_production":        net_out,
                    "production_adjustments": adj_out,
                    "procedure_count":       procs_out,
                    # Appointments
                    "completed_appointments": completed_out,
                    "cancellations":          cancels_out,
                    "no_shows":               noshows_out,
                    "broken_appointments":    broken_out,
                    # Collections
                    "total_collections":     round(total_coll, 2) if total_coll else None,
                    "insurance_collections": round(ins_coll, 2)   if ins_coll   else None,
                    "patient_collections":   pat_coll_out,
                    "collection_percentage": coll_pct,
                    # Source / notes
                    "_source": "provider-performance (same as /v2/reports/provider-performance)",
                    "_collection_note": (
                        "Collections attributed through distribution_lines.procedure_provider_id "
                        "for insurance_payments and patient_payments only."
                    ),
                    "_net_production_note": (
                        "Net production = gross + adjustments (charge adj by provider_id + "
                        "credit adj via distributions→procedures→provider_id). "
                        "Same formula as /v2/reports/provider-performance."
                    ),
                }
                # Only include note field when relevant (keep response clean)
                if coll_pct_note is not None:
                    row["_collection_percentage_note"] = coll_pct_note

                by_provider.append(row)

            result["by_provider"] = by_provider

        return result

    except HTTPException:
        raise
    except Exception as e:
        logger.exception("Error in daily-comparison endpoint")
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        conn.close()


# ============================================================================
# HUDDLE PREFILL — Composite read-only endpoint for redesigned Morning Huddle
# ============================================================================

import calendar
from zoneinfo import ZoneInfo

# Holidays used by Nu Dashboard — matches production_goals_2026.md
# No Black Friday unless Dr. G separately approves.
_HUDDLE_HOLIDAYS: dict[tuple[int, int, int], str] = {
    (2026, 1, 1): "New Year's Day",
    (2026, 5, 25): "Memorial Day",
    (2026, 7, 3): "Independence Day (observed)",
    (2026, 9, 7): "Labor Day",
    (2026, 11, 26): "Thanksgiving",
    (2026, 12, 25): "Christmas",
}

_OFFICE_NAMES: dict[str, str] = {
    "220372a5-afae-49c9-8a0c-f4c0717ff352": "Eatontown",
    "1c719b5b-fd77-4da8-a1b9-2209f1cea63e": "Barnegat",
    "54626997-57c2-4934-8743-1dabb4d176f4": "Brick",
    "b0abcc46-55e8-4529-a28f-eedf41c1d72e": "Staten Island",
}


def _huddle_working_days(year: int, month: int, through_date=None):
    """Return list of working days (Mon-Fri, holidays excluded) in a month.
    If through_date given, only includes days up to and including that date."""
    from datetime import date as _date, timedelta as _td
    days = []
    d = _date(year, month, 1)
    last = through_date or _date(year, month, calendar.monthrange(year, month)[1])
    while d <= last and d.month == month:
        if d.weekday() < 5 and (d.year, d.month, d.day) not in _HUDDLE_HOLIDAYS:
            days.append(d)
        d += _td(days=1)
    return days


def _huddle_month_holidays(year: int, month: int) -> list[dict]:
    """Return holidays that fall in the given month."""
    from datetime import date as _date
    return [
        {"date": _date(y, m, d).isoformat(), "name": name}
        for (y, m, d), name in sorted(_HUDDLE_HOLIDAYS.items())
        if y == year and m == month
    ]


def _huddle_count_provider_days(schedule_rows: list[dict], working_days) -> float:
    """Count working days a provider is scheduled, accounting for
    every-other week_parity and half-days. Returns fractional count."""
    total = 0.0
    for wd in working_days:
        iso_weekday = wd.isoweekday()  # 1=Mon ... 7=Sun
        iso_week = wd.isocalendar()[1]  # 1–53
        for s in schedule_rows:
            if s["weekday"] == iso_weekday:
                if s["frequency"] == "every":
                    total += 0.5 if s.get("half_day") else 1.0
                elif s["frequency"] == "every_other":
                    if (iso_week % 2) == s.get("week_parity", 0):
                        total += 0.5 if s.get("half_day") else 1.0
    return total


def _huddle_is_scheduled_today(schedule_rows: list[dict], check_date) -> bool:
    """Check if provider is scheduled to work on check_date."""
    iso_weekday = check_date.isoweekday()
    iso_week = check_date.isocalendar()[1]
    for s in schedule_rows:
        if s["weekday"] == iso_weekday:
            if s["frequency"] == "every":
                return True
            elif s["frequency"] == "every_other":
                if (iso_week % 2) == s.get("week_parity", 0):
                    return True
    return False


def _sb_query(table: str, params: dict | None = None) -> list[dict]:
    """Query Supabase PostgREST for rows. Returns list of dicts."""
    from supabase_service import _base_url, _headers
    import requests as _req
    url = f"{_base_url()}/{table}"
    hdrs = _headers()
    hdrs["Prefer"] = "return=representation"
    resp = _req.get(url, headers=hdrs, params=params or {}, timeout=10)
    if resp.status_code >= 400:
        logger.warning(f"Supabase query {table} failed: {resp.status_code} {resp.text[:200]}")
        return []
    return resp.json()


