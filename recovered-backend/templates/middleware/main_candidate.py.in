@app.post("/v2/sync/trigger", tags=["Admin"], dependencies=[Depends(verify_api_key)])
def trigger_sync():
    import threading
    from sync import sync_all

    def _run():
        try:
            sync_all()
        except Exception as e:
            logger.error(f"Manual sync failed: {e}", exc_info=True)

    threading.Thread(target=_run, daemon=True, name="manual-sync").start()
    return {"status": "ok", "message": "Sync triggered in background"}


