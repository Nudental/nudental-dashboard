@app.post("/amazon/order-requests", tags=["Amazon"])
async def submit_order_request(request: Request, X_API_Key: Optional[str] = Header(None, alias="X-API-Key")):
    """Submit Order Request"""
    if not X_API_Key or X_API_Key != NUDASHBOARD_API_KEY:
        raise HTTPException(status_code=401, detail="Invalid or missing API key")

    body = await request.json()
    required = ["user_id", "user_email", "office_location", "office_id", "cart_items", "estimated_total", "amazon_cart_id"]
    for field in required:
        if field not in body:
            raise HTTPException(400, f"Missing required field: {field}")
    try:
        payload = amazon_service.build_order_request_payload(
            user_id=body["user_id"],
            user_email=body["user_email"],
            office_location=body["office_location"],
            office_id=body["office_id"],
            cart_items=body["cart_items"],
            estimated_total=body["estimated_total"],
            amazon_cart_id=body["amazon_cart_id"],
            notes=body.get("notes"),
        )
        import requests as _req
        sb = _load_sb_config()
        resp = _req.post(
            f"{sb['project_url']}/rest/v1/amazon_order_requests",
            json=payload,
            headers={
                "apikey": sb["secret_key"],
                "Authorization": f"Bearer {sb['secret_key']}",
                "Content-Type": "application/json",
                "Prefer": "return=representation",
            },
            timeout=10,
        )
        if resp.status_code >= 400:
            raise HTTPException(resp.status_code, resp.text)
        return resp.json()
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(500, str(e))

@app.post("/amazon/order-requests/{request_id}/approve", tags=["Amazon"])
async def approve_order_request(request_id: str, request: Request, X_API_Key: Optional[str] = Header(None, alias="X-API-Key")):
    """Approve Order Request"""
    if not X_API_Key or X_API_Key != NUDASHBOARD_API_KEY:
        raise HTTPException(status_code=401, detail="Invalid or missing API key")

    try:
        body = await request.json() if request.headers.get("content-type", "").startswith("application/json") else {}
        import requests as _req
        sb = _load_sb_config()
        update = {
            "status": "approved",
            "approved_by": body.get("approved_by", "admin"),
            "approved_at": datetime.now(timezone.utc).isoformat(),
        }
        resp = _req.patch(
            f"{sb['project_url']}/rest/v1/amazon_order_requests?id=eq.{request_id}",
            json=update,
            headers={
                "apikey": sb["secret_key"],
                "Authorization": f"Bearer {sb['secret_key']}",
                "Content-Type": "application/json",
                "Prefer": "return=representation",
            },
            timeout=10,
        )
        if resp.status_code >= 400:
            raise HTTPException(resp.status_code, resp.text)
        return resp.json()
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(500, str(e))

@app.post("/amazon/order-requests/{request_id}/reject", tags=["Amazon"])
async def reject_order_request(request_id: str, request: Request, X_API_Key: Optional[str] = Header(None, alias="X-API-Key")):
    """Reject Order Request"""
    if not X_API_Key or X_API_Key != NUDASHBOARD_API_KEY:
