# ---------------------------------------------------------------------------
# Gusto OAuth Callback
# ---------------------------------------------------------------------------

@app.get("/gusto/callback")
async def gusto_callback(code: str = None, error: str = None, state: str = None):
    """Receives Gusto OAuth authorization code and exchanges it for tokens."""
    import httpx, json as _json
    if error:
        return FastAPIResponse(content=f"<html><body><h2>Error: {error}</h2></body></html>", media_type="text/html")
    if not code:
        return FastAPIResponse(content="<html><body><h2>No code received</h2></body></html>", media_type="text/html")

    # Exchange code for token
    creds = _json.load(open("/home/openclaw/.config/gusto/nudental.json"))
    token_url = "https://api.gusto.com/oauth/token"
    payload = {
        "client_id": creds["client_id"],
        "client_secret": creds["client_secret"],
        "redirect_uri": "https://api.nudashboard.com/gusto/callback",
        "code": code,
        "grant_type": "authorization_code",
    }
    async with httpx.AsyncClient() as client:
        resp = await client.post(token_url, data=payload)
        token_data = resp.json()

    # Save token
    token_path = "/home/openclaw/.config/gusto/token.json"
    with open(token_path, "w") as f:
        _json.dump(token_data, f, indent=2)

    if "access_token" in token_data:
        return FastAPIResponse(
            content="<html><body style='font-family:sans-serif;text-align:center;padding:50px'><h2 style='color:green'>&#10003; Gusto Connected Successfully!</h2><p>You can close this tab. Yabezy is finishing the setup.</p></body></html>",
            media_type="text/html"
        )
    else:
        return FastAPIResponse(
            content=f"<html><body><h2>Token error</h2><pre>{token_data}</pre></body></html>",
            media_type="text/html"
        )


