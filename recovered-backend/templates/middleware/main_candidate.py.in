# ── Payroll summary — single endpoint powering the Provider Compensation page ──
@app.get("/v2/payroll/summary", tags=["Payroll"], dependencies=[Depends(verify_api_key)])
def payroll_summary(
    payStart:   str = Query(..., description="Pay period start YYYY-MM-DD"),
    payEnd:     str = Query(..., description="Pay period end YYYY-MM-DD"),
    monthStart: Optional[str] = Query(None, description="Monthly collections start (defaults to 1st of payStart month)"),
    monthEnd:   Optional[str] = Query(None, description="Monthly collections end (defaults to last day of payEnd month)"),
):
    """
    Returns all data needed for the Provider Compensation dashboard page:
    - Per-provider pay-period collections, monthly collections, office, type, tier, compensation
    - KPI totals
    - Unmapped/excluded rows
    """
    import calendar as _cal
    from payroll_report import (
        doctor_rate, hygienist_rate, HYGIENIST_RATE_45,
        EXCLUDED_PROVIDER_IDS, EXCLUDED_PROVIDER_NAMES,
        _collections_by_date, _get_providers, _is_hygienist, HYGIENIST_KEYWORDS,
        _get_location_override, PROVIDER_LOCATION_OVERRIDES
    )

    # Compute month bounds
    ps_date = datetime.strptime(payStart, "%Y-%m-%d")
    pe_date = datetime.strptime(payEnd,   "%Y-%m-%d")
    # Ascend date alignment (1-day offset for Dentrix Ascend queries)
    ascendStart = (ps_date - timedelta(days=1)).strftime("%Y-%m-%d")
    ascendEnd   = (pe_date - timedelta(days=1)).strftime("%Y-%m-%d")
    if not monthStart:
        monthStart = ps_date.replace(day=1).strftime("%Y-%m-%d")
    if not monthEnd:
        last_day = _cal.monthrange(pe_date.year, pe_date.month)[1]
        monthEnd = pe_date.replace(day=last_day).strftime("%Y-%m-%d")

    # Location ID → office name map
    LOC_MAP = {
        "14000000000432": "Staten Island",
        "14000000000433": "Eatontown",
        "14000000000434": "Barnegat",
        "14000000000435": "Brick",
    }

    # Get primary office per provider from distribution_lines
    import sqlite3 as _sl
    _db_path = "/home/openclaw/.openclaw/workspace/ascend_api/middleware/ascend.db"
    _conn = _sl.connect(_db_path)
    _conn.row_factory = _sl.Row
    office_sql = """
        SELECT COALESCE(dl.procedure_provider_id, pr.provider_id) as pid,
               dl.transaction_location_id as loc,
               COUNT(*) as cnt
        FROM distribution_lines dl
        JOIN procedures pr ON pr.id = dl.charge_id
        WHERE dl.transaction_date BETWEEN ? AND ?
          AND dl.line_is_active=1 AND dl.applied_amount<0
          AND dl.transaction_location_id IS NOT NULL
          AND COALESCE(dl.procedure_provider_id, pr.provider_id) IS NOT NULL
        GROUP BY pid, loc ORDER BY pid, cnt DESC
    """
    office_rows = _conn.execute(office_sql, (payStart, payEnd)).fetchall()
    _conn.close()

    # Pick primary office (highest count) per provider
    provider_office: dict = {}
    for r in office_rows:
        pid = r["pid"]
        if pid not in provider_office:
            provider_office[pid] = LOC_MAP.get(r["loc"], "Unknown")

    # Fetch all providers
    providers = _get_providers()

    doctors   = []
    hygienists = []
    unmapped   = []

    for p in providers:
        pid  = p["id"]
        name = p["name"]
        spec = p["specialty"]

        # Skip owner and placeholders
        if pid in EXCLUDED_PROVIDER_IDS or name.strip().lower() in EXCLUDED_PROVIDER_NAMES:
            continue
        if any(x in name.lower() for x in ["temp", "nu dental provider", "nu dental of"]):
            continue

        # Provider location override (e.g. Alan Schwartz → Barnegat only)
        loc_override = _get_location_override(pid)

        # Pay-period collections (filtered by location override if applicable)
        pp_rows    = _collections_by_date(pid, payStart, payEnd,
                                          allowed_locations=loc_override)
        pp_total   = round(sum(r["applied_payments"] for r in pp_rows), 2)
        if pp_total <= 0:
            continue

        # Monthly collections for doctor tier (same location override applied)
        mo_rows   = _collections_by_date(pid, monthStart, payEnd,
                                         allowed_locations=loc_override)
        mo_total  = round(sum(r["applied_payments"] for r in mo_rows), 2)

        office = provider_office.get(pid, "Unknown")

        # Build location override transparency fields
        override_info = {}
        if loc_override:
            ovr = PROVIDER_LOCATION_OVERRIDES.get(pid, {})
            override_info = {
                "officeFilterApplied": True,
                "officeFilterLabel":   ovr.get("label", ""),
                "officeFilterBasis":   ovr.get("basis", "procedure_location"),
                "allowedLocationIds":  sorted(loc_override),
            }

        if _is_hygienist(spec):
            rate40 = round(pp_total * 0.40, 2)
            rate45 = round(pp_total * 0.45, 2)
            assigned_rate = 0.45 if name.strip().lower() in HYGIENIST_RATE_45 else 0.40
            comp = round(pp_total * assigned_rate, 2)
            entry = {
                "providerId":      pid,
                "providerName":    name,
                "office":          office,
                "payStart":        payStart,
                "payEnd":          payEnd,
                "ppCollections":   pp_total,
                "comp40":          rate40,
                "comp45":          rate45,
                "assignedRate":    int(assigned_rate * 100),
                "compensation":    comp,
                "status":          "Estimated",
            }
            if override_info:
                entry.update(override_info)
            hygienists.append(entry)
        else:
            rate  = doctor_rate(mo_total)
            comp  = round(pp_total * rate, 2)
            entry = {
                "providerId":      pid,
                "providerName":    name,
                "office":          office,
                "payStart":        payStart,
                "payEnd":          payEnd,
                "ppCollections":   pp_total,
                "moCollections":   mo_total,
                "tierRate":        int(rate * 100),
                "compensation":    comp,
                "status":          "Estimated",
            }
            if override_info:
                entry.update(override_info)
            doctors.append(entry)

    # KPI totals
    total_doc_mo_coll  = round(sum(d["moCollections"] for d in doctors), 2)
    total_doc_comp     = round(sum(d["compensation"]  for d in doctors), 2)
    avg_doc_rate       = round(sum(d["tierRate"] for d in doctors) / len(doctors), 1) if doctors else 0
    total_hyg_pp_coll  = round(sum(h["ppCollections"] for h in hygienists), 2)
    total_hyg_comp40   = round(sum(h["comp40"]        for h in hygienists), 2)
    total_hyg_comp45   = round(sum(h["comp45"]        for h in hygienists), 2)

    return {
        "payStart":   payStart,
        "payEnd":     payEnd,
        "ascendStart": ascendStart,
        "ascendEnd":   ascendEnd,
        "monthStart": monthStart,
        "monthEnd":   monthEnd,
        "kpis": {
            "totalDoctorMonthlyCollections": total_doc_mo_coll,
            "totalDoctorCompensation":       total_doc_comp,
            "avgDoctorCompPct":              avg_doc_rate,
            "totalHygienistPpCollections":   total_hyg_pp_coll,
            "hygienistCompAt40":             total_hyg_comp40,
            "hygienistCompAt45":             total_hyg_comp45,
            "totalTrueUpDue":                0,
            "overpaymentReview":             0,
        },
        "doctors":    sorted(doctors,    key=lambda x: -x["ppCollections"]),
        "hygienists": sorted(hygienists, key=lambda x: -x["ppCollections"]),
        "tiers": {
            "doctor": [
                {"label": "≤$50,000",          "rate": 32},
                {"label": "$50,001–$65,000",    "rate": 33},
                {"label": "$65,001–$80,000",    "rate": 34},
                {"label": "$80,001+",           "rate": 35},
            ],
            "hygienist": {"sherylDubman": 45, "default": 40}
        },
    }

# ── Payroll access check (called by frontend to show/hide the payroll section) ─
@app.get("/v2/auth/payroll-access", tags=["Auth"], dependencies=[Depends(verify_api_key)])
def payroll_access_check(request: Request, userEmail: str = Query(...)):
    """Return only the verified current account's payroll report access."""
    from api_compensation_policy import verified_compensation_actor, has_compensation_access
    from api_identity import AccessFailure
    try:
        actor = verified_compensation_actor(request, PAYROLL_ALLOWED_EMAILS)
