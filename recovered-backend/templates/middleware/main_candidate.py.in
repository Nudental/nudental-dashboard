# ---------------------------------------------------------------------------
# Plaid Integration
# ---------------------------------------------------------------------------

PLAID_CLIENT_ID = __NUDASHBOARD_CONFIG_LITERAL_018__
PLAID_SANDBOX_SECRET = __NUDASHBOARD_CONFIG_LITERAL_019__
PLAID_PRODUCTION_SECRET = __NUDASHBOARD_CONFIG_LITERAL_020__
PLAID_BASE_URL = "https://production.plaid.com"
PLAID_TOKENS_FILE = "/home/openclaw/.config/plaid/access_tokens.json"

def plaid_request(endpoint: str, payload: dict) -> dict:
    import urllib.request as urlreq
    payload["client_id"] = PLAID_CLIENT_ID
    payload["secret"] = PLAID_PRODUCTION_SECRET
    req = urlreq.Request(
        f"{PLAID_BASE_URL}{endpoint}",
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
        method="POST"
    )
    try:
        with urlreq.urlopen(req) as r:
            return json.loads(r.read())
    except urlreq.HTTPError as e:
        return {"error": e.read().decode()}

def load_plaid_tokens(active_only: bool = True) -> dict:
    """Load Plaid access tokens from disk.

    active_only=True (default): returns only items where sync_status is absent
    or explicitly 'active'. Used by nightly cron, /plaid/accounts,
    /plaid/transactions, and all normal sync paths.

    active_only=False: returns all items including 'pending' ones. Used only
    for admin inspection and intentional targeted historical imports.
    """
    if os.path.exists(PLAID_TOKENS_FILE):
        with open(PLAID_TOKENS_FILE) as f:
            all_tokens = json.load(f)
        if active_only:
            return {k: v for k, v in all_tokens.items()
                    if v.get("sync_status", "active") == "active"}
        return all_tokens
    return {}

def load_all_plaid_tokens() -> dict:
    """Load ALL tokens regardless of sync_status. Admin/inspection use only."""
    return load_plaid_tokens(active_only=False)

def save_plaid_tokens(tokens: dict):
    os.makedirs(os.path.dirname(PLAID_TOKENS_FILE), exist_ok=True)
    with open(PLAID_TOKENS_FILE, "w") as f:
        json.dump(tokens, f, indent=2)

@app.post("/plaid/link-token", tags=["Plaid"])
async def plaid_create_link_token(request: Request):
    """Create a Plaid Link token for account connection."""
    body = await request.json() if request.headers.get("content-type") == "application/json" else {}
    user_id = body.get("user_id", "nudental-admin")
    resp = plaid_request("/link/token/create", {
        "client_name": "Nu Dental Dashboard",
        "country_codes": ["US"],
        "language": "en",
        "user": {"client_user_id": user_id},
        "products": ["transactions"],
        "transactions": {"days_requested": 730},
        "redirect_uri": "https://api.nudashboard.com/static/plaid_connect.html"
    })
    if "error" in resp:
        raise HTTPException(status_code=400, detail=resp["error"])
    return resp

@app.post("/plaid/exchange-token", tags=["Plaid"])
async def plaid_exchange_token(request: Request):
    """Exchange a public token for an access token and save it.

    Optional body param: allow_duplicate (bool, default false)
      Set to true ONLY for intentional re-link of an existing institution
      to obtain a new Item with extended history (days_requested=730).
      When allow_duplicate=true:
        - The new item_id is saved alongside the existing one.
        - The existing item is NOT removed automatically.
        - Caller is responsible for manually retiring the old item after
          verifying the new one has the expected transaction history.
      Default (allow_duplicate=false): duplicate institution connections
      are blocked to prevent double-counting and extra billing.
    """
    body = await request.json()
    public_token = body.get("public_token")
    institution_name = body.get("institution_name", "Unknown")
    allow_duplicate = bool(body.get("allow_duplicate", False))

    if not public_token:
        raise HTTPException(status_code=400, detail="public_token required")

    resp = plaid_request("/item/public_token/exchange", {"public_token": public_token})
    if "error" in resp or "access_token" not in resp:
        raise HTTPException(status_code=400, detail=resp)

    tokens = load_plaid_tokens()
    item_id = resp["item_id"]

    # ── Duplicate Item detection ──────────────────────────────────────────────
    # Bypassed only when allow_duplicate=true is explicitly set by the caller.
    # Default behavior: block duplicate connections to prevent double-counting.
    if not allow_duplicate:
        if item_id in tokens:
            existing = tokens[item_id]
            logger.warning(f"Duplicate Item blocked: {institution_name} (item_id={item_id}) already connected at {existing.get('connected_at','?')}")
            return {
                "success": False,
                "duplicate": True,
                "item_id": item_id,
                "institution": institution_name,
                "already_connected_at": existing.get("connected_at"),
                "message": f"{institution_name} is already connected. Duplicate connection blocked to prevent double-counting."
            }

        for existing_item_id, existing_data in tokens.items():
            if existing_data.get("institution_name", "").lower() == institution_name.lower():
                logger.warning(f"Duplicate institution blocked: {institution_name} already connected as item {existing_item_id}")
                return {
                    "success": False,
                    "duplicate": True,
                    "item_id": existing_item_id,
                    "institution": institution_name,
                    "already_connected_at": existing_data.get("connected_at"),
                    "message": f"{institution_name} is already connected (item {existing_item_id}). Remove existing connection first."
                }
    else:
        logger.info(f"allow_duplicate=true: intentional re-link for {institution_name} (new item_id={item_id})")
    # ── End duplicate check ───────────────────────────────────────────────────

    # sync_status: new items added via allow_duplicate=true are stored as
    # 'pending' so nightly cron and normal sync paths ignore them until
    # explicitly activated. Standard new connections are stored as 'active'.
    sync_status = "pending" if allow_duplicate else "active"

    all_tokens = load_all_plaid_tokens()
    all_tokens[item_id] = {
        "access_token": resp["access_token"],
        "item_id": item_id,
        "institution_name": institution_name,
        "connected_at": datetime.now(timezone.utc).isoformat(),
        "sync_status": sync_status,  # 'active' = included in cron; 'pending' = excluded until activated
    }
    save_plaid_tokens(all_tokens)
    return {
        "success": True,
        "item_id": item_id,
        "institution": institution_name,
        "sync_status": sync_status,
        "note": ("Item stored as PENDING — excluded from nightly sync until activated via /plaid/item/{item_id}/activate"
                 if sync_status == "pending" else "Item active and included in nightly sync.")
    }

@app.get("/plaid/accounts", tags=["Plaid"])
async def plaid_get_accounts(include_pending: bool = False):
    """Get all connected accounts with current balances.

    include_pending=false (default): returns accounts from active items only.
    include_pending=true: also includes accounts from pending (relinked) items.
    """
    tokens = load_plaid_tokens(active_only=not include_pending)
    if not tokens:
        return {"accounts": [], "connected_items": 0}

    all_accounts = []
    for item_id, token_data in tokens.items():
        resp = plaid_request("/accounts/get", {"access_token": token_data["access_token"]})
        if "accounts" in resp:
            institution = token_data.get("institution_name", "Unknown")
            for acct in resp["accounts"]:
                acct["institution_name"] = institution
                acct["item_id"] = item_id
                acct["sync_status"] = token_data.get("sync_status", "active")
                all_accounts.append(acct)

    return {
        "accounts": all_accounts,
        "connected_items": len(tokens),
        "total_balance": sum(
            a.get("balances", {}).get("current", 0) or 0
            for a in all_accounts
        )
    }

@app.get("/plaid/transactions", tags=["Plaid"])
async def plaid_get_transactions(days: int = 30):
    """Get transactions for all connected accounts with full pagination.

    Uses Plaid /transactions/get with offset-based pagination (500 per page)
    to retrieve all transactions regardless of total count. Pagination continues
    until the returned page is empty or total_transactions is satisfied.
    """
    tokens = load_plaid_tokens()
    if not tokens:
        return {"transactions": [], "connected_items": 0}

    from datetime import date
    end_date = date.today().isoformat()
    start_date = (date.today() - timedelta(days=days)).isoformat()

    COUNT_PER_PAGE = 500
    all_transactions = []

    for item_id, token_data in tokens.items():
        institution = token_data.get("institution_name", "Unknown")
        offset = 0
        total_available = None  # set from first response

        while True:
            resp = plaid_request("/transactions/get", {
                "access_token": token_data["access_token"],
                "start_date": start_date,
                "end_date": end_date,
                "options": {
                    "count": COUNT_PER_PAGE,
                    "offset": offset,
                }
            })

            page_txns = resp.get("transactions", [])

            # Safety stop: empty page means no more data
            if not page_txns:
                break

            # Tag each transaction with institution name
            for txn in page_txns:
                txn["institution_name"] = institution
            all_transactions.extend(page_txns)

            # Set total from first response if provided by Plaid
            if total_available is None:
                total_available = resp.get("total_transactions")

            offset += len(page_txns)

            # Stop if we have reached or exceeded the reported total
            if total_available is not None and offset >= total_available:
                break

            # Stop if returned page was smaller than requested (last page)
            if len(page_txns) < COUNT_PER_PAGE:
                break

    all_transactions.sort(key=lambda x: x.get("date", ""), reverse=True)
    return {
        "transactions": all_transactions,
        "count": len(all_transactions),
        "period_days": days
    }

@app.get("/plaid/summary", tags=["Plaid"])
async def plaid_summary():
    """Summary of all connected financial accounts for dashboard."""
    tokens = load_plaid_tokens()
    if not tokens:
        return {"connected": False, "items": []}

    from datetime import date
    end_date = date.today().isoformat()
    start_date = (date.today() - timedelta(days=30)).isoformat()

    summary = {"connected": True, "items": [], "totals": {
        "checking_balance": 0, "savings_balance": 0,
        "credit_balance": 0, "credit_limit": 0
    }}

    for item_id, token_data in tokens.items():
        acct_resp = plaid_request("/accounts/get", {"access_token": token_data["access_token"]})
        item_summary = {
            "institution": token_data.get("institution_name"),
            "item_id": item_id,
            "accounts": []
        }
        if "accounts" in acct_resp:
            for a in acct_resp["accounts"]:
                bal = a.get("balances", {})
                acct_type = a.get("type", "")
                acct_sub = a.get("subtype", "")
                current = bal.get("current") or 0
                limit = bal.get("limit") or 0
                item_summary["accounts"].append({
                    "name": a.get("name"),
                    "mask": a.get("mask"),
                    "type": acct_type,
                    "subtype": acct_sub,
                    "current_balance": current,
                    "available_balance": bal.get("available"),
                    "limit": limit
                })
                if acct_type == "depository":
                    if acct_sub == "checking":
                        summary["totals"]["checking_balance"] += current
                    elif acct_sub == "savings":
                        summary["totals"]["savings_balance"] += current
                elif acct_type == "credit":
                    summary["totals"]["credit_balance"] += current
                    summary["totals"]["credit_limit"] += limit

        summary["items"].append(item_summary)

    return summary


# ===========================================================================
# EXPENSE REPORT ENDPOINTS
# Data sources: expenses (AmEx/Plaid), gusto_expense_facts (payroll/benefits),
#               expense_facts (manual/other), gusto_contractor_payments
# ===========================================================================

def _expense_date_filter(date_from: str = None, date_to: str = None,
                          month: int = None, quarter: int = None, year: int = None):
    """Build a (start, end) tuple for date filtering across all expense sources."""
    from datetime import date, timedelta
    import calendar

    if date_from and date_to:
        return date_from, date_to
    if month and year:
        last_day = calendar.monthrange(year, month)[1]
        return f"{year}-{month:02d}-01", f"{year}-{month:02d}-{last_day:02d}"
    if quarter and year:
        q_start = {1: "01-01", 2: "04-01", 3: "07-01", 4: "10-01"}[quarter]
        q_end   = {1: "03-31", 2: "06-30", 3: "09-30", 4: "12-31"}[quarter]
        return f"{year}-{q_start}", f"{year}-{q_end}"
    if year:
        today = date.today()
        if year == today.year:
            # Cap end at today for current year — never project into the future
            return f"{year}-01-01", today.isoformat()
        return f"{year}-01-01", f"{year}-12-31"
    # Default: rolling 90 days
    today = date.today()
    return (today - timedelta(days=90)).isoformat(), today.isoformat()


def _sb_get(path: str) -> list:
    """GET all rows from a Supabase REST path with full pagination.

    Fetches pages of PAGE_SIZE rows until the result set is exhausted,
    then concatenates and returns the complete list.  Callers that expect
    a list (the overwhelming majority) are unaffected — they receive the
    full result set rather than only the first 1,000 rows.

    Safety: stops after MAX_PAGES pages to guard against runaway loops.
    At PAGE_SIZE=1000 and MAX_PAGES=50 the ceiling is 50,000 rows.
    """
    import urllib.request, json as _json

    PAGE_SIZE = 1000
    MAX_PAGES = 50

    cfg  = _load_supabase_config()
    base = cfg["project_url"] + "/rest/v1"
    key  = cfg["secret_key"]

    # Strip any caller-supplied limit/offset so we own pagination entirely.
    # (Most callers do not supply these; this is a defensive measure.)
    import re as _re
    clean_path = _re.sub(r"[&?]limit=\d+", "", path)
    clean_path = _re.sub(r"[&?]offset=\d+", "", clean_path)

    all_rows = []
    for page in range(MAX_PAGES):
        offset = page * PAGE_SIZE
        sep    = "&" if "?" in clean_path else "?"
        url    = f"{base}/{clean_path}{sep}limit={PAGE_SIZE}&offset={offset}"
        req    = urllib.request.Request(url, headers={
            "apikey": key, "Authorization": f"Bearer {key}", "Accept": "application/json"
        })
        with urllib.request.urlopen(req) as r:
            batch = _json.loads(r.read())

        # PostgREST always returns a list for table/view queries; if for any
        # reason a non-list is returned on the first page, pass it through
        # unchanged so callers that expect a dict are not broken.
        if page == 0 and not isinstance(batch, list):
            return batch

        all_rows.extend(batch)

        # Stop when the page is smaller than PAGE_SIZE — no more rows exist.
        if len(batch) < PAGE_SIZE:
            break

    return all_rows


def _load_supabase_config():
    import json, os
    cfg_path = os.path.expanduser("~/.config/supabase/nudental.json")
    with open(cfg_path) as f:
        return json.load(f)


@app.get("/v2/expenses/filters", tags=["Expenses"], dependencies=[Depends(verify_api_key)])
def expense_filters():
    """
    Returns filter metadata for the Expense Report tab dropdowns.
    Sources: canonical_offices, expense_departments, expense_categories, expenses table.
    """
    try:
        offices = _sb_get("canonical_offices?select=id,canonical_name,display_name&order=display_name")
        departments = _sb_get("expense_departments?select=id,name&order=sort_order&is_active=eq.true")
        categories = _sb_get("expense_categories?select=id,name,parent_category_id&order=sort_order&is_active=eq.true")

        # Cardholders from expenses table — posted-only to exclude archived/superseded rows
        raw_cardholders = _sb_get("expenses?select=cardholder_name&source_tab=eq.amex&expense_status=eq.posted")
        cardholders = sorted(set(r["cardholder_name"] for r in raw_cardholders if r.get("cardholder_name")))

        # Cards from expenses table — posted-only to exclude archived/superseded rows
        raw_cards = _sb_get("expenses?select=card_last4&source_tab=eq.amex&expense_status=eq.posted")
        cards = sorted(set(r["card_last4"] for r in raw_cards if r.get("card_last4")))

        # Source types
        source_types = [
            {"value": "amex",    "label": "American Express"},
            {"value": "gusto",   "label": "Gusto Payroll"},
            {"value": "manual",  "label": "Manual Entry"},
            {"value": "plaid",   "label": "Plaid / Bank"},
        ]

        return {
            "offices": [{"id": o["id"], "name": o["display_name"]} for o in offices],
            "departments": [{"id": d["id"], "name": d["name"]} for d in departments],
            "categories": categories,
            "cardholders": cardholders,
            "cards": cards,
            "source_types": source_types,
            "expense_statuses": ["posted", "draft"],
        }
    except Exception as e:
        logger.error(f"expense_filters error: {e}")
        raise HTTPException(500, str(e))


@app.get("/v2/expenses/summary", tags=["Expenses"], dependencies=[Depends(verify_api_key)])
def expense_summary(
    date_from: str = None, date_to: str = None,
    startDate: str = None, endDate: str = None,
    month: int = None, quarter: int = None, year: int = None,
    office: str = None, officeId: str = None, department: str = None
):
    # Accept both param styles
    if not date_from and startDate:
        date_from = startDate
    if not date_to and endDate:
        date_to = endDate
    if not office and officeId:
        office = officeId
    """
    KPI summary for the Expense Report tab.
    Aggregates: expenses (AmEx), gusto_expense_facts (payroll/tax/benefits),
    expense_facts (manual), gusto_contractor_payments.
    """
    try:
        start, end = _expense_date_filter(date_from, date_to, month, quarter, year)

        # ── 1. AmEx expenses (net: charges minus vendor credits/refunds) ──
        # Updated 2026-05-18: Sum ALL posted AmEx rows (positive charges +
        # negative vendor credits/refunds) to get net AmEx expense.
        # AmEx payments are never in expenses table — they are in amex_payments.
        amex_filter = f"expenses?select=amount,category_name,office_name,department_name,expense_date&source_tab=eq.amex&expense_date=gte.{start}&expense_date=lte.{end}&expense_status=eq.posted"
        if office:
            amex_filter += f"&office_name=ilike.*{office}*"
        amex_rows = _sb_get(amex_filter)
        amex_charges = sum(r["amount"] for r in amex_rows if (r["amount"] or 0) > 0)
        amex_credits = sum(r["amount"] for r in amex_rows if (r["amount"] or 0) < 0)
        amex_total = amex_charges + amex_credits  # net: charges minus credits

        # ── 2. Gusto payroll expense facts ────────────────────────────────
        gef_filter = f"gusto_expense_facts?select=expense_category,expense_amount,expense_date,office_name&expense_date=gte.{start}&expense_date=lte.{end}"
        if office:
            gef_filter += f"&office_name=ilike.*{office}*"
        gef_rows = _sb_get(gef_filter)

        payroll_total    = sum(r["expense_amount"] or 0 for r in gef_rows if r["expense_category"] == "Payroll")
        tax_total        = sum(r["expense_amount"] or 0 for r in gef_rows if r["expense_category"] == "Payroll Taxes")
        benefits_total   = sum(r["expense_amount"] or 0 for r in gef_rows if r["expense_category"] == "Benefit Paid")
        contractor_total = sum(r["expense_amount"] or 0 for r in gef_rows if r["expense_category"] == "Contractors Paid")

        # ── 3. Manual expense_facts ───────────────────────────────────────
        ef_filter = f"expense_facts?select=expense_category,expense_amount,expense_date,office_name,expense_source,source_table&expense_date=gte.{start}&expense_date=lte.{end}&expense_source=neq.gusto_payroll"
        if office:
            ef_filter += f"&office_name=ilike.*{office}*"
        ef_rows = _sb_get(ef_filter)

        # Exclude rows sourced from gusto_payroll (already counted in gusto_expense_facts)
        gusto_sources = {"gusto_payroll", "gusto_payroll_runs"}
        gusto_cats    = {"Payroll / Gusto", "Payroll Taxes", "Benefit Paid", "Contractors Paid"}
        manual_rows = [r for r in ef_rows
                       if r.get("expense_category") not in gusto_cats
                       and r.get("expense_source") not in gusto_sources
                       and r.get("source_table") not in {"gusto_payroll_runs", "gusto_expense_facts"}]
        manual_total = sum(r["expense_amount"] or 0 for r in manual_rows)

        # Utility, occupancy, insurance, compliance from manual rows
        util_total       = sum(r["expense_amount"] or 0 for r in manual_rows if "Utilit" in (r.get("expense_category") or ""))
        occupancy_total  = sum(r["expense_amount"] or 0 for r in manual_rows if "Occupan" in (r.get("expense_category") or "") or "Rent" in (r.get("expense_category") or ""))
        insurance_total  = sum(r["expense_amount"] or 0 for r in manual_rows if "Insur" in (r.get("expense_category") or ""))
        compliance_total = sum(r["expense_amount"] or 0 for r in manual_rows if "Complian" in (r.get("expense_category") or "") or "Regulat" in (r.get("expense_category") or ""))

        # ── 4. WF Banking — true operating/vendor expenses only ─────────
        # Protected operating-expense model (restored from Apr 28 backup):
        #   total_expenses = AmEx posted + Gusto payroll/tax/benefits/contractors
        #                    + manual approved + WF direct operating expenses ONLY.
        #   WF→AmEx liability payments are NOT expenses (AmEx charges already counted).
        #   WF→Gusto payroll funding is NOT an expense (Gusto facts already counted).
        #   Corporate shared allocation, internal transfers, EFT clearing,
        #   deposits, income, needs_review — all excluded from total.
        WF_DIRECT_EXPENSE_CLASSES = {
            "main_operating_direct_expense",
        }
        wf_filter = (
            f"expenses?select=amount,category_name,office_name,department_name,expense_date,allocation_metadata"
            f"&source_tab=eq.Banking&expense_date=gte.{start}&expense_date=lte.{end}"
            f"&expense_status=eq.posted"
        )
        if office:
            wf_filter += f"&office_name=ilike.*{office}*"
        wf_rows = _sb_get(wf_filter)
        wf_banking_total = sum(
            r["amount"] for r in wf_rows
            if (r["amount"] or 0) > 0
            and not (r.get("allocation_metadata") or {}).get("excluded_from_expense", False)
            and (r.get("allocation_metadata") or {}).get("wf_classification") in WF_DIRECT_EXPENSE_CLASSES
        )

        # Reference-only WF buckets (NOT in grand_total — for debug/reconciliation)
        wf_payroll_funding = sum(
            r["amount"] for r in wf_rows
            if (r["amount"] or 0) > 0
            and not (r.get("allocation_metadata") or {}).get("excluded_from_expense", False)
            and (r.get("allocation_metadata") or {}).get("wf_classification") == "payroll_funding"
        )
        wf_liability_amex = sum(
            r["amount"] for r in wf_rows
            if (r["amount"] or 0) > 0
            and not (r.get("allocation_metadata") or {}).get("excluded_from_expense", False)
            and (r.get("allocation_metadata") or {}).get("wf_classification") == "liability_payment_amex"
        )
        wf_corp_shared = sum(
            r["amount"] for r in wf_rows
            if (r["amount"] or 0) > 0
            and not (r.get("allocation_metadata") or {}).get("excluded_from_expense", False)
            and (r.get("allocation_metadata") or {}).get("wf_classification") == "corporate_shared_needs_allocation"
        )

        # Protected total: AmEx + Gusto + manual + WF direct operating only
        grand_total = amex_total + payroll_total + tax_total + benefits_total + contractor_total + manual_total + wf_banking_total

        # ── 5. Production context for ratio KPIs (use SQLite — source of truth) ─
        try:
            svc = get_service()
            loc_id = resolve_location_id(None, None)
            prod_data = svc.get_production_summary(start, end, loc_id)
            coll_data = svc.get_collections_summary(start, end, loc_id)
            gross_production  = prod_data.get("grossProduction", 0) or 0
            total_collections = coll_data.get("totalCollections", 0) or 0
        except Exception:
            gross_production  = 0
            total_collections = 0

        def pct(n, d): return round(n / d * 100, 2) if d else None

        return {
            "period": {"start": start, "end": end},
            "totals": {
                "total_expenses": round(grand_total, 2),
                "payroll":        round(payroll_total, 2),
                "payroll_taxes":  round(tax_total, 2),
                "benefits":       round(benefits_total, 2),
                "contractors":    round(contractor_total, 2),
                "amex":           round(amex_total, 2),
                "amex_charges":   round(amex_charges, 2),
                "amex_credits":   round(amex_credits, 2),
                "wf_banking":     round(wf_banking_total, 2),
                "utilities":      round(util_total, 2),
                "occupancy":      round(occupancy_total, 2),
                "insurance":      round(insurance_total, 2),
                "compliance":     round(compliance_total, 2),
                "manual_other":   round(manual_total - util_total - occupancy_total - insurance_total - compliance_total, 2),
            },
            "wf_reference_buckets": {
                "note": "Reference only — NOT included in total_expenses. For reconciliation/debug.",
                "wf_payroll_funding":              round(wf_payroll_funding, 2),
                "wf_liability_payment_amex":       round(wf_liability_amex, 2),
                "wf_corporate_shared_allocation":  round(wf_corp_shared, 2),
            },
            "expense_model": "operating_expense",
            "ratios": {
                "payroll_pct_of_collections":     pct(payroll_total + tax_total, total_collections),
                "payroll_pct_of_production":      pct(payroll_total + tax_total, gross_production),
                "payroll_only_pct_of_collections": pct(payroll_total, total_collections),
                "payroll_only_pct_of_production":  pct(payroll_total, gross_production),
                "expense_pct_of_collections":     pct(grand_total, total_collections),
                "expense_pct_of_production":      pct(grand_total, gross_production),
                "amex_pct_of_total_expenses":     pct(amex_total, grand_total),
                "est_operating_income":           round(total_collections - grand_total, 2) if total_collections else None,
                "est_operating_margin":           pct(total_collections - grand_total, total_collections) if total_collections else None,
            },
            "context": {
                "gross_production": round(gross_production, 2),
                "total_collections": round(total_collections, 2),
                "office_filter": office,
                "department_filter": department,
            }
        }
    except Exception as e:
        logger.error(f"expense_summary error: {e}")
        raise HTTPException(500, str(e))


@app.get("/v2/expenses/lines", tags=["Expenses"], dependencies=[Depends(verify_api_key)])
def expense_lines(
    date_from: str = None, date_to: str = None,
    month: int = None, quarter: int = None, year: int = None,
    office: str = None, department: str = None,
    category: str = None, cardholder: str = None,
    source_type: str = None, card_last4: str = None,
    expense_status: str = None, limit: int = 500, offset: int = 0
):
    """
    Unified line-item table for the Expense Report tab.
    Merges: expenses (AmEx/Plaid) + gusto_expense_facts (payroll) + expense_facts (manual).
    Each row is traceable to its source table + source record ID.
    """
    try:
        start, end = _expense_date_filter(date_from, date_to, month, quarter, year)
        lines = []

        # ── Source 1: expenses table (AmEx / Plaid) ───────────────────────
        if not source_type or source_type in ("amex", "credit_card", "plaid"):
            q = f"expenses?select=*&source_tab=eq.amex&expense_date=gte.{start}&expense_date=lte.{end}&order=expense_date.desc"
            if office:     q += f"&office_name=ilike.*{office}*"
            if department: q += f"&department_name=ilike.*{department}*"
            if cardholder: q += f"&cardholder_name=ilike.*{cardholder}*"
            if card_last4: q += f"&card_last4=eq.{card_last4}"
            # Default to 'posted' only; pass expense_status='archived' explicitly for audit/debug
            effective_status = expense_status if expense_status else "posted"
            q += f"&expense_status=eq.{effective_status}"
            if category:   q += f"&category_name=ilike.*{category}*"
            for r in _sb_get(q):
                # Also exclude superseded rows tagged in allocation_metadata
                # (belt-and-suspenders: catches rows where expense_status couldn't be set)
                if effective_status == "posted" and (r.get("allocation_metadata") or {}).get("superseded"):
                    continue
                lines.append({
                    "id":                r["id"],
                    "expense_date":      r["expense_date"],
                    "posted_date":       r.get("posted_date"),
                    "statement_period":  r.get("statement_period_start"),
                    "office":            r.get("office_name") or "— Unassigned —",
                    "department":        r.get("department_name") or "— Unassigned —",
                    "category":          r.get("category_name") or "American Express / Corporate Card",
                    "subcategory":       r.get("subcategory_name"),
                    "vendor":            r.get("merchant_name") or r.get("vendor_name"),
                    "cardholder":        r.get("cardholder_name"),
                    "card_last4":        r.get("card_last4"),
                    "source_type":       r.get("source_tab") or "amex",
                    "source_tab":        "AmEx",
                    "source_reference":  r.get("source_reference_id"),
                    "amount":            r.get("amount"),
                    "allocation":        r.get("allocation_method") or "direct_to_office",
                    "status":            r.get("expense_status") or "posted",
                    "notes":             r.get("notes"),
                    "_source_table":     "expenses",
                    "_source_id":        r["id"],
                })

        # ── Source 1b: WF Banking direct expenses ─────────────────────────
        if not source_type or source_type in ("banking", "wells_fargo"):
            wf_q = f"expenses?select=*&source_tab=eq.Banking&expense_date=gte.{start}&expense_date=lte.{end}&order=expense_date.desc"
            if office:     wf_q += f"&office_name=ilike.*{office}*"
            if department: wf_q += f"&department_name=ilike.*{department}*"
            if card_last4: wf_q += f"&card_last4=eq.{card_last4}"
            if expense_status: wf_q += f"&expense_status=eq.{expense_status}"
            if category:   wf_q += f"&category_name=ilike.*{category}*"
            for r in _sb_get(wf_q):
                meta = r.get("allocation_metadata") or {}
                if meta.get("excluded_from_expense", False):
                    continue
                if meta.get("wf_classification") != "main_operating_direct_expense":
                    continue
                if (r.get("amount") or 0) <= 0:
                    continue
                lines.append({
                    "id":                r["id"],
                    "expense_date":      r["expense_date"],
                    "posted_date":       r.get("posted_date"),
                    "statement_period":  None,
                    "office":            r.get("office_name") or "— Unassigned —",
                    "department":        r.get("department_name") or "— Unassigned —",
                    "category":          r.get("category_name") or "Banking",
                    "subcategory":       r.get("subcategory_name"),
                    "vendor":            r.get("merchant_name") or r.get("vendor_name"),
                    "cardholder":        r.get("cardholder_name"),
                    "card_last4":        r.get("card_last4"),
                    "source_type":       "banking",
                    "source_tab":        "Banking",
                    "source_reference":  r.get("source_reference_id"),
                    "amount":            r.get("amount"),
                    "allocation":        r.get("allocation_method") or "direct_to_office",
                    "status":            r.get("expense_status") or "posted",
                    "notes":             r.get("notes"),
                    "_source_table":     "expenses",
                    "_source_id":        r["id"],
                })

        # ── Source 2: gusto_expense_facts (payroll / benefits / contractors) ──
        if not source_type or source_type in ("gusto", "payroll"):
            q = f"gusto_expense_facts?select=*&expense_date=gte.{start}&expense_date=lte.{end}&order=expense_date.desc"
            if office: q += f"&office_name=ilike.*{office}*"
            if category: q += f"&expense_category=ilike.*{category}*"
            for r in _sb_get(q):
                if r.get("expense_amount") and r["expense_amount"] > 0:
                    lines.append({
                        "id":               r["id"],
                        "expense_date":     r["expense_date"],
                        "posted_date":      r.get("expense_date"),
                        "statement_period": r.get("pay_period_start"),
                        "office":           r.get("office_name") or "— Unassigned —",
                        "department":       None,
                        "category":         r.get("expense_category"),
                        "subcategory":      r.get("expense_subcategory"),
                        "vendor":           r.get("gusto_employee_name") or "Gusto Payroll",
                        "cardholder":       None,
                        "card_last4":       None,
                        "source_type":      "gusto",
                        "source_tab":       "Payroll",
                        "source_reference": r.get("source_id"),
                        "amount":           r.get("expense_amount"),
                        "allocation":       "direct_to_office",
                        "status":           "posted",
                        "notes":            f"Pay period: {r.get('pay_period_start')} – {r.get('pay_period_end')}",
                        "_source_table":    r.get("source_table") or "gusto_expense_facts",
                        "_source_id":       r.get("source_id") or r["id"],
                    })

        # ── Source 3: expense_facts (manual + other) — exclude gusto dupes ──
        gusto_source_ids = {l["source_reference"] for l in lines if l["source_type"] == "gusto"}
        if not source_type or source_type == "manual":
            q = f"expense_facts?select=*&expense_date=gte.{start}&expense_date=lte.{end}&expense_source=neq.gusto_payroll&order=expense_date.desc"
            if office:   q += f"&office_name=ilike.*{office}*"
            if category: q += f"&expense_category=ilike.*{category}*"
            for r in _sb_get(q):
                if r.get("source_id") in gusto_source_ids:
                    continue  # deduplicate
                if r.get("expense_amount") and r["expense_amount"] > 0:
                    lines.append({
                        "id":               r["id"],
                        "expense_date":     r["expense_date"],
                        "posted_date":      r.get("expense_date"),
                        "statement_period": None,
                        "office":           r.get("office_name") or "— Unassigned —",
                        "department":       None,
                        "category":         r.get("expense_category") or "Other",
                        "subcategory":      r.get("expense_subcategory"),
                        "vendor":           r.get("gusto_employee_name"),
                        "cardholder":       None,
                        "card_last4":       None,
                        "source_type":      r.get("expense_source") or "manual",
                        "source_tab":       "Manual",
                        "source_reference": r.get("source_id"),
                        "amount":           r.get("expense_amount"),
                        "allocation":       "direct_to_office",
                        "status":           "posted",
                        "notes":            None,
                        "_source_table":    r.get("source_table") or "expense_facts",
                        "_source_id":       r.get("source_id") or r["id"],
                    })

        # Sort unified result by date desc, apply pagination
        lines.sort(key=lambda x: x["expense_date"] or "0000-00-00", reverse=True)
        total = len(lines)
        page  = lines[offset: offset + limit]

        return {
            "total": total,
            "offset": offset,
            "limit": limit,
            "period": {"start": start, "end": end},
            "lines": page,
        }
    except Exception as e:
        logger.error(f"expense_lines error: {e}")
        raise HTTPException(500, str(e))


@app.get("/v2/expenses/breakdown", tags=["Expenses"], dependencies=[Depends(verify_api_key)])
def expense_breakdown(
    date_from: str = None, date_to: str = None,
    startDate: str = None, endDate: str = None,
    month: int = None, quarter: int = None, year: int = None,
    group_by: str = "category",  # office | department | category | vendor | cardholder | month | source_type
    office: str = None
):
    # Accept both param styles
    if not date_from and startDate:
        date_from = startDate
    if not date_to and endDate:
        date_to = endDate
    """
    Grouped expense totals for charts and pivot tables.
    group_by: office | department | category | vendor | cardholder | month | source_type
    """
    try:
        start, end = _expense_date_filter(date_from, date_to, month, quarter, year)
        from collections import defaultdict

        buckets = defaultdict(float)

        # AmEx lines
        amex_q = f"expenses?select=amount,category_name,office_name,department_name,cardholder_name,expense_date,source_tab&source_tab=eq.amex&expense_date=gte.{start}&expense_date=lte.{end}&expense_status=eq.posted"
        if office: amex_q += f"&office_name=ilike.*{office}*"
        for r in _sb_get(amex_q):
            amt = r.get("amount") or 0
            if amt <= 0: continue
            if group_by == "office":       key = r.get("office_name") or "Unassigned"
            elif group_by == "department": key = r.get("department_name") or "Unassigned"
            elif group_by == "category":   key = r.get("category_name") or "AmEx"
            elif group_by == "cardholder": key = r.get("cardholder_name") or "Unknown"
            elif group_by == "month":      key = (r.get("expense_date") or "")[:7]
            elif group_by == "source_type":key = "American Express"
            else:                          key = r.get("category_name") or "AmEx"
            buckets[key] += amt

        # Gusto payroll lines
        gef_q = f"gusto_expense_facts?select=expense_amount,expense_category,expense_date,office_name&expense_date=gte.{start}&expense_date=lte.{end}"
        if office: gef_q += f"&office_name=ilike.*{office}*"
        for r in _sb_get(gef_q):
            amt = r.get("expense_amount") or 0
            if amt <= 0: continue
            if group_by == "office":       key = r.get("office_name") or "Unassigned"
            elif group_by == "category":   key = r.get("expense_category") or "Payroll"
            elif group_by == "month":      key = (r.get("expense_date") or "")[:7]
            elif group_by == "source_type":key = "Gusto Payroll"
            else:                          key = r.get("expense_category") or "Payroll"
            buckets[key] += amt

        # Manual expense_facts
        ef_q = f"expense_facts?select=expense_amount,expense_category,expense_date,office_name&expense_date=gte.{start}&expense_date=lte.{end}"
        if office: ef_q += f"&office_name=ilike.*{office}*"
        gusto_cats = {"Payroll / Gusto", "Payroll Taxes", "Benefit Paid", "Contractors Paid"}
        for r in _sb_get(ef_q):
            if r.get("expense_category") in gusto_cats: continue
            amt = r.get("expense_amount") or 0
            if amt <= 0: continue
            if group_by == "office":       key = r.get("office_name") or "Unassigned"
            elif group_by == "category":   key = r.get("expense_category") or "Other"
            elif group_by == "month":      key = (r.get("expense_date") or "")[:7]
            elif group_by == "source_type":key = "Manual"
            else:                          key = r.get("expense_category") or "Other"
            buckets[key] += amt

        # WF Banking direct expenses
        wf_bd_q = (
            f"expenses?select=amount,category_name,office_name,expense_date,allocation_metadata"
            f"&source_tab=eq.Banking&expense_date=gte.{start}&expense_date=lte.{end}"
        )
        if office: wf_bd_q += f"&office_name=ilike.*{office}*"
        for r in _sb_get(wf_bd_q):
            meta = r.get("allocation_metadata") or {}
            if meta.get("excluded_from_expense", False):
                continue
            if meta.get("wf_classification") != "main_operating_direct_expense":
                continue
            amt = r.get("amount") or 0
            if amt <= 0: continue
            if group_by == "office":       key = r.get("office_name") or "Unassigned"
            elif group_by == "category":   key = r.get("category_name") or "Banking"
            elif group_by == "month":      key = (r.get("expense_date") or "")[:7]
            elif group_by == "source_type":key = "Wells Fargo Banking"
            else:                          key = r.get("category_name") or "Banking"
            buckets[key] += amt

        total = sum(buckets.values())
        rows = sorted(
            [{"group": k, "amount": round(v, 2), "pct": round(v / total * 100, 2) if total else 0}
             for k, v in buckets.items()],
            key=lambda x: x["amount"], reverse=True
        )
        return {"group_by": group_by, "period": {"start": start, "end": end},
                "total": round(total, 2), "rows": rows}
    except Exception as e:
        logger.error(f"expense_breakdown error: {e}")
        raise HTTPException(500, str(e))


@app.get("/v2/expenses/amex", tags=["Expenses"], dependencies=[Depends(verify_api_key)])
def expense_amex(
    date_from: str = None, date_to: str = None,
    month: int = None, quarter: int = None, year: int = None,
    office: str = None, department: str = None,
    cardholder: str = None, card_last4: str = None,
    category: str = None, limit: int = 500, offset: int = 0,
    include_archived: bool = False
):
    """
    AmEx-specific expense data with full cardholder + card + merchant dimensions.
    Source: expenses table where source_tab = 'amex'.
    Default: returns only posted, non-superseded rows (include_archived=false).
    Pass include_archived=true to include archived/superseded rows for audit/debug.
    """
    try:
        start, end = _expense_date_filter(date_from, date_to, month, quarter, year)
        from collections import defaultdict

        q = f"expenses?select=*&source_tab=eq.amex&expense_date=gte.{start}&expense_date=lte.{end}&order=expense_date.desc"
        if not include_archived:
            # Default: exclude archived/superseded rows (normal user-facing view)
            q += "&expense_status=eq.posted"
        if office:     q += f"&office_name=ilike.*{office}*"
        if department: q += f"&department_name=ilike.*{department}*"
        if cardholder: q += f"&cardholder_name=ilike.*{cardholder}*"
        if card_last4: q += f"&card_last4=eq.{card_last4}"
        if category:   q += f"&category_name=ilike.*{category}*"

        rows = _sb_get(q)

        # Post-fetch: also exclude superseded rows tagged in allocation_metadata
        # (handles the case where expense_status could not be set to 'archived')
        if not include_archived:
            rows = [r for r in rows
                    if not (r.get("allocation_metadata") or {}).get("superseded")]

        # Aggregate summaries
        by_card    = defaultdict(float)
        by_merchant= defaultdict(float)
        by_office  = defaultdict(float)
        by_dept    = defaultdict(float)
        by_month   = defaultdict(float)

        for r in rows:
            amt = r.get("amount") or 0
            if amt <= 0: continue
            by_card[r.get("card_last4") or "unknown"]      += amt
            by_merchant[r.get("merchant_name") or "Other"] += amt
            by_office[r.get("office_name") or "Unassigned"]+= amt
            by_dept[r.get("department_name") or "Unassigned"]+= amt
            by_month[(r.get("expense_date") or "")[:7]]    += amt

        total_spend    = sum(r.get("amount") or 0 for r in rows if (r.get("amount") or 0) > 0)
        total_refunds  = abs(sum(r.get("amount") or 0 for r in rows if (r.get("amount") or 0) < 0))
        unique_merchants = len(set(r.get("merchant_name") for r in rows if r.get("merchant_name")))
        unique_cards     = len(set(r.get("card_last4") for r in rows if r.get("card_last4")))

        page = rows[offset: offset + limit]
        lines = [{
            "id":              r["id"],
            "expense_date":    r["expense_date"],
            "posted_date":     r.get("posted_date"),
            "office":          r.get("office_name") or "— Unassigned —",
            "department":      r.get("department_name") or "— Unassigned —",
            "category":        r.get("category_name") or "Other",
            "subcategory":     r.get("subcategory_name"),
            "merchant":        r.get("merchant_name") or r.get("notes"),
            "cardholder":      r.get("cardholder_name"),
            "card_last4":      r.get("card_last4"),
            "amount":          r.get("amount"),
            "status":          r.get("expense_status") or "posted",
            "source_reference":r.get("source_reference_id"),
            "notes":           r.get("notes"),
            "allocation":      r.get("allocation_method") or "direct_to_office",
        } for r in page]

        return {
            "period":        {"start": start, "end": end},
            "total":         len(rows),
            "offset":        offset,
            "limit":         limit,
            "summary": {
                "total_spend":        round(total_spend, 2),
                "total_refunds":      round(total_refunds, 2),
                "net_spend":          round(total_spend - total_refunds, 2),
                "unique_merchants":   unique_merchants,
                "unique_cards":       unique_cards,
                "by_card":    {k: round(v, 2) for k, v in sorted(by_card.items(), key=lambda x: -x[1])},
                "by_merchant":{k: round(v, 2) for k, v in sorted(by_merchant.items(), key=lambda x: -x[1])[:20]},
                "by_office":  {k: round(v, 2) for k, v in sorted(by_office.items(), key=lambda x: -x[1])},
                "by_dept":    {k: round(v, 2) for k, v in sorted(by_dept.items(), key=lambda x: -x[1])},
                "by_month":   dict(sorted(by_month.items())),
            },
            "lines": lines,
        }
    except Exception as e:
        logger.error(f"expense_amex error: {e}")
        raise HTTPException(500, str(e))


@app.get("/v2/expenses/payroll", tags=["Expenses"], dependencies=[Depends(verify_api_key)])
def expense_payroll(
    date_from: str = None, date_to: str = None,
    month: int = None, quarter: int = None, year: int = None,
    office: str = None
):
    """
    Payroll expense rollup for the Expense Report tab.
    Sources: gusto_payroll_runs (run-level totals) + gusto_expense_facts (by category).
    """
    try:
        start, end = _expense_date_filter(date_from, date_to, month, quarter, year)

        # Run-level totals from gusto_payroll_runs
        runs_q = f"gusto_payroll_runs?select=check_date,pay_period_start,pay_period_end,total_net_pay,total_payable_tax,total_debit_amount,total_reimbursement&check_date=gte.{start}&check_date=lte.{end}&order=check_date.desc"
        runs = _sb_get(runs_q)

        # Category breakdown from gusto_expense_facts
        gef_q = f"gusto_expense_facts?select=expense_category,expense_subcategory,expense_amount,expense_date,office_name,office_mapping_status&expense_date=gte.{start}&expense_date=lte.{end}"
        if office: gef_q += f"&office_name=ilike.*{office}*"
        gef = _sb_get(gef_q)

        from collections import defaultdict
        by_cat    = defaultdict(float)
        by_office = defaultdict(float)
        by_month  = defaultdict(float)

        for r in gef:
            amt = r.get("expense_amount") or 0
            by_cat[r.get("expense_category") or "Other"]    += amt
            by_office[r.get("office_name") or "Unassigned"] += amt
            by_month[(r.get("expense_date") or "")[:7]]     += amt

        # Contractor payments
        cp_q = f"gusto_contractor_payments?select=check_date,total_amount,contractor_display_name&check_date=gte.{start}&check_date=lte.{end}&funded=eq.true"
        contractors = _sb_get(cp_q)
        contractor_total = sum(r.get("total_amount") or 0 for r in contractors)

        # Run totals
        total_net         = sum(r.get("total_net_pay") or 0 for r in runs)
        total_tax         = sum(r.get("total_payable_tax") or 0 for r in runs)
        total_debit       = sum(r.get("total_debit_amount") or 0 for r in runs)
        total_reimburse   = sum(r.get("total_reimbursement") or 0 for r in runs)

        return {
            "period": {"start": start, "end": end},
            "payroll_runs": {
                "count":             len(runs),
                "total_net_pay":     round(total_net, 2),
                "total_payroll_tax": round(total_tax, 2),
                "total_debit":       round(total_debit, 2),
                "total_reimbursements": round(total_reimburse, 2),
            },
            "by_category": {k: round(v, 2) for k, v in sorted(by_cat.items(), key=lambda x: -x[1])},
            "by_office":   {k: round(v, 2) for k, v in sorted(by_office.items(), key=lambda x: -x[1])},
            "by_month":    dict(sorted(by_month.items())),
            "contractors": {
                "count":  len(contractors),
                "total":  round(contractor_total, 2),
            },
            "runs_detail": [{
                "check_date":       r["check_date"],
                "pay_period_start": r.get("pay_period_start"),
                "pay_period_end":   r.get("pay_period_end"),
                "net_pay":          r.get("total_net_pay"),
                "payroll_tax":      r.get("total_payable_tax"),
                "total_debit":      r.get("total_debit_amount"),
                "reimbursements":   r.get("total_reimbursement"),
            } for r in runs],
        }
    except Exception as e:
        logger.error(f"expense_payroll error: {e}")
        raise HTTPException(500, str(e))



# ---------------------------------------------------------------------------
# WF (Wells Fargo) expense accounts — office checking accounts via Plaid
# ---------------------------------------------------------------------------
WF_ACCOUNT_MAP = __NUDASHBOARD_CONFIG_LITERAL_021__

@app.get("/v2/expenses/wf", tags=["Expenses"], dependencies=[Depends(verify_api_key)])
def wf_expenses(
    date_from: str = None, date_to: str = None,
    startDate: str = None, endDate: str = None,
    month: int = None, quarter: int = None, year: int = None,
    office: str = None, pending: str = None,
    limit: int = 500, offset: int = 0
):
    """
    Wells Fargo office checking account transactions via Plaid.
    Maps account_id to office using WF_ACCOUNT_MAP.
    Amounts follow Plaid sign convention: positive = debit (money out), negative = credit (money in).
    """
    try:
        if not date_from: date_from = startDate
        if not date_to: date_to = endDate
        # Sanitize JS-side "undefined"/"null" strings
        if date_from in ("undefined", "null", ""): date_from = None
        if date_to in ("undefined", "null", ""): date_to = None
        start, end = _expense_date_filter(date_from, date_to, month, quarter, year)
        tokens = load_plaid_tokens()

        wf_token = None
        for item_id, token_data in tokens.items():
            if token_data.get("institution_name") == "Wells Fargo":
                wf_token = token_data["access_token"]
                break

        if not wf_token:
            return {"total": 0, "period": {"start": start, "end": end}, "lines": [], "accounts": WF_ACCOUNT_MAP}

        wf_account_ids = list(WF_ACCOUNT_MAP.keys())
        all_txns = []
        plaid_offset = 0
        while True:
            resp = plaid_request("/transactions/get", {
                "access_token": wf_token,
                "start_date": start,
                "end_date": end,
                "options": {
                    "account_ids": wf_account_ids,
                    "count": 500,
                    "offset": plaid_offset
                }
            })
            batch = resp.get("transactions", [])
            all_txns.extend(batch)
            total_plaid = resp.get("total_transactions", len(all_txns))
            if len(all_txns) >= total_plaid or not batch:
                break
            plaid_offset += len(batch)

        lines = []
        for t in all_txns:
            acct_id = t.get("account_id", "")
            acct_info = WF_ACCOUNT_MAP.get(acct_id, {})
            office_name = acct_info.get("office", "Unknown")
            mask = acct_info.get("mask", "")
            is_pending = t.get("pending", False)

            if office and office not in ("All Offices", "all", "") and office != office_name:
                continue
            if pending == "posted" and is_pending:
                continue
            if pending == "pending" and not is_pending:
                continue

            # Only show expenses (debits). In Plaid: positive = money out, negative = money in.
            if (t.get("amount") or 0) < 0:
                continue

            pfc = t.get("personal_finance_category") or {}
            lines.append({
                "transaction_id":  t.get("transaction_id"),
                "date":            t.get("date"),
                "authorized_date": t.get("authorized_date"),
                "name":            t.get("name"),
                "merchant_name":   t.get("merchant_name") or t.get("name"),
                "amount":          t.get("amount"),
                "account_id":      acct_id,
                "account_mask":    mask,
                "office_name":     office_name,
                "category":        pfc.get("primary") or "Other",
                "category_detail": pfc.get("detailed") or "",
                "payment_channel": t.get("payment_channel"),
                "check_number":    t.get("check_number"),
                "pending":         is_pending,
                "status":          "pending" if is_pending else "posted",
            })

        lines.sort(key=lambda x: x["date"] or "0000-00-00", reverse=True)
        total = len(lines)
        page = lines[offset: offset + limit]

        by_office = {}
        for ln in lines:
            o = ln["office_name"]
            if o not in by_office:
                by_office[o] = {"office": o, "debits": 0.0, "credits": 0.0, "count": 0}
            amt = ln["amount"] or 0
            if amt >= 0:
                by_office[o]["debits"] += amt
            else:
                by_office[o]["credits"] += abs(amt)
            by_office[o]["count"] += 1

        total_debits  = sum(v["debits"]  for v in by_office.values())
        total_credits = sum(v["credits"] for v in by_office.values())

        return {
            "total":   total,
            "period":  {"start": start, "end": end},
            "summary": {
                "total_debits":      round(total_debits, 2),
                "total_credits":     round(total_credits, 2),
                "net":               round(total_debits - total_credits, 2),
                "transaction_count": len(lines),
                "by_office":         sorted(by_office.values(), key=lambda x: x["debits"], reverse=True),
            },
            "lines":   page,
            "accounts": {k: v for k, v in WF_ACCOUNT_MAP.items()},
        }
    except Exception as e:
        logger.error(f"wf_expenses error: {e}")
        raise HTTPException(500, str(e))


# ===========================================================================
# PAYROLL PROXY ENDPOINTS — Service-key proxied reads for Gusto tables
# RLS blocks anon key from gusto_* tables; these endpoints use the service key
# Frontend should call these instead of Supabase directly for payroll data.
# ===========================================================================

def _sb_get_full(path: str, max_rows: int = 5000, strict: bool = False) -> list:
    """GET all rows from Supabase with pagination, up to max_rows."""
    import urllib.request, json
    cfg = _load_supabase_config()
    base = cfg["project_url"] + "/rest/v1"
    key  = cfg["secret_key"]
    all_rows, offset, page_size = [], 0, 1000
    while offset < max_rows:
        sep = "&" if "?" in path else "?"
        url = f"{base}/{path}{sep}limit={page_size}&offset={offset}"
        req = urllib.request.Request(url, headers={
            "apikey": key, "Authorization": f"Bearer {key}",
            "Accept": "application/json", "Range": f"{offset}-{offset+page_size-1}"
        })
        try:
            with urllib.request.urlopen(req, timeout=30 if strict else None) as r:
                batch = json.loads(r.read())
                if strict and not isinstance(batch, list):
                    raise ValueError("Invalid Supabase response")
                if not batch:
                    break
                all_rows.extend(batch)
                if len(batch) < page_size:
                    break
                offset += page_size
        except Exception:
            if strict:
                raise
            break
    if strict and offset >= max_rows:
        raise ValueError("Complete source exceeds bounded reader")
    return all_rows


@app.get("/v2/payroll/runs", tags=["Payroll"], dependencies=[Depends(verify_api_key)])
def payroll_runs(
    startDate: Optional[str] = Query(None),
    endDate:   Optional[str] = Query(None),
    off_cycle: Optional[bool] = Query(None),
    status: Optional[str] = Query(None),
    run_by_user_name: Optional[str] = Query(None),
    sort: Optional[str] = Query(None),
    limit:     int = Query(200),
    offset:    int = Query(0),
):
    """Proxy read of gusto_payroll_runs using service key (bypasses RLS)."""
    try:
        start = startDate or "2020-01-01"
        end   = endDate   or "2099-12-31"
        q = f"gusto_payroll_runs?select=*&check_date=gte.{start}&check_date=lte.{end}&order=check_date.desc"
        rows = _sb_get_full(q)
        # Honor imported-run filters and requested order before total/pagination.
        if off_cycle is not None:
            rows = [row for row in rows if row.get("off_cycle") is off_cycle]
        if status and status != "all":
            rows = [row for row in rows if status in ("processed", "reversed", "needs_reprocessing") and row.get(status) is True]
        if run_by_user_name is not None:
            rows = [row for row in rows if str(row.get("run_by_user_name") or "") == run_by_user_name]
        if sort == "check_date:asc":
            rows = sorted(rows, key=lambda row: str(row.get("check_date") or ""))
        page = rows[offset: offset + limit]
        return {"total": len(rows), "offset": offset, "limit": limit, "data": page}
    except Exception as e:
        logger.error(f"payroll_runs error: {e}")
        raise HTTPException(500, str(e))


@app.get("/v2/payroll/contractors", tags=["Payroll"], dependencies=[Depends(verify_api_key)])
def payroll_contractors(
    request: Request,
    summaryOnly: Optional[bool] = Query(None),
    startDate: Optional[str] = Query(None),
    endDate: Optional[str] = Query(None),
    search: Optional[str] = Query(None, max_length=100),
    wage_type: Optional[str] = Query(None, max_length=50),
    funded: Optional[bool] = Query(None),
    cancelled: Optional[bool] = Query(None),
    sort: str = Query("check_date:desc"),
    limit: int = Query(50, ge=1, le=200),
    offset: int = Query(0, ge=0),
):
    """Read imported payments with existing session/role grants; never sync Gusto."""
    from datetime import date
    from decimal import Decimal
    from urllib.parse import urlencode
    from otp_auth import _get_user_from_request, _get_user_profile

    # Reuse the Dashboard's existing identity validation and tab permission keys.
    # Old clients cannot safely interpret raw payment amounts as paid spending.
    if summaryOnly is None:
        raise HTTPException(status_code=409, detail="Refresh the Dashboard to load contractor data.")
    try:
        user = _get_user_from_request(request)
        profile = _get_user_profile(user["id"])
        if not profile or profile.get("is_active") is not True:
            raise HTTPException(status_code=403, detail="An active Dashboard profile is required.")
        if profile.get("role") != "super_admin":
            permissions = _sb_get_full("role_permissions?" + urlencode({
                "select": "permission,enabled", "role": "eq." + str(profile.get("role") or ""),
            }), strict=True)
            allowed = {row.get("permission") for row in permissions if row.get("enabled") is True}
            required = {"finance.payroll.gusto.contractors.view"}
            if summaryOnly:
                required.add("finance.payroll.gusto.overview.view")
            if not allowed.intersection(required):
                raise HTTPException(status_code=403, detail="Contractor access is not enabled for your role.")
        for value in [startDate, endDate]:
            if value is not None:
                try:
                    if date.fromisoformat(value).isoformat() != value:
                        raise ValueError()
                except ValueError:
                    raise HTTPException(status_code=422, detail="Dates must use YYYY-MM-DD.")
        if startDate and endDate and startDate > endDate:
            raise HTTPException(status_code=422, detail="Start date must not follow end date.")
        if sort not in ("check_date:desc", "check_date:asc"):
            raise HTTPException(status_code=422, detail="Unsupported contractor sort order.")
        fields = "id,contractor_id,contractor_name,contractor_display_name,check_date,payment_method,wage_type,hours_worked,hourly_rate,wage,bonus,reimbursement,total_amount,funded,cancelled,memo"
        params = [("select", fields), ("order", "check_date.desc,id.asc")]
        if startDate:
            params.append(("check_date", "gte." + startDate))
        if endDate:
            params.append(("check_date", "lte." + endDate))
        rows = _sb_get_full("gusto_contractor_payments?" + urlencode(params), strict=True)
        if search:
            term = search.strip().casefold()
            rows = [r for r in rows if any(term in str(r.get(k) or "").casefold() for k in ("contractor_name", "contractor_display_name"))]
        if wage_type and wage_type != "all":
            rows = [r for r in rows if str(r.get("wage_type") or "").casefold() == wage_type.casefold()]
        if funded is not None:
            rows = [r for r in rows if r.get("funded") is funded]
        if cancelled is not None:
            rows = [r for r in rows if r.get("cancelled") is cancelled]
        rows.sort(key=lambda r: str(r.get("id") or ""))
        rows.sort(key=lambda r: str(r.get("check_date") or ""), reverse=sort == "check_date:desc")
        paid = Decimal("0")
        annual = {}
        for row in rows:
            year = str(row.get("check_date") or "")[:4]
            if len(year) != 4 or not year.isdigit():
                raise ValueError("Incomplete contractor dates")
            annual.setdefault(year, Decimal("0"))
            if row.get("funded") is True and row.get("cancelled") is not True:
                value = Decimal(str(row["total_amount"]))
                if not value.is_finite():
                    raise ValueError("Invalid contractor amount")
                paid += value
                annual[year] += value
        summary = {
            "paidAmount": float(paid),
            "uniqueContractors": len({r["contractor_id"] for r in rows}) if all(r.get("contractor_id") for r in rows) else None,
            "unidentifiedPayments": sum(not (r.get("contractor_id") or r.get("contractor_display_name") or r.get("contractor_name")) for r in rows),
            "annualPaid": [{"year": year, "amount": float(value)} for year, value in sorted(annual.items())],
            "scope": "company-wide",
            "paidDefinition": "Funded and not canceled",
        }
        return {"data": [] if summaryOnly else rows[offset:offset + limit], "total": len(rows), "summary": summary}
    except HTTPException:
        raise
    except Exception:
        raise HTTPException(status_code=503, detail="Contractor data is unavailable. Please retry.")


@app.get("/v2/payroll/employees", tags=["Payroll"], dependencies=[Depends(verify_api_key)])
def payroll_employees(
    status:  Optional[str] = Query(None),
    id: Optional[str] = Query(None),
    search: Optional[str] = Query(None),
    work_state: Optional[str] = Query(None),
    employment_type: Optional[str] = Query(None),
    benefits_enrolled: Optional[bool] = Query(None),
    benefits_eligible: Optional[bool] = Query(None),
    limit:   int = Query(200),
    offset:  int = Query(0),
):
    """Proxy read of gusto_employees using service key (bypasses RLS)."""
    try:
        q = "gusto_employees?select=*&order=last_name.asc,first_name.asc"
        if status:
            q += f"&status=eq.{status}"
        rows = _sb_get_full(q)
        # Apply the existing UI filters before counting and paginating imported rows.
        if id is not None:
            rows = [row for row in rows if str(row.get("id")) == id]
        for field, value in (("work_state", work_state), ("employment_type", employment_type)):
            if value is not None:
                rows = [row for row in rows if str(row.get(field) or "").casefold() == value.casefold()]
        for field, value in (("benefits_enrolled", benefits_enrolled), ("benefits_eligible", benefits_eligible)):
            if value is not None:
                rows = [row for row in rows if row.get(field) is value]
        if search and search.strip():
            term = search.strip().casefold()
            rows = [row for row in rows if term in " ".join(str(row.get(field) or "") for field in ("first_name", "last_name", "email")).casefold()]
        page = rows[offset: offset + limit]
        return {"total": len(rows), "offset": offset, "limit": limit, "data": page}
    except Exception as e:
        logger.error(f"payroll_employees error: {e}")
        raise HTTPException(500, str(e))


@app.get("/v2/payroll/expense-facts", tags=["Payroll"], dependencies=[Depends(verify_api_key)])
def payroll_expense_facts(
    startDate: Optional[str] = Query(None),
    endDate:   Optional[str] = Query(None),
    category:  Optional[str] = Query(None),
    limit:     int = Query(500),
    offset:    int = Query(0),
):
    """Proxy read of gusto_expense_facts using service key (bypasses RLS)."""
    try:
        start = startDate or "2020-01-01"
        end   = endDate   or "2099-12-31"
        q = f"gusto_expense_facts?select=*&expense_date=gte.{start}&expense_date=lte.{end}&order=expense_date.desc"
        if category:
            q += f"&expense_category=eq.{category}"
        rows = _sb_get_full(q)
        page = rows[offset: offset + limit]
        return {"total": len(rows), "offset": offset, "limit": limit, "data": page}
    except Exception as e:
        logger.error(f"payroll_expense_facts error: {e}")
        raise HTTPException(500, str(e))


@app.get("/v2/payroll/crosswalk", tags=["Payroll"], dependencies=[Depends(verify_api_key)])
def payroll_crosswalk(
    mappingStatus: Optional[str] = Query(None),
    gusto_employee_id: Optional[str] = Query(None),
    officeId:      Optional[str] = Query(None),
    limit:         int = Query(500),
    offset:        int = Query(0),
):
    """Proxy read of gusto_provider_crosswalk using service key (bypasses RLS)."""
    try:
        q = "gusto_provider_crosswalk?select=*&order=created_at.desc"
        if mappingStatus:
            q += f"&mapping_status=eq.{mappingStatus}"
        if officeId:
            q += f"&office_id=eq.{officeId}"
        rows = _sb_get_full(q)
        if gusto_employee_id is not None:
            rows = [row for row in rows if str(row.get("gusto_employee_id")) == gusto_employee_id]
        page = rows[offset: offset + limit]
        return {"total": len(rows), "offset": offset, "limit": limit, "data": page}
    except Exception as e:
        logger.error(f"payroll_crosswalk error: {e}")
        raise HTTPException(500, str(e))


@app.get("/v2/payroll/comparison", tags=["Payroll"], dependencies=[Depends(verify_api_key)])
def payroll_comparison(
    startDate:      str           = Query(...,  description="Pay period start (YYYY-MM-DD)"),
    endDate:        str           = Query(...,  description="Pay period end (YYYY-MM-DD)"),
    providerId:     Optional[str] = Query(None, description="Filter by Dentrix provider ID"),
    providerType:   Optional[str] = Query(None, description="Filter by type: doctor | hygienist"),
    checkDate:      Optional[str] = Query(None, description="Match Gusto actuals by check date instead of pay period"),
    payrollRunId:   Optional[str] = Query(None, description="Match Gusto actuals by payroll run ID"),
    limit:          int            = Query(500),
    offset:         int            = Query(0),
):
    """
    Phase 2 — Payroll Comparison: Dentrix expected pay vs Gusto XLSX actual gross pay.

    Expected pay source (unchanged from Phase 1):
      - distribution_lines, charge-allocated (source_table IN patient_payments, insurance_payments)
      - transaction_date basis (provider attribution via procedure_provider_id)
      - Doctor tier: full-calendar-month collections → 32/33/34/35%
      - Cross-month periods: split by calendar month, full-month for tier, slice for pay
      - Hygienist: fixed rate (45% for Sheryl Dubman, 40% default) — no tier logic
      - Multi-Dentrix-ID providers (e.g. Dr. G): collections summed across all IDs

    Actual paid source (Phase 2):
      - gusto_payroll_actuals.gross_pay — imported from Gusto Payroll Data Export XLSX
      - Match key: gusto_employee_id (from crosswalk) ↔ gusto_payroll_actuals.employee_id
      - Period match: pay_period_start/end, or checkDate, or payrollRunId if provided
      - gustoNetPay: informational only — NOT used for variance

    Variance:
      - varianceAmount = actualGustoGrossPay − expectedPay
      - variancePercentage = varianceAmount / expectedPay × 100
      - Tolerance: $0.01 (Matched if |variance| ≤ $0.01)
      - Null if either value is missing or expectedPay is zero

    Provider Compensation (/v2/payroll/summary, /v2/reports/provider-compensation):
      - NOT called, NOT modified. This endpoint computes independently.
    """
    import calendar as _cal, datetime as _dt
    from payroll_report import _collections_by_date, doctor_rate, hygienist_rate

    TOLERANCE = 0.01  # $0.01 — rows within one cent = Matched

    try:
        # ── 1. Load compare-eligible crosswalk rows ────────────────────────────
        cw_q = "gusto_payroll_provider_crosswalk?select=*&compare_eligible=eq.true&active=eq.true&limit=500"
        if providerType:
            cw_q += f"&provider_type=eq.{providerType}"
        crosswalk_rows = _sb_get_full(cw_q)

        if providerId:
            crosswalk_rows = [
                c for c in crosswalk_rows
                if providerId in [p.strip() for p in (c.get("provider_compensation_provider_id") or "").split(",")]
            ]

        if not crosswalk_rows:
            return {
                "total": 0, "offset": offset, "limit": limit,
                "payrollPeriodStart": startDate, "payrollPeriodEnd": endDate,
                "meta": {
                    "phase": "Phase 2 — Gusto XLSX actual gross pay wired — no launch",
                    "dentrixSource": "distribution_lines (charge-allocated, transaction_date)",
                    "gustoSource": "gusto_payroll_actuals.gross_pay (XLSX import)",
                    "actualPaidField": "gross_pay",
                    "netPayRole": "informational only — not used for variance",
                    "varianceTolerance": "$0.01",
                    "compareEligibleProviders": 0,
                    "mappedProviders": 0,
                    "totalExpectedPay": 0,
                    "totalActualGrossPay": 0,
                    "totalVarianceAmount": None,
                    "totalPayPeriodCollections": 0,
                },
                "data": [],
            }

        # ── 2. Load Gusto actuals for this pay period / run / check date ───────
        # Prefer explicit payrollRunId > checkDate > pay_period_start/end
        gusto_ref_map: dict = {}  # gusto_employee_id → actuals row
        if payrollRunId:
            actuals_q = (
                f"gusto_payroll_actuals?select=*"
                f"&payroll_run_id=eq.{payrollRunId}"
                f"&limit=500"
            )
        elif checkDate:
            actuals_q = (
                f"gusto_payroll_actuals?select=*"
                f"&check_date=eq.{checkDate}"
                f"&limit=500"
            )
        else:
            actuals_q = (
                f"gusto_payroll_actuals?select=*"
                f"&pay_period_start=eq.{startDate}"
                f"&pay_period_end=eq.{endDate}"
                f"&limit=500"
            )
        for a in _sb_get_full(actuals_q):
            eid = a.get("employee_id")
            if eid and eid not in gusto_ref_map:
                gusto_ref_map[eid] = a

        # ── 3. Calendar-month split helper ─────────────────────────────────────
        def _month_slices(ps: str, pe: str):
            """Yield calendar-month slices for a pay period."""
            cur = _dt.date.fromisoformat(ps)
            end = _dt.date.fromisoformat(pe)
            while True:
                mo_last   = _cal.monthrange(cur.year, cur.month)[1]
                mo_end_d  = cur.replace(day=mo_last)
                slice_end = min(end, mo_end_d)
                yield {
                    "month":          cur.strftime("%Y-%m"),
                    "sliceStart":     cur.isoformat(),
                    "sliceEnd":       slice_end.isoformat(),
                    "fullMonthStart": cur.replace(day=1).isoformat(),
                    "fullMonthEnd":   mo_end_d.isoformat(),
                }
                if slice_end >= end:
                    break
                cur = mo_end_d + _dt.timedelta(days=1)

        # ── 4. Build one output row per provider ───────────────────────────────
        rows_out = []

        for cw in crosswalk_rows:
            eid     = cw["gusto_employee_id"]
            ptype   = cw["provider_type"]                            # "doctor" | "hygienist"
            pname   = cw.get("provider_compensation_provider_name") or ""
            pid_str = (cw.get("provider_compensation_provider_id") or "").strip()
            pids    = [p.strip() for p in pid_str.split(",") if p.strip()]
            office  = cw.get("department") or None

            # ── Gusto actual row for this employee ─────────────────────────
            gusto_row    = gusto_ref_map.get(eid) or {}
            gusto_ename  = gusto_row.get("employee_display_name")
            gusto_cd     = gusto_row.get("check_date")
            gusto_run_id = gusto_row.get("payroll_run_id")
            gusto_pps    = gusto_row.get("pay_period_start")
            gusto_ppe    = gusto_row.get("pay_period_end")

            _gross_raw   = gusto_row.get("gross_pay")
            _net_raw     = gusto_row.get("net_pay")
            actual_gross = float(_gross_raw) if _gross_raw is not None else None
            gusto_net    = float(_net_raw)   if _net_raw   is not None else None

            # ── No Dentrix ID → Needs Mapping ──────────────────────────────
            if not pids:
                rows_out.append({
                    "providerName":                pname or cw.get("gusto_employee_display_name"),
                    "providerType":                ptype,
                    "office":                      office,
                    "dentrixProviderId":           None,
                    "gustoEmployeeId":             eid,
                    "gustoEmployeeName":           gusto_ename or cw.get("gusto_employee_display_name"),
                    "mappingStatus":               "needs_mapping",
                    "payrollPeriodStart":          startDate,
                    "payrollPeriodEnd":            endDate,
                    "tierMonths":                  None,
                    "monthlyDentrixCollections":   None,
                    "payPeriodDentrixCollections":  None,
                    "compensationPercentage":      None,
                    "expectedPay":                 None,
                    "actualGustoGrossPay":          actual_gross,
                    "gustoNetPay":                 gusto_net,
                    "gustoPayrollRunId":            gusto_run_id,
                    "gustoCheckDate":              gusto_cd,
                    "gustoPayPeriodStart":          gusto_pps,
                    "gustoPayPeriodEnd":            gusto_ppe,
                    "varianceAmount":              None,
                    "variancePercentage":           None,
                    "status":                      "Needs Mapping",
                    "sourceNotes": (
                        "Expected pay: Dentrix charge-allocated collections / "
                        "Provider Compensation read-only logic. "
                        "Actual paid: Gusto Payroll Data Export XLSX gross_pay. "
                        "Net pay is informational only. "
                        "No Dentrix provider ID in crosswalk — variance cannot be computed."
                    ),
                })
                continue

            # ── Compute expected pay via split-month logic ─────────────────
            tier_months_detail = []
            total_pp_coll  = 0.0
            total_expected = 0.0

            for slc in _month_slices(startDate, endDate):
                mo = slc["month"]
                ss = slc["sliceStart"]
                se = slc["sliceEnd"]
                ms = slc["fullMonthStart"]
                me = slc["fullMonthEnd"]

                # Pay-period slice collections (sum all Dentrix IDs)
                pp_coll = 0.0
                for pid in pids:
                    pp_rows = _collections_by_date(pid, ss, se)
                    pp_coll += sum(r["applied_payments"] for r in pp_rows)
                pp_coll = round(pp_coll, 2)

                # Full-month collections for tier determination (sum all Dentrix IDs)
                mo_coll = 0.0
                for pid in pids:
                    mo_rows = _collections_by_date(pid, ms, me)
                    mo_coll += sum(r["applied_payments"] for r in mo_rows)
                mo_coll = round(mo_coll, 2)

                # Rate: hygienists fixed, doctors tier
                if ptype == "hygienist":
                    rate = hygienist_rate(pname)
                else:
                    rate = doctor_rate(mo_coll)

                exp_slice = round(pp_coll * rate, 2)
                total_pp_coll  += pp_coll
                total_expected += exp_slice

                tier_months_detail.append({
                    "month":                     mo,
                    "payPeriodSliceStart":        ss,
                    "payPeriodSliceEnd":          se,
                    "fullMonthStart":             ms,
                    "fullMonthEnd":               me,
                    "fullMonthCollections":       mo_coll,
                    "tierRate":                   int(rate * 100),
                    "payPeriodSliceCollections":  pp_coll,
                    "expectedPayThisSlice":       exp_slice,
                })

            total_pp_coll  = round(total_pp_coll,  2)
            total_expected = round(total_expected, 2)

            # Compensation % display (single or cross-month)
            if len(tier_months_detail) > 1:
                comp_pct_display = "/".join(f"{t['tierRate']}%" for t in tier_months_detail)
            else:
                comp_pct_display = f"{tier_months_detail[0]['tierRate']}%" if tier_months_detail else None

            primary_mo_coll = tier_months_detail[0]["fullMonthCollections"] if tier_months_detail else None

            # ── Variance — only when both values present and expectedPay > 0 ──
            variance_amount = None
            variance_pct    = None
            if actual_gross is not None and total_expected > 0:
                variance_amount = round(actual_gross - total_expected, 2)
                variance_pct    = round(variance_amount / total_expected * 100, 4)

            # ── Row status ─────────────────────────────────────────────────
            if actual_gross is not None and total_expected > 0 and variance_amount is not None:
                if abs(variance_amount) <= TOLERANCE:
                    row_status = "Matched"
                elif variance_amount > TOLERANCE:
                    row_status = "Overpaid"
                else:
                    row_status = "Underpaid"
            elif total_expected > 0 and actual_gross is None:
                row_status = "No Gusto Actual"
            elif total_pp_coll == 0:
                row_status = "No Collections This Period"
            elif total_expected == 0:
                row_status = "Source Not Wired"
            else:
                row_status = "Source Not Wired"

            rows_out.append({
                "providerName":                pname,
                "providerType":                ptype,
                "office":                      office,
                "dentrixProviderId":           pid_str,
                "gustoEmployeeId":             eid,
                "gustoEmployeeName":           gusto_ename or cw.get("gusto_employee_display_name"),
                "mappingStatus":               "mapped",
                "payrollPeriodStart":          startDate,
                "payrollPeriodEnd":            endDate,
                "tierMonths":                  tier_months_detail,
                "monthlyDentrixCollections":   primary_mo_coll,
                "payPeriodDentrixCollections":  total_pp_coll,
                "compensationPercentage":      comp_pct_display,
                "expectedPay":                 total_expected,
                # actualGustoGrossPay = Actual Paid source. net_pay informational only.
                "actualGustoGrossPay":          actual_gross,
                "gustoNetPay":                 gusto_net,
                "gustoPayrollRunId":            gusto_run_id,
                "gustoCheckDate":              gusto_cd,
                "gustoPayPeriodStart":          gusto_pps,
                "gustoPayPeriodEnd":            gusto_ppe,
                "varianceAmount":              variance_amount,
                "variancePercentage":           variance_pct,
                "status":                      row_status,
                "sourceNotes": (
                    "Expected pay: Dentrix charge-allocated collections / "
                    "Provider Compensation read-only logic. "
                    "Actual paid: Gusto Payroll Data Export XLSX gross_pay. "
                    "Net pay is informational only."
                ),
            })

        # ── 5. Summary totals ──────────────────────────────────────────────────
        total              = len(rows_out)
        page               = rows_out[offset: offset + limit]
        mapped_count       = sum(1 for r in rows_out if r["mappingStatus"] == "mapped")
        total_exp_all      = round(sum(r["expectedPay"] or 0 for r in rows_out), 2)
        total_actual_all   = round(sum(r["actualGustoGrossPay"] or 0 for r in rows_out), 2)
        total_pp_all       = round(sum(r["payPeriodDentrixCollections"] or 0 for r in rows_out), 2)

        # Only compute total variance if at least one row has both values
        paired_rows        = [r for r in rows_out if r["varianceAmount"] is not None]
        total_variance_all = round(sum(r["varianceAmount"] for r in paired_rows), 2) if paired_rows else None

        # Status summary
        from collections import Counter as _Counter
        status_summary = dict(_Counter(r["status"] for r in rows_out))

        return {
            "total":              total,
            "offset":             offset,
            "limit":              limit,
            "payrollPeriodStart": startDate,
            "payrollPeriodEnd":   endDate,
            "meta": {
                "phase":                     "Phase 2 — Gusto XLSX actual gross pay wired — no launch",
                "dentrixSource":             "distribution_lines (charge-allocated, transaction_date)",
                "gustoSource":               "gusto_payroll_actuals.gross_pay (XLSX import)",
                "actualPaidField":           "gross_pay",
                "netPayRole":                "informational only — not used for variance",
                "varianceTolerance":         "$0.01",
                "gustoMatchStrategy":        (
                    f"payroll_run_id={payrollRunId}" if payrollRunId
                    else f"check_date={checkDate}" if checkDate
                    else f"pay_period {startDate}→{endDate}"
                ),
                "compareEligibleProviders":  len(crosswalk_rows),
                "mappedProviders":           mapped_count,
                "gustoActualsLoaded":        len(gusto_ref_map),
                "totalExpectedPay":          total_exp_all,
                "totalActualGrossPay":       total_actual_all,
                "totalVarianceAmount":       total_variance_all,
                "totalPayPeriodCollections": total_pp_all,
                "statusSummary":             status_summary,
            },
            "data": page,
        }

    except Exception as e:
        logger.error(f"payroll_comparison error: {e}")
        raise HTTPException(500, str(e))

@app.get("/v2/payroll/mappings", tags=["Payroll"], dependencies=[Depends(verify_api_key)])
def payroll_mappings(
    mappingStatus: Optional[str] = Query(None),
    isIgnored:     Optional[bool] = Query(None),
    limit:         int = Query(500),
    offset:        int = Query(0),
):
    """Proxy read of payroll_provider_mappings using service key (bypasses RLS)."""
    try:
        q = "payroll_provider_mappings?select=*&order=normalized_name.asc"
        if mappingStatus:
            q += f"&mapping_status=eq.{mappingStatus}"
        if isIgnored is not None:
            q += f"&is_ignored=eq.{str(isIgnored).lower()}"
        rows = _sb_get_full(q)
        page = rows[offset: offset + limit]
        return {"total": len(rows), "offset": offset, "limit": limit, "data": page}
    except Exception as e:
        logger.error(f"payroll_mappings error: {e}")
        raise HTTPException(500, str(e))


# ===========================================================================
# PLAID WEBHOOK — Real-time transaction updates
# Plaid pushes to this endpoint when new transactions post
# Configure at: dashboard.plaid.com → Developers → Webhooks
# Webhook URL: https://api.nudashboard.com/plaid/webhook
# ===========================================================================

@app.post("/plaid/webhook", tags=["Plaid"])
async def plaid_webhook(request: Request):
    """
    Receives Plaid webhook events and triggers sync for relevant updates.
    Handles: TRANSACTIONS_REMOVED, DEFAULT_UPDATE, INITIAL_UPDATE, HISTORICAL_UPDATE
    """
    import subprocess
    try:
        body = await request.json()
        webhook_type = body.get("webhook_type", "")
        webhook_code = body.get("webhook_code", "")
        item_id      = body.get("item_id", "")

        logger.info(f"Plaid webhook: {webhook_type}/{webhook_code} item={item_id}")

        # Trigger sync for transaction updates
        if webhook_type == "TRANSACTIONS" and webhook_code in (
            "DEFAULT_UPDATE", "INITIAL_UPDATE", "HISTORICAL_UPDATE"
        ):
            new_txns = body.get("new_transactions", 0)
            logger.info(f"Plaid webhook: {new_txns} new transactions — triggering sync")
            subprocess.Popen(
                ["python3", "plaid_sync.py", "--days", "3"],
                cwd="/home/openclaw/.openclaw/workspace/ascend_api/middleware"
            )
            return {"status": "sync_triggered", "new_transactions": new_txns}

        # Handle item errors — alert when re-auth is needed
        if webhook_type == "ITEM" and webhook_code in ("ERROR", "ITEM_LOGIN_REQUIRED", "PENDING_EXPIRATION"):
            error = body.get("error", {})
            error_code = error.get("error_code", webhook_code) if isinstance(error, dict) else webhook_code
            institution = "Unknown"
            tokens = load_plaid_tokens()
            if item_id in tokens:
                institution = tokens[item_id].get("institution_name", item_id)
            logger.error(f"Plaid item action required: {institution} ({item_id}) — {error_code}")
            # Send alert email to Dr. G
            try:
                import subprocess
                alert_body = f"""Action required: Your {institution} Plaid connection needs re-authentication.

Error: {error_code}
Item ID: {item_id}

Please log into nudashboard.com and reconnect your {institution} account to restore data sync.

— Yabezy"""
                subprocess.Popen([
                    "gog", "gmail", "send",
                    "--account", __NUDASHBOARD_CONFIG_LITERAL_022__,
                    "--to", __NUDASHBOARD_CONFIG_LITERAL_023__,
                    "--subject", f"⚠️ Action Required: {institution} Plaid Connection Needs Re-Auth",
                    "--body", alert_body
                ])
                logger.info(f"Alert email sent for {institution} re-auth")
            except Exception as mail_err:
                logger.warning(f"Could not send alert email: {mail_err}")
            return {"status": "alert_sent", "institution": institution, "error_code": error_code}

        return {"status": "received", "webhook_type": webhook_type, "webhook_code": webhook_code}

    except Exception as e:
        logger.error(f"Plaid webhook error: {e}")
        raise HTTPException(500, str(e))


# ===========================================================================
# RCM — Revenue Cycle Management Endpoints
# All data sourced from local SQLite (synced from Dentrix Ascend)
# ===========================================================================

# Canonical office UUID → Ascend location_id
OFFICE_TO_LOCATION = __NUDASHBOARD_CONFIG_LITERAL_024__
LOCATION_TO_OFFICE = {v: k for k, v in OFFICE_TO_LOCATION.items()}
LOCATION_NAMES = __NUDASHBOARD_CONFIG_LITERAL_025__

def extract_carrier(raw: dict) -> str:
    """Extract insurance carrier name from Dentrix Ascend payment reference number."""
    ref  = ((raw.get("patientPaymentBilling") or {}).get("referenceNumber") or "").strip().upper()
    note = (raw.get("note") or "").upper()
    org_type = ((raw.get("organizationLedgerType") or {}).get("id") or "")

    # org 10472 = manually posted insurance payment (no EFT, carrier unknown)
    # org 10473 = auto-posted EFT (carrier in reference number)
    is_manual_post = "10472" in org_type

    CARRIER_MAP = [
        # Delta Dental variants first (most specific)
        (["DD NJ", "DDNJ", "DD NJ "],         "Delta Dental NJ"),
        (["DD MA", "DDMA"],                    "Delta Dental MA"),
        (["DD OH", "DDOH"],                    "Delta Dental OH"),
        (["DD EFT", "DD 2", "DD NO", "DD "],  "Delta Dental"),
        # Other carriers
        (["HORIZON"],                           "Horizon BCBS"),
        (["AETNA"],                             "Aetna"),
        (["CIGNA"],                             "Cigna"),
        (["UHC", "UNITED HEALTH"],              "United Healthcare"),
        (["METLIFE"],                           "MetLife"),
        (["GUARDIAN"],                          "Guardian"),
        (["BCBS", "BLUE CROSS"],                "Blue Cross Blue Shield"),
        (["ANTHEM"],                            "Anthem"),
        (["FEP"],                               "BCBS Federal Employee"),
        (["MERITIAN", "MERITAIN"],              "Meritain Health"),
        (["ZELIS"],                             "Zelis Payment"),
        (["SUNLIFE", "SUN LIFE"],               "Sun Life"),
        (["AMERITAS"],                          "Ameritas"),
        (["PRINCIPAL"],                         "Principal"),
        (["LINCOLN"],                           "Lincoln Financial"),
        (["UNUM"],                              "Unum"),
        (["EMBLEM", "EHC"],                     "EmblemHealth"),
        (["DENTEMAX"],                          "DenteMax"),
        (["ASSURANT"],                          "Assurant"),
        (["HUMANA"],                            "Humana"),
    ]

    # Check reference number
    for prefixes, name in CARRIER_MAP:
        for p in prefixes:
            if ref.startswith(p) or (" " + p) in ref:
                return name

    # Fall back to note field
    for prefixes, name in CARRIER_MAP:
        for p in prefixes:
            if p in note:
                return name

    # Numeric-only EFT — generic
    if ref and re.sub(r"[^A-Z]", "", ref) in ("EFT", "DEPOSIT", "DEP", ""):
        if ref:
            return "Insurance (EFT)"

    if is_manual_post:
        return "Insurance"

    return "Insurance"



RCM_DB_PATH = str(__import__("pathlib").Path(__file__).parent / "ascend.db")

def rcm_db():
    import sqlite3 as _sqlite3
    conn = _sqlite3.connect(RCM_DB_PATH)
    conn.row_factory = _sqlite3.Row
    return conn

def rcm_patient_map(conn):
    """Build patient_id → {name, chart} lookup from SQLite."""
    rows = conn.execute("SELECT id, first_name, last_name FROM patients").fetchall()
    return {r["id"]: f"{r['first_name'] or ''} {r['last_name'] or ''}".strip() for r in rows}

def rcm_filter_clause(start, end, location_id=None, office_id=None, table_alias=None):
    """Build WHERE clause for date + optional location filter.
    Accepts either Ascend locationId directly or canonical office UUID.
    Pass table_alias (e.g. 'ip') when the query has multiple tables with
    overlapping column names (e.g. insurance_claims JOIN insurance_payments).
    Defaults to no prefix — safe for all single-table callers.
    """
    loc = location_id  # Ascend location_id passed directly by dashboard
    if not loc and office_id:
        loc = OFFICE_TO_LOCATION.get(office_id)
    prefix = f"{table_alias}." if table_alias else ""
    where = f"{prefix}transaction_date >= ? AND {prefix}transaction_date <= ?"
    params = [start, end]
    if loc:
        where += f" AND {prefix}location_id = ?"
        params.append(loc)
    return where, params


@app.get("/v2/rcm/claims", tags=["RCM"])
def rcm_claims(
    startDate: Optional[str] = Query(None), start: Optional[str] = Query(None),
    endDate:   Optional[str] = Query(None), end:   Optional[str] = Query(None),
    locationId: Optional[str] = Query(None), officeId: Optional[str] = Query(None),
    page: int = Query(1), pageSize: int = Query(500)
):
    """Insurance claim payments from Dentrix Ascend SQLite."""
    s = startDate or start or "2026-01-01"
    e = endDate   or end   or "2099-12-31"
    conn = rcm_db()
    try:
        patients = rcm_patient_map(conn)
        # table_alias="ip" required: query JOINs insurance_payments ip + insurance_claims ic,
        # both have location_id — bare column name causes SQLite ambiguity error (500).
        where, params = rcm_filter_clause(s, e, location_id=locationId, office_id=officeId, table_alias="ip")

        rows = conn.execute(f"""
            SELECT ip.id, ip.transaction_date, ABS(ip.amount) as amount,
                   ip.location_id, ip.patient_id, ip.ledger_type, ip.is_active, ip.raw,
                   -- Primary source: insurance_claims table (full coverage, always current)
                   json_extract(ic.raw, '$.payorName')       as ic_payor_name,
                   json_extract(ic.raw, '$.payorId')         as ic_payor_id,
                   json_extract(ic.raw, '$.groupPlanName')   as ic_group_plan,
                   json_extract(ic.raw, '$.groupNumber')     as ic_group_number,
                   json_extract(ic.raw, '$.subscriberNumber') as ic_member_id,
                   json_extract(ic.raw, '$.claimState')      as ic_claim_state,
                   json_extract(ic.raw, '$.totalCharges')    as ic_total_charges,
                   json_extract(ip.raw, '$.insuranceClaim.id') as claim_id_ref
            FROM insurance_payments ip
            LEFT JOIN insurance_claims ic
                   ON json_extract(ip.raw, '$.insuranceClaim.id') = ic.id
            WHERE {where}
            AND ip.ledger_type = 'InsurancePayment'
            AND ip.is_active = 1
            ORDER BY ip.transaction_date DESC
        """, params).fetchall()

        results = []
        for r in rows:
            raw = json.loads(r["raw"] or "{}")
            claim_ref = raw.get("insuranceClaim") or {}
            claim_id  = claim_ref.get("id", r["id"])
            office    = LOCATION_NAMES.get(r["location_id"], "Unknown")
            pat_name  = patients.get(r["patient_id"], "Unknown Patient")
            ledger    = r["ledger_type"] or ""
            status    = "posted" if "Cancellation" not in ledger and "Rebill" not in ledger else \
                        "voided" if "Cancellation" in ledger else "pending"
            billed    = raw.get("billedAmount") or raw.get("amountBilled") or r["amount"]

            entry_date = (raw.get("entryDate") or r["transaction_date"] or "")[:10]
            last_mod   = (raw.get("lastModified") or r["transaction_date"] or "")[:10]
            claim_ref  = r["claim_id_ref"] or claim_id

            # Payor data from insurance_claims (full coverage) with raw JSON fallback
            cached_payor    = r["ic_payor_name"]
            cached_payor_id = r["ic_payor_id"]
            member_id       = r["ic_member_id"]
            group_number    = r["ic_group_number"]
            group_plan      = r["ic_group_plan"]
            cached_billed   = r["ic_total_charges"]
            claim_state     = r["ic_claim_state"]

            payor_display  = cached_payor or extract_carrier(raw)
            billed_display = float(cached_billed or billed or r["amount"] or 0)

            # Map claim state to display status
            state_map = {
                "PAYRECVD": "paid", "SENT": "pending", "CREATED": "pending",
                "VOID": "voided", "DENIED": "denied", "PARTIAL": "partial"
            }
            display_status = state_map.get(claim_state, status) if claim_state else status

            results.append({
                "id":               r["id"],
                "claim_id":         claim_ref,
                "patient_name":     pat_name,
                "patient_id":       r["patient_id"],
                "office":           office,
                "office_id":        LOCATION_TO_OFFICE.get(r["location_id"], r["location_id"]),
                "payor":            payor_display,
                "payor_id":         cached_payor_id,
                "insurance_company": payor_display,
                "member_id":        member_id,
                "group_id":         group_number,
                "group_plan_name":  group_plan,
                "date_created":     entry_date,
                "date_submitted":   entry_date,
                "date_received":    last_mod,
                "last_visit_date":  r["transaction_date"],
                "date_of_service":  r["transaction_date"],
                "amount_billed":    billed_display,
                "amount_paid":      float(r["amount"] or 0),
                "status":           display_status,
                "note":             raw.get("note", ""),
                "_source":          "dentrix_ascend",
            })

        return results
    finally:
        conn.close()


# ── claim-submissions endpoint ─────────────────────────────────────────
_CS_STATUS_MAP = {
    "UNSENT":    "unsent",
    "QUEUED":    "ready_to_send",
    "SENT":      "submitted",
    "PRINTED":   "printed_mailed",
    "UNPROCESS": "unprocessable",
    "ADDINFO":   "additional_info_requested",
    "ACCEPTED":  "accepted_open",
    "SETTLED":   "settled",
    "PAYRECVD":  "paid_closed",
    "REJECTSV":  "rejected",
    "DELETED":   "deleted",
}
_CS_REVERSE_STATUS = {}
for _k, _v in _CS_STATUS_MAP.items():
    _CS_REVERSE_STATUS.setdefault(_v, []).append(_k)

_UUID_RE = re.compile(
    r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', re.IGNORECASE
)

def _cs_aging_bucket(days):
    if days is None:
        return None
    if days <= 30:
        return "0_30"
    if days <= 60:
        return "31_60"
    if days <= 90:
        return "61_90"
    return "over_90"

def _cs_hours_to_submission(created_str, sent_date_str):
    """Compute hours between created and sentDate."""
    if not created_str or not sent_date_str:
        return None
    try:
        from datetime import date as _date
        # Try full datetime parse on created
        created_dt = None
        for fmt in ("%Y-%m-%dT%H:%M:%S.%fZ", "%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%dT%H:%M:%S"):
            try:
                created_dt = datetime.strptime(created_str, fmt)
                break
            except ValueError:
                continue
        # sentDate is typically YYYY-MM-DD
        sent_dt = None
        for fmt in ("%Y-%m-%dT%H:%M:%S.%fZ", "%Y-%m-%dT%H:%M:%SZ", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d"):
            try:
                sent_dt = datetime.strptime(sent_date_str, fmt)
                break
            except ValueError:
                continue
        if created_dt and sent_dt:
            delta = sent_dt - created_dt
            return round(delta.total_seconds() / 3600, 2)
        # fallback: date-only
        cd = _date.fromisoformat(created_str[:10])
        sd = _date.fromisoformat(sent_date_str[:10])
        return float((sd - cd).days * 24)
    except Exception:
        return None


@app.get("/v2/rcm/claim-submissions", tags=["RCM"])
def rcm_claim_submissions(
    startDate: Optional[str] = Query(None), start: Optional[str] = Query(None),
    endDate: Optional[str] = Query(None), end: Optional[str] = Query(None),
    dateBasis: Optional[str] = Query("serviceDate"),
    officeId: Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
    status: Optional[str] = Query(None),
    payor: Optional[str] = Query(None),
    page: int = Query(1),
    pageSize: int = Query(100),
    asOfDate: Optional[str] = Query(None),
):
    """Insurance claim submissions with full lifecycle detail.
    Source: insurance_claims LEFT JOIN providers, pre-aggregated payments & write-offs.
    """
    import math
    from datetime import date as _date
    today_str = _date.today().isoformat()

    # ── resolve dates ──
    sd = startDate or start or "2026-01-01"
    ed = endDate or end or today_str
    as_of = asOfDate or today_str
    if as_of > today_str:
        as_of = today_str
    as_of_date = _date.fromisoformat(as_of)

    # ── date basis ──
    if dateBasis not in ("serviceDate", "sentDate", "createdDate"):
        dateBasis = "serviceDate"
    if dateBasis == "serviceDate":
        date_col = "ic.service_date"
    elif dateBasis == "sentDate":
        date_col = "json_extract(ic.raw, '$.sentDate')"
    else:
        date_col = "substr(json_extract(ic.raw, '$.created'), 1, 10)"

    # ── location handling ──
    loc_filter_id = None
    if locationId and locationId.lower() not in ("all", ""):
        if _UUID_RE.match(locationId):
            return JSONResponse(status_code=400, content={
                "error": "locationId must be a Dentrix numeric ID. Use officeId for dashboard UUIDs.",
                "received": locationId,
            })
        loc_filter_id = locationId
    elif officeId:
        loc_filter_id = OFFICE_TO_LOCATION.get(officeId)

    # ── status filter ──
    status_raw_filters = []
    include_unknown_status = False
    if status:
        for s in status.split(","):
            s = s.strip()
            if s == "unknown":
                include_unknown_status = True
            elif s in _CS_REVERSE_STATUS:
                status_raw_filters.extend(_CS_REVERSE_STATUS[s])

    # ── build WHERE ──
    where_parts = ["ic.is_active = 1"]
    params = []

    where_parts.append(f"{date_col} >= ?")
    params.append(sd)
    where_parts.append(f"{date_col} <= ?")
    params.append(ed)

    if loc_filter_id:
        where_parts.append("ic.location_id = ?")
        params.append(loc_filter_id)

    if status_raw_filters or include_unknown_status:
        status_parts = []
        if status_raw_filters:
            placeholders = ",".join("?" for _ in status_raw_filters)
            status_parts.append(f"json_extract(ic.raw, '$.claimState') IN ({placeholders})")
            params.extend(status_raw_filters)
        if include_unknown_status:
            known_states = list(_CS_STATUS_MAP)
            placeholders = ",".join("?" for _ in known_states)
            status_parts.append(
                "(json_extract(ic.raw, '$.claimState') IS NULL OR "
                f"json_extract(ic.raw, '$.claimState') NOT IN ({placeholders}))"
            )
            params.extend(known_states)
        where_parts.append("(" + " OR ".join(status_parts) + ")")

    if payor:
        where_parts.append("json_extract(ic.raw, '$.payorName') LIKE ?")
        params.append(f"%{payor}%")

    where_clause = " AND ".join(where_parts)

    conn = rcm_db()
    try:
        patient_map = rcm_patient_map(conn)
        cur = conn.cursor()

        # ── provider map ──
        prov_rows = cur.execute("SELECT id, first_name, last_name FROM providers WHERE is_active = 1").fetchall()
        provider_map = {r["id"]: f"{r['first_name']} {r['last_name']}".strip() for r in prov_rows}

        # ── count ──
        count_sql = f"SELECT COUNT(*) as cnt FROM insurance_claims ic WHERE {where_clause}"
        total_count = cur.execute(count_sql, params).fetchone()["cnt"]

        # ── page calc ──
        if pageSize < 1:
            pageSize = 100
        if pageSize > 500:
            pageSize = 500
        total_pages = max(1, math.ceil(total_count / pageSize))
        if page < 1:
            page = 1
        offset = (page - 1) * pageSize

        # ── main query (paginated) ──
        main_sql = f"""
            SELECT ic.id, ic.location_id, ic.service_date, ic.rendering_provider_id,
                   ic.patient_id, ic.raw
            FROM insurance_claims ic
            WHERE {where_clause}
            ORDER BY ic.service_date DESC, ic.id DESC
            LIMIT ? OFFSET ?
        """
        rows = cur.execute(main_sql, params + [pageSize, offset]).fetchall()

        # ── collect IDs for pre-agg (page) ──
        page_ids = [r["id"] for r in rows]

        # ── pre-aggregate payments for page ──
        pay_map = {}  # claim_id -> {paid, count, last_date}
        if page_ids:
            ph = ",".join("?" for _ in page_ids)
            pay_sql = f"""
                SELECT json_extract(ip.raw, '$.insuranceClaim.id') as claim_id,
                       SUM(ABS(ip.amount)) as paid, COUNT(*) as cnt,
                       MAX(ip.transaction_date) as last_dt
                FROM insurance_payments ip
                WHERE ip.ledger_type = 'InsurancePayment' AND ip.is_active = 1
                  AND json_extract(ip.raw, '$.insuranceClaim.id') IN ({ph})
                GROUP BY json_extract(ip.raw, '$.insuranceClaim.id')
            """
            for pr in cur.execute(pay_sql, page_ids).fetchall():
                pay_map[pr["claim_id"]] = {
                    "paid": float(pr["paid"] or 0),
                    "count": pr["cnt"],
                    "last_date": pr["last_dt"],
                }

        # ── pre-aggregate write-offs for page ──
        wo_map = {}  # claim_id -> writeoff_amount
        if page_ids:
            wo_sql = f"""
                SELECT json_extract(adj.raw, '$.insuranceClaim.id') as claim_id,
                       SUM(ABS(adj.amount)) as wo
                FROM adjustments adj
                WHERE adj.is_active = 1
                  AND json_extract(adj.raw, '$.organizationLedgerType.id') = '14000000010459'
                  AND adj.ledger_type NOT LIKE '%Cancellation%'
                  AND json_extract(adj.raw, '$.insuranceClaim.id') IN ({ph})
                GROUP BY json_extract(adj.raw, '$.insuranceClaim.id')
            """
            for wr in cur.execute(wo_sql, page_ids).fetchall():
                wo_map[wr["claim_id"]] = float(wr["wo"] or 0)

        # ── build data rows ──
        data = []
        for r in rows:
            raw = json.loads(r["raw"]) if r["raw"] else {}
            claim_id = r["id"]
            loc_id = r["location_id"] or ""
            office_id = LOCATION_TO_OFFICE.get(loc_id, "")
            office_name = LOCATION_NAMES.get(loc_id, "Unknown")

            claim_state = raw.get("claimState", "")
            norm_status = _CS_STATUS_MAP.get(claim_state, "unknown")

            sent_date = raw.get("sentDate")
            etrans = raw.get("eTransClaimId")

            # Enriched submission_method classification (May 2026)
            # Rule 1: PRINTED state → always printed_mail regardless of sentDate
            if claim_state == "PRINTED":
                sub_method = "printed_mail"
            # Rule 2: Confirmed electronic — sentDate + eTransClaimId present
            elif sent_date and etrans:
                sub_method = "electronic"
            # Rule 3: Likely electronic — SENT state with sentDate but no eTrans ID
            #   eTransClaimId is sometimes absent for ERA/batch electronic submissions
            elif claim_state in ("SENT", "PAYRECVD", "ACCEPTED", "SETTLED") and sent_date:
                sub_method = "electronic_unconfirmed"
            # Rule 4: Check claimStatusHistory for prior SENT/electronic indicator
            #   covers PAYRECVD/ACCEPTED claims where sentDate is missing
            elif claim_state in ("PAYRECVD", "ACCEPTED", "SETTLED"):
                history = raw.get("claimStatusHistory") or []
                was_sent_electronically = any(
                    isinstance(h, dict) and h.get("claimState") in ("SENT", "ACCEPTED")
                    and any(
                        kw in (h.get("claimHistoryMessageTxt") or "")
                        for kw in ("Electronic", "electronically", "DentalXChange", "eTrans", "DC#")
                    )
                    for h in history
                )
                sub_method = "electronic_unconfirmed" if was_sent_electronically else "unknown"
            else:
                sub_method = "unknown"

            created_str = raw.get("created")
            created_date = created_str[:10] if created_str and len(created_str) >= 10 else None

            # attachments
            claim_att = raw.get("claimAttachments") or []
            image_att = raw.get("imageAttachments") or []
            att_count = len(claim_att) + len(image_att)
            has_att = att_count > 0

            # status message: messageTxt or latest claimStatusHistory entry
            msg_txt = raw.get("messageTxt")
            status_msg = msg_txt
            if not status_msg:
                history = raw.get("claimStatusHistory") or []
                if history:
                    latest = history[-1] if isinstance(history, list) else None
                    if latest and isinstance(latest, dict):
                        status_msg = latest.get("claimHistoryMessageTxt")

            total_billed = float(raw.get("totalCharges") or 0)
            pay_info = pay_map.get(claim_id, {"paid": 0, "count": 0, "last_date": None})
            ins_paid = pay_info["paid"]
            wo_amt = wo_map.get(claim_id, 0)
            est_balance = round(total_billed - ins_paid - wo_amt, 2)

            # days calculations
            svc_date = r["service_date"]
            days_since_svc = None
            if svc_date:
                try:
                    days_since_svc = (as_of_date - _date.fromisoformat(svc_date)).days
                except Exception:
                    pass

            days_since_sub = None
            if sent_date:
                try:
                    days_since_sub = (as_of_date - _date.fromisoformat(sent_date[:10])).days
                except Exception:
                    pass

            hrs = _cs_hours_to_submission(created_str, sent_date)
            within_24 = (hrs is not None and hrs <= 24.0) if hrs is not None else None

            last_mod = raw.get("lastModified")
            last_mod_date = last_mod[:10] if last_mod and len(last_mod) >= 10 else None

            data.append({
                "claim_id": claim_id,
                "patient_id": r["patient_id"] or "",
                "patient_name": patient_map.get(r["patient_id"], "Unknown"),
                "office_id": office_id,
                "office": office_name,
                "location_id": loc_id,
                "payor": raw.get("payorName", ""),
                "payor_id": raw.get("payorId", ""),
                "group_plan_name": raw.get("groupPlanName"),
                "member_id": raw.get("subscriberNumber"),
                "provider_id": r["rendering_provider_id"],
                "provider_name": provider_map.get(r["rendering_provider_id"]),
                "service_date": svc_date,
                "claim_created_date": created_date,
                "claim_submitted_date": sent_date,
                "claim_last_modified_date": last_mod_date,
                "raw_claim_state": claim_state,
                "normalized_claim_status": norm_status,
                "claim_followup_action": raw.get("claimFollowupAction"),
                "followup_due_date": raw.get("followupDueDate"),
                "etrans_claim_id": etrans,
                "is_predetermination": bool(raw.get("isPredetermination")),
                "payer_requested_resubmit": bool(raw.get("payerRequestedResubmit")),
                "payer_requested_void": bool(raw.get("payerRequestedVoid")),
                "resubmit_date": raw.get("resubmitDate"),
                "message_text": msg_txt,
                "submission_method": sub_method,
                "has_attachment": has_att,
                "attachment_count": att_count,
                "status_message": status_msg,
                "total_billed": total_billed,
                "insurance_paid_to_date": ins_paid,
                "writeoff_amount": wo_amt,
                "estimated_insurance_balance": est_balance,
                "negative_balance_flag": est_balance < 0,
                "payment_count": pay_info["count"],
                "last_payment_date": pay_info["last_date"],
                "days_since_service": days_since_svc,
                "days_since_submitted": days_since_sub,
                "hours_to_submission": hrs,
                "submitted_within_24h": within_24,
                "aging_bucket_service": _cs_aging_bucket(days_since_svc),
                "aging_bucket_submitted": _cs_aging_bucket(days_since_sub),
                "source_note": "dentrix_ascend/insurance_claims",
            })

        # ── summary (full scope, no pagination) ──
        sum_sql = f"""
            SELECT
                ic.id, ic.location_id, ic.service_date, ic.patient_id, ic.raw
            FROM insurance_claims ic
            WHERE {where_clause}
        """
        all_rows = cur.execute(sum_sql, params).fetchall()
        all_ids = [ar["id"] for ar in all_rows]

        # pre-agg payments for all
        all_pay = {}
        if all_ids:
            chunk_size = 900
            for i in range(0, len(all_ids), chunk_size):
                chunk = all_ids[i:i+chunk_size]
                ph2 = ",".join("?" for _ in chunk)
                for pr in cur.execute(f"""
                    SELECT json_extract(ip.raw, '$.insuranceClaim.id') as cid,
                           SUM(ABS(ip.amount)) as paid, COUNT(*) as cnt,
                           MAX(ip.transaction_date) as last_dt
                    FROM insurance_payments ip
                    WHERE ip.ledger_type = 'InsurancePayment' AND ip.is_active = 1
                      AND json_extract(ip.raw, '$.insuranceClaim.id') IN ({ph2})
                    GROUP BY json_extract(ip.raw, '$.insuranceClaim.id')
                """, chunk).fetchall():
                    all_pay[pr["cid"]] = {"paid": float(pr["paid"] or 0), "cnt": pr["cnt"], "last_dt": pr["last_dt"]}

        all_wo = {}
        if all_ids:
            for i in range(0, len(all_ids), chunk_size):
                chunk = all_ids[i:i+chunk_size]
                ph2 = ",".join("?" for _ in chunk)
                for wr in cur.execute(f"""
                    SELECT json_extract(adj.raw, '$.insuranceClaim.id') as cid,
                           SUM(ABS(adj.amount)) as wo
                    FROM adjustments adj
                    WHERE adj.is_active = 1
                      AND json_extract(adj.raw, '$.organizationLedgerType.id') = '14000000010459'
                      AND adj.ledger_type NOT LIKE '%Cancellation%'
                      AND json_extract(adj.raw, '$.insuranceClaim.id') IN ({ph2})
                    GROUP BY json_extract(adj.raw, '$.insuranceClaim.id')
                """, chunk).fetchall():
                    all_wo[wr["cid"]] = float(wr["wo"] or 0)

        # compute summary
        s_total = len(all_rows)
        s_submitted_states = {"SENT", "PRINTED", "ACCEPTED", "PAYRECVD", "SETTLED"}
        s_submitted = 0
        s_within_24h = 0
        s_counts = {v: 0 for v in _CS_STATUS_MAP.values()}
        s_counts["unknown"] = 0
        s_predet = 0
        s_resubmitted = 0
        s_with_att = 0
        s_total_billed = 0.0
        s_ins_paid = 0.0
        s_wo = 0.0
        s_days_svc_list = []
        s_days_sub_list = []
        # by_office accum
        office_accum = {}
        # by_payor accum
        payor_accum = {}
        # by_submission_method accum
        method_accum = {"electronic": 0, "electronic_unconfirmed": 0, "printed_mail": 0, "unknown": 0}
        # aging buckets
        aging_svc = {"0_30": 0, "31_60": 0, "61_90": 0, "over_90": 0}
        aging_sub = {"0_30": 0, "31_60": 0, "61_90": 0, "over_90": 0}

        for ar in all_rows:
            raw_s = json.loads(ar["raw"]) if ar["raw"] else {}
            cid = ar["id"]
            cs = raw_s.get("claimState", "")
            ns = _CS_STATUS_MAP.get(cs, "unknown")
            s_counts[ns] = s_counts.get(ns, 0) + 1

            is_submitted = cs in s_submitted_states
            if is_submitted:
                s_submitted += 1

            sd_val = raw_s.get("sentDate")
            cr_val = raw_s.get("created")
            h = _cs_hours_to_submission(cr_val, sd_val)
            if h is not None and h <= 24.0 and is_submitted:
                s_within_24h += 1

            # ── submission_method accumulation (enriched logic) ──────────
            _etrans_s = raw_s.get("eTransClaimId")
            if cs == "PRINTED":
                _sm = "printed_mail"
            elif sd_val and _etrans_s:
                _sm = "electronic"
            elif cs in ("SENT", "PAYRECVD", "ACCEPTED", "SETTLED") and sd_val:
                _sm = "electronic_unconfirmed"
            elif cs in ("PAYRECVD", "ACCEPTED", "SETTLED"):
                _hist_s = raw_s.get("claimStatusHistory") or []
                _was_electronic = any(
                    isinstance(_h, dict) and _h.get("claimState") in ("SENT", "ACCEPTED")
                    and any(
                        _kw in (_h.get("claimHistoryMessageTxt") or "")
                        for _kw in ("Electronic", "electronically", "DentalXChange", "eTrans", "DC#")
                    )
                    for _h in _hist_s
                )
                _sm = "electronic_unconfirmed" if _was_electronic else "unknown"
            else:
                _sm = "unknown"
            method_accum[_sm] = method_accum.get(_sm, 0) + 1

            if raw_s.get("isPredetermination"):
                s_predet += 1
            if raw_s.get("resubmitDate"):
                s_resubmitted += 1

            ca = raw_s.get("claimAttachments") or []
            ia = raw_s.get("imageAttachments") or []
            if len(ca) + len(ia) > 0:
                s_with_att += 1

            billed = float(raw_s.get("totalCharges") or 0)
            paid = all_pay.get(cid, {}).get("paid", 0)
            wo_a = all_wo.get(cid, 0)
            s_total_billed += billed
            s_ins_paid += paid
            s_wo += wo_a
            est_b = round(billed - paid - wo_a, 2)

            svc = ar["service_date"]
            dsvc = None
            if svc:
                try:
                    dsvc = (as_of_date - _date.fromisoformat(svc)).days
                    s_days_svc_list.append(dsvc)
                except Exception:
                    pass
            dsub = None
            if sd_val:
                try:
                    dsub = (as_of_date - _date.fromisoformat(sd_val[:10])).days
                    s_days_sub_list.append(dsub)
                except Exception:
                    pass

            b_svc = _cs_aging_bucket(dsvc)
            if b_svc:
                aging_svc[b_svc] += 1
            b_sub = _cs_aging_bucket(dsub)
            if b_sub:
                aging_sub[b_sub] += 1

            # by_office
            lid = ar["location_id"] or ""
            oname = LOCATION_NAMES.get(lid, "Unknown")
            if oname not in office_accum:
                office_accum[oname] = {"office": oname, "location_id": lid,
                    "total_claims": 0, "total_billed": 0.0, "insurance_paid": 0.0,
                    "writeoff": 0.0, "estimated_balance": 0.0}
            oa = office_accum[oname]
            oa["total_claims"] += 1
            oa["total_billed"] += billed
            oa["insurance_paid"] += paid
            oa["writeoff"] += wo_a
            oa["estimated_balance"] += est_b

            # by_payor
            pname = raw_s.get("payorName", "Unknown") or "Unknown"
            if pname not in payor_accum:
                payor_accum[pname] = {"payor": pname, "total_claims": 0,
                    "total_billed": 0.0, "insurance_paid": 0.0,
                    "writeoff": 0.0, "estimated_balance": 0.0}
            pa = payor_accum[pname]
            pa["total_claims"] += 1
            pa["total_billed"] += billed
            pa["insurance_paid"] += paid
            pa["writeoff"] += wo_a
            pa["estimated_balance"] += est_b

        # round office/payor accums
        for oa in office_accum.values():
            for k in ("total_billed", "insurance_paid", "writeoff", "estimated_balance"):
                oa[k] = round(oa[k], 2)
        for pa in payor_accum.values():
            for k in ("total_billed", "insurance_paid", "writeoff", "estimated_balance"):
                pa[k] = round(pa[k], 2)

        by_payor_list = sorted(payor_accum.values(), key=lambda x: x["estimated_balance"], reverse=True)[:20]

        # by_status
        by_status_list = [{"status": st, "count": ct} for st, ct in s_counts.items() if ct > 0]

        # by_submission_method
        by_method_list = [{"method": m, "count": c} for m, c in method_accum.items() if c > 0]

        claims_over_30 = sum(1 for d in s_days_svc_list if d > 30)
        claims_over_60 = sum(1 for d in s_days_svc_list if d > 60)
        claims_over_90 = sum(1 for d in s_days_svc_list if d > 90)

        summary = {
            "total_claims": s_total,
            "submitted_claims": s_submitted,
            "submitted_within_24h_count": s_within_24h,
            "submission_24h_rate": round(s_within_24h / s_submitted * 100, 2) if s_submitted else 0.0,
            "unsent_claims": s_counts.get("unsent", 0),
            "ready_to_send_claims": s_counts.get("ready_to_send", 0),
            "printed_mailed_claims": s_counts.get("printed_mailed", 0),
            "unprocessable_claims": s_counts.get("unprocessable", 0),
            "additional_info_requested_claims": s_counts.get("additional_info_requested", 0),
            "accepted_open_claims": s_counts.get("accepted_open", 0),
            "paid_closed_claims": s_counts.get("paid_closed", 0),
            "settled_claims": s_counts.get("settled", 0),
            "rejected_claims": s_counts.get("rejected", 0),
            "deleted_claims": s_counts.get("deleted", 0),
            "predetermination_claims": s_predet,
            "resubmitted_claims": s_resubmitted,
            "claims_with_attachments": s_with_att,
            "total_billed": round(s_total_billed, 2),
            "insurance_paid_to_date": round(s_ins_paid, 2),
            "writeoff_amount": round(s_wo, 2),
            "estimated_insurance_balance": round(s_total_billed - s_ins_paid - s_wo, 2),
            "average_days_since_service": round(sum(s_days_svc_list) / len(s_days_svc_list), 2) if s_days_svc_list else None,
            "average_days_since_submitted": round(sum(s_days_sub_list) / len(s_days_sub_list), 2) if s_days_sub_list else None,
            "claims_over_30_days": claims_over_30,
            "claims_over_60_days": claims_over_60,
            "claims_over_90_days": claims_over_90,
            "by_office": list(office_accum.values()),
            "by_payor": by_payor_list,
            "by_status": by_status_list,
            "by_submission_method": by_method_list,
            "electronic_claims": method_accum.get("electronic", 0),
            "electronic_unconfirmed_claims": method_accum.get("electronic_unconfirmed", 0),
            "printed_mail_claims": method_accum.get("printed_mail", 0),
            "aging_buckets_service": aging_svc,
            "aging_buckets_submitted": aging_sub,
        }

        # ── sync freshness metadata ──────────────────────────────────────────
        # Pull last_synced_at for insurance_claims from sync_state table.
        # sync_state columns: table_name TEXT PK, last_id TEXT, last_synced_at REAL, total_count INT
        _sync_row = conn.execute(
            "SELECT last_synced_at FROM sync_state WHERE table_name = 'insurance_claims'"
        ).fetchone()
        _sync_ts   = float(_sync_row["last_synced_at"]) if _sync_row and _sync_row["last_synced_at"] else None
        if _sync_ts:
            import datetime as _dt
            _sync_dt       = _dt.datetime.fromtimestamp(_sync_ts, tz=_dt.timezone.utc)
            _sync_iso      = _sync_dt.strftime("%Y-%m-%dT%H:%M:%SZ")
            _sync_date_str = _sync_dt.strftime("%Y-%m-%d")
        else:
            _sync_iso      = None
            _sync_date_str = None

        _today_str      = _dt.date.today().isoformat()
        _is_same_day    = (ed >= _today_str)   # range includes or ends on today
        # Warn when same-day and sync happened before end of business (before 18:00 ET = 22:00 UTC)
        _sync_warning   = False
        if _is_same_day and _sync_ts:
            _sync_dt_et = _dt.datetime.fromtimestamp(_sync_ts,
                          tz=_dt.timezone(_dt.timedelta(hours=-4)))  # EDT
            _sync_warning = _sync_dt_et.hour < 18   # synced before 6 PM ET
        elif _is_same_day and not _sync_ts:
            _sync_warning = True  # no sync info — warn by default

        _freshness_note = (
            "Claim status reflects Dentrix Ascend claim sync. "
            "Same-day submissions may not yet appear if eAssist batch was submitted after the last claim sync."
            if _is_same_day else
            "Claim status reflects Dentrix Ascend claim sync as of the recorded sync timestamp."
        )

        return {
            "data": data,
            "summary": summary,
            "pagination": {
                "page": page,
                "page_size": pageSize,
                "total_count": total_count,
                "total_pages": total_pages,
                "has_next_page": page < total_pages,
            },
            "date_basis": dateBasis,
            "date_range": f"{sd} – {ed}",
            "as_of_date": as_of,
            "claim_source_last_synced_at":   _sync_iso,
            "claim_source_last_synced_date": _sync_date_str,
            "is_same_day_data":              _is_same_day,
            "same_day_sync_warning":         _sync_warning,
            "claim_source_freshness_note":   _freshness_note,
            "_source": "dentrix_ascend/insurance_claims",
        }
    finally:
        conn.close()


@app.get("/v2/rcm/patient-statements", tags=["RCM"])
def rcm_patient_statements(
    startDate: Optional[str] = Query(None), start: Optional[str] = Query(None),
    endDate:   Optional[str] = Query(None), end:   Optional[str] = Query(None),
    locationId: Optional[str] = Query(None), officeId: Optional[str] = Query(None),
    page: int = Query(1), pageSize: int = Query(500)
):
    """Patient payment statements from Dentrix Ascend SQLite.
    Source: patient_payments WHERE ledger_type='PatientProcedurePayment' AND is_active=1 AND amount<0.
    Each row is a completed patient payment transaction, not a statement workflow record.
    Enhanced 2026-05-06: added payment_date, payment_datetime, payment_amount, paid_at_visit,
    payment_method, payment_method_label, card_type, masked_card_number, check_number.
    reference_number intentionally omitted — may contain patient name fragments in CC token strings.
    """
    s = startDate or start or "2026-01-01"
    e = endDate   or end   or "2099-12-31"
    conn = rcm_db()
    try:
        patients = rcm_patient_map(conn)
        where, params = rcm_filter_clause(s, e, location_id=locationId, office_id=officeId)

        rows = conn.execute(f"""
            SELECT id, transaction_date, ABS(amount) as amount, location_id, patient_id,
                   ledger_type, is_active, raw
            FROM patient_payments
            WHERE {where}
            AND ledger_type = 'PatientProcedurePayment'
            AND is_active = 1 AND amount < 0
            ORDER BY transaction_date DESC
        """, params).fetchall()

        # Card type integer → human label mapping (from Dentrix Ascend spec)
        CARD_TYPE_MAP = {1: "Visa", 2: "Mastercard", 3: "Amex", 4: "Discover"}

        results = []
        for r in rows:
            raw     = json.loads(r["raw"] or "{}")
            office  = LOCATION_NAMES.get(r["location_id"], "Unknown")
            patient = patients.get(r["patient_id"], "Unknown Patient")
            paid_at = raw.get("paidAtVisit", None)

            # ── payment method derivation ──────────────────────────────────────
            billing = raw.get("patientPaymentBilling") or {}
            if billing.get("creditCardTransaction"):
                method = "credit_card"
            elif billing.get("checkNumber"):
                method = "check"
            elif isinstance(billing.get("referenceNumber"), str) and \
                 "care credit" in billing["referenceNumber"].lower():
                method = "care_credit"
            elif billing:
                method = "other"
            else:
                method = None  # no billing object — do NOT assume cash

            METHOD_LABELS = {
                "credit_card": "Credit Card",
                "check":       "Check",
                "care_credit": "CareCredit",
                "other":       "Other",
            }
            method_label = METHOD_LABELS.get(method, None)

            # ── card type (integer enum → string) ─────────────────────────────
            raw_card_type = billing.get("creditCardType")
            card_type = CARD_TYPE_MAP.get(raw_card_type) if raw_card_type is not None else None

            # ── masked card number — only return if already masked ─────────────
            raw_cc_num = billing.get("creditCardNumber", "")
            # Dentrix masks as ************XXXX — safe if it has 4+ asterisks
            masked_card_number = raw_cc_num if raw_cc_num and raw_cc_num.count("*") >= 4 else None

            # ── check number — returned as-is (routine billing identifier) ─────
            check_number = billing.get("checkNumber") or None

            # ── reference_number intentionally omitted ─────────────────────────
            # referenceNumber may contain patient name fragments embedded in CC
            # token strings (e.g. "Smith John a8cec92f..."). Not safe to expose.

            results.append({
                # ── existing fields (unchanged for backward compatibility) ──────
                "id":                r["id"],
                "patient_name":      patient,
                "patient_id":        r["patient_id"],
                "office":            office,
                "office_id":         LOCATION_TO_OFFICE.get(r["location_id"], r["location_id"]),
                "statement_date":    r["transaction_date"],
                "date":              r["transaction_date"],
                "balance":           float(r["amount"] or 0),
                "amount":            float(r["amount"] or 0),
                "days_outstanding":  0,
                "last_contact_date": None,
                "status":            "paid" if paid_at else "sent",
                "delivery_method":   "in-office" if paid_at else "statement",
                "note":              raw.get("note", ""),
                "_source":           "dentrix_ascend",
                # ── new payment fields ────────────────────────────────────────
                "payment_date":         r["transaction_date"],
                "payment_datetime":     raw.get("transactionDateTime") or None,
                "payment_amount":       float(r["amount"] or 0),
                "paid_at_visit":        paid_at if paid_at is not None else None,
                "payment_method":       method,
                "payment_method_label": method_label,
                "card_type":            card_type,
                "masked_card_number":   masked_card_number,
                "check_number":         check_number,
            })

        return results
    finally:
        conn.close()


@app.get("/v2/rcm/payment-arrangements", tags=["RCM"])
def rcm_payment_arrangements(
    startDate: Optional[str] = Query(None), start: Optional[str] = Query(None),
    endDate:   Optional[str] = Query(None), end:   Optional[str] = Query(None),
    locationId: Optional[str] = Query(None), officeId: Optional[str] = Query(None),
    page: int = Query(1), pageSize: int = Query(500)
):
    """Payment arrangements — derived from patient payment patterns."""
    s = startDate or start or "2026-01-01"
    e = endDate   or end   or "2099-12-31"
    conn = rcm_db()
    try:
        patients = rcm_patient_map(conn)
        where, params = rcm_filter_clause(s, e, location_id=locationId, office_id=officeId)

        # Rebill transactions indicate payment plan activity
        rows = conn.execute(f"""
            SELECT id, transaction_date, ABS(amount) as amount, location_id, patient_id,
                   ledger_type, is_active, raw
            FROM patient_payments
            WHERE {where}
            AND ledger_type = 'PatientProcedurePaymentRebill'
            AND is_active = 1 AND amount != 0
            ORDER BY transaction_date DESC
        """, params).fetchall()

        results = []
        for r in rows:
            raw     = json.loads(r["raw"] or "{}")
            office  = LOCATION_NAMES.get(r["location_id"], "Unknown")
            patient = patients.get(r["patient_id"], "Unknown Patient")

            results.append({
                "id":                r["id"],
                "patient_name":      patient,
                "patient_id":        r["patient_id"],
                "office":            office,
                "office_id":         LOCATION_TO_OFFICE.get(r["location_id"], r["location_id"]),
                "arrangement_amount": float(r["amount"] or 0),
                "amount_paid":       float(r["amount"] or 0),
                "remaining_balance": 0.0,
                "due_date":          None,
                "created_at":        r["transaction_date"],
                "status":            "active",
                "note":              raw.get("note", ""),
                "_source":           "dentrix_ascend",
            })

        return results
    finally:
        conn.close()


@app.get("/v2/rcm/pos-collections", tags=["RCM"], dependencies=[Depends(verify_api_key)])
def rcm_pos_collections(
    startDate: Optional[str] = Query(None), start: Optional[str] = Query(None),
    endDate:   Optional[str] = Query(None), end:   Optional[str] = Query(None),
    locationId: Optional[str] = Query(None), officeId: Optional[str] = Query(None),
    page: int = Query(1), pageSize: int = Query(500)
):
    """
    Point-of-service collections (paidAtVisit=true) from Dentrix patient_payments.

    Source semantics:
    - Source table: patient_payments (primary), enriched via procedures/providers/patient_procedures/practice_procedures
    - Filter: paidAtVisit=true, is_active=1, amount<0 (patient payments only — no insurance)
    - amount_collected: full payment row amount — NOT procedure-allocation-aware
    - payment_date: transaction_date from patient_payments (payment posting date, NOT service date)
    - date_of_service: NOT returned — use service_date (from patient_procedures.service_date via join)
    - service_date: true procedure service date from patient_procedures — null if join cannot resolve
    - expected_amount: NOT returned — payment-event based; use /v2/rcm/guarantor-reconciliation
    - collection_rate: NOT returned — same reason
    - provider_name / ada_code: from first resolvable procedure distribution; fallback to dists[1+] when dists[0] is an adjustment
    - ledger_type: PatientProcedurePayment (fresh) or PatientProcedurePaymentRebill (reallocation)

    Phase 1 patch 2026-05-08: truthfulness — removed misleading date_of_service/expected_amount/collection_rate=100.
    Phase 2 patch 2026-05-08: enrichment — provider, service code, true service_date, improved payment method.
    Phase 4 patch 2026-05-08: fallback distribution resolution + Dentrix-aligned payment method model.
      - Provider/service: try dists[0], fall back to first resolvable procedure dist; exposes unresolved_reason.
      - Payment method: separated into payment_method_group / payment_channel / flags.
      - Card brand: from creditCardType integer enum (1=Visa, 2=MC, 3=Amex, 4=Discover), not cardHolderName.
      - POS Terminal = channel (not method); Auto-Posted = flag (not method).
    """
    s = startDate or start or "2026-01-01"
    e = endDate   or end   or "2099-12-31"
    page     = max(1, page)
    pageSize = max(1, min(pageSize, 2000))
    offset   = (page - 1) * pageSize

    # ── Financing keyword list for patient_financing detection ─────────────────
    _FINANCING_KEYWORDS = [
        "carecredit", "care credit", "cherry", "sunbit", "alphaeon",
        "lending club", "lendingclub", "greensky", "prosper", "springstone",
        "proceed finance", "patient financing", "payment plan financing",
    ]

    # ── creditCardType integer → brand name mapping ───────────────────────────
    _CC_BRAND_MAP = {1: "Visa", 2: "Mastercard", 3: "AmEx", 4: "Discover"}

    conn = rcm_db()
    try:
        patients = rcm_patient_map(conn)
        where, params = rcm_filter_clause(s, e, location_id=locationId, office_id=officeId)

        base_sql = f"""
            FROM patient_payments
            WHERE {where}
            AND json_extract(raw, '$.paidAtVisit') = 1
            AND is_active = 1 AND amount < 0
        """

        total_rows = conn.execute(
            f"SELECT COUNT(*) as cnt {base_sql}", params
        ).fetchone()["cnt"]

        total_pages = max(1, (total_rows + pageSize - 1) // pageSize)
        has_next    = page < total_pages

        # ── Fetch ALL matching rows (full filter scope) for summary + enrichment ──
        all_rows = conn.execute(
            f"""SELECT id, transaction_date, amount, location_id, patient_id,
                       ledger_type, raw
                {base_sql}
                ORDER BY transaction_date DESC""",
            params
        ).fetchall()

        rows = all_rows[offset : offset + pageSize]

        # ── Build charge_ids and dist_map from ALL rows ───────────────────────────
        all_charge_ids = set()
        row_dist_map   = {}

        for r in all_rows:
            raw_j = json.loads(r["raw"] or "{}")
            dists  = raw_j.get("distributions") or []
            row_dist_map[r["id"]] = dists
            for d in dists:
                cid = d.get("chargeId")
                if cid:
                    all_charge_ids.add(cid)

        # ── Enrich charge_ids via procedures JOIN chain ───────────────────────────
        charge_enrich = {}
        if all_charge_ids:
            ph = ",".join("?" for _ in all_charge_ids)
            enrich_rows = conn.execute(f"""
                SELECT
                    pr.id                                              AS charge_id,
                    pr.provider_id                                     AS provider_id,
                    pr.amount                                          AS proc_charge_amount,
                    COALESCE(pv.first_name,'') || ' ' || COALESCE(pv.last_name,'')
                                                                       AS provider_name,
                    json_extract(pr.raw, '$.patientProcedure.id')      AS patient_procedure_id,
                    ptp.service_date                                    AS service_date,
                    ptp.practice_procedure_id                           AS practice_procedure_id,
                    pproc.ada_code                                      AS ada_code,
                    pproc.description                                   AS procedure_description,
                    pproc.normalized_service_category                   AS service_category,
                    pproc.fee                                           AS procedure_list_fee
                FROM procedures pr
                LEFT JOIN providers pv
                       ON pr.provider_id = pv.id
                LEFT JOIN patient_procedures ptp
                       ON json_extract(pr.raw, '$.patientProcedure.id') = ptp.id
                LEFT JOIN practice_procedures pproc
                       ON ptp.practice_procedure_id = pproc.id
                WHERE pr.id IN ({ph})
            """, list(all_charge_ids)).fetchall()

            for er in enrich_rows:
                charge_enrich[er["charge_id"]] = {
                    "provider_id":          er["provider_id"],
                    "provider_name":        (er["provider_name"] or "").strip() or None,
                    "proc_charge_amount":   er["proc_charge_amount"],
                    "patient_procedure_id": er["patient_procedure_id"],
                    "service_date":         er["service_date"],
                    "practice_procedure_id": er["practice_procedure_id"],
                    "ada_code":             er["ada_code"],
                    "procedure_description": er["procedure_description"],
                    "service_category":     er["service_category"],
                    "procedure_list_fee":   er["procedure_list_fee"],
                }

        # ── Build adjustment_ids set for primary_charge_is_adjustment detection ───
        adjustment_ids = set()
        if all_charge_ids:
            # Only check chargeIds that are NOT in charge_enrich (not procedures)
            uncovered = [cid for cid in all_charge_ids if cid not in charge_enrich]
            if uncovered:
                ph2 = ",".join("?" for _ in uncovered)
                adj_rows = conn.execute(
                    f"SELECT id FROM adjustments WHERE id IN ({ph2})", uncovered
                ).fetchall()
                adjustment_ids = {r["id"] for r in adj_rows}

        # ── Fallback distribution resolver ────────────────────────────────────────
        def _resolve_enrichment(dists, charge_enrich_map, adj_ids):
            """
            Try primary distribution first; fall back to first resolvable procedure dist.
            Returns (enrich_dict, resolved_charge_id, resolved_dist_index,
                     primary_charge_is_adjustment, unresolved_reason, resolution_method).
            """
            if not dists:
                return {}, None, None, False, "zero_distributions", "none"

            primary = dists[0]
            primary_cid = primary.get("chargeId")

            if not primary_cid:
                return {}, None, None, False, "zero_distributions", "none"

            # Try primary
            if primary_cid in charge_enrich_map:
                enrich = charge_enrich_map[primary_cid]
                # Check deeper resolution failures
                reason = _check_enrich_completeness(enrich)
                method = "primary_distribution" if reason is None else "primary_distribution_partial"
                return enrich, primary_cid, 0, False, reason, method

            # Primary not in procedures — check if it's an adjustment
            is_adj = primary_cid in adj_ids

            # Try fallback distributions[1+]
            for idx, d in enumerate(dists[1:], start=1):
                fb_cid = d.get("chargeId")
                if fb_cid and fb_cid in charge_enrich_map:
                    enrich = charge_enrich_map[fb_cid]
                    reason = _check_enrich_completeness(enrich)
                    method = "fallback_distribution"
                    return enrich, fb_cid, idx, is_adj, reason, method

            # Nothing resolved
            if is_adj:
                reason = "primary_adjustment_no_resolvable_procedure"
            else:
                reason = "charge_id_not_found"
            return {}, None, None, is_adj, reason, "none"

        def _check_enrich_completeness(enrich):
            """Return unresolved_reason if enrichment is incomplete, else None."""
            if not enrich.get("provider_id"):
                return "procedure_missing_provider"
            if not enrich.get("provider_name"):
                return "provider_record_missing"
            if not enrich.get("patient_procedure_id"):
                return "patient_procedure_missing"
            if not enrich.get("ada_code"):
                return "practice_procedure_missing"
            return None  # Fully resolved

        # ── Payment method classifier (Phase 4 — Dentrix-aligned) ─────────────────
        def _classify_payment(billing, note, is_auto_posted):
            """
            Classify into payment_method_group + payment_channel + flags.
            Never exposes full card numbers or referenceNumber.
            Uses creditCardType integer as primary brand signal.
            """
            note       = note or ""
            is_pos     = "POS+ Transaction ID:" in note
            auto_flag  = bool(is_auto_posted)
            note_lower = note.lower()

            # Detect financing keywords in note or cardHolderName
            billing_ch_name = ""
            if billing:
                billing_ch_name = (billing.get("cardHolderName") or "").lower()
            combined_text = f"{note_lower} {billing_ch_name}"
            is_financing = any(kw in combined_text for kw in _FINANCING_KEYWORDS)
            financing_match = None
            if is_financing:
                for kw in _FINANCING_KEYWORDS:
                    if kw in combined_text:
                        financing_match = kw
                        break

            # ── Rule 1: creditCardType → credit_card (confirmed) ──────────────
            if billing:
                cc_type   = billing.get("creditCardType")
                check_num = billing.get("checkNumber")
                ref       = (billing.get("referenceNumber") or "")

                if cc_type is not None:
                    brand = _CC_BRAND_MAP.get(cc_type)
                    label = f"Credit Card ({brand})" if brand else "Credit Card"
                    return {
                        "payment_method_group":      "credit_card",
                        "payment_method_label":      label,
                        "payment_method_detail":     brand,
                        "payment_method_confidence": "confirmed",
                        "payment_channel":           "pos_terminal" if is_pos else "manual",
                        "payment_channel_label":     "POS+ Terminal" if is_pos else "Manual Entry",
                        "card_brand":                brand,
                        "check_number":              None,
                        "is_pos_terminal":           is_pos,
                        "is_auto_posted":            auto_flag,
                        "is_rebill":                 False,  # set by caller
                        "is_ach_or_eft":             False,
                        "is_voided":                 False,
                    }

                # ── Rule 2: checkNumber → check (confirmed) ──────────────────
                if check_num is not None and str(check_num).strip():
                    return {
                        "payment_method_group":      "check",
                        "payment_method_label":      "Check",
                        "payment_method_detail":     None,
                        "payment_method_confidence": "confirmed",
                        "payment_channel":           "manual",
                        "payment_channel_label":     "Manual Entry",
                        "card_brand":                None,
                        "check_number":              str(check_num).strip(),
                        "is_pos_terminal":           False,
                        "is_auto_posted":            auto_flag,
                        "is_rebill":                 False,
                        "is_ach_or_eft":             False,
                        "is_voided":                 False,
                    }

                # ── Rule 5: referenceNumber only → electronic_transfer ────────
                if ref and ref.strip() and cc_type is None and (check_num is None or not str(check_num).strip()):
                    return {
                        "payment_method_group":      "electronic_transfer",
                        "payment_method_label":      "Electronic Transfer",
                        "payment_method_detail":     None,
                        "payment_method_confidence": "inferred",
                        "payment_channel":           "manual",
                        "payment_channel_label":     "Manual Entry",
                        "card_brand":                None,
                        "check_number":              None,
                        "is_pos_terminal":           False,
                        "is_auto_posted":            auto_flag,
                        "is_rebill":                 False,
                        "is_ach_or_eft":             True,
                        "is_voided":                 False,
                    }

            # ── No billing object — secondary signals ─────────────────────────

            # ── Rule 3: POS+ Transaction → credit_card (inferred) + pos_terminal channel
            if is_pos:
                return {
                    "payment_method_group":      "credit_card",
                    "payment_method_label":      "Credit Card",
                    "payment_method_detail":     "POS+ Terminal — card brand not exposed by Dentrix",
                    "payment_method_confidence": "inferred",
                    "payment_channel":           "pos_terminal",
                    "payment_channel_label":     "POS+ Terminal",
                    "card_brand":                None,
                    "check_number":              None,
                    "is_pos_terminal":           True,
                    "is_auto_posted":            auto_flag,
                    "is_rebill":                 False,
                    "is_ach_or_eft":             False,
                    "is_voided":                 False,
                }

            # ── Rule 6: financing keyword in note → patient_financing ─────────
            if is_financing:
                return {
                    "payment_method_group":      "patient_financing",
                    "payment_method_label":      "Patient Financing",
                    "payment_method_detail":     financing_match,
                    "payment_method_confidence": "keyword_inferred",
                    "payment_channel":           "manual",
                    "payment_channel_label":     "Manual Entry",
                    "card_brand":                None,
                    "check_number":              None,
                    "is_pos_terminal":           False,
                    "is_auto_posted":            auto_flag,
                    "is_rebill":                 False,
                    "is_ach_or_eft":             False,
                    "is_voided":                 False,
                }

            # ── Rule 4: isAutomaticallyPosted + no billing → unknown ──────────
            if auto_flag:
                return {
                    "payment_method_group":      "unknown",
                    "payment_method_label":      "Unknown",
                    "payment_method_detail":     "Auto-posted allocation — tender type not exposed by Dentrix",
                    "payment_method_confidence": "unknown",
                    "payment_channel":           "auto_posted",
                    "payment_channel_label":     "Auto-Posted",
                    "card_brand":                None,
                    "check_number":              None,
                    "is_pos_terminal":           False,
                    "is_auto_posted":            True,
                    "is_rebill":                 False,
                    "is_ach_or_eft":             False,
                    "is_voided":                 False,
                }

            # ── Rule 7: no signal → cash (inferred by elimination) ────────────
            return {
                "payment_method_group":      "cash",
                "payment_method_label":      "Cash / Unclassified",
                "payment_method_detail":     None,
                "payment_method_confidence": "inferred",
                "payment_channel":           "manual",
                "payment_channel_label":     "Manual Entry",
                "card_brand":                None,
                "check_number":              None,
                "is_pos_terminal":           False,
                "is_auto_posted":            False,
                "is_rebill":                 False,
                "is_ach_or_eft":             False,
                "is_voided":                 False,
            }

        # ── Build results (paginated data[]) ──────────────────────────────────────
        results = []
        for r in rows:
            raw_json   = json.loads(r["raw"] or "{}")
            office     = LOCATION_NAMES.get(r["location_id"], "Unknown")
            patient    = patients.get(r["patient_id"], "Unknown Patient")
            billing    = raw_json.get("patientPaymentBilling")
            note       = raw_json.get("note") or ""
            auto_post  = bool(raw_json.get("isAutomaticallyPosted"))
            pm         = _classify_payment(billing, note, auto_post)
            pm["is_rebill"] = r["ledger_type"] == "PatientProcedurePaymentRebill"

            # ── Distribution analysis ──────────────────────────────────────
            dists      = row_dist_map.get(r["id"]) or []
            dist_count = len(dists)
            primary_dist        = dists[0] if dists else {}
            primary_charge_id   = primary_dist.get("chargeId")
            primary_applied_amt = primary_dist.get("appliedAmount")

            dist_total_applied = sum(
                float(d.get("appliedAmount") or 0)
                for d in dists
                if d.get("isActive") is not False
            )

            # ── Fallback-aware enrichment (Phase 4) ───────────────────────
            enrich, resolved_cid, resolved_idx, primary_is_adj, unresolved_reason, resolution_method = \
                _resolve_enrichment(dists, charge_enrich, adjustment_ids)

            # Multi-provider check across ALL distributions
            resolved_providers = set()
            for d in dists:
                cid = d.get("chargeId")
                if cid and cid in charge_enrich and charge_enrich[cid].get("provider_id"):
                    resolved_providers.add(charge_enrich[cid]["provider_id"])
            multi_provider = len(resolved_providers) > 1

            prov_id   = enrich.get("provider_id")
            prov_name = enrich.get("provider_name")
            svc_date      = enrich.get("service_date")
            ada_code      = enrich.get("ada_code")
            proc_desc     = enrich.get("procedure_description")
            svc_category  = enrich.get("service_category")
            list_fee      = enrich.get("procedure_list_fee")
            proc_amt      = enrich.get("proc_charge_amount")
            pat_proc_id   = enrich.get("patient_procedure_id")
            prac_proc_id  = enrich.get("practice_procedure_id")

            results.append({
                # ── Identity ──────────────────────────────────────────────
                "id":                    r["id"],
                "source_transaction_id": r["id"],
                "patient_payment_id":    r["id"],
                "patient_id":            r["patient_id"],
                "patient_name":          patient,
                "location_id":           r["location_id"],
                "office":                office,
                "office_id":             LOCATION_TO_OFFICE.get(r["location_id"], r["location_id"]),

                # ── Dates ─────────────────────────────────────────────────
                "payment_date":          r["transaction_date"],
                "service_date":          svc_date,
                "date_of_service":       None,

                # ── Amount ────────────────────────────────────────────────
                "amount_collected":      abs(float(r["amount"] or 0)),
                "expected_amount":       None,
                "collection_rate":       None,

                # ── Ledger ────────────────────────────────────────────────
                "ledger_type":           r["ledger_type"],
                "is_rebill":             pm["is_rebill"],
                "paid_at_visit":         True,
                "auto_posted":           auto_post,

                # ── Payment method (Phase 4 — Dentrix-aligned model) ──────
                "payment_method":              pm["payment_method_group"],   # legacy alias
                "payment_method_group":        pm["payment_method_group"],
                "payment_method_label":        pm["payment_method_label"],
                "payment_method_detail":       pm["payment_method_detail"],
                "payment_method_confidence":   pm["payment_method_confidence"],
                "payment_channel":             pm["payment_channel"],
                "payment_channel_label":       pm["payment_channel_label"],
                "card_brand":                  pm["card_brand"],
                "card_type":                   pm["card_brand"],   # legacy alias
                "check_number":                pm["check_number"],
                "is_pos_terminal":             pm["is_pos_terminal"],
                "is_auto_posted":              pm["is_auto_posted"],
                "is_ach_or_eft":               pm["is_ach_or_eft"],
                "is_voided":                   pm["is_voided"],

                # ── Provider (fallback-aware) ─────────────────────────────
                "provider_id":           prov_id,
                "provider_name":         prov_name,
                "provider":              prov_name,
                "multi_provider":        multi_provider,

                # ── Service code (fallback-aware) ─────────────────────────
                "service_date_source":   "patient_procedures.service_date" if svc_date else None,
                "procedure_id":          resolved_cid,
                "patient_procedure_id":  pat_proc_id,
                "practice_procedure_id": prac_proc_id,
                "service_code":          ada_code,
                "service_codes":         ada_code,
                "ada_code":              ada_code,
                "procedure_description": proc_desc,
                "service_category":      svc_category,
                "procedure_amount":      proc_amt,
                "procedure_list_fee":    list_fee,

                # ── Distribution resolution (Phase 4) ─────────────────────
                "distribution_count":                dist_count,
                "has_multiple_distributions":        dist_count > 1,
                "primary_charge_id":                 primary_charge_id,
                "resolved_charge_id":                resolved_cid,
                "resolved_distribution_index":       resolved_idx,
                "primary_charge_is_adjustment":      primary_is_adj,
                "unresolved_reason":                 unresolved_reason,
                "enrichment_resolution_method":      resolution_method,
                "primary_applied_amount":            primary_applied_amt,
                "distribution_total_applied_amount": round(dist_total_applied, 2) if dists else None,
                "charge_id":                         resolved_cid or primary_charge_id,

                # ── Deprecated stubs ──────────────────────────────────────
                "claim_id":              None,
                "line_of_business":      "Patient",
                "note":                  note,

                # ── Source metadata ───────────────────────────────────────
                "_source":               "dentrix_ascend",
                "_source_table":         "patient_payments",
                "_enriched":             True,
                "_enrichment_source":    (
                    f"procedures+providers+patient_procedures+practice_procedures via distributions[{resolved_idx}].chargeId"
                    if resolved_idx is not None else
                    "unresolved — no distribution chargeId matched a procedure"
                ),
                "_enrichment_warning":   (
                    "provider_name, service_date, ada_code from first resolvable procedure distribution. "
                    "multi_provider=true means this payment spans additional providers not shown. "
                    "Null fields indicate join did not resolve — see unresolved_reason."
                ) if resolved_cid else (
                    f"Enrichment unresolved: {unresolved_reason}. "
                    "Provider and service code fields are null — not guessed."
                ),
            })

        # ── Full-scope summary (all_rows, not just current page) ──────────────────
        sum_total_events   = 0
        sum_total_amount   = 0.0
        sum_unique_patients: set = set()

        sum_by_ledger = {
            "PatientProcedurePayment":       {"count": 0, "amount": 0.0},
            "PatientProcedurePaymentRebill": {"count": 0, "amount": 0.0},
        }

        # Phase 4 summary accumulators
        _pmg_keys = ["cash", "check", "credit_card", "electronic_transfer", "patient_financing", "unknown"]
        sum_by_pmg:        dict = {k: {"count": 0, "amount": 0.0} for k in _pmg_keys}

        _channel_keys = ["manual", "pos_terminal", "auto_posted", "unknown"]
        sum_by_channel:    dict = {k: {"count": 0, "amount": 0.0} for k in _channel_keys}

        _brand_keys = ["Visa", "Mastercard", "AmEx", "Discover", None]
        sum_by_brand:      dict = {str(k): {"count": 0, "amount": 0.0} for k in _brand_keys}

        _conf_keys = ["confirmed", "inferred", "keyword_inferred", "unknown"]
        sum_by_confidence: dict = {k: {"count": 0, "amount": 0.0} for k in _conf_keys}

        # Legacy by_payment_method (for frontend compat — aligned to payment_method_group)
        sum_by_pm_legacy:  dict = {k: {"count": 0, "amount": 0.0} for k in _pmg_keys}

        sum_by_office:    dict = {}
        sum_by_provider:  dict = {}
        sum_by_svc_cat:   dict = {}
        sum_by_svc_code:  dict = {}

        multi_dist_count = 0; multi_dist_amount = 0.0
        multi_prov_ind_count = 0; multi_prov_ind_amount = 0.0
        zero_dist_count = 0; zero_dist_amount = 0.0
        unresolved_proc_count = 0; unresolved_proc_amount = 0.0
        resolved_via_fallback_count = 0; resolved_via_fallback_amount = 0.0
        primary_adj_count = 0; primary_adj_amount = 0.0

        # Unresolved reason counts
        sum_by_unresolved_reason: dict = {}

        for r in all_rows:
            raw_j2   = json.loads(r["raw"] or "{}")
            amt2     = abs(float(r["amount"] or 0))
            sum_total_events  += 1
            sum_total_amount  += amt2
            sum_unique_patients.add(r["patient_id"])

            # Ledger type
            lt2 = r["ledger_type"] or "PatientProcedurePayment"
            lt2_key = lt2 if lt2 in sum_by_ledger else "PatientProcedurePayment"
            sum_by_ledger[lt2_key]["count"]  += 1
            sum_by_ledger[lt2_key]["amount"] += amt2

            # Payment method (Phase 4)
            billing2   = raw_j2.get("patientPaymentBilling")
            note2      = raw_j2.get("note") or ""
            auto_post2 = bool(raw_j2.get("isAutomaticallyPosted"))
            pm2        = _classify_payment(billing2, note2, auto_post2)

            pmg2 = pm2["payment_method_group"] if pm2["payment_method_group"] in sum_by_pmg else "unknown"
            sum_by_pmg[pmg2]["count"]  += 1
            sum_by_pmg[pmg2]["amount"] += amt2

            ch2 = pm2["payment_channel"] if pm2["payment_channel"] in sum_by_channel else "unknown"
            sum_by_channel[ch2]["count"]  += 1
            sum_by_channel[ch2]["amount"] += amt2

            brand2 = str(pm2["card_brand"])
            if brand2 not in sum_by_brand:
                sum_by_brand[brand2] = {"count": 0, "amount": 0.0}
            sum_by_brand[brand2]["count"]  += 1
            sum_by_brand[brand2]["amount"] += amt2

            conf2 = pm2["payment_method_confidence"] if pm2["payment_method_confidence"] in sum_by_confidence else "unknown"
            sum_by_confidence[conf2]["count"]  += 1
            sum_by_confidence[conf2]["amount"] += amt2

            # Legacy payment method (aligned to group)
            pm_leg = pmg2 if pmg2 in sum_by_pm_legacy else "unknown"
            sum_by_pm_legacy[pm_leg]["count"]  += 1
            sum_by_pm_legacy[pm_leg]["amount"] += amt2

            # Office
            loc2      = r["location_id"]
            off2_name = LOCATION_NAMES.get(loc2, "Unknown")
            if loc2 not in sum_by_office:
                sum_by_office[loc2] = {"office": off2_name, "location_id": loc2, "count": 0, "amount": 0.0}
            sum_by_office[loc2]["count"]  += 1
            sum_by_office[loc2]["amount"] += amt2

            # Distribution metrics
            dists2      = row_dist_map.get(r["id"]) or []
            dist2_count = len(dists2)
            if dist2_count == 0:
                zero_dist_count  += 1
                zero_dist_amount += amt2
            elif dist2_count > 1:
                multi_dist_count  += 1
                multi_dist_amount += amt2

            # Fallback-aware enrichment for summary
            enrich2, resolved2_cid, resolved2_idx, primary2_is_adj, unresolved2_reason, resolution2_method = \
                _resolve_enrichment(dists2, charge_enrich, adjustment_ids)

            if primary2_is_adj:
                primary_adj_count  += 1
                primary_adj_amount += amt2

            if resolution2_method == "fallback_distribution":
                resolved_via_fallback_count  += 1
                resolved_via_fallback_amount += amt2

            # Multi-provider
            resolved2_provs = set()
            for d2 in dists2:
                cid2 = d2.get("chargeId")
                if cid2 and cid2 in charge_enrich and charge_enrich[cid2].get("provider_id"):
                    resolved2_provs.add(charge_enrich[cid2]["provider_id"])
            if len(resolved2_provs) > 1:
                multi_prov_ind_count  += 1
                multi_prov_ind_amount += amt2

            # Unresolved tracking
            if unresolved2_reason:
                if unresolved2_reason not in sum_by_unresolved_reason:
                    sum_by_unresolved_reason[unresolved2_reason] = {"count": 0, "amount": 0.0}
                sum_by_unresolved_reason[unresolved2_reason]["count"]  += 1
                sum_by_unresolved_reason[unresolved2_reason]["amount"] += amt2
                unresolved_proc_count  += 1
                unresolved_proc_amount += amt2

            # Provider accumulator (using resolved enrichment)
            prov2_id   = enrich2.get("provider_id")
            prov2_name = enrich2.get("provider_name")
            prov2_key  = prov2_id if prov2_id else "__unresolved_provider__"
            prov2_disp = prov2_name if prov2_name else "Unresolved Provider"
            if prov2_key not in sum_by_provider:
                sum_by_provider[prov2_key] = {
                    "provider_id": prov2_id, "provider_name": prov2_disp,
                    "count": 0, "amount": 0.0, "multi_provider_count": 0,
                }
            sum_by_provider[prov2_key]["count"]  += 1
            sum_by_provider[prov2_key]["amount"] += amt2
            if len(resolved2_provs) > 1:
                sum_by_provider[prov2_key]["multi_provider_count"] += 1

            # Service category
            svc2_cat = enrich2.get("service_category") or "Unresolved Service"
            if svc2_cat not in sum_by_svc_cat:
                sum_by_svc_cat[svc2_cat] = {"service_category": svc2_cat, "count": 0, "amount": 0.0}
            sum_by_svc_cat[svc2_cat]["count"]  += 1
            sum_by_svc_cat[svc2_cat]["amount"] += amt2

            # Service code
            ada2       = enrich2.get("ada_code")
            proc2_desc = enrich2.get("procedure_description")
            ada2_key   = ada2 if ada2 else "__unresolved__"
            if ada2_key not in sum_by_svc_code:
                sum_by_svc_code[ada2_key] = {
                    "ada_code": ada2, "procedure_description": proc2_desc if ada2 else "Unresolved Service Code",
                    "count": 0, "amount": 0.0,
                }
            sum_by_svc_code[ada2_key]["count"]  += 1
            sum_by_svc_code[ada2_key]["amount"] += amt2

        # ── Round summary outputs ─────────────────────────────────────────────────
        for _d in [sum_by_ledger, sum_by_pmg, sum_by_channel, sum_by_brand, sum_by_confidence,
                   sum_by_pm_legacy]:
            for _v in _d.values():
                _v["amount"] = round(_v["amount"], 2)
        for _d2 in [sum_by_office, sum_by_provider, sum_by_svc_cat, sum_by_svc_code,
                    sum_by_unresolved_reason]:
            for _v2 in _d2.values():
                _v2["amount"] = round(_v2["amount"], 2)

        avg_payment_amt = round(sum_total_amount / sum_total_events, 2) if sum_total_events else 0.0
        by_office_list = sorted(sum_by_office.values(), key=lambda x: x["amount"], reverse=True)
        by_provider_top = sorted(sum_by_provider.values(), key=lambda x: x["amount"], reverse=True)[:10]
        by_svc_cat_list = sorted(sum_by_svc_cat.values(), key=lambda x: x["amount"], reverse=True)
        by_svc_code_top = sorted(
            [v for k, v in sum_by_svc_code.items() if k != "__unresolved__"],
            key=lambda x: x["amount"], reverse=True
        )[:10]

        resolved_count = sum_total_events - unresolved_proc_count
        resolved_pct = round(100 * resolved_count / sum_total_events, 1) if sum_total_events else 0

        summary = {
            # 1. Overall totals
            "total_payment_events":   sum_total_events,
            "total_amount_collected": round(sum_total_amount, 2),
            "unique_patients_count":  len(sum_unique_patients),
            "average_payment_amount": avg_payment_amt,

            # 2. Ledger type breakdown
            "by_ledger_type": {
                "PatientProcedurePayment":       sum_by_ledger["PatientProcedurePayment"],
                "PatientProcedurePaymentRebill": sum_by_ledger["PatientProcedurePaymentRebill"],
            },
            "fresh_payment_count":  sum_by_ledger["PatientProcedurePayment"]["count"],
            "fresh_payment_amount": sum_by_ledger["PatientProcedurePayment"]["amount"],
            "rebill_count":         sum_by_ledger["PatientProcedurePaymentRebill"]["count"],
            "rebill_amount":        sum_by_ledger["PatientProcedurePaymentRebill"]["amount"],

            # 3. Payment method breakdown (Phase 4 — Dentrix-aligned)
            "by_payment_method_group": {k: sum_by_pmg[k] for k in _pmg_keys},
            "by_payment_channel":      {k: sum_by_channel[k] for k in _channel_keys},
            "by_card_brand":           {k: v for k, v in sorted(sum_by_brand.items(), key=lambda x: -x[1]["count"]) if v["count"] > 0},
            "by_payment_method_confidence": {k: sum_by_confidence[k] for k in _conf_keys},

            # Legacy by_payment_method (aligned to payment_method_group for frontend compat)
            "by_payment_method": {k: sum_by_pm_legacy[k] for k in _pmg_keys},

            # Convenience fields
            "pos_terminal_count":   sum_by_channel["pos_terminal"]["count"],
            "pos_terminal_amount":  sum_by_channel["pos_terminal"]["amount"],
            "auto_posted_count":    sum_by_channel["auto_posted"]["count"],
            "auto_posted_amount":   sum_by_channel["auto_posted"]["amount"],

            # 4. Office breakdown
            "by_office": by_office_list,

            # 5. Provider breakdown — top 10 by amount
            "by_provider_top": by_provider_top,

            # 6. Service category breakdown
            "by_service_category": by_svc_cat_list,

            # 7. Service code breakdown — top 10 by amount
            "by_service_code_top": by_svc_code_top,

            # 8. Distribution / resolution indicators (Phase 4)
            "multi_distribution_count":        multi_dist_count,
            "multi_distribution_amount":       round(multi_dist_amount, 2),
            "multi_provider_count":            multi_prov_ind_count,
            "multi_provider_amount":           round(multi_prov_ind_amount, 2),
            "zero_distribution_count":         zero_dist_count,
            "zero_distribution_amount":        round(zero_dist_amount, 2),
            "resolved_provider_service_count": resolved_count,
            "resolved_provider_service_pct":   resolved_pct,
            "unresolved_procedure_count":      unresolved_proc_count,
            "unresolved_procedure_amount":     round(unresolved_proc_amount, 2),
            "resolved_via_fallback_count":     resolved_via_fallback_count,
            "resolved_via_fallback_amount":    round(resolved_via_fallback_amount, 2),
            "primary_charge_is_adjustment_count":  primary_adj_count,
            "primary_charge_is_adjustment_amount": round(primary_adj_amount, 2),
            "by_unresolved_reason":            sum_by_unresolved_reason,

            # 9. Metadata notes
            "_note":        "POS Collections scorecards are calculated from the full filtered result set, not the current paginated table page.",
            "_amount_note": "Amounts are patient payment event amounts from Dentrix patient_payments where paidAtVisit=true. These are not patient-responsible expected amounts and do not represent collection rate.",
            "_enrichment_note": (
                "Provider and service code fields use the primary distribution (distributions[0]) when it resolves to a procedure. "
                "If distributions[0].chargeId points to an adjustment (not a procedure), the first resolvable procedure distribution is used instead. "
                "Unresolved rows have null provider/service fields and an unresolved_reason field explaining why."
            ),
            "_scope": {
                "total_rows_in_filter": sum_total_events,
                "start_date":           s,
                "end_date":             e,
                "location_filter":      locationId or officeId or "all",
            },
        }

        return {
            "data": results,
            "pagination": {
                "page":          page,
                "page_size":     pageSize,
                "total_rows":    total_rows,
                "total_pages":   total_pages,
                "has_next_page": has_next,
            },
            "metadata": {
                "source":                 "patient_payments",
                "source_definition":      "Dentrix patient payments with paidAtVisit=true, is_active=1, amount<0",
                "amount_definition":      "Full patient payment row amount. Not procedure-allocation-aware. A single payment covering multiple procedures appears as one row.",
                "date_definition":        "payment_date = patient_payments.transaction_date (payment posting date). service_date = patient_procedures.service_date (true service date via join). date_of_service is null/deprecated.",
                "provider_definition":    "provider_name from first resolvable procedure distribution chargeId → procedures.provider_id → providers. Falls back to distributions[1+] when distributions[0] is an adjustment. Null if no distribution resolves. multi_provider=true if distributions span multiple providers.",
                "service_code_definition":"ada_code from first resolvable procedure distribution → practice_procedures.ada_code. service_date from patient_procedures.service_date. Null if no distribution resolves.",
                "payment_method_definition": (
                    "payment_method_group: primary tender type (cash/check/credit_card/electronic_transfer/patient_financing/unknown). "
                    "payment_channel: how the payment was captured (manual/pos_terminal/auto_posted). "
                    "Card brand from creditCardType integer enum (1=Visa,2=Mastercard,3=AmEx,4=Discover). "
                    "POS+ Terminal is a channel, not a method — payment_method_group=credit_card for POS+ rows. "
                    "Auto-Posted is a channel flag — payment_method_group=unknown for auto-posted rows without billing."
                ),
                "procedure_list_fee_note":"procedure_list_fee is the practice fee schedule amount only. It is NOT patient_portion, NOT expected_amount, and must NOT be used to compute collection_rate.",
                "expected_amount_note":   "expected_amount and collection_rate are not returned. Use /v2/rcm/guarantor-reconciliation for patient portion, remaining balance, and collection rate.",
                "ledger_type_warning":    "PatientProcedurePaymentRebill rows are included. Rebill rows inherit paidAtVisit=true from the original payment; their payment_date may differ from service_date.",
                "payment_method_note":    "Phase 4: payment_method_group is the Dentrix-aligned tender type. payment_channel is the capture method. Auto-Posted and POS Terminal are channels/flags, not primary payment methods.",
                "enrichment_match_rate":  f"{resolved_pct}% of rows resolve provider/service_code (fallback-aware). Unresolved rows have null provider/service fields and unresolved_reason.",
                "start_date":             s,
                "end_date":               e,
            },
            "summary": summary,
        }
    finally:
        conn.close()



@app.get("/v2/rcm/collection-refunds", tags=["RCM"], dependencies=[Depends(verify_api_key)])
def rcm_collection_refunds(
    startDate:  Optional[str] = Query(None), start:  Optional[str] = Query(None),
    endDate:    Optional[str] = Query(None), end:    Optional[str] = Query(None),
    locationId: Optional[str] = Query(None), officeId: Optional[str] = Query(None),
    refundType: Optional[str] = Query(None, description="all|insurance_refund|patient_refund|credit_card_refund|refund_review"),
    includeNonRefundAdjustments: bool = Query(False, description="Include write-off/balance-correction rows marked as non-refund review"),
    minAmount:  Optional[float] = Query(None, description="Minimum absolute refund amount"),
    search:     Optional[str]   = Query(None, description="Search patient name or note"),
    page:       int = Query(1),
    pageSize:   int = Query(500),
):
    """
    RCM Collection Refunds — OLT-aware refund ledger for RCM dashboard.

    Phase 1 rewrite (2026-05-10):
    - OLT-based classification (not broad ledger_type)
    - Includes true insurance refunds + patient refunds + credit card refunds
    - Excludes write-offs / balance corrections from refund totals (opt-in via includeNonRefundAdjustments)
    - Envelope: data, summary, pagination, metadata
    - Real pagination; summary is full-filter-scope (not page-scope)
    - Staff/provider/payor resolution; signed + absolute amounts
    - Void/cancellation/rebill rows excluded by default (is_active=1 only)

    Source: adjustments table (Dentrix Ascend SQLite)
    Date basis: transaction_date
    """

    s = startDate or start or "2026-01-01"
    e = endDate   or end   or "2099-12-31"
    page     = max(1, page)
    pageSize = max(1, min(pageSize, 2000))
    offset   = (page - 1) * pageSize

    # ── Validate locationId ───────────────────────────────────────────────
    _VALID_LOCS = {"14000000000432", "14000000000433", "14000000000434", "14000000000435"}
    if locationId and locationId not in _VALID_LOCS:
        if len(locationId) > 20 or "-" in locationId:
            from fastapi import HTTPException as _H
            raise _H(status_code=400,
                      detail="locationId must be a Dentrix numeric ID (e.g. 14000000000433), not a dashboard UUID. Use officeId for UUIDs.")

    # ── OLT classification ────────────────────────────────────────────────
    # Tuple: (refund_type, refund_type_label, refund_group, olt_name)
    _REFUND_OLTS = {
        "14000000010443": ("insurance_overpayment_refund",    "Insurance Overpayment Refund",    "insurance_refund",   "Insurance Over-pmt Refund"),
        "14000000010449": ("insurance_offsetting_adj",        "Insurance Offsetting Adjustment",  "insurance_refund",   "Ins Charge Offsetting Adjustment"),
        "14000000010446": ("patient_refund",                  "Patient Refund",                   "patient_refund",     "Patient Refund"),
        "14000000010450": ("credit_card_full_refund",         "Credit Card Full Refund",          "credit_card_refund", "Credit Card Full Refund"),
        "14000000021755": ("credit_card_partial_refund",      "Credit Card Partial Refund",       "credit_card_refund", "Credit Card Partial Refund"),
        "14000000022515": ("credit_card_independent_refund",  "Credit Card Independent Refund",   "credit_card_refund", "Credit Card Independent Refund"),
    }
    _NON_REFUND_OLTS = {
        "14000000010442": ("insurance_writeoff", "Insurance Write-Off",  "refund_review", "Insurance Adjustment"),
        "14000000010448": ("balance_correction", "Balance Correction",   "refund_review", "Transfer Charge Balance"),
    }
    _ALL_OLTS = {**_REFUND_OLTS, **_NON_REFUND_OLTS}

    # ── refundType filter ─────────────────────────────────────────────────
    _TYPE_GROUPS = {
        "insurance_refund":   {"insurance_overpayment_refund", "insurance_offsetting_adj"},
        "patient_refund":     {"patient_refund"},
        "credit_card_refund": {"credit_card_full_refund", "credit_card_partial_refund", "credit_card_independent_refund"},
        "refund_review":      {"insurance_writeoff", "balance_correction"},
    }
    requested_types = None
    if refundType and refundType != "all":
        if refundType in _TYPE_GROUPS:
            requested_types = _TYPE_GROUPS[refundType]
        else:
            from fastapi import HTTPException as _H
            raise _H(status_code=400,
                      detail=f"Invalid refundType '{refundType}'. Valid: all, insurance_refund, patient_refund, credit_card_refund, refund_review")

    # ── User cache (seeded + lazy API fetch) ──────────────────────────────
    _KNOWN_USERS = {
        "14000000011647": "Ny Velez",        "14000000025678": "Elizabeth Velez",
        "14000000033227": "Viv Diaz",        "14000000017582": "eAssist Dental Solutions",
        "14000000025410": "Courtney Spaeth", "14000000036783": "Angela Moore",
        "14000000029208": "Cami Lott",       "14000000039529": "Latifa Motley",
        "14000000041949": "Mildred Fortune", "14000000045562": "Natasha Torok",
        "14000000046283": "Courtney Wilson", "14000000011514": "Admasu Gizachew",
        "14000000011643": "Nebraska Chaplick","14000000032056": "Sheryl Dubman",
        "14000000036678": "Katherine Soto",
    }
    _ucache = getattr(rcm_collection_refunds, "_user_cache", None)
    if _ucache is None:
        _ucache = dict(_KNOWN_USERS)
        rcm_collection_refunds._user_cache = _ucache

    def _fetch_missing_users(ids):
        missing = [u for u in set(ids) if u and u not in _ucache][:20]
        if not missing:
            return
        try:
            import requests as _req
            with open("/home/openclaw/.config/ascend/production.json") as _f:
                _creds = json.load(_f)
            _tok = _req.post(_creds["oauth_url"],
                data={"client_id": _creds["api_key"], "client_secret": _creds["secret"]},
                timeout=30).json().get("access_token")
            if not _tok:
                return
            _hdrs = {"Authorization": f"Bearer {_tok}", "Organization-ID": _creds["org_id"]}
            for uid in missing:
                try:
                    r = _req.get(f"{_creds['api_base']}/v1/users/{uid}", headers=_hdrs, timeout=10)
                    if r.status_code == 200:
                        d = r.json().get("data", r.json())
                        _ucache[uid] = f"{d.get('firstName','')}{' ' if d.get('firstName') else ''}{d.get('lastName','')}".strip()
                except Exception:
                    pass
        except Exception:
            pass

    # ── Provider cache ────────────────────────────────────────────────────
    _prov_cache = getattr(rcm_collection_refunds, "_prov_cache", None)
    if _prov_cache is None:
        _prov_cache = {}
        rcm_collection_refunds._prov_cache = _prov_cache

    conn = rcm_db()
    try:
        patients = rcm_patient_map(conn)

        # Build provider lookup (one-time per process)
        if not _prov_cache:
            for pr in conn.execute("SELECT id, raw FROM providers").fetchall():
                praw = json.loads(pr["raw"] or "{}")
                _prov_cache[pr["id"]] = f"{praw.get('firstName','')}{' ' if praw.get('firstName') else ''}{praw.get('lastName','')}".strip()

        where, prms = rcm_filter_clause(s, e, location_id=locationId, office_id=officeId)

        # ── Fetch rows ────────────────────────────────────────────────────
        # Two ledger types carry refund-related OLTs:
        #   InsuranceRefundAdjustment  → insurance refunds + some writeoffs
        #   PatientChargeAdjustment    → patient/CC refunds + some writeoffs
        ledger_types = ["InsuranceRefundAdjustment", "PatientChargeAdjustment"]
        lt_ph = ",".join("?" * len(ledger_types))

        all_rows = conn.execute(
            f"""SELECT id, transaction_date, entry_date, amount, provider_id,
                       location_id, patient_id, ledger_type, is_active,
                       last_modified, raw
                FROM adjustments
                WHERE {where}
                AND ledger_type IN ({lt_ph})
                AND is_active = 1
                AND amount > 0
                ORDER BY transaction_date DESC""",
            prms + ledger_types
        ).fetchall()

        # ── Build payor lookup from insurance_claims via linked insurance_payment_id ──
        # Collect all insurance_payment IDs first, then batch-resolve claim → payor
        _ins_pay_ids = set()
        _raw_cache = {}
        for r in all_rows:
            raw_j = json.loads(r["raw"] or "{}")
            _raw_cache[r["id"]] = raw_j
            ins_p = raw_j.get("insurancePayment")
            if isinstance(ins_p, dict) and ins_p.get("id"):
                _ins_pay_ids.add(ins_p["id"])

        # Resolve: insurance_payment → insurance_claim → payorName
        _payor_map = {}   # ins_payment_id → payor_name
        _claim_map = {}   # ins_payment_id → claim_id
        if _ins_pay_ids:
            ph = ",".join("?" * len(_ins_pay_ids))
            ip_rows = conn.execute(
                f"""SELECT ip.id,
                           json_extract(ip.raw, '$.insuranceClaim.id') as claim_id,
                           json_extract(ic.raw, '$.payorName')         as payor_name
                    FROM insurance_payments ip
                    LEFT JOIN insurance_claims ic
                      ON json_extract(ip.raw, '$.insuranceClaim.id') = ic.id
                    WHERE ip.id IN ({ph})""",
                list(_ins_pay_ids)
            ).fetchall()
            for ipr in ip_rows:
                if ipr["payor_name"]:
                    _payor_map[ipr["id"]] = ipr["payor_name"]
                if ipr["claim_id"]:
                    _claim_map[ipr["id"]] = ipr["claim_id"]

        # ── Classify & filter ─────────────────────────────────────────────
        items = []
        user_ids_needed = set()

        for r in all_rows:
            raw_j = _raw_cache[r["id"]]
            olt_id = None
            olt_obj = raw_j.get("organizationLedgerType")
            if isinstance(olt_obj, dict):
                olt_id = olt_obj.get("id")

            if olt_id not in _ALL_OLTS:
                continue

            refund_code, refund_label, refund_group, olt_name = _ALL_OLTS[olt_id]
            is_true_refund = olt_id in _REFUND_OLTS

            # Non-refund: skip unless opted in
            if not is_true_refund and not includeNonRefundAdjustments:
                continue

            # refundType filter
            if requested_types and refund_code not in requested_types:
                continue

            # Amount
            raw_amount = float(r["amount"] or 0)
            abs_amt = abs(raw_amount)
            if minAmount is not None and abs_amt < minAmount:
                continue

            # Resolve names
            patient_name = patients.get(r["patient_id"], "Unknown Patient")
            office_name  = LOCATION_NAMES.get(r["location_id"], "Unknown")
            office_uuid  = LOCATION_TO_OFFICE.get(r["location_id"], r["location_id"])

            # Staff (onlineUser)
            online_user_id = None
            ou = raw_j.get("onlineUser")
            if isinstance(ou, dict):
                online_user_id = ou.get("id")
            if online_user_id:
                user_ids_needed.add(online_user_id)

            # Provider
            prov_id = r["provider_id"] or (raw_j.get("provider", {}) or {}).get("id")

            # Payment method
            billing = raw_j.get("patientPaymentBilling")
            payment_method = None
            if isinstance(billing, dict):
                if billing.get("creditCardTransaction"):
                    payment_method = "credit_card"
                elif billing.get("checkNumber"):
                    payment_method = "check"
                elif billing.get("referenceNumber"):
                    payment_method = "electronic_transfer"

            # Insurance payment link
            ins_payment_id = None
            ins_p = raw_j.get("insurancePayment")
            if isinstance(ins_p, dict):
                ins_payment_id = ins_p.get("id")

            # Payor + claim from insurance payment chain
            payor = _payor_map.get(ins_payment_id) if ins_payment_id else None
            claim_id = _claim_map.get(ins_payment_id) if ins_payment_id else None

            note = raw_j.get("note", "") or ""

            # Search filter
            if search:
                s_lower = search.lower()
                if s_lower not in (patient_name or "").lower() and s_lower not in note.lower():
                    continue

            # Boolean group flags
            is_ins  = refund_group == "insurance_refund"
            is_pat  = refund_group == "patient_refund"
            is_cc   = refund_group == "credit_card_refund"
            is_non  = refund_group == "refund_review"

            items.append({
                "_raw":                          raw_j,
                "id":                            r["id"],
                "patient_id":                    r["patient_id"],
                "patient_name":                  patient_name,
                "office_id":                     office_uuid,
                "office":                        office_name,
                "location_id":                   r["location_id"],
                "refund_date":                   r["transaction_date"],
                "date_basis":                    "transaction_date",
                "refund_amount":                 abs_amt,
                "refund_amount_signed":          raw_amount,
                "refund_type":                   refund_code,
                "refund_type_label":             refund_label,
                "is_true_refund":                is_true_refund,
                "is_patient_refund":             is_pat,
                "is_insurance_refund":           is_ins,
                "is_credit_card_refund":         is_cc,
                "is_non_refund_adjustment":      is_non,
                "non_refund_adjustment_type":    refund_code if is_non else None,
                "ledger_type":                   r["ledger_type"],
                "organization_ledger_type_id":   olt_id,
                "organization_ledger_type_name": olt_name,
                "reason":                        note if note else refund_label,
                "note":                          note,
                "status":                        "active",
                "is_active":                     True,
                "is_voided_or_cancelled":        False,
                "provider_id":                   prov_id,
                "provider_name":                 _prov_cache.get(prov_id, None) if prov_id else None,
                "entered_by_user_id":            online_user_id,
                "entered_by_name":               None,   # resolved after user fetch
                "insurance_payment_id":          ins_payment_id,
                "is_automatically_posted":       raw_j.get("isAutomaticallyPosted"),
                "claim_id":                      claim_id,
                "payor":                         payor,
                "payment_method":                payment_method,
                "source_note":                   "Dentrix Ascend adjustment ledger",
            })

        # ── Resolve staff names ───────────────────────────────────────────
        _fetch_missing_users(list(user_ids_needed))
        for item in items:
            uid = item["entered_by_user_id"]
            if uid:
                item["entered_by_name"] = _ucache.get(uid, f"User {uid}")

        # ── Summary (full-filter-scope, before pagination) ────────────────
        refund_items     = [i for i in items if i["is_true_refund"]]
        non_refund_items = [i for i in items if not i["is_true_refund"]]

        total_refund_amount = round(sum(i["refund_amount"] for i in refund_items), 2)
        total_refund_count  = len(refund_items)

        # By group
        by_group = {}
        for i in items:
            g = "insurance_refund" if i["is_insurance_refund"] else \
                "patient_refund"   if i["is_patient_refund"]   else \
                "credit_card_refund" if i["is_credit_card_refund"] else "non_refund_adjustment"
            if g not in by_group:
                by_group[g] = {"count": 0, "amount": 0.0}
            by_group[g]["count"] += 1
            by_group[g]["amount"] = round(by_group[g]["amount"] + i["refund_amount"], 2)

        # By office (refunds only)
        by_office = {}
        for i in refund_items:
            o = i["office"]
            if o not in by_office:
                by_office[o] = {"count": 0, "amount": 0.0}
            by_office[o]["count"] += 1
            by_office[o]["amount"] = round(by_office[o]["amount"] + i["refund_amount"], 2)

        # By refund_type
        by_type = {}
        for i in items:
            t = i["refund_type"]
            if t not in by_type:
                by_type[t] = {"count": 0, "amount": 0.0, "label": i["refund_type_label"],
                              "is_true_refund": i["is_true_refund"]}
            by_type[t]["count"] += 1
            by_type[t]["amount"] = round(by_type[t]["amount"] + i["refund_amount"], 2)

        # By organization_ledger_type
        by_olt = {}
        for i in items:
            oid = i["organization_ledger_type_id"]
            if oid not in by_olt:
                by_olt[oid] = {"count": 0, "amount": 0.0,
                               "name": i["organization_ledger_type_name"],
                               "is_true_refund": i["is_true_refund"]}
            by_olt[oid]["count"] += 1
            by_olt[oid]["amount"] = round(by_olt[oid]["amount"] + i["refund_amount"], 2)

        # High-value refunds (≥ $500, true refunds only)
        hv = [i for i in refund_items if i["refund_amount"] >= 500]

        summary = {
            "total_refund_amount":              total_refund_amount,
            "total_refund_count":               total_refund_count,
            "patient_refund_amount":            by_group.get("patient_refund", {}).get("amount", 0.0),
            "patient_refund_count":             by_group.get("patient_refund", {}).get("count", 0),
            "insurance_refund_amount":          by_group.get("insurance_refund", {}).get("amount", 0.0),
            "insurance_refund_count":           by_group.get("insurance_refund", {}).get("count", 0),
            "credit_card_refund_amount":        by_group.get("credit_card_refund", {}).get("amount", 0.0),
            "credit_card_refund_count":         by_group.get("credit_card_refund", {}).get("count", 0),
            "non_refund_adjustment_amount":     round(sum(i["refund_amount"] for i in non_refund_items), 2),
            "non_refund_adjustment_count":      len(non_refund_items),
            "high_value_refund_count":          len(hv),
            "high_value_refund_amount":         round(sum(i["refund_amount"] for i in hv), 2),
            "by_office":                        by_office,
            "by_refund_type":                   by_type,
            "by_organization_ledger_type":      by_olt,
        }

        # ── Pagination ────────────────────────────────────────────────────
        total_count = len(items)
        total_pages = max(1, -(-total_count // pageSize))
        page_items  = items[offset:offset + pageSize]

        # ── Build response rows (strip internal keys) ─────────────────────
        data = []
        for item in page_items:
            row = {k: v for k, v in item.items() if not k.startswith("_")}
            data.append(row)

        return {
            "data": data,
            "summary": summary,
            "pagination": {
                "page":          page,
                "page_size":     pageSize,
                "total_count":   total_count,
                "total_pages":   total_pages,
                "has_next_page": page < total_pages,
                "has_prev_page": page > 1,
            },
            "metadata": {
                "source_note":    "Source: Dentrix Ascend adjustment ledger. Refund totals include active true patient and insurance refund adjustment types only. Write-offs and balance corrections are excluded from refund totals unless explicitly requested as review rows.",
                "date_basis":     "transaction_date",
                "date_label":     "Refund Date",
                "refund_type_note": "Refund type is classified by Dentrix Organization Ledger Type (OLT) ID. True refunds include insurance overpayment refunds, insurance offsetting adjustments, patient refunds, and credit card refunds. Write-offs and balance corrections are non-refund review rows.",
                "auth_required":  True,
                "startDate":      s,
                "endDate":        e,
                "locationId":     locationId,
                "officeId":       officeId,
                "refundType":     refundType or "all",
                "includeNonRefundAdjustments": includeNonRefundAdjustments,
                "minAmount":      minAmount,
                "search":         search,
                "refund_type_values": {
                    "insurance_overpayment_refund":   "Insurance Overpayment Refund",
                    "insurance_offsetting_adj":        "Insurance Offsetting Adjustment",
                    "patient_refund":                  "Patient Refund",
                    "credit_card_full_refund":         "Credit Card Full Refund",
                    "credit_card_partial_refund":      "Credit Card Partial Refund",
                    "credit_card_independent_refund":  "Credit Card Independent Refund",
                    "insurance_writeoff":              "Insurance Write-Off (non-refund review)",
                    "balance_correction":              "Balance Correction (non-refund review)",
                },
                "olt_classification_map": {
                    "14000000010443": {"type": "insurance_overpayment_refund",   "name": "Insurance Over-pmt Refund",           "is_true_refund": True},
                    "14000000010449": {"type": "insurance_offsetting_adj",       "name": "Ins Charge Offsetting Adjustment",     "is_true_refund": True},
                    "14000000010446": {"type": "patient_refund",                 "name": "Patient Refund",                      "is_true_refund": True},
                    "14000000010450": {"type": "credit_card_full_refund",        "name": "Credit Card Full Refund",             "is_true_refund": True},
                    "14000000021755": {"type": "credit_card_partial_refund",     "name": "Credit Card Partial Refund",          "is_true_refund": True},
                    "14000000022515": {"type": "credit_card_independent_refund", "name": "Credit Card Independent Refund",      "is_true_refund": True},
                    "14000000010442": {"type": "insurance_writeoff",             "name": "Insurance Adjustment",                "is_true_refund": False},
                    "14000000010448": {"type": "balance_correction",             "name": "Transfer Charge Balance",             "is_true_refund": False},
                },
                "version": "phase1_2026-05-10",
            },
            "_source": "dentrix_ascend/adjustments",
        }
    finally:
        conn.close()







# ── RCM: ADJUSTMENTS REVIEW ───────────────────────────────────────────────────
@app.get("/v2/rcm/adjustments-review", tags=["RCM"], dependencies=[Depends(verify_api_key)])
def rcm_adjustments_review(
    startDate:          Optional[str] = Query(None),  start:      Optional[str] = Query(None),
    endDate:            Optional[str] = Query(None),  end:        Optional[str] = Query(None),
    locationId:         Optional[str] = Query(None),  officeId:   Optional[str] = Query(None),
    page:               int           = Query(1),
    pageSize:           int           = Query(500),
    includeVoided:      bool          = Query(False),
    adjustmentCategory: Optional[str] = Query(None),
    reviewFlag:         Optional[str] = Query(None),
):
    """
    RCM Adjustment Review — Phase 1 backend foundation.

    Constraints (never violate):
    - READ-ONLY. No DB/schema/data changes.
    - Does NOT replace legacy /v2/adjustments.
    - No fraud labels, no accusations.
    - summary and review_queues are full-filter-scope, not page-scope.

    Patch history:
    - 2026-05-08 v1: initial endpoint
    - 2026-05-08 v2: neutral labels/flags, review queues (D/E/F)
    - 2026-05-08 v3: flat summary fields (Part G), metadata (Part H), extended breakdowns
    - 2026-05-09 v4: Phase 4A — Discount / Write-Off Review queue (full-filter-scope, 200-item cap)
    """

    # ── Constants ─────────────────────────────────────────────────────────────
    s = startDate or start or "2026-01-01"
    e = endDate   or end   or "2099-12-31"
    page     = max(1, page)
    pageSize = max(1, min(pageSize, 2000))
    offset   = (page - 1) * pageSize

    # Groups (for aggregate summary buckets)
    _WRITEOFF_CATS   = {"insurance_writeoff", "ppo_contractual_writeoff", "in_house_discount"}
    _DISCOUNT_CATS   = {"discount_plan", "professional_courtesy", "family_friend_courtesy",
                        "management_discount", "no_charge_courtesy"}
    _CHARGE_ADJ_CATS = {"cc_processing_fee", "charge_adjustment"}
    _CREDIT_ADJ_CATS = {"credit_adjustment"}
    _REFUND_CATS     = {"patient_refund", "insurance_refund"}
    _VOID_CATS       = {"void_or_reversal"}

    # Category → flat label (Dr. G directive, v2)
    _CATEGORY_LABEL = {
        "insurance_writeoff":       "Insurance Adjustment",
        "ppo_contractual_writeoff": "PPO / Contractual Write-Off",
        "discount_plan":            "Discount Plan",
        "in_house_discount":        "In-House Discount",
        "professional_courtesy":    "Professional Courtesy",
        "family_friend_courtesy":   "Family / Friend Courtesy",
        "management_discount":      "Management Discount",
        "cc_processing_fee":        "Credit Card Processing Fee",
        "no_charge_courtesy":       "No Charge / Courtesy",
        "charge_adjustment":        "Charge Adjustment",
        "credit_adjustment":        "Credit Adjustment",
        "patient_refund":           "Patient Refund",
        "insurance_refund":         "Insurance Refund",
        "balance_correction":       "Balance Correction",
        "void_or_reversal":         "Voided / Reversal",
        "unmapped":                 "Unmapped Adjustment",
    }

    # OLT decode (28 official Dentrix IDs from API audit)
    _OLT_MAP = {
        "14000000010459": ("Insurance Adjustment",              "insurance_writeoff",       "write_off"),
        "14000000010442": ("Insurance Adjustment",              "insurance_writeoff",       "write_off"),
        "14000000010464": ("Write-off",                         "ppo_contractual_writeoff", "write_off"),
        "14000000010466": ("Discount",                          "discount_plan",            "discount"),
        "14000000010458": ("In-office Write-off",               "in_house_discount",        "discount"),
        "14000000010460": ("Professional Courtesy",             "professional_courtesy",    "discount"),
        "14000000010455": ("Family/Friend Courtesy",            "family_friend_courtesy",   "discount"),
        "14000000010462": ("Staff Courtesy",                    "management_discount",      "discount"),
        "14000000010456": ("Full Payment Courtesy",             "no_charge_courtesy",       "discount"),
        "14000000010461": ("Senior Citizen Courtesy",           "no_charge_courtesy",       "discount"),
        "14000000010438": ("Charge Adjustment",                 "cc_processing_fee",        "charge_adjustment"),
        "14000000010444": ("NSF Bank Fee",                      "charge_adjustment",        "charge_adjustment"),
        "14000000010445": ("NSF Check",                         "charge_adjustment",        "charge_adjustment"),
        "14000000010439": ("Collected Bad Debt",                "charge_adjustment",        "charge_adjustment"),
        "14000000010454": ("Credit Adjustment",                 "credit_adjustment",        "credit_adjustment"),
        "14000000010465": ("Offsetting Adjustment",             "credit_adjustment",        "credit_adjustment"),
        "14000000010446": ("Patient Refund",                    "patient_refund",           "refund"),
        "14000000010450": ("Credit Card Full Refund",           "patient_refund",           "refund"),
        "14000000021755": ("Credit Card Partial Refund",        "patient_refund",           "refund"),
        "14000000022515": ("Credit Card Independent Refund",    "patient_refund",           "refund"),
        "14000000010443": ("Insurance Over-pmt Refund",         "insurance_refund",         "refund"),
        "14000000010449": ("Ins Charge Offsetting Adjustment",  "insurance_refund",         "refund"),
        "14000000010448": ("Transfer Charge Balance",           "balance_correction",       "correction"),
        "14000000010463": ("Transfer Credit Balance",           "balance_correction",       "correction"),
        "14000000010441": ("Initial Balance Forward",           "balance_correction",       "correction"),
        "14000000010457": ("Initial Credit Balance Forward",    "balance_correction",       "correction"),
        "14000000010451": ("Credit Card Void",                  "void_or_reversal",         "void"),
        "14000000010452": ("Bankruptcy Write-off",              "ppo_contractual_writeoff", "write_off"),
    }

    def _classify_olt(olt_id, ledger_type, is_cancel):
        if is_cancel:
            return (None, None, "void_or_reversal", "void")
        if olt_id and olt_id in _OLT_MAP:
            olt_name, cat, grp = _OLT_MAP[olt_id]
            return (olt_id, olt_name, cat, grp)
        # Ledger-type fallback
        lt = (ledger_type or "")
        if "CreditAdjustment" in lt:
            return (olt_id, None, "credit_adjustment", "credit_adjustment")
        if "ChargeAdjustment" in lt:
            return (olt_id, None, "charge_adjustment", "charge_adjustment")
        if "InsuranceRefund" in lt:
            return (olt_id, None, "insurance_refund", "refund")
        return (olt_id, None, "unmapped", "other")

    # User cache — static seed (from audit) + lazy API fetch for unknowns
    _KNOWN_USERS = {
        "14000000011647": {"name": "Ny Velez",                      "isProvider": False},
        "14000000025678": {"name": "Elizabeth Velez",               "isProvider": False},
        "14000000033227": {"name": "Viv Diaz",                      "isProvider": False},
        "14000000017582": {"name": "eAssist Dental Solutions",       "isProvider": False},
        "14000000025410": {"name": "Courtney Spaeth",                "isProvider": False},
        "14000000036783": {"name": "Angela Moore",                   "isProvider": False},
        "14000000029208": {"name": "Cami Lott",                      "isProvider": False},
        "14000000039529": {"name": "Latifa Motley",                  "isProvider": False},
        "14000000041949": {"name": "Mildred Fortune",                "isProvider": False},
        "14000000045562": {"name": "Natasha Torok",                  "isProvider": False},
        "14000000046283": {"name": "Courtney Wilson",                "isProvider": False},
        "14000000011514": {"name": "Admasu Gizachew",                "isProvider": True},
        "14000000011643": {"name": "Nebraska Chaplick",              "isProvider": False},
        "14000000032056": {"name": "Sheryl Dubman",                  "isProvider": True},
        "14000000036678": {"name": "Katherine Soto",                 "isProvider": True},
    }
    _USER_CACHE = getattr(rcm_adjustments_review, "_user_cache", None)
    if _USER_CACHE is None:
        _USER_CACHE = dict(_KNOWN_USERS)
        rcm_adjustments_review._user_cache = _USER_CACHE

    DR_G_USER_ID = "14000000011514"

    def _user_info(uid):
        return _USER_CACHE.get(uid)

    def _maybe_fetch_users(missing_ids):
        missing_ids = [u for u in set(missing_ids) if u and u not in _USER_CACHE][:20]
        if not missing_ids:
            return
        try:
            import requests as _req
            with open("/home/openclaw/.config/ascend/production.json") as _f:
                _creds = json.load(_f)
            _tok = _req.post(_creds["oauth_url"],
                data={"client_id": _creds["api_key"], "client_secret": _creds["secret"]},
                timeout=30).json().get("access_token")
            if not _tok:
                return
            _hdrs = {"Authorization": f"Bearer {_tok}", "Organization-ID": _creds["org_id"]}
            for _uid in missing_ids:
                try:
                    _r = _req.get(f"{_creds['api_base']}/v1/users/{_uid}", headers=_hdrs, timeout=10)
                    if _r.status_code == 200:
                        _d = _r.json().get("data", _r.json())
                        _USER_CACHE[_uid] = {
                            "name": f"{_d.get('firstName','')}{' ' if _d.get('firstName') else ''}{_d.get('lastName','')}".strip(),
                            "isProvider": bool(_d.get("isProvider", False)),
                        }
                except Exception:
                    pass
        except Exception:
            pass

    # Approval evidence helpers
    _APPROVAL_KW = ["ok per dr.g", "ok per dr g", "ok dr g", "ok dr.g", "approved", "per dr g", "per dr.g", "ok ny"]

    def _note_evidence(note):
        return note and any(k in (note or "").lower() for k in _APPROVAL_KW)

    _HIGH_RISK_CATS = {
        "management_discount", "professional_courtesy", "family_friend_courtesy",
        "in_house_discount", "no_charge_courtesy", "patient_refund", "balance_correction", "void_or_reversal",
    }

    def _approval_evidence(cat, abs_amt, note, uid, is_void):
        high = is_void or abs_amt >= 500 or cat in _HIGH_RISK_CATS
        if not high:
            if _note_evidence(note):
                return "evidence_found", "note", (note or "")[:120]
            if uid == DR_G_USER_ID:
                return "evidence_found", "online_user", "Entered by Dr. Gizachew"
            return "not_required", "none", None
        if _note_evidence(note):
            return "evidence_found", "note", (note or "")[:120]
        if uid == DR_G_USER_ID:
            return "evidence_found", "online_user", "Entered by Dr. Gizachew"
        return "evidence_missing", "future_approval_log_needed", (note or "")[:120] or None

    # Payment method group
    _FIN_KW = ["carecredit","care credit","cherry","sunbit","alphaeon","lending club","lendingclub",
               "greensky","prosper","springstone","proceed finance","patient financing","payment plan financing"]

    def _pmg(raw_j):
        note = (raw_j.get("note") or "").lower()
        if any(k in note for k in _FIN_KW):
            return "financing"
        b = raw_j.get("patientPaymentBilling")
        if isinstance(b, dict):
            if b.get("creditCardType"):
                return "credit_card"
            if b.get("checkNumber"):
                return "check"
            if b.get("referenceNumber"):
                return "electronic_transfer"
        if "pos+ transaction id" in note:
            return "credit_card"
        tags = [t.get("id") for t in (raw_j.get("transactionTags") or []) if isinstance(t, dict) and t.get("id")]
        if "14000000003510" in tags:
            return "credit_card"
        if "14000000003502" in tags:
            return "cash"
        if raw_j.get("paidAtVisit") is True:
            return "cash"
        return "unknown"

    # ── DB ───────────────────────────────────────────────────────────────────
    conn = rcm_db()
    try:
        patients    = rcm_patient_map(conn)
        where, prms = rcm_filter_clause(s, e, location_id=locationId, office_id=officeId)

        v_filter = "" if includeVoided else "AND is_active = 1 AND ledger_type NOT LIKE '%Cancellation%'"

        all_rows = conn.execute(
            f"""SELECT id, transaction_date, amount, provider_id, location_id, patient_id,
                       ledger_type, is_active, last_modified, raw, entry_date
                FROM adjustments
                WHERE {where} {v_filter}
                ORDER BY transaction_date DESC""",
            prms
        ).fetchall()

        # Voided row totals (always computed, independent of includeVoided filter)
        v_rows = conn.execute(
            f"""SELECT amount, ledger_type, is_active
                FROM adjustments
                WHERE {where}
                AND (is_active = 0 OR ledger_type LIKE '%Cancellation%')""",
            prms
        ).fetchall()
        voided_all_count  = len(v_rows)
        voided_all_amount = round(sum(abs(float(r["amount"] or 0)) for r in v_rows), 2)

        # Provider lookup
        prov_ids = {r["provider_id"] for r in all_rows if r["provider_id"]}
        prov_names = {}
        if prov_ids:
            ph = ",".join("?" * len(prov_ids))
            for r in conn.execute(
                f"SELECT id, TRIM(COALESCE(first_name,'') || ' ' || COALESCE(last_name,'')) n FROM providers WHERE id IN ({ph})",
                list(prov_ids)
            ):
                prov_names[r["id"]] = r["n"]

        # ── Process rows ────────────────────────────────────────────────────
        processed = []
        miss_uids  = []

        for r in all_rows:
            rj  = json.loads(r["raw"] or "{}")
            amt = float(r["amount"] or 0)
            lt  = r["ledger_type"] or ""

            is_cancel  = lt.endswith("Cancellation")
            is_voided  = is_cancel or r["is_active"] == 0
            is_reversal= False

            olt_ref  = rj.get("organizationLedgerType") or {}
            olt_id   = olt_ref.get("id") if isinstance(olt_ref, dict) else None
            olt_id_dec, olt_name, cat, grp = _classify_olt(olt_id, lt, is_cancel)
            cat_label = _CATEGORY_LABEL.get(cat, "Unmapped Adjustment")

            note     = rj.get("note") or ""
            has_note = bool(note.strip())

            # entryDate + late-posted
            ed_raw = rj.get("entryDate") or (r["entry_date"] if r["entry_date"] else None)
            entry_date_str = str(ed_raw)[:10] if ed_raw else None
            days_gap, is_late = None, False
            try:
                if entry_date_str and r["transaction_date"]:
                    from datetime import datetime as _dt
                    days_gap = (_dt.strptime(entry_date_str, "%Y-%m-%d") - _dt.strptime(str(r["transaction_date"])[:10], "%Y-%m-%d")).days
                    is_late  = days_gap > 7
            except Exception:
                pass

            # onlineUser
            ou_ref   = rj.get("onlineUser") or {}
            uid      = ou_ref.get("id") if isinstance(ou_ref, dict) else None
            if uid and uid not in _USER_CACHE:
                miss_uids.append(uid)
            uinfo    = _user_info(uid)
            uname    = uinfo["name"] if uinfo else None
            urole    = "provider" if (uinfo and uinfo.get("isProvider")) else ("staff" if uinfo else None)

            # Reversal chain
            prev_ref  = rj.get("previousTransaction") or {}
            prev_id   = prev_ref.get("id") if isinstance(prev_ref, dict) else None
            repl_ref  = rj.get("replacedByTransaction") or {}
            repl_id   = repl_ref.get("id") if isinstance(repl_ref, dict) else None
            is_reversal = prev_id is not None

            # Insurance claim
            ic_ref   = rj.get("insuranceClaim") or {}
            claim_id = ic_ref.get("id") if isinstance(ic_ref, dict) else None

            mod_date = rj.get("modifiedDate") or rj.get("lastModified")
            void_date= str(mod_date)[:19] if (mod_date and (is_voided or is_reversal)) else None

            # Provider attribution (direct → distributions → procedures)
            pid = r["provider_id"]
            pn  = prov_names.get(pid) if pid else None
            if not pid:
                for d in (rj.get("distributions") or []):
                    cid = d.get("chargeId")
                    if cid:
                        pr = conn.execute("SELECT provider_id FROM procedures WHERE id=? LIMIT 1", (cid,)).fetchone()
                        if pr and pr["provider_id"]:
                            pid = pr["provider_id"]
                            if pid not in prov_names:
                                pn2 = conn.execute(
                                    "SELECT TRIM(COALESCE(first_name,'') || ' ' || COALESCE(last_name,'')) n FROM providers WHERE id=?",
                                    (pid,)).fetchone()
                                prov_names[pid] = pn2["n"] if pn2 else None
                            pn = prov_names.get(pid)
                            break

            abs_amt  = abs(amt)
            hi_risk  = is_voided or abs_amt >= 500 or cat in _HIGH_RISK_CATS
            ae_stat, ae_src, ae_txt = _approval_evidence(cat, abs_amt, note if has_note else "", uid, is_voided)

            # Review flags
            flags, flag_labels = [], []

            if not has_note and hi_risk:
                flags.append("missing_note"); flag_labels.append("Missing Note")

            if ae_stat == "evidence_missing":
                flags.append("approval_evidence_missing"); flag_labels.append("Approval Evidence Missing")

            if abs_amt >= 500:
                flags.append("large_adjustment"); flag_labels.append("Large Adjustment (>= $500)")

            if is_late:
                flags.append("late_posted"); flag_labels.append("Late-Posted (> 7 days)")

            if is_voided:
                flags.append("voided_transaction_review"); flag_labels.append("Voided Transaction Review")

            if cat in ("balance_correction",) or is_reversal:
                flags.append("correction_review"); flag_labels.append("Correction Review")

            if cat == "unmapped":
                flags.append("unmapped_adjustment_type"); flag_labels.append("Unmapped Adjustment")

            # sign_review: credit adj unexpectedly positive
            if cat in _WRITEOFF_CATS | _DISCOUNT_CATS | _CREDIT_ADJ_CATS and amt > 0:
                flags.append("sign_review"); flag_labels.append("Sign Review")

            needs_rev = len(flags) > 0
            req_mgr   = any(f in {
                "approval_evidence_missing", "large_adjustment", "voided_transaction_review",
                "correction_review", "unmapped_adjustment_type", "sign_review"
            } for f in flags)

            if needs_rev:
                flags.append("needs_review"); flag_labels.append("Needs Review")
            if req_mgr:
                flags.append("requires_manager_review"); flag_labels.append("Requires Manager Review")

            fin_amt = 0.0 if is_voided else amt

            processed.append({
                "adjustment_id":                     r["id"],
                "transaction_id":                    r["id"],
                "patient_id":                        r["patient_id"],
                "patient_name":                      patients.get(r["patient_id"], "Unknown Patient"),
                "office":                            LOCATION_NAMES.get(r["location_id"], "Unknown"),
                "location_id":                       r["location_id"],
                "provider_id":                       pid,
                "provider_name":                     pn,
                "claim_id":                          claim_id,
                "payor_name":                        None,
                "amount":                            round(abs_amt, 2),
                "signed_amount":                     round(amt, 2),
                "financial_amount":                  round(fin_amt, 2),
                "adjustment_date":                   str(r["transaction_date"])[:10] if r["transaction_date"] else None,
                "entry_date":                        entry_date_str,
                "transaction_date":                  str(r["transaction_date"])[:10] if r["transaction_date"] else None,
                "modified_date":                     str(mod_date)[:19] if mod_date else None,
                "days_between_transaction_and_entry": days_gap,
                "is_late_posted":                    is_late,
                "ledger_type":                       lt,
                "organization_ledger_type_id":       olt_id_dec,
                "organization_ledger_type_name":     olt_name,
                "adjustment_category":               cat,
                "adjustment_category_label":         cat_label,
                "adjustment_group":                  grp,
                "reason":                            note.strip() if has_note else None,
                "note":                              note if has_note else None,
                "has_note":                          has_note,
                "status":                            "voided" if is_voided else "active",
                "is_voided":                         is_voided,
                "is_cancelled":                      is_cancel,
                "is_reversal":                       is_reversal,
                "previous_transaction_id":           prev_id,
                "replaced_by_transaction_id":        repl_id,
                "void_or_reversal_date":             void_date,
                "online_user_id":                    uid,
                "online_user_name":                  uname,
                "online_user_role":                  urole,
                "online_user_source":                "cache_or_api" if uid else None,
                "staff_attribution_confidence":      "confirmed" if uname else ("id_only" if uid else "unavailable"),
                "approval_evidence_status":          ae_stat,
                "approval_evidence_source":          ae_src,
                "approval_evidence_text":            ae_txt,
                "review_flags":                      flags,
                "review_flag_labels":                flag_labels,
                "needs_review":                      needs_rev,
                "requires_manager_review":           req_mgr,
                "_source":                           "dentrix_ascend",
                "_source_table":                     "adjustments",
                "_classification_confidence":         "confirmed" if (olt_id_dec and olt_id_dec in _OLT_MAP) else "unmapped",
                "_notes":                            f"OLT={olt_id_dec or 'none'} cat={cat} user={uname or uid or 'unknown'}",
            })

        # Lazy user fetch + re-hydrate
        _maybe_fetch_users(miss_uids)
        for p in processed:
            if not p["online_user_name"] and p["online_user_id"] in _USER_CACHE:
                u = _USER_CACHE[p["online_user_id"]]
                p["online_user_name"] = u.get("name")
                p["online_user_role"] = "provider" if u.get("isProvider") else "staff"
                p["staff_attribution_confidence"] = "confirmed" if p["online_user_name"] else "id_only"

        # repeated_adjustment_pattern (safe: same patient + category + abs(amount) >= 3 within filtered set)
        _rep_counts = {}
        for p in processed:
            k = (p["patient_id"], p["adjustment_category"], round(p["amount"], 2))
            _rep_counts[k] = _rep_counts.get(k, 0) + 1
        for p in processed:
            k = (p["patient_id"], p["adjustment_category"], round(p["amount"], 2))
            if _rep_counts.get(k, 0) >= 3 and "repeated_adjustment_pattern" not in p["review_flags"]:
                p["review_flags"].append("repeated_adjustment_pattern")
                p["review_flag_labels"].append("Repeated Adjustment Pattern")
                if "needs_review" not in p["review_flags"]:
                    p["review_flags"].append("needs_review"); p["review_flag_labels"].append("Needs Review")
                p["needs_review"] = True

        # Apply query filters
        if adjustmentCategory:
            processed = [p for p in processed if p["adjustment_category"] == adjustmentCategory]
        if reviewFlag:
            processed = [p for p in processed if reviewFlag in p["review_flags"]]

        # Pagination
        total_filtered = len(processed)
        total_pages    = max(1, (total_filtered + pageSize - 1) // pageSize)
        page_data      = processed[offset:offset + pageSize]

        # ── Full-scope summary (Part G) ──────────────────────────────────────
        total_count        = len(processed)
        total_signed_amt   = 0.0
        active_count       = 0; active_amt = 0.0
        writeoff_count     = 0; writeoff_amt = 0.0
        discount_count     = 0; discount_amt = 0.0
        charge_adj_count   = 0; charge_adj_amt = 0.0
        credit_adj_count   = 0; credit_adj_amt = 0.0
        refund_count       = 0; refund_amt = 0.0

        missing_note_count = 0; ae_missing_count = 0; needs_rev_count = 0; req_mgr_count = 0
        large_adj_count    = 0; late_count = 0

        by_cat      = {}; by_olt     = {}; by_office  = {}; by_prov    = {}
        by_patient  = {}; by_user    = {}; by_flag    = {}; by_late_bkt = {}
        by_void_type = {}; by_olt_raw = {}

        olt_decoded_count = 0; user_decoded_count = 0

        for p in processed:
            a  = p["signed_amount"]
            aa = p["amount"]
            c  = p["adjustment_category"]

            total_signed_amt += a

            if not p["is_voided"]:
                active_count += 1; active_amt += a

            if c in _WRITEOFF_CATS:
                writeoff_count += 1; writeoff_amt += a
            if c in _DISCOUNT_CATS:
                discount_count += 1; discount_amt += a
            if c in _CHARGE_ADJ_CATS:
                charge_adj_count += 1; charge_adj_amt += a
            if c in _CREDIT_ADJ_CATS:
                credit_adj_count += 1; credit_adj_amt += a
            if c in _REFUND_CATS:
                refund_count += 1; refund_amt += a

            if "missing_note"            in p["review_flags"]: missing_note_count += 1
            if "approval_evidence_missing" in p["review_flags"]: ae_missing_count  += 1
            if p["needs_review"]:                                needs_rev_count    += 1
            if p["requires_manager_review"]:                     req_mgr_count      += 1
            if "large_adjustment"        in p["review_flags"]:  large_adj_count    += 1
            if p["is_late_posted"]:                              late_count         += 1

            if p["organization_ledger_type_name"]: olt_decoded_count += 1
            if p["online_user_name"]:              user_decoded_count += 1

            # by_category
            if c not in by_cat:
                by_cat[c] = {"adjustment_category": c, "label": p["adjustment_category_label"], "count": 0, "signed_amount": 0.0, "abs_amount": 0.0}
            by_cat[c]["count"] += 1; by_cat[c]["signed_amount"] += a; by_cat[c]["abs_amount"] += aa

            # by_organization_ledger_type
            oid  = p["organization_ledger_type_id"] or "not_decoded"
            onam = p["organization_ledger_type_name"] or "Not Decoded"
            if oid not in by_olt:
                by_olt[oid] = {"organization_ledger_type_id": p["organization_ledger_type_id"], "organization_ledger_type_name": onam, "category": c, "count": 0, "signed_amount": 0.0}
            by_olt[oid]["count"] += 1; by_olt[oid]["signed_amount"] += a

            # by_office
            loc = p["location_id"]
            if loc not in by_office:
                by_office[loc] = {"location_id": loc, "office": p["office"], "count": 0, "signed_amount": 0.0}
            by_office[loc]["count"] += 1; by_office[loc]["signed_amount"] += a

            # by_provider
            pv = p["provider_id"] or "__unresolved__"
            if pv not in by_prov:
                by_prov[pv] = {"provider_id": p["provider_id"], "provider_name": p["provider_name"] or "Unresolved Provider", "count": 0, "abs_amount": 0.0}
            by_prov[pv]["count"] += 1; by_prov[pv]["abs_amount"] += aa

            # by_patient
            pt = p["patient_id"]
            if pt not in by_patient:
                by_patient[pt] = {"patient_id": pt, "patient_name": p["patient_name"], "count": 0, "abs_amount": 0.0}
            by_patient[pt]["count"] += 1; by_patient[pt]["abs_amount"] += aa

            # by_online_user
            uid2  = p["online_user_id"] or "__unknown__"
            unam2 = p["online_user_name"] or "Unknown Staff"
            if uid2 not in by_user:
                by_user[uid2] = {"online_user_id": p["online_user_id"], "online_user_name": unam2, "count": 0, "abs_amount": 0.0}
            by_user[uid2]["count"] += 1; by_user[uid2]["abs_amount"] += aa

            # by_review_flag
            for f in p["review_flags"]:
                by_flag[f] = by_flag.get(f, 0) + 1

            # by_late_posted_bucket
            dg = p.get("days_between_transaction_and_entry")
            if dg is not None:
                if dg <= 0:   bkt = "same_day"
                elif dg <= 1: bkt = "1_day"
                elif dg <= 7: bkt = "2_7_days"
                elif dg <= 30: bkt = "8_30_days"
                elif dg <= 90: bkt = "31_90_days"
                else:          bkt = "over_90_days"
                by_late_bkt[bkt] = by_late_bkt.get(bkt, 0) + 1

            # by_void_or_reversal_type
            if p["is_voided"] or c == "void_or_reversal":
                vt = p["ledger_type"]
                if vt not in by_void_type:
                    by_void_type[vt] = {"ledger_type": vt, "count": 0, "abs_amount": 0.0}
                by_void_type[vt]["count"] += 1; by_void_type[vt]["abs_amount"] += aa

        # round all
        for d in [by_cat, by_olt, by_office, by_prov, by_patient, by_user]:
            for v in d.values():
                for fld in ["signed_amount", "abs_amount"]:
                    if fld in v:
                        v[fld] = round(v[fld], 2)
        for v in by_void_type.values():
            v["abs_amount"] = round(v["abs_amount"], 2)

        olt_coverage_pct  = round(olt_decoded_count / max(total_count, 1) * 100, 1)
        user_coverage_pct = round(user_decoded_count / max(total_count, 1) * 100, 1)

        summary = {
            # Flat counts/amounts (Part G)
            "total_adjustments_count":          total_count,
            "total_adjustments_amount":         round(total_signed_amt, 2),
            "active_adjustments_count":         active_count,
            "active_adjustments_amount":        round(active_amt, 2),
            "voided_count":                     voided_all_count,
            "voided_amount":                    voided_all_amount,
            "writeoff_count":                   writeoff_count,
            "writeoff_amount":                  round(writeoff_amt, 2),
            "discount_count":                   discount_count,
            "discount_amount":                  round(discount_amt, 2),
            "charge_adjustment_count":          charge_adj_count,
            "charge_adjustment_amount":         round(charge_adj_amt, 2),
            "credit_adjustment_count":          credit_adj_count,
            "credit_adjustment_amount":         round(credit_adj_amt, 2),
            "refund_count":                     refund_count,
            "refund_amount":                    round(refund_amt, 2),
            "missing_note_count":               missing_note_count,
            "approval_evidence_missing_count":  ae_missing_count,
            "needs_review_count":               needs_rev_count,
            "requires_manager_review_count":    req_mgr_count,
            "large_adjustment_count":           large_adj_count,
            "late_posted_count":                late_count,
            # Derived stats
            "unique_patients_count":            len({p["patient_id"] for p in processed}),
            "olt_decoded_count":                olt_decoded_count,
            "olt_decoded_pct":                  olt_coverage_pct,
            "user_decoded_count":               user_decoded_count,
            "user_decoded_pct":                 user_coverage_pct,
            # Breakdowns
            "by_adjustment_category":           sorted(by_cat.values(), key=lambda x: abs(x["signed_amount"]), reverse=True),
            "by_organization_ledger_type":      sorted(by_olt.values(), key=lambda x: abs(x["signed_amount"]), reverse=True),
            "by_office":                        sorted(by_office.values(), key=lambda x: abs(x["signed_amount"]), reverse=True),
            "by_provider":                      sorted(by_prov.values(), key=lambda x: x["abs_amount"], reverse=True)[:20],
            "by_patient_top":                   sorted(by_patient.values(), key=lambda x: x["abs_amount"], reverse=True)[:10],
            "by_online_user":                   sorted(by_user.values(), key=lambda x: x["abs_amount"], reverse=True)[:20],
            "by_review_flag":                   dict(sorted(by_flag.items(), key=lambda x: -x[1])),
            "by_late_posted_bucket":            by_late_bkt,
            "by_void_or_reversal_type":         sorted(by_void_type.values(), key=lambda x: x["count"], reverse=True),
            "_note": "Summary is full-filter-scope (not page-scope).",
        }

        # ── Payment method review queue (Phase 1B — enriched context) ──────────
        # Patch: 2026-05-09 — adds office, staff entered-by (original + replacement),
        #        transaction IDs, extended dates, payment method labels/channel/confidence.
        # Constraints: read-only, no DB changes, no totals changes, no POS changes.
        payment_method_reviews = []
        by_pm_corr_type = {}
        try:
            pw, pp = rcm_filter_clause(s, e, location_id=locationId, office_id=officeId)
            pay_rows = conn.execute(
                f"""SELECT id, transaction_date, amount, patient_id, location_id, ledger_type, is_active, raw
                    FROM patient_payments WHERE {pw} ORDER BY transaction_date DESC""", pp
            ).fetchall()
            pay_by_id = {r["id"]: r for r in pay_rows}

            from datetime import datetime as _dt2
            def _pd(x):
                try: return _dt2.strptime(str(x)[:10], "%Y-%m-%d")
                except: return None

            # ── Phase 1B helpers ──────────────────────────────────────────────

            # Human-readable payment method label
            _PM_LABEL = {
                "credit_card":        "Credit Card",
                "check":              "Check",
                "cash":               "Cash",
                "electronic_transfer":"Electronic Transfer",
                "financing":          "Patient Financing",
                "unknown":            "Unknown",
            }

            def _pmg_full(raw_j):
                """Return group, label, channel, confidence for a payment row's raw JSON."""
                group = _pmg(raw_j)
                label = _PM_LABEL.get(group, "Unknown")

                note = (raw_j.get("note") or "").lower()
                if "pos+ transaction id" in note:
                    channel = "pos_terminal"
                elif raw_j.get("isAutomaticallyPosted") is True:
                    channel = "auto_posted"
                else:
                    channel = "manual"

                b = raw_j.get("patientPaymentBilling")
                if isinstance(b, dict) and (b.get("creditCardType") or b.get("checkNumber")):
                    pm_conf = "high"
                elif group not in ("unknown",):
                    pm_conf = "medium"
                else:
                    pm_conf = "low"

                return {"group": group, "label": label, "channel": channel, "confidence": pm_conf}

            def _pay_meta(row, rj):
                """Extract enrichment fields from a patient_payments row + raw JSON dict."""
                ou_ref   = rj.get("onlineUser") or {}
                uid      = ou_ref.get("id") if isinstance(ou_ref, dict) else None
                uinfo    = _user_info(uid)
                uname    = uinfo["name"] if uinfo else None
                urole    = "provider" if (uinfo and uinfo.get("isProvider")) else ("staff" if uinfo else None)

                prev_ref = rj.get("previousTransaction") or {}
                prev_id  = prev_ref.get("id") if isinstance(prev_ref, dict) else None
                repl_ref = rj.get("replacedByTransaction") or {}
                repl_id  = repl_ref.get("id") if isinstance(repl_ref, dict) else None

                entry_dt = rj.get("entryDate")
                mod_dt   = rj.get("modifiedDate") or rj.get("lastModified")

                return {
                    "transaction_date":      str(row["transaction_date"])[:10] if row["transaction_date"] else None,
                    "entry_date":            str(entry_dt)[:10]  if entry_dt else None,
                    "modified_date":         str(mod_dt)[:19]    if mod_dt   else None,
                    "location_id":           row["location_id"],
                    "office":                LOCATION_NAMES.get(row["location_id"], "Unknown"),
                    "online_user_id":        uid,
                    "online_user_name":      uname,
                    "online_user_role":      urole,
                    "previous_transaction_id":      prev_id,
                    "replaced_by_transaction_id":   repl_id,
                }

            # Pre-parse raw JSON for all pay_rows once, collect UIDs to fetch
            _pay_rj_cache = {}
            _pay_uid_miss  = []
            for _r in pay_rows:
                _rj = json.loads(_r["raw"] or "{}")
                _pay_rj_cache[_r["id"]] = _rj
                _ou = (_rj.get("onlineUser") or {})
                _uid = _ou.get("id") if isinstance(_ou, dict) else None
                if _uid and _uid not in _USER_CACHE:
                    _pay_uid_miss.append(_uid)

            # Fetch missing users for payment rows (capped at 20)
            _maybe_fetch_users(_pay_uid_miss)

            # Re-hydrate unames after fetch (payment rows share _USER_CACHE with adjustments)
            def _hydrated_meta(row, rj):
                """Call _pay_meta but re-check cache for uname after _maybe_fetch_users."""
                m = _pay_meta(row, rj)
                if not m["online_user_name"] and m["online_user_id"] and m["online_user_id"] in _USER_CACHE:
                    u = _USER_CACHE[m["online_user_id"]]
                    m["online_user_name"] = u.get("name")
                    m["online_user_role"] = "provider" if u.get("isProvider") else "staff"
                return m

            def _build_pm_item(orig_row, orig_rj, repl_row, repl_rj,
                               orig_pm, repl_pm,
                               correction_source, review_reason, confidence, correction_type):
                """Build a fully-enriched payment_method_reviews item."""
                orig_meta = _hydrated_meta(orig_row, orig_rj)
                repl_meta = _hydrated_meta(repl_row, repl_rj)

                # Correction entered-by = the user who entered the replacement transaction.
                # If replacement user is unknown, fall back to original as a note.
                corr_uid   = repl_meta["online_user_id"]
                corr_uname = repl_meta["online_user_name"]
                corr_src   = "online_user" if corr_uid else "unavailable"
                if not corr_uname and orig_meta["online_user_id"]:
                    corr_src = "original_transaction_user_only"

                # Cross-office flag: if offices differ, extend review_reason
                orig_loc = orig_meta["location_id"]
                repl_loc = repl_meta["location_id"]
                rr = review_reason
                if orig_loc and repl_loc and orig_loc != repl_loc:
                    rr = (rr or "") + f" | Office changed: {orig_meta['office']} → {repl_meta['office']}"

                return {
                    # Core identity
                    "patient_id":                       orig_row["patient_id"],
                    "patient_name":                     patients.get(orig_row["patient_id"], "Unknown Patient"),

                    # Office (primary = original transaction's office)
                    "office":                           orig_meta["office"],
                    "location_id":                      orig_meta["location_id"],
                    "original_office":                  orig_meta["office"],
                    "original_location_id":             orig_meta["location_id"],
                    "replacement_office":               repl_meta["office"],
                    "replacement_location_id":          repl_meta["location_id"],

                    # Transaction IDs
                    "original_transaction_id":          orig_row["id"],
                    "replacement_transaction_id":       repl_row["id"],
                    "previous_transaction_id":          orig_meta["previous_transaction_id"],
                    "replaced_by_transaction_id":       orig_meta["replaced_by_transaction_id"],

                    # Amounts
                    "original_amount":                  round(abs(float(orig_row["amount"] or 0)), 2),
                    "replacement_amount":               round(abs(float(repl_row["amount"] or 0)), 2),

                    # Dates — primary (legacy-compatible)
                    "transaction_date":                 orig_meta["transaction_date"],
                    "correction_date":                  repl_meta["transaction_date"],

                    # Dates — extended
                    "original_transaction_date":        orig_meta["transaction_date"],
                    "replacement_transaction_date":     repl_meta["transaction_date"],
                    "original_entry_date":              orig_meta["entry_date"],
                    "replacement_entry_date":           repl_meta["entry_date"],
                    "original_modified_date":           orig_meta["modified_date"],
                    "replacement_modified_date":        repl_meta["modified_date"],

                    # Payment method
                    "original_payment_method_group":    orig_pm["group"],
                    "original_payment_method_label":    orig_pm["label"],
                    "original_payment_channel":         orig_pm["channel"],
                    "original_payment_confidence":      orig_pm["confidence"],
                    "replacement_payment_method_group": repl_pm["group"],
                    "replacement_payment_method_label": repl_pm["label"],
                    "replacement_payment_channel":      repl_pm["channel"],
                    "replacement_payment_confidence":   repl_pm["confidence"],

                    # Staff / entered-by
                    "original_online_user_id":          orig_meta["online_user_id"],
                    "original_online_user_name":        orig_meta["online_user_name"] or "Unknown",
                    "original_online_user_role":        orig_meta["online_user_role"],
                    "replacement_online_user_id":       repl_meta["online_user_id"],
                    "replacement_online_user_name":     repl_meta["online_user_name"] or "Unknown",
                    "replacement_online_user_role":     repl_meta["online_user_role"],
                    "correction_entered_by_user_id":    corr_uid,
                    "correction_entered_by_user_name":  corr_uname or "Unknown",
                    "correction_entered_by_source":     corr_src,

                    # Review context
                    "review_reason":    rr,
                    "review_label":     "Payment Method Review",
                    "confidence":       confidence,
                    "correction_type":  correction_type,
                    "correction_source": correction_source,
                }

            # ── Chain-based pairs ─────────────────────────────────────────────
            for r in pay_rows:
                rj2  = _pay_rj_cache.get(r["id"]) or json.loads(r["raw"] or "{}")
                prev = (rj2.get("previousTransaction") or {})
                pid2 = prev.get("id") if isinstance(prev, dict) else None
                if not pid2 or pid2 not in pay_by_id:
                    continue
                orig    = pay_by_id[pid2]
                orig_rj = _pay_rj_cache.get(orig["id"]) or json.loads(orig["raw"] or "{}")
                orig_pm = _pmg_full(orig_rj)
                repl_pm = _pmg_full(rj2)
                if orig_pm["group"] == repl_pm["group"]:
                    continue
                conf      = "high" if (orig_pm["group"] != "unknown" and repl_pm["group"] != "unknown") else "medium"
                corr_type = f"{orig_pm['group']}_to_{repl_pm['group']}"
                reason    = (f"Payment method changed: {orig_pm['label']} → {repl_pm['label']} "
                             f"(previousTransaction chain)")
                payment_method_reviews.append(
                    _build_pm_item(orig, orig_rj, r, rj2, orig_pm, repl_pm,
                                   "chain", reason, conf, corr_type)
                )
                by_pm_corr_type[corr_type] = by_pm_corr_type.get(corr_type, 0) + 1

            # ── Heuristic: cancel + re-entry nearby, different method ─────────
            cancels     = [r for r in pay_rows if (r["ledger_type"] or "").endswith("Cancellation")]
            non_cancels = [r for r in pay_rows if not (r["ledger_type"] or "").endswith("Cancellation")]
            for c in cancels[:2000]:
                crj  = _pay_rj_cache.get(c["id"]) or json.loads(c["raw"] or "{}")
                c_pm = _pmg_full(crj)
                ca   = round(abs(float(c["amount"] or 0)), 2)
                cdt  = _pd(c["transaction_date"])
                if not cdt:
                    continue
                best = None; best_days = None
                for r in non_cancels:
                    if r["patient_id"] != c["patient_id"]: continue
                    ra = round(abs(float(r["amount"] or 0)), 2)
                    if abs(ra - ca) > 0.01: continue
                    rd = _pd(r["transaction_date"])
                    if not rd: continue
                    dy = abs((rd - cdt).days)
                    if dy > 2: continue
                    if best is None or dy < best_days:
                        best = r; best_days = dy
                        if dy == 0: break
                if not best: continue
                best_rj = _pay_rj_cache.get(best["id"]) or json.loads(best["raw"] or "{}")
                r_pm    = _pmg_full(best_rj)
                if c_pm["group"] == r_pm["group"]: continue
                conf      = "medium" if (c_pm["group"] != "unknown" and r_pm["group"] != "unknown") else "low"
                corr_type = f"{c_pm['group']}_to_{r_pm['group']}"
                reason    = (f"Cancelled payment re-entered same/nearby day with different method: "
                             f"{c_pm['label']} → {r_pm['label']}")
                payment_method_reviews.append(
                    _build_pm_item(c, crj, best, best_rj, c_pm, r_pm,
                                   "heuristic_cancel_reentry", reason, conf, corr_type)
                )
                by_pm_corr_type[corr_type] = by_pm_corr_type.get(corr_type, 0) + 1

        except Exception as _pm_err:
            logger.warning(f"payment_method_reviews error: {_pm_err}")

        # De-dup
        seen_pm = set()
        pm_final = []
        for it in payment_method_reviews:
            k = (it["original_transaction_id"], it["replacement_transaction_id"])
            if k not in seen_pm:
                seen_pm.add(k); pm_final.append(it)
        payment_method_reviews = sorted(pm_final, key=lambda x: (0 if x["confidence"]=="high" else 1 if x["confidence"]=="medium" else 2, -x["original_amount"]))

        # Add to summary
        summary["payment_method_review_count"]  = len(payment_method_reviews)
        summary["by_payment_method_correction_type"] = by_pm_corr_type

        # ── Voided review queue (Phase 3B — enriched context) ────────────────
        # Patch: 2026-05-09 — adds office, staff entered-by, ledger/category context,
        #        chain transaction details, void type classification.
        # Constraints: read-only, no DB changes, no totals changes, no POS changes.

        # ── Phase 3B helpers ──────────────────────────────────────────────────

        def _void_type(lt, is_cancel, is_reversal, is_voided, cat):
            """Classify void/reversal type from ledger_type and flags."""
            if is_cancel:
                # e.g. PatientPaymentCancellation → payment_cancellation
                base = lt.replace("Cancellation", "").strip()
                mapping = {
                    "PatientPayment":              "payment_cancellation",
                    "PatientProcedurePayment":     "procedure_payment_cancellation",
                    "InsurancePayment":            "insurance_payment_cancellation",
                    "InsuranceAdjustment":         "insurance_adjustment_cancellation",
                    "PatientProcedure":            "procedure_cancellation",
                    "PatientProcedureLedger":      "procedure_ledger_cancellation",
                    "PatientProcedureLedgerRebill":"procedure_rebill_cancellation",
                }
                return mapping.get(base, f"cancellation_{base.lower()}" if base else "cancellation")
            if is_reversal:
                return "reversal_chain"
            if cat == "void_or_reversal":
                return "credit_card_void"
            if is_voided:
                return "voided_inactive"
            return "voided_other"

        def _corr_source_void(lt, is_cancel, is_reversal, is_voided):
            if is_cancel:
                return "cancellation_ledger_type"
            if is_reversal:
                return "reversal_previous_transaction"
            if is_voided:
                return "is_active_0"
            return "adjustment_category_void"

        def _void_confidence(is_cancel, is_voided, is_reversal):
            if is_cancel or is_voided:
                return "high"
            if is_reversal:
                return "high"
            return "medium"

        # Build lookup from already-processed rows (same filter scope)
        _proc_by_id = {p["transaction_id"]: p for p in processed}

        # Collect chain IDs not already in processed — fetch from DB in one batch
        _chain_ids_needed = set()
        for p in processed:
            if p["is_voided"] or p["is_reversal"] or p["adjustment_category"] == "void_or_reversal":
                if p["previous_transaction_id"] and p["previous_transaction_id"] not in _proc_by_id:
                    _chain_ids_needed.add(p["previous_transaction_id"])
                if p["replaced_by_transaction_id"] and p["replaced_by_transaction_id"] not in _proc_by_id:
                    _chain_ids_needed.add(p["replaced_by_transaction_id"])

        _chain_rows = {}
        if _chain_ids_needed:
            try:
                _ph2 = ",".join("?" * len(_chain_ids_needed))
                for _cr in conn.execute(
                    f"SELECT id, transaction_date, amount, ledger_type, raw FROM adjustments WHERE id IN ({_ph2})",
                    list(_chain_ids_needed)
                ):
                    _crj = json.loads(_cr["raw"] or "{}")
                    _ou2 = _crj.get("onlineUser") or {}
                    _uid2 = _ou2.get("id") if isinstance(_ou2, dict) else None
                    if _uid2 and _uid2 not in _USER_CACHE:
                        _maybe_fetch_users([_uid2])
                    _u2inf = _user_info(_uid2)
                    _chain_rows[_cr["id"]] = {
                        "transaction_date":  str(_cr["transaction_date"])[:10] if _cr["transaction_date"] else None,
                        "amount":            round(float(_cr["amount"] or 0), 2),
                        "ledger_type":       _cr["ledger_type"],
                        "online_user_id":    _uid2,
                        "online_user_name":  _u2inf["name"] if _u2inf else None,
                    }
            except Exception as _ce:
                logger.warning(f"voided_reviews chain lookup error: {_ce}")

        def _chain_ctx(tid):
            """Return chain row context from processed or fallback batch."""
            if tid is None:
                return None
            if tid in _proc_by_id:
                p2 = _proc_by_id[tid]
                return {
                    "transaction_date":  p2["transaction_date"],
                    "amount":            p2["signed_amount"],
                    "ledger_type":       p2["ledger_type"],
                    "online_user_id":    p2["online_user_id"],
                    "online_user_name":  p2["online_user_name"],
                }
            return _chain_rows.get(tid)

        # ── Build enriched voided queue ───────────────────────────────────────
        voided_reviews = []
        for p in processed:
            if not (p["is_voided"] or p["is_reversal"] or p["adjustment_category"] == "void_or_reversal"):
                continue

            lt        = p["ledger_type"] or ""
            vtype     = _void_type(lt, p["is_cancelled"], p["is_reversal"], p["is_voided"], p["adjustment_category"])
            csrc      = _corr_source_void(lt, p["is_cancelled"], p["is_reversal"], p["is_voided"])
            vconf     = _void_confidence(p["is_cancelled"], p["is_voided"], p["is_reversal"])

            prev_ctx  = _chain_ctx(p["previous_transaction_id"])
            repl_ctx  = _chain_ctx(p["replaced_by_transaction_id"])

            # Void/reversal date: void_or_reversal_date (already computed) or
            # modified_date as fallback — label clearly as source-derived
            void_date    = p.get("void_or_reversal_date")
            void_date_src = "void_or_reversal_date"
            if not void_date and p["modified_date"]:
                void_date     = p["modified_date"]
                void_date_src = "modified_date_approximate"

            # Neutral review reason
            if p["is_cancelled"]:
                reason = f"Cancellation: {lt}"
            elif p["is_reversal"] and prev_ctx:
                reason = (f"Reversal of transaction {p['previous_transaction_id']} "
                          f"({prev_ctx['ledger_type'] or 'unknown type'})")
            elif p["adjustment_category"] == "void_or_reversal":
                reason = f"Void / reversal adjustment: {p['organization_ledger_type_name'] or lt}"
            else:
                reason = f"Voided (inactive): {lt}"

            voided_reviews.append({
                # Core identity
                "transaction_id":                   p["transaction_id"],
                "patient_id":                       p["patient_id"],
                "patient_name":                     p["patient_name"],
                "office":                           p["office"],
                "location_id":                      p["location_id"],

                # Amounts
                "amount":                           p["amount"],          # abs
                "signed_amount":                    p["signed_amount"],
                "financial_amount":                 p["financial_amount"],

                # Dates
                "transaction_date":                 p["transaction_date"],
                "entry_date":                       p["entry_date"],
                "modified_date":                    p["modified_date"],
                "void_or_reversal_date":            void_date,
                "void_or_reversal_date_source":     void_date_src,

                # Ledger / category context
                "ledger_type":                      lt,
                "organization_ledger_type_id":      p["organization_ledger_type_id"],
                "organization_ledger_type_name":    p["organization_ledger_type_name"],
                "adjustment_category":              p["adjustment_category"],
                "adjustment_category_label":        p["adjustment_category_label"],

                # Status flags
                "status":                           p["status"],
                "is_voided":                        p["is_voided"],
                "is_cancelled":                     p["is_cancelled"],
                "is_reversal":                      p["is_reversal"],

                # Chain context
                "previous_transaction_id":          p["previous_transaction_id"],
                "replaced_by_transaction_id":       p["replaced_by_transaction_id"],
                "previous_transaction_type":        prev_ctx["ledger_type"]        if prev_ctx else None,
                "previous_transaction_amount":      prev_ctx["amount"]             if prev_ctx else None,
                "previous_transaction_date":        prev_ctx["transaction_date"]   if prev_ctx else None,
                "replacement_transaction_type":     repl_ctx["ledger_type"]        if repl_ctx else None,
                "replacement_transaction_amount":   repl_ctx["amount"]             if repl_ctx else None,
                "replacement_transaction_date":     repl_ctx["transaction_date"]   if repl_ctx else None,

                # Staff entered-by (this transaction)
                "online_user_id":                   p["online_user_id"],
                "online_user_name":                 p["online_user_name"] or "Unknown",
                "online_user_role":                 p["online_user_role"],
                "online_user_source":               p["online_user_source"],
                "staff_attribution_confidence":     p["staff_attribution_confidence"],

                # Staff entered-by (linked chain transactions)
                "previous_online_user_id":          prev_ctx["online_user_id"]   if prev_ctx else None,
                "previous_online_user_name":        prev_ctx["online_user_name"] if prev_ctx else None,
                "replacement_online_user_id":       repl_ctx["online_user_id"]   if repl_ctx else None,
                "replacement_online_user_name":     repl_ctx["online_user_name"] if repl_ctx else None,

                # Review labels
                "review_reason":                    reason,
                "review_label":                     "Voided Transaction Review",
                "confidence":                       vconf,
                "void_or_reversal_type":            vtype,
                "correction_source":                csrc,
            })

        voided_reviews = sorted(voided_reviews, key=lambda x: abs(x["signed_amount"] or 0), reverse=True)

        # ── Discount / Write-Off Review queue (Phase 4A) ──────────────────────
        # Full-filter-scope (not page-scope). Capped at Q_LIMIT (200).
        # READ-ONLY. No DB/schema/data changes. No migrations. No POS changes.
        # No Rocket/frontend changes. No deploy. Neutral language only.
        # Categories: all 8 write-off/discount categories from _WRITEOFF_CATS | _DISCOUNT_CATS.
        # Approval evidence is inferred from notes/entry-user only —
        # Dentrix has no structured approvedBy field.

        _DW_CATS = _WRITEOFF_CATS | _DISCOUNT_CATS  # 8 categories

        def _dw_doc_status(p):
            """documentation_status: complete | missing_note | approval_evidence_missing | review_recommended"""
            if p["approval_evidence_status"] == "evidence_missing":
                return "approval_evidence_missing"
            if not p["has_note"]:
                return "missing_note"
            if p["needs_review"]:
                return "review_recommended"
            return "complete"

        def _dw_review_reason(p):
            """Neutral, non-accusatory review reason string."""
            cat   = p["adjustment_category"]
            flags = set(p["review_flags"])
            is_wo = cat in _WRITEOFF_CATS
            if "approval_evidence_missing" in flags:
                return "Approval evidence missing for management-review category"
            if "missing_note" in flags and "large_adjustment" in flags:
                return ("Large write-off amount — note missing" if is_wo
                        else "Large discount amount — note missing")
            if "large_adjustment" in flags:
                return "Large write-off amount" if is_wo else "Large discount amount"
            if "missing_note" in flags:
                return "Discount/courtesy adjustment missing note"
            if "late_posted" in flags:
                return "Late-posted discount/write-off"
            return "Documentation present"

        def _dw_priority(p):
            """review_priority: high | medium | low"""
            if p["requires_manager_review"]:
                return "high"
            if p["needs_review"]:
                return "medium"
            return "low"

        def _dw_sort_key(x):
            """Sort: requires_manager_review → approval_evidence_missing → missing_note
               → large_adjustment → abs amount desc → newest transaction date desc."""
            flags = set(x["review_flags"])
            try:
                date_int = int((x["transaction_date"] or "0000-00-00").replace("-", ""))
            except (ValueError, AttributeError):
                date_int = 0
            return (
                0 if x["requires_manager_review"] else 1,
                0 if "approval_evidence_missing" in flags else 1,
                0 if "missing_note"             in flags else 1,
                0 if "large_adjustment"         in flags else 1,
                -x["amount"],
                -date_int,
            )

        discount_writeoff_reviews_full = []
        for p in processed:
            if p["adjustment_category"] not in _DW_CATS:
                continue
            doc_st    = _dw_doc_status(p)
            dw_reason = _dw_review_reason(p)
            dw_pri    = _dw_priority(p)
            discount_writeoff_reviews_full.append({
                # Core
                "adjustment_id":                      p["adjustment_id"],
                "transaction_id":                     p["transaction_id"],
                "patient_id":                         p["patient_id"],
                "patient_name":                       p["patient_name"],
                "office":                             p["office"],
                "location_id":                        p["location_id"],
                "provider_id":                        p["provider_id"],
                "provider_name":                      p["provider_name"],
                # Category
                "adjustment_category":                p["adjustment_category"],
                "adjustment_category_label":          p["adjustment_category_label"],
                "adjustment_group":                   p["adjustment_group"],
                "organization_ledger_type_id":        p["organization_ledger_type_id"],
                "organization_ledger_type_name":      p["organization_ledger_type_name"],
                # Amounts
                "amount":                             p["amount"],
                "signed_amount":                      p["signed_amount"],
                "financial_amount":                   p["financial_amount"],
                # Dates
                "transaction_date":                   p["transaction_date"],
                "entry_date":                         p["entry_date"],
                "modified_date":                      p["modified_date"],
                "days_between_transaction_and_entry": p["days_between_transaction_and_entry"],
                "is_late_posted":                     p["is_late_posted"],
                # Staff Entered By
                "online_user_id":                     p["online_user_id"],
                "online_user_name":                   p["online_user_name"],
                "online_user_role":                   p["online_user_role"],
                "online_user_source":                 p["online_user_source"],
                "staff_attribution_confidence":       p["staff_attribution_confidence"],
                # Documentation / approval evidence
                "reason":                             p["reason"],
                "note":                               p["note"],
                "has_note":                           p["has_note"],
                "approval_evidence_status":           p["approval_evidence_status"],
                "approval_evidence_source":           p["approval_evidence_source"],
                "approval_evidence_text":             p["approval_evidence_text"],
                "review_flags":                       p["review_flags"],
                "review_flag_labels":                 p["review_flag_labels"],
                "needs_review":                       p["needs_review"],
                "requires_manager_review":            p["requires_manager_review"],
                # Status / chain
                "status":                             p["status"],
                "is_voided":                          p["is_voided"],
                "is_cancelled":                       p["is_cancelled"],
                "is_reversal":                        p["is_reversal"],
                "previous_transaction_id":            p["previous_transaction_id"],
                "replaced_by_transaction_id":         p["replaced_by_transaction_id"],
                # Review-specific
                "review_label":                       "Discount / Write-Off Review",
                "review_reason":                      dw_reason,
                "review_priority":                    dw_pri,
                "documentation_status":               doc_st,
                "_source":                            p["_source"],
                "_source_table":                      p["_source_table"],
            })

        discount_writeoff_reviews_full.sort(key=_dw_sort_key)
        _dw_full_count = len(discount_writeoff_reviews_full)

        # Summary additions — safe new fields only; no existing totals changed
        _dw_mn_count  = sum(1 for x in discount_writeoff_reviews_full if "missing_note"             in x["review_flags"])
        _dw_ae_count  = sum(1 for x in discount_writeoff_reviews_full if "approval_evidence_missing" in x["review_flags"])
        _dw_rm_count  = sum(1 for x in discount_writeoff_reviews_full if x["requires_manager_review"])
        _dw_total_amt = round(sum(x["signed_amount"] for x in discount_writeoff_reviews_full), 2)

        summary["discount_writeoff_review_count"]                    = _dw_full_count
        summary["discount_writeoff_review_amount"]                   = _dw_total_amt
        summary["discount_writeoff_missing_note_count"]              = _dw_mn_count
        summary["discount_writeoff_approval_evidence_missing_count"] = _dw_ae_count
        summary["discount_writeoff_requires_manager_review_count"]   = _dw_rm_count

        # ── Documentation review queue (Part F) ──────────────────────────────
        doc_flag_set = {"missing_note", "approval_evidence_missing", "requires_manager_review",
                        "unmapped_adjustment_type", "large_adjustment", "late_posted"}
        doc_reviews = []
        for p in processed:
            matching = [f for f in p["review_flags"] if f in doc_flag_set]
            if matching:
                doc_reviews.append({
                    "adjustment_id":             p["adjustment_id"],
                    "patient_id":                p["patient_id"],
                    "patient_name":              p["patient_name"],
                    "office":                    p["office"],
                    "adjustment_category_label": p["adjustment_category_label"],
                    "amount":                    p["signed_amount"],
                    "transaction_date":          p["transaction_date"],
                    "entry_date":                p["entry_date"],
                    "online_user_name":          p["online_user_name"],
                    "approval_evidence_status":  p["approval_evidence_status"],
                    "note":                      p["note"],
                    "triggered_flags":           matching,
                    "triggered_flag_labels":     [l for f, l in zip(p["review_flags"], p["review_flag_labels"]) if f in doc_flag_set],
                })
        doc_reviews = sorted(doc_reviews, key=lambda x: abs(x["amount"] or 0), reverse=True)

        Q_LIMIT = 200
        summary["voided_transaction_review_count"] = len(voided_reviews)

        review_queues = {
            "payment_method_reviews":       payment_method_reviews[:Q_LIMIT],
            "voided_transaction_reviews":   voided_reviews[:Q_LIMIT],
            "discount_writeoff_reviews":    discount_writeoff_reviews_full[:Q_LIMIT],
            "documentation_reviews":        doc_reviews[:Q_LIMIT],
            "_queue_item_limit":            Q_LIMIT,
            "_queue_counts_full_scope":     {
                "payment_method_reviews":    len(payment_method_reviews),
                "voided_transaction_reviews": len(voided_reviews),
                "discount_writeoff_reviews": _dw_full_count,
                "documentation_reviews":     len(doc_reviews),
            },
            "_note":                        "Items capped at 200 per queue. Counts in summary and _queue_counts_full_scope are full-filter-scope.",
        }

        return {
            "data": page_data,
            "pagination": {
                "page":          page,
                "page_size":     pageSize,
                "total_rows":    total_filtered,
                "total_pages":   total_pages,
                "has_next_page": page < total_pages,
            },
            "metadata": {
                "start_date":       s,
                "end_date":         e,
                "include_voided":   includeVoided,
                "category_filter":  adjustmentCategory,
                "flag_filter":      reviewFlag,
                # Part H
                "source":                   "Dentrix Ascend ledger adjustment data (SQLite ascend.db). Synced from Dentrix Ascend REST API.",
                "classification_source":    "organizationLedgerType.id decoded to official Dentrix category name (28 IDs verified via /v1/organizationledgertypes API audit). Fallback: ledger_type field. If neither resolves: Unmapped Adjustment.",
                "user_source":              "onlineUser.id decoded to staff name via static audit cache (15 top users) + lazy /v1/users API fetch for unknowns. This field identifies who entered the transaction in Dentrix, not who approved it.",
                "approved_by_note":         "approvedBy does NOT exist in Dentrix Ascend API. The system has no structured approval field. Approval evidence is inferred from: (1) note field keywords, (2) onlineUser = Dr. G (NYGIZ). This is advisory only. A future internal approval_log table would provide authoritative approval tracking.",
                "approval_evidence_note":   "approval_evidence_status is inferred inference only. evidence_found means keywords or Dr. G as entry user. evidence_missing means high-risk category with no detectable evidence. not_required means category/amount not considered high-risk. Never implies official approval was or was not given.",
                "review_flags_note":        "Review flags are neutral operational review indicators. They identify adjustments that may benefit from manager attention based on amount, timing, documentation, or pattern. They are not accusations of wrongdoing.",
                "summary_scope":            "All summary fields and review queue counts are calculated from the full filtered result set, not the current page.",
                "discount_writeoff_reviews_note": "discount_writeoff_reviews is full-filter-scope (not page-scope). Includes all rows where adjustment_category is one of: insurance_writeoff, ppo_contractual_writeoff, discount_plan, in_house_discount, professional_courtesy, family_friend_courtesy, management_discount, no_charge_courtesy. Capped at 200 items after priority sort. approval_evidence_status is inferred from note keywords and entry-user context only — Dentrix Ascend has no structured approvedBy field. 'Approval Evidence Missing' means no detectable evidence was found for a high-risk category; it does not imply wrongdoing. 'Staff Entered By' identifies who posted the adjustment in Dentrix, not who authorized it. Review indicators are neutral operational flags.",
            },
            "summary": summary,
            "review_queues": review_queues,
        }
    finally:
        conn.close()

# ── RCM: AR AGING (OFFICIAL — Dentrix Ascend Aging Balances) ──────────────────
@app.get("/v2/rcm/ar-aging-official", tags=["RCM"], dependencies=[Depends(verify_api_key)])
def rcm_ar_aging_official(
    officeId:          Optional[str] = Query(None, description="Dashboard office UUID"),
    locationId:        Optional[str] = Query(None, description="Dentrix numeric location ID"),
    x_super_admin_key: Optional[str] = Header(None, alias="X-Super-Admin-Key"),
):
    """
    Official Dentrix A/R Aging from live /v1/agingbalances/report.
    Returns total/insurance/patient aging bucket splits.
    As-of current (not date-range). Cached 15 minutes per scope.

    Unapplied Credits / Billing Review (super_admin only):
      unapplied_credits in ar_aging and by_office[] is restricted to super_admin.
      Access requires X-Super-Admin-Key header matching NUDASHBOARD_SUPER_ADMIN_KEY env var.
      For non-super_admin: unapplied_credits is omitted; metadata flags indicate access level.
      This field is a billing-review item, not an automatic refund owed.
    """
    import re as _re
    from ar_service import get_ar_official, _OFFICE_UUID_TO_LOC, LOCATIONS

    # ── Super-admin role detection ────────────────────────────────────────────
    # Role context is determined solely by X-Super-Admin-Key vs NUDASHBOARD_SUPER_ADMIN_KEY env var.
    # The backend has a single shared API key with no per-user JWT role claims.
    # If env var is not set: treat as missing role context → suppress unapplied_credits.
    if NUDASHBOARD_SUPER_ADMIN_KEY:
        _is_super_admin   = bool(x_super_admin_key and x_super_admin_key == NUDASHBOARD_SUPER_ADMIN_KEY)
        _unapplied_access = "super_admin" if _is_super_admin else "restricted"
    else:
        _is_super_admin   = False
        _unapplied_access = "restricted_backend_role_context_missing"

    loc_id = None

    # Resolve officeId (UUID) to Dentrix location ID
    if officeId:
        loc_id = _OFFICE_UUID_TO_LOC.get(officeId)
        if not loc_id:
            raise HTTPException(status_code=400, detail=f"Unknown officeId: {officeId}")

    # Resolve locationId — must be numeric Dentrix ID
    if locationId:
        if _re.match(r"^[0-9a-f]{8}-", locationId):
            raise HTTPException(
                status_code=400,
                detail=f"locationId must be a Dentrix numeric ID (e.g. 14000000000433), not a UUID. Use officeId for UUIDs.",
            )
        if locationId not in LOCATIONS:
            raise HTTPException(status_code=400, detail=f"Unknown locationId: {locationId}")
        loc_id = locationId

    try:
        result = get_ar_official(loc_id)
        if "error" in result:
            raise HTTPException(status_code=502, detail=result["error"])

        # ── unapplied_credits gating — super_admin only ───────────────────────
        # ar_service always fetches and includes unapplied_credits.
        # Strip it here for non-super_admin before the response leaves the backend.
        # Does NOT affect: total AR, insurance AR, patient/guarantor AR,
        # estimated_writeoff, net_balance, or any other field.
        if not _is_super_admin:
            # Strip from top-level ar_aging
            result.get("ar_aging", {}).pop("unapplied_credits", None)
            # Strip from each by_office entry
            for _office in result.get("by_office", []):
                _office.pop("unapplied_credits", None)

        # Inject access-control metadata flags
        result.setdefault("metadata", {}).update({
            "unapplied_credits_visible": _is_super_admin,
            "unapplied_credits_access":  _unapplied_access,
        })

        return result
    except HTTPException:
        raise
    except Exception as e:
        logger.exception("Error in AR aging official")
        raise HTTPException(status_code=500, detail=str(e))


# ── RCM: AR AGING (claim-derived — legacy) ───────────────────────────────────
@app.get("/v2/rcm/ar-aging", tags=["RCM"], dependencies=[Depends(verify_api_key)])
def rcm_ar_aging(
    startDate:  Optional[str] = Query(None),
    endDate:    Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
    page:       int           = Query(1),
    pageSize:   int           = Query(500),
):
    """
    AR Aging: outstanding patient/insurance balances aged by date of service.
    startDate/endDate filter the charge (procedure) date range.
    Days outstanding and bucket computed from charge date to today.
    Enhanced 2026-05-06: added provider, payor, plan_name, claim_id, collection_status,
    claim_followup_action, last_payment_amount from procedures/providers/insurance_claims.
    Balance math, bucket math, and existing fields are unchanged.
    payment_arrangement intentionally left null — no direct arrangement source in SQLite.
    """
    import datetime
    import sqlite3 as _sq3

    conn = _sq3.connect(RCM_DB_PATH)
    conn.row_factory = _sq3.Row
    try:
        today = datetime.date.today()

        # Build WHERE clause for charge date range and location
        where_parts = [
            "p.ledger_type IN ('PatientProcedureLedger','PatientProcedureLedgerRebill')",
            "p.is_active = 1",
        ]
        params: list = []
        if startDate:
            where_parts.append("p.transaction_date >= ?"); params.append(startDate)
        if endDate:
            where_parts.append("p.transaction_date <= ?"); params.append(endDate)
        if locationId:
            where_parts.append("p.location_id = ?"); params.append(str(locationId))
        where = " AND ".join(where_parts)

        # Per-patient per-location outstanding balance
        # Charges from procedures; credits from patient_payments, insurance_payments, adjustments
        # New CTEs: provider_cte, claim_cte, last_pay_amt — joined by patient_id + location_id
        # Balance math and bucket formulas are unchanged.
        rows = conn.execute(f"""
            WITH charges AS (
                SELECT p.patient_id,
                       p.location_id,
                       SUM(p.amount)               AS total_charges,
                       MIN(p.transaction_date)     AS first_charge_date,
                       MAX(p.transaction_date)     AS last_charge_date,
                       COUNT(DISTINCT p.id)        AS procedure_count
                FROM procedures p
                WHERE {where}
                GROUP BY p.patient_id, p.location_id
            ),
            patient_paid AS (
                SELECT pp.patient_id, pp.location_id, SUM(ABS(pp.amount)) AS total_paid,
                       MAX(pp.transaction_date) AS last_payment_date
                FROM patient_payments pp
                WHERE pp.ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')
                AND pp.is_active = 1
                GROUP BY pp.patient_id, pp.location_id
            ),
            ins_paid AS (
                SELECT ip.patient_id, ip.location_id, SUM(ABS(ip.amount)) AS total_ins
                FROM insurance_payments ip
                WHERE ip.ledger_type = 'InsurancePayment'
                AND ip.is_active = 1
                GROUP BY ip.patient_id, ip.location_id
            ),
            adj AS (
                SELECT a.patient_id, a.location_id,
                       SUM(CASE WHEN a.amount < 0 THEN ABS(a.amount) ELSE 0 END) AS total_adj
                FROM adjustments a
                WHERE a.is_active = 1
                GROUP BY a.patient_id, a.location_id
            ),
            pat_info AS (
                SELECT id,
                       json_extract(raw,'$.firstName') || ' ' || json_extract(raw,'$.lastName') AS full_name,
                       json_extract(raw,'$.chartNumber') AS chart_number,
                       json_extract(raw,'$.emailAddress') AS email,
                       json_extract(raw,'$.contactMethod') AS contact_preference,
                       json_extract(raw,'$.patientStatus') AS patient_status,
                       json_extract(raw,'$.primaryGuarantor.id') AS guarantor_id,
                       json_extract(raw,'$.phones') AS phones_json
                FROM patients
            ),
            provider_cte AS (
                -- Dominant provider per patient/location (highest procedure count).
                -- ROW_NUMBER picks one row per patient/location when tied.
                SELECT patient_id, location_id, provider_id, provider_name
                FROM (
                    SELECT proc.patient_id,
                           proc.location_id,
                           proc.provider_id,
                           pr.first_name || ' ' || pr.last_name AS provider_name,
                           COUNT(*) AS cnt,
                           ROW_NUMBER() OVER (
                               PARTITION BY proc.patient_id, proc.location_id
                               ORDER BY COUNT(*) DESC, proc.provider_id
                           ) AS rn
                    FROM procedures proc
                    JOIN providers pr ON proc.provider_id = pr.id
                    WHERE proc.is_active = 1
                    GROUP BY proc.patient_id, proc.location_id, proc.provider_id
                )
                WHERE rn = 1
            ),
            claim_cte AS (
                -- Most recent active claim per patient/location by service_date.
                -- Pulls payorName, groupPlanName, claimState, claimFollowupAction,
                -- and real Dentrix claim_id. Self-pay patients will have no row (LEFT JOIN).
                SELECT patient_id, location_id, claim_id, payor_name, plan_name,
                       claim_state, claim_followup_action
                FROM (
                    SELECT ic.patient_id,
                           ic.location_id,
                           ic.id                                           AS claim_id,
                           json_extract(ic.raw, '$.payorName')             AS payor_name,
                           json_extract(ic.raw, '$.groupPlanName')         AS plan_name,
                           json_extract(ic.raw, '$.claimState')            AS claim_state,
                           json_extract(ic.raw, '$.claimFollowupAction')   AS claim_followup_action,
                           ROW_NUMBER() OVER (
                               PARTITION BY ic.patient_id, ic.location_id
                               ORDER BY ic.service_date DESC, ic.id DESC
                           ) AS rn
                    FROM insurance_claims ic
                    WHERE ic.is_active = 1
                )
                WHERE rn = 1
            ),
            last_pay_amt AS (
                -- Amount of the single most-recent patient payment per patient/location.
                -- Separate from patient_paid (which sums all payments).
                SELECT patient_id, location_id, ABS(amount) AS last_payment_amount
                FROM (
                    SELECT pp.patient_id,
                           pp.location_id,
                           pp.amount,
                           ROW_NUMBER() OVER (
                               PARTITION BY pp.patient_id, pp.location_id
                               ORDER BY pp.transaction_date DESC, pp.id DESC
                           ) AS rn
                    FROM patient_payments pp
                    WHERE pp.ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')
                    AND pp.is_active = 1
                )
                WHERE rn = 1
            ),
            combined AS (
                SELECT
                    c.patient_id,
                    c.location_id,
                    COALESCE(pi.full_name, 'Unknown') AS patient_name,
                    pi.chart_number,
                    c.total_charges,
                    COALESCE(pp.total_paid, 0)      AS patient_paid,
                    COALESCE(ip.total_ins, 0)       AS insurance_paid,
                    COALESCE(adj.total_adj, 0)      AS adjustments,
                    c.total_charges
                      - COALESCE(pp.total_paid, 0)
                      - COALESCE(ip.total_ins, 0)
                      - COALESCE(adj.total_adj, 0)  AS balance,
                    c.first_charge_date,
                    c.last_charge_date,
                    pp.last_payment_date,
                    c.procedure_count,
                    -- provider fields
                    prov.provider_id                AS provider_id,
                    prov.provider_name              AS provider_name,
                    -- claim / payor fields
                    cl.claim_id                     AS claim_id,
                    cl.payor_name                   AS payor_name,
                    cl.plan_name                    AS plan_name,
                    cl.claim_state                  AS claim_state,
                    cl.claim_followup_action        AS claim_followup_action,
                    -- last payment amount
                    lpa.last_payment_amount         AS last_payment_amount,
                    -- contact enrichment (Phase 1A)
                    pi.email                        AS email,
                    pi.contact_preference           AS contact_preference,
                    pi.patient_status               AS patient_status,
                    pi.guarantor_id                 AS guarantor_id,
                    pi.phones_json                  AS phones_json
                FROM charges c
                LEFT JOIN patient_paid pp    ON c.patient_id = pp.patient_id    AND c.location_id = pp.location_id
                LEFT JOIN ins_paid ip         ON c.patient_id = ip.patient_id    AND c.location_id = ip.location_id
                LEFT JOIN adj                ON c.patient_id = adj.patient_id   AND c.location_id = adj.location_id
                LEFT JOIN pat_info pi        ON c.patient_id = pi.id
                LEFT JOIN provider_cte prov  ON c.patient_id = prov.patient_id  AND c.location_id = prov.location_id
                LEFT JOIN claim_cte cl       ON c.patient_id = cl.patient_id    AND c.location_id = cl.location_id
                LEFT JOIN last_pay_amt lpa   ON c.patient_id = lpa.patient_id   AND c.location_id = lpa.location_id
            )
            SELECT * FROM combined
            WHERE balance > 0.50
            ORDER BY balance DESC
        """, params).fetchall()

        # Paginate
        offset = (page - 1) * pageSize
        paged  = rows[offset: offset + pageSize]

        results = []
        for r in paged:
            # Days outstanding from first (oldest) charge date — UNCHANGED
            try:
                dos_date = datetime.date.fromisoformat(r["first_charge_date"])
                days_out = (today - dos_date).days
            except Exception:
                days_out = 0

            # Bucket — UNCHANGED
            if days_out <= 30:
                bucket = "current"
            elif days_out <= 60:
                bucket = "b30"
            elif days_out <= 90:
                bucket = "b60"
            else:
                bucket = "b90"

            balance  = float(r["balance"] or 0)
            charges  = float(r["total_charges"] or 0)
            ins_paid = float(r["insurance_paid"] or 0)
            pat_paid = float(r["patient_paid"] or 0)
            adj_amt  = float(r["adjustments"] or 0)

            # Canonical office — UNCHANGED
            office_name = LOCATION_NAMES.get(r["location_id"], "Unknown")
            office_id   = LOCATION_TO_OFFICE.get(r["location_id"], r["location_id"])

            # New fields — safely pull from row, None if not joined
            provider_id            = r["provider_id"]   if r["provider_id"]   else None
            provider_name          = r["provider_name"] if r["provider_name"] else None
            claim_id               = r["claim_id"]      if r["claim_id"]      else None
            payor_name             = r["payor_name"]    if r["payor_name"]    else None
            plan_name              = r["plan_name"]     if r["plan_name"]     else None
            claim_state            = r["claim_state"]   if r["claim_state"]   else None
            claim_followup_action  = r["claim_followup_action"] if r["claim_followup_action"] else None
            last_payment_amount    = float(r["last_payment_amount"]) if r["last_payment_amount"] else None

            # ── contact enrichment (Phase 1A) ─────────────────────────────
            # Mobile phone: first entry where phoneType == MOBILE
            mobile_phone = None
            try:
                phones_raw = r["phones_json"]
                if phones_raw:
                    phones_list = json.loads(phones_raw) if isinstance(phones_raw, str) else phones_raw
                    for ph in (phones_list or []):
                        if isinstance(ph, dict) and ph.get("phoneType") == "MOBILE" and ph.get("number"):
                            mobile_phone = ph["number"]
                            break
            except Exception:
                mobile_phone = None

            email              = r["email"]              if r["email"]              else None
            contact_preference = r["contact_preference"] if r["contact_preference"] else None
            patient_status     = r["patient_status"]     if r["patient_status"]     else None
            guarantor_id       = r["guarantor_id"]       if r["guarantor_id"]       else None
            is_self_guarantor  = None
            if guarantor_id is not None:
                is_self_guarantor = (guarantor_id == r["patient_id"])

            results.append({
                # ── existing fields (unchanged) ───────────────────────────────
                "id":                  f"{r['patient_id']}_{r['location_id']}",
                "patient_id":          r["patient_id"],
                "patient_name":        r["patient_name"],
                "chart_number":        r["chart_number"],
                "responsible_party":   r["patient_name"],
                "office_id":           office_id,
                "office_name":         office_name,
                "location_id":         r["location_id"],
                # Financial — UNCHANGED
                "charges":             charges,
                "payments":            pat_paid,
                "adjustments":         adj_amt,
                "insurance_paid":      ins_paid,
                "balance":             balance,
                "patientBalance":      balance,
                # Aging — UNCHANGED
                "date_of_service":     r["first_charge_date"],
                "last_charge_date":    r["last_charge_date"],
                "last_payment_date":   r["last_payment_date"],
                "last_statement_date": r["last_charge_date"],
                "days_outstanding":    days_out,
                "aging_bucket":        bucket,
                # Buckets — UNCHANGED
                "bucket_current":      balance if bucket == "current" else 0,
                "bucket_30":           balance if bucket == "b30"     else 0,
                "bucket_60":           balance if bucket == "b60"     else 0,
                "bucket_90":           balance if bucket == "b90"     else 0,
                # Meta — UNCHANGED (payment_arrangement intentionally null:
                # no direct arrangement source in SQLite; rebill pattern is
                # inferential only and not safe to label as an arrangement)
                "procedure_count":     r["procedure_count"],
                "payment_arrangement": None,
                "last_contact_date":   None,
                "notes":               None,
                "_source":             "dentrix_ascend",
                # ── new provider fields ───────────────────────────────────────
                "provider":            provider_name,
                "provider_id":         provider_id,
                "provider_name":       provider_name,
                # ── new claim / payor fields ──────────────────────────────────
                "claim_id":            claim_id,
                "payor":               payor_name,
                "payor_name":          payor_name,
                "plan_name":           plan_name,
                "collection_status":   claim_state,
                "claim_followup_action": claim_followup_action,
                # ── new last payment amount ───────────────────────────────────
                "last_payment_amount": last_payment_amount,
                # ── contact enrichment (Phase 1A) ─────────────────────────────
                "mobile_phone":        mobile_phone,
                "email":               email,
                "contact_preference":  contact_preference,
                "patient_status":      patient_status,
                "primary_guarantor_id": guarantor_id,
                "is_self_guarantor":   is_self_guarantor,
                "has_mobile_phone":    mobile_phone is not None,
                "has_email":           email is not None,
            })

        return results

    finally:
        conn.close()


# ---------------------------------------------------------------------------
# /v2/rcm/patient-balances — True patient-responsible AR balances (Phase 1)
#
# Source: Dentrix Ascend GET /v1/agingbalances/report → guarantorPortionBalance
# Enrichment: SQLite (patients, patient_payments, insurance_claims, providers)
#
# Unapplied Amounts / Billing Review:
#   Dentrix unAppliedCredits are SUPER_ADMIN ONLY.
#   These represent amounts not yet applied to treatment — NOT automatic refunds.
#   Neutral label: "Unapplied Amounts / Billing Review".
#   Gated via X-Super-Admin-Key header vs NUDASHBOARD_SUPER_ADMIN_KEY env var.
#   If env var is not set: unapplied_amounts_access = "restricted_backend_role_context_missing"
#   and unapplied fields are NEVER exposed regardless of any header value.
#
# 2026-05-09
# ---------------------------------------------------------------------------

# SQLite IN-clause chunk size (SQLite default max variables = 999; stay well under)
_PB_CHUNK = 900


def _pb_chunked(conn, sql_template, ids, extra_params=()):
    """Execute SQL with large IN clause, chunked to avoid SQLite variable limits.
    sql_template must contain exactly one __PH__ placeholder for the IN list.
    extra_params are appended after the chunk params on each call.
    """
    rows = []
    if not ids:
        return rows
    for i in range(0, len(ids), _PB_CHUNK):
        chunk = ids[i: i + _PB_CHUNK]
        ph = ",".join("?" * len(chunk))
        q = sql_template.replace("__PH__", ph)
        rows.extend(conn.execute(q, list(chunk) + list(extra_params)).fetchall())
    return rows


@app.get("/v2/rcm/patient-balances", tags=["RCM"], dependencies=[Depends(verify_api_key)])
def rcm_patient_balances(
    asOfDate:               Optional[str]   = Query(None, description="Informational in live mode (YYYY-MM-DD). Default: today."),
    officeId:               Optional[str]   = Query(None, description="Dashboard office UUID → mapped to Dentrix location ID."),
    locationId:             Optional[str]   = Query(None, description="Dentrix numeric location ID (e.g. 14000000000433). Do NOT pass a UUID here."),
    balanceType:            str             = Query("patient_responsible", description="patient_responsible | unapplied_review | all"),
    includeZeroBalances:    bool            = Query(False, description="Include patients with zero patient_responsible_balance and zero unapplied amounts."),
    includeUnappliedAmounts: bool           = Query(False, description="Include unapplied amount row fields. super_admin only."),
    minBalance:             Optional[float] = Query(None, description="Minimum patient_responsible_balance filter (applied after balanceType filter)."),
    agingBucket:            Optional[str]   = Query(None, description="Filter to aging bucket: current | b30 | b60 | b90."),
    search:                 Optional[str]   = Query(None, description="Search across patient name, chart number, patient ID, guarantor name."),
    page:                   int             = Query(1, ge=1),
    pageSize:               int             = Query(100, ge=1, le=500),
    x_super_admin_key:      Optional[str]   = Header(None, alias="X-Super-Admin-Key"),
):
    """
    True patient-responsible AR balances sourced from Dentrix Ascend
    GET /v1/agingbalances/report (guarantorPortionBalance).

    Enriched server-side with SQLite data: chart_number, guarantor_name, contact info,
    dominant provider, most-recent claim/payor, last payment date/amount.

    Unapplied Amounts / Billing Review (super_admin only):
      Dentrix unAppliedCredits represent amounts not yet applied to treatment.
      Not automatic refunds. Always verify ledger before taking any action.
      Access requires X-Super-Admin-Key header matching NUDASHBOARD_SUPER_ADMIN_KEY env var.

    Date note:
      No startDate/endDate params. This is a point-in-time balance report.
      Dentrix ages buckets from service/charge date to today.
      Do not use /v2/rcm/ar-aging for patient-responsible balances — that shows total AR.
    """
    import sqlite3 as _sq3
    import math   as _math
    import re     as _re
    import time   as _time
    from ar_service import fetch_aging_report, LOCATIONS as _AR_LOCATIONS

    _t0    = _time.time()
    _today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    _as_of = asOfDate or _today

    # ── Super-admin determination ──────────────────────────────────────────────
    # The backend has a single shared API key with no per-user JWT role claims.
    # super_admin is determined solely by X-Super-Admin-Key vs the env var.
    # If the env var is not configured, unapplied fields are NEVER exposed.
    if NUDASHBOARD_SUPER_ADMIN_KEY:
        _is_super_admin  = bool(x_super_admin_key and x_super_admin_key == NUDASHBOARD_SUPER_ADMIN_KEY)
        _unapplied_access = "super_admin" if _is_super_admin else "restricted"
    else:
        _is_super_admin  = False
        _unapplied_access = "restricted_backend_role_context_missing"

    # Guard: balanceType=unapplied_review → super_admin only
    if balanceType == "unapplied_review" and not _is_super_admin:
        raise HTTPException(
            status_code=403,
            detail=(
                "balanceType=unapplied_review requires super_admin access. "
                "Provide X-Super-Admin-Key header with a valid super_admin key."
            ),
        )

    # Silently downgrade includeUnappliedAmounts for non-super_admin
    if includeUnappliedAmounts and not _is_super_admin:
        includeUnappliedAmounts = False

    # Valid balanceType values
    if balanceType not in ("patient_responsible", "unapplied_review", "all"):
        raise HTTPException(
            status_code=400,
            detail="balanceType must be one of: patient_responsible, unapplied_review, all",
        )

    # ── Location validation and resolution ────────────────────────────────────
    _UUID_RE = _re.compile(
        r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', _re.I
    )
    if locationId and _UUID_RE.match(str(locationId)):
        raise HTTPException(
            status_code=400,
            detail=(
                "locationId must be a Dentrix numeric ID (e.g. 14000000000433). "
                "Use the officeId parameter for dashboard UUIDs."
            ),
        )

    _target_loc: Optional[str] = None
    if officeId:
        _target_loc = OFFICE_UUID_TO_LOCATION_ID.get(officeId)
        if not _target_loc:
            raise HTTPException(
                status_code=400,
                detail=f"Unknown officeId: {officeId}. Valid UUIDs: {list(OFFICE_UUID_TO_LOCATION_ID.keys())}",
            )
    elif locationId:
        if str(locationId) not in _AR_LOCATIONS:
            raise HTTPException(
                status_code=400,
                detail=f"Unknown locationId: {locationId}. Valid IDs: {list(_AR_LOCATIONS.keys())}",
            )
        _target_loc = str(locationId)

    # ── Patient-balances cache check (perf upgrade 2026-05-12) ────────────
    _cache_key_pb = _target_loc or "all"
    _cached_pb = _pb_cache.get(_cache_key_pb)
    _from_pb_cache = bool(
        _cached_pb and (_time.time() - _cached_pb["ts"]) < _PB_CACHE_TTL
    )

    if _from_pb_cache:
        # Restore all variables from cache — skip Dentrix API + SQLite enrichment
        _raw_pairs       = _cached_pb["raw_pairs"]
        _ua_lookup       = _cached_pb["ua_lookup"]
        _pat_enrich_map  = _cached_pb["pat_enrich_map"]
        _guarantor_names = _cached_pb["guarantor_names"]
        _provider_map    = _cached_pb["provider_map"]
        _claim_map       = _cached_pb["claim_map"]
        _payment_map     = _cached_pb["payment_map"]
        _api_errors      = _cached_pb.get("api_errors", [])
        _dentrix_elapsed = 0.0
        _enrich_elapsed  = 0.0

    if not _from_pb_cache:
        _fetch_locs: dict = {_target_loc: _AR_LOCATIONS[_target_loc]} if _target_loc else dict(_AR_LOCATIONS)

        # ── Fetch patient rows from Dentrix API ───────────────────────────────────
        _api_errors: list  = []
        _raw_pairs:  list  = []  # list of (dentrix_patient_dict, location_id_str)

        for _loc_id, _loc_name in _fetch_locs.items():
            try:
                _rpt = fetch_aging_report(_loc_id, include_patients=True)
                if _rpt.get("totals") is None:
                    _api_errors.append(f"{_loc_name} ({_loc_id}): No data returned from Dentrix API")
                    continue
                for _pp in (_rpt.get("patients") or []):
                    _raw_pairs.append((_pp, _loc_id))
            except Exception as _exc:
                _api_errors.append(f"{_loc_name} ({_loc_id}): {str(_exc)[:150]}")

        _dentrix_elapsed = round(_time.time() - _t0, 2)

        # Build unapplied lookup BEFORE filtering (needed for non-super_admin filter logic too)
        # Preserve Dentrix sign: negative = credit on account
        _ua_lookup: dict = {
            (str(_pp.get("id", "")), _lid): float(_pp.get("unAppliedCredits", 0) or 0)
            for (_pp, _lid) in _raw_pairs
            if _pp.get("id")
        }

        # ── Batch SQLite enrichment ───────────────────────────────────────────────
        _all_pid_list  = list({str(_pp.get("id", "")) for (_pp, _) in _raw_pairs if _pp.get("id")})
        _all_loc_list  = list(_fetch_locs.keys())   # ≤ 4 always

        _pat_enrich_map:  dict = {}   # patient_id → {chart_number, guarantor_id, email, ...}
        _guarantor_names: dict = {}   # guarantor_id → full_name
        _provider_map:    dict = {}   # (patient_id, location_id) → provider_name
        _claim_map:       dict = {}   # (patient_id, location_id) → {payor_name, plan_name, claim_state}
        _payment_map:     dict = {}   # (patient_id, location_id) → {last_payment_date, last_payment_amount}

        _sq_conn = _sq3.connect(RCM_DB_PATH, timeout=15)
        _sq_conn.row_factory = _sq3.Row
        try:
            # 1 ─ Patient info
            _pat_rows = _pb_chunked(
                _sq_conn,
                """SELECT id,
                          json_extract(raw,'$.chartNumber')           AS chart_number,
                          json_extract(raw,'$.primaryGuarantor.id')   AS guarantor_id,
                          json_extract(raw,'$.emailAddress')          AS email,
                          json_extract(raw,'$.contactMethod')         AS contact_preference,
                          json_extract(raw,'$.patientStatus')         AS patient_status,
                          json_extract(raw,'$.phones')                AS phones_json
                   FROM patients WHERE id IN (__PH__)""",
                _all_pid_list,
            )
            for _pr in _pat_rows:
                _mob = None
                try:
                    _ph_raw = _pr["phones_json"]
                    if _ph_raw:
                        _ph_list = json.loads(_ph_raw) if isinstance(_ph_raw, str) else _ph_raw
                        for _ph_e in (_ph_list or []):
                            if isinstance(_ph_e, dict) and _ph_e.get("phoneType") == "MOBILE" and _ph_e.get("number"):
                                _mob = _ph_e["number"]
                                break
                except Exception:
                    pass
                _pat_enrich_map[_pr["id"]] = {
                    "chart_number":      _pr["chart_number"],
                    "guarantor_id":      _pr["guarantor_id"],
                    "email":             _pr["email"],
                    "contact_preference": _pr["contact_preference"],
                    "patient_status":    _pr["patient_status"],
                    "mobile_phone":      _mob,
                }

            # 2 ─ Guarantor names (guarantor_id → another patient row)
            _guar_ids = list({
                v["guarantor_id"]
                for v in _pat_enrich_map.values()
                if v.get("guarantor_id")
            })
            if _guar_ids:
                _guar_rows = _pb_chunked(
                    _sq_conn,
                    "SELECT id, first_name || ' ' || last_name AS full_name FROM patients WHERE id IN (__PH__)",
                    _guar_ids,
                )
                for _gr in _guar_rows:
                    _guarantor_names[_gr["id"]] = _gr["full_name"]

            # 3 ─ Dominant provider per (patient_id, location_id)
            #     Patient IDs chunked; location IDs (≤4) as simple IN clause appended.
            _loc_ph = ",".join("?" * len(_all_loc_list))
            if _all_pid_list and _all_loc_list:
                _prov_rows = _pb_chunked(
                    _sq_conn,
                    f"""SELECT proc.patient_id, proc.location_id,
                               pr.first_name || ' ' || pr.last_name AS provider_name,
                               COUNT(*) AS cnt
                        FROM procedures proc
                        JOIN providers pr ON proc.provider_id = pr.id
                        WHERE proc.is_active = 1
                          AND proc.patient_id  IN (__PH__)
                          AND proc.location_id IN ({_loc_ph})
                        GROUP BY proc.patient_id, proc.location_id, proc.provider_id
                        ORDER BY cnt DESC""",
                    _all_pid_list,
                    extra_params=_all_loc_list,
                )
                _seen_prov: set = set()
                for _pvr in _prov_rows:
                    _key = (_pvr["patient_id"], _pvr["location_id"])
                    if _key not in _seen_prov:
                        _provider_map[_key] = _pvr["provider_name"]
                        _seen_prov.add(_key)

            # 4 ─ Most recent active claim per (patient_id, location_id)
            if _all_pid_list and _all_loc_list:
                _claim_rows = _pb_chunked(
                    _sq_conn,
                    f"""SELECT ic.patient_id, ic.location_id,
                               json_extract(ic.raw,'$.payorName')      AS payor_name,
                               json_extract(ic.raw,'$.groupPlanName')  AS plan_name,
                               json_extract(ic.raw,'$.claimState')     AS claim_state,
                               ic.service_date
                        FROM insurance_claims ic
                        WHERE ic.is_active = 1
                          AND ic.patient_id  IN (__PH__)
                          AND ic.location_id IN ({_loc_ph})
                        ORDER BY ic.service_date DESC, ic.id DESC""",
                    _all_pid_list,
                    extra_params=_all_loc_list,
                )
                _seen_claim: set = set()
                for _cr in _claim_rows:
                    _key = (_cr["patient_id"], _cr["location_id"])
                    if _key not in _seen_claim:
                        _claim_map[_key] = {
                            "payor_name":  _cr["payor_name"],
                            "plan_name":   _cr["plan_name"],
                            "claim_state": _cr["claim_state"],
                        }
                        _seen_claim.add(_key)

            # 5 ─ Last patient payment per (patient_id, location_id)
            if _all_pid_list and _all_loc_list:
                _pay_rows = _pb_chunked(
                    _sq_conn,
                    f"""SELECT pp.patient_id, pp.location_id,
                               pp.transaction_date,
                               ABS(pp.amount) AS amount
                        FROM patient_payments pp
                        WHERE pp.is_active = 1
                          AND pp.ledger_type IN ('PatientProcedurePayment','PatientProcedurePaymentRebill')
                          AND pp.patient_id  IN (__PH__)
                          AND pp.location_id IN ({_loc_ph})
                        ORDER BY pp.transaction_date DESC, pp.id DESC""",
                    _all_pid_list,
                    extra_params=_all_loc_list,
                )
                _seen_pay: set = set()
                for _payr in _pay_rows:
                    _key = (_payr["patient_id"], _payr["location_id"])
                    if _key not in _seen_pay:
                        _payment_map[_key] = {
                            "last_payment_date":   _payr["transaction_date"],
                            "last_payment_amount": round(float(_payr["amount"]), 2),
                        }
                        _seen_pay.add(_key)

        finally:
            _sq_conn.close()

        _enrich_elapsed = round(_time.time() - _t0 - _dentrix_elapsed, 2)

        # ── Store in patient-balances cache (perf upgrade 2026-05-12) ─────
        _pb_cache[_cache_key_pb] = {
            "raw_pairs": _raw_pairs, "ua_lookup": _ua_lookup,
            "pat_enrich_map": _pat_enrich_map,
            "guarantor_names": _guarantor_names,
            "provider_map": _provider_map, "claim_map": _claim_map,
            "payment_map": _payment_map, "api_errors": _api_errors,
            "ts": _time.time(),
        }


    # ── Build enriched rows ───────────────────────────────────────────────────
    _all_rows: list = []
    for (_pp, _loc_id) in _raw_pairs:
        _pid = str(_pp.get("id", ""))
        if not _pid:
            continue

        _enrich     = _pat_enrich_map.get(_pid, {})
        _key        = (_pid, _loc_id)
        _guar_id    = _enrich.get("guarantor_id")
        _guar_name  = _guarantor_names.get(_guar_id) if _guar_id else None
        _is_self_g  = (_guar_id == _pid) if _guar_id else None

        # Dentrix balance fields
        _grp_bal  = round(float(_pp.get("guarantorPortionBalance", 0) or 0), 2)
        _ins_bal  = round(float(_pp.get("insurancePortionBalance",  0) or 0), 2)
        _ttl_bal  = round(float(_pp.get("balance",                  0) or 0), 2)
        _wo_bal   = round(float(_pp.get("writeOffBalance",          0) or 0), 2)
        _clm_pend = round(float(_pp.get("claimsPending",            0) or 0), 2)
        _ua_raw   = _ua_lookup.get(_key, 0.0)   # preserved Dentrix sign

        # Aging buckets (from Dentrix; service/charge date basis)
        _bkt_cur  = round(float(_pp.get("current",      0) or 0), 2)
        _bkt_30   = round(float(_pp.get("thirtyDays",   0) or 0), 2)
        _bkt_60   = round(float(_pp.get("sixtyDays",    0) or 0), 2)
        _bkt_90   = round(float(_pp.get("ninetyDays",   0) or 0), 2)

        # Dominant bucket: highest dollar amount; tie-break favors older bucket
        _bkt_candidates = [("b90", _bkt_90), ("b60", _bkt_60), ("b30", _bkt_30), ("current", _bkt_cur)]
        _aging_bucket   = max(_bkt_candidates, key=lambda x: x[1])[0]

        _pay_info   = _payment_map.get(_key, {})
        _claim_info = _claim_map.get(_key, {})
        _office_id  = LOCATION_TO_OFFICE.get(_loc_id, _loc_id)
        _office_nm  = LOCATION_NAMES.get(_loc_id, "Unknown")

        _row: dict = {
            # ── Identity ─────────────────────────────────────────────────────
            "patient_id":        _pid,
            "patient_name":      (f"{_pp.get('firstName', '')} {_pp.get('lastName', '')}".strip() or "Unknown"),
            "chart_number":      _enrich.get("chart_number"),
            "office_id":         _office_id,
            "office_name":       _office_nm,
            "location_id":       _loc_id,
            "guarantor_id":      _guar_id,
            "guarantor_name":    _guar_name,
            "is_self_guarantor": _is_self_g,
            # ── Balances ─────────────────────────────────────────────────────
            "patient_responsible_balance": _grp_bal,
            "insurance_portion_balance":   _ins_bal,
            "total_balance":               _ttl_bal,
            "write_off_balance":           _wo_bal,
            "claims_pending":              _clm_pend,
            # ── Aging (Dentrix buckets; service/charge date basis) ───────────
            "aging_bucket":  _aging_bucket,
            "bucket_current": _bkt_cur,
            "bucket_30":      _bkt_30,
            "bucket_60":      _bkt_60,
            "bucket_90":      _bkt_90,
            # ── Payment / Statement ──────────────────────────────────────────
            "last_payment_date":   _pay_info.get("last_payment_date"),
            "last_payment_amount": _pay_info.get("last_payment_amount"),
            # last_statement_date: approximated from last payment date in SQLite.
            # True statement date requires Dentrix /v1/patientstatements (separate call).
            "last_statement_date":      _pay_info.get("last_payment_date"),
            "last_statement_date_note": "Approximate — last patient payment date from SQLite. True statement date available via /v2/rcm/dentrix-statements.",
            # ── Contact ──────────────────────────────────────────────────────
            "mobile_phone":       _enrich.get("mobile_phone"),
            "email":              _enrich.get("email"),
            "contact_preference": _enrich.get("contact_preference"),
            "patient_status":     _enrich.get("patient_status"),
            "has_mobile_phone":   _enrich.get("mobile_phone") is not None,
            "has_email":          _enrich.get("email") is not None,
            # ── Provider / Payor (SQLite enrichment; null if unavailable) ────
            "provider_name": _provider_map.get(_key),
            "payor_name":    _claim_info.get("payor_name"),
            "plan_name":     _claim_info.get("plan_name"),
            "claim_status":  _claim_info.get("claim_state"),
            # ── Workflow ─────────────────────────────────────────────────────
            "payment_arrangement": None,   # no source in SQLite or Dentrix aging API
            "source_note": "Dentrix Ascend live API — guarantorPortionBalance",
            "_source":     "dentrix_ascend/live_agingbalances_report",
        }

        # Unapplied Amounts / Billing Review — super_admin only.
        # Preserve Dentrix sign in row data (negative = unapplied credit on account).
        # Not a refund indicator. Billing review required before any action.
        if _is_super_admin:
            _row["unapplied_amounts"] = round(_ua_raw, 2)
            _row["net_patient_balance_after_unapplied_amounts"] = round(_grp_bal + _ua_raw, 2)
            _row["unapplied_amounts_note"] = (
                "Unapplied Amounts / Billing Review: amounts not yet applied to treatment. "
                "Not an automatic refund indicator. Verify ledger posting and billing "
                "context before taking any action."
            )

        _all_rows.append(_row)

    # ── Filter ────────────────────────────────────────────────────────────────
    _filtered: list = []
    for _r in _all_rows:
        _grp = _r["patient_responsible_balance"]
        _ins = _r["insurance_portion_balance"]
        _ttl = _r["total_balance"]
        _ua  = _ua_lookup.get((_r["patient_id"], _r["location_id"]), 0.0)

        # balanceType filter
        if balanceType == "patient_responsible":
            if _grp <= 0:
                continue
        elif balanceType == "unapplied_review":
            # Already gated to super_admin above
            if _ua >= 0:
                continue
        elif balanceType == "all":
            if _is_super_admin:
                # Show all non-trivially-zero rows
                if _grp <= 0 and abs(_ttl) < 0.01 and abs(_ua) < 0.01:
                    continue
            else:
                # Non-super_admin: exclude unapplied-only rows (no patient or insurance balance)
                if _grp <= 0 and _ins <= 0:
                    continue

        # includeZeroBalances: for patient_responsible mode, skip rows with grp == 0
        if not includeZeroBalances and balanceType == "patient_responsible" and _grp <= 0:
            continue

        # minBalance
        if minBalance is not None and _grp < minBalance:
            continue

        # agingBucket
        if agingBucket and _r["aging_bucket"] != agingBucket:
            continue

        # search
        if search:
            _s_lower = search.lower()
            _searchable = " ".join(filter(None, [
                _r.get("patient_name", ""),
                _r.get("chart_number", ""),
                _r.get("patient_id", ""),
                _r.get("guarantor_name", ""),
            ])).lower()
            if _s_lower not in _searchable:
                continue

        _filtered.append(_r)

    # ── Scorecard (full filtered set — page-independent) ─────────────────────
    _sc_pr_rows   = [_r for _r in _filtered if _r["patient_responsible_balance"] > 0]
    _sc_any_rows  = [_r for _r in _filtered if abs(_r["total_balance"]) > 0.01]
    _sc_ins_rows  = [_r for _r in _filtered if _r["insurance_portion_balance"] > 0]
    _sc_ins_only  = [_r for _r in _filtered if _r["patient_responsible_balance"] <= 0 and _r["insurance_portion_balance"] > 0]
    _sc_cur       = [_r for _r in _filtered if _r["aging_bucket"] == "current"]
    _sc_30        = [_r for _r in _filtered if _r["aging_bucket"] == "b30"]
    _sc_60        = [_r for _r in _filtered if _r["aging_bucket"] == "b60"]
    _sc_90        = [_r for _r in _filtered if _r["aging_bucket"] == "b90"]
    _sc_30p       = _sc_30 + _sc_60 + _sc_90
    _sc_60p       = _sc_60 + _sc_90
    _HIGH         = 500.0
    _sc_high      = [_r for _r in _filtered if _r["patient_responsible_balance"] > _HIGH]

    def _sum_pr(_rows): return round(sum(_r["patient_responsible_balance"] for _r in _rows), 2)

    _total_pr  = _sum_pr(_sc_pr_rows)
    _total_ins = round(sum(_r["insurance_portion_balance"] for _r in _filtered), 2)
    _total_ttl = round(sum(_r["total_balance"]             for _r in _filtered), 2)
    _total_wo  = round(sum(_r["write_off_balance"]         for _r in _filtered), 2)
    _total_cp  = round(sum(_r["claims_pending"]            for _r in _filtered), 2)
    _avg_pr    = round(_total_pr / len(_sc_pr_rows), 2) if _sc_pr_rows else 0.0

    # Contact counts
    _mob_count     = sum(1 for _r in _filtered if _r.get("has_mobile_phone"))
    _email_count   = sum(1 for _r in _filtered if _r.get("has_email"))
    _no_ct_count   = sum(1 for _r in _filtered if not _r.get("has_mobile_phone") and not _r.get("has_email"))

    # By-office breakdown
    _by_office_acc: dict = {}
    for _r in _filtered:
        _oid = _r["office_id"]
        if _oid not in _by_office_acc:
            _by_office_acc[_oid] = {
                "office_id":                      _oid,
                "office_name":                    _r["office_name"],
                "location_id":                    _r["location_id"],
                "patient_count":                  0,
                "patient_responsible_balance":    0.0,
                "insurance_portion_balance":      0.0,
                "total_balance":                  0.0,
                "total_write_off_balance":        0.0,
                "total_claims_pending":           0.0,
                "patients_over_90_days":          0,
                "balance_over_90_days":           0.0,
                "high_balance_patients":          0,
                "patients_with_mobile":           0,
                "patients_with_email":            0,
                "patients_no_contact":            0,
                "patients_with_insurance_pending": 0,
            }
        _ob = _by_office_acc[_oid]
        _ob["patient_count"]                   += 1
        _ob["patient_responsible_balance"]      = round(_ob["patient_responsible_balance"]   + _r["patient_responsible_balance"], 2)
        _ob["insurance_portion_balance"]        = round(_ob["insurance_portion_balance"]     + _r["insurance_portion_balance"],   2)
        _ob["total_balance"]                    = round(_ob["total_balance"]                 + _r["total_balance"],               2)
        _ob["total_write_off_balance"]          = round(_ob["total_write_off_balance"]       + _r["write_off_balance"],           2)
        _ob["total_claims_pending"]             = round(_ob["total_claims_pending"]          + _r["claims_pending"],              2)
        if _r["aging_bucket"] == "b90":
            _ob["patients_over_90_days"]       += 1
            _ob["balance_over_90_days"]         = round(_ob["balance_over_90_days"] + _r["patient_responsible_balance"], 2)
        if _r["patient_responsible_balance"] > _HIGH:
            _ob["high_balance_patients"]       += 1
        if _r.get("has_mobile_phone"):   _ob["patients_with_mobile"] += 1
        if _r.get("has_email"):          _ob["patients_with_email"]  += 1
        if not _r.get("has_mobile_phone") and not _r.get("has_email"):
            _ob["patients_no_contact"] += 1
        if _r["insurance_portion_balance"] > 0:
            _ob["patients_with_insurance_pending"] += 1

    # Super-admin-only scorecard: unapplied amounts
    _sc_ua_total: Optional[float] = None
    _sc_ua_count: Optional[int]   = None
    _sc_net_after: Optional[float] = None
    _ua_by_office: Optional[list] = None

    if _is_super_admin:
        _ua_vals = [_ua_lookup.get((_r["patient_id"], _r["location_id"]), 0.0) for _r in _filtered]
        _ua_negatives = [_ua for _ua in _ua_vals if _ua < 0]
        _sc_ua_raw    = sum(_ua_negatives)
        _sc_ua_total  = round(abs(_sc_ua_raw), 2)   # positive absolute for scorecard display
        _sc_ua_count  = len(_ua_negatives)
        _sc_net_after = round(_total_pr + _sc_ua_raw, 2)

        _ua_off_acc: dict = {}
        for _r, _ua in zip(_filtered, _ua_vals):
            _oid = _r["office_id"]
            if _oid not in _ua_off_acc:
                _ua_off_acc[_oid] = {
                    "office_id":   _oid,
                    "office_name": _r["office_name"],
                    "patients_with_unapplied_amounts": 0,
                    "total_unapplied_amounts": 0.0,
                }
            if _ua < 0:
                _ua_off_acc[_oid]["patients_with_unapplied_amounts"] += 1
                _ua_off_acc[_oid]["total_unapplied_amounts"] = round(
                    _ua_off_acc[_oid]["total_unapplied_amounts"] + abs(_ua), 2
                )
        _ua_by_office = list(_ua_off_acc.values())

    _now_utc = datetime.now(timezone.utc)
    _total_elapsed = round(_time.time() - _t0, 2)

    _scorecard: dict = {
        # ── Patient counts ──────────────────────────────────────────────────
        "total_patients_with_patient_balance": len(_sc_pr_rows),
        "total_patients_with_any_balance":     len(_sc_any_rows),
        "total_patients_returned":             len(_filtered),
        # ── Balance totals ──────────────────────────────────────────────────
        "total_patient_responsible_balance":   _total_pr,
        "total_insurance_portion_balance":     _total_ins,
        "total_combined_balance":              _total_ttl,
        "total_write_off_balance":             _total_wo,
        "total_claims_pending":                _total_cp,
        # ── Aging ───────────────────────────────────────────────────────────
        "patients_current_0_30":  len(_sc_cur),
        "patients_over_30_days":  len(_sc_30p),
        "patients_over_60_days":  len(_sc_60p),
        "patients_over_90_days":  len(_sc_90),
        "balance_current_0_30":   _sum_pr(_sc_cur),
        "balance_over_30_days":   _sum_pr(_sc_30p),
        "balance_over_60_days":   _sum_pr(_sc_60p),
        "balance_over_90_days":   _sum_pr(_sc_90),
        # ── High balance ────────────────────────────────────────────────────
        "high_balance_patients":  len(_sc_high),
        "high_balance_total":     _sum_pr(_sc_high),
        "average_patient_balance": _avg_pr,
        # ── Insurance / Claims ───────────────────────────────────────────────
        "patients_with_insurance_pending": len(_sc_ins_rows),
        "patients_insurance_only":         len(_sc_ins_only),
        # ── Contact ──────────────────────────────────────────────────────────
        "patients_with_mobile": _mob_count,
        "patients_with_email":  _email_count,
        "patients_no_contact":  _no_ct_count,
        # ── Breakdowns ───────────────────────────────────────────────────────
        "by_office": list(_by_office_acc.values()),
        "by_aging_bucket": {
            "current": {"patient_count": len(_sc_cur), "patient_responsible_balance": _sum_pr(_sc_cur)},
            "b30":     {"patient_count": len(_sc_30),  "patient_responsible_balance": _sum_pr(_sc_30)},
            "b60":     {"patient_count": len(_sc_60),  "patient_responsible_balance": _sum_pr(_sc_60)},
            "b90":     {"patient_count": len(_sc_90),  "patient_responsible_balance": _sum_pr(_sc_90)},
        },
        # ── Unapplied Amounts / Billing Review (super_admin only) ───────────
        # Note: total shown as positive absolute dollars; row-level preserves Dentrix sign
        "total_patients_with_unapplied_amounts":      _sc_ua_count,   # None for non-super_admin
        "total_unapplied_amounts_for_billing_review": _sc_ua_total,   # None for non-super_admin
        "net_patient_balance_after_unapplied_amounts": _sc_net_after, # None for non-super_admin
        "unapplied_amounts_by_office":                _ua_by_office,  # None for non-super_admin
        # ── Unapplied access metadata ─────────────────────────────────────
        "unapplied_amounts_visible": _is_super_admin,
        "unapplied_amounts_access":  _unapplied_access,
        # ── Source freshness ──────────────────────────────────────────────
        "snapshot_timestamp":            _now_utc.isoformat(),
        "is_live_dentrix_pull":          True,
        "is_cached_snapshot":            _from_pb_cache,
        "balance_source_last_synced_at": _now_utc.isoformat(),
        "balance_source_last_synced_date": _today,
        "balance_source_freshness_note": (
            (
                f"Cached snapshot — original pull at "
                f"{__import__('datetime').datetime.fromtimestamp(_cached_pb['ts'], tz=__import__('datetime').timezone.utc).strftime('%Y-%m-%d %H:%M')} UTC. "
                f"Cache TTL: {_PB_CACHE_TTL // 60}min."
            ) if _from_pb_cache else (
                f"Live Dentrix API pull — data current as of "
                f"{_now_utc.strftime('%Y-%m-%d %H:%M')} UTC ({_total_elapsed}s)."
            )
        ),
    }

    # ── Sort: patient_responsible_balance DESC ────────────────────────────────
    _filtered.sort(key=lambda _r: _r["patient_responsible_balance"], reverse=True)

    # ── Real server-side pagination ───────────────────────────────────────────
    _total_count = len(_filtered)
    _total_pages = max(1, _math.ceil(_total_count / pageSize))
    _offset      = (page - 1) * pageSize
    _paged_data  = _filtered[_offset: _offset + pageSize]

    # ── Meta ──────────────────────────────────────────────────────────────────
    _meta: dict = {
        "total_count":   _total_count,
        "page":          page,
        "page_size":     pageSize,
        "total_pages":   _total_pages,
        "has_next_page": page < _total_pages,
        "has_prev_page": page > 1,
        "offset":        _offset,
        "asOfDate":      _as_of,
        "locationId":    _target_loc,
        "office_id":     LOCATION_TO_OFFICE.get(_target_loc) if _target_loc else None,
        "office_name":   (LOCATION_NAMES.get(_target_loc, "Unknown") if _target_loc else "All Offices"),
        "balanceType":   balanceType,
        "filters_applied": {
            "minBalance":              minBalance,
            "agingBucket":             agingBucket,
            "includeZeroBalances":     includeZeroBalances,
            "includeUnappliedAmounts": includeUnappliedAmounts,
            "search":                  search,
        },
        "unapplied_amounts_visible": _is_super_admin,
        "unapplied_amounts_access":  _unapplied_access,
        "dentrix_api_errors": _api_errors or None,
        "performance": {
            "dentrix_api_elapsed_s":         _dentrix_elapsed,
            "sqlite_enrich_elapsed_s":        _enrich_elapsed,
            "total_elapsed_s":               _total_elapsed,
            "patients_fetched_from_dentrix": len(_raw_pairs),
            "patients_after_filter":         _total_count,
        },
    }

    return {
        "data":      _paged_data,
        "scorecard": _scorecard,
        "meta":      _meta,
        "_source":   "dentrix_ascend/live_agingbalances_report",
    }


# ---------------------------------------------------------------------------
# /v2/rcm/payor-aging — Insurance AR aging (precomputed from Dentrix source of truth)
# ---------------------------------------------------------------------------
@app.get("/v2/rcm/payor-aging", tags=["RCM"])
@app.get("/v2/aging-receivables/by-payor", tags=["RCM"])
@app.get("/v2/rcm/aging-receivables-live", tags=["RCM"])
@app.get("/v2/aging-receivables/live", tags=["RCM"])
def rcm_payor_aging(
    asOfDate:    Optional[str] = Query(None, description="Report date (YYYY-MM-DD). Returns most recent snapshot ≤ this date."),
    locationId:  Optional[str] = Query(None, description="Filter by Dentrix location_id"),
    officeId:    Optional[str] = Query(None, description="Filter by office UUID (maps to location_id)"),
    reportType:  Optional[str] = Query("over_90", description="Report type: over_90 (default) or 91_365"),
):
    """
    Insurance AR aging from precomputed Dentrix Aged Receivables import.

    Source of truth: Dentrix Aged Receivables report imported via import_ar_aging.py.
    Reads from ar_aging_snapshots in Supabase — aggregate only, no PHI.

    Reconciliation: values match Dentrix exactly because they ARE Dentrix's values.
    reconciled=true means the import passed all validation checks at import time.

    To update: export Dentrix Aged Receivables (Over 90 format) → run import_ar_aging.py --seed <date>
    """
    import datetime, requests as _req

    # Resolve officeId → locationId
    if officeId and not locationId:
        locationId = OFFICE_TO_LOCATION.get(officeId)

    as_of = asOfDate or datetime.date.today().isoformat()
    rtype = reportType or "over_90"

    # --- Load Supabase config ---
    try:
        import json as _json
        with open("/home/openclaw/.config/supabase/nudental.json") as f:
            _sb = _json.load(f)
        sb_url  = _sb["project_url"] + "/rest/v1/ar_aging_snapshots"
        sb_hdrs = {
            "apikey":        _sb["secret_key"],
            "Authorization": "Bearer " + _sb["secret_key"],
        }
    except Exception as e:
        return {"error": f"Supabase config unavailable: {e}",
                "hint": "Run import_ar_aging.py --seed 2026-05-01 to populate data"}

    # --- Fetch latest snapshot ≤ asOfDate ---
    try:
        resp = _req.get(
            sb_url,
            headers=sb_hdrs,
            params={
                # Return most recent snapshot on or before asOfDate.
                # If none found (e.g. asOfDate < first snapshot), fall back to
                # the absolute most recent snapshot available.
                "report_type":  f"eq.{rtype}",
                "order":        "report_as_of.desc",
                "select":       "*",
            },
            timeout=15,
        )
        if resp.status_code == 404 or (resp.status_code == 200 and "ar_aging_snapshots" in resp.text and "not found" in resp.text.lower()):
            return {
                "error": "Table ar_aging_snapshots not found in Supabase.",
                "action_required": "Run the migration SQL in Supabase SQL Editor, then run: python3 import_ar_aging.py --seed 2026-05-01",
                "migration_sql_path": "/home/openclaw/.openclaw/workspace/ascend_api/middleware/ar_aging_migration.sql",
            }
        rows = resp.json() if resp.status_code == 200 else []
        if isinstance(rows, dict) and rows.get("code"):  # PostgREST error
            return {
                "error":    f"Supabase error: {rows.get('message', rows)}",
                "action_required": "Run migration SQL in Supabase SQL Editor, then seed data.",
            }
    except Exception as e:
        return {"error": f"Supabase fetch failed: {e}"}

    if not rows:
        return {
            "error":       "No AR aging data found.",
            "asOfDate":    as_of,
            "reportType":  rtype,
            "action_required": (
                "Import Dentrix Aged Receivables data: "
                "python3 /home/openclaw/.openclaw/workspace/ascend_api/middleware/import_ar_aging.py --seed 2026-05-01"
            ),
        }

    # --- Find the latest report_as_of in the fetched rows ---
    available_dates = sorted(set(r["report_as_of"] for r in rows), reverse=True)
    latest_date     = available_dates[0]
    snapshot_rows   = [r for r in rows if r["report_as_of"] == latest_date]

    pt_rows  = [r for r in snapshot_rows if r["row_type"] == "practice_total"]
    off_rows = [r for r in snapshot_rows if r["row_type"] == "office_total"]
    pay_rows = [r for r in snapshot_rows if r["row_type"] == "payor_row"]

    if not pt_rows:
        return {"error": "practice_total row missing from snapshot", "snapshot_date": latest_date}

    pt = pt_rows[0]

    def _f(v): return float(v) if v is not None else None
    def _r(v): return round(float(v), 2) if v is not None else None

    # --- Build office rollup (filter by locationId if requested) ---
    office_list = []
    for r in sorted(off_rows, key=lambda x: x.get("office_name") or ""):
        if locationId and r.get("location_id") != locationId:
            continue
        ins_ar = _r(r["insurance_portion"]) or (
            _r(r["bucket_0_30"] or 0) + _r(r["bucket_31_60"] or 0) +
            _r(r["bucket_61_90"] or 0) + _r(r["bucket_over_90"] or 0)
        )
        office_list.append({
            "locationId":          r.get("location_id"),
            "officeName":          r.get("office_name"),
            "insuranceAR":         _r(r["insurance_portion"]),
            "insuranceARCurrent":  _r(r["bucket_0_30"]),
            "insuranceAR31_60":    _r(r["bucket_31_60"]),
            "insuranceAR61_90":    _r(r["bucket_61_90"]),
            "insuranceAROver90":   _r(r["bucket_over_90"]),
            # Full AR fields (may be null if not in this report)
            "totalBalanceBeforeCredits": _r(r.get("total_balance_before_credits")),
            "unappliedCredits":          _r(r.get("unapplied_credits")),
            "netBalanceAfterCredits":    _r(r.get("net_balance_after_credits")),
            "guarantorPortion":          _r(r.get("guarantor_portion")),
            "estimatedWriteOff":         _r(r.get("estimated_writeoff")),
            # Payor breakdown status
            "payorBreakdown":    "available" if any(p.get("location_id") == r.get("location_id") for p in pay_rows) else "payor_mapping_required",
            "sourceNote":        r.get("source_note"),
            "importedAt":        r.get("imported_at"),
        })

    # --- Payor detail rows (if available) ---
    payor_list = []
    for r in sorted(pay_rows, key=lambda x: -(float(x.get("insurance_portion") or 0))):
        if locationId and r.get("location_id") != locationId:
            continue
        payor_list.append({
            "locationId":         r.get("location_id"),
            "officeName":         r.get("office_name"),
            "payorName":          r.get("payor_name") or "Payor mapping required",
            "payorId":            r.get("payor_id"),
            "insuranceAR":        _r(r["insurance_portion"]),
            "insuranceARCurrent": _r(r["bucket_0_30"]),
            "insuranceAR31_60":   _r(r["bucket_31_60"]),
            "insuranceAR61_90":   _r(r["bucket_61_90"]),
            "insuranceAROver90":  _r(r["bucket_over_90"]),
        })

    # --- Reconciliation metadata ---
    calc_total = round(sum(float(o["insuranceAR"] or 0) for o in office_list), 2)
    benchmark  = _r(pt["insurance_portion"])
    variance   = round(calc_total - (benchmark or 0), 2)

    # Determine automation status from source_note
    src_note_str = pt.get("source_note") or ""
    is_email_automated = "email_import" in src_note_str or "auto-imported from email" in src_note_str
    is_seed = "Provided by Dr. G" in src_note_str or "seed" in (pt.get("source_file") or "").lower()
    automated_source = "dentrix_aged_receivables_email_import" if is_email_automated else (
        "dentrix_aged_receivables_seed" if is_seed else "dentrix_aged_receivables_precomputed"
    )

    return {
        "asOfDate":        as_of,
        "snapshotDate":    latest_date,
        "reportType":      rtype,
        "source":          automated_source,
        "sourceNote":      src_note_str,
        "importedAt":      pt.get("imported_at"),
        "lastSyncedAt":    pt.get("imported_at"),
        "importedBy":      pt.get("imported_by"),
        "automated":       is_email_automated,
        "fallbackRequired": not is_email_automated,
        "automationNote":  (
            "✅ Automated — data imported from Dentrix emailed report. No manual export needed."
            if is_email_automated else
            __NUDASHBOARD_CONFIG_LITERAL_026__
        ),

        # --- Insurance AR (PayorsTab) ---
        "officeRollup":    office_list,
        "payorDetail":     payor_list if payor_list else [
            {"note": "Payor breakdown not available in this report. Office-level AR is exact. Re-import with payor detail when Dentrix provides carrier-level export."}
        ],

        # --- Full AR (Claims/AR tab) ---
        "fullAR": {
            "totalBalanceBeforeCredits": _r(pt.get("total_balance_before_credits")),
            "unappliedCredits":          _r(pt.get("unapplied_credits")),
            "netBalanceAfterCredits":    _r(pt.get("net_balance_after_credits")),
            "guarantorPortion":          _r(pt.get("guarantor_portion")),
            "insurancePortion":          _r(pt.get("insurance_portion")),
            "estimatedWriteOff":         _r(pt.get("estimated_writeoff")),
        },

        # --- Aging bucket totals (insurance only) ---
        "agingBuckets": {
            "b_0_30":    _r(pt["bucket_0_30"]),
            "b_31_60":   _r(pt["bucket_31_60"]),
            "b_61_90":   _r(pt["bucket_61_90"]),
            "b_over_90": _r(pt["bucket_over_90"]),
            "total":     _r(pt["insurance_portion"]),
        },

        # --- Reconciliation ---
        "reconciliation": {
            "benchmark_total_insurance_ar":   benchmark,
            "calculated_total_insurance_ar":  calc_total,
            "variance":                       variance,
            "reconciled":                     abs(variance) < 0.02 and pt.get("reconciled", False),
            "reconciled_at_import":           pt.get("reconciled"),
            "reconciliation_note":            pt.get("reconciliation_note"),
        },

        # --- Available snapshots ---
        "availableSnapshots": available_dates[:10],
    }
    import sqlite3 as _sq3
    import datetime

    # Benchmark: Dentrix Aged Receivables "Over 90" report as of 2026-05-01 7:06 PM
    # This is the source-of-truth for PayorsTab reconciliation (no upper age cap).
    DENTRIX_BENCHMARKS = __NUDASHBOARD_CONFIG_LITERAL_027__
    DENTRIX_FULL_AR = __NUDASHBOARD_CONFIG_LITERAL_028__

    as_of = asOfDate or datetime.date.today().isoformat()
    try:
        as_of_dt = datetime.date.fromisoformat(as_of)
    except ValueError:
        return {"error": f"Invalid asOfDate: {as_of}. Use YYYY-MM-DD."}

    # Resolve officeId → locationId
    if officeId and not locationId:
        locationId = OFFICE_TO_LOCATION.get(officeId)

    conn = _sq3.connect(RCM_DB_PATH)
    conn.row_factory = _sq3.Row
    try:
        # --- Step 1: All active, outstanding insurance claims ---
        # Outstanding = not PAYRECVD, DELETED, or VOID
        loc_filter = ""
        loc_params: list = []
        if locationId:
            loc_filter = "AND ic.location_id = ?"
            loc_params.append(str(locationId))

        # No upper age cap: Dentrix "Over 90" report includes all history.
        claims = conn.execute(f"""
            SELECT
                ic.id                                              AS claim_id,
                ic.location_id,
                COALESCE(
                    json_extract(ic.raw, '$.payorName'), 'Unknown Payor'
                )                                                  AS payor_name,
                COALESCE(
                    json_extract(ic.raw, '$.payorId'), ''
                )                                                  AS payor_id,
                COALESCE(
                    json_extract(ic.raw, '$.groupPlanName'), ''
                )                                                  AS plan_name,
                CAST(COALESCE(
                    json_extract(ic.raw, '$.totalCharges'), 0
                ) AS REAL)                                         AS total_charges,
                json_extract(ic.raw, '$.serviceDate')              AS service_date,
                json_extract(ic.raw, '$.claimState')               AS claim_state
            FROM insurance_claims ic
            WHERE ic.is_active = 1
            AND json_extract(ic.raw, '$.claimState')
                NOT IN ('PAYRECVD','DELETED','VOID','PRINTED_PAYRECVD')
            AND json_extract(ic.raw, '$.serviceDate') IS NOT NULL
            {loc_filter}
        """, loc_params).fetchall()

        if not claims:
            # Return empty but structured
            return {
                "asOfDate":   as_of,
                "source":     "dentrix_ascend/insurance_claims",
                "methodology": "claim_gross_minus_payments",
                "reconciliationNote": "No outstanding claims found for the specified criteria.",
                "officeRollup": [],
                "payorDetail": [],
                "totals": {
                    "claimCount": 0, "grossBilled": 0,
                    "insurancePaid": 0, "netOutstanding": 0,
                    "b_0_30": 0, "b_31_60": 0, "b_61_90": 0, "b_over_90": 0,
                },
                "dentrixBenchmark": {
                    "asOf": "2026-05-01 19:06 ET",
                    "reportType": "Over 90 (no upper age cap)",
                    "insurancePortion": 206844.58,
                    "fullAR": DENTRIX_FULL_AR,
                    "offices": DENTRIX_BENCHMARKS,
                    "agingBuckets": __NUDASHBOARD_CONFIG_LITERAL_029__,
                },
            }

        claim_ids = [r["claim_id"] for r in claims]

        # --- Step 2: Insurance payments received per claim ---
        # Batch the query (SQLite IN clause)
        placeholders = ",".join("?" * len(claim_ids))
        paid_rows = conn.execute(f"""
            SELECT
                json_extract(ip.raw, '$.insuranceClaim.id') AS claim_id,
                SUM(ABS(ip.amount))                         AS ins_paid
            FROM insurance_payments ip
            WHERE ip.is_active = 1
            AND ip.ledger_type = 'InsurancePayment'
            AND json_extract(ip.raw, '$.insuranceClaim.id') IN ({placeholders})
            GROUP BY json_extract(ip.raw, '$.insuranceClaim.id')
        """, claim_ids).fetchall()

        paid_by_claim = {r["claim_id"]: float(r["ins_paid"] or 0) for r in paid_rows}

        # --- Step 3: Compute per-claim net outstanding and aging ---
        # Accumulate into (location_id, payor_name, payor_id) buckets
        from collections import defaultdict
        buckets: dict = defaultdict(lambda: {
            "claim_count": 0, "gross_billed": 0.0, "ins_paid": 0.0,
            "net_outstanding": 0.0,
            "b_0_30": 0.0, "b_31_60": 0.0, "b_61_90": 0.0, "b_over_90": 0.0,
        })

        for r in claims:
            charges    = float(r["total_charges"] or 0)
            paid       = paid_by_claim.get(r["claim_id"], 0.0)
            net        = max(charges - paid, 0.0)
            if net < 0.01:
                continue  # skip effectively zero-balance claims

            try:
                svc_dt = datetime.date.fromisoformat(r["service_date"])
                days   = (as_of_dt - svc_dt).days
            except Exception:
                days = 0

            if   days <= 30:  bucket_key = "b_0_30"
            elif days <= 60:  bucket_key = "b_31_60"
            elif days <= 90:  bucket_key = "b_61_90"
            else:             bucket_key = "b_over_90"

            loc   = r["location_id"] or "Unknown"
            payor = r["payor_name"]  or "Unknown Payor"
            pid   = r["payor_id"]    or ""
            key   = (loc, payor, pid)

            b = buckets[key]
            b["claim_count"]     += 1
            b["gross_billed"]    += charges
            b["ins_paid"]        += paid
            b["net_outstanding"] += net
            b[bucket_key]        += net

        # --- Step 4: Build output structures ---
        # Payor-detail rows
        payor_detail = []
        office_rollup: dict = defaultdict(lambda: {
            "claimCount": 0, "grossBilled": 0.0, "insurancePaid": 0.0,
            "netOutstanding": 0.0,
            "b_0_30": 0.0, "b_31_60": 0.0, "b_61_90": 0.0, "b_over_90": 0.0,
        })

        for (loc, payor, pid), b in sorted(
            buckets.items(), key=lambda x: (-x[1]["net_outstanding"],)
        ):
            office_name = LOCATION_NAMES.get(loc, "Unknown")
            row = {
                "locationId":         loc,
                "officeName":         office_name,
                "payorName":          payor,
                "payorId":            pid or None,
                "claimCount":         b["claim_count"],
                "grossBilled":        round(b["gross_billed"], 2),
                "insurancePaid":      round(b["ins_paid"], 2),
                "netOutstanding":     round(b["net_outstanding"], 2),
                "insuranceARCurrent": round(b["b_0_30"], 2),
                "insuranceAR31_60":   round(b["b_31_60"], 2),
                "insuranceAR61_90":   round(b["b_61_90"], 2),
                "insuranceAROver90":  round(b["b_over_90"], 2),
                "unappliedCredits":   None,
                "estimatedWriteOff":  None,
                "sourceNote": (
                    "Claim gross-billed minus insurance payments received. "
                    "Does not deduct contractual write-offs or patient portions."
                ),
            }
            payor_detail.append(row)

            # Roll up to office
            of = office_rollup[loc]
            of["officeName"]     = office_name
            of["locationId"]     = loc
            of["claimCount"]    += b["claim_count"]
            of["grossBilled"]   += b["gross_billed"]
            of["insurancePaid"] += b["ins_paid"]
            of["netOutstanding"]+= b["net_outstanding"]
            of["b_0_30"]        += b["b_0_30"]
            of["b_31_60"]       += b["b_31_60"]
            of["b_61_90"]       += b["b_61_90"]
            of["b_over_90"]     += b["b_over_90"]

        # Finalize office rollup — attach Dentrix benchmarks
        office_rollup_list = []
        for loc, of in sorted(office_rollup.items()):
            bench = DENTRIX_BENCHMARKS.get(loc, {})
            net   = round(of["netOutstanding"], 2)
            dnet  = bench.get("dentrixInsuranceAR", None)
            office_rollup_list.append({
                "locationId":          loc,
                "officeName":          of["officeName"],
                "claimCount":          of["claimCount"],
                "grossBilled":         round(of["grossBilled"], 2),
                "insurancePaid":       round(of["insurancePaid"], 2),
                "netOutstanding":      net,
                "insuranceARCurrent":  round(of["b_0_30"], 2),
                "insuranceAR31_60":    round(of["b_31_60"], 2),
                "insuranceAR61_90":    round(of["b_61_90"], 2),
                "insuranceAROver90":   round(of["b_over_90"], 2),
                "dentrixBenchmark":    dnet,
                "varianceFromDentrix": round(net - dnet, 2) if dnet is not None else None,
                "reconciliationStatus": (
                    "⚠ Unreconciled — contractual write-offs and patient portions "
                    "are included in netOutstanding but excluded by Dentrix's Insurance Portion."
                ),
            })

        # Grand totals
        total_gross = sum(r["grossBilled"] for r in office_rollup_list)
        total_paid  = sum(r["insurancePaid"] for r in office_rollup_list)
        total_net   = sum(r["netOutstanding"] for r in office_rollup_list)
        total_0_30  = sum(r["insuranceARCurrent"] for r in office_rollup_list)
        total_31_60 = sum(r["insuranceAR31_60"] for r in office_rollup_list)
        total_61_90 = sum(r["insuranceAR61_90"] for r in office_rollup_list)
        total_over90 = sum(r["insuranceAROver90"] for r in office_rollup_list)

        return {
            "asOfDate":    as_of,
            "source":      "dentrix_ascend/insurance_claims",
            "methodology": "claim_gross_minus_insurance_payments_received",
            "reconciliationNote": (
                "netOutstanding = totalCharges (UCR/billed) on active outstanding claims "
                "minus insurance payments received. No upper age cap (matches Dentrix 'Over 90' report). "
                "Dentrix 'Insurance Portion' = estimated benefit per procedure minus posted payments. "
                "Reconciling items: (1) contractual write-offs (network fee adjustments), "
                "(2) patient responsibility portions (copay/deductible). "
                "To close the gap: tag PatientCreditAdjustment entries as contractual vs. discretionary "
                "in the sync layer, then net them against claim totalCharges."
            ),
            "officeRollup": office_rollup_list,
            "payorDetail":  payor_detail,
            "totals": {
                "claimCount":     sum(r["claimCount"] for r in office_rollup_list),
                "grossBilled":    round(total_gross, 2),
                "insurancePaid":  round(total_paid, 2),
                "netOutstanding": round(total_net, 2),
                "b_0_30":         round(total_0_30, 2),
                "b_31_60":        round(total_31_60, 2),
                "b_61_90":        round(total_61_90, 2),
                "b_over_90":      round(total_over90, 2),
            },
            "dentrixBenchmark": {
                "source":          "Dentrix Aged Receivables (Over 90) as of 2026-05-01 19:06 ET",
                "reportType":      "Over 90 — no upper age cap",
                "insurancePortion": 206844.58,
                "fullAR":          DENTRIX_FULL_AR,
                "offices": {
                    loc: {
                        "officeName":  v["officeName"],
                        "insuranceAR": v["dentrixInsuranceAR"],
                    }
                    for loc, v in DENTRIX_BENCHMARKS.items()
                },
                "agingBuckets": __NUDASHBOARD_CONFIG_LITERAL_030__,
            },
        }

    finally:
        conn.close()


# ---------------------------------------------------------------------------
# /v2/rcm/contact-attempts — Phase 1C manual contact attempt log
# ---------------------------------------------------------------------------
VALID_CONTACT_METHODS = {"PHONE_CALL", "VOICEMAIL", "EMAIL_MANUAL", "STATEMENT_DENTRIX", "COPY_PHONE", "COPY_EMAIL", "OTHER"}
VALID_CONTACT_OUTCOMES = {"REACHED", "VOICEMAIL_LEFT", "NO_ANSWER", "WRONG_NUMBER", "WRONG_EMAIL", "PAID", "RESOLVED", "FOLLOW_UP_NEEDED", "NOTE_ONLY"}


def _sb_rest(method: str, path: str, body: dict | None = None, headers_extra: dict | None = None) -> tuple:
    """Minimal Supabase REST helper. Returns (status_code, parsed_json).
    Uses service_role key for full access through RLS.
    """
    import urllib.request as urlreq
    cfg = _load_supabase_config()
    url = f"{cfg['project_url']}/rest/v1/{path}"
    hdrs = {
        "apikey": cfg["secret_key"],
        "Authorization": f"Bearer {cfg['secret_key']}",
        "Content-Type": "application/json",
        "Accept": "application/json",
        "Prefer": "return=representation",
    }
    if headers_extra:
        hdrs.update(headers_extra)
    data = json.dumps(body).encode() if body else None
    req = urlreq.Request(url, data=data, headers=hdrs, method=method)
    try:
        with urlreq.urlopen(req) as r:
            return r.status, json.loads(r.read())
    except urlreq.HTTPError as e:
        err_body = e.read().decode()
        try:
            err_json = json.loads(err_body)
            # Strip any internal details that might contain secrets
            msg = err_json.get("message", "Database error")
        except Exception:
            msg = "Database error"
        return e.code, {"error": msg}


@app.post("/v2/rcm/contact-attempts", tags=["RCM"], dependencies=[Depends(verify_api_key)])
async def create_contact_attempt(request: Request):
    """Create one manual contact attempt log entry."""
    body = await request.json()

    # Validate required fields
    patient_id = body.get("patient_id")
    contact_method = body.get("contact_method")
    contact_outcome = body.get("contact_outcome")

    if not patient_id:
        raise HTTPException(400, "patient_id is required")
    if not contact_method:
        raise HTTPException(400, "contact_method is required")
    if not contact_outcome:
        raise HTTPException(400, "contact_outcome is required")
    if contact_method not in VALID_CONTACT_METHODS:
        raise HTTPException(400, f"Invalid contact_method '{contact_method}'. Allowed: {sorted(VALID_CONTACT_METHODS)}")
    if contact_outcome not in VALID_CONTACT_OUTCOMES:
        raise HTTPException(400, f"Invalid contact_outcome '{contact_outcome}'. Allowed: {sorted(VALID_CONTACT_OUTCOMES)}")

    row = {
        "patient_id": patient_id,
        "chart_number": body.get("chart_number"),
        "location_id": body.get("location_id"),
        "office_name": body.get("office_name"),
        "balance_at_contact": body.get("balance_at_contact"),
        "contact_method": contact_method,
        "contact_outcome": contact_outcome,
        "contact_note": body.get("contact_note"),
        "contacted_at": body.get("contacted_at"),  # None → DB default now()
        "contacted_by": body.get("contacted_by"),   # TODO: populate from authenticated user when RBAC is ready
        "contacted_by_name": body.get("contacted_by_name"),  # TODO: populate from authenticated user when RBAC is ready
        "next_followup_date": body.get("next_followup_date"),
        "is_resolved": body.get("is_resolved", False),
        "source_tab": body.get("source_tab", "patient_balances"),
        "source_action": body.get("source_action"),
    }
    # Remove None values so DB defaults apply
    row = {k: v for k, v in row.items() if v is not None}

    status, result = _sb_rest("POST", "patient_contact_attempts", row)
    if status >= 400:
        raise HTTPException(status, result.get("error", "Failed to create contact attempt"))

    created = result[0] if isinstance(result, list) and result else result
    return {"success": True, "id": created.get("id"), "row": created}


@app.get("/v2/rcm/contact-attempts", tags=["RCM"], dependencies=[Depends(verify_api_key)])
async def list_contact_attempts(
    patient_id: str = Query(..., description="Dentrix patient ID"),
    location_id: Optional[str] = Query(None),
    limit: int = Query(50, ge=1, le=500),
    include_resolved: bool = Query(True),
):
    """List contact attempts for a patient, sorted by contacted_at DESC."""
    path = f"patient_contact_attempts?patient_id=eq.{patient_id}&order=contacted_at.desc&limit={limit}"
    if location_id:
        path += f"&location_id=eq.{location_id}"
    if not include_resolved:
        path += "&is_resolved=eq.false"

    status, result = _sb_rest("GET", path)
    if status >= 400:
        raise HTTPException(status, result.get("error", "Failed to list contact attempts"))
    return result


@app.get("/v2/rcm/contact-attempts/summary", tags=["RCM"], dependencies=[Depends(verify_api_key)])
async def contact_attempts_summary(
    location_id: Optional[str] = Query(None),
    start_date: Optional[str] = Query(None, description="Filter contacted_at >= this date"),
    end_date: Optional[str] = Query(None, description="Filter contacted_at <= this date"),
    include_resolved: bool = Query(True),
):
    """Latest contact attempt summary per patient for frontend merge.

    Returns one row per patient_id with the most recent attempt info
    plus total attempt count. Designed to be merged client-side with
    ar-aging data — NOT joined server-side.
    """
    # Fetch all attempts matching filters, ordered by contacted_at DESC
    path = "patient_contact_attempts?order=contacted_at.desc"
    if location_id:
        path += f"&location_id=eq.{location_id}"
    if start_date:
        path += f"&contacted_at=gte.{start_date}"
    if end_date:
        path += f"&contacted_at=lte.{end_date}"
    if not include_resolved:
        path += "&is_resolved=eq.false"

    status, result = _sb_rest("GET", path)
    if status >= 400:
        raise HTTPException(status, result.get("error", "Failed to fetch contact attempts"))

    # Group by patient_id, take latest per patient
    summary = {}
    for row in result:
        pid = row["patient_id"]
        if pid not in summary:
            summary[pid] = {
                "patient_id": pid,
                "location_id": row.get("location_id"),
                "last_contacted_at": row["contacted_at"],
                "last_contact_method": row["contact_method"],
                "last_contact_outcome": row["contact_outcome"],
                "last_contact_note": row.get("contact_note"),
                "contacted_by": row.get("contacted_by"),
                "contacted_by_name": row.get("contacted_by_name"),
                "next_followup_date": row.get("next_followup_date"),
                "is_resolved": row.get("is_resolved"),
                "attempt_count": 0,
            }
        summary[pid]["attempt_count"] += 1

    return list(summary.values())


@app.patch("/v2/rcm/contact-attempts/{attempt_id}", tags=["RCM"], dependencies=[Depends(verify_api_key)])
async def update_contact_attempt(attempt_id: str, request: Request):
    """Update an existing contact attempt (outcome, note, followup, resolved)."""
    body = await request.json()

    allowed_fields = {"contact_outcome", "contact_note", "next_followup_date", "is_resolved"}
    update = {}
    for field in allowed_fields:
        if field in body:
            update[field] = body[field]

    if not update:
        raise HTTPException(400, f"No updatable fields provided. Allowed: {sorted(allowed_fields)}")

    if "contact_outcome" in update and update["contact_outcome"] not in VALID_CONTACT_OUTCOMES:
        raise HTTPException(400, f"Invalid contact_outcome '{update['contact_outcome']}'. Allowed: {sorted(VALID_CONTACT_OUTCOMES)}")

    update["updated_at"] = datetime.now(timezone.utc).isoformat()

    status, result = _sb_rest("PATCH", f"patient_contact_attempts?id=eq.{attempt_id}", update)
    if status >= 400:
        raise HTTPException(status, result.get("error", "Failed to update contact attempt"))

    if isinstance(result, list) and len(result) == 0:
        raise HTTPException(404, f"Contact attempt {attempt_id} not found")

    updated = result[0] if isinstance(result, list) and result else result
    return {"success": True, "row": updated}


# ---------------------------------------------------------------------------
# /v2/rcm/dentrix-statements — Phase 1D Dentrix statement history (read-only)
# Reads from HS1 GET /v1/patientstatements. No sends, no writes to Dentrix.
# ---------------------------------------------------------------------------

DENTRIX_STATEMENTS_CREDS_FILE = "/home/openclaw/.config/ascend/production.json"
_dentrix_stmt_token_cache: dict = {"token": None, "expires_at": 0}

def _dentrix_stmt_get_token():
    """Get/refresh HS1 OAuth token for statement reads."""
    import requests as _req
    now = time.time()
    if _dentrix_stmt_token_cache["token"] and _dentrix_stmt_token_cache["expires_at"] > now + 60:
        return _dentrix_stmt_token_cache["token"], json.load(open(DENTRIX_STATEMENTS_CREDS_FILE))
    creds = json.load(open(DENTRIX_STATEMENTS_CREDS_FILE))
    resp = _req.post(creds["oauth_url"],
                     data={"client_id": creds["api_key"], "client_secret": creds["secret"]},
                     timeout=15)
    resp.raise_for_status()
    data = resp.json()
    _dentrix_stmt_token_cache["token"] = data["access_token"]
    _dentrix_stmt_token_cache["expires_at"] = now + int(data.get("expires_in", 1800))
    return _dentrix_stmt_token_cache["token"], creds


def _dentrix_stmt_fetch(filter_parts: list, page: int = 1, page_size: int = 100) -> dict:
    """GET /v1/patientstatements with filter. Returns raw HS1 JSON. Read-only."""
    import requests as _req
    token, creds = _dentrix_stmt_get_token()
    headers = {
        "Authorization": f"Bearer {token}",
        "Organization-ID": creds["org_id"],
        "Accept": "application/json",
    }
    params: dict = {"responseFields": "ALL", "pageSize": str(min(page_size, 500))}
    if filter_parts:
        params["filter"] = ",".join(filter_parts)
    if page > 1:
        params["page"] = str(page)
    resp = _req.get(f"{creds['api_base']}/v1/patientstatements",
                    headers=headers, params=params, timeout=30)
    resp.raise_for_status()
    return resp.json()


def _normalize_statement(raw: dict) -> dict:
    """Normalize a single HS1 patientstatement row to our schema."""
    return {
        "dentrix_statement_id": str(raw.get("id", "")),
        "patient_id":           str((raw.get("patient") or {}).get("id", "")),
        "location_id":          str((raw.get("location") or {}).get("id", "")),
        "statement_type":       raw.get("statementType"),      # GUARANTOR | PATIENT
        "delivery_method":      raw.get("deliveryMethod"),      # PRINT | ELECTRONIC | ...
        "generated_date":       raw.get("generatedDate"),
        "last_modified":        raw.get("lastModified"),
        "patient_portion":      raw.get("patientPortion"),      # Primary outreach amount
        "please_pay":           raw.get("pleasePay"),            # Primary outreach amount
        "total_balance":        raw.get("totalBalance"),         # Reference only — NOT for outreach
        "document_id":          str((raw.get("document") or {}).get("id", "")),
        "source":               "dentrix_patientstatements",
    }


@app.get("/v2/rcm/dentrix-statements", tags=["RCM"], dependencies=[Depends(verify_api_key)])
async def list_dentrix_statements(
    patient_id: Optional[str] = Query(None, description="Dentrix patient ID"),
    location_id: Optional[str] = Query(None, description="Dentrix location ID"),
    start_date: Optional[str] = Query(None, description="Filter generatedDate >= (YYYY-MM-DD)"),
    end_date: Optional[str] = Query(None, description="Filter generatedDate <= (YYYY-MM-DD)"),
    page: int = Query(1, ge=1),
    page_size: int = Query(100, ge=1, le=500),
):
    """Return Dentrix statement history rows from GET /v1/patientstatements.
    READ-ONLY. Does NOT trigger any sends.
    Primary outreach amounts: patient_portion and please_pay (patient-responsible only).
    total_balance is included as reference only — NOT for patient outreach.

    Note: HS1 /v1/patientstatements only supports filters on patient.id, id, and
    lastModified. location_id filtering is done client-side after fetch.
    """
    filters = []
    if patient_id:
        filters.append(f"patient.id=={patient_id}")
    if start_date:
        filters.append(f"lastModified>={start_date}")
    if end_date:
        filters.append(f"lastModified<={end_date}")

    try:
        raw = _dentrix_stmt_fetch(filters, page=page, page_size=page_size)
    except Exception as exc:
        raise HTTPException(502, f"Dentrix API error: {exc}")

    rows = [_normalize_statement(r) for r in raw.get("data", [])]

    # Client-side location filter (not supported by HS1 API)
    if location_id:
        rows = [r for r in rows if r["location_id"] == location_id]

    meta = raw.get("meta", {})
    pagination = meta.get("pagination", {})

    return {
        "statements": rows,
        "count": len(rows),
        "page": page,
        "page_size": page_size,
        "total": pagination.get("total"),
        "source": "dentrix_patientstatements",
        "_note": "patient_portion and please_pay are patient-responsible amounts for outreach. total_balance is reference only.",
    }


@app.get("/v2/rcm/dentrix-statements/summary", tags=["RCM"], dependencies=[Depends(verify_api_key)])
async def dentrix_statements_summary(
    location_id: Optional[str] = Query(None, description="Dentrix location ID"),
    start_date: Optional[str] = Query(None, description="Filter generatedDate >= (YYYY-MM-DD)"),
    end_date: Optional[str] = Query(None, description="Filter generatedDate <= (YYYY-MM-DD)"),
    page_size: int = Query(500, ge=1, le=500, description="Fetch size per HS1 page"),
):
    """Statement summary per patient+location for frontend merge into Patient Balances.
    Iterates all HS1 pages (up to 10 pages / 5000 statements) and groups.
    READ-ONLY. Does NOT trigger any sends.

    Note: HS1 only supports filters on patient.id, id, lastModified.
    location_id filtering is done client-side after fetch.
    """
    filters = []
    if start_date:
        filters.append(f"lastModified>={start_date}")
    if end_date:
        filters.append(f"lastModified<={end_date}")

    all_rows: list[dict] = []
    max_pages = 10  # Safety cap: 10 pages × 500 = 5000 statements max
    current_page = 1

    try:
        while current_page <= max_pages:
            raw = _dentrix_stmt_fetch(filters, page=current_page, page_size=page_size)
            data = raw.get("data", [])
            if not data:
                break
            all_rows.extend(data)
            # If we got fewer than page_size, that's the last page
            if len(data) < page_size:
                break
            current_page += 1
    except Exception as exc:
        raise HTTPException(502, f"Dentrix API error: {exc}")

    # Client-side location filter (not supported by HS1 API)
    if location_id:
        all_rows = [r for r in all_rows if str((r.get("location") or {}).get("id", "")) == location_id]

    # Group by (patient_id, location_id), most recent first
    from collections import defaultdict
    groups: dict[tuple, list] = defaultdict(list)
    for r in all_rows:
        pid = str((r.get("patient") or {}).get("id", ""))
        lid = str((r.get("location") or {}).get("id", ""))
        groups[(pid, lid)].append(r)

    summaries = []
    for (pid, lid), stmts in groups.items():
        # Sort by generatedDate descending
        stmts.sort(key=lambda x: x.get("generatedDate", ""), reverse=True)
        latest = stmts[0]
        delivery_methods = sorted(set(s.get("deliveryMethod") or "UNKNOWN" for s in stmts))
        summaries.append({
            "patient_id":                   pid,
            "location_id":                  lid,
            "dentrix_statement_count":      len(stmts),
            "dentrix_last_statement_date":  latest.get("generatedDate"),
            "dentrix_last_delivery_method": latest.get("deliveryMethod"),
            "dentrix_last_statement_type":  latest.get("statementType"),
            "dentrix_last_patient_portion": latest.get("patientPortion"),
            "dentrix_last_please_pay":      latest.get("pleasePay"),
            "dentrix_delivery_methods":     delivery_methods,
            "dentrix_statement_ids":        [str(s.get("id", "")) for s in stmts],
            "dentrix_document_ids":         [str((s.get("document") or {}).get("id", "")) for s in stmts],
            "source":                       "dentrix_patientstatements",
        })

    return {
        "summaries": summaries,
        "patient_count": len(summaries),
        "total_statements": len(all_rows),
        "pages_fetched": current_page,
        "source": "dentrix_patientstatements",
        "_note": "dentrix_last_patient_portion and dentrix_last_please_pay are patient-responsible amounts. Do NOT use total_balance for outreach.",
    }


@app.get("/v2/rcm/patient-balance-outreach-summary", tags=["RCM"], dependencies=[Depends(verify_api_key)])
def patient_balance_outreach_summary(
    location_id: Optional[str] = Query(None, description="Dentrix location ID"),
    start_date: Optional[str] = Query(None, description="Filter date range start (YYYY-MM-DD)"),
    end_date: Optional[str] = Query(None, description="Filter date range end (YYYY-MM-DD)"),
):
    """Combined outreach summary: Dentrix statement history + Nu Dashboard contact attempts.
    One row per patient_id + location_id merging both sources.
    READ-ONLY. Does NOT trigger any sends.
    """
    # --- Dentrix statements side ---
    dentrix_map: dict[str, dict] = {}
    try:
        filters = []
        if start_date:
            filters.append(f"lastModified>={start_date}")
        if end_date:
            filters.append(f"lastModified<={end_date}")

        all_stmts: list[dict] = []
        current_page = 1
        while current_page <= 10:
            raw = _dentrix_stmt_fetch(filters, page=current_page, page_size=500)
            data = raw.get("data", [])
            if not data:
                break
            all_stmts.extend(data)
            if len(data) < 500:
                break
            current_page += 1

        # Client-side location filter
        if location_id:
            all_stmts = [r for r in all_stmts if str((r.get("location") or {}).get("id", "")) == location_id]

        from collections import defaultdict
        grp: dict[str, list] = defaultdict(list)
        for r in all_stmts:
            pid = str((r.get("patient") or {}).get("id", ""))
            grp[pid].append(r)

        for pid, stmts in grp.items():
            stmts.sort(key=lambda x: x.get("generatedDate", ""), reverse=True)
            latest = stmts[0]
            dentrix_map[pid] = {
                "dentrix_statement_count":      len(stmts),
                "dentrix_last_statement_date":  latest.get("generatedDate"),
                "dentrix_last_delivery_method": latest.get("deliveryMethod"),
                "dentrix_last_patient_portion": latest.get("patientPortion"),
                "dentrix_last_please_pay":      latest.get("pleasePay"),
            }
    except Exception:
        # Non-fatal — we still return dashboard data if Dentrix fails
        pass

    # --- Nu Dashboard contact attempts side ---
    dashboard_map: dict[str, dict] = {}
    try:
        path = "patient_contact_attempts?order=contacted_at.desc"
        if location_id:
            path += f"&location_id=eq.{location_id}"
        if start_date:
            path += f"&contacted_at=gte.{start_date}"
        if end_date:
            path += f"&contacted_at=lte.{end_date}"

        status, result = _sb_rest("GET", path)
        if status < 400 and isinstance(result, list):
            for row in result:
                pid = row.get("patient_id", "")
                if pid and pid not in dashboard_map:
                    dashboard_map[pid] = {
                        "dashboard_attempt_count": 0,
                        "dashboard_last_contacted_at": row.get("contacted_at"),
                        "dashboard_last_contact_method": row.get("contact_method"),
                        "dashboard_last_contact_outcome": row.get("contact_outcome"),
                        "dashboard_contacted_by_name": row.get("contacted_by_name"),
                        "dashboard_next_followup_date": row.get("next_followup_date"),
                        "dashboard_is_resolved": row.get("is_resolved"),
                    }
                if pid:
                    dashboard_map[pid]["dashboard_attempt_count"] = dashboard_map[pid].get("dashboard_attempt_count", 0) + 1
    except Exception:
        pass

    # --- Merge ---
    all_pids = set(list(dentrix_map.keys()) + list(dashboard_map.keys()))
    merged = []
    for pid in sorted(all_pids):
        row = {
            "patient_id": pid,
            "location_id": location_id,
        }
        dx = dentrix_map.get(pid, {})
        da = dashboard_map.get(pid, {})
        row.update(dx)
        row.update(da)

        # Compute combined total
        row["total_outreach_count"] = dx.get("dentrix_statement_count", 0) + da.get("dashboard_attempt_count", 0)

        # Determine last contact across both sources
        dx_date = dx.get("dentrix_last_statement_date", "")
        da_date = da.get("dashboard_last_contacted_at", "")
        if dx_date and da_date:
            row["last_outreach_date"] = max(dx_date, da_date)
            row["last_outreach_source"] = "dentrix" if dx_date >= da_date else "dashboard"
        elif dx_date:
            row["last_outreach_date"] = dx_date
            row["last_outreach_source"] = "dentrix"
        elif da_date:
            row["last_outreach_date"] = da_date
            row["last_outreach_source"] = "dashboard"
        else:
            row["last_outreach_date"] = None
            row["last_outreach_source"] = None

        merged.append(row)

    return {
        "patients": merged,
        "patient_count": len(merged),
        "dentrix_patients": len(dentrix_map),
        "dashboard_patients": len(dashboard_map),
        "source": "dentrix_patientstatements + patient_contact_attempts",
        "_note": "dentrix_last_patient_portion and dentrix_last_please_pay are patient-responsible amounts only. Never use total_balance for outreach.",
    }


@app.get("/v2/rcm/dashboard", tags=["RCM"])
def rcm_dashboard(
    startDate: Optional[str] = Query(None), start: Optional[str] = Query(None),
    endDate:   Optional[str] = Query(None), end:   Optional[str] = Query(None),
    locationId: Optional[str] = Query(None), officeId: Optional[str] = Query(None),
):
    """RCM KPI dashboard — aggregated from all RCM data sources."""
    s = startDate or start or "2026-01-01"
    e = endDate   or end   or "2099-12-31"
    conn = rcm_db()
    try:
        where, params = rcm_filter_clause(s, e, location_id=locationId, office_id=officeId)

        # Claims submitted + paid
        ins = conn.execute(f"""
            SELECT location_id,
                   COUNT(*) as total_claims,
                   SUM(CASE WHEN is_active=1 THEN 1 ELSE 0 END) as paid_claims,
                   SUM(CASE WHEN is_active=1 THEN ABS(amount) ELSE 0 END) as total_collected
            FROM insurance_payments
            WHERE {where}
            AND ledger_type = 'InsurancePayment'
            GROUP BY location_id
        """, params).fetchall()

        # Patient payments
        pat = conn.execute(f"""
            SELECT location_id,
                   COUNT(*) as total_payments,
                   SUM(CASE WHEN is_active=1 AND amount<0 THEN ABS(amount) ELSE 0 END) as total_patient_collected
            FROM patient_payments
            WHERE {where}
            AND ledger_type = 'PatientProcedurePayment'
            GROUP BY location_id
        """, params).fetchall()

        # POS
        pos = conn.execute(f"""
            SELECT location_id,
                   COUNT(*) as pos_count,
                   SUM(ABS(amount)) as pos_total
            FROM patient_payments
            WHERE {where}
            AND json_extract(raw, '$.paidAtVisit') = 1
            AND is_active=1 AND amount < 0
            GROUP BY location_id
        """, params).fetchall()

        # Refunds
        ref = conn.execute(f"""
            SELECT SUM(amount) as total_refunds
            FROM adjustments
            WHERE {where}
            AND ledger_type = 'InsuranceRefundAdjustment'
            AND amount > 0
            AND is_active = 1
        """, params).fetchone()

        # Totals
        total_submitted  = sum(r["total_claims"] for r in ins)
        total_paid       = sum(r["paid_claims"] for r in ins)
        total_ins_collected = sum(r["total_collected"] for r in ins)
        total_pat_collected = sum(r["total_patient_collected"] for r in pat)
        total_collected  = total_ins_collected + total_pat_collected
        total_refunds    = float(ref["total_refunds"] or 0) if ref else 0
        outstanding_ar   = None  # Not computable from payments alone — use /v2/rcm/ar-aging for actual AR

        # By office breakdown
        by_office = []
        for loc_id, name in LOCATION_NAMES.items():
            office_uuid = LOCATION_TO_OFFICE.get(loc_id)
            ins_r = next((r for r in ins if r["location_id"] == loc_id), None)
            pat_r = next((r for r in pat if r["location_id"] == loc_id), None)
            pos_r = next((r for r in pos if r["location_id"] == loc_id), None)
            by_office.append({
                "office_id":  office_uuid,
                "office":     name,
                "submitted":  ins_r["total_claims"] if ins_r else 0,
                "paid":       ins_r["paid_claims"] if ins_r else 0,
                "billed":     float(ins_r["total_collected"] if ins_r else 0),
                "collected":  float((ins_r["total_collected"] if ins_r else 0) +
                                    (pat_r["total_patient_collected"] if pat_r else 0)),
                "pos_total":  float(pos_r["pos_total"] if pos_r else 0),
            })

        return {
            "totalClaimsSubmitted": total_submitted,
            "totalClaimsPaid":      total_paid,
            "totalOutstandingAR":   outstanding_ar,
            "totalOutstandingARNote": "unavailable — use /v2/rcm/ar-aging for actual AR",
            "totalCollected":       round(total_collected, 2),
            "totalRefunds":         round(total_refunds, 2),
            "claimsPaidRate":       round((total_paid / total_submitted * 100) if total_submitted else 0, 1),
            "claimsPaidRateLabel":  "Claims Paid ÷ Billed",
            "dateRange":            f"{s} – {e}",
            "byOffice":             by_office,
            "_source":              "dentrix_ascend_sqlite",
        }
    finally:
        conn.close()



