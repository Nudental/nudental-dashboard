@app.get("/v2/reports/kpi-summary", tags=["Reports"], dependencies=[Depends(verify_api_key)])
def kpi_summary(year: Optional[int] = Query(None)):
    """YTD KPI summary for the Reports page cards: revenue, collections, expenses, net profit."""
    import datetime
    try:
        svc = get_service()
        now = datetime.date.today()
        yr = year or now.year
        start = f"{yr}-01-01"
        end = now.isoformat() if yr == now.year else f"{yr}-12-31"

        prod = svc.get_production_summary(start, end)
        coll = svc.get_collections_summary(start, end)

        # Expenses from Supabase via REST (paginated to handle >1000 rows)
        total_expenses = 0.0
        try:
            import requests as _req
            sb_url = "https://siwtadgdqtvxoztnxzhx.supabase.co/rest/v1/expenses"
            sb_key = __NUDASHBOARD_CONFIG_LITERAL_016__
            offset = 0
            while True:
                resp = _req.get(
                    f"{sb_url}?select=amount&expense_date=gte.{start}&expense_date=lte.{end}&limit=1000&offset={offset}",
                    headers={"apikey": sb_key, "Authorization": f"Bearer {sb_key}"},
                    timeout=10,
                )
                if resp.status_code != 200:
                    break
                batch = resp.json()
                if not batch:
                    break
                total_expenses += sum(float(r.get("amount", 0) or 0) for r in batch)
                if len(batch) < 1000:
                    break
                offset += 1000
        except Exception as ex:
            logger.warning(f"Could not fetch expenses for KPI: {ex}")

        gross_prod = prod.get("grossProduction", 0) or 0
        net_prod = prod.get("netProduction", 0) or 0
        total_coll = coll.get("totalCollections", 0) or 0
        net_profit = total_coll - total_expenses

        # Issue 4 fix: per-office collection rate breakdown
        # Fetches production + collections per office and computes individual collection rates.
        # Field name: officeCollectionRates — array of {office, locationId, grossProduction,
        # collections, collectionRate} for each active office.
        office_collection_rates = []
        _office_location_map = {
            "14000000000432": "Staten Island",
            "14000000000433": "Eatontown",
            "14000000000434": "Barnegat",
            "14000000000435": "Brick",
        }
        try:
            for _loc_id, _office_name in _office_location_map.items():
                _oprod = svc.get_production_summary(start, end, _loc_id)
                _ocoll = svc.get_collections_summary(start, end, _loc_id)
                _ogross = float(_oprod.get("grossProduction", 0) or 0)
                _ocoll_total = float(_ocoll.get("totalCollections", 0) or 0)
                _orate = round(_ocoll_total / _ogross * 100, 1) if _ogross > 0 else None
                office_collection_rates.append({
                    "office": _office_name,
                    "locationId": _loc_id,
                    "grossProduction": round(_ogross, 2),
                    "collections": round(_ocoll_total, 2),
                    "collectionRate": _orate,
                })
        except Exception as _oex:
            logger.warning(f"Could not build per-office collection rates for KPI: {_oex}")

        return {
            "year": yr,
            "startDate": start,
            "endDate": end,
            "totalRevenue": round(gross_prod, 2),
            "netProduction": round(net_prod, 2),
            "totalCollections": round(total_coll, 2),
            "totalExpenses": round(total_expenses, 2),
            "netProfit": round(net_profit, 2),
            "collectionRate": round(total_coll / gross_prod * 100, 1) if gross_prod else 0,
            "officeCollectionRates": office_collection_rates,
        }
    except Exception as e:
        logger.exception("Error fetching KPI summary")
        raise HTTPException(status_code=500, detail=str(e))


