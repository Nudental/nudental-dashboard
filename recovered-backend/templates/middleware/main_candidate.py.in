# Supabase UUID → Dentrix Location ID mapping
OFFICE_UUID_TO_LOCATION_ID = __NUDASHBOARD_CONFIG_LITERAL_008__

def resolve_location_id(officeId: Optional[str] = None, locationId: Optional[str] = None) -> Optional[str]:
    """Accept either Supabase UUID (officeId) or Dentrix locationId — return Dentrix location ID."""
    val = officeId or locationId
    if not val:
        return None
    return OFFICE_UUID_TO_LOCATION_ID.get(val, val)

