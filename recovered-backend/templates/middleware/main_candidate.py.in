    except Exception as e:
        raise HTTPException(500, str(e))


# --- Gusto Status Route ---

@app.get("/v2/gusto/status", tags=["Gusto"], dependencies=[Depends(verify_api_key)])
def gusto_status():
    """Gusto Status — mirrors live sync-status dashboard."""
    from datetime import datetime as _dt, timezone as _tz
    try:
        # Query sync log for most recent Gusto import
        rows = _sb_get(
            "sync_log?select=id,import_type,status,completed_at,error_message,meta"
            "&import_type=like.gusto_*&order=completed_at.desc&limit=50"
        )
        now = _dt.now(_tz.utc)
        checked_at = now.isoformat()

        # Find last successful sync
        last_success = None
        consecutive_failures = 0
        last_attempt = None
        for r in rows:
            if last_attempt is None:
                last_attempt = r
            if r.get("status") == "completed" or r.get("status") == "success":
                if last_success is None:
                    last_success = r
                break
            else:
                consecutive_failures += 1

        if last_success:
            last_data_date = (last_success.get("completed_at") or "")[:10]
            try:
                days_since = (now - _dt.fromisoformat(last_success["completed_at"].replace("Z", "+00:00"))).days
            except Exception:
                days_since = None
            status_label = f"Current — last data {last_data_date}" if days_since is not None and days_since <= 7 else f"Stale — last data {last_data_date}"
            status = "ok" if days_since is not None and days_since <= 7 else "stale"
        else:
            last_data_date = None
            days_since = None
            status_label = "No successful sync found"
            status = "error"

        # Format last_sync_attempt to match live schema
        last_sync = None
        if last_attempt:
            meta = last_attempt.get("meta") or {}
            if isinstance(meta, str):
                import json as _j2
                try:
                    meta = _j2.loads(meta)
                except Exception:
                    meta = {}
            last_sync = {
                "id": last_attempt.get("id"),
                "import_type": last_attempt.get("import_type"),
                "status": "completed" if last_attempt.get("status") in ("completed", "success") else last_attempt.get("status"),
                "completed_at": last_attempt.get("completed_at"),
                "error": last_attempt.get("error_message"),
                "range_end": meta.get("range_end"),
            }

        action_required = status != "ok"
        action_message = None
        if status == "stale" and days_since:
            action_message = f"No Gusto data for {days_since} days. Check Gusto connection."

        return {
            "status": status,
            "status_label": status_label,
            "last_data_date": last_data_date,
            "days_since_last_data": days_since,
            "consecutive_failures": consecutive_failures,
            "last_sync_attempt": last_sync,
            "action_required": action_required,
            "action_message": action_message,
            "checked_at": checked_at,
        }
    except Exception as e:
        logger.error(f"gusto_status error: {e}")
        return {
            "status": "error",
            "status_label": f"Error: {e}",
            "last_data_date": None,
            "days_since_last_data": None,
            "consecutive_failures": 0,
            "last_sync_attempt": None,
            "action_required": True,
            "action_message": str(e),
            "checked_at": _dt.now(_tz.utc).isoformat(),
        }


# --- Admin Sync Dashboard Route ---

@app.get("/v2/admin/sync-dashboard", tags=["Admin"], dependencies=[Depends(verify_api_key)])
def admin_sync_dashboard():
    """Read current job instrumentation and endpoint reachability without executing jobs."""
    import requests

    def read_status_rows(table, fields, key_field):
        cfg = _load_supabase_config()
        response = requests.get(
            cfg['project_url'].rstrip('/') + '/rest/v1/' + table,
            params={'select': fields, 'order': key_field, 'limit': 500},
            headers={'apikey': cfg['secret_key'], 'Authorization': 'Bearer ' + cfg['secret_key'], 'Prefer': 'count=exact'},
            timeout=20,
        )
        if response.status_code not in (200, 206):
            raise ValueError('Status source is unavailable')
        rows = response.json()
        total = response.headers.get('content-range', '').rsplit('/', 1)[-1]
        if not isinstance(rows, list) or not total.isdigit() or int(total) != len(rows) or len(rows) > 500:
            raise ValueError('Status source returned incomplete results')
        keys = [row.get(key_field) for row in rows if isinstance(row, dict)]
        if len(keys) != len(rows) or any(not key for key in keys) or len(set(keys)) != len(keys):
            raise ValueError('Status source returned invalid rows')
        return rows

    try:
        raw_jobs = read_status_rows(
            'sync_job_latest',
            'job_key,job_name,source_system,job_trigger_type,schedule_description,is_manual_only,'
            'detail_log_table,notes,last_status,last_started_at,last_completed_at,last_duration_ms,'
            'last_rows_read,last_rows_inserted,last_rows_updated,last_rows_failed,freshness_status,effective_status',
            'job_key',
        )
        jobs = []
        for row in raw_jobs:
            status = row.get('effective_status') or row.get('last_status') or 'unknown'
            jobs.append({
                'job_key': row['job_key'],
                'job_name': row.get('job_name') or row['job_key'],
                'source_system': row.get('source_system'),
                'trigger_type': row.get('job_trigger_type'),
                'schedule_description': row.get('schedule_description'),
                'is_manual_only': bool(row.get('is_manual_only')),
                'status': status,
                'freshness_status': row.get('freshness_status') or 'unknown',
                'last_started_at': row.get('last_started_at'),
                'last_completed_at': row.get('last_completed_at'),
                'last_success_at': row.get('last_completed_at') if row.get('last_status') in ('success', 'completed') else None,
                'last_failure_at': row.get('last_completed_at') if row.get('last_status') in ('failed', 'error') else None,
                'duration_ms': row.get('last_duration_ms'),
                'avg_duration_ms': row.get('last_duration_ms'),
                'rows_processed': row.get('last_rows_read'),
                'rows_read': row.get('last_rows_read'),
                'rows_inserted': row.get('last_rows_inserted'),
                'rows_updated': row.get('last_rows_updated'),
                'rows_failed': row.get('last_rows_failed'),
                'log_source': row.get('detail_log_table') or ('sync_job_runs' if row.get('last_started_at') else None),
                'notes': row.get('notes'),
            })
        summary = {
            'jobs_total': len(jobs),
            'jobs_with_reliable_last_run': sum(bool(j['last_completed_at']) for j in jobs),
            'jobs_awaiting_first_run': sum(j['status'] == 'awaiting_first_run' for j in jobs),
            'jobs_manual_only': sum(j['is_manual_only'] for j in jobs),
            'jobs_not_instrumented': sum(j['status'] == 'not_instrumented' for j in jobs),
            'jobs_healthy': sum(j['status'] in ('success', 'completed') and j['freshness_status'] == 'fresh' for j in jobs),
            'jobs_stale': sum(j['freshness_status'] == 'stale' for j in jobs),
            'jobs_failed': sum(j['status'] in ('failed', 'error') for j in jobs),
            'jobs_running': sum(j['status'] == 'running' for j in jobs),
            'last_successful_run': max((j['last_success_at'] for j in jobs if j['last_success_at']), default=None),
        }
        api_health = read_status_rows(
            'api_endpoint_registry',
            'endpoint_key,description,health_status,is_active,last_tested_at,last_success_at,last_error_at,last_error_message,notes',
            'endpoint_key',
        )
        return {
            'summary': summary,
            'jobs': jobs,
            'api_endpoint_health': api_health,
            # The UI already reads the existing data_sync_logs history separately.
            'legacy_sync_logs': [],
            'generated_at': datetime.now(timezone.utc).isoformat(),
        }
    except Exception:
        raise HTTPException(502, 'Sync status sources could not be read completely. Please retry.') from None


# --- RCM AR Location Health ---

@app.get("/v2/rcm/ar-location-health", tags=["RCM"], dependencies=[Depends(verify_api_key)])
def rcm_ar_location_health():
    """AR Location Health — mirrors live location sync check dashboard."""
    try:
        from ar_snapshot import get_location_health
        locations = get_location_health()
        now_str = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        alerts = []
        for loc in locations:
            if loc.get("check_status") not in ("ok", None):
                alerts.append({
                    "location_id": loc.get("location_id"),
                    "location_name": loc.get("location_name"),
                    "check_status": loc.get("check_status"),
                    "error_message": loc.get("error_message"),
                })
        total_ar = sum(loc.get("total_ar") or 0 for loc in locations)
        health_note = (
            f"{len(locations)} locations checked. "
            f"Total outstanding AR: ${total_ar:,.2f}. "
            f"{len(alerts)} alert(s)."
        )
        return {
            "as_of": now_str,
            "locations": locations,
            "alert_count": len(alerts),
            "alerts": alerts,
            "health_note": health_note,
            "source": "ar_location_sync_checks / ar_snapshot.py",
        }
    except ImportError:
        # Fallback: query Supabase directly
        try:
            rows = _sb_get_full(
                "ar_aging_snapshots?select=office_name,snapshot_date,total_ar,"
                "over_90_ar,over_60_ar,over_30_ar&order=snapshot_date.desc&limit=20"
            )
            return {
                "as_of": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                "locations": rows,
                "alert_count": 0,
                "alerts": [],
                "health_note": "Using Supabase fallback — ar_snapshot module not available.",
                "source": "supabase_fallback",
            }
        except Exception as e2:
            raise HTTPException(500, str(e2))
    except Exception as e:
        logger.error(f"rcm_ar_location_health error: {e}")
        raise HTTPException(500, str(e))


# --- MCP (Model Context Protocol) Proxy Routes ---

_MCP_AUTH_CODES: dict = {}  # in-memory auth code store

@app.get("/.well-known/oauth-authorization-server")
def oauth_metadata():
    """Oauth Metadata"""
    return {
        "issuer": "https://api.nudashboard.com",
        "authorization_endpoint": "https://api.nudashboard.com/mcp-auth/authorize",
        "token_endpoint": "https://api.nudashboard.com/mcp-auth/token",
        "token_endpoint_auth_methods_supported": ["none", "client_secret_post"],
        "response_types_supported": ["code"],
        "grant_types_supported": ["authorization_code", "refresh_token"],
        "scopes_supported": ["mcp"],
        "code_challenge_methods_supported": ["S256", "plain"],
    }

@app.get("/mcp/.well-known/oauth-authorization-server")
def oauth_metadata_mcp():
    """Oauth Metadata"""
    return oauth_metadata()

@app.get("/mcp/.well-known/oauth-protected-resource")
def mcp_protected_resource_metadata():
    """Mcp Protected Resource Metadata"""
    return {
        "resource": "https://api.nudashboard.com/mcp",
        "authorization_servers": ["https://api.nudashboard.com"],
        "bearer_methods_supported": ["header"],
        "scopes_supported": ["mcp"],
    }

@app.get("/mcp-auth/authorize")
def mcp_oauth_authorize(
    response_type: str = Query("code"),
    client_id: str = Query(""),
    redirect_uri: str = Query(""),
    state: str = Query(""),
    scope: str = Query(""),
    code_challenge: str = Query(""),
    code_challenge_method: str = Query(""),
):
    """Mcp Oauth Authorize"""
    import secrets as _secrets
    code = _secrets.token_urlsafe(32)
    _MCP_AUTH_CODES[code] = {
        "client_id": client_id,
        "redirect_uri": redirect_uri,
        "code_challenge": code_challenge,
        "code_challenge_method": code_challenge_method,
        "scope": scope,
        "created_at": time.time(),
    }
    # Auto-approve: redirect back with code
    sep = "&" if "?" in redirect_uri else "?"
    redirect_url = f"{redirect_uri}{sep}code={code}"
    if state:
        redirect_url += f"&state={state}"
    from fastapi.responses import RedirectResponse
    return RedirectResponse(url=redirect_url, status_code=302)

@app.post("/mcp-auth/token")
async def mcp_oauth_token(request: Request):
    """Mcp Oauth Token"""
    body = await request.form()
    grant_type = body.get("grant_type")
    code = body.get("code")
    
    if grant_type == "authorization_code" and code:
        stored = _MCP_AUTH_CODES.pop(code, None)
        if not stored:
            raise HTTPException(400, "invalid_grant")
        # Generate a simple bearer token
        import secrets as _secrets, hashlib as _hl
        token = _secrets.token_urlsafe(48)
        return {
            "access_token": token,
            "token_type": "bearer",
            "expires_in": 86400,
            "scope": stored.get("scope", ""),
        }
    raise HTTPException(400, "unsupported_grant_type")

@app.api_route("/mcp", methods=["GET", "POST", "OPTIONS"], tags=["MCP"])
@app.api_route("/mcp/{path:path}", methods=["GET", "POST", "OPTIONS"], tags=["MCP"])
async def mcp_proxy(request: Request, path: str = ""):
    """Mcp Proxy"""
    # MCP server proxy — forwards to local MCP server if running
    if request.method == "OPTIONS":
        return FastAPIResponse(
            content="",
            headers={
                "Access-Control-Allow-Origin": "*",
                "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
                "Access-Control-Allow-Headers": "Authorization, Content-Type, Accept",
            },
        )
    
    # Proxy to local MCP server (default port 3100)
    mcp_port = int(os.environ.get("MCP_SERVER_PORT", "5222"))
    target = f"http://127.0.0.1:{mcp_port}"
    if path:
        target += f"/{path}"
    
    try:
        import httpx
        async with httpx.AsyncClient(timeout=30) as client:
            if request.method == "POST":
                body = await request.body()
                resp = await client.post(
                    target,
                    content=body,
                    headers={
                        "Content-Type": request.headers.get("Content-Type", "application/json"),
                        "Authorization": request.headers.get("Authorization", ""),
                    },
                )
            else:
                resp = await client.get(
                    target,
                    headers={"Authorization": request.headers.get("Authorization", "")},
                )
        return FastAPIResponse(
            content=resp.content,
            status_code=resp.status_code,
            headers={
                "Content-Type": resp.headers.get("Content-Type", "application/json"),
                "Access-Control-Allow-Origin": "*",
            },
        )
    except Exception as e:
        return {"error": f"MCP server not available: {e}", "target": target}
