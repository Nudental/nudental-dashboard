@app.post("/oauth2/token", tags=["Auth"])
def issue_token(
    client_id: str = Body(..., embed=True),
    client_secret: str = Body(..., embed=True),
):
    """Issue internal JWT for nudashboard frontend clients."""
    if client_secret != NUDASHBOARD_API_KEY:
        raise HTTPException(status_code=401, detail="Invalid credentials")

    try:
        import jwt
    except ImportError:
        import base64, hmac, hashlib
        header = base64.urlsafe_b64encode(b'{"alg":"HS256","typ":"JWT"}').rstrip(b"=").decode()
        now = int(time.time())
        payload_dict = {"sub": client_id, "iat": now, "exp": now + 3600}
        payload = base64.urlsafe_b64encode(json.dumps(payload_dict).encode()).rstrip(b"=").decode()
        sig = base64.urlsafe_b64encode(
            hmac.new(JWT_SECRET.encode(), f"{header}.{payload}".encode(), hashlib.sha256).digest()
        ).rstrip(b"=").decode()
        return {"access_token": f"{header}.{payload}.{sig}", "token_type": "Bearer", "expires_in": 3600}

    now = datetime.now(timezone.utc)
    payload = {"sub": client_id, "iat": now, "exp": now + timedelta(hours=1), "iss": "nudashboard-middleware"}
    token = jwt.encode(payload, JWT_SECRET, algorithm="HS256")
    return {"access_token": token, "token_type": "Bearer", "expires_in": 3600}


# ---------------------------------------------------------------------------
# SSE Streaming endpoint
# ---------------------------------------------------------------------------

@app.get("/v2/stream", tags=["Streaming"])
async def stream_events(
    request: Request,
    x_api_key: Optional[str] = Header(None),
    lastEventId: Optional[str] = Query(None, description="Resume from this event ID"),
):
    """
    Server-Sent Events stream of real-time Dentrix data changes.
    Connect with EventSource JS API:
        const es = new EventSource('/v2/stream', {headers: {'X-API-Key': '...'}})
        es.addEventListener('appointment.Updated', e => console.log(JSON.parse(e.data)))
    """
    if x_api_key != NUDASHBOARD_API_KEY:
        raise HTTPException(status_code=401, detail="Invalid or missing API key")

    # Determine starting event ID
    start_id = 0
    if lastEventId:
        try:
            start_id = int(lastEventId)
        except ValueError:
            start_id = 0

    async def event_generator() -> AsyncGenerator:
        last_id = start_id if start_id > 0 else get_latest_event_id()

        # Send initial connected event
        yield {
            "event": "connected",
            "id": "0",
            "data": json.dumps({
                "message": "NuDashboard real-time stream connected",
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "resumeFromId": last_id,
            }),
        }

        # Send a heartbeat every 25s to keep connection alive (SSE timeout prevention)
        last_heartbeat = time.time()

        while True:
            if await request.is_disconnected():
                logger.info("SSE client disconnected")
                break

            # Poll for new events
            try:
                events = await asyncio.get_event_loop().run_in_executor(
                    None, lambda: get_recent_events(since_id=last_id, limit=20)
                )

                for evt in events:
                    last_id = evt["id"]
                    yield {
                        "event": evt["event_type"],
                        "id": str(evt["id"]),
                        "data": evt["payload"],
                    }

            except Exception as e:
                logger.warning(f"SSE poll error: {e}")

            # Heartbeat
            if time.time() - last_heartbeat > 25:
                yield {
                    "event": "heartbeat",
                    "data": json.dumps({"ts": time.time()}),
                }
                last_heartbeat = time.time()

            await asyncio.sleep(0.5)  # Poll every 500ms for near-real-time

    return EventSourceResponse(event_generator())


