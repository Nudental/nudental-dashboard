# ── Provider Compensation / Payroll Reports ────────────────────────────────────
@app.get("/v2/reports/provider-compensation", tags=["Reports"], dependencies=[Depends(verify_api_key)])
def provider_compensation_report(
    request: Request,
    startDate: str = Query(..., description="Pay period start (YYYY-MM-DD)"),
    endDate:   str = Query(..., description="Pay period end (YYYY-MM-DD)"),
    providerId: Optional[str] = Query(None, description="Single provider ID (omit for all)"),
    format: str = Query("zip", description="Output format: zip | html | pdf"),
    userEmail: str = Query(..., description="Authenticated user email — payroll access check"),
):
    """
    Generate provider compensation reports for a pay period.
    Restricted to PAYROLL_ALLOWED_EMAILS. Returns a ZIP (all providers, PDF+HTML each),
    or single provider HTML/PDF. Handles split-month periods with correct tier rates.
    """
    from api_compensation_policy import verified_compensation_actor
    from api_identity import AccessFailure
    try:
        verified_compensation_actor(request, PAYROLL_ALLOWED_EMAILS)
    except AccessFailure as error:
        raise HTTPException(status_code=error.status, detail="Payroll report access denied for this user.") from None
    import tempfile, os
    from fastapi.responses import FileResponse, HTMLResponse, Response as FastAPIResponse
    try:
        from payroll_report import build_html, generate_all_reports, _get_providers, _collections_by_date
    except ImportError as e:
        raise HTTPException(status_code=500, detail=f"payroll_report module error: {e}")

    if format == "zip" and not providerId:
        # All providers — return ZIP
        out_dir = tempfile.mkdtemp(prefix="nudental_payroll_")
        zip_path = generate_all_reports(startDate, endDate, out_dir)
        fname = os.path.basename(zip_path)
        return FileResponse(zip_path, media_type="application/zip",
                            headers={"Content-Disposition": f'attachment; filename="{fname}"'})

    # Single provider
    if not providerId:
        raise HTTPException(status_code=400, detail="providerId required when format != zip")

    providers = {p["id"]: p for p in _get_providers()}
    if providerId not in providers:
        # Provider may be inactive in Dentrix but still has collections — look up directly
        import sqlite3 as _sl2
        _db2 = "/home/openclaw/.openclaw/workspace/ascend_api/middleware/ascend.db"
        _c2 = _sl2.connect(_db2)
        _row = _c2.execute("""
            SELECT id,
                   TRIM(COALESCE(first_name,'') || ' ' || COALESCE(last_name,'')) AS name,
                   COALESCE(NULLIF(JSON_EXTRACT(raw,'$.title'),''), NULLIF(JSON_EXTRACT(raw,'$.specialty'),''),'') AS specialty
            FROM providers WHERE id = ?
        """, (providerId,)).fetchone()
        _c2.close()
        if _row:
            providers[providerId] = {"id": _row[0], "name": _row[1], "specialty": _row[2]}
        else:
            raise HTTPException(status_code=404, detail=f"Provider {providerId} not found")

    p = providers[providerId]
    html, coll, comp = build_html(p["id"], p["name"], p["specialty"], startDate, endDate)

    if format == "html":
        return HTMLResponse(content=html)

    if format == "pdf":
        import subprocess, tempfile as tf
        with tf.NamedTemporaryFile(suffix=".html", delete=False) as hf:
            hf.write(html.encode())
            hf.flush()
            pdf_path = hf.name.replace(".html", ".pdf")
            subprocess.run(["/home/linuxbrew/.linuxbrew/bin/weasyprint", hf.name, pdf_path], check=True, capture_output=True, timeout=30)
        safe = p["name"].replace(" ","_")
        fname = f"{safe}_PayrollReport_{startDate}_to_{endDate}.pdf"
        return FileResponse(pdf_path, media_type="application/pdf",
                            headers={"Content-Disposition": f'attachment; filename="{fname}"'})

    return {"providerId": providerId, "providerName": p["name"],
            "startDate": startDate, "endDate": endDate,
            "totalCollections": coll, "estimatedCompensation": comp}

# ── Send payroll reports directly to each provider via email ─────────────────
@app.post("/v2/reports/provider-compensation/send", tags=["Reports"], dependencies=[Depends(verify_api_key)])
def send_provider_compensation_reports(
    request: Request,
    startDate:  str = Query(...),
    endDate:    str = Query(...),
    userEmail:  str = Query(..., description="Must be a payroll-allowed email"),
    dryRun:     bool = Query(False, description="Preview without sending"),
):
    __NUDASHBOARD_CONFIG_LITERAL_017__
    from api_compensation_policy import verified_compensation_actor
    from api_identity import AccessFailure
    try:
        verified_compensation_actor(request, PAYROLL_ALLOWED_EMAILS)
    except AccessFailure as error:
        raise HTTPException(status_code=error.status, detail="Payroll access denied.") from None
    try:
        from payroll_report import send_all_reports
    except ImportError as e:
        raise HTTPException(status_code=500, detail=f"payroll_report module error: {e}")

    import tempfile
    out_dir  = tempfile.mkdtemp(prefix="nudental_payroll_send_")
    results  = send_all_reports(startDate, endDate, out_dir, dry_run=dryRun)
    return {
        "startDate": startDate,
        "endDate":   endDate,
        "dryRun":    dryRun,
        "sent":      results["sent"],
        "skipped":   results["skipped"],
        "failed":    results["failed"],
        "no_email":  results["no_email"],
        "totalSent": len(results["sent"]),
    }

