# --- Amazon Business Routes ---
# Auth, Products, Cart, Orders, Order Requests
# All route logic delegates to amazon_service.py

from fastapi.responses import HTMLResponse as _HTMLResponse

@app.get("/amazon/status", tags=["Amazon"])
def amazon_status():
    """Amazon Status"""
    is_auth = amazon_service.is_authorized()
    return {
        "authorized": is_auth,
        "message": "Amazon Business API is ready." if is_auth else "Amazon Business API is not authorized.",
    }

@app.get("/amazon/auth-url", tags=["Amazon"])
def amazon_auth_url():
    """Amazon Auth Url"""
    return amazon_service.get_authorization_url()

@app.get("/amazon/auth", tags=["Amazon"])
def amazon_auth():
    """Amazon Auth — returns authorization URL for Dr. G to visit."""
    result = amazon_service.get_authorization_url()
    html = f"""<html><body style="font-family:sans-serif;text-align:center;padding:50px">
    <h2>Amazon Business Authorization</h2>
    <p>Click below to authorize the dashboard:</p>
    <a href="{result['auth_url']}" style="display:inline-block;padding:12px 24px;background:#00B5CC;color:white;text-decoration:none;border-radius:6px;font-size:16px">Authorize with Amazon</a>
    </body></html>"""
    return _HTMLResponse(content=html)

@app.get("/amazon/callback", tags=["Amazon"])
def amazon_callback(code: str = None, state: str = None, error: str = None):
    """Amazon Callback"""
    if error:
        return _HTMLResponse(content=f"<html><body><h2>Error: {error}</h2></body></html>")
    if not code:
        return _HTMLResponse(content="<html><body><h2>No authorization code received</h2></body></html>")
    try:
        result = amazon_service.exchange_code_for_tokens(code, state or "")
        return _HTMLResponse(
            content="<html><body style=\'font-family:sans-serif;text-align:center;padding:50px\'><h2 style=\'color:green\'>&#10003; Amazon Business Connected!</h2><p>You can close this tab.</p></body></html>"
        )
    except Exception as e:
        return _HTMLResponse(content=f"<html><body><h2>Authorization failed: {e}</h2></body></html>", status_code=500)

@app.get("/amazon/products/search", tags=["Amazon"])
def amazon_product_search(
    q: str = Query(..., description="Search keywords"),
    page: int = Query(1),
    page_size: int = Query(20),
    X_API_Key: Optional[str] = Header(None, alias="X-API-Key"),
):
    """Amazon Product Search"""
    if not X_API_Key or X_API_Key != NUDASHBOARD_API_KEY:
        raise HTTPException(status_code=401, detail="Invalid or missing API key")

    try:
        return amazon_service.search_products(q, page_size=page_size, page_number=page)
