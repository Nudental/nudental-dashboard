# ---------------------------------------------------------------------------
# Independent runtime controls (Phase B preparation — Dr. G directive Sep 8)
# ---------------------------------------------------------------------------
# Each subsystem is gated by its own env var, defaulting SAFE (off).
# OTP_EMAIL_DRY_RUN is handled separately — it defaults true (dry-run)
# and is only set false when explicitly ready for live OTP after traffic switch.
#
# Env var                     Default   Meaning when true
# ENABLE_MIGRATIONS           false     Run Supabase DDL migrations at startup
# ENABLE_BACKGROUND_SYNC      false     Start hourly SQLite background sync thread
# ENABLE_AMQPS_CONSUMER       false     Connect to Dentrix Ascend AMQPS streaming
# ENABLE_CACHE_PREWARM        false     Start cache prewarm daemon thread
# OTP_EMAIL_DRY_RUN           true      Log OTP codes but do NOT send real email
# ---------------------------------------------------------------------------
def _env_flag(name: str, default: str = "false") -> bool:
    return os.environ.get(name, default).lower() in ("true", "1", "yes")

_ENABLE_MIGRATIONS      = _env_flag("ENABLE_MIGRATIONS", "false")
_ENABLE_BACKGROUND_SYNC = _env_flag("ENABLE_BACKGROUND_SYNC", "false")
_ENABLE_AMQPS_CONSUMER  = _env_flag("ENABLE_AMQPS_CONSUMER", "false")
_ENABLE_CACHE_PREWARM   = _env_flag("ENABLE_CACHE_PREWARM", "false")

# OTP dry-run: must be forced in env BEFORE otp_auth is imported.
# otp_auth.py reads OTP_EMAIL_DRY_RUN at import time (line 63) via load_dotenv.
# Problem: systemd EnvironmentFile loads .env (which has OTP_EMAIL_DRY_RUN=false)
# and this value persists in the process environment even when a later
# Environment= directive sets it to true. This is a confirmed systemd merge-order
# issue on this host. os.environ.setdefault cannot fix it because the var already
# exists with value 'false'.
#
# Solution: use a separate override var (OTP_FORCE_DRY_RUN) that is NOT in .env.
# If OTP_FORCE_DRY_RUN=true, we force OTP_EMAIL_DRY_RUN=true regardless.
# If OTP_FORCE_DRY_RUN is absent or false, OTP_EMAIL_DRY_RUN keeps its value.
if _env_flag("OTP_FORCE_DRY_RUN", "false"):
    os.environ["OTP_EMAIL_DRY_RUN"] = "true"

