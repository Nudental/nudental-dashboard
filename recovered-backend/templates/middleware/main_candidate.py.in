@app.get("/v2/ar/trend", tags=["Collections"], dependencies=[Depends(verify_api_key)])
def ar_trend(
    startDate: Optional[str] = Query(None, description="Start date (YYYY-MM-DD)"),
    endDate: Optional[str] = Query(None, description="End date (YYYY-MM-DD)"),
    locationId: Optional[str] = Query(None, description="Filter by location ID (omit for all offices)"),
    officeId: Optional[str] = Query(None, description="Filter by office UUID"),
    granularity: Optional[str] = Query("daily", description="Granularity: daily (default)"),
):
    """
    Verified A/R trend from daily snapshots.
    Source: ar_snapshots table populated by ar_snapshot.py from
    GET /v1/agingbalances/report (Carl Emery, HS1, May 2026).
    No PHI — aggregate totals only.
    """
    import sqlite3 as _sq3
    from datetime import date as _date, timedelta as _td

    loc_id = resolve_location_id(officeId, locationId)
    end = endDate or _date.today().isoformat()
    start = startDate or (_date.today() - _td(days=90)).isoformat()

    _db_path = os.path.join(os.path.dirname(__file__), "ascend.db")
    conn = _sq3.connect(_db_path, timeout=10)
    conn.row_factory = _sq3.Row

    if loc_id:
        rows = conn.execute("""
            SELECT snapshot_date, total_ar, net_balance, insurance_portion,
                   guarantor_portion, estimated_writeoff, unapplied_credits,
                   current_0_30, aged_31_60, aged_61_90, aged_over_90,
                   patient_count
            FROM ar_snapshots
            WHERE location_id = ? AND snapshot_date >= ? AND snapshot_date <= ?
            ORDER BY snapshot_date ASC
        """, (loc_id, start, end)).fetchall()
        loc_name = dict(OFFICE_TO_LOCATION).get(loc_id) or loc_id
        # Reverse lookup for display name
        for uid, lid in OFFICE_TO_LOCATION.items():
            if lid == loc_id:
                loc_name = uid
                break
        from ar_service import LOCATIONS as _AR_LOCS
        loc_name = _AR_LOCS.get(loc_id, loc_id)
    else:
        rows = conn.execute("""
            SELECT snapshot_date, total_ar, net_balance, insurance_portion,
                   guarantor_portion, estimated_writeoff, unapplied_credits,
                   current_0_30, aged_31_60, aged_61_90, aged_over_90,
                   patient_count
            FROM ar_snapshots
            WHERE is_all_locations = 1 AND snapshot_date >= ? AND snapshot_date <= ?
            ORDER BY snapshot_date ASC
        """, (start, end)).fetchall()
        loc_name = "All Offices"

    conn.close()

    points = []
    for r in rows:
        points.append({
            "snapshot_date": r["snapshot_date"],
            "total_ar": r["total_ar"],
            "net_balance": r["net_balance"],
            "insurance_portion": r["insurance_portion"],
            "guarantor_portion": r["guarantor_portion"],
            "estimated_writeoff": r["estimated_writeoff"],
            "unapplied_credits": r["unapplied_credits"],
            "current_0_30": r["current_0_30"],
            "aged_31_60": r["aged_31_60"],
            "aged_61_90": r["aged_61_90"],
            "aged_over_90": r["aged_over_90"],
            "patient_count": r["patient_count"],
        })

    result = {
        "source": "ar_snapshots (dentrix_ascend_api)",
        "startDate": start,
        "endDate": end,
        "locationId": loc_id,
        "locationName": loc_name,
        "granularity": granularity,
        "points": points,
    }

    if not points:
        result["message"] = "Verified A/R snapshot history has not accumulated yet."

    return result


