# ── Cache prewarm thread (perf upgrade 2026-05-12) ───────────────────────────
def _prewarm_caches_thread():
    """Background daemon thread: warm slow endpoint caches every 10 minutes.

    Targets the PREWARM_TARGET_PORT env var (default: this process's own port).
    This ensures the prewarm thread always warms *this* instance's caches,
    not a different process on a different port.
    """
    import time as _pw_time
    import requests as _pw_req
    _pw_time.sleep(20)  # Let server finish startup
    _api_key = os.environ.get("NUDASHBOARD_API_KEY", __NUDASHBOARD_CONFIG_LITERAL_015__)
    _prewarm_port = os.environ.get("PREWARM_TARGET_PORT", os.environ.get("PORT", "8001"))
    _base = f"http://127.0.0.1:{_prewarm_port}"
    _hdrs = {"X-API-Key": _api_key}
    logger.info(f"[prewarm] Cache prewarm thread started — target {_base}")
    while True:
        try:
            _pw_req.get(f"{_base}/v2/rcm/ar-aging-official", headers=_hdrs, timeout=120)
            logger.info("[prewarm] ar-aging-official all-offices cache warmed")
        except Exception as _e:
            logger.warning(f"[prewarm] ar-aging-official failed: {_e}")
        try:
            _pw_req.get(f"{_base}/v2/rcm/patient-balances?pageSize=1", headers=_hdrs, timeout=180)
            logger.info("[prewarm] patient-balances all-offices cache warmed")
        except Exception as _e:
            logger.warning(f"[prewarm] patient-balances failed: {_e}")
        _pw_time.sleep(600)  # Every 10 minutes


@app.on_event("startup")
def startup_event():
    """On startup: init DB, optionally apply migrations, start sync/AMQPS/prewarm.

    Each subsystem is gated by an independent env-var flag (all default false/safe).
    This allows fine-grained control during blue-green deployment without the
    all-or-nothing CANDIDATE_MODE approach.
    """
    logger.info("=== NuDashboard Middleware v3.0 starting ===")

    # ── Log effective runtime flags (no secrets) ──
    _otp_dry = os.environ.get("OTP_EMAIL_DRY_RUN", "true")
    logger.info("Runtime flags:")
    logger.info(f"  ENABLE_MIGRATIONS      = {_ENABLE_MIGRATIONS}")
    logger.info(f"  ENABLE_BACKGROUND_SYNC = {_ENABLE_BACKGROUND_SYNC}")
    logger.info(f"  ENABLE_AMQPS_CONSUMER  = {_ENABLE_AMQPS_CONSUMER}")
    logger.info(f"  ENABLE_CACHE_PREWARM   = {_ENABLE_CACHE_PREWARM}")
    logger.info(f"  OTP_EMAIL_DRY_RUN      = {_otp_dry}")

    # ── init_db: always runs (idempotent DDL — CREATE TABLE/INDEX IF NOT EXISTS) ──
    logger.info("Initializing SQLite database...")
    init_db()

    # ── Supabase migrations ──
    if _ENABLE_MIGRATIONS:
        logger.info("Applying Supabase migrations...")
        try:
            migration_result = apply_migrations()
            logger.info(f"Migration result: {migration_result}")
        except Exception as e:
            logger.warning(f"Migration step skipped: {e}")
    else:
        logger.info("ENABLE_MIGRATIONS=false — skipped apply_migrations()")

    # ── Background sync (hourly SQLite refresh from Dentrix REST API) ──
    if _ENABLE_BACKGROUND_SYNC:
        logger.info("Starting SQLite background sync (hourly)...")
        start_background_sync(interval_seconds=3600)
    else:
        logger.info("ENABLE_BACKGROUND_SYNC=false — skipped start_background_sync()")

    # ── AMQPS streaming consumer (Dentrix Ascend real-time events) ──
    if _ENABLE_AMQPS_CONSUMER:
        logger.info("Starting AMQPS streaming consumer...")
        try:
            start_consumer_thread()
        except Exception as e:
            logger.error(f"Failed to start streaming consumer: {e}")
    else:
        logger.info("ENABLE_AMQPS_CONSUMER=false — skipped start_consumer_thread()")

    # ── Cache prewarm thread ──
    if _ENABLE_CACHE_PREWARM:
        import threading as _prewarm_threading
        _prewarm_t = _prewarm_threading.Thread(
            target=_prewarm_caches_thread, daemon=True, name="cache-prewarm"
        )
        _prewarm_t.start()
        logger.info("Cache prewarm thread started (ar-aging-official + patient-balances)")
    else:
        logger.info("ENABLE_CACHE_PREWARM=false — skipped _prewarm_caches_thread()")

    _port = os.environ.get("PORT", "8001")
    logger.info(f"Startup complete. API ready on port {_port}.")


