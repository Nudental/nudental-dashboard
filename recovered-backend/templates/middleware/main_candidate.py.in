@app.get("/amazon/orders/sync", tags=["Amazon"])
def amazon_orders_sync(
    start_date: str = Query(None),
    end_date: str = Query(None),
    triggered_by: str = Query("manual"),
    X_API_Key: Optional[str] = Header(None, alias="X-API-Key"),
):
    """Amazon Orders Sync"""
    if not X_API_Key or X_API_Key != NUDASHBOARD_API_KEY:
        raise HTTPException(status_code=401, detail="Invalid or missing API key")

    from datetime import datetime as _dt, timedelta as _td
    if not start_date:
        start_date = (_dt.now() - _td(days=30)).strftime("%Y-%m-%dT00:00:00")
    if not end_date:
        end_date = _dt.now().strftime("%Y-%m-%dT23:59:59")
    try:
        result = amazon_service.sync_orders(start_date, end_date)
        result["triggered_by"] = triggered_by
        return result
    except Exception as e:
        raise HTTPException(500, str(e))

@app.get("/amazon/orders/history", tags=["Amazon"])
def amazon_orders_history(
    office: str = Query(None),
    month: str = Query(None),
    status: str = Query(None),
    limit: int = Query(100),
    offset: int = Query(0),
    X_API_Key: Optional[str] = Header(None, alias="X-API-Key"),
):
    """Amazon Orders History"""
    if not X_API_Key or X_API_Key != NUDASHBOARD_API_KEY:
        raise HTTPException(status_code=401, detail="Invalid or missing API key")

    try:
        filters = "front_desk_amazon_orders?select=*"
        if office:
            filters += f"&office_location=eq.{office}"
        if month:
            filters += f"&order_month=eq.{month}"
        if status:
            filters += f"&amazon_order_status=eq.{status}"
        filters += f"&order=order_date.desc&limit={limit}&offset={offset}"
        rows = _sb_get_full(filters)
        return {"orders": rows, "count": len(rows), "limit": limit, "offset": offset}
    except Exception as e:
        raise HTTPException(500, str(e))

@app.post("/amazon/orders/place-direct", tags=["Amazon"])
