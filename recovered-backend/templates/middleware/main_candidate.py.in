@app.get("/v2/patients", tags=["Patients"], dependencies=[Depends(verify_api_key)])
def list_patients(
    startDate: Optional[str] = Query(None),
    endDate: Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
    officeId: Optional[str] = Query(None),
    limit: int = Query(100, le=1000),
):
    try:
        svc = get_service()
        loc_id = resolve_location_id(officeId, locationId)

        patients = svc.get_patients(startDate, endDate, loc_id, limit)
        return {"patients": patients, "count": len(patients)}
    except Exception as e:
        logger.exception("Error fetching patients")
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/v2/patients/summary", tags=["Patients"], dependencies=[Depends(verify_api_key)])
def patients_summary(
    startDate: Optional[str] = Query(None),
    endDate: Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
    officeId: Optional[str] = Query(None),
):
    scope = officeId or locationId
    selected_locations = [resolve_location_id(locationId=value.strip()) for value in scope.split(',')] if scope else []
    if any(value not in VALID_LOCATION_IDS for value in selected_locations):
        raise HTTPException(status_code=422, detail="Select valid office locations.")
    loc_id = ','.join(dict.fromkeys(selected_locations)) or None
    try:
        svc = get_service()

        return svc.get_patients_summary(startDate, endDate, loc_id)
    except Exception as e:
        logger.exception("Error fetching patients summary")
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/v2/patients/demographics", tags=["Patients"], dependencies=[Depends(verify_api_key)])
def patients_demographics(
    startDate: Optional[str] = Query(None),
    endDate:   Optional[str] = Query(None),
    locationId: Optional[str] = Query(None),
    officeId:   Optional[str] = Query(None),
    serviceCategory: Optional[str] = Query(None),
    mode: Optional[str] = Query("seen"),  # seen | new | active
):
    """
    Aggregate patient age buckets + ZIP geographic origin.
    NO PHI: returns only counts/percentages — no names, DOBs, IDs, addresses,
    phone numbers, emails, or any patient-level rows.

    mode=seen   → distinct patients with ≥1 completed procedure in period (default)
    mode=new    → patients whose first completed procedure falls in period
    mode=active → patients with patientStatus=ACTIVE or NEW at time of query
    """
    import math
    from datetime import date as _date

    s = startDate or "2026-01-01"
    e = endDate   or "2099-12-31"
    loc = resolve_location_id(officeId, locationId)

    conn = rcm_db()
    try:
        # ── Build patient cohort (aggregate IDs only — never returned) ────────
        loc_filter    = "AND pp.location_id = ?"   if loc else ""
        svc_filter    = "AND pm.normalized_service_category = ?" if serviceCategory else ""
        svc_join      = """
            JOIN patient_procedure_map pm
              ON pp.id = pm.patient_procedure_id""" if serviceCategory else ""

        if mode == "active":
            # Patients with status ACTIVE or NEW, optionally filtered to those
            # seen in the period.
            cohort_sql = f"""
                SELECT DISTINCT p.id,
                       json_extract(p.raw, '$.dateOfBirth') as dob,
                       SUBSTR(json_extract(p.raw, '$.postalCode'), 1, 5) as zip5,
                       json_extract(p.raw, '$.city')  as city,
                       json_extract(p.raw, '$.state') as state
                FROM patients p
                JOIN patient_procedures pp ON pp.patient_id = p.id
                {svc_join}
                WHERE json_extract(p.raw, '$.patientStatus') IN ('ACTIVE','NEW')
                AND pp.status = 'COMPLETED'
                AND pp.service_date >= ?
                AND pp.service_date <= ?
                {loc_filter}
                {svc_filter}
            """
        elif mode == "new":
            # Patients whose FIRST completed procedure falls within the period
            cohort_sql = f"""
                SELECT DISTINCT p.id,
                       json_extract(p.raw, '$.dateOfBirth') as dob,
                       SUBSTR(json_extract(p.raw, '$.postalCode'), 1, 5) as zip5,
                       json_extract(p.raw, '$.city')  as city,
                       json_extract(p.raw, '$.state') as state
                FROM patients p
                JOIN patient_procedures pp ON pp.patient_id = p.id
                {svc_join}
                WHERE pp.status = 'COMPLETED'
                AND pp.service_date >= ?
                AND pp.service_date <= ?
                {loc_filter}
                {svc_filter}
                AND NOT EXISTS (
                    SELECT 1 FROM patient_procedures pp2
                    WHERE pp2.patient_id = p.id
                    AND pp2.status = 'COMPLETED'
                    AND pp2.service_date < ?
                )
            """
        else:
            # mode=seen (default): distinct patients with any completed procedure
            cohort_sql = f"""
                SELECT DISTINCT p.id,
                       json_extract(p.raw, '$.dateOfBirth') as dob,
                       SUBSTR(json_extract(p.raw, '$.postalCode'), 1, 5) as zip5,
                       json_extract(p.raw, '$.city')  as city,
                       json_extract(p.raw, '$.state') as state
                FROM patients p
                JOIN patient_procedures pp ON pp.patient_id = p.id
                {svc_join}
                WHERE pp.status = 'COMPLETED'
                AND pp.service_date >= ?
                AND pp.service_date <= ?
                {loc_filter}
                {svc_filter}
            """

        # Build params list
        params: list = [s, e]
        if loc:             params.append(loc)
        if serviceCategory: params.append(serviceCategory)
        if mode == "new":   params.append(s)  # extra param for NOT EXISTS check

        rows = conn.execute(cohort_sql, params).fetchall()
        total = len(rows)

        # ── Age buckets ──────────────────────────────────────────────────────
        today_str = _date.today().isoformat()
        today_year  = int(today_str[:4])
        today_mmdd  = today_str[5:]

        buckets = {"0-12": 0, "13-17": 0, "18-34": 0,
                   "35-49": 0, "50-64": 0, "65+": 0, "Unknown Age": 0}

        for r in rows:
            dob = r["dob"]
            if not dob or len(dob) < 10 or dob.startswith("0001"):
                buckets["Unknown Age"] += 1
                continue
            try:
                birth_year = int(dob[:4])
                birth_mmdd = dob[5:]
                age = today_year - birth_year - (1 if today_mmdd < birth_mmdd else 0)
                if age < 0 or age > 130:
                    buckets["Unknown Age"] += 1
                elif age <= 12:  buckets["0-12"]  += 1
                elif age <= 17:  buckets["13-17"] += 1
                elif age <= 34:  buckets["18-34"] += 1
                elif age <= 49:  buckets["35-49"] += 1
                elif age <= 64:  buckets["50-64"] += 1
                else:            buckets["65+"]   += 1
            except Exception:
                buckets["Unknown Age"] += 1

        age_order = ["0-12","13-17","18-34","35-49","50-64","65+","Unknown Age"]
        age_buckets = [
            {
                "bucket": b,
                "count":  buckets[b],
                "pct":    round(buckets[b] / total * 100, 1) if total else 0.0,
            }
            for b in age_order
        ]

        # ── ZIP geographic origin ────────────────────────────────────────────
        LOW_VOLUME_THRESHOLD = 10
        zip_map: dict = {}
        unknown_zip = 0

        for r in rows:
            z = r["zip5"]
            # Validate 5-digit numeric
            if not z or len(z) != 5 or not z.isdigit():
                unknown_zip += 1
                continue
            city_norm  = (r["city"] or "").strip().title() or None
            state_norm = (r["state"] or "").strip().upper() or None
            key = z
            if key not in zip_map:
                zip_map[key] = {"zip": z, "city": city_norm,
                                "state": state_norm, "count": 0}
            zip_map[key]["count"] += 1
            # Use most common city name (simple: first wins — good enough)

        # Sort by count desc, apply low-volume bucketing
        sorted_zips = sorted(zip_map.values(), key=lambda x: -x["count"])
        other_count = sum(z["count"] for z in sorted_zips if z["count"] < LOW_VOLUME_THRESHOLD)
        zip_output  = [
            {
                "zip":   z["zip"],
                "city":  z["city"],
                "state": z["state"],
                "count": z["count"],
                "pct":   round(z["count"] / total * 100, 1) if total else 0.0,
            }
            for z in sorted_zips if z["count"] >= LOW_VOLUME_THRESHOLD
        ]
        # Append aggregate buckets (no PHI)
        if other_count > 0:
            zip_output.append({"zip": "OTHER", "city": None, "state": None,
                                "count": other_count,
                                "pct": round(other_count / total * 100, 1) if total else 0.0})
        if unknown_zip > 0:
            zip_output.append({"zip": "Unknown", "city": None, "state": None,
                                "count": unknown_zip,
                                "pct": round(unknown_zip / total * 100, 1) if total else 0.0})

        return {
            "period":       {"start": s, "end": e},
            "mode":         mode,
            "locationId":   loc or None,
            "serviceCategory": serviceCategory or None,
            "totalPatients": total,
            "ageBuckets":   age_buckets,
            "zipCodes":     zip_output,
            "_source":      "dentrix_ascend_local",
            "_coverageDOB": f"{round((total - buckets['Unknown Age']) / total * 100, 1) if total else 0}%",
            "_coverageZIP": f"{round((total - unknown_zip) / total * 100, 1) if total else 0}%",
            "_phi":         "none — aggregate only",
        }
    except Exception as ex:
        logger.exception("Error in /v2/patients/demographics")
        raise HTTPException(status_code=500, detail=str(ex))
    finally:
        conn.close()


