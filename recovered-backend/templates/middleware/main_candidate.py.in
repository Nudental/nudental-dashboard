@app.get("/v2/accounts-receivable", tags=["Collections"], dependencies=[Depends(verify_api_key)])
def accounts_receivable(
    locationId:        Optional[str] = Query(None),
    officeId:          Optional[str] = Query(None),
    x_super_admin_key: Optional[str] = Header(None, alias="X-Super-Admin-Key"),
):
    """
    Aged Receivables — LIVE from Dentrix Ascend /v1/agingbalances/report.
    Replaced old estimated calc with direct API pull (Carl Emery, HS1, May 2026).
    Returns aging buckets, insurance/guarantor split, write-offs.

    Unapplied Credits / Billing Review (super_admin only):
      unappliedCredits at top level and in offices[] is restricted to super_admin.
      Access requires X-Super-Admin-Key header matching NUDASHBOARD_SUPER_ADMIN_KEY env var.
      For non-super_admin: field is stripped; metadata flags indicate access level.
      This is a billing-review item — not an automatic refund owed. Use neutral wording.
    """
    try:
        from ar_service import get_ar_summary

        # ── Super-admin role detection (same pattern as /v2/rcm/ar-aging-official) ──
        if NUDASHBOARD_SUPER_ADMIN_KEY:
            _is_super_admin   = bool(x_super_admin_key and x_super_admin_key == NUDASHBOARD_SUPER_ADMIN_KEY)
            _unapplied_access = "super_admin" if _is_super_admin else "restricted"
        else:
            _is_super_admin   = False
            _unapplied_access = "restricted_backend_role_context_missing"

        loc_id = resolve_location_id(officeId, locationId)
        result = get_ar_summary(loc_id)

        # ── Strip Unapplied Credits / Billing Review for non-super_admin ─────────
        # get_ar_summary always fetches unappliedCredits from Dentrix API.
        # Remove here before the response leaves the backend.
        # Does NOT affect: totalAR, insurancePortion, guarantorPortion, netBalance,
        # estimatedWriteOff, aging buckets, or any other field.
        if not _is_super_admin:
            result.pop("unappliedCredits", None)
            for _office in result.get("offices", []):
                _office.pop("unappliedCredits", None)

        # Inject access-control metadata flags (consistent with ar-aging-official)
        result["unapplied_credits_visible"] = _is_super_admin
        result["unapplied_credits_access"]  = _unapplied_access

        return result
    except Exception as e:
        logger.exception("Error fetching AR from Dentrix API")
        raise HTTPException(status_code=500, detail=str(e))


# Alias: /v2/ar → /v2/accounts-receivable (frontend compatibility)
@app.get("/v2/ar", tags=["Collections"], dependencies=[Depends(verify_api_key)])
def accounts_receivable_alias(
    locationId:        Optional[str] = Query(None),
    officeId:          Optional[str] = Query(None),
    x_super_admin_key: Optional[str] = Header(None, alias="X-Super-Admin-Key"),
):
    """
    Alias for /v2/accounts-receivable. Same restriction logic applies.
    Unapplied Credits / Billing Review: super_admin only via X-Super-Admin-Key.
    """
    try:
        from ar_service import get_ar_summary

        if NUDASHBOARD_SUPER_ADMIN_KEY:
            _is_super_admin   = bool(x_super_admin_key and x_super_admin_key == NUDASHBOARD_SUPER_ADMIN_KEY)
            _unapplied_access = "super_admin" if _is_super_admin else "restricted"
        else:
            _is_super_admin   = False
            _unapplied_access = "restricted_backend_role_context_missing"

        loc_id = resolve_location_id(officeId, locationId)
        result = get_ar_summary(loc_id)

        if not _is_super_admin:
            result.pop("unappliedCredits", None)
            for _office in result.get("offices", []):
                _office.pop("unappliedCredits", None)

        result["unapplied_credits_visible"] = _is_super_admin
        result["unapplied_credits_access"]  = _unapplied_access

        return result
    except Exception as e:
        logger.exception("Error fetching AR (alias)")
        raise HTTPException(status_code=500, detail=str(e))


