"""Bounded, read-only source reader for compensation; never invokes sync.py.

The existing cache is useful for immutable linked transaction identities but is
not a complete historical payroll ledger. Read every page of relevant source
history, retaining inactive revisions and later lastModified timestamps. Nothing
is written to ascend.db, Supabase, Ascend, Gusto, or paid payroll.
"""
from datetime import datetime, timezone
from pathlib import Path
from contextlib import closing
import hashlib, json, sqlite3
from compensation_ledger import IncompleteCollectionEvidence, applied_date, reference

FIELDS = ('id','ledgerType','amount','distributions','provider','location',
    'transactionDate','entryDate','modifiedDate','lastModified','isActive',
    'previousTransaction','replacedByTransaction','organizationLedgerType')
ENDPOINTS = {'patient_payments':'patientpayments','insurance_payments':'insurancepayments','adjustments':'adjustments'}


def minimal_record(raw):
    if not isinstance(raw, dict) or not str(raw.get('id', '')).isdigit():
        raise IncompleteCollectionEvidence('Missing source transaction identity')
    result = {k:raw[k] for k in FIELDS if k in raw}
    for key in ('provider','location','previousTransaction','replacedByTransaction','organizationLedgerType'):
        if result.get(key): result[key] = {'id':reference(result[key])}
    # The v1 response's optional distribution array is absent for unapplied
    # payments and cancellations. The caller requested the field explicitly.
    result['distributions'] = [{k:a.get(k) for k in ('chargeId','chargeLocationId','appliedAmount','isActive')}
                               for a in raw.get('distributions') or []]
    return result


class LedgerReader:
    def __init__(self, client, db_path, *, page_size=100, max_pages=100, max_linked_reads=1000):
        self.client=client; self.db_path=Path(db_path); self.page_size=page_size
        self.max_pages=max_pages; self.max_linked_reads=max_linked_reads
        self.linked_reads=0; self.records={}; self.charges={}; self.categories={}; self.receipts=[]

    def _get(self, path, params):
        status, body, _ = self.client.get(path, params=params)
        if status != 200 or not isinstance(body,dict) or body.get('errors') or body.get('warnings'):
            raise IncompleteCollectionEvidence('Ascend source read did not complete')
        return body

    def _cached(self, tid, tables):
        with closing(sqlite3.connect('file:'+self.db_path.as_posix()+'?mode=ro',uri=True)) as db:
            db.execute('PRAGMA query_only=ON')
            for table in tables:
                assert table in ('procedures','adjustments','patient_payments','insurance_payments')
                row=db.execute('SELECT raw FROM '+table+' WHERE id=?',(tid,)).fetchone()
                if row:
                    raw=json.loads(row[0])
                    if str(raw.get('id')) != tid: raise IncompleteCollectionEvidence('Cached identity mismatch')
                    return raw
        return None

    def _linked(self, tid, fields):
        if not tid or not str(tid).isdigit(): raise IncompleteCollectionEvidence('Invalid source reference')
        self.linked_reads+=1
        if self.linked_reads>self.max_linked_reads: raise IncompleteCollectionEvidence('Linked history exceeds bounded reader limit')
        raw=self._get('/v1/transactions/'+str(tid),{'responseFields':','.join(fields) }).get('data')
        if not raw or str(raw.get('id'))!=str(tid): raise IncompleteCollectionEvidence('Linked source identity mismatch')
        return raw

    def category(self, record):
        cid=reference(record.get('organizationLedgerType'))
        if not cid: raise IncompleteCollectionEvidence('Missing source category reference')
        if cid not in self.categories:
            raw=self._get('/v1/organizationledgertypes/'+cid,{'responseFields':'id,description,allocation,ledgerType'}).get('data')
            if not raw or str(raw.get('id'))!=cid: raise IncompleteCollectionEvidence('Source category identity mismatch')
            self.categories[cid]={k:raw.get(k) for k in ('id','description','allocation','ledgerType')}
        return self.categories[cid]

    def _dependencies(self, record, visited=frozenset()):
        tid=str(record['id'])
        if tid in visited: raise IncompleteCollectionEvidence('Cyclic source revision')
        self.category(record)
        for line in record['distributions']:
            cid=str(line.get('chargeId') or '')
            if cid in self.charges:continue
            raw=self._cached(cid,('procedures','adjustments'))
            if raw is None:raw=self._linked(cid,('id','provider','location','ledgerType'))
            if not reference(raw.get('provider')):raise IncompleteCollectionEvidence('Charge provider identity unavailable')
            self.charges[cid]={'id':cid,'provider':{'id':reference(raw['provider'])},
                'location':{'id':reference(raw.get('location'))},'ledgerType':raw.get('ledgerType')}
        if 'Cancellation' in record.get('ledgerType','') and not record['distributions']:
            previous=reference(record.get('previousTransaction'))
            if not previous:raise IncompleteCollectionEvidence('Cancellation predecessor missing')
            if previous not in self.records:
                raw=self._cached(previous,('patient_payments','insurance_payments','adjustments'))
                if raw is None:raw=self._linked(previous,FIELDS)
                self.records[previous]=minimal_record(raw)
            self._dependencies(self.records[previous],visited|{tid})

    def read(self, start, end, office_ids, *, as_of=None):
        as_of=as_of or datetime.now(timezone.utc).isoformat().replace('+00:00','Z')
        if not office_ids or len(office_ids)>20:raise IncompleteCollectionEvidence('Invalid office scope')
        for table, endpoint in ENDPOINTS.items():
            for office in sorted(office_ids):
                if not str(office).isdigit():raise IncompleteCollectionEvidence('Invalid office identity')
                cursor=None; seen=set()
                query=f'location.id=={office},lastModified>={start},lastModified<={as_of}'
                for page in range(self.max_pages):
                    params={'filter':query,'responseFields':','.join(FIELDS),'pageSize':str(self.page_size)}
                    if cursor:params['lastId']=cursor
                    body=self._get('/v1/transactions/'+endpoint,params);batch=body.get('data')
                    if not isinstance(batch,list):raise IncompleteCollectionEvidence('Invalid source page')
                    ids=[]
                    for raw in batch:
                        r=minimal_record(raw);tid=str(r['id']);ids.append(tid)
                        # API supports lastModified/transactionDate filters but
                        # no Applied Date filter. Discard out-of-window records
                        # immediately; only exact linked predecessors may return.
                        if not start<=applied_date(r)<=end:continue
                        if tid in self.records and self.records[tid]!=r:
                            raise IncompleteCollectionEvidence('Source changed during paginated read')
                        self.records[tid]=r
                    new=set(ids)-seen;seen.update(ids)
                    self.receipts.append({'table':table,'office':str(office),'page':page+1,'count':len(batch)})
                    if len(batch)<self.page_size:break
                    nxt=str(max(map(int,ids)))
                    if not new or nxt==cursor:raise IncompleteCollectionEvidence('Source pagination stalled')
                    cursor=nxt
                else:raise IncompleteCollectionEvidence('Source pagination limit reached')
        # Only relevant Collection rows need their exact historical dependencies.
        # Unrelated Production adjustments cannot become compensation accidentally.
        for r in list(self.records.values()):
            if start<=applied_date(r)<=end and self.category(r).get('allocation')=='COLLECTION':
                self._dependencies(r)
        minimal={'records':self.records,'charges':self.charges,'categories':self.categories}
        digest=hashlib.sha256(json.dumps(minimal,sort_keys=True,separators=(',',':')).encode()).hexdigest()
        return {**minimal,'snapshot':{'sha256':digest,'retrieved_at':datetime.now(timezone.utc).isoformat(),
            'read_as_of':as_of,'applied_scope':[start,end],'complete':True,'pages':len(self.receipts),
            'linked_source_reads':self.linked_reads,'source':'Ascend v1 complete revision history; read only',
            'report_data_as_of':None}}
