# Name aliases for normalisation (first-name variants)
_NAME_ALIASES: dict = {"kat": "katherine", "katherine": "kat", "jeff": "james", "jeffrey": "james"}
# Rigby special case: DB stores "Jeffrey C Rigby", map key is "james clifford rigby"
_RIGBY_NORMS: set = {"jeffrey c rigby", "jeffrey rigby"}

GOG_SEND_ACCOUNT = __NUDASHBOARD_CONFIG_LITERAL_056__

import re as _re, json as _json, urllib.request as _urllib_req, logging as _logging

_provider_email_logger = _logging.getLogger("payroll_report.email_lookup")

def _normalize_provider_name(name: str) -> str:
    """Strip titles (Dr./DDS/DMD), handle 'Last, First' format, collapse whitespace."""
    n = name.strip()
    # Handle "Last, First" → "First Last" before punctuation removal
    if "," in n and "temp" not in n.lower():
        parts = n.split(",", 1)
        n = f"{parts[1].strip()} {parts[0].strip()}"
    n = n.lower()
    for title in ["dr.", "dr ", " dds", " dmd"]:
        n = n.replace(title, "")
    n = _re.sub(r"[.,]", "", n)
    n = _re.sub(r"\s+", " ", n).strip()
    return n


def _lookup_hardcoded(norm: str) -> Optional[str]:
    """Fallback: check PROVIDER_EMAIL_MAP with fuzzy matching."""
    # Exact match
    if norm in PROVIDER_EMAIL_MAP:
        return PROVIDER_EMAIL_MAP[norm]
    # Rigby alias
    if norm in _RIGBY_NORMS:
        return PROVIDER_EMAIL_MAP.get("james clifford rigby")
    # First + last only (drop middle initial/name)
    parts = norm.split()
    if len(parts) >= 2:
        short = f"{parts[0]} {parts[-1]}"
        if short in PROVIDER_EMAIL_MAP:
            return PROVIDER_EMAIL_MAP[short]
    # First-name alias (kat ↔ katherine, jeffrey → james)
    if parts:
        alt = _NAME_ALIASES.get(parts[0])
        if alt:
            alt_name = f"{alt} {' '.join(parts[1:])}"
            if alt_name in PROVIDER_EMAIL_MAP:
                return PROVIDER_EMAIL_MAP[alt_name]
    return None


def _query_supabase_provider_email(norm: str) -> Optional[str]:
    """Query Supabase providers table for email by normalized name match."""
    try:
        cfg_path = "/home/openclaw/.config/supabase/nudental.json"
        with open(cfg_path) as f:
            cfg = _json.load(f)
        sb_url = cfg["project_url"]
        sb_key = cfg["secret_key"]
        # Fetch active providers with email set
        url = f"{sb_url}/rest/v1/providers?is_active=eq.true&email=neq.&select=name,email&limit=200"
        req = _urllib_req.Request(url, headers={
            "apikey": sb_key,
            "Authorization": f"Bearer {sb_key}",
        })
        with _urllib_req.urlopen(req, timeout=10) as r:
            rows = _json.loads(r.read())
        for row in rows:
            db_norm = _normalize_provider_name(row.get("name", ""))
            if db_norm == norm and row.get("email"):
                return row["email"]
    except Exception as exc:
        _provider_email_logger.warning("Supabase provider email lookup failed: %s", exc)
    return None


def get_provider_email(name: str) -> Optional[str]:
    """
    Resolve provider email.
    1. Normalize the input name (strip Dr./DDS/DMD, handle Last-First, etc.)
    2. Query Supabase providers.email (primary source of truth)
    3. Fall back to hardcoded PROVIDER_EMAIL_MAP
    4. Log lookup failures (no PHI, no UUIDs)
    """
    norm = _normalize_provider_name(name)
    # 1. Supabase providers.email
    email = _query_supabase_provider_email(norm)
    if email:
        return email
    # 2. Hardcoded fallback
    email = _lookup_hardcoded(norm)
    if email:
        return email
    # 3. Log miss
    _provider_email_logger.info("No email found for provider: %s (normalized: %s)", name, norm)
    return None

def send_report_to_provider(provider_name: str, provider_email: str,
                             pay_start: str, pay_end: str,
                             pdf_path: str, html_str: str,
                             total_coll: float, total_comp: float) -> bool:
    """Email the provider their individual compensation report (PDF attached)."""
    import subprocess, shlex

    payday_map = {
        # Approximate payday based on period end — can be made smarter
    }
    ascend_start, ascend_end = ascend_reporting_period(pay_start, pay_end)

    subject = (f"NU Dental — Your Compensation Report | "
               f"{_fmt(pay_start)} – {_fmt(pay_end)}")

    body = f"""<div style="font-family:Arial,sans-serif;font-size:13px;color:#222;max-width:520px;">
<p>Dear {provider_name.split()[-1] if ' ' in provider_name else provider_name},</p>
<p>Please find attached your NU Dental compensation report for the pay period
<strong>{_fmt(pay_start)} – {_fmt(pay_end)}</strong>.</p>
<table style="border-collapse:collapse;margin:16px 0;width:100%;max-width:400px;">
  <tr style="background:#1a3a5c;color:#fff;">
    <th style="padding:8px 14px;text-align:left;">Detail</th>
    <th style="padding:8px 14px;text-align:right;">Amount</th>
  </tr>
  <tr>
    <td style="padding:7px 14px;border-bottom:1px solid #eee;">Total Collections</td>
    <td style="padding:7px 14px;text-align:right;border-bottom:1px solid #eee;">${total_coll:,.2f}</td>
  </tr>
  <tr style="background:#eafaf1;">
    <td style="padding:7px 14px;font-weight:700;">Estimated Compensation</td>
    <td style="padding:7px 14px;text-align:right;font-weight:700;color:#1e8449;">${total_comp:,.2f}</td>
  </tr>
</table>
<p style="font-size:11px;color:#888;">
  This is a preliminary report for the pay period above, based on Ascend activity
  from {_fmt(ascend_start)} through {_fmt(ascend_end)}.
  Final amounts are subject to month-end reconciliation if your monthly collections
  cross a compensation tier threshold.<br><br>
  Questions? Contact <a href="mailto:__NUDASHBOARD_CONFIG_LITERAL_057__">__NUDASHBOARD_CONFIG_LITERAL_058__</a>.
</p>
<p>Best regards,<br><strong>NU Dental Administration</strong></p>
</div>"""

    cmd = [
        "gog", "gmail", "send",
        "--account", GOG_SEND_ACCOUNT,
        "--to",      provider_email,
        "--subject", subject,
        "--body-html", body,
        "--attach",  pdf_path,
        "--no-input"
    ]
    env = {**os.environ, "GOG_ACCOUNT": GOG_SEND_ACCOUNT}
    try:
        result = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=30)
        return result.returncode == 0
    except Exception as e:
        print(f"  Email failed for {provider_name}: {e}")
        return False


def send_all_reports(pay_start: str, pay_end: str, output_dir: Optional[str] = None,
                     dry_run: bool = False) -> dict:
    """
    Generate + email individual reports to all providers with known emails.
    Returns summary of sent / skipped / failed.
    """
    if output_dir is None:
        output_dir = tempfile.mkdtemp(prefix="nudental_payroll_email_")

    providers = _get_providers()
    results = {"sent": [], "skipped": [], "failed": [], "no_email": []}

    for p in providers:
        pid   = p["id"]
        name  = p["name"]
        spec  = p["specialty"]

        # Skip owner and placeholders
        if pid in EXCLUDED_PROVIDER_IDS or name.strip().lower() in EXCLUDED_PROVIDER_NAMES:
            results["skipped"].append(f"{name} (owner — excluded)")
            continue
        if any(x in name.lower() for x in ["temp", "nu dental provider", "nu dental of"]):
            results["skipped"].append(name)
            continue

        loc_override = _get_location_override(pid)
        ascend_start, ascend_end = ascend_reporting_period(pay_start, pay_end)
        coll_rows  = _collections_by_date(pid, ascend_start, ascend_end,
                                          allowed_locations=loc_override)
        total_coll = sum(r["applied_payments"] for r in coll_rows)
        if total_coll <= 0:
            results["skipped"].append(f"{name} (no collections)")
            continue

        email = get_provider_email(name)
        if not email:
            results["no_email"].append(name)
            continue

        html_str, coll, comp = build_html(pid, name, spec, pay_start, pay_end)

        safe   = name.replace(" ","_").replace(",","").replace(".","")
        html_p = os.path.join(output_dir, f"{safe}_{pay_start}_to_{pay_end}.html")
        pdf_p  = os.path.join(output_dir, f"{safe}_{pay_start}_to_{pay_end}.pdf")

        with open(html_p, "w") as f:
            f.write(html_str)

        try:
            subprocess.run([WEASYPRINT_BIN, html_p, pdf_p],
                           check=True, capture_output=True, timeout=30)
        except Exception as e:
            results["failed"].append(f"{name} (PDF error: {e})")
            continue

        if dry_run:
            print(f"  [DRY RUN] Would email {name} → {email}  comp=${comp:,.2f}")
            results["sent"].append({"name": name, "email": email,
                                    "collections": coll, "compensation": comp})
            continue

        ok = send_report_to_provider(name, email, pay_start, pay_end, pdf_p, html_str, coll, comp)
        if ok:
            print(f"  ✓ Emailed {name} → {email}  comp=${comp:,.2f}")
            results["sent"].append({"name": name, "email": email,
                                    "collections": coll, "compensation": comp})
        else:
            results["failed"].append(name)

    return results


if __name__ == "__main__":
    import sys
    start = sys.argv[1] if len(sys.argv) > 1 else "2026-04-13"
    end   = sys.argv[2] if len(sys.argv) > 2 else "2026-04-24"
    out   = sys.argv[3] if len(sys.argv) > 3 else "/tmp/nudental_payroll"
    os.makedirs(out, exist_ok=True)
    print(f"Generating reports for {start} → {end}...")
    zip_path = generate_all_reports(start, end, out)
    print(f"\nDone → {zip_path}")
