"""
Reports Individual Export — Backend endpoints with RBAC + audit logging.

Created: 2026-05-21
Checkpoint: reports-individual-export-backend-rbac-audit-no-frontend

Supports CSV (and XLSX) export for verified Reports sections.
All exports are aggregate-only — no patient-level PHI.
"""

import csv
import io
import json
import logging
import os
import re
import urllib.request
from datetime import datetime, date, timezone
from typing import Optional

from fastapi import APIRouter, HTTPException, Body, Depends, Header

logger = logging.getLogger("report_export")

router = APIRouter(prefix="/v2/reports", tags=["Reports Export"])

# ── Config ────────────────────────────────────────────────────────────────

SUPPORTED_REPORT_TYPES = {
    "executive_summary",
    "pl_summary",
    "expense_breakdown",
    "goal_leaderboard",
    "period_comparison",
    "provider_production_collections",
    "office_comparison",
    "treatment_plan_completion",
    "patient_flow",
    "full_workbook",
}

UNSUPPORTED_REPORT_TYPES = {
    "case_acceptance": "Legacy Case Acceptance source not verified.",
}

SUPPORTED_FORMATS = {"csv", "xlsx", "pdf"}

PERMISSION_KEY = "resources.reports.individual_export"

LOCATION_NAMES = __NUDASHBOARD_CONFIG_LITERAL_069__

LOCATION_IDS_BY_NAME = {v.lower(): k for k, v in LOCATION_NAMES.items()}

ALL_LOCATION_IDS = list(LOCATION_NAMES.keys())

# Supabase office UUIDs → Dentrix location IDs
OFFICE_UUID_TO_LOCATION_ID = __NUDASHBOARD_CONFIG_LITERAL_070__

# Reverse: UUID → display name
OFFICE_UUID_TO_NAME = {
    uid: LOCATION_NAMES[lid] for uid, lid in OFFICE_UUID_TO_LOCATION_ID.items()
}

# Combined lookup: accepts UUID, location ID, or office name → display name
def _resolve_office_name(val: str) -> str:
    """Resolve any office identifier to a human-readable display name."""
    v = val.strip()
    vl = v.lower()
    # UUID → name
    if vl in OFFICE_UUID_TO_NAME:
        return OFFICE_UUID_TO_NAME[vl]
    # Dentrix location ID → name
    if v in LOCATION_NAMES:
        return LOCATION_NAMES[v]
    # Already a name?
    for name in LOCATION_NAMES.values():
        if vl == name.lower():
            return name
    # Unknown
    short = v[:8] if len(v) > 12 else v
    return f"Unknown Office ({short})"


# ── Helpers ───────────────────────────────────────────────────────────────

def _load_supabase_config():
    cfg_path = os.path.expanduser("~/.config/supabase/nudental.json")
    with open(cfg_path) as f:
        return json.load(f)


def _sb_rest(path: str, method: str = "GET", body: dict = None) -> list | dict:
    """Supabase REST call with service role key."""
    cfg = _load_supabase_config()
    base = cfg["project_url"] + "/rest/v1"
    key = cfg["secret_key"]
    url = f"{base}/{path}"
    headers = {
        "apikey": key,
        "Authorization": f"Bearer {key}",
        "Content-Type": "application/json",
        "Prefer": "return=representation",
    }
    if method == "GET":
        req = urllib.request.Request(url, headers=headers)
    else:
        data = json.dumps(body).encode() if body else b"{}"
        req = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req) as r:
        return json.loads(r.read())


def _api_get(path: str, api_key: str) -> dict | list:
    """Internal HTTP call to our own middleware API."""
    from urllib.parse import quote
    # Encode the path properly — split at ? to keep query string structure
    if "?" in path:
        base, qs = path.split("?", 1)
        # Re-encode each param value
        parts = []
        for param in qs.split("&"):
            if "=" in param:
                k, v = param.split("=", 1)
                parts.append(f"{k}={quote(v, safe='')}")
            else:
                parts.append(param)
        path = f"{base}?{'&'.join(parts)}"
    url = f"http://127.0.0.1:8001{path}"
    req = urllib.request.Request(url, headers={
        "X-API-Key": api_key,
        "Accept": "application/json",
    })
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read())


def _verify_api_key(x_api_key: str = Header(..., alias="X-API-Key")):
    """Reuse the same API key verification as other endpoints."""
    if x_api_key != __NUDASHBOARD_CONFIG_LITERAL_071__:
        raise HTTPException(status_code=401, detail="Invalid API key")
    return x_api_key


def _check_rbac(user_id: str, user_email: str, user_role: str):
    """Verify the user has export permission."""
    if not user_role:
        raise HTTPException(status_code=403, detail="User role is required")
    allowed = {"super_admin", "admin"}
    if user_role not in allowed:
        # Also check the permission key
        rows = _sb_rest(
            f"role_permissions?role=eq.{user_role}&permission=eq.{PERMISSION_KEY}&enabled=eq.true&limit=1"
        )
        if not rows:
            raise HTTPException(
                status_code=403,
                detail=f"Role '{user_role}' does not have '{PERMISSION_KEY}' permission"
            )


def _check_rbac_full_workbook(user_id: str, user_email: str, user_role: str):
    """Verify the user has full workbook export permission.
    Accepts either the full_workbook permission or the individual export permission."""
    if not user_role:
        raise HTTPException(status_code=403, detail="User role is required")
    allowed = {"super_admin", "admin"}
    if user_role not in allowed:
        # Check full_workbook permission first, fall back to individual export
        rows = _sb_rest(
            f"role_permissions?role=eq.{user_role}&permission=eq.{FULL_WORKBOOK_PERMISSION}&enabled=eq.true&limit=1"
        )
        if not rows:
            rows = _sb_rest(
                f"role_permissions?role=eq.{user_role}&permission=eq.{PERMISSION_KEY}&enabled=eq.true&limit=1"
            )
        if not rows:
            raise HTTPException(
                status_code=403,
                detail=f"Role '{user_role}' does not have '{FULL_WORKBOOK_PERMISSION}' permission"
            )


def _audit_log(
    user_id: str,
    user_email: str,
    user_role: str,
    report_type: str,
    export_format: str,
    date_range_start: str,
    date_range_end: str,
    office_filter: list,
    sheets_exported: list,
    row_counts: dict,
    source_notes: str = "",
    metadata: dict = None,
) -> str:
    """Insert audit row. Returns audit row ID. Raises on failure."""
    row = {
        "user_id": user_id,
        "user_email": user_email,
        "user_role": user_role,
        "report_type": report_type,
        "export_format": export_format,
        "date_range_start": date_range_start,
        "date_range_end": date_range_end,
        "office_filter": office_filter,
        "sheets_exported": sheets_exported,
        "row_counts": row_counts,
        "phi_flag": False,
        "source_version": "3.0.0",
        "source_notes": source_notes,
        "metadata": metadata or {},
    }
    try:
        result = _sb_rest("report_export_audit_log", method="POST", body=row)
        if isinstance(result, list) and result:
            return result[0]["id"]
        return "unknown"
    except Exception as e:
        logger.error(f"Audit log insert failed: {e}")
        raise HTTPException(
            status_code=500,
            detail=f"Audit logging failed — export blocked. Error: {str(e)}"
        )


def _sanitize_filename(name: str) -> str:
    return re.sub(r"[^a-zA-Z0-9_\-]", "_", name)


_ALL_OFFICE_STRINGS = {"all", "all_offices", "all offices", ""}

def _coerce_office_filter(raw) -> list:
    """Coerce office_filter from any input shape to a clean list.
    
    Handles: None, [], "all", "all_offices", "All Offices", "",
    single UUID string, list of UUIDs/names.
    """
    if raw is None:
        return []
    if isinstance(raw, str):
        trimmed = raw.strip()
        if trimmed.lower() in _ALL_OFFICE_STRINGS:
            return []
        # Single value string — wrap in list
        return [trimmed]
    if isinstance(raw, list):
        # Filter out "all"/"all_offices" sentinel values inside the list
        cleaned = []
        for item in raw:
            if isinstance(item, str):
                t = item.strip()
                if t.lower() not in _ALL_OFFICE_STRINGS and t:
                    cleaned.append(t)
        return cleaned
    # Unexpected type — treat as empty
    return []


def _normalize_office_filter(office_filter: list) -> list[str]:
    """Normalize office_filter entries to display names.
    Accepts UUIDs, location IDs, or names — returns list of display names."""
    if not office_filter:
        return []
    return [_resolve_office_name(o) for o in office_filter if o]


def _office_label(office_filter: list) -> str:
    names = _normalize_office_filter(office_filter)
    if not names or len(names) >= len(LOCATION_NAMES):
        return "all_offices"
    return "_".join(_sanitize_filename(n) for n in names[:4])


def _office_display(office_filter: list) -> str:
    """Human-readable office display string for PDF headers, etc."""
    names = _normalize_office_filter(office_filter)
    if not names or len(names) >= len(LOCATION_NAMES):
        return "All Offices"
    return ", ".join(names)


def _resolve_office_locations(office_filter: list) -> list[str]:
    """Convert office identifiers (UUIDs, names, or location IDs) to Dentrix location IDs."""
    if not office_filter:
        return ALL_LOCATION_IDS
    locs = []
    for val in office_filter:
        v = val.strip().lower()
        # UUID → location ID
        if v in OFFICE_UUID_TO_LOCATION_ID:
            locs.append(OFFICE_UUID_TO_LOCATION_ID[v])
            continue
        # Already a location ID
        if val.strip() in LOCATION_NAMES:
            locs.append(val.strip())
            continue
        # Name → location ID
        lid = LOCATION_IDS_BY_NAME.get(v)
        if lid:
            locs.append(lid)
    return locs or ALL_LOCATION_IDS


def _make_csv(
    headers: list[str],
    rows: list[dict],
    *,
    report_title: str = "",
    date_range_start: str = "",
    date_range_end: str = "",
    office_display: str = "",
    source_notes: str = "",
    user_email: str = "",
    user_role: str = "",
) -> str:
    """Generate CSV with clean metadata header rows."""
    buf = io.StringIO()

    # Metadata header block (Option A — clean, importable)
    meta_lines = [
        f"# Nu Dental — {report_title}",
        f"# Date Range: {date_range_start} to {date_range_end}",
        f"# Office: {office_display or 'All Offices'}",
        f"# Generated: {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')}",
        f"# Generated by: {user_email} ({user_role})",
        f"# Source: {source_notes}" if source_notes else None,
        f"# Confidential — Internal Use Only",
        f"#",
    ]
    for line in meta_lines:
        if line is not None:
            buf.write(line + "\n")

    writer = csv.DictWriter(buf, fieldnames=headers, extrasaction="ignore")
    writer.writeheader()
    for row in rows:
        writer.writerow(row)
    return buf.getvalue()


