# ── Brand Colors ──────────────────────────────────────────────────────────

BRAND_CYAN    = colors.HexColor("#00B5CC")
BRAND_SKY     = colors.HexColor("#9BCBEB")
BRAND_MINT    = colors.HexColor("#6ECEB2")
BRAND_DARK    = colors.HexColor("#1A1A2E")
HEADER_BG     = colors.HexColor("#00B5CC")
HEADER_TEXT    = colors.white
ROW_ALT       = colors.HexColor("#F0FAFB")
BORDER_COLOR  = colors.HexColor("#D0E8EC")
SUBTLE_GRAY   = colors.HexColor("#666666")
LIGHT_GRAY    = colors.HexColor("#F5F5F5")

# ── Logo path ─────────────────────────────────────────────────────────────

LOGO_PATH = os.path.join(os.path.dirname(__file__), "static", "nudental_logo.png")
LOGO_EXISTS = os.path.isfile(LOGO_PATH)

# ── Styles ────────────────────────────────────────────────────────────────

def _get_styles():
    styles = getSampleStyleSheet()

    styles.add(ParagraphStyle(
        "BrandTitle",
        parent=styles["Title"],
        fontName="Helvetica-Bold",
        fontSize=18,
        textColor=BRAND_DARK,
        spaceAfter=4,
    ))
    styles.add(ParagraphStyle(
        "BrandSubtitle",
        parent=styles["Normal"],
        fontName="Helvetica",
        fontSize=10,
        textColor=SUBTLE_GRAY,
        spaceAfter=2,
    ))
    styles.add(ParagraphStyle(
        "SectionHeader",
        parent=styles["Heading2"],
        fontName="Helvetica-Bold",
        fontSize=13,
        textColor=BRAND_CYAN,
        spaceBefore=16,
        spaceAfter=6,
    ))
    styles.add(ParagraphStyle(
        "KPILabel",
        parent=styles["Normal"],
        fontName="Helvetica",
        fontSize=8,
        textColor=SUBTLE_GRAY,
        alignment=TA_CENTER,
    ))
    styles.add(ParagraphStyle(
        "KPIValue",
        parent=styles["Normal"],
        fontName="Helvetica-Bold",
        fontSize=14,
        textColor=BRAND_DARK,
        alignment=TA_CENTER,
    ))
    styles.add(ParagraphStyle(
        "SourceNote",
        parent=styles["Normal"],
        fontName="Helvetica-Oblique",
        fontSize=7,
        textColor=SUBTLE_GRAY,
        spaceBefore=4,
        spaceAfter=2,
    ))
    styles.add(ParagraphStyle(
        "CellText",
        parent=styles["Normal"],
        fontName="Helvetica",
        fontSize=8,
        leading=10,
    ))
    styles.add(ParagraphStyle(
        "CellTextBold",
        parent=styles["Normal"],
        fontName="Helvetica-Bold",
        fontSize=8,
        leading=10,
    ))
    styles.add(ParagraphStyle(
        "HeaderCell",
        parent=styles["Normal"],
        fontName="Helvetica-Bold",
        fontSize=8,
        leading=10,
        textColor=HEADER_TEXT,
    ))
    return styles


# ── Helper: format values for PDF cells ───────────────────────────────────

def _fmt(val, fmt_type="text"):
    if val is None or val == "":
        return "—"
    if fmt_type == "money":
        try:
            v = float(val)
            neg = v < 0
            s = f"${abs(v):,.2f}"
            return f"({s})" if neg else s
        except (ValueError, TypeError):
            return str(val)
    if fmt_type == "pct":
        try:
            return f"{float(val):.1f}%"
        except (ValueError, TypeError):
            return str(val)
    if fmt_type == "int":
        try:
            return f"{int(float(val)):,}"
        except (ValueError, TypeError):
            return str(val)
    if fmt_type == "days":
        try:
            return f"{float(val):.1f}"
        except (ValueError, TypeError):
            return str(val)
    return str(val)


# ── Helper: build a branded table ─────────────────────────────────────────

def _make_table(headers: list[str], rows: list[dict], col_formats: list[str] = None,
                col_widths: list[float] = None, styles_obj=None) -> Table:
    """Build a branded ReportLab Table from headers + row dicts."""
    s = styles_obj or _get_styles()

    if not col_formats:
        col_formats = ["text"] * len(headers)

    # Header row
    table_data = [[Paragraph(h, s["HeaderCell"]) for h in headers]]

    # Data rows
    for row in rows:
        table_row = []
        for i, h in enumerate(headers):
            val = row.get(h, "")
            fmt = col_formats[i] if i < len(col_formats) else "text"
            cell_style = s["CellTextBold"] if i == 0 else s["CellText"]
            table_row.append(Paragraph(_fmt(val, fmt), cell_style))
        table_data.append(table_row)

    t = Table(table_data, colWidths=col_widths, repeatRows=1)

    # Style
    style_cmds = [
        ("BACKGROUND", (0, 0), (-1, 0), HEADER_BG),
        ("TEXTCOLOR", (0, 0), (-1, 0), HEADER_TEXT),
        ("FONTNAME", (0, 0), (-1, 0), "Helvetica-Bold"),
        ("FONTSIZE", (0, 0), (-1, 0), 8),
        ("BOTTOMPADDING", (0, 0), (-1, 0), 6),
        ("TOPPADDING", (0, 0), (-1, 0), 6),
        ("FONTNAME", (0, 1), (-1, -1), "Helvetica"),
        ("FONTSIZE", (0, 1), (-1, -1), 8),
        ("TOPPADDING", (0, 1), (-1, -1), 4),
        ("BOTTOMPADDING", (0, 1), (-1, -1), 4),
        ("GRID", (0, 0), (-1, -1), 0.5, BORDER_COLOR),
        ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
        ("ROWBACKGROUNDS", (0, 1), (-1, -1), [colors.white, ROW_ALT]),
    ]

    # Right-align money/pct/int columns
    for i, fmt in enumerate(col_formats):
        if fmt in ("money", "pct", "int", "days"):
            style_cmds.append(("ALIGN", (i, 0), (i, -1), "RIGHT"))

    t.setStyle(TableStyle(style_cmds))
    return t


# ── Page template with header/footer ─────────────────────────────────────

class _BrandedPageTemplate:
    """Draws header logo + footer on each page."""

    def __init__(self, report_title: str, subtitle: str, user_email: str, user_role: str):
        self.report_title = report_title
        self.subtitle = subtitle
        self.user_email = user_email
        self.user_role = user_role

    def on_page(self, canvas_obj, doc):
        canvas_obj.saveState()
        w, h = doc.pagesize

        # ── Header ──
        # Logo
        if LOGO_EXISTS:
            try:
                canvas_obj.drawImage(LOGO_PATH, 36, h - 52, width=120, height=20,
                                     preserveAspectRatio=True, mask="auto")
            except Exception:
                canvas_obj.setFont("Helvetica-Bold", 14)
                canvas_obj.setFillColor(BRAND_CYAN)
                canvas_obj.drawString(36, h - 44, "NU Dental")
        else:
            canvas_obj.setFont("Helvetica-Bold", 14)
            canvas_obj.setFillColor(BRAND_CYAN)
            canvas_obj.drawString(36, h - 44, "NU Dental")

        # Header line
        canvas_obj.setStrokeColor(BRAND_CYAN)
        canvas_obj.setLineWidth(1.5)
        canvas_obj.line(36, h - 58, w - 36, h - 58)

        # ── Footer ──
        canvas_obj.setStrokeColor(BORDER_COLOR)
        canvas_obj.setLineWidth(0.5)
        canvas_obj.line(36, 42, w - 36, 42)

        canvas_obj.setFont("Helvetica", 6.5)
        canvas_obj.setFillColor(SUBTLE_GRAY)

        # Left: confidential
        canvas_obj.drawString(36, 30, "Confidential — Internal Use Only")

        # Center: generated by
        gen_text = f"Generated by {self.user_email} ({self.user_role})"
        canvas_obj.drawCentredString(w / 2, 30, gen_text)

        # Right: page number
        canvas_obj.drawRightString(w - 36, 30, f"Page {doc.page}")

        canvas_obj.restoreState()

    def on_first_page(self, canvas_obj, doc):
        self.on_page(canvas_obj, doc)

    def on_later_pages(self, canvas_obj, doc):
        self.on_page(canvas_obj, doc)


# ── KPI card helper ───────────────────────────────────────────────────────

def _kpi_cards(kpis: list[tuple[str, str]], styles_obj) -> Table:
    """
    Build a row of KPI cards.
    kpis: list of (label, value_string) tuples.
    """
    s = styles_obj
    n = len(kpis)
    if n == 0:
        return Spacer(1, 0)

    # Build 2-row table: values on top, labels below
    val_row = []
    lbl_row = []
    for label, value in kpis:
        val_row.append(Paragraph(value, s["KPIValue"]))
        lbl_row.append(Paragraph(label, s["KPILabel"]))

    t = Table([val_row, lbl_row], colWidths=[2.0 * inch] * n)
    t.setStyle(TableStyle([
        ("ALIGN", (0, 0), (-1, -1), "CENTER"),
        ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
        ("TOPPADDING", (0, 0), (-1, 0), 8),
        ("BOTTOMPADDING", (0, 1), (-1, 1), 8),
        ("BACKGROUND", (0, 0), (-1, -1), LIGHT_GRAY),
        ("BOX", (0, 0), (-1, -1), 0.5, BORDER_COLOR),
        ("LINEBELOW", (0, 0), (-1, 0), 0.5, BORDER_COLOR),
    ]))
    return t


# ── Per-report PDF builders ──────────────────────────────────────────────

def _build_executive_summary(headers, rows, meta, s) -> list:
    elements = []
    elements.append(Paragraph("Executive Summary", s["SectionHeader"]))

    # KPI cards from first row or aggregate
    if rows:
        # Aggregate all offices
        total_prod = sum(r.get("Gross Production", 0) or 0 for r in rows)
        total_coll = sum(r.get("Total Collections", 0) or 0 for r in rows)
        total_exp = sum(r.get("Total Expenses", 0) or 0 for r in rows)
        net_profit = round(total_coll - total_exp, 2)

        kpis = [
            ("Gross Production", _fmt(total_prod, "money")),
            ("Total Collections", _fmt(total_coll, "money")),
            ("Total Expenses", _fmt(total_exp, "money")),
            ("Est. Net Profit", _fmt(net_profit, "money")),
        ]
        elements.append(_kpi_cards(kpis, s))
        elements.append(Spacer(1, 12))

    elements.append(Paragraph("Office Breakdown", s["SectionHeader"]))

    col_formats = ["text", "money", "money", "money", "money", "money", "money", "pct", "money", "money", "int"]
    elements.append(_make_table(headers, rows, col_formats, styles_obj=s))

    elements.append(Spacer(1, 8))
    elements.append(Paragraph(
        "Source: Dentrix Ascend production &amp; collections + Finance Expense Report protected totals. "
        "Est. Net Profit = Total Collections − Total Expenses.",
        s["SourceNote"]
    ))
    return elements


def _build_pl_summary(headers, rows, meta, s) -> list:
    elements = []
    elements.append(Paragraph("Profit &amp; Loss Summary", s["SectionHeader"]))

    col_formats = ["text", "money", "money", "money", "money", "money", "pct", "money", "money", "pct"]

    # Add a total row
    if rows:
        total = {"Month": "TOTAL"}
        for h in headers[1:]:
            if h == "Margin %" or h == "Collection Rate %":
                vals = [r.get(h, 0) or 0 for r in rows]
                total[h] = round(sum(vals) / len(vals), 1) if vals else 0
            else:
                total[h] = round(sum(r.get(h, 0) or 0 for r in rows), 2)
        rows_with_total = rows + [total]
    else:
        rows_with_total = rows

    t = _make_table(headers, rows_with_total, col_formats, styles_obj=s)

    # Bold the total row
    if rows_with_total:
        last = len(rows_with_total)
        t.setStyle(TableStyle([
            ("FONTNAME", (0, last), (-1, last), "Helvetica-Bold"),
            ("LINEABOVE", (0, last), (-1, last), 1.5, BRAND_CYAN),
            ("BACKGROUND", (0, last), (-1, last), LIGHT_GRAY),
        ]))

    elements.append(t)
    elements.append(Spacer(1, 8))
    elements.append(Paragraph(
        "Source: Dentrix Ascend monthly production &amp; collections, Finance Expense Report protected expenses. "
        "Net Profit = Collections − Expenses. Margin = Net Profit / Collections.",
        s["SourceNote"]
    ))
    return elements


def _build_expense_breakdown(headers, rows, meta, s) -> list:
    elements = []
    elements.append(Paragraph("Expense Breakdown", s["SectionHeader"]))

    col_formats = ["text", "money"]

    t = _make_table(headers, rows, col_formats, col_widths=[3.5 * inch, 2.5 * inch], styles_obj=s)

    # Bold the total row
    if rows:
        last = len(rows)
        t.setStyle(TableStyle([
            ("FONTNAME", (0, last), (-1, last), "Helvetica-Bold"),
            ("LINEABOVE", (0, last), (-1, last), 1.5, BRAND_CYAN),
            ("BACKGROUND", (0, last), (-1, last), LIGHT_GRAY),
        ]))

    elements.append(t)
    elements.append(Spacer(1, 8))
    elements.append(Paragraph(
        "Source: Finance Expense Report — Gusto payroll, AmEx corporate card, Wells Fargo direct operating. "
        "AmEx Net = Charges − Credits/Refunds.",
        s["SourceNote"]
    ))
    return elements


