}


# ── Main generator ────────────────────────────────────────────────────────

def generate_pdf(
    report_type: str,
    headers: list[str],
    rows: list[dict],
    date_range_start: str,
    date_range_end: str,
    office_label: str,
    user_email: str,
    user_role: str,
    metadata: dict = None,
) -> bytes:
    """Generate a branded Nu Dental PDF report and return bytes."""
    metadata = metadata or {}
    buf = io.BytesIO()

    title = REPORT_TITLES.get(report_type, report_type.replace("_", " ").title())
    subtitle_parts = [
        f"{date_range_start} — {date_range_end}",
        office_label if office_label else "All Offices",
    ]
    subtitle = " | ".join(subtitle_parts)
    gen_ts = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")

    # Use landscape for wide tables
    wide_reports = {"provider_production_collections", "executive_summary", "pl_summary", "treatment_plan_completion", "patient_flow"}
    page_size = landscape(letter) if report_type in wide_reports else letter

    template = _BrandedPageTemplate(title, subtitle, user_email, user_role)

    doc = SimpleDocTemplate(
        buf,
        pagesize=page_size,
        topMargin=72,
        bottomMargin=54,
        leftMargin=36,
        rightMargin=36,
        title=f"Nu Dental — {title}",
        author="Nu Dashboard",
    )

    s = _get_styles()

    # Build document elements
    elements = []

    # Title block
    elements.append(Paragraph(title, s["BrandTitle"]))
    elements.append(Paragraph(subtitle, s["BrandSubtitle"]))
    elements.append(Paragraph(f"Generated: {gen_ts}", s["BrandSubtitle"]))
    elements.append(Spacer(1, 6))
    elements.append(HRFlowable(width="100%", thickness=0.5, color=BRAND_SKY))
    elements.append(Spacer(1, 8))

    # Report-specific content
    builder = BUILDERS.get(report_type)
    if builder:
        report_elements = builder(headers, rows, metadata, s)
        elements.extend(report_elements)
    else:
        # Fallback: generic table
        elements.append(_make_table(headers, rows, styles_obj=s))

    # Build PDF
    doc.build(elements,
              onFirstPage=template.on_first_page,
              onLaterPages=template.on_later_pages)

    return buf.getvalue()
