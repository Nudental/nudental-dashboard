    "period_comparison": _build_period_comparison,
    "provider_production_collections": _build_provider_production_collections,
    "office_comparison": _build_office_comparison,
    "treatment_plan_completion": _build_treatment_plan_completion,
    "patient_flow": _build_patient_flow,
}

