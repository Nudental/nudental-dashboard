def _build_provider_production_collections(headers, rows, meta, s) -> list:
    elements = []
    elements.append(Paragraph("Provider Production &amp; Collections", s["SectionHeader"]))

    # KPI summary
    if rows:
        total_gross = sum(r.get("Gross Production", 0) or 0 for r in rows)
        total_coll = sum(r.get("Total Collections", 0) or 0 for r in rows)
        n_providers = len(rows)
        kpis = [
            ("Providers", str(n_providers)),
            ("Gross Production", _fmt(total_gross, "money")),
            ("Total Collections", _fmt(total_coll, "money")),
        ]
        elements.append(_kpi_cards(kpis, s))
        elements.append(Spacer(1, 10))

    col_formats = ["text", "text", "text", "text", "money", "money", "money",
                   "money", "money", "money", "pct", "int", "int"]
    elements.append(_make_table(headers, rows, col_formats, styles_obj=s))

    elements.append(Spacer(1, 8))
    elements.append(Paragraph(
        "Source: /v2/reports/provider-performance — Dentrix Ascend procedures, distribution lines, appointments. "
        "Collection Rate = Total Collections / Net Production × 100.",
        s["SourceNote"]
    ))
    return elements


def _build_office_comparison(headers, rows, meta, s) -> list:
    elements = []
    elements.append(Paragraph("Office Comparison", s["SectionHeader"]))

    col_formats = ["text", "money", "money", "money", "money", "money", "pct", "pct", "int"]
    elements.append(_make_table(headers, rows, col_formats, styles_obj=s))

    elements.append(Spacer(1, 8))
    elements.append(Paragraph(
        "Source: Dentrix Ascend collections &amp; production per office, Finance Expense Report office-scoped expenses. "
        "Net Profit = Collections − Expenses. Margin = Net Profit / Collections × 100. "
        "Corporate/Shared expenses are shown separately and not attributed to any single office.",
        s["SourceNote"]
    ))
    return elements


def _build_treatment_plan_completion(headers, rows, meta, s) -> list:
    elements = []
    elements.append(Paragraph("Treatment Plan Completion", s["SectionHeader"]))

    window = meta.get("completion_window_days", 90)
    elements.append(Paragraph(
        f"Completion Window: {window} days from planned end date. "
        "Reflects formally treatment-planned procedures only.",
        s["SourceNote"]
    ))
    elements.append(Spacer(1, 6))

    # Split into sections
    summary_rows = [r for r in rows if r.get("Section") == "SUMMARY"]
    office_rows = [r for r in rows if r.get("Section") == "BY OFFICE"]
    provider_rows = [r for r in rows if r.get("Section") == "BY PLANNING PROVIDER"]

    # Summary KPIs
    if summary_rows:
        sr = summary_rows[0]
        kpis = [
            ("Planned Value", _fmt(sr.get("Planned Value"), "money")),
            ("Completed Value", _fmt(sr.get("Completed Value"), "money")),
            ("Completion Rate", _fmt(sr.get("Completion Rate (Value)"), "pct")),
            ("Avg Days", _fmt(sr.get("Avg Days"), "days")),
            ("Median Days", _fmt(sr.get("Median Days"), "days")),
        ]
        elements.append(_kpi_cards(kpis, s))
        elements.append(Spacer(1, 6))

        # Additional summary detail
        detail_kpis = [
            ("Open Value", _fmt(sr.get("Open Value"), "money")),
            ("Unscheduled", _fmt(sr.get("Unscheduled Value"), "money")),
            ("Sched. Not Completed", _fmt(sr.get("Scheduled Not Completed"), "money")),
        ]
        elements.append(_kpi_cards(detail_kpis, s))
        elements.append(Spacer(1, 12))

    # By Office table
    if office_rows:
        elements.append(Paragraph("By Office", s["SectionHeader"]))
        office_headers = ["Name", "Planned Value", "Completed Value",
                         "Completion Rate (Value)", "Open Value", "Avg Days", "Median Days"]
        office_formats = ["text", "money", "money", "pct", "money", "days", "days"]
        elements.append(_make_table(office_headers, office_rows, office_formats, styles_obj=s))
        elements.append(Spacer(1, 10))

    # By Provider table
    if provider_rows:
        elements.append(Paragraph("By Planning Provider", s["SectionHeader"]))
        prov_headers = ["Name", "Planned Value", "Completed Value",
                       "Completion Rate (Value)", "Open Value", "Avg Days", "Median Days"]
        prov_formats = ["text", "money", "money", "pct", "money", "days", "days"]
        elements.append(_make_table(prov_headers, provider_rows, prov_formats, styles_obj=s))

    elements.append(Spacer(1, 8))
    elements.append(Paragraph(
        "Source: /v2/eod/treatment-plan-completion — Dentrix Ascend patient_procedures with treatmentPlannedDate. "
        "Excludes direct/walk-in completions and same-day plan+complete.",
        s["SourceNote"]
    ))
    return elements


def _build_patient_flow(headers, rows, meta, s) -> list:
    elements = []
    elements.append(Paragraph("Patient Flow", s["SectionHeader"]))

    # Identify summary/total row for KPI cards
    total_row = None
    office_rows = []
    monthly_rows = []
    in_monthly = False
    for r in rows:
        office_val = r.get("Office", "")
        if office_val == "── Monthly Trend ──":
            in_monthly = True
            continue
        if office_val == "TOTAL":
            total_row = r
            continue
        if in_monthly:
            monthly_rows.append(r)
        else:
            office_rows.append(r)

    # Use total row if multi-office, otherwise first office row
    kpi_src = total_row or (office_rows[0] if office_rows else None)

    if kpi_src:
        # Row 1: patient counts (3 cards — fits comfortably)
        kpis_row1 = [
            ("New Patients", _fmt(kpi_src.get("New Patients"), "int")),
            ("Active Patients", _fmt(kpi_src.get("Active Patients"), "int")),
            ("Total Scheduled", _fmt(kpi_src.get("Total Scheduled"), "int")),
        ]
        elements.append(_kpi_cards(kpis_row1, s))
        elements.append(Spacer(1, 6))
        # Row 2: outcomes (3 cards)
        kpis_row2 = [
            ("Completed", _fmt(kpi_src.get("Completed"), "int")),
            ("Show Rate", _fmt(kpi_src.get("Show Rate %"), "pct")),
            ("Missed Rate", _fmt(kpi_src.get("Missed Rate %"), "pct")),
        ]
        elements.append(_kpi_cards(kpis_row2, s))
        elements.append(Spacer(1, 12))

    # Office breakdown table
    if office_rows:
        if total_row:
            elements.append(Paragraph("By Office", s["SectionHeader"]))
        col_formats = ["text", "int", "int", "int", "int", "int", "int", "int", "pct", "pct"]
        display_rows = office_rows + ([total_row] if total_row else [])
        t = _make_table(headers, display_rows, col_formats, styles_obj=s)

        # Bold the total row
        if total_row:
            last = len(display_rows)
            t.setStyle(TableStyle([
                ("FONTNAME", (0, last), (-1, last), "Helvetica-Bold"),
                ("LINEABOVE", (0, last), (-1, last), 1.5, BRAND_CYAN),
                ("BACKGROUND", (0, last), (-1, last), LIGHT_GRAY),
            ]))
        elements.append(t)
        elements.append(Spacer(1, 10))

    # Monthly trend table
    if monthly_rows:
        elements.append(Paragraph("Monthly Trend", s["SectionHeader"]))
        # Data rows store month labels under "Office" key — copy to "Month" for display
        trend_rows = []
        for r in monthly_rows:
            tr = dict(r)
            tr["Month"] = tr.pop("Office", "—")
            trend_rows.append(tr)
        trend_headers = ["Month"] + list(headers[1:])
        col_formats = ["text", "int", "int", "int", "int", "int", "int", "int", "pct", "pct"]
        elements.append(_make_table(trend_headers, trend_rows, col_formats, styles_obj=s))
        elements.append(Spacer(1, 10))

    elements.append(Spacer(1, 8))
    elements.append(Paragraph(
        "Source: /v2/patients/summary + /v2/appointments/summary — Dentrix Ascend SQLite. "
        "No daily_entries, no MEA, no manual/EOD data. Aggregate-only, no patient-level PHI. "
        "Show Rate = Completed / Total Scheduled × 100. "
        "Missed Rate = (Cancelled + Broken + No-Shows) / Total Scheduled × 100.",
        s["SourceNote"]
    ))
    return elements


# ── Builder dispatch ──────────────────────────────────────────────────────

BUILDERS = {
