def _build_period_comparison(headers, rows, meta, s) -> list:
    elements = []
    elements.append(Paragraph("Period Comparison", s["SectionHeader"]))

    col_formats = ["text", "money", "money", "money", "pct"]
    elements.append(_make_table(headers, rows, col_formats, styles_obj=s))

    elements.append(Spacer(1, 8))
    elements.append(Paragraph(
        "Source: Dentrix Ascend production &amp; collections, Finance Expense Report protected expenses. "
