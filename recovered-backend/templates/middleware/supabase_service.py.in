def get_table_counts() -> dict:
    """Return record counts for all dentrix tables."""
    tables = ["dentrix_patients", "dentrix_appointments", "dentrix_transactions",
              "dentrix_providers", "dentrix_locations"]
    counts = {}
    for table in tables:
        try:
            resp = requests.get(
                f"{_base_url()}/{table}",
                headers={**_headers(), "Prefer": "count=exact"},
                params={"select": "id"},
                timeout=10,
            )
            if resp.status_code == 200:
                count_header = resp.headers.get("content-range", "")
                if "/" in count_header:
                    counts[table] = int(count_header.split("/")[-1])
                else:
                    counts[table] = len(resp.json())
            else:
                counts[table] = f"error:{resp.status_code}"
        except Exception as e:
            counts[table] = f"error:{e}"
    return counts


def write_sync_audit(
    endpoint_key: str,
    sync_type: str = "scheduled",  # scheduled, historical, streaming, manual
    status: str = "success",        # success, partial, failed, nodata
    office_id: str = None,
    office_name: str = None,
    location_id: str = None,
    endpoint_name: str = None,
    endpoint_path: str = None,
    records_fetched: int = 0,
    records_imported: int = 0,
    records_skipped: int = 0,
    records_failed: int = 0,
    response_status_code: int = None,
    error_code: str = None,
    error_details: dict = None,
    duration_ms: int = None,
    triggered_by: str = "middleware_sync",
) -> bool:
    """Write a sync audit entry to the import_audit_log table in Supabase."""
    import uuid

    row = {
        "run_id": str(uuid.uuid4()),
        "endpoint_key": endpoint_key,
        "sync_type": sync_type,
        "status": status,
        "office_id": office_id,
        "office_name": office_name,
        "location_id": location_id,
        "endpoint_name": endpoint_name,
        "endpoint_path": endpoint_path,
        "records_fetched": records_fetched,
        "records_imported": records_imported,
        "records_skipped": records_skipped,
        "records_failed": records_failed,
        "response_status_code": response_status_code,
        "error_code": error_code,
        "error_details": error_details,
        "duration_ms": duration_ms,
        "source_system": "Dentrix Ascend",
        "triggered_by": triggered_by,
    }
    row = {k: v for k, v in row.items() if v is not None}
    return _upsert("import_audit_log", row, retries=1)


def seed_providers_and_locations(providers: list, locations: list, org_id: str) -> dict:
    """Bulk seed providers and locations to Supabase after initial sync."""
    p_ok = sum(1 for p in providers if upsert_provider(p, org_id))
    l_ok = sum(1 for l in locations if upsert_location(l, org_id))
    return {"providers_seeded": p_ok, "locations_seeded": l_ok}
