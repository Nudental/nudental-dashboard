    return _upsert("dentrix_locations", row)


def _upsert(table: str, row: dict, retries: int = 2) -> bool:
    """Upsert a single row via Supabase REST API."""
    url = f"{_base_url()}/{table}"
    headers = dict(_headers())
    headers["Prefer"] = "resolution=merge-duplicates,return=minimal"

    # JSONB fields need to be JSON strings for PostgREST
    payload = {}
    for k, v in row.items():
        if isinstance(v, (dict, list)):
            payload[k] = v  # PostgREST handles JSON natively
        else:
            payload[k] = v

    for attempt in range(retries + 1):
        try:
            resp = requests.post(url, headers=headers, json=payload, timeout=10)
            if resp.status_code in (200, 201, 204):
                return True
            if resp.status_code == 404:
                logger.warning(f"Table {table} not found — run MIGRATION_SQL in Supabase dashboard")
                return False
            if resp.status_code == 409:
                # Conflict — try PATCH instead
                patch_resp = requests.patch(
                    f"{url}?id=eq.{row['id']}",
                    headers=headers,
                    json=payload,
                    timeout=10,
                )
                return patch_resp.status_code in (200, 204)
            logger.warning(f"Supabase upsert {table}: {resp.status_code} {resp.text[:100]}")
            if attempt < retries:
                time.sleep(1)
        except Exception as e:
            logger.warning(f"Supabase upsert {table} attempt {attempt}: {e}")
            if attempt < retries:
                time.sleep(1)
    return False


def _batch_upsert(table: str, rows: list, retries: int = 2) -> int:
    """Batch upsert multiple rows via Supabase REST API. Returns count of successfully inserted rows."""
    if not rows:
        return 0
    url = f"{_base_url()}/{table}"
    headers = dict(_headers())
    headers["Prefer"] = "resolution=merge-duplicates,return=minimal"

    for attempt in range(retries + 1):
        try:
            resp = requests.post(url, headers=headers, json=rows, timeout=30)
            if resp.status_code in (200, 201, 204):
                return len(rows)
            logger.warning(f"Batch upsert {table}: {resp.status_code} {resp.text[:200]}")
            if attempt < retries:
                time.sleep(1)
        except Exception as e:
            logger.warning(f"Batch upsert {table} attempt {attempt}: {e}")
            if attempt < retries:
                time.sleep(1)
    return 0


def batch_upsert_transactions(items: list, org_id: str, tx_type: str = None, batch_size: int = 200) -> int:
    """Batch upsert transactions to Supabase."""
    rows = []
    for item in items:
        row_id = item.get("id")
        if not row_id:
            continue
        rows.append({
            "id": row_id,
            "org_id": org_id,
            "type": tx_type or item.get("ledgerType") or item.get("type"),
            "location_id": _nested_id(item.get("location")),
            "provider_id": _nested_id(item.get("provider")),
            "data": item,
            "last_modified": item.get("lastModified") or item.get("modifiedDate"),
            "synced_at": _now_iso(),
        })
    total = 0
    for i in range(0, len(rows), batch_size):
        batch = rows[i:i+batch_size]
        total += _batch_upsert("dentrix_transactions", batch)
    return total


