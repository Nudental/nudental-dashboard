"""
Supabase Service
Handles upserts and reads for the nudental Supabase project.
Tables: dentrix_patients, dentrix_appointments, dentrix_transactions,
        dentrix_providers, dentrix_locations

Supabase project: siwtadgdqtvxoztnxzhx
"""

import json
import logging
import time
from datetime import datetime, timezone
from typing import Optional, Any
import requests

logger = logging.getLogger("supabase_service")

CREDS_PATH = "/home/openclaw/.config/supabase/nudental.json"
_sb_config: Optional[dict] = None


def _load_config() -> dict:
    global _sb_config
    if _sb_config is None:
        with open(CREDS_PATH) as f:
            _sb_config = json.load(f)
    return _sb_config


def _headers() -> dict:
    cfg = _load_config()
    key = cfg["secret_key"]
    return {
        "apikey": key,
        "Authorization": f"Bearer {key}",
        "Content-Type": "application/json",
        "Prefer": "return=minimal",
    }


def _base_url() -> str:
    return _load_config()["project_url"] + "/rest/v1"


# ---------------------------------------------------------------------------
# Table creation SQL (run once via Supabase dashboard or management API)
# ---------------------------------------------------------------------------

MIGRATION_SQL = """
-- Dentrix streaming tables for nudashboard real-time sync

CREATE TABLE IF NOT EXISTS dentrix_patients (
    id TEXT PRIMARY KEY,
    org_id TEXT NOT NULL,
    data JSONB NOT NULL,
    last_modified TIMESTAMPTZ,
    synced_at TIMESTAMPTZ DEFAULT NOW()
);
CREATE INDEX IF NOT EXISTS idx_dp_org ON dentrix_patients(org_id);
CREATE INDEX IF NOT EXISTS idx_dp_modified ON dentrix_patients(last_modified);

CREATE TABLE IF NOT EXISTS dentrix_appointments (
    id TEXT PRIMARY KEY,
    org_id TEXT NOT NULL,
    location_id TEXT,
    provider_id TEXT,
    data JSONB NOT NULL,
    last_modified TIMESTAMPTZ,
    synced_at TIMESTAMPTZ DEFAULT NOW()
);
CREATE INDEX IF NOT EXISTS idx_da_org ON dentrix_appointments(org_id);
CREATE INDEX IF NOT EXISTS idx_da_loc ON dentrix_appointments(location_id);
CREATE INDEX IF NOT EXISTS idx_da_prov ON dentrix_appointments(provider_id);
CREATE INDEX IF NOT EXISTS idx_da_modified ON dentrix_appointments(last_modified);

CREATE TABLE IF NOT EXISTS dentrix_transactions (
    id TEXT PRIMARY KEY,
    org_id TEXT NOT NULL,
    type TEXT,
    location_id TEXT,
    provider_id TEXT,
    data JSONB NOT NULL,
    last_modified TIMESTAMPTZ,
    synced_at TIMESTAMPTZ DEFAULT NOW()
);
CREATE INDEX IF NOT EXISTS idx_dt_org ON dentrix_transactions(org_id);
CREATE INDEX IF NOT EXISTS idx_dt_type ON dentrix_transactions(type);
CREATE INDEX IF NOT EXISTS idx_dt_modified ON dentrix_transactions(last_modified);

CREATE TABLE IF NOT EXISTS dentrix_providers (
    id TEXT PRIMARY KEY,
    org_id TEXT NOT NULL,
    data JSONB NOT NULL,
    last_modified TIMESTAMPTZ,
    synced_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS dentrix_locations (
    id TEXT PRIMARY KEY,
    org_id TEXT NOT NULL,
    data JSONB NOT NULL,
    last_modified TIMESTAMPTZ,
    synced_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS goals (
    id BIGSERIAL PRIMARY KEY,
    location_id TEXT,
    year INTEGER,
    month INTEGER,
    production_goal NUMERIC(12,2),
    collections_goal NUMERIC(12,2),
    new_patients_goal INTEGER,
    data JSONB,
    created_at TIMESTAMPTZ DEFAULT NOW()
);
CREATE INDEX IF NOT EXISTS idx_goals_loc ON goals(location_id);
CREATE UNIQUE INDEX IF NOT EXISTS idx_goals_unique ON goals(location_id, year, month);

CREATE TABLE IF NOT EXISTS ar_aging_snapshots (
    id                            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    report_as_of                  DATE        NOT NULL,
    report_type                   TEXT        NOT NULL DEFAULT 'over_90',
    row_type                      TEXT        NOT NULL DEFAULT 'office_total',
    office_name                   TEXT,
    location_id                   TEXT,
    payor_name                    TEXT,
    payor_id                      TEXT,
    bucket_0_30                   NUMERIC(12,2),
    bucket_31_60                  NUMERIC(12,2),
    bucket_61_90                  NUMERIC(12,2),
    bucket_over_90                NUMERIC(12,2),
    total_balance_before_credits  NUMERIC(12,2),
    unapplied_credits             NUMERIC(12,2),
    net_balance_after_credits     NUMERIC(12,2),
    guarantor_portion             NUMERIC(12,2),
    insurance_portion             NUMERIC(12,2),
    estimated_writeoff            NUMERIC(12,2),
    source_file                   TEXT,
    source_note                   TEXT,
    imported_at                   TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
    imported_by                   TEXT         NOT NULL DEFAULT 'yabezy',
    reconciled                    BOOLEAN      NOT NULL DEFAULT FALSE,
    reconciliation_note           TEXT,
    UNIQUE (report_as_of, report_type, row_type, location_id, payor_name)
);
CREATE INDEX IF NOT EXISTS idx_ar_as_of    ON ar_aging_snapshots(report_as_of DESC);
CREATE INDEX IF NOT EXISTS idx_ar_location ON ar_aging_snapshots(location_id);
CREATE INDEX IF NOT EXISTS idx_ar_row_type ON ar_aging_snapshots(row_type);
ALTER TABLE ar_aging_snapshots ENABLE ROW LEVEL SECURITY;
"""


def apply_migrations() -> dict:
    """
    Attempt to apply migrations via Supabase management API.
    Falls back to a no-op if the API isn't accessible.
    Returns status dict.
    """
    cfg = _load_config()
    project_id = cfg.get("project_id", "siwtadgdqtvxoztnxzhx")
    secret_key = cfg["secret_key"]

    # Try management API (requires management token, may fail)
    mgmt_url = f"https://api.supabase.com/v1/projects/{project_id}/database/query"
    try:
        resp = requests.post(
            mgmt_url,
            headers={
                "Authorization": f"Bearer {secret_key}",
                "Content-Type": "application/json",
            },
            json={"query": MIGRATION_SQL},
            timeout=30,
        )
        if resp.status_code in (200, 201):
            logger.info("Migrations applied via management API")
            return {"status": "ok", "method": "management_api"}
        else:
            logger.warning(f"Management API migration failed: {resp.status_code} {resp.text[:200]}")
    except Exception as e:
        logger.warning(f"Management API not available: {e}")

    # Tables might already exist — return guidance
    return {
        "status": "manual_required",
        "message": "Run MIGRATION_SQL in Supabase SQL Editor if tables don't exist",
        "sql_preview": MIGRATION_SQL[:200] + "...",
    }


# ---------------------------------------------------------------------------
# Upsert helpers
# ---------------------------------------------------------------------------

def _now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def _nested_id(obj) -> Optional[str]:
    if isinstance(obj, dict):
        return obj.get("id")
    return obj


def upsert_patient(resource: dict, org_id: str) -> bool:
    """Upsert a patient record to dentrix_patients."""
    row_id = resource.get("id")
    if not row_id:
        return False
    last_mod = resource.get("lastModified") or resource.get("modifiedDate")
    row = {
        "id": row_id,
        "org_id": org_id,
        "data": resource,
        "last_modified": last_mod,
        "synced_at": _now_iso(),
    }
    return _upsert("dentrix_patients", row)


def upsert_appointment(resource: dict, org_id: str, location_id: Optional[str] = None, provider_id: Optional[str] = None) -> bool:
    row_id = resource.get("id")
    if not row_id:
        return False
    loc_id = location_id or _nested_id(resource.get("location"))
    prov_id = provider_id or _nested_id(resource.get("provider"))
    last_mod = resource.get("lastModified") or resource.get("modifiedDate")
    row = {
        "id": row_id,
        "org_id": org_id,
        "location_id": loc_id,
        "provider_id": prov_id,
        "data": resource,
        "last_modified": last_mod,
        "synced_at": _now_iso(),
    }
    return _upsert("dentrix_appointments", row)


def upsert_transaction(resource: dict, org_id: str, tx_type: Optional[str] = None) -> bool:
    row_id = resource.get("id")
    if not row_id:
        return False
    loc_id = _nested_id(resource.get("location"))
    prov_id = _nested_id(resource.get("provider"))
    last_mod = resource.get("lastModified") or resource.get("modifiedDate")
    row = {
        "id": row_id,
        "org_id": org_id,
        "type": tx_type or resource.get("ledgerType") or resource.get("type"),
        "location_id": loc_id,
        "provider_id": prov_id,
        "data": resource,
        "last_modified": last_mod,
        "synced_at": _now_iso(),
    }
    return _upsert("dentrix_transactions", row)


